  "translations": {
    "91767": {
      "id": 3684422,
      "text": "Bây giờ ông có thể mặc quần áo vào.",
      "author": "ChatGPT4.1"
    },
    "91768": {
      "id": 3684423,
      "text": "Ông Hartley, tôi nghĩ vấn đề của ông là do thận không hoạt động tốt như bình thường.",
      "author": "ChatGPT4.1"
    },
    "91769": {
      "id": 3684424,
      "text": "Trước đây, ông có từng gặp khó khăn gì khi đi tiểu không?",
      "author": "ChatGPT4.1"
    },
    "91770": {
      "id": 3684425,
      "text": "À có, vài năm trước tôi cảm thấy rát khi đi tiểu.",
      "author": "ChatGPT4.1"
    },
    "91771": {
      "id": 3684426,
      "text": "Bác sĩ đa khoa bảo tôi bị cao huyết áp và kê thuốc cho tôi, sau đó tạm thời hết triệu chứng.",
      "author": "ChatGPT4.1"
    },
    "91772": {
      "id": 3684427,
      "text": "Vậy bây giờ thì sao?",
      "author": "ChatGPT4.1"
    },
    "91773": {
      "id": 3684428,
      "text": "Tôi muốn ông làm một số xét nghiệm máu, chụp X-quang và kiểm tra chức năng thận.",
      "author": "ChatGPT4.1"
    },
    "91774": {
      "id": 3684429,
      "text": "Tôi muốn ông lấy mẫu nước tiểu trong vòng 24 giờ.",
      "author": "ChatGPT4.1"
    },
    "91775": {
      "id": 3684430,
      "text": "Y tá sẽ hướng dẫn ông chính xác cách thực hiện.",
      "author": "ChatGPT4.1"
    },
    "91776": {
      "id": 3684431,
      "text": "Sau đó, chúng tôi sẽ yêu cầu ông đến kiểm tra siêu âm thận.",
      "author": "ChatGPT4.1"
    },
    "91777": {
      "id": 3684432,
      "text": "Đây là một thủ thuật rất đơn giản để đảm bảo không có sự tắc nghẽn nào.",
      "author": "ChatGPT4.1"
    }
  }
