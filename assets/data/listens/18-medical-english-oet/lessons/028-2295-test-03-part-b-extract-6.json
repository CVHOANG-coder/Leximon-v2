  "translations": {
    "90476": {
      "id": 3682874,
      "text": "Tôi là một nhà vật lý trị liệu, và tôi đang trình bày poster của chúng tôi về liệu pháp vận động cưỡng bức",
      "author": "ChatGPT4.1"
    },
    "90477": {
      "id": 3682875,
      "text": "cho trẻ em bị liệt một phần sau phẫu thuật não.",
      "author": "ChatGPT4.1"
    },
    "90478": {
      "id": 3682876,
      "text": "Chúng tôi đã thực hiện một loạt ca bệnh trên bốn trẻ em, tất cả đều đã trải qua phẫu thuật cắt bán cầu não.",
      "author": "a user"
    },
    "90479": {
      "id": 3682877,
      "text": "Các em được tiếp nhận vào điều trị nội trú trong vòng hai tuần sau phẫu thuật",
      "author": "ChatGPT4.1"
    },
    "90480": {
      "id": 3682878,
      "text": "và bắt đầu quá trình trị liệu từ hai đến ba tuần sau phẫu thuật.",
      "author": "ChatGPT4.1"
    },
    "90481": {
      "id": 3682879,
      "text": "Liệu pháp này được tiếp tục sau khi các em xuất viện.",
      "author": "ChatGPT4.1"
    },
    "90482": {
      "id": 3682880,
      "text": "Kết quả của chúng tôi cho thấy ba em đã phục hồi chức năng và khả năng vận động tuyệt vời, bao gồm cả khả năng đi lại và chức năng chi trên.",
      "author": "a user"
    },
    "90483": {
      "id": 3682881,
      "text": "Đáng tiếc, một em không đạt kết quả tốt,",
      "author": "ChatGPT4.1"
    },
    "90484": {
      "id": 3682882,
      "text": "nhưng em ấy đã bỏ trị liệu từ sớm.",
      "author": "ChatGPT4.1"
    },
    "90485": {
      "id": 3682883,
      "text": "Loại liệu pháp vận động này đã được sử dụng khá nhiều ở người lớn sau đột quỵ.",
      "author": "ChatGPT4.1"
    },
    "90486": {
      "id": 3682884,
      "text": "Kết quả ở đây thúc đẩy việc tiếp tục nghiên cứu thêm trên đối tượng trẻ em hoặc thanh thiếu niên",
      "author": "ChatGPT4.1"
    },
    "90487": {
      "id": 3682885,
      "text": "sau phẫu thuật cắt bán cầu não hoặc các phẫu thuật khác",
      "author": "a user"
    },
    "90488": {
      "id": 3682886,
      "text": "để giúp chúng tôi quyết định liệu pháp này có phù hợp với các em hay không.",
      "author": "a user"
    }
  }
}
