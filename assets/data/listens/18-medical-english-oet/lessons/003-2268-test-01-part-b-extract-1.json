  "translations": {
    "89710": {
      "id": 3680860,
      "text": "Được rồi, tiếp theo là về Suzie Williams ở giường số 3.",
      "author": "ChatGPT4.1"
    },
    "89711": {
      "id": 3680861,
      "text": "Đúng rồi.",
      "author": "ChatGPT4.1"
    },
    "89712": {
      "id": 3680862,
      "text": "Cô ấy nhập viện vì đau ngực để loại trừ nhồi máu cơ tim.",
      "author": "ChatGPT4.1"
    },
    "89713": {
      "id": 3680863,
      "text": "Cho đến nay cô ấy đã làm điện tâm đồ và kết quả bình thường,",
      "author": "ChatGPT4.1"
    },
    "89714": {
      "id": 3680864,
      "text": "và loạt xét nghiệm men tim và troponin đầu tiên đều âm tính.",
      "author": "ChatGPT4.1"
    },
    "89715": {
      "id": 3680865,
      "text": "Khi cô ấy vào viện, huyết áp có hơi tăng, khoảng 182 trên 95,",
      "author": "ChatGPT4.1"
    },
    "89716": {
      "id": 3680866,
      "text": "nhưng cô ấy đã được cho dùng losartan và lúc 6 giờ thì huyết áp là 142 trên 82.",
      "author": "a user"
    },
    "89717": {
      "id": 3680867,
      "text": "Cô ấy cũng bị mất nước nên chúng tôi bắt đầu truyền dịch qua đường tĩnh mạch cho cô ấy,",
      "author": "a user"
    },
    "89718": {
      "id": 3680868,
      "text": "Dung dịch D5 NaCl 0,45% đang truyền với tốc độ 125 mL/giờ.",
      "author": "a user"
    },
    "89719": {
      "id": 3680869,
      "text": "Truyền như vậy đến nửa đêm thì có thể ngắt.",
      "author": "ChatGPT4.1"
    },
    "89720": {
      "id": 3680870,
      "text": "Cô ấy được hẹn làm nghiệm pháp gắng sức vào ngày mai và thêm một số xét nghiệm men tim nữa.",
      "author": "ChatGPT4.1"
    },
    "89721": {
      "id": 3680871,
      "text": "Được chứ?",
      "author": "ChatGPT4.1"
    },
    "89722": {
      "id": 3680872,
      "text": "Được rồi.",
      "author": "ChatGPT4.1"
    }
  }
}
