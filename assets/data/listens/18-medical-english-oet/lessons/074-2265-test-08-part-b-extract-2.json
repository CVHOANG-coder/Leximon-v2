  "translations": {
    "89624": {
      "id": 3684859,
      "text": "Hai mươi bốn giờ đầu tiên sau khi bị chấn thương đầu là quan trọng nhất",
      "author": "ChatGPT4.1"
    },
    "89625": {
      "id": 3684860,
      "text": "mặc dù các di chứng có thể xuất hiện muộn hơn nhiều.",
      "author": "ChatGPT4.1"
    },
    "89626": {
      "id": 3684861,
      "text": "Điều quan trọng là bệnh nhân được đánh thức mỗi 2 giờ trong 24 giờ đầu tiên.",
      "author": "ChatGPT4.1"
    },
    "89627": {
      "id": 3684862,
      "text": "Nếu họ đang hồi phục tại nhà, thì việc này nên do một người có trách nhiệm thực hiện,",
      "author": "ChatGPT4.1"
    },
    "89628": {
      "id": 3684863,
      "text": "người đó cũng cần theo dõi các triệu chứng sau:",
      "author": "ChatGPT4.1"
    },
    "89629": {
      "id": 3684864,
      "text": "đau đầu liên tục, buồn nôn hoặc nôn mửa;",
      "author": "ChatGPT4.1"
    },
    "89630": {
      "id": 3684865,
      "text": "yếu, tê liệt hoặc liệt tay chân;",
      "author": "ChatGPT4.1"
    },
    "89631": {
      "id": 3684866,
      "text": "có máu hoặc dịch trong suốt chảy ra từ tai hoặc mũi;",
      "author": "ChatGPT4.1"
    },
    "89632": {
      "id": 3684867,
      "text": "nhìn mờ, hoặc một bên đồng tử to hơn bên còn lại và co giật.",
      "author": "ChatGPT4.1"
    },
    "89633": {
      "id": 3684868,
      "text": "Nếu xảy ra bất kỳ điều nào trong số này, người đó cần gọi cho bác sĩ ngay lập tức,",
      "author": "ChatGPT4.1"
    },
    "89634": {
      "id": 3684869,
      "text": "hoặc trở lại khoa cấp cứu của bệnh viện.",
      "author": "ChatGPT4.1"
    }
  }
}
