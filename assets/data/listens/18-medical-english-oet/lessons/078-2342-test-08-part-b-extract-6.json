  "translations": {
    "92082": {
      "id": 3680041,
      "text": "Bạn bị một tình trạng gọi là \"vảy nến mảng mãn tính\" ở khuỷu tay và đầu gối, nhưng đừng lo, chúng tôi có thể điều trị nó.",
      "author": "ChatGPT4.1"
    },
    "92083": {
      "id": 3680042,
      "text": "Bạn chắc chắn sẽ được lợi ích từ việc điều trị bằng tia sáng để giúp làm dịu vùng phát ban.",
      "author": "ChatGPT4.1"
    },
    "92084": {
      "id": 3680043,
      "text": "Tôi khuyên bạn nên đến khoa vật lý trị liệu hai lần một tuần để được điều trị bằng tia UVB.",
      "author": "ChatGPT4.1"
    },
    "92085": {
      "id": 3680044,
      "text": "Bác sĩ đang sắp xếp cho tôi điều trị bằng giường tắm nắng phải không?",
      "author": "ChatGPT4.1"
    },
    "92086": {
      "id": 3680045,
      "text": "Ờ... có một vài điểm tương đồng với việc điều trị bằng giường tắm nắng, nhưng thực ra...",
      "author": "ChatGPT4.1"
    },
    "92087": {
      "id": 3680046,
      "text": "đèn mà chúng tôi sử dụng ở bệnh viện là loại đặc biệt và chỉ phát ra tia UVB mà thôi.",
      "author": "ChatGPT4.1"
    },
    "92088": {
      "id": 3680047,
      "text": "Tuy nhiên, bạn vẫn sẽ có làn da rám nắng.",
      "author": "ChatGPT4.1"
    },
    "92089": {
      "id": 3680048,
      "text": "Nghe tuyệt quá. Khi nào tôi có thể bắt đầu?",
      "author": "ChatGPT4.1"
    },
    "92090": {
      "id": 3680049,
      "text": "Hiện đang có danh sách chờ, nên tôi sẽ đưa bạn loại kem này để dùng trước.",
      "author": "ChatGPT4.1"
    },
    "92091": {
      "id": 3680050,
      "text": "Hãy mang tờ đơn này đến khoa vật lý trị liệu và họ sẽ đăng ký cho bạn sáu tuần điều trị bằng tia UVB.",
      "author": "ChatGPT4.1"
    },
    "92092": {
      "id": 3680051,
      "text": "Chúc bạn mọi điều tốt đẹp.",
      "author": "ChatGPT4.1"
    },
    "92093": {
      "id": 3680052,
      "text": "Cảm ơn bác sĩ.",
      "author": "ChatGPT4.1"
    }
  }
