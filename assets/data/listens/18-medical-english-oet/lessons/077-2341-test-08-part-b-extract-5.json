  "translations": {
    "92070": {
      "id": 3684901,
      "text": "Những yêu cầu chuẩn bị quan trọng nhất bao gồm việc lấy kết quả eGFR gần đây,",
      "author": "ChatGPT4.1"
    },
    "92071": {
      "id": 3684902,
      "text": "và cung cấp chi tiết các loại thuốc đang sử dụng, thuốc không kê đơn và thông tin về tình trạng mang thai.",
      "author": "ChatGPT4.1"
    },
    "92072": {
      "id": 3684903,
      "text": "Vui lòng đảm bảo rằng bệnh nhân không uống nước trong vòng 4 giờ trước khi kiểm tra.",
      "author": "ChatGPT4.1"
    },
    "92073": {
      "id": 3684904,
      "text": "Những bệnh nhân có tiền sử sốt, tiêu chảy hoặc chạy thận gần đây không phù hợp để chụp CT có sử dụng chất cản quang.",
      "author": "ChatGPT4.1"
    },
    "92074": {
      "id": 3684905,
      "text": "Thời gian thực hiện kiểm tra kéo dài từ 10 đến 45 phút tùy thuộc vào loại thủ thuật,",
      "author": "ChatGPT4.1"
    },
    "92075": {
      "id": 3684906,
      "text": "và các tác dụng phụ có thể xảy ra bao gồm buồn nôn, nôn và chóng mặt.",
      "author": "ChatGPT4.1"
    },
    "92076": {
      "id": 3684907,
      "text": "Chất cản quang CT thường tồn tại trong cơ thể bệnh nhân khoảng 48 giờ sau khi tiêm,",
      "author": "ChatGPT4.1"
    },
    "92077": {
      "id": 3684908,
      "text": "và sau khi kiểm tra, tôi khuyên nên nhắc bệnh nhân uống nhiều nước hơn bình thường",
      "author": "ChatGPT4.1"
    },
    "92078": {
      "id": 3684909,
      "text": "vì điều này giúp thúc đẩy quá trình đào thải chất cản quang CT.",
      "author": "ChatGPT4.1"
    },
    "92079": {
      "id": 3684910,
      "text": "Cuối cùng, nếu có bất kỳ biến chứng nào như phản ứng dị ứng, giảm lượng nước tiểu,",
      "author": "ChatGPT4.1"
    },
    "92080": {
      "id": 3684911,
      "text": "lú lẫn, hoặc có máu trong nước tiểu,",
      "author": "ChatGPT4.1"
    },
    "92081": {
      "id": 3684912,
      "text": "thì vui lòng hướng dẫn bệnh nhân thông báo cho nhân viên y tế càng sớm càng tốt.",
      "author": "ChatGPT4.1"
    }
  }
}
