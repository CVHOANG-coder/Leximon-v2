  "translations": {
    "90756": {
      "id": 3683153,
      "text": "Quá trình chuyển dạ có thể diễn ra khác nhau đối với từng người.",
      "author": "ChatGPT4.1"
    },
    "90757": {
      "id": 3683154,
      "text": "Trong một số trường hợp, nếu quá trình chuyển dạ kéo dài hơn dự kiến,",
      "author": "ChatGPT4.1"
    },
    "90758": {
      "id": 3683155,
      "text": "và nếu chúng tôi phát hiện em bé đang gặp khó khăn,",
      "author": "ChatGPT4.1"
    },
    "90759": {
      "id": 3683156,
      "text": "thì chúng tôi có thể phải cân nhắc thực hiện ca mổ lấy thai khẩn cấp.",
      "author": "ChatGPT4.1"
    },
    "90760": {
      "id": 3683157,
      "text": "Đây là một thủ thuật được thực hiện trong phòng mổ,",
      "author": "ChatGPT4.1"
    },
    "90761": {
      "id": 3683158,
      "text": "và được tiến hành dưới gây tê tủy sống hoặc gây tê ngoài màng cứng,",
      "author": "ChatGPT4.1"
    },
    "90762": {
      "id": 3683159,
      "text": "vì vậy bạn sẽ không cảm thấy gì, nhưng bạn vẫn tỉnh táo.",
      "author": "a user"
    },
    "90763": {
      "id": 3683160,
      "text": "Một tấm màn sẽ được che ngang người bạn để bạn không nhìn thấy những gì đang diễn ra.",
      "author": "ChatGPT4.1"
    },
    "90764": {
      "id": 3683161,
      "text": "Chúng tôi sẽ rạch một đường ở bụng và tử cung ngay dưới đường bikini để lấy em bé ra",
      "author": "ChatGPT4.1"
    },
    "90765": {
      "id": 3683162,
      "text": "và sau đó khâu vết thương.",
      "author": "a user"
    },
    "90766": {
      "id": 3683163,
      "text": "Thủ thuật mất khoảng 40 phút và người thân hỗ trợ sinh có thể ở bên bạn suốt quá trình đó.",
      "author": "ChatGPT4.1"
    },
    "90767": {
      "id": 3683164,
      "text": "Điều đó có hợp lý không?",
      "author": "a user"
    }
  }
