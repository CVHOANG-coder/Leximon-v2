  "translations": {
    "90778": {
      "id": 3683175,
      "text": "Chào buổi sáng ông Henderson.",
      "author": "ChatGPT4.1"
    },
    "90779": {
      "id": 3683176,
      "text": "Bác sĩ Ray đã khuyên ông nên tiêm vắc-xin phòng cúm trước khi xuất viện.",
      "author": "a user"
    },
    "90780": {
      "id": 3683177,
      "text": "Tôi đã chuẩn bị mũi tiêm sẵn sàng cho ông.",
      "author": "ChatGPT4.1"
    },
    "90781": {
      "id": 3683178,
      "text": "Ông có bị dị ứng với gì không?",
      "author": "ChatGPT4.1"
    },
    "90782": {
      "id": 3683179,
      "text": "Tôi chỉ dị ứng với latex và penicillin thôi.",
      "author": "ChatGPT4.1"
    },
    "90783": {
      "id": 3683180,
      "text": "Tôi không biết mình có muốn tiêm phòng cúm không.",
      "author": "ChatGPT4.1"
    },
    "90784": {
      "id": 3683181,
      "text": "Lần tiêm trước tôi bị ốm.",
      "author": "a user"
    },
    "90785": {
      "id": 3683182,
      "text": "Tôi rất tiếc vì chuyện đó đã xảy ra với ông.",
      "author": "a user"
    },
    "90786": {
      "id": 3683183,
      "text": "Ông có những triệu chứng gì sau mũi tiêm cúm cuối cùng?",
      "author": "a user"
    },
    "90787": {
      "id": 3683184,
      "text": "Tôi bị sổ mũi, đau đầu và cảm giác như ai đó đấm vào cánh tay tôi vậy.",
      "author": "a user"
    },
    "90788": {
      "id": 3683185,
      "text": "Đôi khi, vắc-xin phòng cúm có thể gây ra các phản ứng như đau chỗ tiêm và đau đầu.",
      "author": "a user"
    },
    "90789": {
      "id": 3683186,
      "text": "Các triệu chứng phổ biến khác bao gồm mệt mỏi, đau cơ và khớp, run rẩy và sốt.",
      "author": "a user"
    },
    "90790": {
      "id": 3683187,
      "text": "Tất cả những triệu chứng này đều có thể gặp ở bệnh cúm, nhưng mũi tiêm không thể khiến bạn bị cúm.",
      "author": "a user"
    }
  }
}
