  "translations": {
    "90136": {
      "id": 3682547,
      "text": "Chúng ta đã có ghi chú của bà Kent chưa?",
      "author": "ChatGPT4.1"
    },
    "90137": {
      "id": 3682548,
      "text": "Vâng, chúng ở đây.",
      "author": "ChatGPT4.1"
    },
    "90138": {
      "id": 3682549,
      "text": "Bà ấy sẽ đến hôm nay để có thể phẫu thuật laser cho bệnh võng mạc của mình, phải không?",
      "author": "ChatGPT4.1"
    },
    "90139": {
      "id": 3682550,
      "text": "Ờ, còn tùy vào kết quả...",
      "author": "ChatGPT4.1"
    },
    "90140": {
      "id": 3682551,
      "text": "và từ những bức ảnh chúng tôi chụp lần trước, có thể thấy sự cải thiện chậm,",
      "author": "a user"
    },
    "90141": {
      "id": 3682552,
      "text": "nên chúng ta sẽ nói chuyện với bà ấy và có thể tạm thời hoãn lại",
      "author": "ChatGPT4.1"
    },
    "90142": {
      "id": 3682553,
      "text": "trừ khi tình trạng của bà ấy trở nên tệ hơn, vì thực tế có thể xảy ra trong một số trường hợp.",
      "author": "ChatGPT4.1"
    },
    "90143": {
      "id": 3682554,
      "text": "Vậy nguyên nhân là gì?",
      "author": "ChatGPT4.1"
    },
    "90144": {
      "id": 3682555,
      "text": "Vâng, chúng ta biết rằng rò rỉ chất lỏng phía sau võng mạc gây ra tình trạng thị lực bị biến dạng mà người bệnh gặp phải.",
      "author": "a user"
    },
    "90145": {
      "id": 3682556,
      "text": "nhưng không biết tại sao điều đó lại xảy ra.",
      "author": "ChatGPT4.1"
    },
    "90146": {
      "id": 3682557,
      "text": "Có thể có liên quan đến căng thẳng, hoặc sử dụng steroid, nhưng tôi e rằng điều này vẫn chưa chắc chắn.",
      "author": "ChatGPT4.1"
    }
  }
