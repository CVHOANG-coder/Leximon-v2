  "translations": {
    "91101": {
      "id": 3683516,
      "text": "Được rồi, vậy khi bạn làm việc với những bệnh nhân hen suyễn,",
      "author": "ChatGPT4.1"
    },
    "91102": {
      "id": 3683517,
      "text": "khả năng cao họ sẽ hỏi bạn về việc tập thể dục",
      "author": "ChatGPT4.1"
    },
    "91103": {
      "id": 3683518,
      "text": "và bạn sẽ phải nhanh chóng đánh giá xem nên nói gì cho phù hợp.",
      "author": "ChatGPT4.1"
    },
    "91104": {
      "id": 3683519,
      "text": "Về cơ bản, bằng cách cho phổi của họ được tập luyện thường xuyên,",
      "author": "a user"
    },
    "91105": {
      "id": 3683520,
      "text": "họ sẽ giảm nguy cơ xuất hiện triệu chứng hen suyễn.",
      "author": "ChatGPT4.1"
    },
    "91106": {
      "id": 3683521,
      "text": "Nhưng nếu họ chưa từng có thói quen tập thể dục thường xuyên trước đây,",
      "author": "a user"
    },
    "91107": {
      "id": 3683522,
      "text": "điều đầu tiên họ cần làm là đến gặp bác sĩ đa khoa để kiểm tra",
      "author": "a user"
    },
    "91108": {
      "id": 3683523,
      "text": "và đảm bảo rằng kế hoạch kiểm soát hen suyễn của họ luôn được cập nhật.",
      "author": "ChatGPT4.1"
    },
    "91109": {
      "id": 3683524,
      "text": "Hầu hết bệnh nhân đều có thể sắp xếp tập thể dục đều đặn trong tuần",
      "author": "ChatGPT4.1"
    },
    "91110": {
      "id": 3683525,
      "text": "và bạn nên nhấn mạnh rằng những thay đổi nhỏ sẽ tạo ra sự khác biệt lớn.",
      "author": "ChatGPT4.1"
    },
    "91111": {
      "id": 3683526,
      "text": "Vì vậy chỉ cần dẫn con đi bộ tới trường hoặc đi bộ trong giờ nghỉ trưa thay vì ngồi một chỗ",
      "author": "ChatGPT4.1"
    },
    "91112": {
