  "translations": {
    "91131": {
      "id": 3683546,
      "text": "Vậy nên, ông Clark, ông cần giữ cho băng bó luôn khô ráo,",
      "author": "ChatGPT4.1"
    },
    "91132": {
      "id": 3683547,
      "text": "có nghĩa là phải bọc nó bằng túi nhựa khi tắm.",
      "author": "ChatGPT4.1"
    },
    "91133": {
      "id": 3683548,
      "text": "Tôi chắc là ông sẽ làm được.",
      "author": "ChatGPT4.1"
    },
    "91134": {
      "id": 3683549,
      "text": "Nếu băng bó bị ướt, tôi có thể dùng máy sấy tóc đúng không?",
      "author": "ChatGPT4.1"
    },
    "91135": {
      "id": 3683550,
      "text": "Đúng, nhưng hãy để ở chế độ mát nhé.",
      "author": "ChatGPT4.1"
    },
    "91136": {
      "id": 3683551,
      "text": "Một điều nữa, rất dễ quên tập cho vai và khuỷu tay.",
      "author": "ChatGPT4.1"
    },
    "91137": {
      "id": 3683552,
      "text": "Đừng ngồi cả ngày như một bức tượng.",
      "author": "ChatGPT4.1"
    },
    "91138": {
      "id": 3683553,
      "text": "Vâng.",
      "author": "ChatGPT4.1"
    },
    "91139": {
      "id": 3683554,
      "text": "Và không bình thường khi cảm thấy tê hoặc ngứa ran.",
      "author": "ChatGPT4.1"
    },
    "91140": {
      "id": 3683555,
      "text": "Khả năng này là thấp, nhưng hãy báo cho chúng tôi ngay nếu có.",
      "author": "ChatGPT4.1"
    },
    "91141": {
      "id": 3683556,
      "text": "Sau một hai ngày, một số người sẽ cảm thấy băng bó quá chật hoặc quá lỏng.",
      "author": "ChatGPT4.1"
    },
    "91142": {
      "id": 3683557,
      "text": "Nếu có vấn đề như vậy, ông hãy báo cho chúng tôi.",
      "author": "ChatGPT4.1"
    },
    "91143": {
      "id": 3683558,
      "text": "Vậy, các anh có thể điều chỉnh nó được chứ?",
      "author": "ChatGPT4.1"
    },
    "91144": {
      "id": 3683559,
      "text": "Thực ra, nếu có cảm giác khó chịu, chúng tôi có thể thay băng bó cho ông.",
      "author": "ChatGPT4.1"
    }
  }
