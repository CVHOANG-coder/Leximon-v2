  "translations": {
    "91834": {
      "id": 3684538,
      "text": "Này Kylie, tôi có thể nói chuyện với bạn một chút về bà Robbins ở phòng 225 không?",
      "author": "ChatGPT4.1"
    },
    "91835": {
      "id": 3684539,
      "text": "Được chứ, có chuyện gì vậy?",
      "author": "ChatGPT4.1"
    },
    "91836": {
      "id": 3684540,
      "text": "À, bà ấy là bệnh nhân của bác sĩ Nguyễn và ghi chú của ông ấy nói rằng bà cần bắt đầu vận động hôm nay và sẽ xuất viện vào ngày kia.",
      "author": "ChatGPT4.1"
    },
    "91837": {
      "id": 3684541,
      "text": "Vì vậy tôi đã vào thăm bà ấy, hỏi thăm sức khỏe của bà và thông báo rằng tôi sẽ giúp bà đi tắm.",
      "author": "ChatGPT4.1"
    },
    "91838": {
      "id": 3684542,
      "text": "Cho đến giờ bà ấy vẫn chỉ được lau người trên giường.",
      "author": "ChatGPT4.1"
    },
    "91839": {
      "id": 3684543,
      "text": "Được rồi.",
      "author": "ChatGPT4.1"
    },
    "91840": {
      "id": 3684544,
      "text": "Vấn đề là, ngay khi tôi nhắc đến việc đi tắm, bà ấy bắt đầu rất khó chịu rồi nói rằng bà chỉ muốn nghỉ ngơi.",
      "author": "ChatGPT4.1"
    },
    "91841": {
      "id": 3684545,
      "text": "Và tôi đã cố giải thích cho bà hiểu tầm quan trọng của việc vận động",
      "author": "ChatGPT4.1"
    },
    "91842": {
      "id": 3684546,
      "text": "và rằng chính bác sĩ là người đã yêu cầu điều đó",
      "author": "ChatGPT4.1"
    },
    "91843": {
      "id": 3684547,
      "text": "và nó sẽ giúp bà hồi phục nhanh hơn, nhưng bà không chịu nghe.",
      "author": "ChatGPT4.1"
    },
