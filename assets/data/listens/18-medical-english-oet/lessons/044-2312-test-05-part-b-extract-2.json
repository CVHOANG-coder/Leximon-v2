  "translations": {
    "91086": {
      "id": 3683492,
      "text": "À, bạn đang mắc phải thứ gọi là “bệnh bunion” (chứng đau khớp ngón chân cái).",
      "author": "ChatGPT4.1"
    },
    "91087": {
      "id": 3683493,
      "text": "Nó thật là xấu xí.",
      "author": "ChatGPT4.1"
    },
    "91088": {
      "id": 3683494,
      "text": "Tôi thậm chí đã ngừng mang những đôi giày hở mũi.",
      "author": "ChatGPT4.1"
    },
    "91089": {
      "id": 3683495,
      "text": "Sao chuyện này lại xảy ra? Ý tôi là, tôi còn quá trẻ để bị như thế này.",
      "author": "ChatGPT4.1"
    },
    "91090": {
      "id": 3683496,
      "text": "Thực ra đó là một quan niệm sai lầm phổ biến.",
      "author": "ChatGPT4.1"
    },
    "91091": {
      "id": 3683497,
      "text": "Tình trạng này có thể do di truyền hoặc thậm chí liên quan đến các bệnh về khớp như viêm xương khớp.",
      "author": "a user"
    },
    "91092": {
      "id": 3683498,
      "text": "Nhưng nguyên nhân phổ biến nhất là do giày dép không vừa vặn,",
      "author": "a user"
    },
    "91093": {
      "id": 3683499,
      "text": "đặc biệt là những đôi giày có mũi hẹp.",
      "author": "ChatGPT4.1"
    },
    "91094": {
      "id": 3683500,
      "text": "À, hầu hết các đôi giày của tôi đều có mũi khá hẹp,",
      "author": "ChatGPT4.1"
    },
    "91095": {
      "id": 3683501,
      "text": "nhưng chắc chắn điều đó không thể thay đổi hình dạng bàn chân của bạn.",
      "author": "a user"
    },
    "91096": {
      "id": 3683502,
      "text": "Ý tôi là, ngón chân cái của tôi đang chỉ sai hướng.",
      "author": "a user"
    },
    "91097": {
      "id": 3683503,
      "text": "Điều thực sự xảy ra là xương bàn chân, tức là xương dài ở giữa bàn chân, lệch về phía bàn chân còn lại,",
      "author": "ChatGPT4.1"
    },
    "91098": {
      "id": 3683504,
      "text": "trong khi ngón chân cái, hay còn gọi là hallux, đẩy về phía các ngón khác,",
      "author": "ChatGPT4.1"
    },
    "91099": {
      "id": 3683505,
      "text": "nên chúng ta thấy phần khớp rất lộ ra ngoài, giống như trường hợp của bạn ở đây.",
      "author": "ChatGPT4.1"
    },
    "91100": {
      "id": 3683506,
      "text": "Tôi hiểu rồi.",
      "author": "ChatGPT4.1"
    }
  }
}
