  "translations": {
    "90768": {
      "id": 3683165,
      "text": "Vào tháng Chín, chúng ta sẽ có nhiều bệnh nhân mới vì các sinh viên năm nhất đại học sẽ đăng ký trong tuần lễ định hướng.",
      "author": "ChatGPT4.1"
    },
    "90769": {
      "id": 3683166,
      "text": "Đúng vậy, năm ngoái chúng ta đã cực kỳ bận rộn, đúng không?",
      "author": "ChatGPT4.1"
    },
    "90770": {
      "id": 3683167,
      "text": "Ừ, thật sự rất hỗn loạn.",
      "author": "ChatGPT4.1"
    },
    "90771": {
      "id": 3683168,
      "text": "Bạn có nghĩ chúng ta nên thuê nhân viên từ các công ty dịch vụ để hỗ trợ trong vài tuần đầu không?",
      "author": "ChatGPT4.1"
    },
    "90772": {
      "id": 3683169,
      "text": "Tôi nghĩ một phần vấn đề là năm ngoái bác sĩ Igwe và y tá Fletcher đều vắng mặt.",
      "author": "ChatGPT4.1"
    },
    "90773": {
      "id": 3683170,
      "text": "Bác sĩ Igwe đã đi Costa Rica và Y tá Fletcher bị cúm.",
      "author": "a user"
    },
    "90774": {
      "id": 3683171,
      "text": "Đúng rồi, tôi nhớ mà, ừm...",
      "author": "ChatGPT4.1"
    },
    "90775": {
      "id": 3683172,
      "text": "Chúng ta không thể làm gì nhiều để ngăn ngừa nhân viên bị ốm.",
      "author": "a user"
    },
    "90776": {
      "id": 3683173,
      "text": "Không, nhưng chúng ta có thể yêu cầu mọi người tránh đặt lịch nghỉ phép trong ba tuần đầu tiên đó.",
      "author": "a user"
    },
    "90777": {
      "id": 3683174,
      "text": "Được rồi, tôi sẽ gửi email hôm nay.",
      "author": "ChatGPT4.1"
    }
  }
