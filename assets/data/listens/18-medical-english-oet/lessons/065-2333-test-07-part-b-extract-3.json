  "translations": {
    "91791": {
      "id": 3684491,
      "text": "À, Brian, ở Bệnh viện Tư nhân Belmont, họ có một chương trình CBT,",
      "author": "ChatGPT4.1"
    },
    "91792": {
      "id": 3684492,
      "text": "CBT là viết tắt của Liệu pháp Nhận thức Hành vi.",
      "author": "ChatGPT4.1"
    },
    "91793": {
      "id": 3684493,
      "text": "Chương trình này tập trung vào việc thay đổi các kiểu suy nghĩ của bạn và cách bạn phản ứng với những tình huống khó khăn.",
      "author": "ChatGPT4.1"
    },
    "91794": {
      "id": 3684494,
      "text": "Tôi hiểu rồi.",
      "author": "ChatGPT4.1"
    },
    "91795": {
      "id": 3684495,
      "text": "Nó sẽ giúp bạn có kỹ năng và kiến thức để kiểm soát cảm xúc tốt hơn, cũng như cảm thấy hài lòng về bản thân và cuộc sống của mình.",
      "author": "ChatGPT4.1"
    },
    "91796": {
      "id": 3684496,
      "text": "Nghe có vẻ đây là một điều tốt cho tôi đấy.",
      "author": "ChatGPT4.1"
