  "translations": {
    "91070": {
      "id": 3683476,
      "text": "John, có một đơn khiếu nại bằng văn bản từ ông Boeing ở phòng 6.",
      "author": "ChatGPT4.1"
    },
    "91071": {
      "id": 3683477,
      "text": "Ông ấy nói rằng mình đã yêu cầu một phòng riêng vào tối qua, mà anh đã hứa sẽ sắp xếp.",
      "author": "ChatGPT4.1"
    },
    "91072": {
      "id": 3683478,
      "text": "Sau đó anh đã phớt lờ những nỗ lực của ông ấy khi muốn nói chuyện với anh,",
      "author": "ChatGPT4.1"
    },
    "91073": {
      "id": 3683479,
      "text": "ngay cả khi ông ấy đang rất đau đớn.",
      "author": "ChatGPT4.1"
    },
    "91074": {
      "id": 3683480,
      "text": "Chuyện gì đã xảy ra vậy?",
      "author": "ChatGPT4.1"
    },
    "91075": {
      "id": 3683481,
      "text": "Ừm... ông ấy yêu cầu được chuyển đi vì cảm thấy khó chịu và rất đau đớn.",
      "author": "a user"
    },
    "91076": {
      "id": 3683482,
      "text": "Thật không may, tình trạng của bà Stewart đã chuyển biến xấu và cần được theo dõi chặt chẽ hơn.",
      "author": "a user"
    },
    "91077": {
      "id": 3683483,
      "text": "Tôi cần ưu tiên khu điều trị cho phù hợp.",
      "author": "ChatGPT4.1"
    },
    "91078": {
      "id": 3683484,
      "text": "Ông ấy đã nhận thuốc giảm đau đúng giờ.",
      "author": "ChatGPT4.1"
    },
    "91079": {
      "id": 3683485,
      "text": "Tôi hiểu rồi.",
      "author": "ChatGPT4.1"
    },
    "91080": {
      "id": 3683486,
      "text": "Bình thường tôi sẽ trao đổi với ông ấy, nhưng thời gian không cho phép.",
      "author": "ChatGPT4.1"
    },
    "91081": {
      "id": 3683487,
      "text": "Tôi buộc phải ở nơi cần tôi nhất, đó là chăm sóc bà Stewart.",
      "author": "ChatGPT4.1"
    },
    "91082": {
      "id": 3683488,
      "text": "Công việc của anh là phải sắp xếp ưu tiên, và anh đã làm đúng như vậy.",
      "author": "ChatGPT4.1"
    },
    "91083": {
      "id": 3683489,
      "text": "Tôi sẽ vào nói chuyện với ông ấy, và xem ông ấy có còn muốn theo đuổi vụ việc hay không.",
      "author": "a user"
    },
    "91084": {
      "id": 3683490,
      "text": "Vì đây là một cáo buộc khá nghiêm trọng.",
      "author": "ChatGPT4.1"
    },
    "91085": {
      "id": 3683491,
      "text": "Vâng.",
      "author": "ChatGPT4.1"
    }
  }
}
