  "translations": {
    "90084": {
      "id": 3682506,
      "text": "Vậy huấn luyện viên đã nói chúng ta phải làm gì?",
      "author": "ChatGPT4.1"
    },
    "90085": {
      "id": 3682507,
      "text": "Chúng ta phải xem qua những ghi chú hồ sơ này... tổng cộng mười bộ,",
      "author": "ChatGPT4.1"
    },
    "90086": {
      "id": 3682508,
      "text": "và quyết định bệnh nhân nào cần được chuyển đến bác sĩ tư vấn ngay lập tức, và bệnh nhân nào có thể chờ.",
      "author": "ChatGPT4.1"
    },
    "90087": {
      "id": 3682509,
      "text": "Ồ, đúng rồi.",
      "author": "ChatGPT4.1"
    },
    "90088": {
      "id": 3682510,
      "text": "Và tôi có nghe anh ấy nói rằng chỉ được phép giới thiệu một số lượng nhất định không?",
      "author": "ChatGPT4.1"
    },
    "90089": {
      "id": 3682511,
      "text": "Không hẳn.",
      "author": "ChatGPT4.1"
    },
    "90090": {
      "id": 3682512,
      "text": "Anh ấy nói chúng ta nên xếp thứ tự họ theo mức độ nghiêm trọng của các triệu chứng",
      "author": "ChatGPT4.1"
    },
    "90091": {
      "id": 3682513,
      "text": "và các yếu tố khác thể hiện trong hồ sơ bệnh án.",
      "author": "ChatGPT4.1"
    },
    "90092": {
      "id": 3682514,
      "text": "Khi chúng ta đã đồng ý với danh sách của mình, chúng ta phải so sánh với một cặp thực tập sinh khác.",
      "author": "ChatGPT4.1"
    },
    "90093": {
      "id": 3682515,
      "text": "Được rồi.",
      "author": "ChatGPT4.1"
    },
    "90094": {
      "id": 3682516,
      "text": "Vậy thì bắt đầu thôi.",
      "author": "ChatGPT4.1"
    }
  }
