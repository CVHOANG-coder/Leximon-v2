  "translations": {
    "89746": {
      "id": 3678500,
      "text": "Quản lý giường bệnh vừa mới gọi điện.",
      "author": "ChatGPT4.1"
    },
    "89747": {
      "id": 3678501,
      "text": "Ông ấy muốn chúng ta giải phóng ba chỗ trong khu điều trị hôm nay.",
      "author": "ChatGPT4.1"
    },
    "89748": {
      "id": 3678502,
      "text": "Ôi, chuyện này cứ không bao giờ dứt!",
      "author": "ChatGPT4.1"
    },
    "89749": {
      "id": 3678503,
      "text": "Hãy xem chúng ta có thể làm gì.",
      "author": "ChatGPT4.1"
    },
    "89750": {
      "id": 3678504,
      "text": "Không ai sẵn sàng xuất viện cả.",
      "author": "ChatGPT4.1"
    },
    "89751": {
      "id": 3678505,
      "text": "Nhưng chúng ta có thể thử thúc đẩy chuyển tuyến cho ông Davison sang bệnh viện cộng đồng để phục hồi chức năng.",
      "author": "ChatGPT4.1"
    },
    "89752": {
      "id": 3678506,
      "text": "Hồ sơ của ông ấy đâu?",
      "author": "ChatGPT4.1"
    },
    "89753": {
      "id": 3678507,
      "text": "Vâng, nhưng ông ấy đã được đánh giá chưa?",
      "author": "ChatGPT4.1"
    },
    "89754": {
      "id": 3678508,
      "text": "Họ đều đi dự hội nghị ngày hôm qua và ngày hôm kia.",
      "author": "a user"
    },
    "89755": {
      "id": 3678509,
      "text": "Tôi nghĩ ông ấy đã bị sót lại rồi.",
      "author": "ChatGPT4.1"
    },
    "89756": {
      "id": 3678510,
      "text": "Nhưng bác sĩ Ammat đã giúp ông ấy ổn định về mặt y tế và ký xác nhận rồi nên...",
      "author": "ChatGPT4.1"
    },
    "89757": {
      "id": 3678511,
      "text": "ông ấy nên là người tiếp theo được chuyển đi.",
      "author": "ChatGPT4.1"
    },
    "89758": {
      "id": 3678512,
      "text": "Tôi sẽ đưa ông ấy đến đó càng sớm càng tốt trước khi họ giao chỗ cho người khác.",
      "author": "a user"
    },
    "89759": {
      "id": 3678513,
      "text": "Tôi sẽ gọi cho họ ngay lập tức.",
      "author": "ChatGPT4.1"
    }
  }
}
