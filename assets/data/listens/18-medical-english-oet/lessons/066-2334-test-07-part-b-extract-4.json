  "translations": {
    "91808": {
      "id": 3680678,
      "text": "Chào bác sĩ Jones, tôi là Helen từ bệnh viện PA.",
      "author": "ChatGPT4.1"
    },
    "91809": {
      "id": 3680679,
      "text": "Tôi đang gọi về bệnh nhân của bác sĩ, bà Singh, ở phòng 231.",
      "author": "ChatGPT4.1"
    },
    "91810": {
      "id": 3680680,
      "text": "Bà ấy là bệnh nhân 70 tuổi, ngày thứ hai sau phẫu thuật thay khớp háng,",
      "author": "ChatGPT4.1"
    },
    "91811": {
      "id": 3680681,
      "text": "và tối nay, bà ấy than phiền về cơn đau dữ dội.",
      "author": "ChatGPT4.1"
    },
    "91812": {
      "id": 3680682,
      "text": "Bà ấy đã nhận tất cả các liều kháng sinh theo lịch trình",
      "author": "ChatGPT4.1"
    },
    "91813": {
      "id": 3680683,
      "text": "nhưng bắt đầu sốt 38,3 độ vào lúc nửa đêm.",
      "author": "ChatGPT4.1"
    },
    "91814": {
      "id": 3680684,
      "text": "Vết mổ của bà ấy cũng khá đỏ và tôi nhận thấy có mủ mới chảy ra.",
      "author": "ChatGPT4.1"
    },
    "91815": {
      "id": 3680685,
      "text": "Tôi lo lắng rằng có thể bà ấy đã bị nhiễm trùng",
      "author": "ChatGPT4.1"
    },
    "91816": {
      "id": 3680686,
      "text": "và tôi muốn bác sĩ đến xem bà Singh càng sớm càng tốt.",
      "author": "ChatGPT4.1"
    },
    "91817": {
      "id": 3680687,
      "text": "Nhưng trong lúc chờ đợi, tôi muốn hỏi bác sĩ muốn tôi thực hiện các bước nào,",
      "author": "ChatGPT4.1"
    },
    "91818": {
      "id": 3680688,
      "text": "liệu bác sĩ có muốn tôi lấy xét nghiệm công thức máu hoặc cấy máu không.",
      "author": "ChatGPT4.1"
    }
  }
