  "translations": {
    "91455": {
      "id": 3683982,
      "text": "Chào ông Hartley, mời ông ngồi xuống.",
      "author": "ChatGPT4.1"
    },
    "91456": {
      "id": 3683983,
      "text": "Tôi nghe nói ông gặp nhiều khó khăn hơn kể từ lần cuối tôi gặp ông?",
      "author": "ChatGPT4.1"
    },
    "91457": {
      "id": 3683984,
      "text": "Vâng, đúng vậy.",
      "author": "ChatGPT4.1"
    },
    "91458": {
      "id": 3683985,
      "text": "Tôi cứ nôn mửa và cảm thấy rất tệ.",
      "author": "ChatGPT4.1"
    },
    "91459": {
      "id": 3683986,
      "text": "Tôi không thể tiếp tục như thế này nữa.",
      "author": "ChatGPT4.1"
    },
    "91460": {
      "id": 3683987,
      "text": "Có vẻ như bước tiếp theo sẽ là đưa ông vào bệnh viện để bắt đầu điều trị thêm.",
      "author": "ChatGPT4.1"
    },
    "91461": {
      "id": 3683988,
      "text": "Tôi nghĩ ông sẽ cần điều trị thẩm phân phúc mạc.",
      "author": "a user"
    },
    "91462": {
      "id": 3683989,
      "text": "Cái đó là gì vậy bác sĩ?",
      "author": "ChatGPT4.1"
    },
    "91463": {
      "id": 3683990,
