      "text": "Được rồi, chúng ta cần phải tiến hành cuộc họp tổng kết.",
      "author": "ChatGPT4.1"
    },
    "91118": {
      "id": 3683533,
      "text": "Jackie, bạn có ý kiến gì về ca này không?",
      "author": "ChatGPT4.1"
    },
    "91119": {
      "id": 3683534,
      "text": "Chúng ta bắt đầu trễ vì phải chờ giấy đồng ý phẫu thuật được đưa vào,",
      "author": "ChatGPT4.1"
    },
    "91120": {
      "id": 3683535,
      "text": "nhưng tôi đã trao đổi với bác sĩ nội trú trẻ,",
      "author": "ChatGPT4.1"
    },
    "91121": {
      "id": 3683536,
      "text": "và tôi nghĩ chỉ là có một vài sự hiểu lầm nhỏ, giờ đã giải quyết xong.",
      "author": "ChatGPT4.1"
    },
    "91122": {
      "id": 3683537,
      "text": "Đúng vậy, sáng nay chúng ta bận ở phòng khám,",
      "author": "ChatGPT4.1"
    },
    "91123": {
      "id": 3683538,
      "text": "nhưng chúng ta cũng bị trễ vào phòng này vì ca trước làm quá giờ,",
      "author": "ChatGPT4.1"
    },
    "91124": {
      "id": 3683539,
      "text": "khiến cho chúng ta phải lùi lại.",
      "author": "ChatGPT4.1"
    },
    "91125": {
      "id": 3683540,
      "text": "Điều đó dường như đang trở thành chuyện thường xuyên với đội đó.",
      "author": "ChatGPT4.1"
    },
    "91126": {
      "id": 3683541,
      "text": "Tôi sẽ đề nghị quản lý điều dưỡng của chúng ta điều chỉnh lại lịch của họ dựa trên lịch sử các ca gần đây.",
      "author": "ChatGPT4.1"
    },
    "91127": {
      "id": 3683542,
      "text": "Chúng ta cũng phải chờ khá lâu mới lấy được phim di động từ khoa X-quang.",
      "author": "ChatGPT4.1"
    },
    "91128": {
      "id": 3683543,
      "text": "Có nhiều phòng cùng lúc yêu cầu phim và bên X-quang dường như thiếu người.",
      "author": "ChatGPT4.1"
    },
    "91129": {
      "id": 3683544,
      "text": "Điều đó không thường xảy ra với họ nhưng chúng ta nên chú ý,",
      "author": "ChatGPT4.1"
    },
    "91130": {
      "id": 3683545,
      "text": "và nếu điều đó xảy ra nữa thì chúng ta sẽ báo cáo như một vấn đề cần quan tâm.",
      "author": "ChatGPT4.1"
    }
  }
