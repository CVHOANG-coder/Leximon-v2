  "translations": {
    "90422": {
      "id": 3682805,
      "text": "Vậy vấn đề là gì?",
      "author": "ChatGPT4.1"
    },
    "90423": {
      "id": 3682806,
      "text": "Tôi cảm thấy mình thật thất bại.",
      "author": "ChatGPT4.1"
    },
    "90424": {
      "id": 3682807,
      "text": "Tôi chắc rằng mọi người nghĩ rằng nếu tôi cố gắng hơn thì tôi có thể giảm cân.",
      "author": "ChatGPT4.1"
    },
    "90425": {
      "id": 3682808,
      "text": "Có lẽ tôi cần nhiều ý chí hơn.",
      "author": "ChatGPT4.1"
    },
    "90426": {
      "id": 3682809,
      "text": "Trước tiên, bạn đã làm rất tốt khi tìm kiếm sự trợ giúp y tế.",
      "author": "ChatGPT4.1"
    },
    "90427": {
      "id": 3682810,
      "text": "Thực ra, thừa cân hoặc béo phì là một vấn đề y tế,",
      "author": "ChatGPT4.1"
    },
    "90428": {
      "id": 3682811,
      "text": "bởi vì thừa cân làm thay đổi cách cơ thể bạn hoạt động.",
      "author": "ChatGPT4.1"
    },
    "90429": {
      "id": 3682812,
      "text": "Cảm ơn, nhưng tôi thực sự cảm thấy đó là lỗi của tôi khi trở nên như vậy.",
      "author": "ChatGPT4.1"
    },
    "90430": {
      "id": 3682813,
      "text": "Tôi hiểu những gì bạn nói, nhưng...",
      "author": "ChatGPT4.1"
    },
    "90431": {
      "id": 3682814,
      "text": "xin hãy hiểu rằng ngày nay chúng tôi coi béo phì là một căn bệnh,",
      "author": "ChatGPT4.1"
    },
    "90432": {
      "id": 3682815,
      "text": "giống như cao huyết áp hoặc hen suyễn.",
      "author": "ChatGPT4.1"
    },
    "90433": {
      "id": 3682816,
      "text": "Bạn biết đấy, các tín hiệu từ cơ thể lên não không còn hoạt động đúng khi bạn bị thừa cân.",
      "author": "ChatGPT4.1"
    },
    "90434": {
      "id": 3682817,
      "text": "Và theo thời gian, bạn sẽ cảm thấy ít no hơn, ngay cả khi bạn ăn cùng một lượng thức ăn.",
      "author": "ChatGPT4.1"
    },
    "90435": {
      "id": 3682818,
      "text": "Và khi bạn giảm lượng calo, cơ thể bạn sẽ cố sử dụng ít năng lượng hơn để giữ cân nặng không đổi.",
      "author": "ChatGPT4.1"
    }
  }
}
