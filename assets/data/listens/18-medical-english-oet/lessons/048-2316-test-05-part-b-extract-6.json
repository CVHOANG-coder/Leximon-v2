  "translations": {
    "91145": {
      "id": 3683560,
      "text": "Trước khi thay băng, nếu có bất kỳ hướng dẫn cụ thể nào về cách chăm sóc bà Harris hoặc vết loét,",
      "author": "ChatGPT4.1"
    },
    "91146": {
      "id": 3683561,
      "text": "bạn sẽ được thông báo vào đầu ca làm việc.",
      "author": "ChatGPT4.1"
    },
    "91147": {
      "id": 3683562,
      "text": "Bạn sẽ không bao giờ phải tự mình truy cập hồ sơ của bà ấy và xem qua tất cả mọi thứ.",
      "author": "ChatGPT4.1"
    },
    "91148": {
      "id": 3683563,
      "text": "Ở đây có một danh sách kiểm tra thiết bị với loại dung dịch vệ sinh và kẹp cần thiết,",
      "author": "ChatGPT4.1"
    },
    "91149": {
      "id": 3683564,
      "text": "vì vậy bạn sẽ nhớ điều đó một cách dễ dàng.",
      "author": "ChatGPT4.1"
    },
    "91150": {
      "id": 3683565,
      "text": "Bạn sẽ thấy rằng khẩu trang không bắt buộc, mặc dù một số y tá thích sử dụng.",
      "author": "ChatGPT4.1"
    },
    "91151": {
      "id": 3683566,
      "text": "Như bạn đã biết rõ, bạn nên trò chuyện ngắn gọn với bà Harris về những gì bạn sẽ thực hiện,",
      "author": "ChatGPT4.1"
    },
    "91152": {
      "id": 3683567,
      "text": "ngay cả khi bà ấy đã quen với quy trình này.",
      "author": "ChatGPT4.1"
    },
    "91153": {
      "id": 3683568,
      "text": "Bây giờ, hãy chú ý ghi chép tình trạng da xung quanh vết thương,",
      "author": "ChatGPT4.1"
    },
    "91154": {
      "id": 3683569,
      "text": "cùng với sự xuất hiện của bất kỳ dấu hiệu viêm, đổi màu hay mùi nào.",
      "author": "ChatGPT4.1"
    },
    "91155": {
      "id": 3683570,
      "text": "Việc đánh giá này phải thật kỹ lưỡng.",
      "author": "ChatGPT4.1"
    },
    "91156": {
      "id": 3683571,
      "text": "Sau đó hãy đặt bà ấy vào tư thế thoải mái rồi bạn có thể bắt đầu.",
      "author": "ChatGPT4.1"
    }
  }
}
