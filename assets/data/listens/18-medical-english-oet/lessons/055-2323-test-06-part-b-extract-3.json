  "translations": {
    "91445": {
      "id": 3683961,
      "text": "Ong bắp cày châu Âu ăn thịt và các sản phẩm từ thịt như thức ăn cho chó và thức ăn thừa từ tiệc nướng.",
      "author": "ChatGPT4.1"
    },
    "91446": {
      "id": 3683962,
      "text": "Chúng cũng thích tìm kiếm đồ ngọt, đồ uống và đánh cắp mật ong từ các tổ ong.",
      "author": "ChatGPT4.1"
    },
    "91447": {
      "id": 3683963,
      "text": "Nọc của chúng không có ngạnh như ong mật.",
      "author": "ChatGPT4.1"
    },
    "91448": {
      "id": 3683964,
      "text": "Điều này có nghĩa là một con ong bắp cày có thể đốt nhiều lần.",
      "author": "ChatGPT4.1"
    },
    "91449": {
      "id": 3683965,
      "text": "Độc tố trong nọc sẽ gây ra phản ứng mạnh và ở một số người có thể gây ra phản ứng dị ứng.",
      "author": "a user"
    },
    "91450": {
      "id": 3683966,
      "text": "Vì chúng bị thu hút bởi thức ăn, nhiều vết đốt của ong bắp cày xuất hiện ở trong hoặc quanh miệng.",
      "author": "ChatGPT4.1"
    },
    "91451": {
      "id": 3683967,
      "text": "Đây là những vị trí nguy hiểm nhất cho vết đốt, vì có thể gây sưng tấy.",
      "author": "ChatGPT4.1"
    },
    "91452": {
      "id": 3683968,
      "text": "Các phản ứng nhẹ bao gồm sưng đau ở môi,",
      "author": "ChatGPT4.1"
    },
    "91453": {
      "id": 3683969,
      "text": "trong khi ở trường hợp nghiêm trọng, có thể tắc nghẽn khí quản do sưng tấy,",
      "author": "ChatGPT4.1"
    },
    "91454": {
      "id": 3683970,
      "text": "và trong những trường hợp nghiêm trọng nhất, điều này thậm chí có thể dẫn đến tử vong.",
      "author": "a user"
    }
  }
}
