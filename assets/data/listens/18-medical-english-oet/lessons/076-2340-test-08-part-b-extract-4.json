  "translations": {
    "92055": {
      "id": 3684886,
      "text": "Bây giờ chuyển sang Margaret Smith,",
      "author": "ChatGPT4.1"
    },
    "92056": {
      "id": 3684887,
      "text": "bà ấy là một phụ nữ 68 tuổi được con trai là Geoff đưa vào phòng cấp cứu hai ngày trước.",
      "author": "ChatGPT4.1"
    },
    "92057": {
      "id": 3684888,
      "text": "Margaret được chẩn đoán thoái hóa thùy trán - thái dương cách đây 4 năm",
      "author": "ChatGPT4.1"
    },
    "92058": {
      "id": 3684889,
      "text": "và đã dần dần suy giảm trong thời gian đó.",
      "author": "ChatGPT4.1"
    },
    "92059": {
      "id": 3684890,
      "text": "Bà ấy cũng bị tăng huyết áp và trầm cảm.",
      "author": "ChatGPT4.1"
    },
    "92060": {
      "id": 3684891,
      "text": "Bác sĩ đa khoa của bà gần đây đã bắt đầu cho bà dùng thuốc chống trầm cảm.",
      "author": "ChatGPT4.1"
    },
    "92061": {
      "id": 3684892,
      "text": "Bà sống tại nhà với con trai, người là người chăm sóc chính toàn thời gian của bà,",
      "author": "ChatGPT4.1"
    },
    "92062": {
      "id": 3684893,
      "text": "nhưng nhân viên y tế không thể liên lạc được với anh ấy từ khi bà nhập viện.",
      "author": "ChatGPT4.1"
    },
    "92063": {
      "id": 3684894,
      "text": "Gần đây Margaret đã có những thay đổi trong hành vi xã hội.",
      "author": "ChatGPT4.1"
    },
    "92064": {
      "id": 3684895,
      "text": "Bà ấy đã từ chối ăn ở nhà và các y tá ở khoa cho biết bà ấy giữ thức ăn trong miệng.",
      "author": "ChatGPT4.1"
    },
    "92065": {
      "id": 3684896,
      "text": "Bà ấy từ chối uống thuốc.",
      "author": "ChatGPT4.1"
    },
    "92066": {
      "id": 3684897,
      "text": "Bà ấy rất bồn chồn, kích động khi ở khoa.",
      "author": "ChatGPT4.1"
    },
    "92067": {
      "id": 3684898,
      "text": "Và bà ấy đã la hét khi nhân viên y tế cố gắng giúp đỡ bà",
      "author": "ChatGPT4.1"
    },
    "92068": {
      "id": 3684899,
      "text": "và đôi khi bà ấy bị lú lẫn và có hành vi hung hăng về thể chất.",
      "author": "ChatGPT4.1"
    },
    "92069": {
      "id": 3684900,
      "text": "Bà ấy cũng thường xuyên gọi tên con trai mình.",
      "author": "ChatGPT4.1"
    }
  }
}
