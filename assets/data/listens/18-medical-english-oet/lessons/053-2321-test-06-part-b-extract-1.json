  "translations": {
    "91415": {
      "id": 3683931,
      "text": "Bác sĩ Khan, bác sĩ có rảnh một chút không?",
      "author": "ChatGPT4.1"
    },
    "91416": {
      "id": 3683932,
      "text": "Tôi muốn nói chuyện với bác sĩ về polypeptide.",
      "author": "ChatGPT4.1"
    },
    "91417": {
      "id": 3683933,
      "text": "Được thôi, bác sĩ Jones.",
      "author": "ChatGPT4.1"
    },
    "91418": {
      "id": 3683934,
      "text": "Polly là một bé gái 6 tuổi có tiền sử hen suyễn và chàm, đã nhập viện hôm qua vì cơn hen suyễn kịch phát.",
      "author": "a user"
    },
    "91419": {
      "id": 3683935,
      "text": "Bé đến khám với triệu chứng khó thở và ho sau khi thăm ông bà hút thuốc.",
      "author": "a user"
    },
    "91420": {
      "id": 3683936,
      "text": "Bé đáp ứng tốt với albuterol và prednisolone tại khoa cấp cứu,",
      "author": "ChatGPT4.1"
    },
    "91421": {
      "id": 3683937,
      "text": "nhưng vẫn phải nhập viện do thiếu oxy kéo dài khi thở không khí phòng.",
      "author": "ChatGPT4.1"
    },
    "91422": {
      "id": 3683938,
      "text": "Bé cũng đã được cho uống một liều acetaminophen gần đây vì sốt.",
      "author": "a user"
    },
    "91423": {
      "id": 3683939,
      "text": "Hiện nhiệt độ của bé là 39,7 độ C.",
      "author": "ChatGPT4.1"
    },
    "91424": {
      "id": 3683940,
      "text": "Tình trạng của bé khi nghe tim phổi như thế nào?",
      "author": "a user"
    },
    "91425": {
      "id": 3683941,
      "text": "Có tiếng rít thở ra rõ rệt khắp phổi trái và ở vùng trên bên phải.",
      "author": "ChatGPT4.1"
    },
    "91426": {
      "id": 3683942,
      "text": "Âm thở giảm và không có tiếng rít ở vùng đáy phổi bên phải.",
      "author": "ChatGPT4.1"
    },
    "91427": {
      "id": 3683943,
      "text": "Có thể là viêm phổi do vi khuẩn không?",
      "author": "ChatGPT4.1"
    },
    "91428": {
      "id": 3683944,
      "text": "Đó cũng là điều tôi đang nghĩ tới.",
      "author": "ChatGPT4.1"
    },
    "91429": {
      "id": 3683945,
      "text": "Tôi sẽ gửi bé đi làm đầy đủ các xét nghiệm để xác nhận.",
      "author": "a user"
    },
    "91430": {
      "id": 3683946,
      "text": "Cảm ơn bác sĩ Khan.",
      "author": "ChatGPT4.1"
    }
  }
