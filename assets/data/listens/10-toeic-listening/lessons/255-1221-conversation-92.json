    "55115": {
      "id": 966843,
      "text": "Chắc chắn rồi! Tôi rất thích cách bố trí mới.",
      "author": "a user"
    },
    "55117": {
      "id": 966845,
      "text": "Trước đây tôi gặp khó khăn khi di chuyển xung quanh các khách hàng khác,",
