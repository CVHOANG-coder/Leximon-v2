  "translations": {
    "55567": {
      "id": 1203042,
      "text": "Họ mở cửa lúc 10 giờ sáng. Vì vậy, hãy ghé qua để nhận gói kẹo miễn phí của bạn.",
      "author": "a user"
    },
    "55561": {
      "id": 2611323,
      "text": "Chào buổi tối quý khán giả, tôi là Audrina Patts, đến từ bản tin kênh 8.",
      "author": "ChatGPT4.1"
    },
    "55562": {
      "id": 2611324,
      "text": "Hiện tôi đang có mặt tại Quảng trường Stanley, ngay trước cửa hàng Jolly Candy.",
      "author": "ChatGPT4.1"
    },
    "55563": {
      "id": 2611325,
      "text": "Chúng tôi sẽ tổ chức lễ khai trương cửa hàng bánh kẹo vào ngày mai!",
      "author": "ChatGPT4.1"
    },
    "55564": {
      "id": 2611326,
      "text": "Đây là chi nhánh đầu tiên tại bang của chúng ta,",
      "author": "ChatGPT4.1"
    },
    "55565": {
      "id": 2611327,
      "text": "nhưng cửa hàng bánh kẹo có trụ sở tại New York này rất nổi tiếng trên toàn quốc.",
      "author": "ChatGPT4.1"
    },
    "55566": {
      "id": 2611328,
      "text": "Công ty muốn chào đón thành phố của chúng ta bằng cách tặng túi bánh kẹo miễn phí cho 50 người đầu tiên vào sáng mai.",
      "author": "ChatGPT4.1"
    },
    "55568": {
      "id": 2611329,
      "text": "Họ cũng giảm giá 10% trong suốt tuần này,",
      "author": "ChatGPT4.1"
    },
    "55569": {
      "id": 2611330,
      "text": "vì vậy nếu bạn không thể đến vào ngày mai, hãy ghé qua trước thứ Sáu nhé!",
      "author": "ChatGPT4.1"
    }
  }
}
