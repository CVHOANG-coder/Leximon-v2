  "translations": {
    "55019": {
      "id": 963737,
      "text": "nhưng chúng ta sẽ nghỉ ngơi nhiều lần để uống nước và chụp ảnh.",
      "author": "a user"
    },
    "55021": {
      "id": 963739,
      "text": "À... Nói cho bạn biết là không có thùng rác nào ở trên đỉnh cả,",
      "author": "a user"
    },
    "55023": {
      "id": 963741,
      "text": "Chúng ta có thể vứt bỏ nó vào cuối ngày hôm nay vì chúng ta muốn đảm bảo việc bảo vệ môi trường.",
      "author": "a user"
    },
    "55014": {
      "id": 2603199,
      "text": "Xin chào mọi người!",
      "author": "ChatGPT4.1"
    },
    "55015": {
      "id": 2603200,
      "text": "Chào mừng các bạn đến với Công viên Olympic!",
      "author": "ChatGPT4.1"
    },
    "55016": {
      "id": 2603201,
      "text": "Tôi là Sarah và hôm nay tôi sẽ hướng dẫn các bạn lên đỉnh núi Olympic.",
      "author": "ChatGPT4.1"
    },
    "55017": {
      "id": 2603202,
      "text": "Tôi mong được chỉ cho các bạn những loài hoa đặc biệt ở khu vực này và kể cho các bạn nghe về lịch sử của những ngọn núi cũng như các thành phố xung quanh.",
      "author": "ChatGPT4.1"
    },
    "55018": {
      "id": 2603203,
      "text": "Chúng ta sẽ mất khoảng bốn tiếng để lên tới đỉnh,",
      "author": "ChatGPT4.1"
    },
    "55020": {
      "id": 2603204,
      "text": "Khi chúng ta lên đến đỉnh, cũng sẽ là giờ ăn trưa, nên chúng ta có thể thưởng thức buổi dã ngoại ở đó.",
      "author": "ChatGPT4.1"
    },
    "55022": {
      "id": 2603205,
      "text": "vì vậy hãy bỏ rác vào trong ba lô của bạn và mang xuống cùng nhé.",
      "author": "ChatGPT4.1"
    }
  }
