  "translations": {
    "71506": {
      "id": 2583703,
      "text": "Cảm ơn bạn đã liên hệ với Swift Home Services.",
      "author": "ChatGPT4.1"
    },
    "71507": {
      "id": 2583704,
      "text": "Tôi có thể giúp gì cho bạn hôm nay?",
      "author": "ChatGPT4.1"
    },
    "71508": {
      "id": 2583705,
      "text": "Tôi đã nghe về công ty của bạn từ một người bạn.",
      "author": "ChatGPT4.1"
    },
    "71509": {
      "id": 2583706,
      "text": "Tôi quan tâm đến việc đặt lịch cho một số dịch vụ dọn dẹp.",
      "author": "ChatGPT4.1"
    },
    "71510": {
      "id": 2583707,
      "text": "Tôi cần lau sàn bếp và làm sạch mặt bếp.",
      "author": "ChatGPT4.1"
    },
    "71511": {
      "id": 2583708,
      "text": "Ngoài ra, tôi muốn các phòng tắm được khử trùng.",
      "author": "ChatGPT4.1"
    },
    "71512": {
      "id": 2583709,
      "text": "Chúng tôi chắc chắn có thể thực hiện những công việc đó.",
      "author": "ChatGPT4.1"
    },
    "71513": {
      "id": 2583710,
      "text": "Nếu bạn cũng muốn giặt thảm,",
      "author": "ChatGPT4.1"
    },
    "71514": {
      "id": 2583711,
      "text": "chi phí đó sẽ là thêm 75 bảng Anh.",
      "author": "ChatGPT4.1"
    },
    "71515": {
      "id": 2583712,
      "text": "Tôi cảm ơn lời đề nghị, nhưng hiện tại tôi chỉ cần dọn dẹp cơ bản.",
      "author": "ChatGPT4.1"
    },
    "71516": {
      "id": 2583713,
      "text": "Không vấn đề gì cả.",
      "author": "ChatGPT4.1"
    },
    "71517": {
      "id": 2583714,
      "text": "Bước tiếp theo sẽ là sắp xếp một buổi ước tính tại nhà,",
      "author": "ChatGPT4.1"
    },
    "71518": {
      "id": 2583715,
      "text": "vì giá của chúng tôi dựa trên diện tích cần làm sạch.",
      "author": "ChatGPT4.1"
    },
    "71519": {
      "id": 2583716,
      "text": "Tuần sau bạn có tiện không?",
      "author": "ChatGPT4.1"
    },
    "71520": {
      "id": 2583717,
      "text": "Vâng.",
      "author": "ChatGPT4.1"
    },
    "71521": {
      "id": 2583718,
      "text": "10 giờ sáng thứ Năm sẽ là lý tưởng.",
      "author": "ChatGPT4.1"
    }
  }
}
