  "translations": {
    "71531": {
      "id": 2583835,
      "text": "Bạn đang lắng nghe ZRM 102,",
      "author": "ChatGPT4.1"
    },
    "71532": {
      "id": 2583836,
      "text": "mang đến cho bạn tất cả những cập nhật và sự kiện mới nhất.",
      "author": "ChatGPT4.1"
    },
    "71533": {
      "id": 2583837,
      "text": "Cuối tuần này, Lễ hội Âm nhạc và Nghệ thuật thường niên sẽ thắp sáng Enfield,",
      "author": "ChatGPT4.1"
    },
    "71534": {
      "id": 2583838,
      "text": "làm say mê cả những người yêu nghệ thuật lẫn âm nhạc.",
      "author": "ChatGPT4.1"
    },
    "71535": {
      "id": 2583839,
      "text": "Kỷ niệm hơn 15 năm, sự kiện sôi động này đã trở thành điểm hẹn được cộng đồng yêu thích,",
      "author": "ChatGPT4.1"
    },
    "71536": {
      "id": 2583840,
      "text": "với phiên bản năm nay hứa hẹn dàn nghệ sĩ phong phú nhất từ trước đến nay.",
      "author": "ChatGPT4.1"
    },
    "71537": {
      "id": 2583841,
      "text": "Các nghệ sĩ đến từ chín quốc gia sẽ biểu diễn,",
      "author": "ChatGPT4.1"
    },
    "71538": {
      "id": 2583842,
      "text": "trong đó Nhật Bản có màn ra mắt đầy ấn tượng.",
      "author": "ChatGPT4.1"
    },
    "71539": {
      "id": 2583843,
      "text": "Những người tham dự lễ hội nên lưu ý sự thay đổi địa điểm năm nay:",
      "author": "ChatGPT4.1"
    },
    "71540": {
      "id": 2583844,
      "text": "sự kiện sẽ được tổ chức tại Elmwood Meadows, ngay bên cạnh đại lộ Riverstone.",
      "author": "ChatGPT4.1"
    },
    "71541": {
      "id": 2583845,
      "text": "Địa điểm mới này thay thế cho khu Briarwood Park thường lệ, vốn đang được cải tạo gần đây,",
      "author": "ChatGPT4.1"
    },
    "71542": {
      "id": 2583846,
      "text": "đảm bảo mang lại trải nghiệm mới mẻ cho tất cả khách tham dự.",
      "author": "ChatGPT4.1"
    },
    "71543": {
      "id": 2583847,
      "text": "Hãy tiếp tục đón nghe khi chúng tôi chuyển sang cập nhật về các sự kiện thể thao địa phương diễn ra trong tuần này!",
      "author": "ChatGPT4.1"
    }
  }
}
