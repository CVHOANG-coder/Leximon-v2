  "translations": {
    "69055": {
      "id": 2588026,
      "text": "Này Margot, tôi nghe nói bạn đã thử một số đường mòn leo núi mới.",
      "author": "ChatGPT4.1"
    },
    "69056": {
      "id": 2588027,
      "text": "Bạn có biết một nhóm trong văn phòng thường đi bộ đường dài vào cuối tuần không?",
      "author": "ChatGPT4.1"
    },
    "69057": {
      "id": 2588028,
      "text": "Không, tôi không biết!",
      "author": "ChatGPT4.1"
    },
    "69058": {
      "id": 2588029,
      "text": "Nghe hay đấy. Hoạt động đó như thế nào vậy?",
      "author": "ChatGPT4.1"
    },
    "69059": {
      "id": 2588030,
      "text": "Chúng tôi thường chọn một đường mòn khác nhau vào mỗi sáng Chủ nhật.",
      "author": "ChatGPT4.1"
    },
    "69060": {
      "id": 2588031,
      "text": "Một số người rất nghiêm túc về việc leo núi, trong khi những người khác chỉ đến để hít thở không khí trong lành và ngắm cảnh.",
      "author": "ChatGPT4.1"
    },
    "69061": {
      "id": 2588032,
      "text": "Bạn không cần phải có nhiều kinh nghiệm để tham gia đâu.",
      "author": "ChatGPT4.1"
    },
    "69062": {
      "id": 2588033,
      "text": "Biết vậy thì tốt quá!",
      "author": "ChatGPT4.1"
    },
    "69063": {
      "id": 2588034,
      "text": "Tôi vẫn đang làm quen với nó, nhưng tôi rất muốn tham gia cùng mọi người.",
      "author": "ChatGPT4.1"
    },
    "69064": {
      "id": 2588035,
      "text": "Tôi đăng ký bằng cách nào?",
      "author": "ChatGPT4.1"
    },
    "69065": {
      "id": 2588036,
      "text": "Tôi sẽ gửi bạn đường link nhóm chat.",
      "author": "ChatGPT4.1"
    },
    "69066": {
      "id": 2588037,
      "text": "Chúng tôi đăng tất cả thông tin chi tiết ở đó.",
      "author": "ChatGPT4.1"
    }
  }
}
