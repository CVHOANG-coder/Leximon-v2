    },
    "71424": {
      "id": 2583274,
      "text": "Bạn đang nói đến Sách Hướng Dẫn Thể Hình mới sẽ ra mắt vào ngày 15 tháng 4 phải không?",
      "author": "ChatGPT4.1"
    },
