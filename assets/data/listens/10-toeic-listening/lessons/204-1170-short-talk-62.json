  "translations": {
    "54482": {
      "id": 934870,
      "text": "Tôi muốn nhân cơ hội này phát các thiết bị hướng dẫn bằng âm thanh không dây để bạn có thể thưởng thức cuộc triển lãm một cách tốt nhất.",
      "author": "a user"
    },
    "54483": {
      "id": 934872,
      "text": "Bạn sẽ có thể nghe thông tin cơ bản về các nghệ sĩ và tác phẩm nghệ thuật.",
      "author": "a user"
    },
    "54485": {
      "id": 934878,
      "text": "Tôi biết bạn sẽ thích cuộc nói chuyện, hẹn gặp lại bạn vào lúc đó!",
      "author": "a user"
    },
    "54480": {
      "id": 2606146,
      "text": "Chào mừng đến với lễ khai mạc triển lãm Mỹ Latinh, tại Bảo tàng Nghệ thuật Bắc Mỹ.",
      "author": "ChatGPT4.1"
    },
    "54481": {
      "id": 2606147,
      "text": "Triển lãm này trưng bày các tác phẩm Mỹ Latinh từ quá khứ đến hiện tại.",
      "author": "ChatGPT4.1"
    },
    "54484": {
      "id": 2606148,
      "text": "Xin đừng quên, chúng tôi có một nghệ sĩ nổi tiếng bất ngờ sẽ phát biểu lúc 3 giờ chiều.",
      "author": "ChatGPT4.1"
    }
  }
