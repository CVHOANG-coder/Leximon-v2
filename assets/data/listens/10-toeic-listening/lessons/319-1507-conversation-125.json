  "translations": {
    "65610": {
      "id": 2596409,
      "text": "Wow, Susan từ bộ phận Nhân sự vừa tiết lộ với tôi một bí mật.",
      "author": "ChatGPT4.1"
    },
    "65611": {
      "id": 2596410,
      "text": "Họ đang trao cho Edward sự thăng chức mà anh ấy đã hy vọng.",
      "author": "ChatGPT4.1"
    },
    "65612": {
      "id": 2596411,
      "text": "Vị trí quản lý tài khoản tại văn phòng công ty là của anh ấy!",
      "author": "ChatGPT4.1"
    },
    "65613": {
      "id": 2596412,
      "text": "Đó là một tin tuyệt vời!",
      "author": "ChatGPT4.1"
    },
    "65614": {
      "id": 2596413,
      "text": "Tôi cá là anh ấy rất phấn khích.",
      "author": "ChatGPT4.1"
    },
    "65615": {
      "id": 2596414,
      "text": "Bạn có biết khi nào anh ấy chuyển công tác không?",
      "author": "ChatGPT4.1"
    },
    "65616": {
      "id": 2596415,
      "text": "Mọi thứ dường như đang diễn ra rất nhanh.",
      "author": "ChatGPT4.1"
    },
    "65617": {
      "id": 2596416,
      "text": "Susan nói rằng ngày cuối cùng của anh ấy ở đây sẽ là thứ Sáu!",
      "author": "ChatGPT4.1"
    },
    "65618": {
      "id": 2596417,
      "text": "Wow, nhanh thật, nhưng tôi cá là anh ấy không phiền đâu.",
      "author": "ChatGPT4.1"
    },
    "65619": {
      "id": 2596418,
      "text": "Anh ấy đã mong muốn một vị trí ở văn phòng công ty trong một thời gian rồi.",
      "author": "ChatGPT4.1"
    },
    "65620": {
      "id": 2596419,
      "text": "Điều đó không để lại cho chúng ta nhiều thời gian để tổ chức tiệc chia tay!",
      "author": "ChatGPT4.1"
    },
    "65621": {
      "id": 2596420,
      "text": "Chúng ta nên lên kế hoạch cho một bữa tiệc vào thứ Sáu sau giờ làm không?",
      "author": "ChatGPT4.1"
    },
    "65622": {
      "id": 2596421,
      "text": "Điều đó rất đúng!",
      "author": "ChatGPT4.1"
    },
    "65623": {
      "id": 2596422,
      "text": "Thứ Sáu thì tôi được.",
      "author": "ChatGPT4.1"
    },
    "65624": {
      "id": 2596423,
      "text": "Tôi sẽ gửi một email ngay lập tức.",
      "author": "ChatGPT4.1"
    }
  }
}
