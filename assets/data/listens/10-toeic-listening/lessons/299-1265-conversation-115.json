    "55789": {
      "id": 2599523,
      "text": "Chào Anna!",
      "author": "ChatGPT4.1"
    },
    "55790": {
      "id": 2599524,
      "text": "Tôi đang rất mong chờ lễ hội cộng đồng mà công ty chúng ta đang hỗ trợ tài trợ và tổ chức.",
      "author": "ChatGPT4.1"
    },
    "55791": {
      "id": 2599525,
      "text": "Sẽ có rất nhiều người tham dự sự kiện này,",
      "author": "ChatGPT4.1"
    },
    "55792": {
      "id": 2599526,
      "text": "nên tôi nghĩ đây sẽ là dịp tuyệt vời để quảng bá tên tuổi của chúng ta.",
      "author": "ChatGPT4.1"
    },
    "55793": {
      "id": 2599527,
      "text": "Ồ, tôi suýt nữa thì quên mất chuyện này.",
      "author": "ChatGPT4.1"
    },
    "55794": {
      "id": 2599528,
      "text": "Bạn đã xem qua hoặc nghe thử bất kỳ ban nhạc nào mà chúng ta đang cân nhắc thuê chưa?",
      "author": "ChatGPT4.1"
    },
    "55795": {
      "id": 2599529,
      "text": "Chúng ta cần quyết định sớm để ban nhạc có thời gian chuẩn bị.",
      "author": "ChatGPT4.1"
    },
    "55796": {
      "id": 2599530,
      "text": "Ôi, thực ra tôi đã bận quá với việc quảng cáo nên quên mất phần nghệ sĩ biểu diễn.",
      "author": "ChatGPT4.1"
    },
    "55797": {
      "id": 2599531,
      "text": "Cá nhân tôi rất thích ban nhạc HooHa, nhưng phí của họ khá cao",
      "author": "ChatGPT4.1"
    },
    "55798": {
      "id": 2599532,
      "text": "và tôi không chắc liệu chúng ta có đủ khả năng chi trả không.",
      "author": "ChatGPT4.1"
    },
    "55799": {
      "id": 2599533,
      "text": "Tôi cũng thích họ, nhưng thật tiếc, tôi đồng ý với bạn.",
      "author": "ChatGPT4.1"
    },
    "55800": {
      "id": 2599534,
      "text": "Chúng ta có nên đặt ban nhạc đến từ Hamilton không?",
      "author": "ChatGPT4.1"
    },
    "55801": {
      "id": 2599535,
      "text": "Họ khá nổi tiếng và có lượng người theo dõi tốt trên mạng xã hội,",
      "author": "ChatGPT4.1"
    },
    "55802": {
      "id": 2599536,
      "text": "và phí của họ thấp hơn đáng kể.",
      "author": "ChatGPT4.1"
    }
  }
}
