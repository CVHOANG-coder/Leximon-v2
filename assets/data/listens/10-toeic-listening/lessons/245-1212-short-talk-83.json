    },
    "55028": {
      "id": 963746,
      "text": "Tôi đã đặt hàng thay thế vào tối qua,",
      "author": "a user"
    },
    "55031": {
      "id": 1542530,
      "text": "Hãy gọi lại cho chúng tôi dù bạn quyết định như thế nào để cho chúng tôi biết.",
      "author": "a user"
    },
    "55024": {
      "id": 2606057,
      "text": "Xin chào, ông Green.",
      "author": "ChatGPT4.1"
    },
    "55025": {
      "id": 2606058,
      "text": "Đây là James Coe, gọi từ Jame's Auto.",
      "author": "ChatGPT4.1"
    },
    "55027": {
      "id": 2606059,
      "text": "Đây là một lỗi và cần được thay thế càng sớm càng tốt.",
      "author": "ChatGPT4.1"
    },
    "55029": {
      "id": 2606060,
      "text": "nhưng thật không may là bóng đèn sẽ về vào cuối tuần này.",
      "author": "ChatGPT4.1"
    },
    "55030": {
      "id": 2606061,
      "text": "Nếu ông cần xe thuê trong bốn ngày tới, chúng tôi có thể hỗ trợ sắp xếp.",
      "author": "ChatGPT4.1"
    },
    "55032": {
      "id": 2606062,
      "text": "Số điện thoại của chúng tôi là 555-3432, xin cảm ơn.",
