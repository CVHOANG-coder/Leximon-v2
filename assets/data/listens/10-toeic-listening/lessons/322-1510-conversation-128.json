  "translations": {
    "65673": {
      "id": 2648006,
      "text": "Xin lỗi,",
      "author": "ChatGPT4.1"
    },
    "65674": {
      "id": 2648007,
      "text": "đây có phải là quầy làm thủ tục cho Hãng Hàng không Jetstars không?",
      "author": "ChatGPT4.1"
    },
    "65675": {
      "id": 2648008,
      "text": "Tôi bay đến Sydney.",
      "author": "ChatGPT4.1"
    },
    "65676": {
      "id": 2648009,
      "text": "Xin lỗi ông.",
      "author": "ChatGPT4.1"
    },
    "65677": {
      "id": 2648010,
      "text": "Chuyến bay đã bị hoãn do sự cố kỹ thuật với máy bay.",
      "author": "ChatGPT4.1"
    },
    "65678": {
      "id": 2648011,
      "text": "Theo các kỹ thuật viên, thời gian chờ ước tính là khoảng 5 tiếng.",
      "author": "ChatGPT4.1"
    },
    "65679": {
      "id": 2648012,
      "text": "Ừm... Điều đó không tốt lắm.",
      "author": "ChatGPT4.1"
    },
    "65680": {
      "id": 2648013,
      "text": "Tối nay tôi phải tham dự một buổi gây quỹ cho một tổ chức bảo vệ động vật hoang dã ở Úc.",
      "author": "ChatGPT4.1"
    },
    "65681": {
      "id": 2648014,
      "text": "Anh/chị có thể chuyển tôi sang chuyến bay tiếp theo không?",
      "author": "ChatGPT4.1"
    },
    "65682": {
      "id": 2648015,
      "text": "Dĩ nhiên.",
      "author": "ChatGPT4.1"
    },
    "65683": {
      "id": 2648016,
      "text": "Tôi có thể xem hộ chiếu và vé của ông không?",
      "author": "ChatGPT4.1"
    },
    "65684": {
      "id": 2648017,
      "text": "Đây ạ.",
      "author": "ChatGPT4.1"
    },
    "65685": {
      "id": 2648018,
      "text": "Tôi muốn chuyến bay đến trước buổi trưa và ghế hạng thương gia.",
      "author": "ChatGPT4.1"
    },
    "65686": {
      "id": 2648019,
      "text": "Cảm ơn!",
      "author": "ChatGPT4.1"
    },
    "65687": {
      "id": 2648020,
      "text": "Chắc chắn rồi.",
      "author": "ChatGPT4.1"
    },
    "65688": {
      "id": 2648021,
      "text": "Xin chờ một chút...",
      "author": "ChatGPT4.1"
    },
    "65689": {
      "id": 2648022,
      "text": "để tôi kiểm tra đặt chỗ của ông và xem tôi có thể giúp gì.",
      "author": "ChatGPT4.1"
    }
  }
}
