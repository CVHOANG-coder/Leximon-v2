  "translations": {
    "69907": {
      "id": 2592223,
      "text": "Tiếp theo, xin mời. Tôi có thể giúp gì cho bạn?",
      "author": "ChatGPT4.1"
    },
    "69908": {
      "id": 2592224,
      "text": "Chào, tôi cần làm lại hộ chiếu.",
      "author": "ChatGPT4.1"
    },
    "69909": {
      "id": 2592225,
      "text": "Chắc chắn rồi, bạn có mang theo đơn xin và hộ chiếu cũ không?",
      "author": "ChatGPT4.1"
    },
    "69910": {
      "id": 2592226,
      "text": "Vâng, ở đây này.",
      "author": "ChatGPT4.1"
    },
    "69911": {
      "id": 2592227,
      "text": "Bạn có biết thời gian chờ khoảng bao lâu không?",
      "author": "ChatGPT4.1"
    },
    "69912": {
      "id": 2592228,
      "text": "Tôi phải đi đón con sớm.",
      "author": "ChatGPT4.1"
    },
    "69913": {
      "id": 2592229,
      "text": "Hôm nay khá đông, vậy nên có thể phải chờ hơn một tiếng.",
      "author": "ChatGPT4.1"
    },
    "69914": {
      "id": 2592230,
      "text": "Nếu như vậy quá lâu, bạn có thể đến sớm vào ngày mai khi vắng hơn.",
      "author": "ChatGPT4.1"
    },
    "69915": {
      "id": 2592231,
      "text": "Ừm, có lẽ đó là ý hay hơn.",
      "author": "ChatGPT4.1"
    },
    "69916": {
      "id": 2592232,
      "text": "Mấy giờ bạn mở cửa?",
      "author": "ChatGPT4.1"
    },
    "69917": {
      "id": 2592233,
      "text": "Chúng tôi mở cửa lúc 8 giờ sáng, và lúc đó thường rất vắng.",
      "author": "ChatGPT4.1"
    }
  }
