  "translations": {
    "68608": {
      "id": 2596400,
      "text": "Xin chào tất cả mọi người!",
      "author": "ChatGPT4.1"
    },
    "68609": {
      "id": 2596401,
      "text": "Tôi là bác sĩ Harris từ phòng khám Riverstone,",
      "author": "ChatGPT4.1"
    },
    "68610": {
      "id": 2596402,
      "text": "và hôm nay, tôi muốn nói về tầm quan trọng của việc tiêm phòng cúm trong mùa này.",
      "author": "ChatGPT4.1"
    },
    "68611": {
      "id": 2596403,
      "text": "Mặc dù cúm có vẻ là một căn bệnh thông thường, nhưng nó có thể dẫn đến các biến chứng nghiêm trọng,",
      "author": "ChatGPT4.1"
    },
    "68612": {
      "id": 2596404,
      "text": "đặc biệt là đối với trẻ nhỏ và người lớn tuổi.",
      "author": "ChatGPT4.1"
    },
    "68613": {
      "id": 2596405,
      "text": "Tại phòng khám của chúng tôi, chúng tôi cung cấp vắc xin cúm cho mọi lứa tuổi,",
      "author": "ChatGPT4.1"
    },
    "68614": {
      "id": 2596406,
      "text": "và chúng tôi đã làm cho quy trình này trở nên nhanh chóng và dễ dàng.",
      "author": "ChatGPT4.1"
    },
    "68615": {
      "id": 2596407,
      "text": "Không cần đặt lịch hẹn,",
      "author": "ChatGPT4.1"
    },
    "68616": {
      "id": 2596408,
      "text": "nhưng chúng tôi khuyên bạn nên đến sớm để tránh phải chờ lâu hơn.",
      "author": "ChatGPT4.1"
    }
  }
