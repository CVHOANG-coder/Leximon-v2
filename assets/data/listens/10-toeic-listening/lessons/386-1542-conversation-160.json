  "translations": {
    "66166": {
      "id": 2669271,
      "text": "Chào buổi sáng. Tôi muốn hỏi về việc gửi một vài món hàng ra quốc tế.",
      "author": "ChatGPT4.1"
    },
    "66167": {
      "id": 2669272,
      "text": "Chúng tôi cần gửi các món hàng này từ đây, San Francisco, tới Seoul, Hàn Quốc.",
      "author": "ChatGPT4.1"
    },
    "66168": {
      "id": 2669273,
      "text": "Các gói hàng khá nhỏ, nên có lẽ chúng tôi có thể gộp lại với nhau,",
      "author": "ChatGPT4.1"
    },
    "66169": {
      "id": 2669274,
      "text": "nhưng chúng tôi có 100 hộp đựng dây chuyền và 50 hộp nhẫn.",
      "author": "ChatGPT4.1"
    },
    "66170": {
      "id": 2669275,
      "text": "Điều đó sẽ không thành vấn đề.",
      "author": "ChatGPT4.1"
    },
    "66171": {
      "id": 2669276,
      "text": "Tôi đồng ý, chúng ta nên gộp các hộp nhỏ lại để giảm chi phí.",
      "author": "ChatGPT4.1"
    },
    "66172": {
      "id": 2669277,
      "text": "Chúng tôi chuyên vận chuyển các mặt hàng có giá trị cao.",
      "author": "ChatGPT4.1"
    },
    "66173": {
      "id": 2669278,
      "text": "Quý khách muốn các món hàng được giao vào thời điểm nào?",
      "author": "ChatGPT4.1"
    },
    "66174": {
      "id": 2669279,
      "text": "Chúng tôi cần trang sức được giao tại Seoul cho lễ khai trương, muộn nhất là ngày 15 tháng 3,",
      "author": "ChatGPT4.1"
    },
    "66175": {
      "id": 2669280,
      "text": "nhưng càng gần đầu tháng ba thì càng tốt.",
      "author": "ChatGPT4.1"
    },
    "66176": {
      "id": 2669281,
      "text": "Anh/chị có thể cung cấp báo giá cho các ngày giao hàng khác nhau không?",
      "author": "ChatGPT4.1"
    },
    "66177": {
      "id": 2669282,
      "text": "Tôi đoán là bên bạn có cung cấp bảo hiểm?",
      "author": "ChatGPT4.1"
    },
    "66178": {
      "id": 2669283,
      "text": "Chắc chắn rồi, chúng tôi có thể gửi cho bạn một vài báo giá.",
      "author": "ChatGPT4.1"
    },
    "66179": {
      "id": 2669284,
      "text": "Trước tiên, tôi sẽ cần giá trị của từng món hàng, theo đơn giá riêng lẻ.",
      "author": "ChatGPT4.1"
    },
    "66180": {
      "id": 2669285,
      "text": "Chúng tôi cần biết điều này vì lý do bảo hiểm, nó sẽ ảnh hưởng tới chi phí.",
      "author": "ChatGPT4.1"
    },
    "66181": {
      "id": 2669286,
