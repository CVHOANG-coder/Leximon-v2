  "translations": {
    "70198": {
      "id": 2584146,
      "text": "Chào bạn, tôi gọi để đặt bốn vé cho tour đi bộ thăm các di tích lịch sử tại City Explorers vào Chủ nhật tới.",
      "author": "ChatGPT4.1"
    },
    "70199": {
      "id": 2584147,
      "text": "Giá cho tour đó là bao nhiêu?",
      "author": "ChatGPT4.1"
    },
    "70200": {
      "id": 2584148,
      "text": "Mỗi vé có giá 25 đô la.",
      "author": "ChatGPT4.1"
    },
    "70201": {
      "id": 2584149,
      "text": "Tour sẽ bắt đầu lúc 10 giờ sáng và kéo dài khoảng ba tiếng.",
      "author": "ChatGPT4.1"
    },
    "70202": {
      "id": 2584150,
      "text": "Đó là hơi nhiều hơn tôi dự đoán.",
      "author": "ChatGPT4.1"
    },
    "70203": {
      "id": 2584151,
      "text": "Gần đây giá vé có tăng không?",
      "author": "ChatGPT4.1"
    },
    "70204": {
      "id": 2584152,
      "text": "Anh trai tôi đã tham gia cùng tour này vài tuần trước và nói rằng khi đó là 20 đô một người.",
      "author": "ChatGPT4.1"
    },
    "70205": {
      "id": 2584153,
      "text": "Có lẽ anh ấy đã mua vé trong chương trình khuyến mãi theo mùa của chúng tôi.",
      "author": "ChatGPT4.1"
    },
    "70206": {
      "id": 2584154,
      "text": "Chúng tôi thỉnh thoảng có ưu đãi đặc biệt vào các thời điểm khác nhau trong năm,",
      "author": "ChatGPT4.1"
    },
    "70207": {
      "id": 2584155,
      "text": "giúp làm giảm giá vé thông thường.",
      "author": "ChatGPT4.1"
    }
  }
