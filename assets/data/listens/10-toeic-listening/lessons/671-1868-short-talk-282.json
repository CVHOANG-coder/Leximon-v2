  "translations": {
    "71241": {
      "id": 2586161,
      "text": "Nếu bạn đang lên kế hoạch cho một đám cưới, tổ chức tiệc, hoặc đơn giản là tìm kiếm một món quà đầy ý nghĩa,",
      "author": "ChatGPT4.1"
    },
    "71242": {
      "id": 2586162,
      "text": "Blossom Boutique có những thiết kế hoa hoàn hảo đang chờ bạn!",
      "author": "ChatGPT4.1"
    },
    "71243": {
      "id": 2586163,
      "text": "Là một trong những cửa hàng hoa hàng đầu tại Glasgow,",
      "author": "ChatGPT4.1"
    },
    "71244": {
      "id": 2586164,
      "text": "chúng tôi tự hào về các bộ sưu tập hoa tuyệt đẹp của mình.",
      "author": "ChatGPT4.1"
    },
    "71245": {
      "id": 2586165,
      "text": "Với hơn 5.000 mét vuông dành cho những bông hoa rực rỡ sắc màu và những chậu cây tinh tế,",
      "author": "ChatGPT4.1"
    },
    "71246": {
      "id": 2586166,
      "text": "bạn sẽ có quá nhiều lựa chọn tuyệt vời.",
      "author": "ChatGPT4.1"
    },
    "71247": {
      "id": 2586167,
      "text": "Hãy ghé thăm chúng tôi tại 789 Highland Avenue",
      "author": "ChatGPT4.1"
    },
    "71248": {
      "id": 2586168,
      "text": "để khám phá bộ sưu tập hoa thủ công tinh xảo của chúng tôi.",
      "author": "ChatGPT4.1"
    },
    "71249": {
      "id": 2586169,
      "text": "Hãy nhắc đến quảng cáo này khi thanh toán,",
      "author": "ChatGPT4.1"
    },
    "71250": {
      "id": 2586170,
      "text": "và bạn sẽ được giảm giá đặc biệt 5% cho đơn hàng của mình.",
      "author": "ChatGPT4.1"
    }
  }
}
