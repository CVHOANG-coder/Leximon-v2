  "translations": {
    "71029": {
      "id": 2585240,
      "text": "Nếu bạn đang mơ ước xây dựng ngôi nhà lý tưởng của mình, cơ hội của bạn đã đến!",
      "author": "ChatGPT4.1"
    },
    "71030": {
      "id": 2585241,
      "text": "Golden Horizon Realty hiện đang cung cấp nhiều lô đất sạch sẽ, diện tích nửa mẫu Anh, nằm dọc theo bờ hồ yên bình của Crystal Lake.",
      "author": "ChatGPT4.1"
    },
    "71031": {
      "id": 2585242,
      "text": "Những lô đất này có tầm nhìn tuyệt đẹp và cung cấp nhiều không gian cho ý tưởng thiết kế cảnh quan sáng tạo của bạn.",
      "author": "ChatGPT4.1"
    },
    "71032": {
      "id": 2585243,
      "text": "Một điểm cộng nữa là các lô đất này đã được chuẩn bị sẵn sàng để kết nối liền mạch với hệ thống nước, điện và thoát nước đáng tin cậy của Riverdale.",
      "author": "ChatGPT4.1"
    },
    "71033": {
      "id": 2585244,
      "text": "Với nhu cầu ngày càng gia tăng và số lượng hạn chế,",
      "author": "ChatGPT4.1"
    },
    "71034": {
      "id": 2585245,
      "text": "những lô đất này sẽ nhanh chóng được bán hết.",
      "author": "ChatGPT4.1"
    },
    "71035": {
      "id": 2585246,
      "text": "Hãy hành động nhanh để nắm bắt cơ hội độc đáo này.",
      "author": "ChatGPT4.1"
    },
    "71036": {
      "id": 2585247,
      "text": "Để sắp xếp một chuyến tham quan có hướng dẫn các lô đất tại Crystal Lake,",
      "author": "ChatGPT4.1"
    },
    "71037": {
      "id": 2585248,
      "text": "hãy liên hệ với đội ngũ của chúng tôi theo số 555-7562 và đặt lịch tham quan ngay hôm nay.",
      "author": "ChatGPT4.1"
    }
  }
}
