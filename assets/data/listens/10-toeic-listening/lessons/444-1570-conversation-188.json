  "translations": {
    "66599": {
      "id": 2620403,
      "text": "Bạn đã nghe về các thủ tục đỗ xe mới chưa?",
      "author": "ChatGPT4.1"
    },
    "66600": {
      "id": 2620404,
      "text": "Sếp của chúng ta muốn tôi đảm bảo bạn đã biết về các quy định mới.",
      "author": "ChatGPT4.1"
    },
    "66601": {
      "id": 2620405,
      "text": "À, tôi đã nghe đồn, nhưng tôi chưa nghe thấy gì chính thức cả.",
      "author": "ChatGPT4.1"
    },
    "66602": {
      "id": 2620406,
      "text": "Từ bây giờ chúng ta sẽ có chỗ đỗ xe được chỉ định, đúng không?",
      "author": "ChatGPT4.1"
    },
    "66603": {
      "id": 2620407,
      "text": "Đúng vậy, mọi người sẽ được phân chia một chỗ đỗ xe.",
      "author": "ChatGPT4.1"
    },
    "66604": {
      "id": 2620408,
      "text": "Chúng ta cũng sẽ có chỗ đỗ xe ngắn hạn cho nhân viên nếu bạn cần vào văn phòng nhanh.",
      "author": "ChatGPT4.1"
    },
    "66605": {
      "id": 2620409,
      "text": "Mỗi người cũng sẽ được cấp một thẻ đỗ xe cần dán trên gương chiếu hậu.",
      "author": "ChatGPT4.1"
    },
    "66606": {
      "id": 2620410,
      "text": "Họ sẽ quyết định chỗ đỗ xe của chúng ta như thế nào?",
      "author": "ChatGPT4.1"
    },
    "66607": {
      "id": 2620411,
      "text": "Chủ yếu dựa vào thâm niên,",
      "author": "ChatGPT4.1"
    },
    "66608": {
      "id": 2620412,
      "text": "nhưng những yếu tố khác, như tần suất bạn có mặt ở văn phòng cũng ảnh hưởng đến quyết định.",
      "author": "ChatGPT4.1"
    },
    "66609": {
      "id": 2620413,
      "text": "Bạn còn có câu hỏi nào khác không?",
      "author": "ChatGPT4.1"
    },
    "66610": {
      "id": 2620414,
      "text": "Tôi nghĩ là không.",
      "author": "ChatGPT4.1"
    },
    "66611": {
      "id": 2620415,
      "text": "Sẽ rất tốt khi có một chỗ đã được chỉ định,",
      "author": "ChatGPT4.1"
    },
    "66612": {
      "id": 2620416,
      "text": "nó sẽ giúp giảm áp lực phải tìm chỗ mới mỗi ngày.",
      "author": "ChatGPT4.1"
    }
  }
}
