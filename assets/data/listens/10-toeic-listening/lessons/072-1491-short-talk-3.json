    },
    "64238": {
      "id": 1444392,
      "text": "chúng tôi rất vui mừng khi giới thiệu sản phẩm cải tiến mới nhất của mình: ghế sofa có ngăn lưu trữ hình chữ L!",
      "author": "a user"
    },
    "64243": {
      "id": 1444397,
      "text": "Và điều tuyệt vời nhất là gì? Tất cả đều có sẵn với mức giá mà bạn sẽ thích.",
      "author": "a user"
    },
    "64235": {
      "id": 2584355,
      "text": "Fun Furniture đã dành 14 năm qua để mang lại sự thoải mái cho phòng khách của bạn,",
      "author": "ChatGPT4.1"
    },
    "64236": {
      "id": 2584356,
      "text": "giúp các gia đình và bạn bè tạo nên những kỷ niệm lâu dài.",
      "author": "ChatGPT4.1"
    },
    "64239": {
      "id": 2584357,
      "text": "Thiết kế mới này kết hợp sự thoải mái của sofa truyền thống với sự tiện lợi của ngăn lưu trữ tích hợp,",
      "author": "ChatGPT4.1"
    },
    "64240": {
      "id": 2584358,
      "text": "giúp bạn dễ dàng giữ không gian của mình luôn ngăn nắp hơn bao giờ hết.",
      "author": "ChatGPT4.1"
    },
    "64241": {
      "id": 2584359,
      "text": "Chúng tôi cũng đã bổ sung phần tựa lưng nâng cấp để cải thiện tư thế ngồi,",
      "author": "ChatGPT4.1"
    },
    "64242": {
      "id": 2584360,
      "text": "đảm bảo bạn có thể thư giãn một cách sang trọng và thoải mái.",
