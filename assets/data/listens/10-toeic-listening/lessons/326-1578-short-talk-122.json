  "translations": {
    "66721": {
      "id": 2618482,
      "text": "Mọi người đã sẵn sàng chưa?",
      "author": "ChatGPT4.1"
    },
    "66722": {
      "id": 2618483,
      "text": "Bạn sẽ được trải nghiệm cảm giác hồi hộp nhất trong đời,",
      "author": "ChatGPT4.1"
    },
    "66723": {
      "id": 2618484,
      "text": "khi bạn chuẩn bị lên tàu lượn Speed Demon Mountain, tại Công viên Giải trí Erie Point.",
      "author": "ChatGPT4.1"
    },
    "66724": {
      "id": 2618485,
      "text": "Tàu lượn đạt tốc độ lên đến 190 km một giờ,",
      "author": "ChatGPT4.1"
    },
    "66725": {
      "id": 2618486,
      "text": "và cao 160 mét.",
      "author": "ChatGPT4.1"
    },
    "66726": {
      "id": 2618487,
      "text": "Trước khi bắt đầu, hãy cùng điểm qua một số quy định an toàn.",
      "author": "ChatGPT4.1"
    },
    "66727": {
      "id": 2618488,
      "text": "Đầu tiên, hãy luôn giữ tất cả các bộ phận cơ thể bên trong xe mọi lúc.",
      "author": "ChatGPT4.1"
    },
    "66728": {
      "id": 2618489,
      "text": "Thứ hai, bạn nên để đồ dùng cá nhân vào tủ khóa miễn phí được cung cấp.",
      "author": "ChatGPT4.1"
    },
    "66729": {
      "id": 2618490,
      "text": "Điều này bao gồm cả điện thoại di động, xin đừng cố giữ trong túi quần.",
      "author": "ChatGPT4.1"
    },
    "66730": {
      "id": 2618491,
      "text": "Sau khi bạn đã được cài dây an toàn và chuyến đi bắt đầu rời ga,",
      "author": "ChatGPT4.1"
    },
    "66731": {
      "id": 2618492,
      "text": "sẽ không có lựa chọn nào để xuống cho đến khi chuyến đi hoàn thành,",
      "author": "ChatGPT4.1"
    },
    "66732": {
      "id": 2618493,
      "text": "vì vậy hãy chắc chắn bạn muốn tham gia trước khi lên tàu.",
      "author": "ChatGPT4.1"
    },
    "66733": {
      "id": 2618494,
      "text": "Chúc bạn có khoảng thời gian thật tuyệt vời!",
      "author": "ChatGPT4.1"
    }
  }
}
