  "translations": {
    "55573": {
      "id": 955806,
      "text": "Để thợ sửa ống nước có thời gian để sửa chữa vụ nổ.",
      "author": "a user"
    },
    "55570": {
      "id": 2612885,
      "text": "Tôi biết nhiều người trong các bạn đang thắc mắc tại sao lại có những kỹ thuật viên ra vào văn phòng trong vài ngày qua.",
      "author": "ChatGPT4.1"
    },
    "55571": {
      "id": 2612886,
      "text": "Chúng tôi phát hiện có một đường ống bị vỡ ở tầng hai vào thứ Hai.",
      "author": "ChatGPT4.1"
    },
    "55572": {
      "id": 2612887,
      "text": "Thật không may, điều này có nghĩa là các phòng vệ sinh ở tầng đó sẽ bị đóng cửa trong hai ngày tới,",
      "author": "ChatGPT4.1"
    },
    "55574": {
      "id": 2612888,
      "text": "Vì vậy, xin vui lòng không lên tầng hai và thay vào đó hãy sử dụng các phòng vệ sinh ở tầng một hoặc tầng ba.",
      "author": "ChatGPT4.1"
    },
    "55575": {
      "id": 2612889,
      "text": "Ngoài ra, hãy nhớ lấy tất cả đồ đạc ra khỏi tủ ở tầng hai trước khi rời đi hôm nay.",
      "author": "ChatGPT4.1"
    }
  }
