  "translations": {
    "70990": {
      "id": 2585132,
      "text": "Này Janice, chúng ta đã đăng tuyển vị trí thiết kế đồ họa gần một tháng rồi,",
      "author": "ChatGPT4.1"
    },
    "70991": {
      "id": 2585133,
      "text": "và chúng ta vẫn chưa nhận được nhiều đơn ứng tuyển.",
      "author": "ChatGPT4.1"
    },
    "70992": {
      "id": 2585134,
      "text": "Thêm vào đó, những hồ sơ nhận được cho đến giờ chưa có tác phẩm sáng tạo mà chúng ta cần.",
      "author": "ChatGPT4.1"
    },
    "70993": {
      "id": 2585135,
      "text": "Thật là nản.",
      "author": "ChatGPT4.1"
    },
    "70994": {
      "id": 2585136,
      "text": "Có lẽ chúng ta nên giữ nó trên các trang đăng việc như bình thường thêm một tuần nữa.",
      "author": "ChatGPT4.1"
    },
    "70995": {
      "id": 2585137,
      "text": "Chúng ta cũng có thể thử đăng lên một số diễn đàn thiết kế chuyên ngành để tiếp cận đúng người hơn.",
      "author": "ChatGPT4.1"
    },
    "70996": {
      "id": 2585138,
      "text": "Ừ, nghe hợp lý đấy.",
      "author": "ChatGPT4.1"
    },
    "70997": {
      "id": 2585139,
      "text": "Alex bên bộ phận marketing khá rành về mấy diễn đàn đó.",
      "author": "ChatGPT4.1"
    },
    "70998": {
      "id": 2585140,
      "text": "Tôi sẽ gặp anh ấy sau cuộc họp lúc 11 giờ sáng nay",
      "author": "ChatGPT4.1"
    },
    "70999": {
      "id": 2585141,
      "text": "và xem anh ấy đề xuất những diễn đàn nào là tốt nhất.",
      "author": "ChatGPT4.1"
    },
    "71000": {
      "id": 2585142,
      "text": "Nghe ổn đấy.",
      "author": "ChatGPT4.1"
    },
    "71001": {
      "id": 2585143,
      "text": "Cậu có thể cập nhật cho tôi sau khi nói chuyện với anh ấy không?",
      "author": "ChatGPT4.1"
    },
    "71002": {
      "id": 2585144,
      "text": "Tôi muốn đăng tin tuyển dụng mới trong chiều nay nếu có thể.",
      "author": "ChatGPT4.1"
    }
  }
}
