  "translations": {
    "55407": {
      "id": 2614080,
      "text": "Bạn đã nhận được thông báo về chính sách mới cho các buổi tiệc công ty chưa?",
      "author": "ChatGPT4.1"
    },
    "55408": {
      "id": 2614081,
      "text": "Tôi không thể tin được!",
      "author": "ChatGPT4.1"
    },
    "55409": {
      "id": 2614082,
      "text": "Ừ, Sarah đã kể cho tôi về điều đó.",
      "author": "ChatGPT4.1"
    },
    "55410": {
      "id": 2614083,
      "text": "Thật là tệ.",
      "author": "ChatGPT4.1"
    },
    "55411": {
      "id": 2614084,
      "text": "Mười đô la cho mỗi người cho các buổi tiệc của chúng ta sao?",
      "author": "ChatGPT4.1"
    },
    "55412": {
      "id": 2614085,
      "text": "Mọi thứ thực sự sẽ đi xuống.",
      "author": "ChatGPT4.1"
    },
    "55413": {
      "id": 2614086,
      "text": "Tôi biết mà!",
      "author": "ChatGPT4.1"
    },
    "55414": {
      "id": 2614087,
      "text": "Ban quản lý nói rằng chúng ta không đạt mong đợi của họ trong năm nay,",
      "author": "ChatGPT4.1"
    },
    "55415": {
      "id": 2614088,
      "text": "nên họ không có thêm tiền để chi tiêu, điều này thật vô lý",
      "author": "ChatGPT4.1"
    },
    "55416": {
      "id": 2614089,
      "text": "bởi vì chúng ta chỉ có hai bữa tiệc mỗi năm thôi.",
      "author": "ChatGPT4.1"
    },
    "55417": {
      "id": 2614090,
      "text": "Tôi đồng ý. Và họ nghĩ điều này sẽ thúc đẩy chúng ta sao?",
      "author": "ChatGPT4.1"
    },
    "55418": {
      "id": 2614091,
      "text": "Tôi sẵn sàng đi tìm việc mới rồi.",
