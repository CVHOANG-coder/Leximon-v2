  "translations": {
    "54030": {
      "id": 2587744,
      "text": "Chào buổi chiều, ông Lane.",
      "author": "ChatGPT4.1"
    },
    "54031": {
      "id": 2587745,
      "text": "Tôi là Ruby, gọi từ phòng khám nha khoa của bác sĩ Decker.",
      "author": "ChatGPT4.1"
    },
    "54032": {
      "id": 2587746,
      "text": "Chúng tôi chỉ muốn nhắc ông về cuộc hẹn vào thứ Sáu.",
      "author": "ChatGPT4.1"
    },
    "54033": {
      "id": 2587747,
      "text": "Xin nhớ rằng ông sẽ được gây mê cho quá trình điều trị,",
      "author": "ChatGPT4.1"
    },
    "54034": {
      "id": 2587748,
      "text": "nên ông sẽ cần ai đó đưa ông về nhà sau cuộc hẹn,",
      "author": "ChatGPT4.1"
    },
    "54035": {
      "id": 2587749,
      "text": "và chăm sóc ông cho phần còn lại của ngày hôm đó.",
      "author": "ChatGPT4.1"
    },
    "54036": {
      "id": 2587750,
      "text": "Ngoài ra, tôi cũng muốn nhắc rằng vì ông từng gặp vấn đề về răng trước đây,",
      "author": "ChatGPT4.1"
    },
    "54037": {
      "id": 2587751,
      "text": "tôi khuyên ông nên đăng ký gói Dịch Vụ Mới của chúng tôi,",
      "author": "ChatGPT4.1"
    },
    "54038": {
      "id": 2587752,
      "text": "gói này bao gồm các dịch vụ bổ sung xuyên suốt cả năm.",
      "author": "ChatGPT4.1"
    },
    "54039": {
      "id": 2587753,
      "text": "Vì ông là bệnh nhân lâu năm, chúng tôi xin gửi mức giá ưu đãi đặc biệt.",
      "author": "ChatGPT4.1"
    },
    "54040": {
      "id": 2587754,
      "text": "Xin vui lòng gọi lại cho tôi để xác nhận cuộc hẹn.",
      "author": "ChatGPT4.1"
    }
  }
