  "translations": {
    "71316": {
      "id": 2586690,
      "text": "Cảm ơn tất cả các bạn đã tham dự hội chợ sức khỏe cộng đồng thường niên của chúng tôi.",
      "author": "ChatGPT4.1"
    },
    "71317": {
      "id": 2586691,
      "text": "Sự tham gia của các bạn vô cùng quý giá đối với các gia đình địa phương của chúng ta.",
      "author": "ChatGPT4.1"
    },
    "71318": {
      "id": 2586692,
      "text": "Nhiều người trong số họ gặp khó khăn khi tiếp cận các dịch vụ chăm sóc sức khỏe chất lượng,",
      "author": "ChatGPT4.1"
    },
    "71319": {
      "id": 2586693,
      "text": "đặc biệt là trong thời kỳ kinh tế khó khăn.",
      "author": "ChatGPT4.1"
    },
    "71320": {
      "id": 2586694,
      "text": "Chúng tôi rất vui mừng khi thấy số lượng tham dự đông đảo năm nay,",
      "author": "ChatGPT4.1"
    },
    "71321": {
      "id": 2586695,
      "text": "bao gồm cả các đối tác mới như Health First.",
      "author": "ChatGPT4.1"
    },
    "71322": {
      "id": 2586696,
      "text": "Trước khi các bạn di chuyển đến các vị trí được chỉ định,",
      "author": "ChatGPT4.1"
    },
    "71323": {
      "id": 2586697,
      "text": "tôi muốn thông báo cho các bạn về một thay đổi địa điểm vào phút chót.",
      "author": "ChatGPT4.1"
    },
    "71324": {
      "id": 2586698,
      "text": "Chúng tôi đã dự định tổ chức các hội thảo về sức khỏe tại hội trường B,",
      "author": "ChatGPT4.1"
    },
    "71325": {
      "id": 2586699,
      "text": "nhưng do số người tham gia tăng bất ngờ,",
      "author": "ChatGPT4.1"
    },
    "71326": {
      "id": 2586700,
      "text": "chúng tôi đã chuyển chúng sang khán phòng chính.",
      "author": "ChatGPT4.1"
    },
    "71327": {
      "id": 2586701,
      "text": "Nơi này ban đầu được dành cho các hội thảo về sức khỏe tâm thần.",
      "author": "ChatGPT4.1"
    },
    "71328": {
      "id": 2586702,
      "text": "Có ai có câu hỏi gì không?",
      "author": "ChatGPT4.1"
    }
  }
}
