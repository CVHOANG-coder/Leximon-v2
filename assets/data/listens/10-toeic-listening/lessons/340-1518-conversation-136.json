  "translations": {
    "65791": {
      "id": 2592187,
      "text": "Xin lỗi,",
      "author": "ChatGPT4.1"
    },
    "65792": {
      "id": 2592188,
      "text": "Tôi đã mua chiếc khăn quàng này cho vợ tôi cách đây vài ngày trong đợt giảm giá cuối năm ở cửa hàng của bạn.",
      "author": "ChatGPT4.1"
    },
    "65793": {
      "id": 2592189,
      "text": "Tôi hy vọng tôi có thể đổi nó lấy chiếc màu đỏ rượu.",
      "author": "ChatGPT4.1"
    },
    "65794": {
      "id": 2592190,
      "text": "Cô ấy thích họa tiết của khăn quàng nhưng không thích màu sắc.",
      "author": "ChatGPT4.1"
    },
    "65795": {
      "id": 2592191,
      "text": "Tôi thật sự xin lỗi. Tất cả khăn quàng đã bán hết trong đợt giảm giá vừa rồi.",
      "author": "ChatGPT4.1"
    },
    "65796": {
      "id": 2592192,
      "text": "Để tôi xem...",
      "author": "ChatGPT4.1"
    },
    "65797": {
      "id": 2592193,
      "text": "Vẫn còn một chiếc ở cửa hàng khác của chúng tôi trên đường Charlotte.",
      "author": "ChatGPT4.1"
    },
    "65798": {
      "id": 2592194,
      "text": "Nếu bạn không phiền chờ, tôi sẽ chuyển chiếc khăn đó về đây ngay lập tức.",
      "author": "ChatGPT4.1"
    },
    "65799": {
      "id": 2592195,
      "text": "Nghe ổn đấy.",
      "author": "ChatGPT4.1"
    },
    "65800": {
      "id": 2592196,
      "text": "Bạn có thể gửi cho tôi qua đường bưu điện khi nhận được nó không?",
      "author": "ChatGPT4.1"
    },
    "65801": {
      "id": 2592197,
      "text": "Chắc chắn rồi.",
      "author": "ChatGPT4.1"
    },
    "65802": {
      "id": 2592198,
      "text": "Vui lòng điền tên, địa chỉ và số điện thoại của bạn vào mẫu này,",
      "author": "ChatGPT4.1"
    },
    "65803": {
      "id": 2592199,
      "text": "và tôi sẽ lo phần còn lại.",
      "author": "ChatGPT4.1"
    }
  }
