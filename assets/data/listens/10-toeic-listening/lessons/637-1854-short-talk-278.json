  "translations": {
    "71080": {
      "id": 2585444,
      "text": "Kính thưa quý ông bà, xin hãy chú ý lắng nghe.",
      "author": "ChatGPT4.1"
    },
    "71081": {
      "id": 2585445,
      "text": "Tất cả hành khách đã đặt chỗ trên chuyến bay 452 của Pacific Airlines đi New York City xin vui lòng di chuyển đến cửa 18 để lên máy bay.",
      "author": "ChatGPT4.1"
    },
    "71082": {
      "id": 2585446,
      "text": "Máy bay dự kiến khởi hành lúc 2 giờ 30 chiều.",
      "author": "ChatGPT4.1"
    },
    "71083": {
      "id": 2585447,
      "text": "Ưu tiên sẽ được dành cho các thành viên Câu lạc bộ Premier và hành khách hạng nhất,",
      "author": "ChatGPT4.1"
    },
    "71084": {
      "id": 2585448,
      "text": "những người này có thể bắt đầu lên máy bay lúc 1 giờ 55 phút chiều,",
      "author": "ChatGPT4.1"
    },
    "71085": {
      "id": 2585449,
      "text": "trong khi việc lên máy bay cho tất cả hành khách còn lại sẽ bắt đầu vào lúc 2 giờ 10 phút chiều.",
      "author": "ChatGPT4.1"
    },
    "71086": {
      "id": 2585450,
      "text": "Bên cạnh đó, xin thông báo rằng chuyến bay 209 của Continental Flyer,",
      "author": "ChatGPT4.1"
    },
    "71087": {
      "id": 2585451,
      "text": "ban đầu dự kiến khởi hành đi Denver lúc 2 giờ 15 phút chiều,",
      "author": "ChatGPT4.1"
    },
    "71088": {
      "id": 2585452,
      "text": "hiện đang bị hoãn do gặp phải sự cố bảo trì ngoài dự kiến.",
      "author": "ChatGPT4.1"
    },
    "71089": {
      "id": 2585453,
      "text": "Đội ngũ mặt đất hiện đang đánh giá tình hình để đảm bảo an toàn cho quý khách.",
      "author": "ChatGPT4.1"
    },
    "71090": {
      "id": 2585454,
      "text": "Thông tin cập nhật về giờ khởi hành mới của chuyến bay 209 sẽ được thông báo vào khoảng 3 giờ chiều.",
      "author": "ChatGPT4.1"
    },
    "71091": {
      "id": 2585455,
      "text": "Xin cảm ơn sự kiên nhẫn của quý khách.",
      "author": "ChatGPT4.1"
    }
  }
}
