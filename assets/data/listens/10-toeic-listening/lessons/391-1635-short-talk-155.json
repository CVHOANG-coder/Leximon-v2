  "translations": {
    "68289": {
      "id": 2624859,
      "text": "Xin chào mọi người!",
      "author": "ChatGPT4.1"
    },
    "68290": {
      "id": 2624860,
      "text": "Với tư cách là thị trưởng của Lakeville,",
      "author": "ChatGPT4.1"
    },
    "68291": {
      "id": 2624861,
      "text": "Tôi rất vui mừng được cùng mọi người chào mừng việc khai trương lại Công viên Lakeville vừa được nâng cấp của chúng ta.",
      "author": "ChatGPT4.1"
    },
    "68292": {
      "id": 2624862,
      "text": "Có rất nhiều địa điểm mới để khám phá,",
      "author": "ChatGPT4.1"
    },
    "68293": {
      "id": 2624863,
      "text": "vì vậy chúng tôi đã tổ chức một chuyến đi bộ ngắn cho mọi người.",
      "author": "ChatGPT4.1"
    },
    "68294": {
      "id": 2624864,
      "text": "Chúng ta sẽ đi dạo bên hồ và trên con đường đi bộ vừa được làm mới.",
      "author": "ChatGPT4.1"
    },
    "68295": {
      "id": 2624865,
      "text": "Buổi đi bộ sẽ kết thúc trên ngọn đồi phía bắc của công viên,",
      "author": "ChatGPT4.1"
    },
    "68296": {
      "id": 2624866,
      "text": "nơi chúng ta sẽ cùng nhau thưởng thức đồ ăn nhẹ và kem miễn phí.",
      "author": "ChatGPT4.1"
    },
    "68297": {
      "id": 2624867,
      "text": "Nếu bạn chụp ảnh, vui lòng chia sẻ chúng trên trang web của thành phố.",
      "author": "ChatGPT4.1"
    },
    "68298": {
      "id": 2624868,
      "text": "Hãy cùng nhau làm cho ngày hôm nay trở nên đáng nhớ nhé!",
      "author": "ChatGPT4.1"
    }
  }
