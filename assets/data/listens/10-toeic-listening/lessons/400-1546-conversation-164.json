  "translations": {
    "66221": {
      "id": 2612830,
      "text": "Xin lỗi,",
      "author": "ChatGPT4.1"
    },
    "66222": {
      "id": 2612831,
      "text": "Tôi vừa đi trên chuyến bay TR6 từ Tokyo,",
      "author": "ChatGPT4.1"
    },
    "66223": {
      "id": 2612832,
      "text": "nhưng chưa có hành lý ký gửi nào của tôi xuất hiện cả.",
      "author": "ChatGPT4.1"
    },
    "66224": {
      "id": 2612833,
      "text": "Cho tôi xem thẻ hành lý của bạn được không?",
      "author": "ChatGPT4.1"
    },
    "66225": {
      "id": 2612834,
      "text": "Hả?",
      "author": "ChatGPT4.1"
    },
    "66226": {
      "id": 2612835,
      "text": "Thẻ nào vậy?",
      "author": "ChatGPT4.1"
    },
    "66227": {
      "id": 2612836,
      "text": "Chúng thường được dán ở mặt sau vé máy bay của bạn.",
      "author": "ChatGPT4.1"
    },
    "66228": {
      "id": 2612837,
      "text": "Đó là những miếng dán nhỏ có mã vạch trên đó.",
      "author": "ChatGPT4.1"
    },
    "66229": {
      "id": 2612838,
      "text": "À, đúng rồi.",
      "author": "ChatGPT4.1"
    },
    "66230": {
      "id": 2612839,
      "text": "Đây ạ.",
      "author": "ChatGPT4.1"
    },
    "66231": {
      "id": 2612840,
      "text": "Hmm... Có vẻ như hành lý của bạn đã bị gửi nhầm đến Chicago rồi!",
      "author": "ChatGPT4.1"
    },
    "66232": {
      "id": 2612841,
      "text": "Tôi xin lỗi vì sự nhầm lẫn này.",
      "author": "ChatGPT4.1"
    },
    "66233": {
      "id": 2612842,
      "text": "Hôm nay hành lý sẽ không tới kịp, nhưng chúng tôi có thể gửi chúng tới cho bạn vào ngày mai.",
      "author": "ChatGPT4.1"
    },
    "66234": {
      "id": 2612843,
      "text": "Bạn chắc chắn hành lý sẽ tới vào ngày mai chứ?",
      "author": "ChatGPT4.1"
    },
    "66235": {
      "id": 2612844,
      "text": "Vâng.",
      "author": "ChatGPT4.1"
    },
    "66236": {
      "id": 2612845,
      "text": "Chỉ cần cho tôi địa chỉ, chúng tôi sẽ gửi hành lý đến nhà bạn trước trưa mai.",
      "author": "ChatGPT4.1"
    }
  }
