  "translations": {
    "68484": {
      "id": 2652237,
      "text": "Thứ Hai tới, Green Haven Landscaping sẽ giao những chậu cây mà chúng tôi đã đặt để làm đẹp các khu vực chung trong văn phòng của chúng ta.",
      "author": "ChatGPT4.1"
    },
    "68485": {
      "id": 2652238,
      "text": "Việc có cây xanh xung quanh có thể giúp giảm căng thẳng đáng kể và tăng năng suất làm việc.",
      "author": "ChatGPT4.1"
    },
    "68486": {
      "id": 2652239,
      "text": "Chúng tôi tin rằng bạn sẽ đánh giá cao sự thay đổi tích cực này trong môi trường làm việc của mình.",
      "author": "ChatGPT4.1"
    },
    "68487": {
      "id": 2652240,
      "text": "Nếu bạn quan tâm đến việc có một chậu cây nhỏ để trên bàn làm việc,",
      "author": "ChatGPT4.1"
    },
    "68488": {
      "id": 2652241,
      "text": "công ty sẽ vui lòng chi trả chi phí đó.",
      "author": "ChatGPT4.1"
    },
    "68489": {
      "id": 2652242,
      "text": "Để chọn cây của mình, vui lòng xem qua danh mục được đặt tại phòng nhân viên.",
      "author": "ChatGPT4.1"
    },
    "68490": {
      "id": 2652243,
      "text": "Danh mục này có hình ảnh và hướng dẫn chăm sóc cho từng lựa chọn.",
      "author": "ChatGPT4.1"
    }
  }
}
