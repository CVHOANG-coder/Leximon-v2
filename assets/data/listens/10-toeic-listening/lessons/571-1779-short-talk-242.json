  "translations": {
    "69997": {
      "id": 2642871,
      "text": "Tôi tên là Joseph Bishop, và tôi liên hệ với bạn từ Summit Insurance.",
      "author": "ChatGPT4.1"
    },
    "69998": {
      "id": 2642872,
      "text": "Liên quan đến yêu cầu gần đây của bạn,",
      "author": "ChatGPT4.1"
    },
    "69999": {
      "id": 2642873,
      "text": "chúng tôi đã xử lý yêu cầu bổ sung phạm vi bảo hiểm cho hợp đồng bảo hiểm nhà của bạn.",
      "author": "ChatGPT4.1"
    },
    "70000": {
      "id": 2642874,
      "text": "Một thư xác nhận chi tiết các điều khoản và phạm vi bảo hiểm mới đã được gửi qua dịch vụ chuyển phát bảo mật.",
      "author": "ChatGPT4.1"
    },
    "70001": {
      "id": 2642875,
      "text": "Dự kiến sẽ đến vào thứ Năm tuần tới.",
      "author": "ChatGPT4.1"
    },
    "70002": {
      "id": 2642876,
      "text": "Khi nhận được thư,",
      "author": "ChatGPT4.1"
    },
    "70003": {
      "id": 2642877,
      "text": "vui lòng xem lại các điều khoản đã cập nhật và liên hệ với văn phòng chúng tôi để nói chuyện với cố vấn bảo hiểm nếu bạn có bất kỳ thắc mắc nào.",
      "author": "ChatGPT4.1"
    },
    "70004": {
      "id": 2642878,
      "text": "Phạm vi bảo hiểm bổ sung của bạn sẽ có hiệu lực ngay lập tức sau khi bạn xác nhận đã nhận được thư xác nhận.",
      "author": "ChatGPT4.1"
    }
  }
