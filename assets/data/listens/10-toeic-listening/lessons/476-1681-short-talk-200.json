  "translations": {
    "68739": {
      "id": 2685088,
      "text": "Xin chào, tôi là Lisa từ văn phòng quản lý tòa nhà.",
      "author": "ChatGPT4.1"
    },
    "68740": {
      "id": 2685089,
      "text": "Chúng tôi đã lên lịch bảo trì thang máy vào ngày mai, bắt đầu từ 8 giờ sáng.",
      "author": "ChatGPT4.1"
    },
    "68741": {
      "id": 2685090,
      "text": "Rất tiếc, điều này có nghĩa là thang máy sẽ không hoạt động trong phần lớn thời gian trong ngày.",
      "author": "ChatGPT4.1"
    },
    "68742": {
      "id": 2685091,
      "text": "Nếu bạn cần hỗ trợ mang vật nặng hoặc có vấn đề về di chuyển,",
      "author": "ChatGPT4.1"
    },
    "68743": {
      "id": 2685092,
      "text": "vui lòng thông báo trước cho chúng tôi và chúng tôi sẽ sắp xếp hỗ trợ.",
      "author": "ChatGPT4.1"
    },
    "68744": {
      "id": 2685093,
      "text": "Chúng tôi xin lỗi vì sự bất tiện này và cảm ơn sự thông cảm của bạn.",
      "author": "ChatGPT4.1"
    },
    "68745": {
      "id": 2685094,
      "text": "Thang máy dự kiến sẽ hoạt động trở lại vào lúc 5 giờ chiều ngày mai.",
      "author": "ChatGPT4.1"
    }
  }
