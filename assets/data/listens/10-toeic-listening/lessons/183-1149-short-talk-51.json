  "translations": {
    "54212": {
      "id": 2595988,
      "text": "Bạn có thấy mình vất vả khi phải ra khỏi giường không?",
      "author": "ChatGPT4.1"
    },
    "54213": {
      "id": 2595989,
      "text": "Bạn có cảm thấy khó khăn khi thực hiện các công việc hàng ngày không?",
      "author": "ChatGPT4.1"
    },
    "54214": {
      "id": 2595990,
      "text": "Nếu bạn trả lời \"có\" cho những câu hỏi này,",
      "author": "ChatGPT4.1"
    },
    "54215": {
      "id": 2595991,
      "text": "các nhà trị liệu tại Phòng khám Wilton luôn sẵn sàng giúp đỡ bạn.",
      "author": "ChatGPT4.1"
    },
    "54216": {
      "id": 2595992,
      "text": "Bill Wilton, chủ sở hữu và là chuyên gia trị liệu chính, là tác giả của cuốn sách Nạp Năng Lượng Cho Cuộc Sống Của Bạn,",
      "author": "ChatGPT4.1"
    },
    "54217": {
      "id": 2595993,
      "text": "một cuốn sách nói về quản lý căng thẳng và bổ sung năng lượng mới vào cuộc sống hàng ngày.",
      "author": "ChatGPT4.1"
    },
    "54218": {
      "id": 2595994,
      "text": "Bác sĩ Wilton là một bác sĩ nổi tiếng thế giới đã đoạt nhiều giải thưởng với các phương pháp của mình,",
      "author": "ChatGPT4.1"
    },
    "54219": {
      "id": 2595995,
      "text": "và sự thành công mà ông có được trong việc điều trị bệnh nhân.",
      "author": "ChatGPT4.1"
    },
    "54220": {
      "id": 2595996,
      "text": "Gần đây ông được tạp chí Psychology Now giới thiệu là bác sĩ xuất sắc nhất tại Mỹ.",
      "author": "ChatGPT4.1"
    },
    "54221": {
      "id": 2595997,
      "text": "Chúng tôi mở cửa từ thứ Hai đến thứ Sáu từ 8 giờ sáng đến 8 giờ tối,",
      "author": "ChatGPT4.1"
    },
    "54222": {
      "id": 2595998,
      "text": "365 ngày trong năm.",
      "author": "ChatGPT4.1"
    },
    "54223": {
      "id": 2595999,
      "text": "Hãy gọi cho chúng tôi ngay bây giờ, theo số 5551232",
      "author": "ChatGPT4.1"
    },
    "54224": {
      "id": 2596000,
      "text": "để đặt lịch hẹn với một trong các chuyên gia trị liệu của chúng tôi.",
      "author": "ChatGPT4.1"
    },
    "54225": {
      "id": 2596001,
      "text": "Hãy nhắc đến thông điệp này để được giảm giá 10% cho lần hẹn đầu tiên.",
      "author": "ChatGPT4.1"
    }
  }
