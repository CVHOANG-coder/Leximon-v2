  "translations": {
    "52614": {
      "id": 868611,
      "text": "Tôi chỉ muốn thông báo nhanh cho bạn biết rằng có một thay đổi nhỏ trong chương trình hội nghị.",
      "author": "a user"
    },
    "52615": {
      "id": 868612,
      "text": "Caitlin George, người hướng dẫn Zumba đang ở giữa ùn tắc giao thông\n",
      "author": "a user"
    },
    "52617": {
      "id": 868614,
      "text": "vì vậy chúng ta sẽ rút ngắn buổi học",
      "author": "a user"
    },
    "52613": {
      "id": 2587679,
      "text": "Xin chào mọi người, chào mừng các bạn đến với ngày đầu tiên của triển lãm thể hình kéo dài 4 ngày của chúng tôi.",
      "author": "a user"
    },
    "52616": {
      "id": 2587680,
      "text": "Cô ấy sẽ đến trễ hai mươi phút,",
      "author": "ChatGPT4.1"
    },
    "52618": {
      "id": 2587681,
      "text": "và thêm một lớp thiền vào đầu buổi, do Courtney Hart hướng dẫn.",
      "author": "ChatGPT4.1"
    },
    "52619": {
      "id": 2587682,
      "text": "Điều này sẽ không ảnh hưởng đến thời gian chúng ta bắt đầu bữa trưa,",
      "author": "a user"
    },
    "52620": {
      "id": 2587683,
      "text": "đừng lo lắng, quầy salad sẽ được mở đúng lịch vào buổi trưa.",
      "author": "ChatGPT4.1"
    },
    "52621": {
      "id": 2587684,
      "text": "Có ai có câu hỏi nào không, hay chúng ta bắt đầu lớp thiền luôn nhé?",
