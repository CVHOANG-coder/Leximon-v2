  "translations": {
    "52929": {
      "id": 876525,
      "text": "Chúng ta đang ở vị trí thứ hai trong hàng chờ cất cánh và sẽ cất cánh trong thời gian ngắn nữa.",
      "author": "a user"
    },
    "52933": {
      "id": 876529,
      "text": "Các tiếp viên hàng không của chúng tôi cũng xin chào mừng quý khách lên máy bay và bây giờ sẽ hướng dẫn các quy trình an toàn cho quý khách.",
      "author": "a user"
    },
    "52934": {
      "id": 876530,
      "text": "Hãy nhớ quay lại chỗ ngồi của mình bất cứ khi nào đèn báo hiệu cài dây an toàn bật sáng,",
      "author": "a user"
    },
    "52926": {
      "id": 2594757,
      "text": "Xin chào quý ông và quý bà, tôi là cơ trưởng Susan Mccord, xin được phát biểu.",
      "author": "ChatGPT4.1"
    },
    "52927": {
      "id": 2594758,
      "text": "Tôi xin trân trọng chào mừng quý khách lên chuyến bay 786 của hãng hàng không British Airways.",
      "author": "a user"
    },
    "52928": {
      "id": 2594759,
      "text": "Hôm nay chúng ta sẽ bay từ London đến Singapore.",
      "author": "ChatGPT4.1"
    },
    "52930": {
      "id": 2594760,
      "text": "với thời gian hạ cánh dự kiến là 8:45 tối.",
      "author": "ChatGPT4.1"
    },
    "52931": {
      "id": 2594761,
      "text": "Tổng thời gian bay hôm nay là chín giờ hai mươi phút.",
      "author": "ChatGPT4.1"
    },
    "52932": {
      "id": 2594762,
      "text": "Thời tiết tại Singapore hôm nay nhiều mây và oi bức, ở mức 29 độ C.",
      "author": "ChatGPT4.1"
    },
    "52935": {
      "id": 2594763,
      "text": "mặc dù chúng tôi dự kiến sẽ có một chuyến bay êm ái hôm nay.",
      "author": "a user"
    },
    "52936": {
      "id": 2594764,
      "text": "Cảm ơn quý khách đã bay cùng British Air và chúc quý khách có chuyến đi vui vẻ đến châu Á.",
      "author": "ChatGPT4.1"
    }
  }
}
