  "translations": {
    "70013": {
      "id": 2642918,
      "text": "Chào buổi chiều, ông Henry.",
      "author": "ChatGPT4.1"
    },
    "70014": {
      "id": 2642919,
      "text": "Tôi là Rosemary Blake từ GreenEnergize.",
      "author": "ChatGPT4.1"
    },
    "70015": {
      "id": 2642920,
      "text": "Tôi rất vui được thông báo rằng ông đủ điều kiện tham gia chương trình nâng cấp nhà độc quyền của chúng tôi,",
      "author": "ChatGPT4.1"
    },
    "70016": {
      "id": 2642921,
      "text": "chương trình này dành phần thưởng cho những khách hàng đã đồng hành cùng chúng tôi trên 3 năm",
      "author": "ChatGPT4.1"
    },
    "70017": {
      "id": 2642922,
      "text": "bằng cách cung cấp cho họ một bộ điều nhiệt thông minh tiên tiến với mức giá giảm đáng kể.",
      "author": "ChatGPT4.1"
    },
    "70018": {
      "id": 2642923,
      "text": "Hiện tại, chúng tôi đang giới thiệu mẫu ClimateMaster 5 tiên tiến nhất.",
      "author": "ChatGPT4.1"
    },
    "70019": {
      "id": 2642924,
      "text": "Để nhận thiết bị đột phá này chỉ với 40 đô la,",
      "author": "ChatGPT4.1"
    },
    "70020": {
      "id": 2642925,
      "text": "ông chỉ cần truy cập trang web của chúng tôi và hoàn thành một khảo sát ngắn về thói quen môi trường.",
      "author": "ChatGPT4.1"
    },
    "70021": {
      "id": 2642926,
      "text": "Sau khi nhận được phản hồi của ông, chúng tôi sẽ nhanh chóng gửi thiết bị đến tận nhà,",
      "author": "ChatGPT4.1"
    },
    "70022": {
      "id": 2642927,
      "text": "và ông sẽ không phải lo về phí vận chuyển.",
      "author": "ChatGPT4.1"
    }
  }
