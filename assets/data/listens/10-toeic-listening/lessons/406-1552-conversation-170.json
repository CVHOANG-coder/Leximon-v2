  "translations": {
    "66321": {
      "id": 2781206,
      "text": "Tôi thực sự ngạc nhiên khi nhà hát tối nay chỉ đầy một nửa.",
      "author": "ChatGPT4.1"
    },
    "66322": {
      "id": 2781207,
      "text": "Thành thật mà nói, đây là vở nhạc kịch hay nhất mà tôi đã xem trong nhiều năm.",
      "author": "ChatGPT4.1"
    },
    "66323": {
      "id": 2781208,
      "text": "Thật ra thì, tôi chưa hoàn toàn bị thuyết phục.",
      "author": "ChatGPT4.1"
    },
    "66324": {
      "id": 2781209,
      "text": "Nhiều người sẽ đồng ý với tôi.",
      "author": "ChatGPT4.1"
    },
    "66325": {
      "id": 2781210,
      "text": "Có rất nhiều bài đánh giá tiêu cực trên mạng.",
      "author": "ChatGPT4.1"
    },
    "66326": {
      "id": 2781211,
      "text": "Ừ, bạn không phải lúc nào cũng có thể tin vào truyền thông.",
      "author": "ChatGPT4.1"
    },
    "66327": {
      "id": 2781212,
      "text": "Theo như tôi biết, một số bài đánh giá dạo này thực sự rất cay nghiệt.",
      "author": "ChatGPT4.1"
    },
    "66328": {
      "id": 2781213,
      "text": "Dù sao thì, bạn nghĩ sao nếu chúng ta ghé qua quán Pumpkin Bar and Grill trên đại lộ số 3?",
      "author": "ChatGPT4.1"
    },
    "66329": {
      "id": 2781214,
      "text": "Này, tôi rất muốn,",
      "author": "ChatGPT4.1"
    },
    "66330": {
      "id": 2781215,
      "text": "nhưng tôi phải học nhồi cho kỳ thi ngày mai.",
      "author": "ChatGPT4.1"
    },
    "66331": {
      "id": 2781216,
      "text": "Ba mẹ tôi chắc đang mong tôi về nhà trong vòng nửa tiếng nữa.",
      "author": "ChatGPT4.1"
    },
    "66332": {
      "id": 2781217,
      "text": "Tôi có thể khất lại chuyện đó được không?",
      "author": "ChatGPT4.1"
    }
  }
