  "translations": {
    "68957": {
      "id": 2615004,
      "text": "Bạn có phải là một doanh nhân đang gặp khó khăn trong việc làm cho thương hiệu của mình nổi bật trong thế giới số không?",
      "author": "ChatGPT4.1"
    },
    "68958": {
      "id": 2615005,
      "text": "Tại Panorama Digital, chúng tôi có một đội ngũ chiến lược gia xuất sắc và giàu kinh nghiệm",
      "author": "ChatGPT4.1"
    },
    "68959": {
      "id": 2615006,
      "text": "sẵn sàng nâng tầm khả năng hiển thị của bạn lên một cấp độ mới.",
      "author": "ChatGPT4.1"
    },
    "68960": {
      "id": 2615007,
      "text": "Chúng tôi sẽ chỉ định một chiến lược gia kỹ thuật số tận tâm để làm việc trực tiếp với bạn.",
      "author": "ChatGPT4.1"
    },
    "68961": {
      "id": 2615008,
      "text": "Sứ mệnh của chúng tôi là giúp bạn thu hút đúng khách hàng cho thương hiệu của mình.",
      "author": "ChatGPT4.1"
    },
    "68962": {
      "id": 2615009,
      "text": "Truy cập panoramadigital.com ngay hôm nay để bắt đầu với một khảo sát nhỏ.",
      "author": "ChatGPT4.1"
    },
    "68963": {
      "id": 2615010,
      "text": "Bạn sẽ nhận được phản hồi từ đội ngũ của chúng tôi để đặt lịch tư vấn miễn phí!",
      "author": "ChatGPT4.1"
    }
  }
