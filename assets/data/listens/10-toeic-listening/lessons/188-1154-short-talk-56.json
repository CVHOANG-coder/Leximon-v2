  "translations": {
    "54270": {
      "id": 920829,
      "text": "Công ty Bỏng Ngô của Peppy đã tài trợ cho hội nghị này năm thứ ba liên tiếp,",
      "author": "a user"
    },
    "54268": {
      "id": 2638148,
      "text": "Trước khi chúng ta bắt đầu với Hội nghị Cuồng Nhiệt Phim Kinh Điển,",
      "author": "ChatGPT4.1"
    },
    "54269": {
      "id": 2638149,
      "text": "Tôi muốn gửi lời cảm ơn lớn đến nhà tài trợ của chúng ta.",
      "author": "ChatGPT4.1"
    },
    "54271": {
      "id": 2638150,
      "text": "với những đóng góp vô cùng hào phóng.",
      "author": "ChatGPT4.1"
    },
    "54272": {
      "id": 2638151,
      "text": "Nhờ Peppy, chúng ta đã có thể mở rộng sự kiện và bổ sung thêm 200 vé,",
      "author": "ChatGPT4.1"
    },
    "54273": {
      "id": 2638152,
      "text": "4 suất chiếu bổ sung, và 3 buổi hỏi đáp với các diễn viên.",
      "author": "ChatGPT4.1"
    },
    "54274": {
      "id": 2638153,
      "text": "Một lần nữa, xin cảm ơn Công ty Bỏng Ngô Peppy.",
      "author": "ChatGPT4.1"
    },
    "54275": {
      "id": 2638154,
      "text": "Bây giờ, hãy bắt đầu buổi chiếu đầu tiên trong ngày, Top Gun, với nam diễn viên nổi tiếng Tom Cruise.",
      "author": "ChatGPT4.1"
    }
  }
