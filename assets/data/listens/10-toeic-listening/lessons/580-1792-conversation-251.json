  "translations": {
    "70128": {
      "id": 2620754,
      "text": "Chào bạn, tôi muốn nhận phòng.",
      "author": "ChatGPT4.1"
    },
    "70129": {
      "id": 2620755,
      "text": "Tôi đã đặt phòng dưới tên Thomas.",
      "author": "ChatGPT4.1"
    },
    "70130": {
      "id": 2620756,
      "text": "Chào mừng ông Thomas! Để tôi kiểm tra đặt phòng của ông.",
      "author": "ChatGPT4.1"
    },
    "70131": {
      "id": 2620757,
      "text": "Có vẻ như ông đã đặt một phòng queen cho ba đêm.",
      "author": "ChatGPT4.1"
    },
    "70132": {
      "id": 2620758,
      "text": "Đúng rồi.",
      "author": "ChatGPT4.1"
    },
    "70133": {
      "id": 2620759,
      "text": "Có thể lấy phòng có hướng nhìn ra thành phố không?",
      "author": "ChatGPT4.1"
    },
    "70134": {
      "id": 2620760,
      "text": "Tôi có thể sắp xếp được.",
      "author": "ChatGPT4.1"
    },
    "70135": {
      "id": 2620761,
      "text": "Chúng tôi có một phòng ở tầng mười với tầm nhìn đẹp ra trung tâm thành phố.",
      "author": "ChatGPT4.1"
    },
    "70136": {
      "id": 2620762,
      "text": "Như vậy được không ạ?",
      "author": "ChatGPT4.1"
    },
    "70137": {
      "id": 2620763,
      "text": "Nghe rất tuyệt.",
      "author": "ChatGPT4.1"
    },
    "70138": {
      "id": 2620764,
      "text": "Ở đây có Wi-Fi thế nào vậy?",
      "author": "ChatGPT4.1"
    },
    "70139": {
      "id": 2620765,
      "text": "Chúng tôi cung cấp Wi-Fi tốc độ cao miễn phí.",
      "author": "ChatGPT4.1"
    },
    "70140": {
      "id": 2620766,
      "text": "Chỉ cần dùng số phòng của bạn để kết nối.",
      "author": "ChatGPT4.1"
    },
    "70141": {
      "id": 2620767,
      "text": "Nếu bạn đã sẵn sàng, tôi chỉ cần giấy tờ tuỳ thân và thẻ tín dụng để hoàn tất nhận phòng.",
      "author": "ChatGPT4.1"
    }
