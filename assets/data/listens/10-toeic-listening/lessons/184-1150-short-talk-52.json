  "translations": {
    "54227": {
      "id": 895216,
      "text": "Bạn có rảnh để gặp tôi vào buổi trưa ngày mai không?",
      "author": "a user"
    },
    "54226": {
      "id": 2598051,
      "text": "Chào Jane, là Sarah đây.",
      "author": "ChatGPT4.1"
    },
    "54228": {
      "id": 2598052,
      "text": "Chúng ta cần tổ chức phỏng vấn cho vị trí đại diện chăm sóc khách hàng.",
      "author": "ChatGPT4.1"
    },
    "54229": {
      "id": 2598053,
      "text": "Như bạn đã biết, chỉ còn hai tháng nữa là trung tâm mới sẽ khai trương.",
      "author": "ChatGPT4.1"
    },
    "54230": {
      "id": 2598054,
      "text": "Tôi sẽ gửi cho bạn một email ngay bây giờ với danh sách rút gọn các ứng viên phù hợp nhất.",
      "author": "ChatGPT4.1"
    },
    "54231": {
      "id": 2598055,
      "text": "Trước khi chúng ta gặp nhau ngày mai, làm ơn chọn bốn ứng viên để tiếp tục.",
      "author": "ChatGPT4.1"
    },
    "54232": {
      "id": 2598056,
      "text": "Gọi lại cho tôi để xác nhận rằng ngày mai được với bạn nhé.",
      "author": "ChatGPT4.1"
    },
    "54233": {
      "id": 2598057,
      "text": "Cảm ơn!",
      "author": "ChatGPT4.1"
    }
