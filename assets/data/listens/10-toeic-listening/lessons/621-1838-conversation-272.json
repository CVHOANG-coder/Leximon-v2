  "translations": {
    "70895": {
      "id": 2584473,
      "text": "Có vẻ như triển lãm nghệ thuật nhìn chung đã thành công.",
      "author": "ChatGPT4.1"
    },
    "70896": {
      "id": 2584474,
      "text": "Về cơ bản thì đúng vậy.",
      "author": "ChatGPT4.1"
    },
    "70897": {
      "id": 2584475,
      "text": "Nhưng chúng ta đã có ít khách tham quan hơn dự kiến, điều này hơi gây thất vọng.",
      "author": "ChatGPT4.1"
    },
    "70898": {
      "id": 2584476,
      "text": "Tôi cũng cảm thấy như vậy.",
      "author": "ChatGPT4.1"
    },
    "70899": {
      "id": 2584477,
      "text": "Tôi nghĩ chúng ta đã có thể thu hút nhiều người hơn nếu làm quảng cáo mạnh hơn cho sự kiện.",
      "author": "ChatGPT4.1"
    },
    "70900": {
      "id": 2584478,
      "text": "Tôi đã đề cập điều đó với quản lý của chúng ta, ông Lee, vài tuần trước.",
      "author": "ChatGPT4.1"
    },
    "70901": {
      "id": 2584479,
      "text": "Tôi nghĩ ông ấy có thể sẽ đồng ý bổ sung chi phí quảng cáo.",
      "author": "ChatGPT4.1"
    },
    "70902": {
      "id": 2584480,
      "text": "Bạn có biết tại sao ông ấy không làm vậy không?",
      "author": "ChatGPT4.1"
    },
    "70903": {
      "id": 2584481,
      "text": "Tôi tin rằng ông ấy không thể dành thêm ngân sách cho việc quảng bá",
      "author": "ChatGPT4.1"
    },
    "70904": {
      "id": 2584482,
      "text": "bởi vì ngân sách của chúng ta đã bị ràng buộc vào những cam kết khác.",
      "author": "ChatGPT4.1"
    },
    "70905": {
      "id": 2584483,
      "text": "Tôi đoán chúng ta không thể kéo dài thêm ngân sách mà không phải lấy của người này để bù cho người kia.",
      "author": "ChatGPT4.1"
    }
  }
