  "translations": {
    "55597": {
      "id": 2650229,
      "text": "Kính thưa quý ông và quý bà.",
      "author": "ChatGPT4.1"
    },
    "55598": {
      "id": 2650230,
      "text": "Chào mừng quý vị đến với triển lãm đặc biệt tại Bảo tàng Nghệ thuật Hiện đại Chicago.",
      "author": "ChatGPT4.1"
    },
    "55599": {
      "id": 2650231,
      "text": "Triển lãm đặc biệt năm nay tập trung vào các tác phẩm nghệ thuật làm từ sản phẩm tái sử dụng hoặc tái chế.",
      "author": "ChatGPT4.1"
    },
    "55600": {
      "id": 2650232,
      "text": "Năm nay chúng tôi giới thiệu một số nghệ sĩ, mỗi người đều sử dụng các chất liệu khác nhau cho tác phẩm của mình.",
      "author": "ChatGPT4.1"
    },
    "55601": {
      "id": 2650233,
      "text": "Tôi sẽ hướng dẫn quý vị tham quan triển lãm,",
      "author": "ChatGPT4.1"
    },
    "55602": {
      "id": 2650234,
      "text": "và sau đó chúng ta sẽ nghe bài phát biểu của nữ nghệ sĩ trẻ, Natalie Port,",
      "author": "ChatGPT4.1"
    },
    "55603": {
      "id": 2650235,
      "text": "người có bốn tác phẩm trong triển lãm này.",
      "author": "ChatGPT4.1"
    },
    "55604": {
      "id": 2650236,
      "text": "Cô ấy đã sử dụng trải nghiệm thu gom rác trên các bãi biển ở Ấn Độ làm chất liệu và nguồn cảm hứng cho mình.",
      "author": "ChatGPT4.1"
    },
    "55605": {
      "id": 2650237,
      "text": "Nếu quý vị có câu hỏi trong bài phát biểu, xin vui lòng chờ đến cuối bài mới giơ tay,",
      "author": "ChatGPT4.1"
    },
    "55606": {
      "id": 2650238,
      "text": "vì chúng ta sẽ có một phần hỏi và đáp.",
      "author": "ChatGPT4.1"
    },
    "55607": {
      "id": 2650239,
      "text": "Trong năm phút nữa, xin mời quý vị đi theo tôi bằng cầu thang xuống tầng một,",
      "author": "ChatGPT4.1"
    },
    "55608": {
      "id": 2650240,
      "text": "và đó là cánh cửa đầu tiên bên trái sau khi quý vị đi qua cửa hàng quà tặng.",
      "author": "ChatGPT4.1"
    }
  }
}
