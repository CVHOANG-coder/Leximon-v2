  "translations": {
    "71092": {
      "id": 2616640,
      "text": "Trong tin tức địa phương, việc đóng đường tạm thời dự kiến sẽ diễn ra tại một số khu vực thuộc Nashville trong suốt tuần tới.",
      "author": "ChatGPT4.1"
    },
    "71093": {
      "id": 2616641,
      "text": "khi Sở Công trình Công cộng Music City thực hiện các dự án bảo trì đường bộ cần thiết.",
      "author": "ChatGPT4.1"
    },
    "71094": {
      "id": 2616642,
      "text": "Sở này đặt mục tiêu giảm thiểu sự gián đoạn đối với cư dân và các doanh nghiệp.",
      "author": "ChatGPT4.1"
    },
    "71095": {
      "id": 2616643,
      "text": "Do đó, công việc tại các khu dân cư sẽ được lên lịch từ 9 giờ sáng đến 3 giờ chiều,",
      "author": "ChatGPT4.1"
    },
    "71096": {
      "id": 2616644,
      "text": "trong khi bảo trì tại các khu thương mại sẽ diễn ra vào ban đêm từ 11 giờ tối đến 4 giờ sáng.",
      "author": "ChatGPT4.1"
    },
    "71097": {
      "id": 2616645,
      "text": "Người dân và chủ doanh nghiệp Nashville được khuyến khích truy cập trang web của Sở Công trình Công cộng Music City",
      "author": "ChatGPT4.1"
    },
    "71098": {
      "id": 2616646,
      "text": "để xem danh sách đầy đủ các khu vực sẽ bị đóng.",
      "author": "ChatGPT4.1"
    },
    "71099": {
      "id": 2616647,
      "text": "Nếu bạn gặp bất kỳ sự cố nào ngoài thời gian đã chỉ định,",
      "author": "ChatGPT4.1"
    },
    "71100": {
      "id": 2616648,
      "text": "xin vui lòng liên hệ bộ phận hỗ trợ của Sở qua số 555-6782.",
      "author": "ChatGPT4.1"
    }
  }
}
