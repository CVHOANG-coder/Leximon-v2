  "translations": {
    "70663": {
      "id": 1624848,
      "text": "trưng bày các mẫu vật được mượn từ các công viên thuỷ sinh trên toàn thế giới.",
      "author": "a user"
    },
    "70658": {
      "id": 2633506,
      "text": "Chào mừng bạn đến với Bảo tàng Kỳ Quan Thiên Nhiên Riverstone.",
      "author": "ChatGPT4.1"
    },
    "70659": {
      "id": 2633507,
      "text": "Hãy ghé qua quầy thông tin ở sảnh để lấy bản đồ tòa nhà và tờ rơi với thông tin chi tiết về các triển lãm hiện tại của chúng tôi.",
      "author": "ChatGPT4.1"
    },
    "70660": {
      "id": 2633508,
      "text": "Ngoài ra, đừng quên tham quan trưng bày mới nhất của chúng tôi, Kỳ Quan Biển Sâu,",
      "author": "ChatGPT4.1"
    },
    "70661": {
      "id": 2633509,
      "text": "nằm ở tầng ba, phòng triển lãm B.",
      "author": "ChatGPT4.1"
    },
    "70662": {
      "id": 2633510,
      "text": "Triển lãm này chỉ diễn ra trong tháng này,",
      "author": "ChatGPT4.1"
    },
    "70664": {
      "id": 2633511,
      "text": "Khi kết thúc chuyến tham quan, hãy ghé qua cửa hàng quà lưu niệm của chúng tôi.",
      "author": "ChatGPT4.1"
    },
    "70665": {
      "id": 2633512,
      "text": "Là khách tham quan, bạn sẽ được giảm giá 10% cho bất kỳ đơn hàng nào khi xuất trình vé vào cổng!",
      "author": "ChatGPT4.1"
    }
  }
