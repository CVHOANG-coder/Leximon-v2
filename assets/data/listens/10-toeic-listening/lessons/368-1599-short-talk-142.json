  "translations": {
    "66940": {
      "id": 2624011,
      "text": "Tôi muốn thông báo đến mọi người rằng chúng ta sẽ thay đổi chính sách liên quan đến giờ làm việc của công ty.",
      "author": "ChatGPT4.1"
    },
    "66941": {
      "id": 2624012,
      "text": "Tuần trước, tất cả nhân viên đã hoàn thành một cuộc khảo sát ý kiến, và với kết quả đó,",
      "author": "ChatGPT4.1"
    },
    "66942": {
      "id": 2624013,
      "text": "chúng tôi nhận thấy các bạn muốn ở lại muộn hơn một giờ vào thứ Năm,",
      "author": "ChatGPT4.1"
    },
    "66943": {
      "id": 2624014,
      "text": "để có thể rời văn phòng sớm hơn một giờ vào thứ Sáu.",
      "author": "ChatGPT4.1"
    },
    "66944": {
      "id": 2624015,
      "text": "Giờ đây, cuộc họp sáng thứ Sáu sẽ được tổ chức vào thứ Năm, lúc 5 giờ chiều.",
      "author": "ChatGPT4.1"
    },
    "66945": {
      "id": 2624016,
      "text": "Bạn sẽ phải ở lại muộn hơn, nhưng đa số đã đồng ý rằng điều này không phải là vấn đề.",
      "author": "ChatGPT4.1"
    },
    "66946": {
      "id": 2624017,
      "text": "Và điều tích cực là bạn có thể rời văn phòng sớm hơn một giờ vào thứ Sáu, tức là vào lúc 4 giờ chiều.",
      "author": "ChatGPT4.1"
    },
    "66947": {
      "id": 2624018,
      "text": "Việc thay đổi chính sách này sẽ giúp chúng ta cân bằng giữa công việc và cuộc sống tốt hơn.",
      "author": "ChatGPT4.1"
    },
    "66948": {
      "id": 2624019,
      "text": "Lưu ý, giờ làm việc mới này sẽ được áp dụng bắt đầu từ tuần đầu tiên của tháng Mười.",
      "author": "ChatGPT4.1"
    }
  }
