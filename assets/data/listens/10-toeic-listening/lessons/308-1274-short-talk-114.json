  "translations": {
    "55912": {
      "id": 2612184,
      "text": "Xin chào, cảm ơn bạn đã liên hệ với Hiệp hội Khoa học Zoodle.",
      "author": "ChatGPT4.1"
    },
    "55913": {
      "id": 2612185,
      "text": "Chúng tôi bắt đầu từ năm 1992 và có các buổi gặp mặt thường xuyên để thảo luận về khoa học",
      "author": "ChatGPT4.1"
    },
    "55914": {
      "id": 2612186,
      "text": "và làm thí nghiệm cùng trẻ em trong cộng đồng.",
      "author": "ChatGPT4.1"
    },
    "55915": {
      "id": 2612187,
      "text": "Chúng tôi luôn tìm kiếm các thành viên mới,",
      "author": "ChatGPT4.1"
    },
    "55916": {
      "id": 2612188,
      "text": "vì vậy nếu bạn quan tâm và muốn tìm hiểu thêm về tổ chức của chúng tôi,",
      "author": "ChatGPT4.1"
    },
    "55917": {
      "id": 2612189,
      "text": "bạn có thể đến tham dự một trong các buổi họp hàng tháng của chúng tôi,",
      "author": "ChatGPT4.1"
    },
    "55918": {
      "id": 2612190,
      "text": "được tổ chức vào thứ Ba đầu tiên của mỗi tháng tại trung tâm cộng đồng.",
      "author": "ChatGPT4.1"
    },
    "55919": {
      "id": 2612191,
      "text": "Nếu bạn cần thêm thông tin về lịch trình các sự kiện đặc biệt của chúng tôi,",
      "author": "ChatGPT4.1"
    },
    "55920": {
      "id": 2612192,
      "text": "xin vui lòng truy cập trang web của chúng tôi.",
      "author": "ChatGPT4.1"
    }
  }
