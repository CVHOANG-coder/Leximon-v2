    },
    "66373": {
      "id": 2598692,
      "text": "Chào buổi chiều.",
      "author": "ChatGPT4.1"
    },
    "66374": {
      "id": 2598693,
      "text": "Tôi gọi để hỏi về việc thuê phòng riêng của bạn cho một bữa tiệc chia tay về hưu của đồng nghiệp.",
      "author": "ChatGPT4.1"
    },
    "66375": {
      "id": 2598694,
      "text": "Chúng tôi sẽ có khoảng bốn mươi đến năm mươi người.",
