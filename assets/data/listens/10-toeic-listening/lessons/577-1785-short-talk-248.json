  "translations": {
    "70051": {
      "id": 2643075,
      "text": "Năm nay, như một phần trong cam kết đóng góp cho cộng đồng của chúng ta,",
      "author": "ChatGPT4.1"
    },
    "70052": {
      "id": 2643076,
      "text": "chúng tôi rất vui mừng thông báo về một chương trình quyên góp sách cộng đồng",
      "author": "ChatGPT4.1"
    },
    "70053": {
      "id": 2643077,
      "text": "nhằm hỗ trợ sáng kiến \"Reading Haven\" tại Trung tâm Thanh thiếu niên Khu trung tâm.",
      "author": "ChatGPT4.1"
    },
    "70054": {
      "id": 2643078,
      "text": "Chúng tôi mời các nhân viên quyên góp những cuốn sách còn mới hoặc đã qua sử dụng phù hợp cho trẻ em và thanh thiếu niên.",
      "author": "ChatGPT4.1"
    },
    "70055": {
      "id": 2643079,
      "text": "Thời gian thu gom sẽ diễn ra từ ngày 1 tháng 11 đến ngày 20 tháng 11,",
      "author": "ChatGPT4.1"
    },
    "70056": {
      "id": 2643080,
      "text": "với các điểm tiếp nhận đặt tại khu vực chung của tất cả các văn phòng.",
      "author": "ChatGPT4.1"
    },
    "70057": {
      "id": 2643081,
      "text": "Những cuốn sách được quyên góp sẽ giúp xây dựng một thư viện sôi động",
      "author": "ChatGPT4.1"
    },
    "70058": {
      "id": 2643082,
      "text": "khuyến khích tinh thần đọc sách và học tập trong giới trẻ cộng đồng của chúng ta.",
      "author": "ChatGPT4.1"
    },
    "70059": {
      "id": 2643083,
      "text": "Tôi sẽ sớm gửi một email với thông tin bổ sung về sứ mệnh của Trung tâm Thanh thiếu niên",
      "author": "ChatGPT4.1"
    },
    "70060": {
      "id": 2643084,
      "text": "và cách những đóng góp của chúng ta sẽ làm phong phú thêm cuộc sống của những người tham gia.",
      "author": "ChatGPT4.1"
    },
    "70061": {
      "id": 2643085,
      "text": "Hãy cùng nhau khơi dậy niềm đam mê đọc sách và học tập!",
      "author": "ChatGPT4.1"
    }
  }
