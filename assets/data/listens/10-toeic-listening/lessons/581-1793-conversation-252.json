  "translations": {
    "70142": {
      "id": 2621035,
      "text": "Chào buổi chiều, Green Clean Services. Sabrina đang nghe máy.",
      "author": "ChatGPT4.1"
    },
    "70143": {
      "id": 2621036,
      "text": "Tôi có thể giúp gì cho bạn hôm nay?",
      "author": "ChatGPT4.1"
    },
    "70144": {
      "id": 2621037,
      "text": "Chào bạn, tôi muốn xin báo giá dịch vụ dọn dẹp căn hộ của tôi.",
      "author": "ChatGPT4.1"
    },
    "70145": {
      "id": 2621038,
      "text": "Bạn có thể cho tôi biết giá dịch vụ của bạn không?",
      "author": "ChatGPT4.1"
    },
    "70146": {
      "id": 2621039,
      "text": "Chắc chắn rồi!",
      "author": "ChatGPT4.1"
    },
    "70147": {
      "id": 2621040,
      "text": "Giá của chúng tôi phụ thuộc vào số phòng và mức độ làm sạch mà bạn muốn:",
      "author": "ChatGPT4.1"
    },
    "70148": {
      "id": 2621041,
      "text": "cơ bản, sâu, hoặc tùy chọn.",
      "author": "ChatGPT4.1"
    },
    "70149": {
      "id": 2621042,
      "text": "Tôi nghĩ dọn dẹp cơ bản là được rồi.",
      "author": "ChatGPT4.1"
    },
    "70150": {
      "id": 2621043,
      "text": "Đó là một căn hộ một phòng ngủ.",
      "author": "ChatGPT4.1"
    },
    "70151": {
      "id": 2621044,
      "text": "Tuyệt vời, với một căn hộ một phòng ngủ và dọn dẹp cơ bản, giá khoảng 80 đô la.",
      "author": "ChatGPT4.1"
    },
    "70152": {
      "id": 2621045,
      "text": "Bạn có muốn đặt lịch không?",
      "author": "ChatGPT4.1"
    },
    "70153": {
      "id": 2621046,
      "text": "Chưa phải bây giờ.",
      "author": "ChatGPT4.1"
    },
    "70154": {
      "id": 2621047,
      "text": "Tôi cần kiểm tra lại lịch trình của mình và sẽ gọi lại cho bạn sau hôm nay.",
      "author": "ChatGPT4.1"
    }
