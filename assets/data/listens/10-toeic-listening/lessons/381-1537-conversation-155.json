  "translations": {
    "66100": {
      "id": 2588547,
      "text": "Xin chào. Tôi là Kate Harden.",
      "author": "ChatGPT4.1"
    },
    "66101": {
      "id": 2588548,
      "text": "Tôi muốn đặt hai phòng gia đình cho một đêm vào thứ Bảy tới.",
      "author": "ChatGPT4.1"
    },
    "66102": {
      "id": 2588549,
      "text": "Sẽ có một gia đình lớn gồm bốn người lớn và bốn trẻ em.",
      "author": "ChatGPT4.1"
    },
    "66103": {
      "id": 2588550,
      "text": "Xin lỗi, bà Harden.",
      "author": "ChatGPT4.1"
    },
    "66104": {
      "id": 2588551,
      "text": "Thành phố Langley đang tổ chức Lễ hội Nghệ thuật và Bí ngô thường niên,",
      "author": "ChatGPT4.1"
    },
    "66105": {
      "id": 2588552,
      "text": "vì vậy chúng tôi sẽ rất bận vào cuối tuần tới.",
      "author": "ChatGPT4.1"
    },
    "66106": {
      "id": 2588553,
      "text": "Tôi e rằng tôi sẽ phải đặt các phòng của bà ở những tầng khác nhau, nếu điều đó không sao cả.",
      "author": "ChatGPT4.1"
    },
    "66107": {
      "id": 2588554,
      "text": "Ha! Không sao đâu.",
      "author": "ChatGPT4.1"
    },
    "66108": {
      "id": 2588555,
      "text": "Lễ hội đó chính là điều mà chúng tôi dự định tham dự.",
      "author": "ChatGPT4.1"
    },
    "66109": {
      "id": 2588556,
      "text": "Bọn trẻ rất hào hứng với những vườn bí ngô và khu vực cho động vật ăn.",
      "author": "ChatGPT4.1"
    },
    "66110": {
      "id": 2588557,
      "text": "Vì vậy, miễn là chúng tôi không phải ở phòng tầng trệt thì ổn thôi.",
      "author": "ChatGPT4.1"
    },
    "66111": {
      "id": 2588558,
      "text": "Được rồi. Để tôi xem...",
      "author": "ChatGPT4.1"
    },
    "66112": {
      "id": 2588559,
      "text": "Một phòng gia đình có giá 180 đô la mỗi đêm.",
      "author": "ChatGPT4.1"
    },
    "66113": {
      "id": 2588560,
      "text": "Các phòng của bà sẽ ở tầng 2 và tầng 3.",
      "author": "ChatGPT4.1"
    },
    "66114": {
      "id": 2588561,
      "text": "Cảm ơn, xin hãy tiếp tục đặt phòng cho tôi.",
      "author": "ChatGPT4.1"
    }
  }
}
