    },
    "52511": {
      "id": 866680,
      "text": "đang tích tụ dày tới 4 inch",
      "author": "a user"
    },
    "52512": {
      "id": 866682,
      "text": "Vì vậy, hãy cố gắng tránh lái xe vào đêm muộn.",
      "author": "a user"
    },
    "52514": {
      "id": 866687,
      "text": "Vì vậy hãy nhớ, đây là một lựa chọn cho một số người đi lại làm việc.",
      "author": "a user"
    },
    "52505": {
      "id": 2582498,
      "text": "Bạn đang nghe bản tin giao thông của KFUD.",
      "author": "ChatGPT4.1"
    },
    "52506": {
      "id": 2582499,
      "text": "Giao thông hiện tại di chuyển cực kỳ chậm do tuyết rơi dày.",
      "author": "ChatGPT4.1"
    },
    "52507": {
      "id": 2582500,
      "text": "Cầu Thompson và cầu Government đều đang bị kẹt cứng.",
      "author": "ChatGPT4.1"
    },
    "52509": {
      "id": 2582501,
      "text": "Khi tuyết tiếp tục rơi, giao thông sẽ tiếp tục bị ùn tắc.",
      "author": "ChatGPT4.1"
    },
    "52510": {
      "id": 2582502,
      "text": "Các bản tin thời tiết cho biết tuyết sẽ còn rơi trong năm giờ tới,",
      "author": "ChatGPT4.1"
    },
    "52513": {
      "id": 2582503,
      "text": "Việc phong tỏa cầu Harbor đã hoàn tất,",
      "author": "ChatGPT4.1"
    },
    "52515": {
      "id": 2582504,
      "text": "Cảm ơn vì đã theo dõi.",
      "author": "ChatGPT4.1"
    },
    "52516": {
      "id": 2582505,
      "text": "Đây là Jane Clipp của KFUD, lựa chọn tốt nhất cho tin tức giao thông của bạn.",
      "author": "ChatGPT4.1"
    },
    "52517": {
      "id": 2582506,
      "text": "Hãy tiếp tục theo dõi cập nhật thời tiết cùng Katt Olsen.",
      "author": "ChatGPT4.1"
    }
  }
