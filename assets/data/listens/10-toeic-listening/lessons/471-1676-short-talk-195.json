  "translations": {
    "68700": {
      "id": 1568761,
      "text": "Tôi rất vui mừng được thông báo cho bạn về buổi tiệc nướng cộng đồng ngoài trời sắp tới của chúng tôi vào thứ bảy này!",
      "author": "a user"
    },
    "68699": {
      "id": 2652484,
      "text": "Xin chào, tôi là điều phối viên sự kiện từ Meadowbrook Apartments.",
      "author": "ChatGPT4.1"
    },
    "68701": {
      "id": 2652485,
      "text": "Sự kiện sẽ diễn ra tại sân trong từ 12 giờ trưa đến 4 giờ chiều,",
      "author": "ChatGPT4.1"
    },
    "68702": {
      "id": 2652486,
      "text": "và chúng tôi sẽ có nhiều lựa chọn món ăn, bao gồm cả các món chay và không chứa gluten.",
      "author": "ChatGPT4.1"
    },
    "68703": {
      "id": 2652487,
      "text": "Nếu bạn muốn mang theo một món ăn để chia sẻ hoặc giúp đỡ trong việc chuẩn bị,",
      "author": "ChatGPT4.1"
    },
    "68704": {
      "id": 2652488,
      "text": "hãy cho tôi biết nhé.",
      "author": "ChatGPT4.1"
    },
    "68705": {
      "id": 2652489,
      "text": "Chúng tôi hy vọng sẽ gặp bạn tại đó để cùng vui chơi, thưởng thức món ăn và kết nối với hàng xóm!",
      "author": "ChatGPT4.1"
    }
  }
