  "translations": {
    "67959": {
      "id": 2594974,
      "text": "Thật lạ là thợ điện vẫn chưa đến.",
      "author": "ChatGPT4.1"
    },
    "67960": {
      "id": 2594975,
      "text": "Tôi tưởng họ sẽ đến lúc 9 giờ sáng để thay tất cả đèn và lắp thêm ổ cắm quanh văn phòng.",
      "author": "ChatGPT4.1"
    },
    "67961": {
      "id": 2594976,
      "text": "Tôi quên chưa nói với bạn.",
      "author": "ChatGPT4.1"
    },
    "67962": {
      "id": 2594977,
      "text": "Thư ký ở công ty đã gửi email cho tôi khoảng 20 phút trước.",
      "author": "ChatGPT4.1"
    },
    "67963": {
      "id": 2594978,
      "text": "Việc giao bóng đèn bị kẹt lại ở hải quan,",
      "author": "ChatGPT4.1"
    },
    "67964": {
      "id": 2594979,
      "text": "vì vậy họ không thể thay đèn hôm nay.",
      "author": "ChatGPT4.1"
    },
    "67965": {
      "id": 2594980,
      "text": "Tuy nhiên, họ sẽ đến đây chiều nay để lắp thêm ổ cắm mới.",
      "author": "ChatGPT4.1"
    },
    "67966": {
      "id": 2594981,
      "text": "Ôi trời.",
      "author": "ChatGPT4.1"
    },
    "67967": {
      "id": 2594982,
      "text": "Tôi biết việc nhập khẩu các thiết bị chiếu sáng có thể gặp rủi ro.",
      "author": "ChatGPT4.1"
    },
    "67968": {
      "id": 2594983,
      "text": "Họ dự kiến sẽ đến khi nào?",
      "author": "ChatGPT4.1"
    },
    "67969": {
      "id": 2594984,
      "text": "Nhiếp ảnh gia sẽ đến chụp ảnh mới cho văn phòng vào sáng thứ Hai.",
      "author": "ChatGPT4.1"
    },
    "67970": {
      "id": 2594985,
      "text": "Cô ấy nói rằng đã trao đổi với đơn vị vận chuyển và các thiết bị sẽ về trong chiều nay.",
      "author": "ChatGPT4.1"
    },
    "67971": {
      "id": 2594986,
      "text": "Họ đã sắp xếp một số công nhân đến làm vào cuối tuần",
      "author": "ChatGPT4.1"
    },
    "67972": {
      "id": 2594987,
      "text": "để đảm bảo dự án hoàn thành trước sáng thứ Hai.",
      "author": "ChatGPT4.1"
    }
  }
