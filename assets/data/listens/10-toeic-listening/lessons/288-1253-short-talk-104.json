      "author": "ChatGPT4.1"
    },
    "55543": {
      "id": 2636686,
      "text": "Trường dạy lái xe Daniels có các giáo viên được chứng nhận, thân thiện, giàu kinh nghiệm và sẽ không bao giờ thúc ép bạn.",
      "author": "ChatGPT4.1"
    },
    "55544": {
      "id": 2636687,
      "text": "Những chiếc xe chúng tôi sử dụng đều được bảo hiểm 100% và chưa bao giờ bị hỏng hóc.",
      "author": "ChatGPT4.1"
    },
    "55545": {
