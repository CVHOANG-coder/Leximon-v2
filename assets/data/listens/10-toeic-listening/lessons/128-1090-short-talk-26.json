  "translations": {
    "53221": {
      "id": 2614838,
      "text": "Chào ông Geard.",
      "author": "ChatGPT4.1"
    },
    "53222": {
      "id": 2614839,
      "text": "Tôi là Gary gọi từ Sunflower Couriers.",
      "author": "ChatGPT4.1"
    },
    "53223": {
      "id": 2614840,
      "text": "Một trong những tài xế của chúng tôi đã cố gắng giao một bưu kiện gửi đến ông vào đầu giờ chiều nay,",
      "author": "ChatGPT4.1"
    },
    "53224": {
      "id": 2614841,
      "text": "nhưng người ở cửa trước nói rằng ông không sống ở đó.",
      "author": "ChatGPT4.1"
    },
    "53225": {
      "id": 2614842,
      "text": "Chúng tôi muốn sắp xếp lại thời gian giao hàng đến đúng địa chỉ càng sớm càng tốt.",
      "author": "ChatGPT4.1"
    },
    "53226": {
      "id": 2614843,
      "text": "Xin vui lòng gọi lại cho chúng tôi theo số 5557938 và cung cấp địa chỉ hiện tại của ông?",
      "author": "ChatGPT4.1"
    },
    "53227": {
      "id": 2614844,
      "text": "Đây là một bưu kiện lớn, nên tôi chắc chắn ông đang rất mong chờ nó.",
      "author": "ChatGPT4.1"
    },
    "53228": {
      "id": 2614845,
      "text": "Chúc ông một ngày tốt lành.",
      "author": "ChatGPT4.1"
    }
  }
