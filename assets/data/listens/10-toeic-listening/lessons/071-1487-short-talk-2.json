  "translations": {
    "64209": {
      "id": 1443147,
      "text": "khi đó chúng ta sẽ rút thăm để giành giải thưởng lớn.",
      "author": "a user"
    },
    "64210": {
      "id": 1443148,
      "text": "Giải đặc biệt năm nay do Lucy's Bakery tài trợ là một bộ dụng cụ làm bánh KitchenArt hoàn toàn mới.",
      "author": "a user"
    },
    "64213": {
      "id": 1443152,
      "text": "Quầy bán vé nằm ngay phía trước điểm tham quan bên phải.",
      "author": "a user"
    },
    "64205": {
      "id": 1443178,
      "text": "Chúng tôi chào đón mùa thu bằng cách trao tặng những phần quà may mắn cho khách tham dự.",
      "author": "a user"
    },
    "64207": {
      "id": 1443180,
      "text": "nhưng đừng lo, vẫn còn rất nhiều phần quà đang chờ phía trước, và có thể bạn sẽ là người tiếp theo!",
      "author": "a user"
    },
    "64204": {
      "id": 2594901,
      "text": "Chào mừng đến với Hội chợ Nông thôn!",
      "author": "ChatGPT4.1"
    },
    "64206": {
      "id": 2594902,
      "text": "Hôm qua, chúng tôi đã trao phần thưởng trị giá 500 đô la cho một số khách may mắn,",
      "author": "ChatGPT4.1"
    },
    "64208": {
      "id": 2594903,
      "text": "Ban giáo dục của thị trấn chúng ta sẽ tổ chức rút thăm trúng thưởng mỗi 30 phút cho đến 4 giờ chiều,",
      "author": "ChatGPT4.1"
    },
    "64211": {
      "id": 2594904,
      "text": "Để tham gia rút thăm, xin vui lòng đến quầy bán vé.",
      "author": "ChatGPT4.1"
    },
    "64212": {
      "id": 2594905,
      "text": "Nếu bạn đi vào từ cổng đầu tiên, hãy rẽ trái và đi thẳng đến cuối lối đi.",
      "author": "ChatGPT4.1"
    },
    "64214": {
      "id": 2594906,
      "text": "Chúc bạn may mắn!",
      "author": "ChatGPT4.1"
    }
  }
}
