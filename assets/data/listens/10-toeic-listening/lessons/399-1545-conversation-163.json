  "translations": {
    "66208": {
      "id": 2609431,
      "text": "Này, bạn nghĩ gì về bản ghi nhớ đó?",
      "author": "ChatGPT4.1"
    },
    "66209": {
      "id": 2609433,
      "text": "Bản ghi nhớ nào?",
      "author": "ChatGPT4.1"
    },
    "66210": {
      "id": 2609435,
      "text": "Tôi đã bị ngập trong công việc suốt cả sáng nay.",
      "author": "ChatGPT4.1"
    },
    "66211": {
      "id": 2609436,
      "text": "Tôi chưa có cơ hội kiểm tra email nữa.",
      "author": "ChatGPT4.1"
    },
    "66212": {
      "id": 2609437,
      "text": "Nó nói rằng từ tháng Bảy, tất cả nhân viên sẽ bắt đầu làm việc muộn hơn một tiếng rưỡi.",
      "author": "ChatGPT4.1"
    },
    "66213": {
      "id": 2609438,
      "text": "Chẳng phải điều đó thật tuyệt sao?",
      "author": "ChatGPT4.1"
    },
    "66214": {
      "id": 2609439,
      "text": "Tôi luôn muốn bắt đầu thói quen tập yoga buổi sáng nhưng chưa bao giờ có thời gian.",
      "author": "ChatGPT4.1"
    },
    "66215": {
      "id": 2609440,
      "text": "Chà, tôi nghĩ điều đó sẽ không hiệu quả đâu.",
      "author": "ChatGPT4.1"
    },
    "66216": {
      "id": 2609442,
      "text": "Thời gian kết thúc công việc chính thức là lúc năm giờ,",
      "author": "ChatGPT4.1"
    },
    "66217": {
      "id": 2609443,
      "text": "nhưng nhiều người trong chúng ta thường ở lại tới bảy giờ hầu hết các ngày.",
      "author": "ChatGPT4.1"
    },
    "66218": {
      "id": 2609445,
      "text": "Và bây giờ chúng ta sẽ không bao giờ về được nhà trước chín giờ!",
      "author": "ChatGPT4.1"
    },
    "66219": {
      "id": 2609446,
      "text": "Một số đồng nghiệp của chúng ta cũng không hào hứng với điều này,",
      "author": "ChatGPT4.1"
    },
    "66220": {
      "id": 2609448,
      "text": "đặc biệt là phòng kế toán.",
      "author": "ChatGPT4.1"
    }
  }
