  "translations": {
    "52855": {
      "id": 875571,
      "text": "Vâng, những ngôi nhà đang cháy hàng.",
      "author": "a user"
    },
    "52856": {
      "id": 875572,
      "text": "Tôi ngạc nhiên là có nhiều sự quan tâm đến dự án phát triển khu dân cư này.",
      "author": "a user"
    },
    "52851": {
      "id": 2585627,
      "text": "Xin chào, Caroline.",
      "author": "ChatGPT4.1"
    },
    "52852": {
      "id": 2585628,
      "text": "Tôi nghe nói công ty bạn đang quản lý khu căn hộ cao cấp lớn nhất từ trước đến nay.",
      "author": "ChatGPT4.1"
    },
    "52853": {
      "id": 2585629,
      "text": "Việc bán trước thế nào rồi?",
      "author": "ChatGPT4.1"
    },
    "52854": {
      "id": 2585630,
      "text": "Ý bạn là Albert Park chứ gì?",
      "author": "ChatGPT4.1"
    },
    "52857": {
      "id": 2585631,
      "text": "Điều đó đúng, xét đến mức giá khá cao.",
      "author": "ChatGPT4.1"
    },
    "52858": {
      "id": 2585632,
      "text": "Nhưng thực ra, vợ chồng tôi cũng quan tâm vì khu căn hộ này hoàn toàn mới và gần mọi tiện ích.",
      "author": "ChatGPT4.1"
    },
    "52859": {
      "id": 2585633,
      "text": "Ồ, thật sao?",
      "author": "ChatGPT4.1"
    },
    "52860": {
      "id": 2585634,
      "text": "Chúng tôi đang có chương trình khuyến mãi đặc biệt.",
      "author": "ChatGPT4.1"
    },
    "52861": {
      "id": 2585635,
      "text": "Nếu bạn mua một căn, bạn sẽ được bảo vệ tối đa cho ngôi nhà mới của mình",
      "author": "ChatGPT4.1"
    },
    "52862": {
      "id": 2585636,
      "text": "nhờ vào chế độ bảo hành mở rộng cho ngôi nhà mới của chúng tôi.",
      "author": "a user"
    },
    "52863": {
      "id": 2585637,
      "text": "Tuyệt vời quá!",
      "author": "ChatGPT4.1"
    },
    "52864": {
      "id": 2585638,
      "text": "Bạn có thể cho tôi biết thêm về các tiện ích đã đề xuất không?",
      "author": "a user"
    },
    "52865": {
      "id": 2585639,
      "text": "Vâng, tôi rất sẵn lòng đưa cho bạn một cuốn tài liệu quảng cáo.",
      "author": "a user"
    },
    "52866": {
      "id": 2585640,
      "text": "Chờ chút nhé… Nó ở trong xe tôi.",
      "author": "ChatGPT4.1"
    }
  }
