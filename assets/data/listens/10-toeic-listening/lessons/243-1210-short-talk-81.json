  "translations": {
    "55007": {
      "id": 963725,
      "text": "Tôi vừa nhận được bản báo cáo mà bạn đã lập về các khoản hoàn trả cho chuyến đi gần đây của bạn tới Ấn Độ.",
      "author": "a user"
    },
    "55008": {
      "id": 963726,
      "text": "Có một vấn đề nhỏ là mình đã nhận được đơn yêu cầu nhưng chưa nhận được biên lai từ chuyến đi.",
      "author": "a user"
    },
    "55009": {
      "id": 963727,
      "text": "Rất tiếc, tôi không thể hoàn trả chi phí cho bạn cho đến khi tôi có biên lai để xác nhận cho mỗi giao dịch.",
      "author": "a user"
    },
    "55011": {
      "id": 963729,
      "text": "nhưng tôi nghĩ quá trình sẽ nhanh hơn nếu bạn có thể đưa chúng đến trực tiếp.",
      "author": "a user"
    },
    "55012": {
      "id": 963730,
      "text": "Xin nhắc lại, phòng ban của tôi hiện đang được cải tạo,",
      "author": "a user"
    },
    "55005": {
      "id": 2602490,
      "text": "Chào Sarah.",
      "author": "ChatGPT4.1"
    },
    "55006": {
      "id": 2602491,
      "text": "Mindy đây, gọi từ phòng Nhân sự.",
      "author": "ChatGPT4.1"
    },
    "55010": {
      "id": 2602492,
      "text": "Bạn có thể gửi hóa đơn cho tôi qua email,",
      "author": "ChatGPT4.1"
    },
    "55013": {
      "id": 2602493,
      "text": "nên chúng tôi đang dùng chung văn phòng với phòng thiết kế.",
      "author": "ChatGPT4.1"
    }
  }
}
