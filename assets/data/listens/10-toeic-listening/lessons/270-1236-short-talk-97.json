  "translations": {
    "55313": {
      "id": 969691,
      "text": "Rất tiếc, chúng tôi sắp hết tiền để mua những \"bữa ăn sơ chế sẵn\" (kèm dụng cụ)",
      "author": "a user"
    },
    "55310": {
      "id": 2636599,
      "text": "Chào buổi chiều, và cảm ơn bạn đã quan tâm đến Dự án Nuôi Dưỡng Cộng Đồng.",
      "author": "ChatGPT4.1"
    },
    "55311": {
      "id": 2636600,
      "text": "Nhiều người trong các bạn biết, chúng tôi đã nỗ lực xây dựng một kế hoạch dành cho các gia đình gặp rủi ro đang phải sống vô gia cư.",
      "author": "ChatGPT4.1"
    },
    "55312": {
      "id": 2636601,
      "text": "Mặc dù chúng tôi đã nhận được các khoản quyên góp,",
      "author": "ChatGPT4.1"
    },
    "55314": {
      "id": 2636602,
      "text": "Điều này có nghĩa là chúng tôi cần gây quỹ nhiều hơn để mua thức ăn và chi trả cho việc giao hàng.",
      "author": "ChatGPT4.1"
    },
    "55315": {
      "id": 2636603,
      "text": "Chúng ta cần liên hệ với mọi người trong cộng đồng để xin giúp đỡ.",
      "author": "ChatGPT4.1"
    },
    "55316": {
      "id": 2636604,
      "text": "Đây là những gì tôi cần bạn làm;",
      "author": "ChatGPT4.1"
    },
    "55317": {
      "id": 2636605,
      "text": "hãy lập danh sách các chủ doanh nghiệp địa phương quan tâm đến việc giúp đỡ chúng ta.",
      "author": "ChatGPT4.1"
    }
  }
