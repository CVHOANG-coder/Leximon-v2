  "translations": {
    "55329": {
      "id": 2637024,
      "text": "Xin chào, tin nhắn này dành cho Russell.",
      "author": "ChatGPT4.1"
    },
    "55330": {
      "id": 2637025,
      "text": "Tôi là Dan, từ Công ty Food Source.",
      "author": "ChatGPT4.1"
    },
    "55331": {
      "id": 2637026,
      "text": "Đơn đặt hàng hàng tuần của bạn vừa đến và tôi rất ngạc nhiên về số lượng chanh bạn đã đặt.",
      "author": "ChatGPT4.1"
    },
    "55332": {
      "id": 2637027,
      "text": "Vì đây là lần đầu tiên bạn cần nhiều chanh đến vậy,",
      "author": "ChatGPT4.1"
    },
    "55333": {
      "id": 2637028,
      "text": "nên tôi sẽ tiến hành thay đổi số lượng về như đơn đặt hàng thông thường của bạn.",
      "author": "ChatGPT4.1"
    },
    "55334": {
      "id": 2637029,
      "text": "Gọi cho tôi nếu bạn muốn giữ nguyên đơn đặt hàng như vậy.",
      "author": "ChatGPT4.1"
    },
    "55335": {
      "id": 2637030,
      "text": "Tôi cũng muốn thông báo với bạn rằng tôi sẽ vắng mặt tại văn phòng bắt đầu từ thứ Hai,",
      "author": "ChatGPT4.1"
    },
    "55336": {
      "id": 2637031,
      "text": "và đồng nghiệp Joe của tôi sẽ phụ trách các tài khoản của tôi.",
      "author": "ChatGPT4.1"
    },
    "55337": {
      "id": 2637032,
      "text": "Nếu bạn cần gì tuần tới, vui lòng gọi cho Joe.",
      "author": "ChatGPT4.1"
    }
  }
