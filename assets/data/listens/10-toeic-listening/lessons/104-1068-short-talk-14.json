    "52939": {
      "id": 876536,
      "text": "và những khuyến nghị của họ về truyền thông trong thế kỷ 21.",
      "author": "a user"
    },
    "52943": {
      "id": 876540,
      "text": "Tuy nhiên, việc quan trọng trước tiên là làm quen với nhau qua một buổi gặp gỡ với cà phê và bánh donut.",
      "author": "a user"
    },
    "52937": {
      "id": 2582630,
      "text": "Chào mừng quý ông và quý bà đến với Hội nghị Công nghệ Truyền thông.",
      "author": "ChatGPT4.1"
    },
    "52938": {
      "id": 2582631,
      "text": "Trong hai ngày tới, quý vị sẽ có cơ hội lắng nghe từ một số chuyên gia truyền thông hàng đầu,",
      "author": "ChatGPT4.1"
    },
    "52940": {
      "id": 2582632,
      "text": "Quý vị đang ở cùng với những người tham dự khác đến từ hơn 25 quốc gia khác nhau.",
      "author": "ChatGPT4.1"
    },
    "52941": {
      "id": 2582633,
      "text": "Hôm nay, quý vị sẽ có cơ hội lắng nghe các chuyên gia trong ngành,",
      "author": "ChatGPT4.1"
    },
    "52942": {
      "id": 2582634,
      "text": "tham gia các cuộc tranh luận, và hoàn thành những hoạt động nhóm nhỏ.",
      "author": "ChatGPT4.1"
    },
    "52944": {
      "id": 2582635,
      "text": "Xin hãy đeo bảng tên của mình và làm quen với những người xung quanh.",
      "author": "ChatGPT4.1"
    },
    "52945": {
      "id": 2582636,
      "text": "Chúng ta sẽ có bài thuyết trình đầu tiên trong mười lăm phút nữa tại phòng Sunset.",
      "author": "ChatGPT4.1"
    }
  }
