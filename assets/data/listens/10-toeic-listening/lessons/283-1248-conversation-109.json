  "translations": {
    "55475": {
      "id": 2614195,
      "text": "Chào Miriam! Bạn khỏe không?",
      "author": "ChatGPT4.1"
    },
    "55476": {
      "id": 2614196,
      "text": "Tôi biết bạn đang cân nhắc việc nhờ bên ngoài giúp thiết kế lại văn phòng của bạn.",
      "author": "ChatGPT4.1"
    },
    "55477": {
      "id": 2614197,
      "text": "Bạn đã đưa ra quyết định nào chưa?",
      "author": "ChatGPT4.1"
    },
    "55478": {
      "id": 2614198,
      "text": "Chào! Vâng, tôi quyết định sẽ liều thử và cứ làm thôi!",
      "author": "ChatGPT4.1"
    },
    "55479": {
      "id": 2614199,
      "text": "Tôi đã liên hệ với một công ty mà chị gái tôi từng làm việc cùng tên là Everyday.",
      "author": "ChatGPT4.1"
    },
    "55480": {
      "id": 2614200,
      "text": "Vì chị tôi rất hài lòng với văn phòng mà Everyday thiết kế,",
      "author": "ChatGPT4.1"
    },
    "55481": {
      "id": 2614201,
      "text": "Tôi đã quyết định chọn họ.",
      "author": "ChatGPT4.1"
    },
    "55482": {
      "id": 2614202,
      "text": "Ôi, tin tuyệt quá!",
      "author": "ChatGPT4.1"
    },
    "55483": {
      "id": 2614203,
      "text": "Tôi biết bạn sẽ đi châu Âu trong tháng tới,",
      "author": "ChatGPT4.1"
    },
    "55484": {
      "id": 2614204,
      "text": "nên tôi không chắc bạn có quyết định hoãn kế hoạch không.",
      "author": "ChatGPT4.1"
    },
    "55485": {
      "id": 2614205,
      "text": "Thực ra, Everyday rất sẵn lòng làm việc với tôi qua video conference,",
      "author": "ChatGPT4.1"
    },
    "55486": {
      "id": 2614206,
      "text": "vì vậy dường như dự án sẽ hoàn thành khi tôi trở về.",
      "author": "ChatGPT4.1"
    },
    "55487": {
      "id": 2614207,
      "text": "Sẽ tuyệt lắm vì điều đó có nghĩa là tôi sẽ không phải làm việc ở phòng họp như dự định ban đầu của mình.",
      "author": "ChatGPT4.1"
    }
  }
