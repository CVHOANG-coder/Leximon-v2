  "translations": {
    "66272": {
      "id": 2618350,
      "text": "Này, tuần sau là sinh nhật của Angela đấy.",
      "author": "ChatGPT4.1"
    },
    "66273": {
      "id": 2618351,
      "text": "Bây giờ nghĩ lại,",
      "author": "ChatGPT4.1"
    },
    "66274": {
      "id": 2618352,
      "text": "chúng ta chưa bao giờ tổ chức tiệc chào mừng cho cô ấy, phải không?",
      "author": "ChatGPT4.1"
    },
    "66275": {
      "id": 2618353,
      "text": "Cô ấy đã ở cùng chúng ta gần một năm rồi.",
      "author": "ChatGPT4.1"
    },
    "66276": {
      "id": 2618354,
      "text": "Ừ, tôi nghĩ chúng ta thật sự nợ cô ấy điều đó.",
      "author": "ChatGPT4.1"
    },
    "66277": {
      "id": 2618355,
      "text": "Hãy đi đâu đó thật đẹp nhé.",
      "author": "ChatGPT4.1"
    },
    "66278": {
      "id": 2618356,
      "text": "À, dạo này cô ấy cứ nhắc mãi về quán bar Moon này.",
      "author": "ChatGPT4.1"
    },
    "66279": {
      "id": 2618357,
      "text": "Nhưng chỗ đó đến 10 giờ tối mới mở cửa.",
      "author": "ChatGPT4.1"
    },
    "66280": {
      "id": 2618358,
      "text": "Sẽ không lý tưởng nếu mang theo cả lũ trẻ của mọi người.",
      "author": "ChatGPT4.1"
    },
    "66281": {
      "id": 2618359,
      "text": "Còn nhà hàng Thái mới khai trương thì sao?",
      "author": "ChatGPT4.1"
    },
    "66282": {
      "id": 2618360,
      "text": "Adonia à?",
      "author": "ChatGPT4.1"
    },
    "66283": {
      "id": 2618361,
      "text": "Đó cũng là một lựa chọn.",
      "author": "ChatGPT4.1"
    },
    "66284": {
      "id": 2618362,
      "text": "Nhưng, ừm, một số người trong chúng ta không thích đồ ăn Thái.",
      "author": "ChatGPT4.1"
    },
    "66285": {
      "id": 2618363,
      "text": "Có lẽ chúng ta nên thu hẹp lại lựa chọn.",
      "author": "ChatGPT4.1"
    },
    "66286": {
      "id": 2618364,
      "text": "Tôi biết chắc chắn chúng ta cần đặt một phòng riêng có thể chứa được 20 người.",
      "author": "ChatGPT4.1"
    }
  }
