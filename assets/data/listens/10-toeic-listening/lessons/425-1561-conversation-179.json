  "translations": {
    "66466": {
      "id": 2638388,
      "text": "Chào, tôi là Charles Blake.",
      "author": "ChatGPT4.1"
    },
    "66467": {
      "id": 2638389,
      "text": "Tôi là bệnh nhân của bác sĩ Sendroff.",
      "author": "ChatGPT4.1"
    },
    "66468": {
      "id": 2638390,
      "text": "Tôi sẽ đi công tác ở châu Á vào tháng tới,",
      "author": "ChatGPT4.1"
    },
    "66469": {
      "id": 2638391,
      "text": "nên tôi đã yêu cầu trước một bản sao hồ sơ y tế của mình.",
      "author": "ChatGPT4.1"
    },
    "66470": {
      "id": 2638392,
      "text": "Cảm ơn ông đã gọi, ông Blake.",
      "author": "ChatGPT4.1"
    },
    "66471": {
      "id": 2638393,
      "text": "Tôi sẽ chuyển cuộc gọi của ông.",
      "author": "ChatGPT4.1"
    },
    "66472": {
      "id": 2638394,
      "text": "Cô Heather phụ trách việc cung cấp hồ sơ bệnh nhân.",
      "author": "ChatGPT4.1"
    },
    "66473": {
      "id": 2638395,
      "text": "Cảm ơn.",
      "author": "ChatGPT4.1"
    },
    "66474": {
      "id": 2638396,
      "text": "Xin chào, ông Blake. Tôi đã cố liên lạc với ông sáng nay.",
      "author": "ChatGPT4.1"
    },
    "66475": {
      "id": 2638397,
      "text": "Chỉ là ông chưa xác định rõ muốn nhận hồ sơ y tế của mình qua đường bưu điện hay qua email.",
      "author": "ChatGPT4.1"
    },
    "66476": {
      "id": 2638398,
      "text": "Ôi, tôi sơ ý quá.",
      "author": "ChatGPT4.1"
    },
    "66477": {
      "id": 2638399,
      "text": "Tôi không phải lúc nào cũng nghe điện thoại trong giờ làm việc.",
      "author": "ChatGPT4.1"
    },
    "66478": {
      "id": 2638400,
      "text": "Ờ... Ông/cô có thể gửi bằng đường chuyển phát nhanh không?",
      "author": "ChatGPT4.1"
    },
    "66479": {
      "id": 2638401,
      "text": "Dạ, chắc chắn rồi. Xin chờ một lát, thưa ông.",
      "author": "ChatGPT4.1"
    },
    "66480": {
      "id": 2638402,
      "text": "Tôi sẽ chuyển ông lại cho lễ tân của chúng tôi.",
      "author": "ChatGPT4.1"
    },
    "66481": {
      "id": 2638403,
      "text": "Cô ấy sẽ cần địa chỉ và một số điện thoại dự phòng của ông.",
      "author": "ChatGPT4.1"
    },
    "66482": {
