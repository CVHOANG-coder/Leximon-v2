    },
    "53791": {
      "id": 2590744,
      "text": "Tôi đã nhận được email bạn gửi chiều hôm qua.",
      "author": "ChatGPT4.1"
    },
    "53792": {
      "id": 2590745,
      "text": "Tôi nghĩ nó rất ổn, nhưng tôi cần sửa lại một chỗ.",
      "author": "ChatGPT4.1"
    },
    "53795": {
      "id": 2590746,
      "text": "Thật khó để kiểm tra với tất cả các quốc gia khác nhau.",
      "author": "ChatGPT4.1"
    },
    "53797": {
      "id": 2590747,
      "text": "Tôi không chắc về chi phí sinh hoạt ở Athens.",
      "author": "ChatGPT4.1"
    },
    "53799": {
      "id": 2590748,
      "text": "Tôi thấy mình đã tiêu nhiều hơn so với bạn ước tính.",
      "author": "ChatGPT4.1"
    },
    "53800": {
      "id": 2590749,
      "text": "Tôi nghĩ giá đã tăng vọt trong năm vừa rồi.",
      "author": "ChatGPT4.1"
    },
    "53802": {
      "id": 2590750,
      "text": "Tôi đã dùng dữ liệu mà công ty thu thập được, nhưng là từ hai năm trước.",
      "author": "ChatGPT4.1"
    },
    "53803": {
      "id": 2590751,
      "text": "Tôi sẽ liên hệ với một số người quen để xem chúng ta có thể lấy được báo giá hiện tại không.",
      "author": "ChatGPT4.1"
    }
