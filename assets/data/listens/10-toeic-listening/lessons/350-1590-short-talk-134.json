  "translations": {
    "66849": {
      "id": 2598062,
      "text": "Trước khi chúng ta bắt đầu buổi học piano,",
      "author": "ChatGPT4.1"
    },
    "66850": {
      "id": 2598063,
      "text": "Tôi muốn thông báo cho mọi người về một ưu đãi lớn đang được cung cấp tại Trung tâm Gia đình Orlando.",
      "author": "ChatGPT4.1"
    },
    "66851": {
      "id": 2598064,
      "text": "Nhiều người trong số các bạn biết rằng ở đây có nhiều cấp độ lớp học khác nhau dành cho các loại nhạc cụ khác nhau.",
      "author": "ChatGPT4.1"
    },
    "66852": {
      "id": 2598065,
      "text": "Chúng tôi luôn khuyến khích bạn thử chơi một nhạc cụ mới.",
      "author": "ChatGPT4.1"
    },
    "66853": {
      "id": 2598066,
      "text": "Trong tháng Chín, nếu bạn tham gia ba lớp học khác nhau tại đây,",
      "author": "ChatGPT4.1"
    },
    "66854": {
      "id": 2598067,
      "text": "lớp học thứ ba của bạn sẽ được miễn phí vào tháng sau!",
      "author": "ChatGPT4.1"
    },
    "66855": {
      "id": 2598068,
      "text": "Nếu bạn muốn biết thêm thông tin,",
      "author": "ChatGPT4.1"
    },
    "66856": {
      "id": 2598069,
      "text": "hãy lấy một tờ rơi từ văn phòng giám đốc ở tầng hai có kèm theo lịch trình và mô tả lớp học.",
      "author": "ChatGPT4.1"
    },
    "66857": {
      "id": 2598070,
      "text": "Hãy chắc chắn rằng bạn đăng ký tên cho các lớp học của mình để đủ điều kiện nhận ưu đãi càng sớm càng tốt.",
      "author": "ChatGPT4.1"
    }
  }
}
