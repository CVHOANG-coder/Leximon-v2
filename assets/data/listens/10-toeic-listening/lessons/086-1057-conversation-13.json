  "translations": {
    "52790": {
      "id": 872243,
      "text": "Thật tốt khi thấy bạn kịp trở lại trước khi cửa hàng đóng cửa!",
      "author": "a user"
    },
    "52791": {
      "id": 872244,
      "text": "Cuộc họp với quản lý khu vực diễn ra tốt đẹp chứ?",
      "author": "a user"
    },
    "52795": {
      "id": 872248,
      "text": "Tôi tưởng doanh thu của chúng ta khá cao.",
      "author": "a user"
    },
    "52796": {
      "id": 872249,
      "text": "Cô ấy đã đưa ra đề xuất gì vậy?",
      "author": "a user"
    },
    "52797": {
      "id": 872250,
      "text": "Cô ấy muốn chúng ta làm nổi bật các mặt hàng giảm giá ở cửa sổ phía trước.",
      "author": "a user"
    },
    "52798": {
      "id": 872308,
      "text": "Như bạn đã biết, khi một chiếc áo phông hoặc một chiếc quần dài được giảm giá",
      "author": "a user"
    },
    "52799": {
      "id": 872309,
      "text": "nó di chuyển về phía sau cửa hàng trong khu vực giảm giá.",
      "author": "a user"
    },
    "52800": {
      "id": 872310,
      "text": "Cô ấy lo ngại rằng khách hàng của chúng ta không biết về khu vực này của cửa hàng.",
      "author": "a user"
    },
    "52802": {
      "id": 872312,
      "text": "Tôi có thể bắt đầu nghiên cứu cách bày trí ngay bây giờ.",
      "author": "a user"
    },
    "52803": {
      "id": 872314,
