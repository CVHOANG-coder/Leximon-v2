  "translations": {
    "69975": {
      "id": 2642816,
      "text": "Chúng ta đã chuẩn bị xong cho bữa tiệc nghỉ hưu của cô Johnson vào thứ Bảy chưa?",
      "author": "ChatGPT4.1"
    },
    "69976": {
      "id": 2642817,
      "text": "Sau bao năm làm việc ở trường Tiểu học Greenfield, chúng ta muốn nó thật đặc biệt cho cô ấy.",
      "author": "ChatGPT4.1"
    },
    "69977": {
      "id": 2642818,
      "text": "Có một trục trặc nhỏ.",
      "author": "ChatGPT4.1"
    },
    "69978": {
      "id": 2642819,
      "text": "Tôi vừa nghe tin từ khách sạn Bloomfield nơi chúng ta dự định tổ chức;",
      "author": "ChatGPT4.1"
    },
    "69979": {
      "id": 2642820,
      "text": "họ đột ngột đóng cửa phòng ăn để sửa chữa vào cuối tuần này.",
      "author": "ChatGPT4.1"
    },
    "69980": {
      "id": 2642821,
      "text": "Ôi không, họ có nói lý do tại sao không thông báo cho chúng ta sớm hơn không?",
      "author": "ChatGPT4.1"
    },
    "69981": {
      "id": 2642822,
      "text": "Dường như đó là quyết định vào phút cuối do có sự cố bảo trì khẩn cấp.",
      "author": "ChatGPT4.1"
    },
    "69982": {
      "id": 2642823,
      "text": "Họ đề nghị giảm giá 30% nếu chúng ta dời lịch sang cuối tuần sau.",
      "author": "ChatGPT4.1"
    },
    "69983": {
      "id": 2642824,
      "text": "Như vậy là khá hào phóng.",
      "author": "ChatGPT4.1"
    },
    "69984": {
      "id": 2642825,
      "text": "Bạn thử xem Chủ nhật tới có còn chỗ không nhé?",
      "author": "ChatGPT4.1"
    },
    "69985": {
      "id": 2642826,
      "text": "Như vậy, có thể sẽ có nhiều người tham dự hơn.",
      "author": "ChatGPT4.1"
    },
    "69986": {
      "id": 2642827,
      "text": "Được rồi. Tôi sẽ gọi cho họ ngay bây giờ.",
      "author": "ChatGPT4.1"
    }
  }
}
