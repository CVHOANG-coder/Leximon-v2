  "translations": {
    "66392": {
      "id": 2599338,
      "text": "Xin chào. Tôi là Barry, từ Dịch vụ giao hàng Downtown.",
      "author": "ChatGPT4.1"
    },
    "66393": {
      "id": 2599339,
      "text": "Bạn đã sẵn sàng để chúng tôi bắt đầu chưa?",
      "author": "ChatGPT4.1"
    },
    "66394": {
      "id": 2599340,
      "text": "Xin lỗi, tôi không mong bạn đến cho đến ngày mai.",
      "author": "ChatGPT4.1"
    },
    "66395": {
      "id": 2599341,
      "text": "Ngày chuyển nhà của chúng tôi đã bị lùi lại,",
      "author": "ChatGPT4.1"
    },
    "66396": {
      "id": 2599342,
      "text": "vì vậy tôi đã gửi email cho văn phòng chính của các bạn vào tuần trước.",
      "author": "ChatGPT4.1"
    },
    "66397": {
      "id": 2599343,
      "text": "Ồ, ừm... Được rồi.",
      "author": "ChatGPT4.1"
    },
    "66398": {
      "id": 2599344,
      "text": "Tôi chưa nhận được tin nhắn đó.",
      "author": "ChatGPT4.1"
    },
    "66399": {
      "id": 2599345,
      "text": "Thật ra, tôi đã nhận được email trả lời xác nhận ngày mai là ngày mới.",
      "author": "ChatGPT4.1"
    },
    "66400": {
      "id": 2599346,
      "text": "Được rồi, tôi xin lỗi vì sự bất tiện này.",
      "author": "ChatGPT4.1"
    },
    "66401": {
      "id": 2599347,
      "text": "Tôi sẽ kiểm tra với giám sát viên của mình và có lẽ sẽ gặp lại bạn vào ngày mai.",
      "author": "ChatGPT4.1"
    },
    "66402": {
      "id": 2599348,
      "text": "Nghe ổn đấy.",
      "author": "ChatGPT4.1"
    },
    "66403": {
      "id": 2599349,
      "text": "Trong lúc bạn đang ở đây,",
      "author": "ChatGPT4.1"
    },
    "66404": {
      "id": 2599350,
      "text": "bạn có thể cho tôi biết chi phí thêm là bao nhiêu nếu bạn chuyển đàn piano cho chúng tôi không?",
      "author": "ChatGPT4.1"
    },
    "66405": {
      "id": 2599351,
      "text": "Chúng tôi không bán được cây đàn, nên sẽ đưa nó về nhà mới.",
      "author": "ChatGPT4.1"
    },
    "66406": {
      "id": 2599352,
      "text": "Thực ra có khá nhiều yếu tố ảnh hưởng đến giá cả.",
      "author": "ChatGPT4.1"
    },
    "66407": {
      "id": 2599353,
      "text": "Lựa chọn tốt nhất là bạn nên gọi cho văn phòng để nhận báo giá.",
      "author": "ChatGPT4.1"
    },
    "66408": {
      "id": 2599354,
      "text": "Tôi không tham gia vào phần công việc đó.",
      "author": "ChatGPT4.1"
    }
  }
