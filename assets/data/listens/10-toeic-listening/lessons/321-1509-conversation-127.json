    },
    "65664": {
      "id": 2650509,
      "text": "Được chứ.",
      "author": "ChatGPT4.1"
    },
    "65665": {
      "id": 2650510,
      "text": "Chúng tôi chi trả cho các vật tư văn phòng cơ bản, như bút và bút chì,",
      "author": "ChatGPT4.1"
    },
    "65666": {
