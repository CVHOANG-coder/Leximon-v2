    },
    "65667": {
      "id": 2650512,
      "text": "Chỉ cần nhớ, mọi khoản mua sắm trên 200 đô la cần sự phê duyệt của quản lý trước khi mua.",
      "author": "ChatGPT4.1"
    },
    "65668": {
      "id": 2650513,
      "text": "Chúng ta vẫn chỉ làm hoàn trả một quý một lần phải không?",
