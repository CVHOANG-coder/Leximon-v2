  "translations": {
    "65651": {
      "id": 2650496,
      "text": "Xin nhắc nhanh về việc được hoàn trả chi phí vật tư văn phòng mà bạn mua bằng tiền của mình.",
      "author": "ChatGPT4.1"
    },
    "65652": {
      "id": 2650497,
      "text": "Đầu tiên, đăng nhập vào mạng nội bộ của công ty,",
      "author": "ChatGPT4.1"
    },
    "65653": {
      "id": 2650498,
      "text": "sau đó vào mục \"Khai báo Chi phí\" ở góc ngoài cùng bên phải của menu.",
      "author": "ChatGPT4.1"
    },
    "65654": {
      "id": 2650499,
      "text": "Nhấp vào, điền thông tin và in ra.",
