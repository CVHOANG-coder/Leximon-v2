    },
    "65661": {
      "id": 2650506,
      "text": "một bản cho quản lý của bạn và giữ bản cuối để lưu trữ cá nhân.",
      "author": "ChatGPT4.1"
    },
    "65662": {
      "id": 2650507,
      "text": "Đã rõ.",
      "author": "ChatGPT4.1"
    },
    "65663": {
      "id": 2650508,
      "text": "Bạn có thể nhắc lại những loại vật tư nào được hoàn trả không?",
