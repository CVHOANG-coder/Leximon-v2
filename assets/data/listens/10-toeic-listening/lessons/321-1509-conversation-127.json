    },
    "65656": {
      "id": 2650501,
      "text": "Chúng ta còn có thể nộp báo cáo chung cho các chuyến công tác cùng đồng nghiệp không,",
      "author": "ChatGPT4.1"
    },
    "65657": {
      "id": 2650502,
      "text": "hay mọi người cần tự nộp báo cáo riêng?",
      "author": "ChatGPT4.1"
    },
    "65658": {
      "id": 2650503,
      "text": "Nếu là cho cùng một khoản chi, một báo cáo là được.",
      "author": "ChatGPT4.1"
    },
    "65659": {
      "id": 2650504,
      "text": "Sau khi in, dập hóa đơn vào mẫu và photo hai bản.",
      "author": "ChatGPT4.1"
    },
    "65660": {
      "id": 2650505,
      "text": "Nộp bản gốc cho phòng kế toán,",
