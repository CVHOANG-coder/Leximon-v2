  "translations": {
    "71166": {
      "id": 2583987,
      "text": "Chào ông Robson, tôi hy vọng có thể nghỉ làm vào thứ Tư.",
      "author": "ChatGPT4.1"
    },
    "71167": {
      "id": 2583988,
      "text": "Tôi có một cuộc hẹn tái khám với bác sĩ, và chúng tôi dự định sẽ xem lại một số kết quả xét nghiệm.",
      "author": "ChatGPT4.1"
    },
    "71168": {
      "id": 2583989,
      "text": "Tôi hiểu điều đó, nhưng thứ Tư thì hơi khó.",
      "author": "ChatGPT4.1"
    },
    "71169": {
      "id": 2583990,
      "text": "Chúng ta có sự kiện xây dựng đội nhóm tại văn phòng trung tâm,",
      "author": "ChatGPT4.1"
    },
    "71170": {
      "id": 2583991,
      "text": "và chúng ta thực sự cần tất cả mọi người có mặt.",
      "author": "ChatGPT4.1"
    },
    "71171": {
      "id": 2583992,
      "text": "Bạn có thể kiểm tra xem mình có thể dời cuộc hẹn sang thứ Năm hoặc có thể là thứ Ba tuần sau không?",
      "author": "ChatGPT4.1"
    },
    "71172": {
      "id": 2583993,
      "text": "Ồ đúng rồi! Tôi hoàn toàn quên mất sự kiện đó.",
      "author": "ChatGPT4.1"
    },
    "71173": {
      "id": 2583994,
      "text": "Cảm ơn bạn đã nhắc nhở.",
      "author": "ChatGPT4.1"
    },
    "71174": {
      "id": 2583995,
      "text": "Tôi sẽ gọi cho phòng khám để xem có thể chuyển sang thứ Năm không.",
      "author": "ChatGPT4.1"
    },
    "71175": {
      "id": 2583996,
      "text": "Họ thường khá linh hoạt trong việc dời lịch,",
      "author": "ChatGPT4.1"
    },
    "71176": {
      "id": 2583997,
      "text": "nên tôi chắc chắn chúng ta có thể sắp xếp được.",
      "author": "ChatGPT4.1"
    }
  }
