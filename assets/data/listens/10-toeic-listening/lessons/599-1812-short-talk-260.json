  "translations": {
    "70330": {
      "id": 2643762,
      "text": "Chào buổi tối và cảm ơn quý vị đã lắng nghe bản tin thời sự buổi tối của Đài Phát thanh KWXL.",
      "author": "ChatGPT4.1"
    },
    "70331": {
      "id": 2643763,
      "text": "Trong tin tức cộng đồng, lễ hội mùa thu được mong đợi sẽ diễn ra tại Công viên Thành phố vào Chủ nhật này,",
      "author": "ChatGPT4.1"
    },
    "70332": {
      "id": 2643764,
      "text": "bắt đầu lúc 11 giờ sáng.",
      "author": "ChatGPT4.1"
    },
    "70333": {
      "id": 2643765,
      "text": "Tuy nhiên, chúng tôi muốn thông báo đến quý vị một cập nhật quan trọng.",
      "author": "ChatGPT4.1"
    },
    "70334": {
      "id": 2643766,
      "text": "Ban đầu, lễ hội dự kiến sẽ có các hoạt động diễn ra ở nhiều khu vực trong công viên,",
      "author": "ChatGPT4.1"
    },
    "70335": {
      "id": 2643767,
      "text": "nhưng do điều kiện thời tiết, các hoạt động sẽ được tập trung tại bãi cỏ trung tâm.",
      "author": "ChatGPT4.1"
    },
    "70336": {
      "id": 2643768,
      "text": "Đối với những ai quan tâm đến tình hình thời tiết cho lễ hội cuối tuần này,",
      "author": "ChatGPT4.1"
    },
    "70337": {
      "id": 2643769,
      "text": "xin hãy tiếp tục theo dõi chương trình sau phần thông báo ngắn để nhận dự báo chi tiết.",
      "author": "ChatGPT4.1"
    }
  }
