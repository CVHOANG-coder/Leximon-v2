    },
    "68709": {
      "id": 2660119,
      "text": "Trong buổi này, chúng ta sẽ khám phá các kỹ thuật thực tiễn mà bạn có thể sử dụng để giảm căng thẳng, cải thiện sự tập trung,",
      "author": "ChatGPT4.1"
    },
    "68710": {
      "id": 2660120,
      "text": "và duy trì sự cân bằng lành mạnh giữa công việc và cuộc sống.",
      "author": "ChatGPT4.1"
    },
    "68711": {
      "id": 2660121,
      "text": "Hãy đảm bảo rằng bạn có sẵn bút và sổ tay,",
      "author": "ChatGPT4.1"
