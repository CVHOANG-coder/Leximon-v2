  "translations": {
    "66808": {
      "id": 2651239,
      "text": "Cảm ơn bạn đã gọi đến Westpac Airlines.",
      "author": "ChatGPT4.1"
    },
    "66809": {
      "id": 2651240,
      "text": "Do ảnh hưởng của thời tiết bất ngờ, chúng tôi đang nhận được số cuộc gọi nhiều hơn bình thường.",
      "author": "ChatGPT4.1"
    },
    "66810": {
      "id": 2651241,
      "text": "Cuộc gọi của bạn rất quan trọng đối với chúng tôi và sẽ được trả lời theo thứ tự nhận được.",
      "author": "ChatGPT4.1"
    },
    "66811": {
      "id": 2651242,
      "text": "Để hỗ trợ bạn tốt nhất, xin vui lòng chọn tùy chọn phù hợp nhất.",
      "author": "ChatGPT4.1"
    },
    "66812": {
      "id": 2651243,
      "text": "Để đặt lại vé máy bay của bạn, bấm phím số một.",
      "author": "ChatGPT4.1"
    },
    "66813": {
      "id": 2651244,
      "text": "Để đặt vé mới, bấm phím số hai.",
      "author": "ChatGPT4.1"
    },
    "66814": {
      "id": 2651245,
      "text": "Đối với các thắc mắc khác, hoặc để nói chuyện với nhân viên, bấm phím số không.",
      "author": "ChatGPT4.1"
    },
    "66815": {
      "id": 2651246,
      "text": "Bạn cũng có thể thực hiện nhiều thao tác này trực tuyến",
      "author": "ChatGPT4.1"
    },
    "66816": {
      "id": 2651247,
      "text": "tại westpacairlines.com.",
      "author": "ChatGPT4.1"
    }
  }
