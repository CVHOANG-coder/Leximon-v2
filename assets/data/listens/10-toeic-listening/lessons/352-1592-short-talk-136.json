  "translations": {
    "66868": {
      "id": 2604062,
      "text": "Santorini and Sons là công ty cung cấp thực phẩm tốt nhất ở toàn thành phố New York!",
      "author": "ChatGPT4.1"
    },
    "66869": {
      "id": 2604063,
      "text": "Chúng tôi vừa thêm buffet thịt nướng Hy Lạp và quầy sốt tzatziki vào thực đơn của mình.",
      "author": "ChatGPT4.1"
    },
    "66870": {
      "id": 2604064,
      "text": "Chúng tôi có mức giá tốt nhất và phải chăng nhất trong khu vực,",
      "author": "ChatGPT4.1"
    },
    "66871": {
      "id": 2604065,
      "text": "và rất nhiều lựa chọn đa dạng cho sự kiện tiếp theo của bạn!",
      "author": "ChatGPT4.1"
    },
    "66872": {
      "id": 2604066,
      "text": "Danh tiếng của chúng tôi là vô đối.",
      "author": "ChatGPT4.1"
    },
    "66873": {
      "id": 2604067,
      "text": "Chưa bị thuyết phục? Vậy thế này thì sao?",
      "author": "ChatGPT4.1"
    },
    "66874": {
      "id": 2604068,
      "text": "Nếu bạn không hài lòng với đồ ăn hoặc dịch vụ của chúng tôi tại sự kiện của mình,",
      "author": "ChatGPT4.1"
    },
    "66875": {
      "id": 2604069,
      "text": "chúng tôi sẽ hoàn lại toàn bộ tiền cho bạn!",
      "author": "ChatGPT4.1"
    },
    "66876": {
      "id": 2604070,
      "text": "Hãy truy cập trang web của chúng tôi tại santoriniandsons.com để xem thực đơn cố định,",
      "author": "ChatGPT4.1"
    },
    "66877": {
      "id": 2604071,
      "text": "hoặc nếu bạn muốn tùy chỉnh thực đơn phù hợp với nhu cầu sự kiện của mình,",
      "author": "ChatGPT4.1"
    },
    "66878": {
      "id": 2604072,
      "text": "chỉ cần nhấp vào nút \"Thực đơn tự chọn của tôi\".",
      "author": "ChatGPT4.1"
    }
  }
}
