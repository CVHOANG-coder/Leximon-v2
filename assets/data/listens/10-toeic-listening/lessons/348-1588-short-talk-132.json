  "translations": {
    "66828": {
      "id": 2597096,
      "text": "Chào buổi tối mọi người, đây là Elizabeth Bows, từ thành phố Plain với tin nóng vừa cập nhật.",
      "author": "ChatGPT4.1"
    },
    "66829": {
      "id": 2597097,
      "text": "Một thông báo đã được đưa ra vào chiều nay rằng công viên trượt ván sẽ tiếp tục đóng cửa cho đến hết mùa hè.",
      "author": "ChatGPT4.1"
    },
    "66830": {
      "id": 2597098,
      "text": "Thị trưởng Rathburg cho biết với công chúng rằng một số dốc trượt đã bị lỏng và gỗ thì bắt đầu bị tách ra.",
      "author": "ChatGPT4.1"
    },
    "66831": {
      "id": 2597099,
      "text": "Nhờ các khoản quyên góp và thuế địa phương, công viên trượt ván dự kiến sẽ được cải tạo hoàn toàn,",
      "author": "ChatGPT4.1"
    },
    "66832": {
      "id": 2597100,
      "text": "với hai dốc trượt bổ sung sẽ được xây dựng.",
      "author": "ChatGPT4.1"
    },
    "66833": {
      "id": 2597101,
      "text": "Các trường học địa phương được khuyến khích sử dụng công viên này như một điểm đến cho các chuyến dã ngoại.",
      "author": "ChatGPT4.1"
    },
    "66834": {
      "id": 2597102,
      "text": "Để hỗ trợ cho việc cải tạo, bạn có thể mua vé trực tuyến cho thời điểm công viên mở cửa lại vào tháng Chín tới.",
      "author": "ChatGPT4.1"
    },
    "66835": {
      "id": 2597103,
      "text": "Bạn cũng có thể tham gia để có cơ hội trúng một vé mùa miễn phí,",
      "author": "ChatGPT4.1"
    },
    "66836": {
      "id": 2597104,
      "text": "vì thành phố sẽ phát tặng bốn thẻ thành viên miễn phí.",
      "author": "ChatGPT4.1"
    }
  }
}
