  "translations": {
    "69426": {
      "id": 2590031,
      "text": "Tôi là Clara Simmons, đang tường thuật trực tiếp cho WLFS Action News.",
      "author": "ChatGPT4.1"
    },
    "69427": {
      "id": 2590032,
      "text": "Tôi đang có mặt tại công viên Lakeside,",
      "author": "ChatGPT4.1"
    },
    "69428": {
      "id": 2590033,
      "text": "thưởng thức thời tiết nắng đẹp vào ngày thứ ba của Hội chợ Nghệ thuật và Thủ công Mỹ nghệ thường niên.",
      "author": "ChatGPT4.1"
    },
    "69429": {
      "id": 2590034,
      "text": "Hôm nay có điều thú vị dành cho tất cả mọi người.",
      "author": "ChatGPT4.1"
    },
    "69430": {
      "id": 2590035,
      "text": "Các em nhỏ sẽ được vui chơi với những hoạt động sáng tạo,",
      "author": "ChatGPT4.1"
    },
    "69431": {
      "id": 2590036,
      "text": "trong khi người lớn có thể tham quan đủ loại sản phẩm thủ công của các nghệ sĩ địa phương.",
      "author": "ChatGPT4.1"
    },
    "69432": {
      "id": 2590037,
      "text": "Ngoài ra, còn có rất nhiều món ăn ngon từ các xe bán hàng lưu động đa dạng.",
      "author": "ChatGPT4.1"
    },
    "69433": {
      "id": 2590038,
      "text": "Nhớ đón xem chương trình trực tiếp đặc biệt của The Harmony Quartet lúc 7 giờ tối nhé.",
      "author": "ChatGPT4.1"
    },
    "69434": {
      "id": 2590039,
      "text": "Sau một khoảng nghỉ ngắn, tôi sẽ phỏng vấn một số nghệ sĩ tại đây, nên hãy tiếp tục theo dõi chúng tôi!",
      "author": "ChatGPT4.1"
    }
  }
}
