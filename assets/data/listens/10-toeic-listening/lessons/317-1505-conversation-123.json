    },
    "65580": {
      "id": 2650916,
      "text": "Tôi nghĩ đúng là như vậy.",
      "author": "ChatGPT4.1"
    },
    "65581": {
      "id": 2650917,
      "text": "Kể từ khi có những cắt giảm nhân sự gần đây, khối lượng công việc của tôi gần như tăng gấp ba.",
      "author": "ChatGPT4.1"
    },
    "65582": {
      "id": 2650918,
      "text": "Tôi xin lỗi, tôi biết điều đó chắc hẳn rất khó khăn.",
      "author": "ChatGPT4.1"
    },
