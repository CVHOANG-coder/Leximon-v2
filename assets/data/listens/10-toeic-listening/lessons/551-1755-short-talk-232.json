  "translations": {
    "69627": {
      "id": 2585960,
      "text": "Chào mừng tất cả các bạn đến với buổi định hướng cho khóa học cấp chứng chỉ Thiết kế Đồ họa của viện chúng ta.",
      "author": "ChatGPT4.1"
    },
    "69628": {
      "id": 2585961,
      "text": "Tôi là Alex Martin, giảng viên của các bạn trong vài tuần tới.",
      "author": "ChatGPT4.1"
    },
    "69629": {
      "id": 2585962,
      "text": "Trước khi bắt đầu, tôi có một số thông tin muốn chia sẻ.",
      "author": "ChatGPT4.1"
    },
    "69630": {
      "id": 2585963,
      "text": "Sau khi các bạn hoàn thành khóa học,",
      "author": "ChatGPT4.1"
    },
    "69631": {
      "id": 2585964,
      "text": "mỗi bạn sẽ có cơ hội gặp riêng tư một chuyên viên tư vấn nghề nghiệp mà không mất thêm chi phí nào.",
      "author": "ChatGPT4.1"
    },
    "69632": {
      "id": 2585965,
      "text": "Đây là một lợi ích tuyệt vời dành cho tất cả các bạn,",
      "author": "ChatGPT4.1"
    },
    "69633": {
      "id": 2585966,
      "text": "vì vậy tôi khuyến khích các bạn hãy tận dụng nó.",
      "author": "ChatGPT4.1"
    },
    "69634": {
      "id": 2585967,
      "text": "Bây giờ, chúng ta hãy bắt đầu buổi học đầu tiên.",
      "author": "ChatGPT4.1"
    },
    "69635": {
      "id": 2585968,
      "text": "Vui lòng đăng nhập vào hệ thống đào tạo của chúng ta bằng tên đăng nhập và mật khẩu được ghi trên thẻ tên của các bạn.",
      "author": "ChatGPT4.1"
    }
  }
