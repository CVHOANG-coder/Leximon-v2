  "translations": {
    "53768": {
      "id": 896266,
      "text": "Tôi tưởng chúng ta có thể thực hiện tất cả các xét nghiệm ngay tại đây.",
      "author": "a user"
    },
    "53773": {
      "id": 896274,
      "text": "giống như những cái trong trường hợp của bạn.",
      "author": "a user"
    },
    "53775": {
      "id": 896276,
      "text": "Tôi chắc chắn bạn sẽ được chăm sóc tốt thôi.",
      "author": "a user"
    },
    "53763": {
      "id": 2590854,
      "text": "Được rồi, bà Grant.",
      "author": "ChatGPT4.1"
    },
    "53764": {
      "id": 2590855,
      "text": "Chúng ta đã xong ở đây rồi.",
      "author": "ChatGPT4.1"
    },
    "53765": {
      "id": 2590856,
      "text": "Các xét nghiệm còn lại nên được thực hiện ở một cơ sở lớn hơn,",
      "author": "ChatGPT4.1"
    },
    "53766": {
      "id": 2590857,
      "text": "như là bệnh viện đa khoa trên đường Cambie.",
      "author": "ChatGPT4.1"
    },
    "53767": {
      "id": 2590858,
      "text": "Ôi không.",
      "author": "ChatGPT4.1"
    },
    "53769": {
      "id": 2590859,
      "text": "Tôi đã có nhiều trải nghiệm không tốt tại bệnh viện đa khoa.",
      "author": "ChatGPT4.1"
    },
    "53770": {
      "id": 2590860,
      "text": "Thật lòng mà nói, tôi thích bệnh viện tưởng niệm hơn.",
      "author": "ChatGPT4.1"
    },
    "53771": {
      "id": 2590861,
      "text": "Tôi muốn giúp,",
      "author": "ChatGPT4.1"
    },
    "53772": {
      "id": 2590862,
      "text": "nhưng cần phải có trang thiết bị chẩn đoán hiện đại nhất để thực hiện một số xét nghiệm nhất định,",
      "author": "a user"
    },
    "53774": {
      "id": 2590863,
      "text": "Để tôi giới thiệu bà đến bệnh viện tưởng niệm.",
      "author": "ChatGPT4.1"
    },
    "53776": {
      "id": 2590864,
      "text": "Thế thì tốt quá. Cảm ơn.",
      "author": "ChatGPT4.1"
    }
  }
