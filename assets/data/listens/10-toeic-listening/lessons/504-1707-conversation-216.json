    },
    "69094": {
      "id": 2588111,
      "text": "Tôi đang tổ chức một sự kiện từ thiện và tôi cần in 200 tờ rơi.",
      "author": "ChatGPT4.1"
    },
    "69095": {
      "id": 2588112,
      "text": "Tôi không chắc loại giấy nào sẽ tốt nhất",
      "author": "ChatGPT4.1"
    },
    "69096": {
      "id": 2588113,
      "text": "vì tôi muốn chúng nổi bật nhưng cũng phải hợp túi tiền.",
      "author": "ChatGPT4.1"
    },
    "69097": {
      "id": 2588114,
      "text": "Bạn có gợi ý nào không?",
