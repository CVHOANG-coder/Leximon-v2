    },
    "69100": {
      "id": 2588117,
      "text": "Nó có giá cả hợp lý và màu sắc lên rất rực rỡ,",
      "author": "ChatGPT4.1"
    },
    "69101": {
      "id": 2588118,
      "text": "giúp cho tờ rơi của bạn trở nên bắt mắt.",
      "author": "ChatGPT4.1"
    },
    "69102": {
      "id": 2588119,
      "text": "Nghe có vẻ là một lựa chọn tuyệt vời.",
      "author": "ChatGPT4.1"
    },
    "69103": {
      "id": 2588120,
      "text": "Bạn có thể cho tôi biết tổng chi phí sẽ là bao nhiêu không?",
      "author": "ChatGPT4.1"
    },
    "69104": {
      "id": 2588121,
      "text": "Tất nhiên!",
      "author": "ChatGPT4.1"
    },
    "69105": {
      "id": 2588122,
      "text": "Mỗi tờ giấy cán mờ giá 25 xu,",
      "author": "ChatGPT4.1"
    },
    "69106": {
      "id": 2588123,
      "text": "và chúng tôi có thể in hai tờ rơi trên mỗi tờ giấy.",
      "author": "ChatGPT4.1"
    },
    "69107": {
