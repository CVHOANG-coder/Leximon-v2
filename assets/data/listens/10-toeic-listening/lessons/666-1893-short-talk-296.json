  "translations": {
    "71577": {
      "id": 2584007,
      "text": "Chào buổi sáng quý vị và các bạn, nhiệt liệt chào mừng đến với lễ khai mạc Diễn đàn Đổi mới Sáng tạo của Viện Hawthorne.",
      "author": "ChatGPT4.1"
    },
    "71578": {
      "id": 2584008,
      "text": "Hôm nay, chúng tôi vinh dự được đón tiếp các chuyên gia xuất sắc",
      "author": "ChatGPT4.1"
    },
    "71579": {
      "id": 2584009,
      "text": "đến từ các lĩnh vực công nghệ, khoa học môi trường và kỹ thuật",
      "author": "ChatGPT4.1"
    },
    "71580": {
      "id": 2584010,
      "text": "những người sẽ chia sẻ những hiểu biết từ các dự án và phát triển mới nhất của họ.",
      "author": "ChatGPT4.1"
    },
    "71581": {
      "id": 2584011,
      "text": "Tôi tin chắc rằng mỗi phiên thảo luận chiều nay sẽ vừa hữu ích vừa truyền cảm hứng.",
      "author": "ChatGPT4.1"
    },
    "71582": {
      "id": 2584012,
      "text": "Xin vui lòng nhận lịch trình ngày hôm nay tại bàn đón tiếp ngay lối vào.",
      "author": "ChatGPT4.1"
    },
    "71583": {
      "id": 2584013,
      "text": "Ngoài ra, chúng tôi kính đề nghị quý vị giữ câu hỏi của mình đến cuối mỗi bài thuyết trình,",
      "author": "ChatGPT4.1"
    },
    "71584": {
      "id": 2584014,
      "text": "bởi mỗi chuyên gia sẽ tham gia phần hỏi & đáp sau đó.",
      "author": "ChatGPT4.1"
    },
    "71585": {
      "id": 2584015,
      "text": "Cảm ơn quý vị đã chú ý lắng nghe, chúc quý vị có một trải nghiệm bổ ích tại diễn đàn.",
      "author": "ChatGPT4.1"
    }
  }
}
