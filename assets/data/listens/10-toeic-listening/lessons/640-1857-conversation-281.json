  "translations": {
    "71111": {
      "id": 2588331,
      "text": "Bạn có biết ai là người chịu trách nhiệm thiết kế poster mới cho sự kiện ra mắt sản phẩm không?",
      "author": "ChatGPT4.1"
    },
    "71112": {
      "id": 2588332,
      "text": "Giám đốc muốn cập nhật một số hình ảnh và nhờ tôi chuyển yêu cầu của ông ấy đến đúng người.",
      "author": "ChatGPT4.1"
    },
    "71113": {
      "id": 2588333,
      "text": "Tôi không chắc lắm, nhưng bạn có thể hỏi Craig Cooper.",
      "author": "ChatGPT4.1"
    },
    "71114": {
      "id": 2588334,
      "text": "Anh ấy đang điều phối toàn bộ sự kiện, nên chắc sẽ biết ai phụ trách phần thiết kế.",
      "author": "ChatGPT4.1"
    },
    "71115": {
      "id": 2588335,
      "text": "Được rồi, cảm ơn vì gợi ý nhé.",
      "author": "ChatGPT4.1"
    },
    "71116": {
      "id": 2588336,
      "text": "Tôi nghĩ anh ấy có cuộc họp vào sáng nay,",
      "author": "ChatGPT4.1"
    },
    "71117": {
      "id": 2588337,
      "text": "nhưng tôi sẽ liên lạc với anh ấy ngay khi anh ấy rảnh.",
      "author": "ChatGPT4.1"
    },
    "71118": {
      "id": 2588338,
      "text": "Cảm ơn bạn đã giúp đỡ!",
      "author": "ChatGPT4.1"
    }
  }
