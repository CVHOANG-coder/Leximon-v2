  "translations": {
    "66837": {
      "id": 2597043,
      "text": "Chào buổi tối,",
      "author": "ChatGPT4.1"
    },
    "66838": {
      "id": 2597044,
      "text": "chào mừng đến với chương trình hàng tháng của Planet News, Khám Phá Doanh Nhân.",
      "author": "ChatGPT4.1"
    },
    "66839": {
      "id": 2597045,
      "text": "Chúng tôi có một vị khách mời rất đặc biệt với chúng ta tối nay,",
      "author": "ChatGPT4.1"
    },
    "66840": {
      "id": 2597046,
      "text": "đó là nữ chủ nhà hàng nổi tiếng thế giới, Georgia Southbank.",
      "author": "ChatGPT4.1"
    },
    "66841": {
      "id": 2597047,
      "text": "Bà Southbank đã thành công mở hơn năm mươi nhà hàng trên khắp thế giới,",
      "author": "ChatGPT4.1"
    },
    "66842": {
      "id": 2597048,
      "text": "trong đó có 30 nhà hàng được trao sao Michelin.",
      "author": "ChatGPT4.1"
    },
    "66843": {
      "id": 2597049,
      "text": "Bà mới đây được Hiệp hội Nhà hàng Thế giới vinh danh là đầu bếp thành công nhất thế hệ chúng ta.",
      "author": "ChatGPT4.1"
    },
    "66844": {
      "id": 2597050,
      "text": "Bà Southbank sẽ chia sẻ câu chuyện của mình với chúng ta,",
      "author": "ChatGPT4.1"
    },
    "66845": {
      "id": 2597051,
      "text": "từ thời thơ ấu ở miền nam nước Pháp, đến khi mở nhà hàng đầu tiên ở London.",
      "author": "ChatGPT4.1"
    },
    "66846": {
      "id": 2597052,
      "text": "Bà cũng sẽ trả lời mọi thắc mắc từ quý thính giả,",
      "author": "ChatGPT4.1"
    },
    "66847": {
      "id": 2597053,
      "text": "vì vậy hãy gọi vào số 899-9012 nếu bạn có câu hỏi.",
      "author": "ChatGPT4.1"
    },
    "66848": {
      "id": 2597054,
      "text": "Chúng tôi sẽ quay lại với bà Southbank sau những thông điệp từ nhà tài trợ của chương trình.",
