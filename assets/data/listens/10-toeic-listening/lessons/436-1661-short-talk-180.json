  "translations": {
    "68570": {
      "id": 3033477,
      "text": "Chào buổi chiều, tất cả mọi người!",
      "author": "ChatGPT4.1"
    },
    "68571": {
      "id": 3033478,
      "text": "Thật vinh dự được chào đón tất cả các bạn đến với buổi khai trương chính thức của Trung tâm Văn hóa Riverside.",
      "author": "ChatGPT4.1"
    },
    "68572": {
      "id": 3033479,
      "text": "Với tư cách là thị trưởng, tôi rất vui mừng được chứng kiến sự phát triển đáng chú ý này trong cộng đồng của chúng ta.",
      "author": "ChatGPT4.1"
    },
    "68573": {
      "id": 3033480,
      "text": "Trung tâm này thể hiện cam kết về phát triển bền vững với nhiều tính năng đổi mới.",
      "author": "ChatGPT4.1"
    },
    "68574": {
      "id": 3033481,
      "text": "Ví dụ, trung tâm có các tấm pin năng lượng mặt trời trên mái và cửa sổ tiết kiệm năng lượng giúp tận dụng tối đa ánh sáng tự nhiên.",
      "author": "ChatGPT4.1"
    },
    "68575": {
      "id": 3033482,
      "text": "Dù hôm nay chúng ta tụ họp để ăn mừng,",
      "author": "ChatGPT4.1"
    },
    "68576": {
      "id": 3033483,
      "text": "Tôi xin thông báo rằng phòng trưng bày nghệ thuật ở tầng hai sẽ đóng cửa cho đến tháng sau",
      "author": "ChatGPT4.1"
    },
    "68577": {
      "id": 3033484,
      "text": "trong khi chúng tôi hoàn thiện các công đoạn cuối cùng.",
      "author": "ChatGPT4.1"
    },
    "68578": {
      "id": 3033485,
      "text": "Cảm ơn sự ủng hộ của các bạn,",
      "author": "ChatGPT4.1"
    },
    "68579": {
      "id": 3033486,
      "text": "và hãy cùng chờ đón những hoạt động tuyệt vời đang đón chờ chúng ta!",
      "author": "ChatGPT4.1"
    }
  }
}
