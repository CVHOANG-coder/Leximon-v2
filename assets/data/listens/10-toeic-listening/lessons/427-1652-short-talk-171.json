  "translations": {
    "68491": {
      "id": 2648177,
      "text": "Xin chào!",
      "author": "ChatGPT4.1"
    },
    "68492": {
      "id": 2648178,
      "text": "Bạn đã liên hệ với Atlantic Energy Services,",
      "author": "ChatGPT4.1"
    },
    "68493": {
      "id": 2648179,
      "text": "nhà cung cấp điện và gas đáng tin cậy của bạn tại khu vực Mid-Atlantic.",
      "author": "ChatGPT4.1"
    },
    "68494": {
      "id": 2648180,
      "text": "Vui lòng chờ để gặp nhân viên tiếp theo.",
      "author": "ChatGPT4.1"
    },
    "68495": {
      "id": 2648181,
      "text": "Nếu bạn đang thắc mắc về sự cố mất điện hiện tại ở Maplewood,",
      "author": "ChatGPT4.1"
    },
    "68496": {
      "id": 2648182,
      "text": "chúng tôi muốn đảm bảo với bạn rằng các đội ngũ của chúng tôi đang tích cực làm việc tại khu vực này",
      "author": "ChatGPT4.1"
    },
    "68497": {
      "id": 2648183,
      "text": "và dự kiến mọi thứ sẽ trở lại bình thường trước 3 giờ chiều hôm nay.",
      "author": "ChatGPT4.1"
    },
    "68498": {
      "id": 2648184,
      "text": "Nếu bạn mới chuyển đến và cần khởi tạo hoặc kết thúc một dịch vụ,",
      "author": "ChatGPT4.1"
    },
    "68499": {
      "id": 2648185,
      "text": "xin vui lòng truy cập trang web của chúng tôi để gửi yêu cầu.",
      "author": "ChatGPT4.1"
    },
    "68500": {
      "id": 2648186,
      "text": "Cảm ơn bạn đã kiên nhẫn!",
      "author": "ChatGPT4.1"
    }
