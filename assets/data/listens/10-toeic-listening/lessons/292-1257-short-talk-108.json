  "translations": {
    "55576": {
      "id": 2613278,
      "text": "Chào mừng bạn đến với lễ hội Nghệ thuật trong Công viên đầu tiên, hy vọng sẽ còn nhiều lần nữa.",
      "author": "ChatGPT4.1"
    },
    "55577": {
      "id": 2613279,
      "text": "Chúng tôi dự định biến đây thành một sự kiện diễn ra hàng tháng,",
      "author": "ChatGPT4.1"
    },
    "55578": {
      "id": 2613280,
      "text": "bao gồm các sự kiện được tổ chức vào thứ Bảy và Chủ Nhật, vào cuối tuần đầu tiên của mỗi tháng.",
      "author": "ChatGPT4.1"
    },
    "55579": {
      "id": 2613281,
      "text": "Chúng tôi có một loạt chương trình hấp dẫn cho cuối tuần đầu tiên này,",
      "author": "ChatGPT4.1"
    },
    "55580": {
      "id": 2613282,
      "text": "với các hoạt động tương tác để cả gia đình cùng tham gia và tận hưởng.",
      "author": "ChatGPT4.1"
    },
    "55581": {
      "id": 2613283,
      "text": "Xin hãy tận hưởng khoảng thời gian này cùng gia đình và cộng đồng của mình.",
      "author": "ChatGPT4.1"
    },
    "55582": {
      "id": 2613284,
      "text": "Một điều cuối cùng.",
      "author": "ChatGPT4.1"
    },
    "55583": {
      "id": 2613285,
      "text": "Chỉ riêng cuối tuần này, tất cả các sự kiện dự kiến diễn ra tại Công viên Phía Bắc vào thứ Bảy sẽ được chuyển sang địa điểm khác,",
      "author": "ChatGPT4.1"
    },
    "55584": {
      "id": 2613286,
      "text": "do công viên hiện đang được cải tạo.",
      "author": "ChatGPT4.1"
    },
    "55585": {
      "id": 2613287,
      "text": "Được rồi, chúng ta hãy bắt đầu thôi!",
      "author": "ChatGPT4.1"
    }
  }
}
