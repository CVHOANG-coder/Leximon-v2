  "translations": {
    "66424": {
      "id": 2677561,
      "text": "Chào mừng bạn đến với cửa hàng Chapman.",
      "author": "ChatGPT4.1"
    },
    "66425": {
      "id": 2677562,
      "text": "Hôm nay tôi có thể giúp gì cho bạn không?",
      "author": "ChatGPT4.1"
    },
    "66426": {
      "id": 2677563,
      "text": "Chào bạn, tôi đang tìm cọ vẽ cho cháu trai của mình.",
      "author": "ChatGPT4.1"
    },
    "66427": {
      "id": 2677564,
      "text": "Bạn có ý là loại có cán lớn dành cho trẻ em không?",
      "author": "ChatGPT4.1"
    },
    "66428": {
      "id": 2677565,
      "text": "Ừm... Tôi không chắc là chúng tôi còn loại đó trong kho hay không.",
      "author": "ChatGPT4.1"
    },
    "66429": {
      "id": 2677566,
      "text": "Thực ra thì không phải.",
      "author": "ChatGPT4.1"
    },
    "66430": {
      "id": 2677567,
      "text": "Đó là bộ cọ vẽ dành cho người mới bắt đầu.",
      "author": "ChatGPT4.1"
    },
    "66431": {
      "id": 2677568,
      "text": "Theo tôi biết thì chúng tôi chỉ có bộ dành cho chuyên nghiệp thôi.",
      "author": "ChatGPT4.1"
    },
    "66432": {
      "id": 2677569,
      "text": "Nhưng để tôi kiểm tra ở phía sau nhé.",
      "author": "ChatGPT4.1"
    },
    "66433": {
      "id": 2677570,
      "text": "Này John, chúng ta còn bộ cọ vẽ cho người mới bắt đầu không?",
      "author": "ChatGPT4.1"
    },
    "66434": {
      "id": 2677571,
      "text": "Có đấy, nhưng không ở tầng này.",
      "author": "ChatGPT4.1"
    },
    "66435": {
      "id": 2677572,
      "text": "Tôi nghĩ chúng ở tầng hầm.",
      "author": "ChatGPT4.1"
    },
    "66436": {
      "id": 2677573,
      "text": "Để tôi dẫn bạn xuống xem nhé.",
      "author": "ChatGPT4.1"
    },
    "66437": {
      "id": 2677574,
      "text": "Tuyệt vời.",
      "author": "ChatGPT4.1"
    },
    "66438": {
      "id": 2677575,
      "text": "Có cách nào tôi có thể gói quà chúng không?",
      "author": "ChatGPT4.1"
    },
    "66439": {
      "id": 2677576,
      "text": "Tôi khá vụng về khoản đó.",
      "author": "ChatGPT4.1"
    },
    "66440": {
      "id": 2677577,
      "text": "Thật ra, dịch vụ gói quà miễn phí với bất kỳ mua hàng nào tại cửa hàng chúng tôi.",
      "author": "ChatGPT4.1"
    },
    "66441": {
