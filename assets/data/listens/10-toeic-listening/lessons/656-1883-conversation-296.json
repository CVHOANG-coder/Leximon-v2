  "translations": {
    "71463": {
      "id": 2583436,
      "text": "Trung tâm Triển lãm Denver. Tôi có thể giúp gì cho bạn hôm nay?",
      "author": "ChatGPT4.1"
    },
    "71464": {
      "id": 2583437,
      "text": "Xin chào. Tôi muốn hỏi về Lễ hội Dụng cụ Leo núi diễn ra vào ngày 10 tháng 6.",
      "author": "ChatGPT4.1"
    },
    "71465": {
      "id": 2583438,
      "text": "Tôi được biết vé cá nhân có giá 25 bảng mỗi vé,",
      "author": "ChatGPT4.1"
    },
    "71466": {
      "id": 2583439,
      "text": "nhưng tôi dự định tham dự cùng nhóm leo núi của mình.",
      "author": "ChatGPT4.1"
    },
    "71467": {
      "id": 2583440,
      "text": "Chúng tôi có được hưởng ưu đãi dành cho nhóm không?",
      "author": "ChatGPT4.1"
    },
    "71468": {
      "id": 2583441,
      "text": "Chắc chắn rồi.",
      "author": "ChatGPT4.1"
    },
    "71469": {
      "id": 2583442,
      "text": "Để mua vé nhóm, bạn cần liên hệ với Dean Spencer, người phụ trách những yêu cầu này.",
      "author": "ChatGPT4.1"
    },
    "71470": {
      "id": 2583443,
      "text": "Bạn có thể gửi email cho anh ấy tại dean@groupevents.com.",
      "author": "ChatGPT4.1"
    },
    "71471": {
      "id": 2583444,
      "text": "Tuyệt vời.",
      "author": "ChatGPT4.1"
    },
    "71472": {
      "id": 2583445,
      "text": "Nhóm của chúng tôi đặc biệt mong chờ buổi trình diễn về thiết bị leo núi.",
      "author": "ChatGPT4.1"
    },
    "71473": {
      "id": 2583446,
      "text": "Chúng tôi có tài liệu quảng cáo từ tổ chức chủ trì buổi đó.",
      "author": "ChatGPT4.1"
    },
    "71474": {
      "id": 2583447,
      "text": "Nếu bạn muốn, tôi có thể gửi cho bạn một bản qua đường bưu điện.",
      "author": "ChatGPT4.1"
    },
    "71475": {
      "id": 2583448,
      "text": "Tôi cảm ơn, nhưng tôi đã có đầy đủ thông tin cần thiết rồi.",
      "author": "ChatGPT4.1"
    }
  }
