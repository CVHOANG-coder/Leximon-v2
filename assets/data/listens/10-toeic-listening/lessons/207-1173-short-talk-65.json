  "translations": {
    "54504": {
      "id": 922547,
      "text": "Xin chào mọi người, tôi đánh giá cao việc bạn đã đến nhanh sau thông báo gấp.",
      "author": "a user"
    },
    "54505": {
      "id": 922548,
      "text": "Như tôi đã đề cập trong email của mình, chúng ta đã và đang làm việc chăm chỉ để giữ cho những người cao tuổi trong khu vực luôn năng động.",
      "author": "a user"
    },
    "54514": {
      "id": 922557,
      "text": "Tôi đã phát một danh sách các nhà cung cấp",
      "author": "a user"
    },
    "54506": {
      "id": 2611510,
      "text": "Nhờ sự giúp đỡ và đóng góp từ cộng đồng,",
      "author": "ChatGPT4.1"
    },
    "54507": {
      "id": 2611511,
      "text": "chúng tôi vui mừng thông báo rằng cuối cùng chúng tôi đã khai trương Trung tâm Cộng đồng Người Cao tuổi vào tuần trước.",
      "author": "ChatGPT4.1"
    },
    "54508": {
      "id": 2611512,
      "text": "Thông qua trung tâm này, chúng tôi có thể cung cấp các lớp thể dục và các sự kiện xã hội cho người cao tuổi, hoàn toàn miễn phí.",
      "author": "ChatGPT4.1"
    },
    "54509": {
      "id": 2611513,
      "text": "Hầu hết các thành viên của chúng tôi đều có một số khuyết tật về thể chất,",
      "author": "ChatGPT4.1"
    },
    "54510": {
      "id": 2611514,
      "text": "vì vậy chúng tôi đang nghiên cứu các chương trình phù hợp cho họ.",
      "author": "ChatGPT4.1"
    },
    "54511": {
      "id": 2611515,
      "text": "Chúng tôi rất tiếc phải thông báo rằng chúng tôi đang cạn kiệt kinh phí để thực hiện các chương trình này.",
      "author": "ChatGPT4.1"
    },
    "54512": {
      "id": 2611516,
      "text": "Hiện tại, chúng tôi cần sự giúp đỡ từ các nghệ sĩ địa phương để tình nguyện tham gia các chương trình mới.",
      "author": "ChatGPT4.1"
    },
    "54513": {
      "id": 2611517,
      "text": "Chúng tôi đang tìm kiếm các huấn luyện viên khiêu vũ, DJ và huấn luyện viên thể chất.",
      "author": "ChatGPT4.1"
    },
    "54515": {
      "id": 2611518,
      "text": "và mong các bạn giúp liên hệ với họ để xin sự hỗ trợ.",
      "author": "ChatGPT4.1"
    }
  }
}
