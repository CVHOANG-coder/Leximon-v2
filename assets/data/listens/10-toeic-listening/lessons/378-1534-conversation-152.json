  "translations": {
    "66043": {
      "id": 2643614,
      "text": "Xin chào, tôi tự hỏi liệu bạn có thể giúp được không.",
      "author": "ChatGPT4.1"
    },
    "66044": {
      "id": 2643615,
      "text": "Tôi có một cuộc hẹn với nhà trị liệu vào lúc 4:20 chiều",
      "author": "ChatGPT4.1"
    },
    "66045": {
      "id": 2643616,
      "text": "Hiện tại tôi đang đỗ xe trong nhà để xe liền kề tòa nhà",
      "author": "ChatGPT4.1"
    },
    "66046": {
      "id": 2643617,
      "text": "và tôi đang tự hỏi liệu tôi có thể trả tiền mặt khi kết thúc cuộc hẹn không?",
      "author": "ChatGPT4.1"
    },
    "66047": {
      "id": 2643618,
      "text": "Vâng, máy có thể nhận tiền mặt hoặc thẻ,",
      "author": "ChatGPT4.1"
    },
    "66048": {
      "id": 2643619,
      "text": "nhưng may mắn là nếu bạn sử dụng dịch vụ trong tòa nhà của chúng tôi, thì sẽ được đỗ xe miễn phí.",
      "author": "ChatGPT4.1"
    },
    "66049": {
      "id": 2643620,
      "text": "Tôi chỉ cần xác nhận vé của bạn.",
      "author": "ChatGPT4.1"
    },
    "66050": {
      "id": 2643621,
      "text": "Bạn có nó trong tay không?",
      "author": "ChatGPT4.1"
    },
    "66051": {
      "id": 2643622,
      "text": "Ồ, tuyệt quá!",
      "author": "ChatGPT4.1"
    },
    "66052": {
      "id": 2643623,
      "text": "Đây, cảm ơn bạn!",
      "author": "ChatGPT4.1"
    },
    "66053": {
      "id": 2643624,
      "text": "Tôi chưa từng đến đây trước đây.",
      "author": "ChatGPT4.1"
    },
    "66054": {
      "id": 2643625,
      "text": "Bạn có biết văn phòng của bác sĩ Foster ở đâu không?",
      "author": "ChatGPT4.1"
    },
    "66055": {
      "id": 2643626,
      "text": "Vâng, để tôi xem nhé.",
      "author": "ChatGPT4.1"
    },
    "66056": {
      "id": 2643627,
      "text": "Cô ấy khá mới và cô ấy... ở tầng bốn!",
      "author": "ChatGPT4.1"
    },
    "66057": {
      "id": 2643628,
      "text": "Văn phòng 406.",
      "author": "ChatGPT4.1"
    }
  }
