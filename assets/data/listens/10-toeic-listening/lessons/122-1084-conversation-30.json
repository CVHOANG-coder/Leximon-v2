    "53156": {
      "id": 876579,
      "text": "Tôi muốn biết các khoản thanh toán gốc và lãi có thể dự đoán được.",
      "author": "a user"
    },
    "53157": {
      "id": 876584,
      "text": "Chắc chắn rồi.",
      "author": "a user"
    },
    "53160": {
      "id": 876592,
      "text": "với khoản trả trước từ 20% trở lên sẽ giúp bạn nhận được mức lãi suất thấp hơn.",
      "author": "a user"
    },
    "53152": {
      "id": 2630858,
      "text": "Cảm ơn vì đã dẫn tôi tham quan, Janice.",
      "author": "ChatGPT4.1"
    },
    "53153": {
      "id": 2630859,
      "text": "Nhà phố này có vị trí thuận tiện và khu vực xung quanh khá an toàn.",
      "author": "ChatGPT4.1"
    },
    "53154": {
      "id": 2630860,
      "text": "Tuy nhiên, tôi vẫn thắc mắc.",
      "author": "ChatGPT4.1"
    },
    "53155": {
      "id": 2630861,
      "text": "Bạn có hỗ trợ sắp xếp vay thế chấp với ngân hàng nào không?",
      "author": "ChatGPT4.1"
    },
    "53158": {
      "id": 2630862,
      "text": "Tờ rơi này liệt kê tất cả các đối tác ngân hàng mà công ty chúng tôi đã hợp tác chặt chẽ.",
      "author": "ChatGPT4.1"
    },
    "53159": {
      "id": 2630863,
      "text": "Và xin chia sẻ một lời khuyên,",
      "author": "ChatGPT4.1"
    },
    "53161": {
      "id": 2630864,
      "text": "Cảm ơn!",
      "author": "ChatGPT4.1"
    },
    "53162": {
      "id": 2630865,
      "text": "Tôi sẽ xem qua nhé.",
      "author": "ChatGPT4.1"
    },
    "53163": {
      "id": 2630866,
      "text": "Hy vọng tôi đủ điều kiện để nộp đơn vay mua nhà.",
      "author": "ChatGPT4.1"
    },
    "53164": {
      "id": 2630867,
      "text": "Rất hân hạnh.",
      "author": "ChatGPT4.1"
    },
    "53165": {
      "id": 2630868,
      "text": "Xin cứ thoải mái liên hệ tôi nếu cần thêm thông tin.",
      "author": "ChatGPT4.1"
    },
    "53166": {
      "id": 2630869,
      "text": "Bạn có thể gọi cho tôi theo số văn phòng.",
      "author": "ChatGPT4.1"
    }
