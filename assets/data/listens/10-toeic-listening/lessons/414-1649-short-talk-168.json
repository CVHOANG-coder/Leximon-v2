  "translations": {
    "68466": {
      "id": 2675296,
      "text": "Chào mừng bạn đến với một tập mới của Podcast Những Góc Nhìn Kinh Doanh!",
      "author": "ChatGPT4.1"
    },
    "68467": {
      "id": 2675297,
      "text": "Hôm nay, chúng ta sẽ khám phá những điểm tinh tế trong tiếp thị mạng xã hội,",
      "author": "ChatGPT4.1"
    },
    "68468": {
      "id": 2675298,
      "text": "tìm hiểu cả tiềm năng và những giới hạn của nó.",
      "author": "ChatGPT4.1"
    },
    "68469": {
      "id": 2675299,
      "text": "Làm thế nào các doanh nghiệp có thể hoàn thiện chiến lược tiếp thị để kết nối hiệu quả hơn với đối tượng mục tiêu?",
      "author": "ChatGPT4.1"
    },
    "68470": {
      "id": 2675300,
      "text": "Để làm sáng tỏ chủ đề này, chúng tôi hân hạnh được chào đón trở lại Sarah Thompson,",
      "author": "ChatGPT4.1"
    },
    "68471": {
      "id": 2675301,
      "text": "Quản lý Tiếp thị tại Innovate Marketing Group.",
      "author": "ChatGPT4.1"
    },
    "68472": {
      "id": 2675302,
      "text": "Sarah là một khách mời đáng giá của chương trình, nổi tiếng với khả năng đơn giản hóa các khái niệm tiếp thị phức tạp thành những lời khuyên thực tiễn, dễ áp dụng.",
      "author": "ChatGPT4.1"
    }
  }
