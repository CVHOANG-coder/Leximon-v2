  "translations": {
    "66572": {
      "id": 2618433,
      "text": "Lauren, sao bạn vẫn còn ở đây vậy?",
      "author": "ChatGPT4.1"
    },
    "66573": {
      "id": 2618434,
      "text": "Bạn không phải đang ở hội chợ thương mại ở Chicago sao?",
      "author": "ChatGPT4.1"
    },
    "66574": {
      "id": 2618435,
      "text": "Tôi có mà!",
      "author": "ChatGPT4.1"
    },
    "66575": {
      "id": 2618436,
      "text": "Tôi đã phải hủy chuyến đi vào phút chót,",
      "author": "ChatGPT4.1"
    },
    "66576": {
      "id": 2618437,
      "text": "vì một số diễn giả chính bị cảm cúm.",
      "author": "ChatGPT4.1"
    },
    "66577": {
      "id": 2618438,
      "text": "Họ đã dời sự kiện sang cùng thời điểm vào tháng sau.",
      "author": "ChatGPT4.1"
    },
    "66578": {
      "id": 2618439,
      "text": "Thật phiền khi phải sắp xếp lại các cuộc hẹn của bạn.",
      "author": "ChatGPT4.1"
    },
    "66579": {
      "id": 2618440,
      "text": "Tôi biết bạn đã phải lên kế hoạch rất nhiều mới nghỉ được tuần này.",
      "author": "ChatGPT4.1"
    },
    "66580": {
      "id": 2618441,
      "text": "Đúng vậy, tôi rất thất vọng khi biết tin.",
      "author": "ChatGPT4.1"
    },
    "66581": {
      "id": 2618442,
      "text": "Tôi sẽ không thể đi vào tháng sau,",
      "author": "ChatGPT4.1"
    },
    "66582": {
      "id": 2618443,
      "text": "nó quá gần dịp lễ, cũng là thời điểm bận rộn nhất trong năm đối với kế toán.",
      "author": "ChatGPT4.1"
    },
    "66583": {
      "id": 2618444,
      "text": "Tôi hiểu mà.",
      "author": "ChatGPT4.1"
    },
    "66584": {
      "id": 2618445,
      "text": "Hy vọng sẽ có một hội chợ tương tự vào năm mới!",
      "author": "ChatGPT4.1"
    }
  }
