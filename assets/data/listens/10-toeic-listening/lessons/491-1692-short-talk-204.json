  "translations": {
    "68913": {
      "id": 2673911,
      "text": "Chào mừng các bạn lên tàu, và cảm ơn đã lựa chọn Sunshine Cruises.",
      "author": "ChatGPT4.1"
    },
    "68914": {
      "id": 2673912,
      "text": "Tôi tên là Laura, và tôi sẽ là hướng dẫn viên của các bạn trong chuyến tham quan ngắm cảnh này.",
      "author": "ChatGPT4.1"
    },
    "68915": {
      "id": 2673913,
      "text": "Hôm nay, chúng ta sẽ du ngoạn dọc theo bờ biển,",
      "author": "ChatGPT4.1"
    },
    "68916": {
      "id": 2673914,
      "text": "nơi các bạn sẽ có cơ hội ngắm nhìn một số cảnh quan tuyệt đẹp nhất của khu vực,",
      "author": "ChatGPT4.1"
    },
    "68917": {
      "id": 2673915,
      "text": "bao gồm các vách đá, bãi biển ẩn mình, và thậm chí vài ngọn hải đăng lịch sử.",
      "author": "ChatGPT4.1"
    },
    "68918": {
      "id": 2673916,
      "text": "Nếu may mắn, chúng ta có thể nhìn thấy cá heo hoặc rùa biển trên đường đi!",
      "author": "ChatGPT4.1"
    },
    "68919": {
      "id": 2673917,
      "text": "Tôi sẽ giới thiệu các địa danh quan trọng và chia sẻ một chút lịch sử trong suốt hành trình.",
      "author": "ChatGPT4.1"
    },
    "68920": {
      "id": 2673918,
      "text": "Xin mời quý vị thư giãn và lấy nước uống tại quầy bar,",
      "author": "ChatGPT4.1"
    },
    "68921": {
      "id": 2673919,
      "text": "và đừng ngần ngại hỏi nếu có bất kỳ thắc mắc nào.",
      "author": "ChatGPT4.1"
    }
  }
}
