      "author": "a user"
    },
    "54660": {
      "id": 939766,
      "text": "Tôi mua nó được hơn 1 năm một chút nên bảo hành có lẽ đã hết hạn.",
      "author": "a user"
    },
    "54664": {
      "id": 939785,
      "text": "vì bạn là một khách hàng thân thiết nên tôi có thể tặng bạn một phiếu giảm giá 40% cho lần mua hàng tiếp theo của bạn.",
      "author": "a user"
    },
    "54654": {
      "id": 2614537,
      "text": "Xin chào. Tôi gọi về chiếc máy pha cà phê mà tôi đã mua từ trang web của bạn.",
