  "translations": {
    "66980": {
      "id": 2641201,
      "text": "Bạn có mệt mỏi vì phải thực hiện cùng một bài tập nhàm chán ở nhà ngày này qua ngày khác không?",
      "author": "ChatGPT4.1"
    },
    "66981": {
      "id": 2641202,
      "text": "Bây giờ bạn không còn phải như vậy nữa.",
      "author": "ChatGPT4.1"
    },
    "66982": {
      "id": 2641203,
      "text": "Fitness Firm đang mở cửa và cung cấp một lựa chọn thay thế đầy thú vị cho những bài tập nhàm chán đó.",
      "author": "ChatGPT4.1"
    },
    "66983": {
      "id": 2641204,
      "text": "Chúng tôi mở cửa từ Chủ nhật đến Thứ sáu, và có hơn 20 máy tập tim mạch và sức mạnh.",
      "author": "ChatGPT4.1"
    },
    "66984": {
      "id": 2641205,
      "text": "Không chỉ vậy, chúng tôi còn có hai hồ bơi, trong nhà và ngoài trời,",
      "author": "ChatGPT4.1"
    },
    "66985": {
      "id": 2641206,
      "text": "và một phòng xông hơi để thư giãn sau khi tập luyện.",
      "author": "ChatGPT4.1"
    },
    "66986": {
      "id": 2641207,
      "text": "Chúng tôi rất vui nếu bạn có thể tham gia ngày khai trương tại địa điểm của chúng tôi trên đường Wilton vào thứ Năm",
      "author": "ChatGPT4.1"
    },
    "66987": {
      "id": 2641208,
      "text": "để nhận một tháng miễn phí khi bạn ký hợp đồng sáu tháng.",
      "author": "ChatGPT4.1"
    },
    "66988": {
      "id": 2641209,
      "text": "Ngoài ra, bạn có thể nhận một buổi tập miễn phí vào ngày chúng tôi khai trương!",
      "author": "ChatGPT4.1"
    }
  }
}
