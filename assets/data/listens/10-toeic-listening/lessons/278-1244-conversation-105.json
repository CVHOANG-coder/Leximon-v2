  "translations": {
    "55420": {
      "id": 963701,
      "text": "Tôi có thể giúp gì cho bạn?",
      "author": "a user"
    },
    "55424": {
      "id": 963705,
      "text": "Thực ra cô ấy vừa mới ra ngoài để làm một số việc vặt.",
      "author": "a user"
    },
    "55426": {
      "id": 963707,
      "text": "Tôi có thể nhận lời nhắn không?",
      "author": "a user"
    },
    "55419": {
      "id": 2649146,
      "text": "Bạn đã gọi đến hộ gia đình Whitman.",
      "author": "ChatGPT4.1"
    },
    "55421": {
      "id": 2649147,
      "text": "Chào buổi sáng.",
      "author": "ChatGPT4.1"
    },
    "55422": {
      "id": 2649148,
      "text": "Tôi hy vọng được nói chuyện với Laura Whitley.",
      "author": "ChatGPT4.1"
    },
    "55423": {
      "id": 2649149,
      "text": "Cô ấy có ở nhà không?",
      "author": "ChatGPT4.1"
    },
    "55425": {
      "id": 2649150,
      "text": "Tôi là chồng của cô ấy.",
      "author": "ChatGPT4.1"
    },
    "55427": {
      "id": 2649151,
      "text": "Tôi rất muốn để lại lời nhắn.",
      "author": "ChatGPT4.1"
    },
    "55428": {
      "id": 2649152,
      "text": "Tôi là Cynthia Watman, và tôi làm việc tại BioTech Labs.",
      "author": "ChatGPT4.1"
    },
    "55429": {
      "id": 2649153,
      "text": "Vợ anh gần đây đã phỏng vấn trực tuyến cho vị trí Trưởng phòng Công nghệ của chúng tôi,",
      "author": "ChatGPT4.1"
    },
    "55430": {
      "id": 2649154,
      "text": "và chúng tôi rất ấn tượng.",
      "author": "ChatGPT4.1"
    },
    "55431": {
      "id": 2649155,
      "text": "Chúng tôi muốn mời cô ấy đến để hoàn thành bài kiểm tra năng lực vào thứ Sáu.",
      "author": "ChatGPT4.1"
    },
    "55432": {
      "id": 2649156,
      "text": "Có lẽ tốt nhất là cô ấy gọi lại cho tôi để trao đổi chi tiết hơn.",
      "author": "ChatGPT4.1"
    },
    "55433": {
      "id": 2649157,
      "text": "Ồ, cô ấy vừa mới nói với tôi về vị trí này.",
      "author": "ChatGPT4.1"
    },
    "55434": {
      "id": 2649158,
      "text": "Tôi chắc chắn cô ấy sẽ rất vui khi đến.",
      "author": "ChatGPT4.1"
    },
    "55435": {
      "id": 2649159,
      "text": "Cô ấy có số điện thoại của chị để gọi lại không?",
      "author": "ChatGPT4.1"
    }
  }
