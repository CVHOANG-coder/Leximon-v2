  "translations": {
    "66776": {
      "id": 2622166,
      "text": "Chào Sarah, đây là Susannah, gọi từ British Getaways.",
      "author": "ChatGPT4.1"
    },
    "66777": {
      "id": 2622167,
      "text": "Chúng tôi đã chuẩn bị xong cho chuyến đi của bạn tới London, nhưng tôi vừa gặp phải một chút vấn đề.",
      "author": "ChatGPT4.1"
    },
    "66778": {
      "id": 2622168,
      "text": "Chúng tôi đã cố đặt khách sạn mà chúng ta đã thảo luận trước đó,",
      "author": "ChatGPT4.1"
    },
    "66779": {
      "id": 2622169,
      "text": "nhưng rất tiếc, khách sạn đó đã kín phòng do Lễ Kỷ niệm của Nữ hoàng.",
      "author": "ChatGPT4.1"
    },
    "66780": {
      "id": 2622170,
      "text": "Bạn đừng lo, tôi đã đặt cho bạn một chỗ ở rất giống như vậy, tên là The London Bridge Inn.",
      "author": "ChatGPT4.1"
    },
    "66781": {
      "id": 2622171,
      "text": "May mắn thay, phòng này nằm trong ngân sách của bạn, không vượt quá 200 đô mỗi đêm,",
      "author": "ChatGPT4.1"
    },
    "66782": {
      "id": 2622172,
      "text": "và còn bao gồm một buổi trà chiều mỗi ngày.",
      "author": "ChatGPT4.1"
    },
    "66783": {
      "id": 2622173,
      "text": "Tôi sẽ gửi bạn thông tin chi tiết về khách sạn ngay bây giờ, nhưng",
      "author": "ChatGPT4.1"
    },
    "66784": {
      "id": 2622174,
      "text": "nếu bạn muốn xem hình ảnh của chỗ ở này,",
      "author": "ChatGPT4.1"
    },
    "66785": {
      "id": 2622175,
      "text": "hãy truy cập vào www.LBinn.com.",
      "author": "ChatGPT4.1"
    }
  }
