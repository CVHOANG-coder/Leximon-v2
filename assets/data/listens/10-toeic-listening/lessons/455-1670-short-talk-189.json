  "translations": {
    "68653": {
      "id": 2594689,
      "text": "Đây là tủ đựng dụng cụ vệ sinh dành cho đội lao công.",
      "author": "a user"
    },
    "68654": {
      "id": 2594690,
      "text": "Trong quá trình đào tạo, bạn sẽ làm quen với các loại sản phẩm được sử dụng cho các bề mặt khác nhau trong khách sạn,",
      "author": "ChatGPT4.1"
    },
    "68655": {
      "id": 2594691,
      "text": "như thảm và sàn cứng.",
      "author": "ChatGPT4.1"
    },
    "68656": {
      "id": 2594692,
      "text": "Bình xịt trên cùng là Reflekto; cái đó dùng để lau kính.",
      "author": "ChatGPT4.1"
    },
    "68657": {
      "id": 2594693,
      "text": "Sản phẩm mới ngay bên dưới vừa mới được bày bán trong tháng này",
      "author": "ChatGPT4.1"
    },
    "68658": {
      "id": 2594694,
      "text": "và rất tuyệt để đánh bóng đồ nội thất.",
      "author": "ChatGPT4.1"
    },
    "68659": {
      "id": 2594695,
      "text": "Ngoài ra, hãy nhớ rằng vào mỗi thứ Ba lúc 1 giờ chiều,",
      "author": "ChatGPT4.1"
    },
    "68660": {
      "id": 2594696,
      "text": "chúng ta sẽ nhận được xe giao hàng với các vật dụng mà chúng ta sắp hết.",
      "author": "ChatGPT4.1"
    },
    "68661": {
      "id": 2594697,
      "text": "Hãy chú ý đến điều này nhé.",
      "author": "ChatGPT4.1"
    }
  }
