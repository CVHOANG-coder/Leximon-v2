  "translations": {
    "52948": {
      "id": 874303,
      "text": "Nếu bạn ở Cheshire ngày hôm nay, bạn đã thấy bầu trời xanh tuyệt đẹp,",
      "author": "a user"
    },
    "52952": {
      "id": 876546,
      "text": "Thật không may, điều này rất có thể sẽ làm gián đoạn kế hoạch của nhiều học sinh trong khu vực,",
      "author": "a user"
    },
    "52953": {
      "id": 876547,
      "text": "vì các hồ bơi địa phương sẽ mở cửa vào thời điểm đó",
      "author": "a user"
    },
    "52956": {
      "id": 876550,
      "text": "Sau thông điệp của nhà tài trợ, chúng ta sẽ gặp gỡ Nico Casper,",
      "author": "a user"
    },
    "52946": {
      "id": 2591217,
      "text": "Chào mừng các bạn quay trở lại Đài Phát Thanh Dễ Nghe,",
      "author": "ChatGPT4.1"
    },
    "52947": {
      "id": 2591218,
      "text": "đây là người dẫn chương trình của bạn, Rebecca Arnett.",
      "author": "ChatGPT4.1"
    },
    "52949": {
      "id": 2591219,
      "text": "đây là một khoảng thời gian thời tiết dễ chịu sau hai tuần thời tiết tồi tệ vừa qua.",
      "author": "a user"
    },
    "52950": {
      "id": 2591220,
      "text": "Tin tốt là tôi dự đoán mặt trời sẽ ở lại trong ba ngày tới,",
      "author": "ChatGPT4.1"
    },
    "52951": {
      "id": 2591221,
      "text": "nhưng tiếc là các cơn bão sẽ quay lại vào sáng sớm thứ Tư.",
      "author": "ChatGPT4.1"
    },
    "52954": {
      "id": 2591222,
      "text": "Có khả năng sẽ có lốc xoáy vào cuối tuần,",
      "author": "ChatGPT4.1"
    },
    "52955": {
      "id": 2591223,
      "text": "nên hãy tiếp tục theo dõi mạng xã hội của chúng tôi để nhận cập nhật liên tục.",
      "author": "ChatGPT4.1"
    },
    "52957": {
      "id": 2591224,
      "text": "với những cập nhật mới nhất về cuộc bầu cử địa phương.",
      "author": "ChatGPT4.1"
    }
  }
