  "translations": {
    "55054": {
      "id": 963905,
      "text": "Giải đấu sẽ được tổ chức tại Câu lạc bộ Golf Muirfield ở Dublin, Ohio và pha bóng đầu tiên sẽ bắt đầu lúc 5:30 sáng.",
      "author": "a user"
    },
    "55056": {
      "id": 963907,
      "text": "nhưng năm nay các đạo diễn đã bổ sung thêm một cấp độ khác.",
      "author": "a user"
    },
    "55052": {
      "id": 2583998,
      "text": "Hãy chuyển sang phần thể thao của chương trình chúng ta.",
      "author": "ChatGPT4.1"
    },
    "55053": {
      "id": 2583999,
      "text": "Giải đấu golf thường niên lần thứ 15 nhân Ngày Tưởng niệm sẽ diễn ra vào cuối tuần này.",
      "author": "a user"
    },
    "55055": {
      "id": 2584000,
      "text": "Như thường lệ, các tay gôn chuyên nghiệp và bán chuyên sẽ tham dự,",
      "author": "ChatGPT4.1"
    },
    "55057": {
      "id": 2584001,
      "text": "Các tay gôn trẻ chuyên nghiệp sẽ có cơ hội tham gia.",
      "author": "ChatGPT4.1"
    },
    "55058": {
      "id": 2584002,
      "text": "Những tay gôn này là các tài năng trẻ đến từ khắp nước Mỹ, độ tuổi từ mười hai đến mười sáu.",
      "author": "ChatGPT4.1"
    },
    "55059": {
      "id": 2584003,
      "text": "Vé ngày có giá 45 đô la, hoặc bạn có thể mua vé cả cuối tuần với giá 135 đô la.",
      "author": "ChatGPT4.1"
    },
    "55060": {
      "id": 2584004,
      "text": "Bạn có thể mua vé trực tuyến tại www.memorialdaygolf.com.",
      "author": "ChatGPT4.1"
    }
  }
