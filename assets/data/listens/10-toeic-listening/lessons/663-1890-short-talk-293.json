  "translations": {
    "71544": {
      "id": 2583853,
      "text": "Chào mừng đến với Khu Bảo tồn Thái Bình Dương!",
      "author": "ChatGPT4.1"
    },
    "71545": {
      "id": 2583854,
      "text": "Trước khi bắt đầu, tôi muốn nhắc qua một vài điều quan trọng.",
      "author": "ChatGPT4.1"
    },
    "71546": {
      "id": 2583855,
      "text": "Trước hết, xin đừng mang bất kỳ đồ uống nào vào khu bảo tồn.",
      "author": "ChatGPT4.1"
    },
    "71547": {
      "id": 2583856,
      "text": "Điều này giúp chúng tôi giữ cho nơi đây sạch sẽ và an toàn cho mọi người.",
      "author": "ChatGPT4.1"
    },
    "71548": {
      "id": 2583857,
      "text": "Ngoài ra, bạn cứ thoải mái chụp hình,",
      "author": "ChatGPT4.1"
    },
    "71549": {
      "id": 2583858,
      "text": "nhưng nhớ tắt đèn flash của máy ảnh,",
      "author": "ChatGPT4.1"
    },
    "71550": {
      "id": 2583859,
      "text": "vì nó có thể làm các loài động vật hoảng sợ.",
      "author": "ChatGPT4.1"
    },
    "71551": {
      "id": 2583860,
      "text": "Và xin nhắc nhở một điều nữa:",
      "author": "ChatGPT4.1"
    },
    "71552": {
      "id": 2583861,
      "text": "hãy đi theo các lối đi đã được đánh dấu và tránh các khu vực cấm để đảm bảo an toàn cho bạn.",
      "author": "ChatGPT4.1"
    },
    "71553": {
      "id": 2583862,
      "text": "Chúng ta sẽ nghỉ giải lao 45 phút tại Quán Rainforest Bistro",
      "author": "ChatGPT4.1"
    },
    "71554": {
      "id": 2583863,
      "text": "khi chúng ta tham quan xong khu vực môi trường sống Bắc Mỹ.",
      "author": "ChatGPT4.1"
    },
    "71555": {
      "id": 2583864,
      "text": "Sau khi mọi người ăn xong, chúng ta sẽ tiếp tục khám phá đường mòn Nam Mỹ.",
      "author": "ChatGPT4.1"
    },
    "71556": {
      "id": 2583865,
      "text": "Được rồi, nếu mọi người đã sẵn sàng, chúng ta hãy bắt đầu chuyến phiêu lưu nhé!",
      "author": "ChatGPT4.1"
    }
  }
}
