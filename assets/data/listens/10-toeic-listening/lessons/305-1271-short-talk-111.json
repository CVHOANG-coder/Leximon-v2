  "translations": {
    "55880": {
      "id": 2590697,
      "text": "Chào buổi sáng, bác sĩ Lewis.",
      "author": "ChatGPT4.1"
    },
    "55881": {
      "id": 2590698,
      "text": "Tôi là Marion Mix, từ Nature's Medical Supplies.",
      "author": "ChatGPT4.1"
    },
    "55882": {
      "id": 2590699,
      "text": "Tôi biết tuần trước bác sĩ đã gọi cho chúng tôi về các giải pháp vi lượng đồng căn cho phòng khám của mình,",
      "author": "ChatGPT4.1"
    },
    "55883": {
      "id": 2590700,
      "text": "và tôi muốn liên lạc lại để trao đổi thêm.",
      "author": "ChatGPT4.1"
    },
    "55884": {
      "id": 2590701,
      "text": "Tôi sẽ đến Ohio vào tháng tới,",
      "author": "ChatGPT4.1"
    },
    "55885": {
      "id": 2590702,
      "text": "và tôi rất muốn mang một số mẫu sản phẩm đến phòng khám của bác sĩ, đồng thời trò chuyện trực tiếp.",
      "author": "ChatGPT4.1"
    },
    "55886": {
      "id": 2590703,
      "text": "Tất cả sản phẩm của chúng tôi đều 100% tự nhiên và chúng tôi giao hàng hàng tuần.",
      "author": "ChatGPT4.1"
    },
    "55887": {
      "id": 2590704,
      "text": "Tôi rất mong có cơ hội được nói chuyện trực tiếp,",
      "author": "ChatGPT4.1"
    },
    "55888": {
      "id": 2590705,
      "text": "hãy cho tôi biết nếu bác sĩ có thời gian đi ăn trưa.",
      "author": "ChatGPT4.1"
    },
    "55889": {
