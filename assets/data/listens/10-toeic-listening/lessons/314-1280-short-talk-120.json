  "translations": {
    "55972": {
      "id": 2650843,
      "text": "Chào buổi sáng, quý thính giả, và chào mừng trở lại với WCOL tại Seattle.",
      "author": "ChatGPT4.1"
    },
    "55973": {
      "id": 2650844,
      "text": "Thời tiết sẽ ẩm ướt và ảm đạm trong vài ngày tới,",
      "author": "ChatGPT4.1"
    },
    "55974": {
      "id": 2650845,
      "text": "vì vậy nếu bạn có thể ở nhà, chúng tôi khuyên bạn nên ở nhà!",
      "author": "ChatGPT4.1"
    },
    "55975": {
      "id": 2650846,
      "text": "Mưa lớn sẽ bắt đầu từ sáng sớm ngày mai thứ Ba và kéo dài đến tối Chủ nhật.",
      "author": "ChatGPT4.1"
    },
    "55976": {
      "id": 2650847,
      "text": "Có cảnh báo lũ quét,",
      "author": "ChatGPT4.1"
    },
    "55977": {
      "id": 2650848,
      "text": "nên dịch vụ phà giữa Seattle và Bainbridge đã bị tạm ngưng cho đến sáng thứ Hai.",
      "author": "ChatGPT4.1"
    },
    "55978": {
      "id": 2650849,
      "text": "Hiện tại, các tuyến tàu trong thành phố vẫn đang hoạt động,",
      "author": "ChatGPT4.1"
    },
    "55979": {
      "id": 2650850,
      "text": "nhưng tuỳ vào lượng mưa, cũng có thể sẽ bị tạm ngưng.",
      "author": "ChatGPT4.1"
    },
    "55980": {
      "id": 2650851,
      "text": "Nhiều công ty đang cho phép nhân viên làm việc tại nhà,",
      "author": "ChatGPT4.1"
    },
    "55981": {
      "id": 2650852,
      "text": "vì vậy hãy kiểm tra với công ty của bạn trước khi rời nhà đi làm.",
      "author": "ChatGPT4.1"
    },
    "55982": {
      "id": 2650853,
      "text": "Hãy theo dõi cập nhật thời tiết mỗi giờ, đúng vào đầu giờ.",
      "author": "ChatGPT4.1"
    }
  }
