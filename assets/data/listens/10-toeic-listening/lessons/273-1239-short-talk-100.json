  "translations": {
    "55338": {
      "id": 2645412,
      "text": "Chào mọi người.",
      "author": "ChatGPT4.1"
    },
    "55339": {
      "id": 2645413,
      "text": "Dựa trên những phản hồi mà chúng tôi vừa nhận được, chúng tôi đã quyết định làm một điều mới trong năm nay.",
      "author": "ChatGPT4.1"
    },
    "55340": {
      "id": 2645414,
      "text": "Vào đầu tháng 9, chúng tôi sẽ bắt đầu thực hiện đánh giá nhân viên.",
      "author": "ChatGPT4.1"
    },
    "55341": {
      "id": 2645415,
      "text": "Quản lý bếp, Bill, và tôi sẽ gặp từng người trong các bạn để nói về thái độ và đạo đức nghề nghiệp của bạn.",
      "author": "ChatGPT4.1"
    },
    "55342": {
      "id": 2645416,
      "text": "Những buổi đánh giá này cũng là dịp để các bạn đặt bất kỳ câu hỏi nào mà mình có,",
      "author": "ChatGPT4.1"
    },
    "55343": {
      "id": 2645417,
      "text": "liên quan đến sự thăng tiến trong công việc hoặc các hoạt động hàng ngày.",
      "author": "ChatGPT4.1"
    },
    "55344": {
      "id": 2645418,
      "text": "Chúng tôi sẽ tiến hành các buổi đánh giá này mỗi sáu tháng một lần,",
      "author": "ChatGPT4.1"
    },
    "55345": {
      "id": 2645419,
      "text": "với hy vọng những phản hồi sẽ khuyến khích một môi trường làm việc tích cực và minh bạch hơn.",
      "author": "ChatGPT4.1"
    },
    "55346": {
      "id": 2645420,
      "text": "Để tiết kiệm thời gian,",
      "author": "ChatGPT4.1"
    },
    "55347": {
      "id": 2645421,
      "text": "chúng tôi chỉ tiến hành đánh giá với các nhân viên làm việc toàn thời gian.",
      "author": "ChatGPT4.1"
    },
    "55348": {
      "id": 2645422,
      "text": "Có ai có câu hỏi nào không?",
      "author": "ChatGPT4.1"
    }
  }
