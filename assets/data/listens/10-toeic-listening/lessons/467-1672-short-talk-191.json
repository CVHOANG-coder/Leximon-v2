  "translations": {
    "68671": {
      "id": 2622679,
      "text": "Chào bạn, tôi là Jennifer từ Skyview Realty.",
      "author": "ChatGPT4.1"
    },
    "68672": {
      "id": 2622680,
      "text": "Tôi chỉ muốn trao đổi thêm về cuộc trò chuyện lần trước của chúng ta về căn nhà trên đường Oak.",
      "author": "ChatGPT4.1"
    },
    "68673": {
      "id": 2622681,
      "text": "Nó vẫn còn đang rao bán, nhưng đừng chờ quá lâu,",
      "author": "ChatGPT4.1"
    },
    "68674": {
      "id": 2622682,
      "text": "hiện tại nó đang rất \"hot\", và tôi đã nhận thêm một vài yêu cầu hỏi về nó rồi.",
      "author": "ChatGPT4.1"
    },
    "68675": {
      "id": 2622683,
      "text": "Nếu bạn quan tâm, tốt nhất nên tận dụng cơ hội khi còn kịp.",
      "author": "ChatGPT4.1"
    },
    "68676": {
      "id": 2622684,
      "text": "Cứ thoải mái gọi cho tôi nếu bạn muốn đặt lịch xem nhà lần hai hoặc tiến hành đặt giá mua nhé.",
      "author": "ChatGPT4.1"
    }
  }
