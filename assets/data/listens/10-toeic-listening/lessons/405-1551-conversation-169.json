  "translations": {
    "66307": {
      "id": 2614714,
      "text": "Này! Dự án cho sự kiện ra mắt mới tiến triển thế nào rồi?",
      "author": "ChatGPT4.1"
    },
    "66308": {
      "id": 2614715,
      "text": "Thành thật mà nói, nó không ổn lắm.",
      "author": "ChatGPT4.1"
    },
    "66309": {
      "id": 2614716,
      "text": "Tôi hầu như không có thời gian để xem hết tất cả các yêu cầu.",
      "author": "ChatGPT4.1"
    },
    "66310": {
      "id": 2614717,
      "text": "Tôi đang thực sự bận với rất nhiều sự kiện khác ngay lúc này,",
      "author": "ChatGPT4.1"
    },
    "66311": {
      "id": 2614718,
      "text": "Tôi lo mình sẽ không hoàn thành kịp hạn chót.",
      "author": "ChatGPT4.1"
    },
    "66312": {
      "id": 2614719,
      "text": "Ôi không.",
      "author": "ChatGPT4.1"
    },
    "66313": {
      "id": 2614720,
      "text": "Đây là thời điểm trong năm rất bận rộn.",
      "author": "ChatGPT4.1"
    },
    "66314": {
      "id": 2614721,
      "text": "Hạn nộp là chiều thứ Sáu, đúng không?",
      "author": "ChatGPT4.1"
    },
    "66315": {
      "id": 2614722,
      "text": "Bạn có nên xin gia hạn thêm thời gian không?",
      "author": "ChatGPT4.1"
    },
    "66316": {
      "id": 2614723,
      "text": "Tôi sẽ phải xin một lần gia hạn.",
      "author": "ChatGPT4.1"
    },
    "66317": {
      "id": 2614724,
      "text": "Tôi nghĩ mình có thể hoàn thành vào thứ Ba tuần sau.",
      "author": "ChatGPT4.1"
    },
    "66318": {
      "id": 2614725,
      "text": "Tôi cảm thấy lo lắng, bạn có thể nói chuyện với sếp cùng tôi không?",
      "author": "ChatGPT4.1"
    },
    "66319": {
      "id": 2614726,
      "text": "Tôi ước gì có thể, nhưng bây giờ tôi phải đi đưa con gái đến nha sĩ.",
      "author": "ChatGPT4.1"
    },
    "66320": {
      "id": 2614727,
      "text": "Chúc may mắn!",
      "author": "ChatGPT4.1"
    }
