  "translations": {
    "70289": {
      "id": 2642551,
      "text": "Tôi là Theo Garner, mang đến cho bạn những cập nhật mới nhất về địa phương.",
      "author": "ChatGPT4.1"
    },
    "70290": {
      "id": 2642552,
      "text": "Tôi biết nhiều người trong các bạn đã nhận thấy số thuế của mình tăng đáng kể trong năm nay,",
      "author": "ChatGPT4.1"
    },
    "70291": {
      "id": 2642553,
      "text": "và có lẽ bạn đang tự hỏi số tiền đó sẽ được sử dụng vào đâu.",
      "author": "ChatGPT4.1"
    },
    "70292": {
      "id": 2642554,
      "text": "Tin vui đây!",
      "author": "ChatGPT4.1"
    },
    "70293": {
      "id": 2642555,
      "text": "Thành phố đang tiến hành bốn dự án lớn nhằm nâng cao chất lượng cộng đồng của chúng ta.",
      "author": "ChatGPT4.1"
    },
    "70294": {
      "id": 2642556,
      "text": "Chúng tôi đang cải thiện thư viện, mở rộng khu vực công viên,",
      "author": "ChatGPT4.1"
    },
    "70295": {
      "id": 2642557,
      "text": "cải tạo trạm cứu hỏa, và nâng cấp đường phố của chúng ta.",
      "author": "ChatGPT4.1"
    },
    "70296": {
      "id": 2642558,
      "text": "Hiện tại, công trình cải tạo trạm cứu hỏa đang được tiến hành,",
      "author": "ChatGPT4.1"
    },
    "70297": {
      "id": 2642559,
      "text": "và chúng tôi sẽ khởi động các dự án khác trong vài tháng tới.",
      "author": "ChatGPT4.1"
    },
    "70298": {
      "id": 2642560,
      "text": "Ngoài ra, tôi muốn nhắc bạn rằng cuộc bầu cử thị trưởng cũng sắp diễn ra.",
      "author": "ChatGPT4.1"
    },
    "70299": {
      "id": 2642561,
      "text": "Lá phiếu của bạn đóng vai trò quan trọng trong việc quyết định những dự án nào sẽ được ưu tiên trong tương lai.",
      "author": "ChatGPT4.1"
    },
    "70300": {
      "id": 2642562,
      "text": "Để giúp bạn đưa ra quyết định đúng đắn, các ứng viên sẽ tranh luận trực tiếp tại trường quay của chúng tôi vào thứ Tư này,",
      "author": "ChatGPT4.1"
    },
    "70301": {
      "id": 2642563,
      "text": "và chúng tôi rất mong bạn sẽ tham gia cùng chúng tôi.",
      "author": "ChatGPT4.1"
    }
  }
}
