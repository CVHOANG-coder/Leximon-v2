  "translations": {
    "70319": {
      "id": 2637960,
      "text": "Chào mừng đến với Nghệ thuật & Văn hóa Hôm nay.",
      "author": "ChatGPT4.1"
    },
    "70320": {
      "id": 2637961,
      "text": "Hội sách Chicago vừa tiết lộ một bổ sung mới đầy thú vị cho lịch trình năm nay.",
      "author": "ChatGPT4.1"
    },
    "70321": {
      "id": 2637962,
      "text": "Điều phối viên sự kiện Sarah Lin mới đây đã thông báo rằng tác giả bán chạy Jake Daniels sẽ tham gia hội thảo.",
      "author": "ChatGPT4.1"
    },
    "70322": {
      "id": 2637963,
      "text": "Anh ấy sẽ cùng nhà văn Emily Hart tham gia một buổi thảo luận đặc biệt.",
      "author": "ChatGPT4.1"
    },
    "70323": {
      "id": 2637964,
      "text": "Đây là lần đầu tiên hai nhân vật văn học này cùng đứng trên một sân khấu,",
      "author": "ChatGPT4.1"
    },
    "70324": {
      "id": 2637965,
      "text": "khiến đây trở thành sự kiện không thể bỏ lỡ cho những người yêu sách.",
      "author": "ChatGPT4.1"
    },
    "70325": {
      "id": 2637966,
      "text": "Nếu bạn muốn tham gia, hãy nhanh tay mua vé vì vé dự kiến sẽ bán hết rất nhanh.",
      "author": "ChatGPT4.1"
    },
    "70326": {
      "id": 2637967,
      "text": "Vé tham dự toàn bộ hội sách có giá 60 đô la,",
      "author": "ChatGPT4.1"
    },
    "70327": {
      "id": 2637968,
      "text": "trong khi vé cho từng sự kiện có giá 25 đô la mỗi vé.",
      "author": "ChatGPT4.1"
    },
    "70328": {
      "id": 2637969,
      "text": "Thêm vào đó, 30% doanh thu từ bán vé sẽ được dành cho các chương trình xóa mù chữ địa phương,",
      "author": "ChatGPT4.1"
    },
    "70329": {
      "id": 2637970,
      "text": "vì vậy bạn sẽ vừa giúp đỡ người khác, vừa thưởng thức những buổi thảo luận tuyệt vời.",
      "author": "ChatGPT4.1"
    }
  }
