  "translations": {
    "71557": {
      "id": 2625137,
      "text": "Bạn đang tìm kiếm điều gì thú vị để làm vào cuối tuần này?",
      "author": "ChatGPT4.1"
    },
    "71558": {
      "id": 2625138,
      "text": "Hãy đến Trung tâm Thương mại Central để chào mừng lễ khai trương khu vườn trên sân thượng mới vào thứ Bảy, ngày 10 tháng 6!",
      "author": "ChatGPT4.1"
    },
    "71559": {
      "id": 2625139,
      "text": "Khu vườn này bao phủ phần lớn tầng trên cùng của tòa nhà,",
      "author": "ChatGPT4.1"
    },
    "71560": {
      "id": 2625140,
      "text": "với cảnh quan tuyệt đẹp, đa dạng các loài cây,",
      "author": "ChatGPT4.1"
    },
    "71561": {
      "id": 2625141,
      "text": "và những khu vực ghế ngồi thoải mái để thư giãn.",
      "author": "ChatGPT4.1"
    },
    "71562": {
      "id": 2625142,
      "text": "Đối với những ai đến cùng trẻ em, có một khu vui chơi riêng để các bé có thể khám phá an toàn.",
      "author": "ChatGPT4.1"
    },
    "71563": {
      "id": 2625143,
      "text": "Cần thêm điều gì để khơi dậy sự hứng thú của bạn?",
      "author": "ChatGPT4.1"
    },
    "71564": {
      "id": 2625144,
      "text": "Nếu bạn tham gia cùng chúng tôi vào thứ Bảy,",
      "author": "ChatGPT4.1"
    },
    "71565": {
      "id": 2625145,
      "text": "bạn có thể thưởng thức màn trình diễn trực tiếp đặc biệt của ban nhạc dân gian nổi tiếng The Riverstones tại nhà hát ngoài trời trong vườn.",
      "author": "ChatGPT4.1"
    },
    "71566": {
      "id": 2625146,
      "text": "Truy cập trang web của chúng tôi để biết thêm chi tiết về sự kiện này.",
      "author": "ChatGPT4.1"
    },
    "71567": {
      "id": 2625147,
      "text": "Chúng tôi hy vọng sẽ gặp bạn vào thứ Bảy này!",
      "author": "ChatGPT4.1"
    }
  }
}
