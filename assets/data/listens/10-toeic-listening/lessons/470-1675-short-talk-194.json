  "translations": {
    "68692": {
      "id": 2659773,
      "text": "Chào buổi sáng, và chào mừng quý khách lên chuyến bay 652 đi Denver.",
      "author": "ChatGPT4.1"
    },
    "68693": {
      "id": 2659774,
      "text": "Tôi tên là Riley, cơ trưởng của quý khách cho chuyến bay hôm nay.",
      "author": "ChatGPT4.1"
    },
    "68694": {
      "id": 2659775,
      "text": "Chúng tôi dự kiến chuyến bay sẽ êm ái với bầu trời trong xanh,",
      "author": "ChatGPT4.1"
    },
    "68695": {
      "id": 2659776,
      "text": "và thời gian hạ cánh dự kiến là 3:15 chiều theo giờ địa phương.",
      "author": "ChatGPT4.1"
    },
    "68696": {
      "id": 2659777,
      "text": "Thời tiết tại Denver hiện có mây nhẹ, nhiệt độ dễ chịu khoảng 68 độ F.",
      "author": "ChatGPT4.1"
    },
    "68697": {
      "id": 2659778,
      "text": "Khi máy bay đạt độ cao hành trình, tiếp viên sẽ bắt đầu phục vụ.",
      "author": "ChatGPT4.1"
    },
    "68698": {
      "id": 2659779,
      "text": "Xin mời quý khách ngồi lại, thư giãn và tận hưởng chuyến bay!",
      "author": "ChatGPT4.1"
    }
  }
