  "translations": {
    "69494": {
      "id": 2590525,
      "text": "Chào buổi sáng! Đây là tiệm may Harper.",
      "author": "ChatGPT4.1"
    },
    "69495": {
      "id": 2590526,
      "text": "Tôi có thể giúp gì cho bạn hôm nay?",
      "author": "ChatGPT4.1"
    },
    "69496": {
      "id": 2590527,
      "text": "Chào bạn, tôi là Neville Miller.",
      "author": "ChatGPT4.1"
    },
    "69497": {
      "id": 2590528,
      "text": "Tôi đã gửi một bộ vest để chỉnh sửa vào tuần trước,",
      "author": "ChatGPT4.1"
    },
    "69498": {
      "id": 2590529,
      "text": "và tôi muốn hỏi xem nó đã sẵn sàng để lấy chưa.",
      "author": "ChatGPT4.1"
    },
    "69499": {
      "id": 2590530,
      "text": "Để tôi kiểm tra...",
      "author": "ChatGPT4.1"
    },
    "69500": {
      "id": 2590531,
      "text": "À, ông Miller, có vẻ như bộ vest của ông sẽ sẵn sàng vào chiều mai.",
      "author": "ChatGPT4.1"
    },
    "69501": {
      "id": 2590532,
      "text": "Chúng tôi gặp một vài sự chậm trễ.",
      "author": "ChatGPT4.1"
    },
    "69502": {
      "id": 2590533,
      "text": "Ồ, không sao!",
      "author": "ChatGPT4.1"
    },
    "69503": {
      "id": 2590534,
      "text": "Dù sao tôi cũng chưa định mặc nó cho đến cuối tuần.",
      "author": "ChatGPT4.1"
    },
    "69504": {
      "id": 2590535,
      "text": "Tôi sẽ ghé lấy vào ngày mai sau khi tan làm.",
      "author": "ChatGPT4.1"
    },
    "69505": {
      "id": 2590536,
      "text": "Vậy thì quá tuyệt.",
      "author": "ChatGPT4.1"
    },
    "69506": {
      "id": 2590537,
      "text": "Chỉ cần chắc chắn mang theo hóa đơn khi đến nhé.",
      "author": "ChatGPT4.1"
    },
    "69507": {
      "id": 2590538,
      "text": "Tổng chi phí là 45 đô la.",
      "author": "ChatGPT4.1"
    },
    "69508": {
      "id": 2590539,
      "text": "Được, tôi sẽ mang theo.",
      "author": "ChatGPT4.1"
    },
    "69509": {
      "id": 2590540,
      "text": "Và tôi đoán tiệm vẫn mở cửa đến 6 giờ tối?",
      "author": "ChatGPT4.1"
    },
    "69510": {
      "id": 2590541,
      "text": "Vâng, chúng tôi đóng cửa lúc 6 giờ. Nhưng nếu bạn đến muộn, hãy gọi cho chúng tôi, chúng tôi sẽ đợi một chút.",
      "author": "ChatGPT4.1"
    }
  }
}
