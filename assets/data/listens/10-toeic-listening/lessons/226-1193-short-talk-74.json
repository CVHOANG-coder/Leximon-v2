  "translations": {
    "54789": {
      "id": 945894,
      "text": "Tôi là Noah Lewis, và tôi cùng với những người kiểm lâm còn lại muốn chào mừng bạn đến với Núi Rainier.",
      "author": "a user"
    },
    "54794": {
      "id": 945900,
      "text": "vì vậy chúng tôi yêu cầu bạn xem một đoạn video nhanh hướng dẫn an toàn dài năm phút.",
      "author": "a user"
    },
    "54788": {
      "id": 2625441,
      "text": "Chào mừng mọi người.",
      "author": "ChatGPT4.1"
    },
    "54790": {
      "id": 2625442,
      "text": "Chúng ta thật may mắn khi có hệ động thực vật đa dạng ở công viên này,",
      "author": "ChatGPT4.1"
    },
    "54791": {
      "id": 2625443,
      "text": "bao gồm đại bàng đầu trắng, gấu nâu và chó sói đồng cỏ,",
      "author": "ChatGPT4.1"
    },
    "54792": {
      "id": 2625444,
      "text": "mà hy vọng rằng các bạn sẽ có thể nhìn thấy trong thời gian ở đây.",
      "author": "ChatGPT4.1"
    },
    "54793": {
      "id": 2625445,
      "text": "Điều quan trọng là luôn cảnh giác và tôn trọng động vật hoang dã,",
      "author": "ChatGPT4.1"
    },
    "54795": {
      "id": 2625446,
      "text": "Khi video kết thúc, sẽ có thời gian để các bạn đặt câu hỏi,",
      "author": "ChatGPT4.1"
    },
    "54796": {
      "id": 2625447,
      "text": "và sau đó các bạn sẽ bắt đầu tham quan.",
      "author": "ChatGPT4.1"
    },
    "54797": {
      "id": 2625448,
      "text": "Trước khi bắt đầu, tôi muốn nhấn mạnh tầm quan trọng của việc đi đúng đường đã chỉ định.",
      "author": "ChatGPT4.1"
    },
    "54798": {
      "id": 2625449,
      "text": "Được rồi, chúng ta bắt đầu nhé.",
      "author": "ChatGPT4.1"
    }
  }
}
