  "translations": {
    "68508": {
      "id": 2604888,
      "text": "Tôi muốn thông báo với mọi người rằng bắt đầu từ thứ Hai,",
      "author": "ChatGPT4.1"
    },
    "68509": {
      "id": 2604889,
      "text": "lối vào chính của tòa nhà văn phòng sẽ đóng cửa để thi công",
      "author": "ChatGPT4.1"
    },
    "68510": {
      "id": 2604890,
      "text": "vì con đường đang được mở rộng và trải nhựa lại.",
      "author": "ChatGPT4.1"
    },
    "68511": {
      "id": 2604891,
      "text": "Việc đóng cửa này cũng sẽ ảnh hưởng đến khu vực đỗ xe thường lệ của chúng ta.",
      "author": "ChatGPT4.1"
    },
    "68512": {
      "id": 2604892,
      "text": "Tuy nhiên, mọi người không cần lo lắng,",
      "author": "ChatGPT4.1"
    },
    "68513": {
      "id": 2604893,
      "text": "có rất nhiều chỗ đỗ xe trong nhà để xe bên cạnh tòa nhà Oak.",
      "author": "ChatGPT4.1"
    },
    "68514": {
      "id": 2604894,
      "text": "Để tạo thuận lợi cho mọi người,",
      "author": "ChatGPT4.1"
    },
    "68515": {
      "id": 2604895,
      "text": "công ty sẽ cung cấp dịch vụ xe đưa đón",
      "author": "ChatGPT4.1"
    },
    "68516": {
      "id": 2604896,
      "text": "xe đưa đón sẽ chạy mỗi 15 phút cho đến khi công việc hoàn thành.",
      "author": "ChatGPT4.1"
    },
    "68517": {
      "id": 2604897,
      "text": "Xe đưa đón sẽ hoạt động từ 7 đến 9 giờ sáng,",
      "author": "ChatGPT4.1"
    },
    "68518": {
      "id": 2604898,
      "text": "và sau đó từ 4 đến 6 giờ chiều.",
      "author": "ChatGPT4.1"
    }
  }
}
