  "translations": {
    "69618": {
      "id": 2585718,
      "text": "Đây là Sylvester Castro, mang đến cho bạn bản cập nhật giao thông buổi sáng.",
      "author": "ChatGPT4.1"
    },
    "69619": {
      "id": 2585719,
      "text": "Những người đi làm hướng về khu uptown nên lưu ý có sự chậm trễ đáng kể trên đường cao tốc East River.",
      "author": "ChatGPT4.1"
    },
    "69620": {
      "id": 2585720,
      "text": "Một sự cố với xe xây dựng đã xảy ra khoảng 15 phút trước đây",
      "author": "ChatGPT4.1"
    },
    "69621": {
      "id": 2585721,
      "text": "đã dẫn đến việc tạm thời đóng cửa hai làn đường hướng đông.",
      "author": "ChatGPT4.1"
    },
    "69622": {
      "id": 2585722,
      "text": "Ngoài ra, công tác bảo trì đang diễn ra trên tuyến Downtown Express Loop,",
      "author": "ChatGPT4.1"
    },
    "69623": {
      "id": 2585723,
      "text": "một tuyến đường quan trọng khác vào trung tâm thương mại.",
      "author": "ChatGPT4.1"
    },
    "69624": {
      "id": 2585724,
      "text": "Hãy dự đoán sẽ bị chậm khoảng 25 phút.",
      "author": "ChatGPT4.1"
    },
    "69625": {
      "id": 2585725,
      "text": "Chúng tôi dự đoán những gián đoạn này sẽ được giải quyết trong vòng một tiếng rưỡi tới.",
      "author": "ChatGPT4.1"
    },
    "69626": {
      "id": 2585726,
      "text": "Nếu có thể, hãy cân nhắc sử dụng hệ thống tàu điện nhẹ để tránh những kẹt xe này vào sáng nay.",
      "author": "ChatGPT4.1"
    }
  }
