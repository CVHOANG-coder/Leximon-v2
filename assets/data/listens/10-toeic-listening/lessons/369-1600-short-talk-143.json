  "translations": {
    "66949": {
      "id": 2636134,
      "text": "Chào mọi người, tôi có thể xin sự chú ý của các bạn không?",
      "author": "ChatGPT4.1"
    },
    "66950": {
      "id": 2636135,
      "text": "Tôi chỉ muốn giới thiệu với các bạn về Tyson Brandt.",
      "author": "ChatGPT4.1"
    },
    "66951": {
      "id": 2636136,
      "text": "Tyson là một cựu vận động viên thể hình từ phòng gym của chúng ta ở Miami,",
      "author": "ChatGPT4.1"
    },
    "66952": {
      "id": 2636137,
      "text": "và tôi đã mời anh ấy đến đây tuần này vì anh ấy sẽ mở một chi nhánh ở Nashville.",
      "author": "ChatGPT4.1"
    },
    "66953": {
      "id": 2636138,
      "text": "Anh ấy ở đây để tìm hiểu về hoạt động hàng ngày và những dự án mới mà chúng ta đang triển khai.",
      "author": "ChatGPT4.1"
    },
    "66954": {
      "id": 2636139,
      "text": "Tôi biết tất cả các bạn đều rất muốn gặp Tyson,",
      "author": "ChatGPT4.1"
    },
    "66955": {
      "id": 2636140,
      "text": "nhưng tôi muốn tiếp tục chuyến tham quan và hoàn tất giấy tờ trước khi khai trương.",
      "author": "ChatGPT4.1"
    },
    "66956": {
      "id": 2636141,
      "text": "Vì vậy, nếu bạn muốn đặt lịch để nói chuyện với anh ấy,",
      "author": "ChatGPT4.1"
    },
    "66957": {
      "id": 2636142,
      "text": "bạn nên gửi cho tôi một email và tôi sẽ sắp xếp lịch trình.",
      "author": "ChatGPT4.1"
    }
  }
