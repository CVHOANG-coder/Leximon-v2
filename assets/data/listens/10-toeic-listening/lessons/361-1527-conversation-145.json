    },
    "65942": {
      "id": 2619322,
      "text": "Tôi đồng ý.",
      "author": "ChatGPT4.1"
    },
    "65943": {
      "id": 2619323,
      "text": "Các công nhân thật đáng thất vọng và thiếu chuyên nghiệp.",
      "author": "ChatGPT4.1"
    },
    "65944": {
      "id": 2619324,
      "text": "Họ bật nhạc to đến mức,",
      "author": "ChatGPT4.1"
    },
    "65945": {
      "id": 2619325,
      "text": "tôi hầu như không thể gọi điện cho khách hàng.",
      "author": "ChatGPT4.1"
    },
    "65946": {
      "id": 2619326,
      "text": "Chưa kể, văn phòng thì lộn xộn hoàn toàn với bụi bẩn và giày dép dơ.",
      "author": "ChatGPT4.1"
    },
    "65947": {
      "id": 2619327,
      "text": "Chúng ta có lẽ nên gọi cho văn phòng chính của công ty xây dựng.",
