    },
    "54845": {
      "id": 950918,
      "text": "Trước khi đăng ký, xin lưu ý rằng ngày phỏng vấn ở Chicago đã được chuyển sang ngày trước vòng phỏng vấn ở New Orleans",
      "author": "a user"
    },
    "54837": {
      "id": 2623940,
      "text": "Bạn đang muốn sửa sang lại ngôi nhà của mình?",
