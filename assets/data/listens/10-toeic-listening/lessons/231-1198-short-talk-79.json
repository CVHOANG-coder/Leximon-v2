    },
    "54844": {
      "id": 2623946,
      "text": "Nếu bạn quan tâm và muốn đăng ký, hãy gửi thông tin cá nhân cùng ảnh ngôi nhà của bạn tới auditions@HUH.com.",
      "author": "ChatGPT4.1"
    },
    "54846": {
