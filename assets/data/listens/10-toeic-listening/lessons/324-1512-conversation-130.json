  "translations": {
    "65707": {
      "id": 2371649,
      "text": "Xin chào, tôi là Emily Larson gọi điện thay mặt cho Robo Technology.",
      "author": "DeepSeekAI"
    },
    "65708": {
      "id": 2371650,
      "text": "Chúng tôi đã chọn một vài mẫu mà chúng tôi cảm thấy có thể phù hợp cho việc cải tạo văn phòng.",
      "author": "DeepSeekAI"
    },
    "65709": {
      "id": 2371651,
      "text": "Chúng tôi có thể xem một số mẫu được không?",
      "author": "DeepSeekAI"
    },
    "65710": {
      "id": 2371652,
      "text": "Chắc chắn rồi.",
      "author": "DeepSeekAI"
    },
    "65711": {
      "id": 2371653,
      "text": "Hiện chúng tôi có rất nhiều loại gỗ và lớp hoàn thiện đa dạng.",
      "author": "DeepSeekAI"
    },
    "65712": {
      "id": 2371654,
      "text": "Sẽ rất tốt nếu bạn có thể chỉ định tên của chúng từ danh mục sàn gỗ thủ công mà chúng tôi đã gửi cho bạn trước đó.",
      "author": "DeepSeekAI"
    },
    "65713": {
      "id": 2371655,
      "text": "Tất nhiên.",
      "author": "DeepSeekAI"
    },
    "65714": {
      "id": 2371656,
      "text": "Montiel và Chambery đều trông rất đẹp.",
      "author": "DeepSeekAI"
    },
    "65715": {
      "id": 2371657,
      "text": "Chúng sẽ được sử dụng cho nhiều không gian văn phòng khác nhau,",
      "author": "DeepSeekAI"
    },
    "65716": {
      "id": 2371658,
      "text": "nên thật khó để quyết định.",
      "author": "DeepSeekAI"
    },
    "65717": {
      "id": 2371659,
      "text": "Tại sao bạn không đến kho của chúng tôi?",
      "author": "DeepSeekAI"
    },
    "65718": {
      "id": 2371660,
      "text": "Bạn có thể đi thử để cảm nhận trực tiếp.",
      "author": "DeepSeekAI"
    },
    "65719": {
      "id": 2371661,
      "text": "Ý hay đấy.",
      "author": "DeepSeekAI"
    },
    "65720": {
      "id": 2371662,
      "text": "Bạn có thể giới thiệu ai đó có thể lắp đặt sàn giúp chúng tôi không?",
      "author": "DeepSeekAI"
    }
  }
}
