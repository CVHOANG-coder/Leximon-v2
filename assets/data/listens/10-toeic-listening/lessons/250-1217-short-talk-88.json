  "translations": {
    "55068": {
      "id": 2585801,
      "text": "Bạn đang tìm kiếm địa điểm hoàn hảo để tổ chức tiệc sinh nhật của mình?",
      "author": "ChatGPT4.1"
    },
    "55069": {
      "id": 2585802,
      "text": "Bernette's Barn là nơi lý tưởng dành cho bạn!",
      "author": "ChatGPT4.1"
    },
    "55070": {
      "id": 2585803,
      "text": "Chúng tôi cung cấp dịch vụ tiệc buffet, các phần ăn riêng và nhiều gói đồ uống đa dạng,",
      "author": "ChatGPT4.1"
    },
    "55071": {
      "id": 2585804,
      "text": "cũng như các trò chơi tại quầy bar như bi-a, phi tiêu và máy bấm bóng.",
      "author": "ChatGPT4.1"
    },
    "55072": {
      "id": 2585805,
      "text": "Mỗi lần thuê đều bao gồm một phòng riêng,",
      "author": "ChatGPT4.1"
    },
    "55073": {
      "id": 2585806,
      "text": "một bartender riêng và giảm giá ít nhất 10% so với giá thực đơn thông thường.",
      "author": "ChatGPT4.1"
    },
    "55074": {
      "id": 2585807,
      "text": "Chúng tôi có thể phục vụ các bữa tiệc với mọi quy mô, lên đến năm mươi khách.",
      "author": "ChatGPT4.1"
    },
    "55075": {
      "id": 2585808,
      "text": "Ngoài ra, chúng tôi còn có gian DJ để bạn có thể mời DJ riêng,",
      "author": "ChatGPT4.1"
    },
    "55076": {
      "id": 2585809,
      "text": "hoặc thuê DJ của chúng tôi để phát những bài hát yêu thích của bạn.",
      "author": "ChatGPT4.1"
    },
    "55077": {
      "id": 2585810,
      "text": "Hãy truy cập www.bbarn.com để kiểm tra tình trạng còn trống và xem các gói dịch vụ.",
      "author": "ChatGPT4.1"
    }
  }
