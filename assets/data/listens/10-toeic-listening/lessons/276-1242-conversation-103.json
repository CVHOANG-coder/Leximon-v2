  "translations": {
    "55391": {
      "id": 2606423,
      "text": "Chào buổi sáng. Tôi tên là Harvey Rose.",
      "author": "ChatGPT4.1"
    },
    "55392": {
      "id": 2606424,
      "text": "Tôi đã đặt phòng vào ngày 25 tháng 3, nhưng tôi vẫn chưa nhận được email xác nhận.",
      "author": "ChatGPT4.1"
    },
    "55393": {
      "id": 2606425,
      "text": "Xin lỗi về việc đó, ông Rose.",
      "author": "ChatGPT4.1"
    },
    "55394": {
      "id": 2606426,
      "text": "Tôi thấy ông đã đặt một phòng có hướng nhìn ra thành phố trong ba đêm liên tiếp.",
      "author": "ChatGPT4.1"
    },
    "55395": {
      "id": 2606427,
      "text": "Xin chờ một chút.",
      "author": "ChatGPT4.1"
    },
    "55396": {
      "id": 2606428,
      "text": "Được rồi, email xác nhận vừa được gửi đi.",
      "author": "ChatGPT4.1"
    },
    "55397": {
      "id": 2606429,
      "text": "Ông có thể kiểm tra hòm thư của mình ngay bây giờ.",
      "author": "ChatGPT4.1"
    },
    "55398": {
      "id": 2606430,
      "text": "Cảm ơn, nhanh thật đấy.",
      "author": "ChatGPT4.1"
    },
    "55399": {
      "id": 2606431,
      "text": "Nhân tiện, ông có thể giúp tôi đặt dịch vụ xe riêng không?",
      "author": "ChatGPT4.1"
    },
    "55400": {
      "id": 2606432,
      "text": "Thậm chí đi xe ghép cũng được, tôi không phiền đâu.",
      "author": "ChatGPT4.1"
    },
    "55401": {
      "id": 2606433,
      "text": "Thực ra, chúng tôi có cung cấp xe đưa đón miễn phí đến và từ Sân bay Quốc tế Narita.",
      "author": "ChatGPT4.1"
    },
    "55402": {
      "id": 2606434,
      "text": "Xe xuất phát mỗi giờ, hoạt động 24/7.",
      "author": "ChatGPT4.1"
    },
    "55403": {
      "id": 2606435,
      "text": "Tuyệt quá.",
      "author": "ChatGPT4.1"
    },
    "55404": {
      "id": 2606436,
      "text": "Tôi nên đợi xe đưa đón ở đâu?",
      "author": "ChatGPT4.1"
    },
    "55405": {
      "id": 2606437,
      "text": "Sau khi ra khỏi cửa trung tâm, ông hãy sử dụng lối đi bộ qua đường.",
      "author": "ChatGPT4.1"
    },
    "55406": {
      "id": 2606438,
      "text": "Trạm xe buýt nằm đối diện bãi đỗ taxi.",
      "author": "ChatGPT4.1"
    }
  }
}
