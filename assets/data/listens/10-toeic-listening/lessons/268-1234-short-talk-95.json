  "translations": {
    "55295": {
      "id": 969599,
      "text": "Kết quả khảo sát cho thấy người dùng thích chế độ tiết kiệm nhiều nhất.",
      "author": "a user"
    },
    "55292": {
      "id": 2645277,
      "text": "Tôi muốn gửi lời cảm ơn chân thành đến từng người trong số các bạn đã tham gia cuộc họp.",
      "author": "ChatGPT4.1"
    },
    "55293": {
      "id": 2645278,
      "text": "Bây giờ, chúng ta sẽ xem lại phản hồi từ các khảo sát mà khách hàng đã điền cho mẫu lò nướng mới nhất của chúng ta.",
      "author": "ChatGPT4.1"
    },
    "55294": {
      "id": 2645279,
      "text": "Như các bạn đã biết, lò nướng này có một vài tính năng mới mà người tiêu dùng sẽ thấy hữu ích.",
      "author": "ChatGPT4.1"
    },
    "55296": {
      "id": 2645280,
      "text": "Điều này làm cho lò nướng êm hơn, và đó là lý do chính khiến khách hàng yêu thích sản phẩm.",
      "author": "ChatGPT4.1"
    },
    "55297": {
      "id": 2645281,
      "text": "Giờ đây, khi lò nướng có quá nhiều tính năng, sách hướng dẫn trở nên quá nhiều trang.",
      "author": "ChatGPT4.1"
    },
    "55298": {
      "id": 2645282,
      "text": "Bộ phận nội dung của chúng tôi hiện đang làm việc để chỉnh sửa hướng dẫn từ 50 xuống còn 15 trang.",
      "author": "ChatGPT4.1"
    }
  }
