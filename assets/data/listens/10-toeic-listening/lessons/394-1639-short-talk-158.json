  "translations": {
    "68382": {
      "id": 2653263,
      "text": "Bạn có phải là tài xế xe tải vận chuyển hàng hóa có bằng lái hợp lệ không?",
      "author": "ChatGPT4.1"
    },
    "68383": {
      "id": 2653264,
      "text": "Titan Heavy Haulers hiện đang tích cực tìm kiếm các tài xế xe tải có kỹ năng để gia nhập đội ngũ của chúng tôi.",
      "author": "ChatGPT4.1"
    },
    "68384": {
      "id": 2653265,
      "text": "Đúng như tên gọi, chúng tôi chuyên vận chuyển hàng hóa nặng trên toàn khu vực.",
      "author": "ChatGPT4.1"
    },
    "68385": {
      "id": 2653266,
      "text": "Tại Titan, các tài xế được hưởng lịch làm việc linh hoạt.",
      "author": "ChatGPT4.1"
    },
    "68386": {
      "id": 2653267,
      "text": "Thực tế, chúng tôi là công ty duy nhất trong khu vực cho phép nhân viên tự chọn giờ làm việc.",
      "author": "ChatGPT4.1"
    },
    "68387": {
      "id": 2653268,
      "text": "Nếu bạn chưa có kinh nghiệm với hàng hóa nặng, chúng tôi có các cơ hội đào tạo.",
      "author": "ChatGPT4.1"
    },
    "68388": {
      "id": 2653269,
      "text": "Vui lòng truy cập trang web của chúng tôi để biết thêm thông tin về các vị trí tuyển dụng.",
      "author": "ChatGPT4.1"
    },
    "68389": {
      "id": 2653270,
      "text": "Chúng tôi mong được hợp tác cùng bạn!",
      "author": "ChatGPT4.1"
    }
  }
