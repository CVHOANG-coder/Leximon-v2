    "53515": {
      "id": 884864,
      "text": "Trong tháng thứ 5 liên tiếp, lợi nhuận của chúng ta đã giảm.",
      "author": "a user"
    },
    "53518": {
      "id": 884867,
      "text": "Tôi không biết phải nói gì nhưng tôi cũng thất vọng giống bạn.",
      "author": "a user"
    },
    "53519": {
      "id": 884868,
      "text": "Đội ngũ của chúng ta rất tận tâm,",
      "author": "a user"
    },
    "53520": {
      "id": 884869,
      "text": "nhưng vì lý do nào đó, chúng ta chưa thấy được kết quả như mong đợi.",
      "author": "a user"
    },
    "53522": {
      "id": 884871,
      "text": "Tôi sẵn sàng tìm những đại lý bán hàng mới nếu đó là điều cần phải làm.",
      "author": "a user"
    },
    "53524": {
      "id": 884873,
      "text": "Tôi đã nói chuyện với các nguồn tin ở các công ty khác và có vẻ như mọi người đều đang gặp phải vấn đề này.",
      "author": "a user"
    },
    "53512": {
      "id": 2594877,
      "text": "Chào Elizabeth, vui lòng ngồi xuống, cứ tự nhiên như ở nhà nhé.",
