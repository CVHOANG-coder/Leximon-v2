    },
    "70551": {
      "id": 2643781,
      "text": "Vấn đề là gì vậy?",
      "author": "ChatGPT4.1"
    },
    "70552": {
      "id": 2643782,
      "text": "Nó hoàn toàn không bật lên được.",
