  "translations": {
    "66756": {
      "id": 2621548,
      "text": "Chào mừng mọi người, chào buổi sáng.",
      "author": "ChatGPT4.1"
    },
    "66757": {
      "id": 2621549,
      "text": "Tôi muốn cập nhật nhanh về những ưu đãi đặc biệt mà chúng ta đang cung cấp cho khách hàng.",
      "author": "ChatGPT4.1"
    },
    "66758": {
      "id": 2621550,
      "text": "Chúng tôi sẽ cung cấp các buổi huấn luyện cá nhân kéo dài 20 phút",
      "author": "ChatGPT4.1"
    },
    "66759": {
      "id": 2621551,
      "text": "kèm theo một chai nước miễn phí khi thành viên mới đăng ký.",
      "author": "ChatGPT4.1"
    },
    "66760": {
      "id": 2621552,
      "text": "Tôi biết mọi người đều rất xuất sắc trong việc giúp khách hàng giữ dáng.",
      "author": "ChatGPT4.1"
    },
    "66761": {
      "id": 2621553,
      "text": "Bây giờ chúng ta chỉ cần thông báo cho công chúng biết về chương trình khuyến mãi này.",
      "author": "ChatGPT4.1"
    },
    "66762": {
      "id": 2621554,
      "text": "Chúng ta đã trả tiền cho quảng cáo trực tuyến và treo tờ rơi.",
      "author": "ChatGPT4.1"
    },
    "66763": {
      "id": 2621555,
      "text": "Bây giờ, tôi hơi lo lắng rằng chúng ta sẽ hết chai nước!",
      "author": "ChatGPT4.1"
    },
    "66764": {
      "id": 2621556,
      "text": "Có ai có thời gian đi lên phía bắc lấy thêm một vài chai từ các nhà phân phối không?",
      "author": "ChatGPT4.1"
    },
    "66765": {
      "id": 2621557,
      "text": "Làm ơn cho tôi biết nếu bạn có thể sắp xếp thời gian trong ngày của mình,",
      "author": "ChatGPT4.1"
    },
    "66766": {
      "id": 2621558,
      "text": "Tôi sẽ rất cảm kích.",
      "author": "ChatGPT4.1"
    }
  }
