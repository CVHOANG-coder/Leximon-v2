  "translations": {
    "66797": {
      "id": 2638824,
      "text": "Chào buổi chiều, các bạn.",
      "author": "ChatGPT4.1"
    },
    "66798": {
      "id": 2638825,
      "text": "Tôi là Sally Anders từ phòng nhân sự.",
      "author": "ChatGPT4.1"
    },
    "66799": {
      "id": 2638826,
      "text": "Tôi muốn dành một phút để nhắc nhở các bạn về các hội thảo cuối tuần mà chúng ta đang tổ chức.",
      "author": "ChatGPT4.1"
    },
    "66800": {
      "id": 2638827,
      "text": "Mỗi cuối tuần, chúng tôi sẽ tạo cơ hội cho từng nhân viên của mình nâng cao kỹ năng và mở rộng mối quan hệ.",
      "author": "ChatGPT4.1"
    },
    "66801": {
      "id": 2638828,
      "text": "Những hội thảo này là tự nguyện và hoàn toàn miễn phí.",
      "author": "ChatGPT4.1"
    },
    "66802": {
      "id": 2638829,
      "text": "Chúng tôi có ba chủ đề cho quý này,",
      "author": "ChatGPT4.1"
    },
    "66803": {
      "id": 2638830,
      "text": "và buổi đầu tiên sẽ nói về Trải nghiệm người dùng, do Brittany East dẫn dắt.",
      "author": "ChatGPT4.1"
    },
    "66804": {
      "id": 2638831,
      "text": "Tôi rất tiếc phải thông báo rằng Joe Edwards không thể tham dự được,",
      "author": "ChatGPT4.1"
    },
    "66805": {
      "id": 2638832,
      "text": "vì vậy chúng ta sẽ có một diễn giả khách mời trong tháng 10 để hướng dẫn về Tiếp thị cho các thế hệ.",
      "author": "ChatGPT4.1"
    },
    "66806": {
      "id": 2638833,
      "text": "Vui lòng mang theo bất kỳ câu hỏi nào và thái độ ham học hỏi khi tham dự nhé!",
      "author": "ChatGPT4.1"
    },
    "66807": {
      "id": 2638834,
      "text": "Bạn có thể đăng ký trên trang web của công ty.",
      "author": "ChatGPT4.1"
    }
  }
