  "translations": {
    "66767": {
      "id": 2621967,
      "text": "Bạn có yêu thích việc sưu tập thẻ bóng chày không?",
      "author": "ChatGPT4.1"
    },
    "66768": {
      "id": 2621968,
      "text": "Hãy đến ngay một trong ba địa điểm của Baseball Barn",
      "author": "ChatGPT4.1"
    },
    "66769": {
      "id": 2621969,
      "text": "để tham gia sự kiện gặp gỡ và trao đổi được tổ chức hai lần mỗi năm vào thứ Bảy.",
      "author": "ChatGPT4.1"
    },
    "66770": {
      "id": 2621970,
      "text": "Chọn lựa của bạn từ bộ sưu tập lớn các thẻ bóng chày, áo thi đấu, găng tay và gậy đánh bóng,",
      "author": "ChatGPT4.1"
    },
    "66771": {
      "id": 2621971,
      "text": "tất cả sẽ được giảm giá ít nhất 10%.",
      "author": "ChatGPT4.1"
    },
    "66772": {
      "id": 2621972,
      "text": "Được sưu tập từ năm 1950 cho đến nay,",
      "author": "ChatGPT4.1"
    },
    "66773": {
      "id": 2621973,
      "text": "chúng tôi có thứ gì đó dành cho mọi người đam mê bóng chày.",
      "author": "ChatGPT4.1"
    },
    "66774": {
      "id": 2621974,
      "text": "Nếu bạn quan tâm đến việc xem bộ sưu tập trước sự kiện, hoặc muốn đăng ký,",
      "author": "ChatGPT4.1"
    },
    "66775": {
      "id": 2621975,
      "text": "hãy truy cập www.baseballbarn.com.",
      "author": "ChatGPT4.1"
    }
  }
