      "id": 2673274,
      "text": "Tất nhiên rồi!",
      "author": "ChatGPT4.1"
    },
    "68797": {
      "id": 2673275,
      "text": "Nhưng họ đang thi công trên Đại lộ Maple ngay bây giờ.",
      "author": "ChatGPT4.1"
    },
    "68798": {
      "id": 2673276,
      "text": "Tôi đã thấy nó khi lái xe trước đó.",
      "author": "ChatGPT4.1"
    },
    "68799": {
      "id": 2673277,
      "text": "Vì vậy có thể sẽ mất nhiều thời gian hơn để đến đó.",
      "author": "ChatGPT4.1"
    },
    "68800": {
      "id": 2673278,
      "text": "Ôi không!",
      "author": "ChatGPT4.1"
    },
    "68801": {
      "id": 2673279,
      "text": "Tôi có vé xem phim lúc 8 giờ và tôi thực sự không thể bỏ lỡ nó.",
      "author": "ChatGPT4.1"
    },
    "68802": {
      "id": 2673280,
      "text": "Nếu đến trễ thì họ không cho vào đâu.",
      "author": "ChatGPT4.1"
    },
    "68803": {
      "id": 2673281,
      "text": "Đừng lo lắng.",
      "author": "ChatGPT4.1"
    },
    "68804": {
