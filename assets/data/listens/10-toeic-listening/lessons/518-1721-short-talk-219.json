  "translations": {
    "69251": {
      "id": 2589203,
      "text": "Chào mừng tất cả các bạn đến với chuyến tham quan Bảo tàng Nghệ thuật Riverview của chúng tôi.",
      "author": "ChatGPT4.1"
    },
    "69252": {
      "id": 2589204,
      "text": "Trước khi bắt đầu, tôi muốn nói về sự chậm trễ ngoài dự kiến.",
      "author": "ChatGPT4.1"
    },
    "69253": {
      "id": 2589205,
      "text": "Chúng tôi đã gặp một sự cố kỹ thuật nhỏ với các thiết bị hướng dẫn âm thanh,",
      "author": "ChatGPT4.1"
    },
    "69254": {
      "id": 2589206,
      "text": "nhưng bây giờ mọi thứ đã được khắc phục và sẵn sàng sử dụng.",
      "author": "ChatGPT4.1"
    },
    "69255": {
      "id": 2589207,
      "text": "Vui lòng xem bản đồ được đính kèm trong tập chào mừng khi tôi giải thích lộ trình hôm nay.",
      "author": "ChatGPT4.1"
    },
    "69256": {
      "id": 2589208,
      "text": "Chúng ta sẽ bắt đầu từ sảnh chính tại đây,",
      "author": "ChatGPT4.1"
    },
    "69257": {
      "id": 2589209,
      "text": "sau đó di chuyển đến khu nghệ thuật đương đại,",
      "author": "ChatGPT4.1"
    },
    "69258": {
      "id": 2589210,
      "text": "và sau đó tham quan khu vườn điêu khắc cũng như triển lãm tranh ấn tượng.",
      "author": "ChatGPT4.1"
    },
    "69259": {
      "id": 2589211,
      "text": "Do thời gian hạn chế, chúng ta sẽ phải bỏ qua một trong những phòng trưng bày còn lại,",
      "author": "ChatGPT4.1"
    },
    "69260": {
      "id": 2589212,
      "text": "nên chúng ta sẽ quay lại sảnh chính theo lối đi nhanh nhất.",
      "author": "ChatGPT4.1"
    },
    "69261": {
      "id": 2589213,
      "text": "Như một lời cảm ơn vì sự thông cảm của các bạn,",
      "author": "ChatGPT4.1"
    },
    "69262": {
      "id": 2589214,
      "text": "mỗi người sẽ nhận được một phiếu đồ uống miễn phí tại quán cà phê của bảo tàng.",
      "author": "ChatGPT4.1"
    },
    "69263": {
      "id": 2589215,
      "text": "Hãy bắt đầu hành trình nghệ thuật của chúng ta thôi!",
      "author": "ChatGPT4.1"
    }
  }
}
