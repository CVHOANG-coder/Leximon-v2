  "translations": {
    "66969": {
      "id": 2641835,
      "text": "Chào buổi chiều, các đồng nghiệp!",
      "author": "ChatGPT4.1"
    },
    "66970": {
      "id": 2641836,
      "text": "Tôi cảm ơn mọi người đã dành thời gian đến tham dự bữa tiệc này,",
      "author": "ChatGPT4.1"
    },
    "66971": {
      "id": 2641837,
      "text": "để chúc mừng William Geard được thăng chức lên Trưởng nhóm Thiết kế của đội ngũ kỹ thuật số.",
      "author": "ChatGPT4.1"
    },
    "66972": {
      "id": 2641838,
      "text": "Will đã làm việc cho công ty trong mười năm,",
      "author": "ChatGPT4.1"
    },
    "66973": {
      "id": 2641839,
      "text": "bắt đầu với vai trò nhà thiết kế tập sự trước khi thăng tiến lên vị trí trưởng nhóm thiết kế.",
      "author": "ChatGPT4.1"
    },
    "66974": {
      "id": 2641840,
      "text": "Bây giờ, anh ấy sẽ phụ trách việc quyết định các thiết kế quan trọng cho công ty,",
      "author": "ChatGPT4.1"
    },
    "66975": {
      "id": 2641841,
      "text": "cũng như hướng dẫn các nhà thiết kế trẻ hơn.",
      "author": "ChatGPT4.1"
    },
    "66976": {
      "id": 2641842,
      "text": "Tôi muốn dành một chút thời gian để vỗ tay chúc mừng Will",
      "author": "ChatGPT4.1"
    },
    "66977": {
      "id": 2641843,
      "text": "cảm ơn anh ấy vì những năm tháng cống hiến,",
      "author": "ChatGPT4.1"
    },
    "66978": {
      "id": 2641844,
      "text": "và trao tặng anh ấy tấm bảng vinh danh cho sự thăng chức này.",
      "author": "ChatGPT4.1"
    },
    "66979": {
      "id": 2641845,
      "text": "William, xin mời anh lên sân khấu để chụp ảnh và phát biểu vài lời.",
      "author": "ChatGPT4.1"
    }
  }
