  "translations": {
    "53999": {
      "id": 888262,
      "text": "Là người làm kinh doanh, bạn sẽ sử dụng những chiếc điện thoại này suốt cả ngày để liên lạc với khách hàng và đồng nghiệp.",
      "author": "a user"
    },
    "54001": {
      "id": 888264,
      "text": "nhưng nếu bạn tập trung chú ý,",
      "author": "a user"
    },
    "54005": {
      "id": 888269,
      "text": "Sau đó, bạn sẽ có thể ghi âm tin nhắn mà người gọi sẽ nghe thấy nếu bạn rời khỏi bàn làm việc.",
      "author": "a user"
    },
    "54006": {
      "id": 888352,
      "text": "Tin nhắn không nên dài hơn 30 giây.",
      "author": "a user"
    },
    "54007": {
      "id": 888421,
      "text": "Chúng ta hãy bắt đầu ngay bây giờ nhé, mọi người?",
      "author": "a user"
    },
    "54000": {
      "id": 907241,
      "text": "Hệ thống mới có thể khó hiểu,",
      "author": "a user"
    },
    "53997": {
      "id": 2588452,
      "text": "Chào buổi chiều.",
      "author": "ChatGPT4.1"
    },
    "53998": {
      "id": 2588453,
      "text": "Hôm nay là ngày cuối cùng huấn luyện về hệ thống điện thoại mới trong văn phòng.",
      "author": "ChatGPT4.1"
    },
    "54002": {
      "id": 2588454,
      "text": "bạn sẽ không gặp bất kỳ vấn đề nào.",
      "author": "ChatGPT4.1"
    },
    "54003": {
      "id": 2588455,
      "text": "Hôm nay, chúng ta sẽ học cách ghi âm tin nhắn hộp thư thoại,",
      "author": "ChatGPT4.1"
    },
    "54004": {
      "id": 2588456,
      "text": "vì vậy để bắt đầu, chúng ta sẽ xem một bài thuyết trình dài 5 phút.",
      "author": "ChatGPT4.1"
    }
  }
