    "69455": {
      "id": 2590251,
      "text": "Tôi muốn thông báo cho các bạn rằng sẽ có người từ Cục Tuân thủ Liên bang đến thăm cơ sở của chúng ta vào thứ Năm tới, ngày 20.",
      "author": "ChatGPT4.1"
    },
    "69456": {
      "id": 2590252,
      "text": "Xin hãy lưu ý một vài điều sau.",
      "author": "ChatGPT4.1"
    },
    "69457": {
      "id": 2590253,
      "text": "Đầu tiên, vị khách sẽ kiểm tra tất cả các khu vực,",
      "author": "ChatGPT4.1"
    },
    "69458": {
      "id": 2590254,
      "text": "nên hãy đảm bảo tất cả giấy tờ đều cập nhật và dễ tìm.",
      "author": "ChatGPT4.1"
    },
    "69459": {
      "id": 2590255,
      "text": "Sau thông báo này, tôi sẽ phát các checklist để các bạn điền vào.",
      "author": "ChatGPT4.1"
    },
    "69460": {
      "id": 2590256,
      "text": "Vui lòng nộp lại cho trưởng nhóm của bạn trước cuối ngày.",
      "author": "ChatGPT4.1"
    },
    "69461": {
      "id": 2590257,
      "text": "Ngoài ra, sẽ có một cuộc họp ngắn lúc 2 giờ chiều dành cho tất cả trưởng nhóm.",
      "author": "ChatGPT4.1"
    },
    "69462": {
      "id": 2590258,
      "text": "Vì phòng họp thường dùng đang được sửa chữa, chúng ta sẽ họp ở phòng nghỉ.",
      "author": "ChatGPT4.1"
    },
    "69463": {
      "id": 2590259,
      "text": "Trong cuộc họp này, chúng ta sẽ thảo luận về kế hoạch cho ngày đón tiếp.",
