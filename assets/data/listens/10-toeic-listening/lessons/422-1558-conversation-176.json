  "translations": {
    "66409": {
      "id": 2599892,
      "text": "Chào mừng bạn đến với Green's Market.",
      "author": "ChatGPT4.1"
    },
    "66410": {
      "id": 2599893,
      "text": "Tôi có thể giúp bạn tìm gì không?",
      "author": "ChatGPT4.1"
    },
    "66411": {
      "id": 2599894,
      "text": "Tôi đến đây để nhận đơn hàng đã đặt trước.",
      "author": "ChatGPT4.1"
    },
    "66412": {
      "id": 2599895,
      "text": "Tên tôi là Hope Dunson.",
      "author": "ChatGPT4.1"
    },
    "66413": {
      "id": 2599896,
      "text": "Không vấn đề gì, tôi rất sẵn lòng giúp bạn.",
      "author": "ChatGPT4.1"
    },
    "66414": {
      "id": 2599897,
      "text": "Tất cả các đơn hàng được đặt ở phía sau cửa hàng, gần quầy thịt.",
      "author": "ChatGPT4.1"
    },
    "66415": {
      "id": 2599898,
      "text": "Thật ra sáng nay tôi bị chấn thương ở cổ tay,",
      "author": "ChatGPT4.1"
    },
    "66416": {
      "id": 2599899,
      "text": "và tôi hy vọng tôi có thể đổi sang giao hàng tận nơi.",
      "author": "ChatGPT4.1"
    },
    "66417": {
      "id": 2599900,
      "text": "Tôi sống ở tầng sáu, và tôi bị đau nên không thể mang đồ được.",
      "author": "ChatGPT4.1"
    },
    "66418": {
      "id": 2599901,
      "text": "Chắc chắn rồi, tôi có thể sắp xếp giao hàng, cô Dunson.",
      "author": "ChatGPT4.1"
    },
    "66419": {
      "id": 2599902,
      "text": "Chúng tôi đã có địa chỉ của cô trong hồ sơ, và chúng tôi sẽ giao hàng cho cô vào chiều nay.",
      "author": "ChatGPT4.1"
    },
    "66420": {
      "id": 2599903,
      "text": "Thật tuyệt vời.",
      "author": "ChatGPT4.1"
    },
    "66421": {
      "id": 2599904,
      "text": "Thật ra tôi vừa đi nghỉ mát về,",
      "author": "ChatGPT4.1"
    },
    "66422": {
      "id": 2599905,
      "text": "nên nhà tôi không còn gì để ăn, càng sớm càng tốt.",
      "author": "ChatGPT4.1"
    },
    "66423": {
      "id": 2599906,
      "text": "Được rồi, tôi sẽ để người giao hàng ghé nhà cô đầu tiên!",
      "author": "ChatGPT4.1"
    }
  }
}
