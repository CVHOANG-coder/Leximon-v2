  "translations": {
    "68885": {
      "id": 2673502,
      "text": "Xin chào, tôi là Hannah từ Công ty Du lịch Dream.",
      "author": "ChatGPT4.1"
    },
    "68886": {
      "id": 2673503,
      "text": "Tôi gọi để xác nhận chuyến đi sắp tới của bạn đến Paris, dự kiến vào ngày 15 tháng 11.",
      "author": "ChatGPT4.1"
    },
    "68887": {
      "id": 2673504,
      "text": "Chúng tôi đã hoàn tất tất cả các sắp xếp cho bạn, bao gồm vé máy bay khứ hồi,",
      "author": "ChatGPT4.1"
    },
    "68888": {
      "id": 2673505,
      "text": "chỗ ở khách sạn tại Grand Palais,",
      "author": "ChatGPT4.1"
    },
    "68889": {
      "id": 2673506,
      "text": "và một chuyến tham quan trong ngày đến Louvre và Tháp Eiffel.",
      "author": "ChatGPT4.1"
    },
    "68890": {
      "id": 2673507,
      "text": "Tôi sẽ gửi lịch trình chuyến đi cho bạn qua email trước sáng mai,",
      "author": "ChatGPT4.1"
    },
    "68891": {
      "id": 2673508,
      "text": "và nếu bạn có bất kỳ câu hỏi hoặc yêu cầu đặc biệt nào, hãy thoải mái liên hệ với chúng tôi.",
      "author": "ChatGPT4.1"
    },
    "68892": {
      "id": 2673509,
      "text": "Bạn cũng có thể tải ứng dụng của chúng tôi để theo dõi chuyến bay và đặt phòng của mình.",
      "author": "ChatGPT4.1"
    },
    "68893": {
      "id": 2673510,
      "text": "Cảm ơn bạn một lần nữa vì đã chọn Dream Travel,",
      "author": "ChatGPT4.1"
    },
    "68894": {
      "id": 2673511,
      "text": "và chúng tôi hy vọng bạn sẽ có một khoảng thời gian tuyệt vời tại Paris!",
      "author": "ChatGPT4.1"
    }
  }
