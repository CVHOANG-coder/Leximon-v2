  "translations": {
    "68662": {
      "id": 2582315,
      "text": "Chào mọi người!",
      "author": "ChatGPT4.1"
    },
    "68663": {
      "id": 2582316,
      "text": "Chào mừng các bạn đến với khóa học Nhập môn Nhiếp ảnh.",
      "author": "ChatGPT4.1"
    },
    "68664": {
      "id": 2582317,
      "text": "Trong vài tuần tới, chúng ta sẽ tìm hiểu những kiến thức cơ bản về cách sử dụng máy ảnh,",
      "author": "ChatGPT4.1"
    },
    "68665": {
      "id": 2582318,
      "text": "hiểu về ánh sáng, và cách bố cục những bức ảnh đẹp.",
      "author": "ChatGPT4.1"
    },
    "68666": {
      "id": 2582319,
      "text": "Hôm nay, chúng ta sẽ bắt đầu với những điều cơ bản nhất:",
      "author": "ChatGPT4.1"
    },
    "68667": {
      "id": 2582320,
      "text": "cài đặt máy ảnh, ống kính, và cách chụp ở chế độ chỉnh tay.",
      "author": "ChatGPT4.1"
    },
    "68668": {
      "id": 2582321,
      "text": "Cuối buổi, chúng ta sẽ có hoạt động thực hành để các bạn luyện tập với chính máy ảnh của mình.",
      "author": "ChatGPT4.1"
    },
    "68669": {
      "id": 2582322,
      "text": "Nếu có thắc mắc trong quá trình học, các bạn cứ tự nhiên giơ tay nhé.",
      "author": "ChatGPT4.1"
    },
    "68670": {
      "id": 2582323,
      "text": "Hãy cùng vui vẻ và sáng tạo nào!",
      "author": "ChatGPT4.1"
    }
  }
