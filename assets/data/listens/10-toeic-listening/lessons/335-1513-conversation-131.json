  "translations": {
    "65721": {
      "id": 2640288,
      "text": "Bạn đã nhận được email từ giám đốc của chúng ta chưa?",
      "author": "ChatGPT4.1"
    },
    "65722": {
      "id": 2640289,
      "text": "Bà ấy muốn tổ chức một cuộc thi toàn công ty để đưa ra ý tưởng cho việc ra mắt sản phẩm.",
      "author": "ChatGPT4.1"
    },
    "65723": {
      "id": 2640290,
      "text": "Tôi đã xem lướt qua nó rồi.",
      "author": "ChatGPT4.1"
    },
    "65724": {
      "id": 2640291,
      "text": "Tôi không thể tin được là phòng marketing đã làm hỏng việc",
      "author": "ChatGPT4.1"
    },
    "65725": {
      "id": 2640292,
      "text": "và không thể tạo ra một chiến dịch thành công để thu hút khách hàng.",
      "author": "ChatGPT4.1"
    },
    "65726": {
      "id": 2640293,
      "text": "Thành thật mà nói, tôi nghĩ mình sẽ không tham gia cuộc thi này.",
      "author": "ChatGPT4.1"
    },
    "65727": {
      "id": 2640294,
      "text": "Tôi sắp hết thời gian để hoàn thành báo cáo ngân sách này rồi.",
      "author": "ChatGPT4.1"
    },
    "65728": {
      "id": 2640295,
      "text": "Ôi, thật là chán quá!",
      "author": "ChatGPT4.1"
    },
    "65729": {
      "id": 2640296,
      "text": "Bạn lúc nào cũng có những ý tưởng độc đáo nhất.",
      "author": "ChatGPT4.1"
    },
    "65730": {
      "id": 2640297,
      "text": "Có lẽ cũng đáng để ở lại muộn hoàn thành báo cáo,",
      "author": "ChatGPT4.1"
    },
    "65731": {
      "id": 2640298,
      "text": "vì người chiến thắng cuộc thi sẽ được một chuyến đi trọn gói đến Mexico!",
      "author": "ChatGPT4.1"
    }
  }
