  "translations": {
    "54496": {
      "id": 2611247,
      "text": "Chào buổi chiều, đây là Khloe Ellen từ bản tin sáng của Kênh Mười.",
      "author": "ChatGPT4.1"
    },
    "54497": {
      "id": 2611248,
      "text": "Tại cuộc họp báo hàng tuần, Hội đồng thành phố Wilton tiết lộ họ đang lên kế hoạch xây dựng các làn đường xe buýt mới trên khắp thành phố",
      "author": "ChatGPT4.1"
    },
    "54498": {
      "id": 2611249,
      "text": "để giải quyết những vấn đề giao thông nghiêm trọng.",
      "author": "ChatGPT4.1"
    },
    "54499": {
      "id": 2611250,
      "text": "Dự án dự kiến sẽ kéo dài sáu tháng và sẽ bắt đầu vào đầu tháng Mười.",
      "author": "ChatGPT4.1"
    },
    "54500": {
      "id": 2611251,
      "text": "Thị trưởng Wilton, ông Greg Micheals, cho biết các làn xe buýt sẽ giảm ùn tắc và khuyến khích sử dụng phương tiện công cộng.",
      "author": "ChatGPT4.1"
    },
    "54501": {
      "id": 2611252,
      "text": "Nhiều người dân đã lên tiếng phản đối việc xây dựng các làn đường này,",
      "author": "ChatGPT4.1"
    },
    "54502": {
      "id": 2611253,
      "text": "cho rằng lợi ích sẽ không xứng đáng với sự bất tiện trong quá trình xây dựng.",
      "author": "ChatGPT4.1"
    },
    "54503": {
      "id": 2611254,
      "text": "Hãy tiếp tục theo dõi, bản tin thời tiết sẽ được cập nhật ngay sau đây.",
      "author": "ChatGPT4.1"
    }
  }
