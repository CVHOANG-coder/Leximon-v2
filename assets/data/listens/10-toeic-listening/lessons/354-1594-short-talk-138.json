  "translations": {
    "66890": {
      "id": 2604899,
      "text": "Chào buổi chiều, các giáo viên Trường Tiểu học Hillbrook.",
      "author": "ChatGPT4.1"
    },
    "66891": {
      "id": 2604900,
      "text": "Hôm nay là một ngày rất đặc biệt đối với các học sinh của chúng ta,",
      "author": "ChatGPT4.1"
    },
    "66892": {
      "id": 2604901,
      "text": "vì chúng ta có Ngày Hội Thể Thao ngoài trời.",
      "author": "ChatGPT4.1"
    },
    "66893": {
      "id": 2604902,
      "text": "Chúng tôi sẽ gửi cho các bạn lịch trình qua email được sắp xếp bởi thầy giáo thể dục, thầy Decker.",
      "author": "ChatGPT4.1"
    },
    "66894": {
      "id": 2604903,
      "text": "Những hoạt động này dành cho tất cả học sinh chưa bị kỷ luật trong học kỳ này.",
      "author": "ChatGPT4.1"
    },
    "66895": {
      "id": 2604904,
      "text": "Tôi muốn cảm ơn thầy Decker",
      "author": "ChatGPT4.1"
    },
    "66896": {
      "id": 2604905,
      "text": "người đã rất cẩn thận trong việc lên lịch trình,",
      "author": "ChatGPT4.1"
    },
    "66897": {
      "id": 2604906,
      "text": "vì thầy đã lắng nghe ý kiến từ các học sinh hiện tại và trước đây",
      "author": "ChatGPT4.1"
    },
    "66898": {
      "id": 2604907,
      "text": "để đưa vào những trò chơi được các em yêu thích nhất.",
      "author": "ChatGPT4.1"
    },
    "66899": {
      "id": 2604908,
      "text": "Hiệu trưởng sẽ phát biểu ngắn với học sinh vào đầu hoạt động thứ hai,",
      "author": "ChatGPT4.1"
    },
    "66900": {
      "id": 2604909,
      "text": "nhằm động viên các em tiếp tục cư xử tốt và vui chơi thoải mái.",
      "author": "ChatGPT4.1"
    }
  }
