  "translations": {
    "54288": {
      "id": 2603931,
      "text": "Chào buổi chiều, các bạn.",
      "author": "ChatGPT4.1"
    },
    "54289": {
      "id": 2603932,
      "text": "Tên tôi là Bill Brooks.",
      "author": "ChatGPT4.1"
    },
    "54290": {
      "id": 2603933,
      "text": "Hôm nay tôi sẽ giúp các bạn học cách sử dụng phần mềm văn phòng của chúng ta và làm việc với khả năng tốt nhất.",
      "author": "ChatGPT4.1"
    },
    "54291": {
      "id": 2603934,
      "text": "Trong ngày đầu tiên, các bạn sẽ được chia thành nhóm ba người.",
      "author": "ChatGPT4.1"
    },
    "54292": {
      "id": 2603935,
      "text": "Mỗi nhóm sẽ có một trợ lý đào tạo chuyên về quy trình làm việc và phần mềm văn phòng.",
      "author": "ChatGPT4.1"
    },
    "54293": {
      "id": 2603936,
      "text": "Hãy xem tấm áp phích cạnh cửa để tìm nhóm của mình và điểm danh.",
      "author": "ChatGPT4.1"
    },
    "54294": {
      "id": 2603937,
      "text": "Việc này sẽ mất vài phút vì có rất nhiều người trong các bạn.",
      "author": "ChatGPT4.1"
    },
    "54295": {
      "id": 2603938,
      "text": "Ngoài ra, nếu bạn chưa nộp bản sao thẻ công tác của mình,",
      "author": "ChatGPT4.1"
    },
    "54296": {
      "id": 2603939,
      "text": "vui lòng sao chụp thẻ và nộp cho thư ký càng sớm càng tốt.",
      "author": "ChatGPT4.1"
    },
    "54297": {
      "id": 2603940,
      "text": "Máy photocopy nằm ở phòng 211.",
      "author": "ChatGPT4.1"
    }
  }
