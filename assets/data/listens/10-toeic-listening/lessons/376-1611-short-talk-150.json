  "translations": {
    "67138": {
      "id": 2506091,
      "text": "Bạn đã liên hệ đến đường dây thông tin của văn phòng Maplewood Apartments.",
      "author": "ChatGPT4.1"
    },
    "67139": {
      "id": 2506092,
      "text": "Vào thứ Tư, ngày 17 tháng 5,",
      "author": "ChatGPT4.1"
    },
    "67140": {
      "id": 2506093,
      "text": "chúng tôi sẽ bắt đầu lát lại khu vực đậu xe bên cạnh lối vào chính của tòa nhà.",
      "author": "ChatGPT4.1"
    },
    "67141": {
      "id": 2506094,
      "text": "Tất cả cư dân Maplewood cần di chuyển xe khỏi chỗ đậu được chỉ định trước 7 giờ sáng thứ Tư.",
      "author": "ChatGPT4.1"
    },
    "67142": {
      "id": 2506095,
      "text": "Bất kỳ xe nào vẫn còn ở chỗ sau 7 giờ sáng sẽ bị kéo đi với chi phí do chủ xe chịu.",
      "author": "ChatGPT4.1"
    },
    "67143": {
      "id": 2506096,
      "text": "Bản đồ các lựa chọn chỗ đậu xe khác đã được gửi cho cư dân vào tuần trước và cũng được dán tại sảnh tòa nhà.",
      "author": "ChatGPT4.1"
    }
  }
