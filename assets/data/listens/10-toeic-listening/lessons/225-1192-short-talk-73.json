  "translations": {
    "54785": {
      "id": 945883,
      "text": "Chúng tôi sẽ phân phát đồ uống và đồ ăn nhẹ miễn phí vì rắc rối bạn đã gặp phải.",
      "author": "a user"
    },
    "54780": {
      "id": 2625236,
      "text": "Xin chú ý, quý bà và quý ông!",
      "author": "ChatGPT4.1"
    },
    "54781": {
      "id": 2625237,
      "text": "Thật không may, chuyến bay thẳng của WestJet từ Montreal đến Vancouver đã bị hoãn.",
      "author": "ChatGPT4.1"
    },
    "54782": {
      "id": 2625238,
      "text": "Chúng tôi xin lỗi về sự chậm trễ và những bất tiện điều này có thể đã gây ra cho quý vị.",
      "author": "ChatGPT4.1"
    },
    "54783": {
      "id": 2625239,
      "text": "Nếu quý vị đến quầy thông tin gần Cổng 14 và nói chuyện với nhân viên của WestJet,",
      "author": "ChatGPT4.1"
    },
    "54784": {
      "id": 2625240,
      "text": "chúng tôi sẽ cố gắng hết sức để sắp xếp một chuyến bay mới đến điểm đến cuối cùng của quý vị.",
      "author": "ChatGPT4.1"
    },
    "54786": {
      "id": 2625241,
      "text": "Xin cảm ơn sự thông cảm và kiên nhẫn của quý vị.",
      "author": "ChatGPT4.1"
    },
    "54787": {
      "id": 2625242,
      "text": "Xin cảm ơn quý vị đã bay cùng WestJet Airlines.",
      "author": "ChatGPT4.1"
    }
  }
