  "translations": {
    "68501": {
      "id": 2604412,
      "text": "Chào mọi người, cuối tuần này chúng ta sẽ nâng cấp mạng lưới.",
      "author": "ChatGPT4.1"
    },
    "68502": {
      "id": 2604413,
      "text": "Đây không chỉ là kiểm tra bảo trì bình thường, lần này sẽ phức tạp hơn một chút.",
      "author": "ChatGPT4.1"
    },
    "68503": {
      "id": 2604414,
      "text": "Chúng tôi làm điều này để đảm bảo mọi thứ hoạt động trơn tru và nhanh hơn cho mọi người.",
      "author": "ChatGPT4.1"
    },
    "68504": {
      "id": 2604415,
      "text": "Vì vậy, tất cả chúng ta cần chuẩn bị tốt phần việc của mình.",
      "author": "ChatGPT4.1"
    },
    "68505": {
      "id": 2604416,
      "text": "Trước khi kết thúc vào thứ Sáu, chúng ta cần sao lưu các tệp và ngắt kết nối khỏi mạng lưới.",
      "author": "ChatGPT4.1"
    },
    "68506": {
      "id": 2604417,
      "text": "Bằng cách đó, việc nâng cấp sẽ diễn ra suôn sẻ.",
      "author": "ChatGPT4.1"
    },
    "68507": {
      "id": 2604418,
      "text": "Kevin Brown sẽ giải thích những việc chúng ta cần làm khi quay lại vào thứ Hai.",
      "author": "ChatGPT4.1"
    }
  }
