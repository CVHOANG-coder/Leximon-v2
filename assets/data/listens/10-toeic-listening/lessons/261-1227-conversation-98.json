  "translations": {
    "55197": {
      "id": 2616810,
      "text": "Chào Gary. Tôi có một thông báo thú vị.",
      "author": "ChatGPT4.1"
    },
    "55198": {
      "id": 2616811,
      "text": "Doanh nghiệp đã đạt được thỏa thuận tiếp quản The Builder's Architect,",
      "author": "ChatGPT4.1"
    },
    "55199": {
      "id": 2616812,
      "text": "một công ty kiến trúc khác tại Manchester.",
      "author": "ChatGPT4.1"
    },
    "55200": {
      "id": 2616813,
      "text": "Ồ, thật ấn tượng!",
      "author": "ChatGPT4.1"
    },
    "55201": {
      "id": 2616814,
      "text": "Tôi không biết rằng có một thương vụ sáp nhập đang diễn ra.",
      "author": "ChatGPT4.1"
    },
    "55202": {
      "id": 2616815,
      "text": "Thỏa thuận sẽ được hoàn tất khi nào?",
      "author": "ChatGPT4.1"
    },
    "55203": {
      "id": 2616816,
      "text": "Nó sẽ hoàn tất vào ngày 4 tháng 12.",
      "author": "ChatGPT4.1"
    },
    "55204": {
      "id": 2616817,
      "text": "Được rồi, tuyệt lắm.",
      "author": "ChatGPT4.1"
    },
    "55205": {
      "id": 2616818,
      "text": "Còn hơn một tháng nữa thôi.",
      "author": "ChatGPT4.1"
    },
    "55206": {
      "id": 2616819,
      "text": "Liệu các nhân viên từ The Builder's Architect sẽ tham gia bảng lương của chúng ta sau khi mua lại không?",
      "author": "ChatGPT4.1"
    },
    "55207": {
      "id": 2616820,
      "text": "Chúng tôi sẽ giữ lại các nhân viên tạm thời và đánh giá để quyết định có sa thải họ hay không.",
      "author": "ChatGPT4.1"
    },
    "55208": {
      "id": 2616821,
      "text": "À, được rồi.",
      "author": "ChatGPT4.1"
    },
    "55209": {
      "id": 2616822,
      "text": "Tôi nên thông báo cho các nhân viên của mình.",
      "author": "ChatGPT4.1"
    },
    "55210": {
      "id": 2616823,
      "text": "Vâng, nếu bạn có thể thông báo cho họ càng sớm càng tốt thì tuyệt lắm.",
      "author": "ChatGPT4.1"
    },
    "55211": {
      "id": 2616824,
      "text": "Tôi sẽ phát biểu tại một cuộc họp báo vào chiều nay.",
      "author": "ChatGPT4.1"
    },
    "55212": {
      "id": 2616825,
      "text": "Không vấn đề gì, tôi sẽ thông báo cho họ ngay bây giờ.",
      "author": "ChatGPT4.1"
    }
  }
