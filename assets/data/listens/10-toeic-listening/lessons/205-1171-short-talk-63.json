  "translations": {
    "54486": {
      "id": 2610987,
      "text": "Bạn có đang tìm kiếm để lên kế hoạch cho một chuyến đi với một công ty du lịch chuyên nghiệp không?",
      "author": "ChatGPT4.1"
    },
    "54487": {
      "id": 2610988,
      "text": "Hãy đặt chuyến đi hôm nay với Công ty Du lịch TravelBox, tọa lạc tại trung tâm Charleston.",
      "author": "ChatGPT4.1"
    },
    "54488": {
      "id": 2610989,
      "text": "Travelbox đã hoạt động kinh doanh được mười lăm năm,",
      "author": "ChatGPT4.1"
    },
    "54489": {
      "id": 2610990,
      "text": "và đã lên kế hoạch cho khách hàng đến những điểm đến tuyệt vời trên khắp thế giới.",
      "author": "ChatGPT4.1"
    },
    "54490": {
      "id": 2610991,
      "text": "Mặc dù chúng tôi có thể giúp bạn lên kế hoạch cho chuyến đi đến bất cứ đâu, chúng tôi chuyên về các chuyến đi đến Brazil.",
      "author": "ChatGPT4.1"
    },
    "54491": {
      "id": 2610992,
      "text": "Hiện tại, chúng tôi đang có chương trình khuyến mãi cho tour du lịch chín ngày đến Rio de Janeiro, Sao Paulo và Angros dos Reis.",
      "author": "ChatGPT4.1"
    },
    "54492": {
      "id": 2610993,
      "text": "Chuyến đi bao gồm tất cả các tour tham quan, bữa ăn và khách sạn.",
      "author": "ChatGPT4.1"
    },
    "54493": {
      "id": 2610994,
      "text": "Hoặc, nếu bạn muốn lên kế hoạch cho chuyến đi tới Châu Âu hoặc Châu Á, xin vui lòng liên hệ với chúng tôi.",
      "author": "ChatGPT4.1"
    },
    "54494": {
      "id": 2610995,
      "text": "Chúng tôi có thể giúp với bất kỳ loại chuyến đi nào, lớn hay nhỏ!",
      "author": "ChatGPT4.1"
    },
    "54495": {
      "id": 2610996,
      "text": "Gọi cho chúng tôi theo số 5551232, hoặc ghé thăm trang Facebook của chúng tôi.",
      "author": "ChatGPT4.1"
    }
  }
