  "translations": {
    "69416": {
      "id": 2600865,
      "text": "Bạn đang muốn nâng cao chế độ tập luyện thể dục của mình?",
      "author": "ChatGPT4.1"
    },
    "69417": {
      "id": 2600866,
      "text": "Khám phá BoostAid,",
      "author": "ChatGPT4.1"
    },
    "69418": {
      "id": 2600867,
      "text": "giải pháp bổ sung nước giàu dưỡng chất mang tính cách mạng từ Active Essentials.",
      "author": "ChatGPT4.1"
    },
    "69419": {
      "id": 2600868,
      "text": "BoostAid chứa đầy sự kết hợp của các loại vitamin và khoáng chất được thiết kế để nâng cao hiệu suất luyện tập của bạn",
      "author": "ChatGPT4.1"
    },
    "69420": {
      "id": 2600869,
      "text": "và giữ cho bạn tràn đầy năng lượng trong suốt mọi hoạt động.",
      "author": "ChatGPT4.1"
    },
    "69421": {
      "id": 2600870,
      "text": "Đừng bỏ lỡ ưu đãi đặc biệt trực tuyến của chúng tôi!",
      "author": "ChatGPT4.1"
    },
    "69422": {
      "id": 2600871,
      "text": "1.000 người đầu tiên hoàn thành khảo sát ngắn trên trang web của chúng tôi",
      "author": "ChatGPT4.1"
    },
    "69423": {
      "id": 2600872,
      "text": "sẽ nhận được một chai miễn phí hương vị BoostAid mới nhất, Tropical Fusion.",
      "author": "ChatGPT4.1"
    },
    "69424": {
      "id": 2600873,
      "text": "Nhanh tay lên, chương trình khuyến mãi này chỉ có hiệu lực cho đến khi hết hàng.",
      "author": "ChatGPT4.1"
    },
    "69425": {
      "id": 2600874,
      "text": "Tăng cường mức năng lượng của bạn ngay hôm nay với một chai BoostAid và tận dụng tối đa buổi tập luyện!",
      "author": "ChatGPT4.1"
    }
  }
