  "translations": {
    "52919": {
      "id": 876502,
      "text": "Crosscountry Tours đang tìm kiếm những cá nhân hướng ngoại, khỏe mạnh để thực hiện các chuyến du lịch mùa đông khắc nghiệt của chúng tôi ở vùng núi Colorado.",
      "author": "a user"
    },
    "52922": {
      "id": 876511,
      "text": "Không vấn đề gì!",
      "author": "a user"
    },
    "52923": {
      "id": 876512,
      "text": "Chúng tôi sẽ cung cấp tất cả các sự huấn luyện bạn cần trong một khóa học hai ngày để phát huy chuyên môn của bạn trong công ty chúng tôi.",
      "author": "a user"
    },
    "52917": {
      "id": 2593394,
      "text": "Bạn có đang băn khoăn không biết nên làm gì cho kỳ nghỉ đông không?",
      "author": "ChatGPT4.1"
    },
    "52918": {
      "id": 2593395,
      "text": "Bạn có đang tìm kiếm điều gì đó thú vị hơn việc về nhà thăm họ hàng không?",
      "author": "ChatGPT4.1"
    },
    "52920": {
      "id": 2593396,
      "text": "Người trẻ và người già đến từ khắp nơi trên thế giới tham gia các chuyến du lịch của chúng tôi, với nhiều mức độ thể lực khác nhau.",
      "author": "ChatGPT4.1"
    },
    "52921": {
      "id": 2593397,
      "text": "Không có kinh nghiệm?",
      "author": "ChatGPT4.1"
    },
    "52924": {
      "id": 2593398,
      "text": "Gửi cho chúng tôi sơ yếu lý lịch và thư xin việc của bạn càng sớm càng tốt đến jobs@crosscountrytours.com",
      "author": "ChatGPT4.1"
    },
    "52925": {
      "id": 2593399,
      "text": "và chúng tôi sẽ liên hệ với bạn về quy trình phỏng vấn!",
      "author": "ChatGPT4.1"
    }
  }
}
