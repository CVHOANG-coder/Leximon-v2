  "translations": {
    "68390": {
      "id": 2652407,
      "text": "Này Marcus, tôi có một tin tuyệt vời!",
      "author": "ChatGPT4.1"
    },
    "68391": {
      "id": 2652408,
      "text": "Chương trình truyền hình Culinary Chronicles muốn giới thiệu nhà hàng của chúng ta trong một tập mới.",
      "author": "ChatGPT4.1"
    },
    "68392": {
      "id": 2652409,
      "text": "Họ sẽ đến vào thứ Năm để ghi hình đội ngũ của chúng ta trong giờ cao điểm buổi trưa.",
      "author": "ChatGPT4.1"
    },
    "68393": {
      "id": 2652410,
      "text": "Vì bạn là bếp trưởng,",
      "author": "ChatGPT4.1"
    },
    "68394": {
      "id": 2652411,
      "text": "Tôi cần bạn đến sớm hơn bình thường một chút để đảm bảo mọi thứ đã được chuẩn bị và sắp xếp chu đáo.",
      "author": "ChatGPT4.1"
    },
    "68395": {
      "id": 2652412,
      "text": "Để tạo ấn tượng mạnh, bạn có thể sáng tạo vài món ăn đặc biệt cho ngày hôm đó không?",
      "author": "ChatGPT4.1"
    },
    "68396": {
      "id": 2652413,
      "text": "Ngoài ra, hãy đảm bảo nhà bếp luôn sạch bong và vận hành trơn tru nhé,",
      "author": "ChatGPT4.1"
    },
    "68397": {
      "id": 2652414,
      "text": "đặc biệt khi chúng ta sẽ nhận được rất nhiều sự chú ý thêm.",
      "author": "ChatGPT4.1"
    }
  }
}
