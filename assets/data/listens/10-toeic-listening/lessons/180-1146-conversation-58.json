    },
    "54168": {
      "id": 2593147,
      "text": "Chào, tôi đã mua bộ bách khoa toàn thư này ở đây hôm trước,",
      "author": "ChatGPT4.1"
    },
    "54169": {
      "id": 2593148,
      "text": "và không hiểu sao, phần đóng gáy sách lại không được chắc chắn.",
