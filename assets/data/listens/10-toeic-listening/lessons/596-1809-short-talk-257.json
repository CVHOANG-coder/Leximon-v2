  "translations": {
    "70302": {
      "id": 2642810,
      "text": "Xin chào, tôi muốn đặt mua một số ly sứ in theo yêu cầu cho quán cà phê của chúng tôi.",
      "author": "ChatGPT4.1"
    },
    "70303": {
      "id": 2642811,
      "text": "Chúng tôi dự định tặng những chiếc ly này cho khách hàng mới như một phần của chương trình khuyến mãi.",
      "author": "ChatGPT4.1"
    },
    "70304": {
      "id": 2642812,
      "text": "Tôi cần chúng phải bền và có thể chứa được chất lỏng nóng mà không gặp vấn đề gì.",
      "author": "ChatGPT4.1"
    },
    "70305": {
      "id": 2642813,
      "text": "Chúng tôi muốn thiết kế có logo của quán ở một bên và khẩu hiệu vui nhộn ở bên còn lại.",
      "author": "ChatGPT4.1"
    },
    "70306": {
      "id": 2642814,
      "text": "Nếu bạn có loại chúng tôi cần, chúng tôi muốn mua 100 chiếc ly.",
      "author": "ChatGPT4.1"
    },
    "70307": {
      "id": 2642815,
      "text": "Bạn có thể cho tôi biết về giá cả và liệu có giảm giá cho đơn hàng số lượng lớn không?",
      "author": "ChatGPT4.1"
    }
  }
