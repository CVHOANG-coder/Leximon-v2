  "translations": {
    "68261": {
      "id": 2624272,
      "text": "Trước khi buổi hòa nhạc gây quỹ bắt đầu,",
      "author": "ChatGPT4.1"
    },
    "68262": {
      "id": 2624273,
      "text": "Tôi xin gửi lời cảm ơn chân thành đến tất cả mọi người có mặt ở đây.",
      "author": "ChatGPT4.1"
    },
    "68263": {
      "id": 2624274,
      "text": "Sự ủng hộ của các bạn dành cho Trung tâm Cộng đồng Brookfield thật sự rất ý nghĩa.",
      "author": "ChatGPT4.1"
    },
    "68264": {
      "id": 2624275,
      "text": "Cơ sở vật chất của chúng tôi đã cần sửa chữa trong một thời gian khá dài.",
      "author": "ChatGPT4.1"
    },
    "68265": {
      "id": 2624276,
      "text": "Tính đến nay, chúng tôi đã quyên góp được 6000 đô la từ việc bán vé,",
      "author": "ChatGPT4.1"
    },
    "68266": {
      "id": 2624277,
      "text": "nhưng chúng tôi vẫn còn thiếu so với mục tiêu đề ra.",
      "author": "ChatGPT4.1"
    },
    "68267": {
      "id": 2624278,
      "text": "Trong suốt buổi hòa nhạc, tôi khuyến khích các bạn mua đồ ăn nhẹ và nước uống tại quầy phục vụ.",
      "author": "ChatGPT4.1"
    },
    "68268": {
      "id": 2624279,
      "text": "Tám mươi phần trăm lợi nhuận sẽ được dành cho việc sửa chữa tại Trung tâm Cộng đồng Brookfield.",
      "author": "ChatGPT4.1"
    },
    "68269": {
      "id": 2624280,
      "text": "Chúc các bạn thưởng thức buổi biểu diễn vui vẻ!",
      "author": "ChatGPT4.1"
    }
  }
}
