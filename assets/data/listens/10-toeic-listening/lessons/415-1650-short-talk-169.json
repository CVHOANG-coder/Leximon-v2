  "translations": {
    "68473": {
      "id": 2675568,
      "text": "Chào mừng bạn đến với Carson Automotive & Tire Care, lựa chọn đáng tin cậy của bạn tại khu vực Greenfield.",
      "author": "ChatGPT4.1"
    },
    "68474": {
      "id": 2675569,
      "text": "Chúng tôi cung cấp các dịch vụ bảo trì và sửa chữa xe chất lượng cao với mức giá cạnh tranh.",
      "author": "ChatGPT4.1"
    },
    "68475": {
      "id": 2675570,
      "text": "Đội ngũ kỹ thuật viên chuyên nghiệp của chúng tôi không ai sánh bằng,",
      "author": "ChatGPT4.1"
    },
    "68476": {
      "id": 2675571,
      "text": "và chúng tôi tự hào mang đến dịch vụ khách hàng xuất sắc.",
      "author": "ChatGPT4.1"
    },
    "68477": {
      "id": 2675572,
      "text": "Chúng tôi rất vui mừng thông báo rằng trong năm thứ năm liên tiếp,",
      "author": "ChatGPT4.1"
    },
    "68478": {
      "id": 2675573,
      "text": "độc giả của Greenfield Gazette đã bình chọn chúng tôi là Đơn vị tốt nhất trong thành phố!",
      "author": "ChatGPT4.1"
    },
    "68479": {
      "id": 2675574,
      "text": "Để kỷ niệm cột mốc đáng nhớ này,",
      "author": "ChatGPT4.1"
    },
    "68480": {
      "id": 2675575,
      "text": "chúng tôi giảm giá 15% cho tất cả các dịch vụ xoay lốp trong tháng Tám.",
      "author": "ChatGPT4.1"
    },
    "68481": {
      "id": 2675576,
      "text": "Để tận dụng ưu đãi đặc biệt này,",
      "author": "ChatGPT4.1"
    },
    "68482": {
      "id": 2675577,
      "text": "xin vui lòng đặt lịch hẹn bằng cách gọi cho chúng tôi hoặc đăng ký trực tuyến.",
      "author": "ChatGPT4.1"
    },
    "68483": {
      "id": 2675578,
      "text": "Nhanh lên! Các suất đang dần được lấp đầy!",
      "author": "ChatGPT4.1"
    }
  }
