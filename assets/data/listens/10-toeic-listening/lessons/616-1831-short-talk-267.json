  "translations": {
    "70714": {
      "id": 2617173,
      "text": "Bạn đang tìm kiếm những ưu đãi không thể đánh bại cho các thiết bị gia dụng?",
      "author": "ChatGPT4.1"
    },
    "70715": {
      "id": 2617174,
      "text": "Sự tìm kiếm của bạn kết thúc tại Kho Better Deals!",
      "author": "ChatGPT4.1"
    },
    "70716": {
      "id": 2617175,
      "text": "Nằm thuận tiện ngay trung tâm Cedar Springs,",
      "author": "ChatGPT4.1"
    },
    "70717": {
      "id": 2617176,
      "text": "Better Deals là điểm đến lý tưởng cho các thiết bị đã qua sử dụng chất lượng cao mà không làm bạn cạn túi.",
      "author": "ChatGPT4.1"
    },
    "70718": {
      "id": 2617177,
      "text": "Dù bạn đang tìm mua tủ lạnh, máy giặt hay lò nướng,",
      "author": "ChatGPT4.1"
    },
    "70719": {
      "id": 2617178,
      "text": "bạn sẽ ngạc nhiên với mức giá thấp của chúng tôi.",
      "author": "ChatGPT4.1"
    },
    "70720": {
      "id": 2617179,
      "text": "Thêm vào đó, mua sắm cùng chúng tôi và tận hưởng đặc quyền tham gia câu lạc bộ VIP giảm giá tại www.betterdealswarehouse.com.",
      "author": "ChatGPT4.1"
    },
    "70721": {
      "id": 2617180,
      "text": "Hãy ghé thăm Kho Better Deals vào cuối tuần này,",
      "author": "ChatGPT4.1"
    },
    "70722": {
      "id": 2617181,
      "text": "và nhận lắp đặt miễn phí cho mọi đơn hàng trên $500.",
      "author": "ChatGPT4.1"
    }
  }
