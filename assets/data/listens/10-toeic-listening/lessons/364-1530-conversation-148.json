  "translations": {
    "65978": {
      "id": 2604657,
      "text": "Xin lỗi, bạn để đàn ukulele ở đâu vậy?",
      "author": "ChatGPT4.1"
    },
    "65979": {
      "id": 2604658,
      "text": "Tôi đang tìm một cây đàn cho các buổi học nhạc của mình.",
      "author": "ChatGPT4.1"
    },
    "65980": {
      "id": 2604659,
      "text": "Bạn muốn mua trong mức giá nào?",
      "author": "ChatGPT4.1"
    },
    "65981": {
      "id": 2604660,
      "text": "Ờ... Khoảng 25 đô la.",
      "author": "ChatGPT4.1"
    },
    "65982": {
      "id": 2604661,
      "text": "Tôi chỉ là sinh viên nên không đủ tiền mua loại xịn lắm.",
      "author": "ChatGPT4.1"
    },
    "65983": {
      "id": 2604662,
      "text": "Hơn nữa, tôi hoàn toàn là người mới bắt đầu.",
      "author": "ChatGPT4.1"
    },
    "65984": {
      "id": 2604663,
      "text": "Tôi e rằng với mức giá đó bạn sẽ không tìm được đàn ukulele mới nào đâu,",
      "author": "ChatGPT4.1"
    },
    "65985": {
      "id": 2604664,
      "text": "ngay cả những loại dành cho người mới cũng không có.",
      "author": "ChatGPT4.1"
    },
    "65986": {
      "id": 2604665,
      "text": "Đàn ukulele đã qua sử dụng thì thường được giảm giá 20% hoặc thậm chí nhiều hơn so với giá gốc.",
      "author": "ChatGPT4.1"
    },
    "65987": {
      "id": 2604666,
      "text": "Bạn có sẵn sàng xem hàng cũ không?",
      "author": "ChatGPT4.1"
    },
    "65988": {
      "id": 2604667,
      "text": "Tốt quá, như vậy tôi có thể mua được,",
      "author": "ChatGPT4.1"
    },
    "65989": {
      "id": 2604668,
      "text": "miễn là không có hỏng hóc nặng hoặc thiếu dây.",
      "author": "ChatGPT4.1"
    },
    "65990": {
      "id": 2604669,
      "text": "Đừng lo lắng.",
      "author": "ChatGPT4.1"
    },
    "65991": {
      "id": 2604670,
      "text": "Những nhạc cụ này còn ở tình trạng rất tốt.",
      "author": "ChatGPT4.1"
    },
    "65992": {
      "id": 2604671,
      "text": "Để tôi cho bạn xem những gì chúng tôi đang có trong kho.",
      "author": "ChatGPT4.1"
    }
  }
}
