  "translations": {
    "65949": {
      "id": 2602390,
      "text": "Brad, quán sushi mới ở trung tâm mà cậu thử tối qua thế nào?",
      "author": "ChatGPT4.1"
    },
    "65950": {
      "id": 2602391,
      "text": "Cũng tạm ổn thôi.",
      "author": "ChatGPT4.1"
    },
    "65951": {
      "id": 2602392,
      "text": "Sao cậu hỏi vậy?",
      "author": "ChatGPT4.1"
    },
    "65952": {
      "id": 2602393,
      "text": "Trời ơi, tôi vừa được giao nhiệm vụ tiếp khách nước ngoài.",
      "author": "ChatGPT4.1"
    },
    "65953": {
      "id": 2602394,
      "text": "Cậu biết người ta vẫn nói: ấn tượng đầu tiên rất quan trọng mà.",
      "author": "ChatGPT4.1"
    },
    "65954": {
      "id": 2602395,
      "text": "Tôi thật sự muốn gây ấn tượng với ông Mitsukoshi.",
      "author": "ChatGPT4.1"
    },
    "65955": {
      "id": 2602396,
      "text": "Ừm, nếu tôi là cậu,",
      "author": "ChatGPT4.1"
    },
    "65956": {
      "id": 2602397,
      "text": "tôi sẽ chọn một nhà hàng nào đó giúp khách cảm nhận được thành phố này,",
      "author": "ChatGPT4.1"
    },
    "65957": {
      "id": 2602398,
      "text": "ví dụ như Coppa's Savory chẳng hạn.",
      "author": "ChatGPT4.1"
    },
    "65958": {
      "id": 2602399,
      "text": "Quán này có thực đơn rất đa dạng,",
      "author": "ChatGPT4.1"
    },
    "65959": {
      "id": 2602400,
      "text": "và không gian ở đó cũng rất tuyệt,",
      "author": "ChatGPT4.1"
    },
    "65960": {
      "id": 2602401,
      "text": "với thiết kế gạch và gỗ ấm áp trong phòng ăn.",
      "author": "ChatGPT4.1"
    },
    "65961": {
      "id": 2602402,
      "text": "Hay thật. Tôi cứ nghĩ chỗ đó chỉ là tiệm pizza thôi.",
      "author": "ChatGPT4.1"
    },
    "65962": {
      "id": 2602403,
      "text": "Cảm ơn vì lời khuyên nha, Brad.",
      "author": "ChatGPT4.1"
    },
    "65963": {
      "id": 2602404,
      "text": "Tôi sẽ xem thực đơn đầy đủ trên mạng.",
      "author": "ChatGPT4.1"
    }
  }
}
