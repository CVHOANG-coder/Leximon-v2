  "translations": {
    "54813": {
      "id": 946155,
      "text": "Dàn nhạc Tre đã ở đây cùng chúng tôi, đến từ tận Ukraine xa xôi!",
      "author": "a user"
    },
    "54811": {
      "id": 2625745,
      "text": "Đây là một đêm đặc biệt tại Nhà hát Lowry,",
      "author": "ChatGPT4.1"
    },
    "54812": {
      "id": 2625746,
      "text": "vì lần đầu tiên chúng ta được đón chào một dàn nhạc quốc tế!",
      "author": "ChatGPT4.1"
    },
    "54814": {
      "id": 2625747,
      "text": "Dàn nhạc đã biểu diễn tại quê hương và khắp châu Âu trong sáu năm qua",
      "author": "ChatGPT4.1"
    },
    "54815": {
      "id": 2625748,
      "text": "và đã giành được nhiều giải thưởng.",
      "author": "ChatGPT4.1"
    },
    "54816": {
      "id": 2625749,
      "text": "Nhạc trưởng của dàn nhạc, Alice Smallens, nổi tiếng với việc kết hợp các kỹ thuật cổ điển với âm thanh hiện đại,",
      "author": "ChatGPT4.1"
    },
    "54817": {
      "id": 2625750,
      "text": "tạo nên một lượng người hâm mộ đa dạng.",
      "author": "ChatGPT4.1"
    },
    "54818": {
      "id": 2625751,
      "text": "Hãy ngồi lại, thư giãn và tận hưởng một giờ tiếp theo cùng Dàn nhạc Tre.",
      "author": "ChatGPT4.1"
    }
  }
