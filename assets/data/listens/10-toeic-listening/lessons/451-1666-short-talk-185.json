  "translations": {
    "68617": {
      "id": 2596222,
      "text": "Chào bạn, tôi là Greg từ Dịch Vụ Ô Tô Easy Ride.",
      "author": "ChatGPT4.1"
    },
    "68618": {
      "id": 2596223,
      "text": "Tôi muốn nhắc bạn rằng chiếc xe của bạn đến hạn kiểm tra bảo dưỡng định kỳ vào tuần tới.",
      "author": "ChatGPT4.1"
    },
    "68619": {
      "id": 2596224,
      "text": "Chúng tôi sẽ kiểm tra dầu, phanh và áp suất lốp để đảm bảo mọi thứ đều trong tình trạng tốt nhất.",
      "author": "ChatGPT4.1"
    },
    "68620": {
      "id": 2596225,
      "text": "Thông thường quá trình này mất khoảng một tiếng, bạn có thể chờ tại phòng chờ của chúng tôi",
      "author": "ChatGPT4.1"
    },
    "68621": {
      "id": 2596226,
      "text": "hoặc để lại xe và quay lại lấy sau trong ngày.",
      "author": "ChatGPT4.1"
    },
    "68622": {
      "id": 2596227,
      "text": "Nếu bạn muốn thêm bất kỳ dịch vụ nào khác,",
      "author": "ChatGPT4.1"
    },
    "68623": {
      "id": 2596228,
      "text": "như xoay lốp hoặc thay lọc gió,",
      "author": "ChatGPT4.1"
    },
    "68624": {
      "id": 2596229,
      "text": "vui lòng cho chúng tôi biết trước.",
      "author": "ChatGPT4.1"
    },
    "68625": {
      "id": 2596230,
      "text": "Cảm ơn bạn đã chọn Easy Ride, và hẹn gặp lại bạn sớm!",
      "author": "ChatGPT4.1"
    }
  }
}
