    "55921": {
      "id": 2612325,
      "text": "Đây là Manchester Now, trên U.K. Radio One.",
      "author": "ChatGPT4.1"
    },
    "55922": {
      "id": 2612326,
      "text": "Sáng nay tôi sẽ nói chuyện với Sophie Turns, Giám đốc của Love Homes U.K.",
      "author": "ChatGPT4.1"
    },
    "55923": {
      "id": 2612327,
      "text": "Tổ chức từ thiện đặc biệt này giúp tìm nhà cho những thanh thiếu niên vô gia cư, có nguy cơ cao.",
      "author": "ChatGPT4.1"
    },
    "55924": {
      "id": 2612328,
      "text": "Cô Turns có mặt ở đây để nhờ bạn giúp đỡ cho chiến lược mới mà họ muốn triển khai vào tháng tới.",
      "author": "ChatGPT4.1"
    },
    "55925": {
      "id": 2612329,
      "text": "Love Homes đang tìm kiếm các tình nguyện viên để hướng dẫn các em về cuộc sống tự lập.",
      "author": "ChatGPT4.1"
    },
    "55926": {
      "id": 2612330,
      "text": "Chúng tôi sẽ gặp cô Turns sau hai phút nữa, ngay khi kết thúc các thông điệp từ nhà tài trợ của chúng tôi.",
      "author": "ChatGPT4.1"
    }
  }
