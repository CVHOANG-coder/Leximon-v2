  "translations": {
    "55506": {
      "id": 2585109,
      "text": "Thông báo cuối cùng của chúng tôi là một tin rất thú vị!",
      "author": "ChatGPT4.1"
    },
    "55507": {
      "id": 2585110,
      "text": "Ca sĩ nổi tiếng toàn thế giới, Arianna Gold, đã ký hợp đồng quảng bá cho sản phẩm dầu gội mới của chúng ta.",
      "author": "ChatGPT4.1"
    },
    "55508": {
      "id": 2585111,
      "text": "Cô Gold là một ca sĩ nhạc pop từng đoạt giải thưởng và cũng là giám khảo trong chương trình \"America Can Sing.\"",
      "author": "ChatGPT4.1"
    },
    "55509": {
      "id": 2585112,
      "text": "Đây là một sự kiện rất quan trọng đối với công ty chúng ta,",
      "author": "ChatGPT4.1"
    },
    "55510": {
      "id": 2585113,
      "text": "vì chúng ta chưa bao giờ có một người nổi tiếng đến vậy quảng bá cho các sản phẩm của mình.",
      "author": "ChatGPT4.1"
    },
    "55511": {
      "id": 2585114,
      "text": "Cô ấy đã ký hợp đồng một năm, cam kết tham dự sáu buổi ra mắt sản phẩm và bốn quảng cáo.",
      "author": "ChatGPT4.1"
    },
    "55512": {
      "id": 2585115,
      "text": "Nếu bạn là người sẽ làm việc trực tiếp với cô Gold,",
      "author": "ChatGPT4.1"
    },
    "55513": {
      "id": 2585116,
      "text": "bạn có thể tin tôi, cô ấy là một người rất tích cực và thật vui khi được ở gần bên cô ấy.",
      "author": "ChatGPT4.1"
    },
    "55514": {
      "id": 2585117,
      "text": "Tôi đặt rất nhiều hy vọng vào dự án này.",
      "author": "ChatGPT4.1"
    }
  }
