    "52990": {
      "id": 2593096,
      "text": "Thành phố Chicago muốn nhắc nhở bạn rằng cuộc đua marathon hàng năm sẽ diễn ra vào ngày 19 tháng 9.",
      "author": "ChatGPT4.1"
    },
    "52991": {
      "id": 2593097,
      "text": "Các đường Park, Range, và Smith xung quanh tòa nhà chung cư này sẽ bị đóng cửa cho các phương tiện giao thông từ 7 giờ sáng đến 10 giờ sáng.",
      "author": "ChatGPT4.1"
    },
    "52992": {
      "id": 2593098,
      "text": "Đại lộ Penn, nằm ở phía nam khu căn hộ, sẽ vẫn mở cửa và có chỗ đậu xe miễn phí cho cư dân của khu này.",
      "author": "ChatGPT4.1"
    },
    "52993": {
      "id": 2593099,
      "text": "Vui lòng chỉ sử dụng chỗ đậu xe này nếu thật sự cần thiết.",
      "author": "ChatGPT4.1"
    },
    "52994": {
      "id": 2593100,
      "text": "Chúng tôi khuyên bạn nên ở trong căn hộ của mình hoặc đi đến nơi nào đó trong phạm vi đi bộ vào thời điểm đó để tránh ùn tắc giao thông.",
      "author": "ChatGPT4.1"
    },
    "52995": {
      "id": 2593101,
      "text": "Cảm ơn bạn đã hợp tác để giúp giải Marathon Chicago thành công.",
