  "translations": {
    "70062": {
      "id": 2605295,
      "text": "Kính gửi quý khách hàng của Green Valley Market.",
      "author": "ChatGPT4.1"
    },
    "70063": {
      "id": 2605296,
      "text": "Chúng tôi xin thông báo cửa hàng sẽ tạm thời đóng cửa từ ngày 5 đến ngày 8 tháng 9 để nâng cấp theo kế hoạch.",
      "author": "ChatGPT4.1"
    },
    "70064": {
      "id": 2605297,
      "text": "Trong thời gian này, chúng tôi sẽ lắp đặt quầy cà phê mới ngay cạnh khu vực bánh ngọt.",
      "author": "ChatGPT4.1"
    },
    "70065": {
      "id": 2605298,
      "text": "Chúng tôi trân trọng cảm ơn sự thông cảm và kiên nhẫn của quý khách,",
      "author": "ChatGPT4.1"
    },
    "70066": {
      "id": 2605299,
      "text": "và chúng tôi tin chắc rằng những cải tiến này sẽ nâng cao trải nghiệm mua sắm của quý khách.",
      "author": "ChatGPT4.1"
    },
    "70067": {
      "id": 2605300,
      "text": "Để chào mừng khai trương quầy cà phê mới vào ngày 9 tháng 9,",
      "author": "ChatGPT4.1"
    },
    "70068": {
      "id": 2605301,
      "text": "chúng tôi sẽ có chương trình khuyến mãi đặc biệt:",
      "author": "ChatGPT4.1"
    },
    "70069": {
      "id": 2605302,
      "text": "tặng một phần bánh miễn phí cho mỗi đơn mua cà phê.",
      "author": "ChatGPT4.1"
    },
    "70070": {
      "id": 2605303,
      "text": "Để nhận phiếu bánh miễn phí, quý khách chỉ cần đến quầy dịch vụ khách hàng.",
      "author": "ChatGPT4.1"
    },
    "70071": {
      "id": 2605304,
      "text": "Cảm ơn quý khách đã luôn tin tưởng và ủng hộ chúng tôi.",
      "author": "ChatGPT4.1"
    }
  }
}
