  "translations": {
    "54008": {
      "id": 888103,
      "text": "Chào Alex. Là tôi, Dave đây.",
      "author": "a user"
    },
    "54012": {
      "id": 888426,
      "text": "Bạn sẽ không tin điều này đâu, chúng tôi thậm chí còn có cơ hội vào hậu trường và gặp Drake!",
      "author": "a user"
    },
    "54013": {
      "id": 888427,
      "text": "Tôi thực sự trân trọng những tấm vé.",
      "author": "a user"
    },
    "54015": {
      "id": 888429,
      "text": "Tôi sẽ có một cuộc gặp mặt nhỏ tại nhà tôi vào Chủ nhật để xem lễ trao giải Oscar trên TV.",
      "author": "a user"
    },
    "54017": {
      "id": 907330,
      "text": "Tôi biết các bạn yêu thích phim ảnh nên hy vọng các bạn có thể đến.",
      "author": "a user"
    },
    "54018": {
      "id": 1044573,
      "text": "Bạn có thể nhắn tin cho tôi và cho tôi biết trước tối nay được không?",
      "author": "a user"
    },
    "54009": {
      "id": 2616126,
      "text": "Mình chỉ gọi để cảm ơn bạn vì đã tặng mình vé hòa nhạc.",
      "author": "ChatGPT4.1"
    },
    "54010": {
      "id": 2616127,
      "text": "Màn trình diễn của Drake thật sự tuyệt vời,",
      "author": "ChatGPT4.1"
    },
    "54011": {
      "id": 2616128,
      "text": "bạn gái mình và mình đã có khoảng thời gian rất vui.",
      "author": "ChatGPT4.1"
    },
    "54014": {
      "id": 2616129,
      "text": "À, tiện thì mình cũng muốn báo cho bạn biết là...",
      "author": "ChatGPT4.1"
    },
    "54016": {
      "id": 2616130,
      "text": "Bạn và bạn gái muốn tới không?",
      "author": "ChatGPT4.1"
    },
    "54019": {
      "id": 2616131,
      "text": "Mình sẽ đi mua sắm sau giờ làm và cần biết nên làm bao nhiêu cái pizza.",
      "author": "ChatGPT4.1"
    }
  }
