  "translations": {
    "53723": {
      "id": 897472,
      "text": "Công ty chúng ta, BankingBiz, đã có một năm có lợi nhuận cao nhất kể từ khi công ty thành lập vào năm 1992.",
      "author": "a user"
    },
    "53724": {
      "id": 897473,
      "text": "Sự làm việc chăm chỉ của các bạn, những nhân viên của chúng tôi, là điều đã giúp chúng ta thành công như vậy.",
      "author": "a user"
    },
    "53726": {
      "id": 897476,
      "text": "Hơn nữa, chúng ta đang mở rộng kinh doanh sang California.",
      "author": "a user"
    },
    "53727": {
      "id": 897477,
      "text": "Bây giờ, để nói về việc mở rộng của chúng ta, Giám đốc điều hành Bill Buss của chúng ta sẽ lên sân khấu.",
      "author": "a user"
    },
    "53725": {
      "id": 1007674,
      "text": "Nhờ sự siêng năng của bạn, chúng ta đã ký được thêm 28 khách hàng so với năm ngoái.",
      "author": "a user"
    },
    "53722": {
      "id": 2589412,
      "text": "Cảm ơn tất cả các bạn đã đến tham dự buổi lễ này.",
      "author": "ChatGPT4.1"
    },
    "53728": {
      "id": 2589413,
      "text": "Chúng ta hãy dành cho Bill một tràng pháo tay.",
      "author": "ChatGPT4.1"
    }
  }
