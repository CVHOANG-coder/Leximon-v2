  "translations": {
    "53118": {
      "id": 897671,
      "text": "Bạn đã tuyển được người cho vị trí đó chưa?",
      "author": "a user"
    },
    "53123": {
      "id": 897676,
      "text": "Vâng, tôi rất quan tâm,",
      "author": "a user"
    },
    "53124": {
      "id": 897677,
      "text": "nhưng tôi đang học số tín chỉ tối đa rồi",
      "author": "a user"
    },
    "53128": {
      "id": 897681,
      "text": "và đôi khi, chúng tôi thuê hai sinh viên đảm nhận một vai trò nếu việc đó phù hợp với lịch học của họ.",
      "author": "a user"
    },
    "53116": {
      "id": 2598635,
      "text": "Chào buổi sáng.",
      "author": "ChatGPT4.1"
    },
    "53117": {
      "id": 2598636,
      "text": "Tôi đã thấy trên bảng việc làm trực tuyến của trường đại học rằng bạn đang tuyển một lễ tân sinh viên.",
      "author": "ChatGPT4.1"
    },
    "53119": {
      "id": 2598637,
      "text": "Xin chào.",
      "author": "ChatGPT4.1"
    },
    "53120": {
      "id": 2598638,
      "text": "Chúng tôi chưa tuyển đủ vị trí, nhưng đã bắt đầu xem xét các đơn ứng tuyển.",
      "author": "ChatGPT4.1"
    },
    "53121": {
      "id": 2598639,
      "text": "Chúng tôi dự định bắt đầu phỏng vấn từ thứ Hai.",
      "author": "ChatGPT4.1"
    },
    "53122": {
      "id": 2598640,
      "text": "Bạn có muốn điền đơn ứng tuyển không?",
      "author": "ChatGPT4.1"
    },
    "53125": {
      "id": 2598641,
      "text": "Công việc này có đảm bảo sự linh hoạt không?",
      "author": "ChatGPT4.1"
    },
    "53126": {
      "id": 2598642,
      "text": "Tôi lo rằng với hai mươi tín chỉ, tôi có thể không có nhiều thời gian như công việc yêu cầu.",
      "author": "ChatGPT4.1"
    },
    "53127": {
      "id": 2598643,
      "text": "Công việc có một chút linh hoạt,",
      "author": "ChatGPT4.1"
    },
    "53129": {
      "id": 2598644,
      "text": "Vui lòng đính kèm bản sao lịch học của học kỳ này vào đơn ứng tuyển của bạn.",
      "author": "ChatGPT4.1"
    },
    "53130": {
      "id": 2598645,
      "text": "Bằng cách này, chúng tôi có thể xác định khối lượng công việc phù hợp nhất cho bạn.",
      "author": "ChatGPT4.1"
    }
  }
