  "translations": {
    "66711": {
      "id": 2612362,
      "text": "Xin mọi người chú ý, làm ơn.",
      "author": "ChatGPT4.1"
    },
    "66712": {
      "id": 2612363,
      "text": "Máy may mới sẽ được giao vào thứ Ba.",
      "author": "ChatGPT4.1"
    },
    "66713": {
      "id": 2612364,
      "text": "Không nghi ngờ gì, đây là tin tuyệt vời!",
      "author": "ChatGPT4.1"
    },
    "66714": {
      "id": 2612365,
      "text": "Máy mới này có thể may áo chỉ mất một nửa thời gian so với các máy may hiện tại.",
      "author": "ChatGPT4.1"
    },
    "66715": {
      "id": 2612366,
      "text": "Chúng tôi muốn đảm bảo mọi người đều biết rõ về cách vận hành máy mới,",
      "author": "ChatGPT4.1"
    },
    "66716": {
      "id": 2612367,
      "text": "nên chúng tôi mong các bạn ở lại nhà máy sau giờ làm.",
      "author": "ChatGPT4.1"
    },
    "66717": {
      "id": 2612368,
      "text": "Chúng tôi hiểu có thể không phải ai cũng có mặt được,",
      "author": "ChatGPT4.1"
    },
    "66718": {
      "id": 2612369,
      "text": "vì vậy chúng tôi sẽ chuyển cho mọi người một danh sách.",
      "author": "ChatGPT4.1"
    },
    "66719": {
      "id": 2612370,
      "text": "Vui lòng ghi tên mình nếu bạn có thể làm thêm giờ.",
      "author": "ChatGPT4.1"
    },
    "66720": {
      "id": 2612371,
      "text": "Như thường lệ, tiền làm thêm giờ của bạn sẽ được cộng vào kỳ lương tiếp theo.",
      "author": "ChatGPT4.1"
    }
  }
