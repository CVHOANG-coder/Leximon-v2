  "translations": {
    "66911": {
      "id": 2505932,
      "text": "Sáng nay, chúng tôi có tin nóng muốn chia sẻ với tất cả các bạn.",
      "author": "ChatGPT4.1"
    },
    "66912": {
      "id": 2505933,
      "text": "Brown Developers đã vượt qua các đối thủ trong cuộc đấu thầu phát triển 40 mẫu đất",
      "author": "ChatGPT4.1"
    },
    "66913": {
      "id": 2505934,
      "text": "ngay bên ngoài trung tâm thành phố Dallas.",
      "author": "ChatGPT4.1"
    },
    "66914": {
      "id": 2505935,
      "text": "Đây là một dự án trị giá 40 triệu đô la dự kiến sẽ mang lại hàng ngàn việc làm cho người dân Texas.",
      "author": "ChatGPT4.1"
    },
    "66915": {
      "id": 2505936,
      "text": "Toàn bộ dự án này được dự đoán sẽ mất ít nhất năm năm,",
      "author": "ChatGPT4.1"
    },
    "66916": {
      "id": 2505937,
      "text": "và Brown Developers đã phát hành một thông báo rằng họ muốn khởi công vào tháng tới.",
      "author": "ChatGPT4.1"
    },
    "66917": {
      "id": 2505938,
      "text": "Làm gì với mảnh đất này đã được tranh luận trong nhiều năm,",
      "author": "ChatGPT4.1"
    },
    "66918": {
      "id": 2505939,
      "text": "vì một số người nghĩ rằng nó sẽ trở thành một khu bảo tồn thiên nhiên tuyệt vời để người dân tránh xa thành phố.",
      "author": "ChatGPT4.1"
    },
    "66919": {
      "id": 2505940,
      "text": "Chúng tôi sẽ trở lại với nhiều thông tin hơn sau quảng cáo ngắn này.",
      "author": "ChatGPT4.1"
    }
  }
