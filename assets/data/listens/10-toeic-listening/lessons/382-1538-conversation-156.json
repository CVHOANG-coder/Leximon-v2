  "translations": {
    "66115": {
      "id": 2634453,
      "text": "Ồ, chào Yolanda.",
      "author": "ChatGPT4.1"
    },
    "66116": {
      "id": 2634454,
      "text": "Tôi ngạc nhiên khi thấy bạn ở quầy lễ tân muộn thế này.",
      "author": "ChatGPT4.1"
    },
    "66117": {
      "id": 2634455,
      "text": "Bạn không thường làm việc ở khách sạn vào buổi sáng sao?",
      "author": "ChatGPT4.1"
    },
    "66118": {
      "id": 2634456,
      "text": "Thật ra, tôi sẽ làm ca tối một thời gian;",
      "author": "ChatGPT4.1"
    },
    "66119": {
      "id": 2634457,
      "text": "Tôi đang thay cho một giám sát viên lễ tân vừa được thăng chức,",
      "author": "ChatGPT4.1"
    },
    "66120": {
      "id": 2634458,
      "text": "nhưng chỉ cho đến khi khách sạn tuyển được người thay thế cố định.",
      "author": "ChatGPT4.1"
    },
    "66121": {
      "id": 2634459,
      "text": "Ồ, vậy là đang có vị trí giám sát lễ tân trống à?",
      "author": "ChatGPT4.1"
    },
    "66122": {
      "id": 2634460,
      "text": "Tôi đang tìm kiếm cơ hội đảm nhận một vai trò quản lý.",
      "author": "ChatGPT4.1"
    },
    "66123": {
      "id": 2634461,
      "text": "Họ vẫn còn nhận đơn không?",
      "author": "ChatGPT4.1"
    },
    "66124": {
      "id": 2634462,
      "text": "Vâng, và nếu bạn không ngại làm việc vào buổi tối,",
      "author": "ChatGPT4.1"
    },
    "66125": {
      "id": 2634463,
      "text": "tôi nghĩ bạn có cơ hội tốt cho vị trí đó.",
      "author": "ChatGPT4.1"
    },
    "66126": {
      "id": 2634464,
      "text": "Tuy nhiên, tôi nghĩ bạn nên liên hệ với quản lý ngay bây giờ.",
      "author": "ChatGPT4.1"
    },
    "66127": {
      "id": 2634465,
      "text": "Chị ấy sẽ bắt đầu phỏng vấn trong tuần này.",
      "author": "ChatGPT4.1"
    }
  }
