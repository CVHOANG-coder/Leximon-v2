  "translations": {
    "69656": {
      "id": 2591613,
      "text": "Bạn đang tìm kiếm các sản phẩm tươi ngon, chất lượng cao mà không tốn quá nhiều chi phí?",
      "author": "ChatGPT4.1"
    },
    "69657": {
      "id": 2591614,
      "text": "Hãy đến ngay Chợ Green Harvest,",
      "author": "ChatGPT4.1"
    },
    "69658": {
      "id": 2591615,
      "text": "nơi chúng tôi cung cấp đa dạng nhất các loại trái cây và rau củ tươi sạch từ nông trại trong thành phố!",
      "author": "ChatGPT4.1"
    },
    "69659": {
      "id": 2591616,
      "text": "Từ táo hữu cơ cho đến cà chua cổ truyền,",
      "author": "ChatGPT4.1"
    },
    "69660": {
      "id": 2591617,
      "text": "chúng tôi đảm bảo có sản phẩm cho mọi khẩu vị và chế độ ăn uống.",
      "author": "ChatGPT4.1"
    },
    "69661": {
      "id": 2591618,
      "text": "Thêm vào đó, chúng tôi cam kết về độ tươi mới của tất cả sản phẩm.",
      "author": "ChatGPT4.1"
    },
    "69662": {
      "id": 2591619,
      "text": "Nếu bạn không hài lòng với bất kỳ mặt hàng nào đã mua,",
      "author": "ChatGPT4.1"
    },
    "69663": {
      "id": 2591620,
      "text": "hãy hoàn trả sản phẩm trong vòng ba ngày làm việc để được hoàn tiền đầy đủ, không cần giải thích!",
      "author": "ChatGPT4.1"
    },
    "69664": {
      "id": 2591621,
      "text": "Chúng tôi vừa ra mắt dịch vụ giao hàng tận nơi hấp dẫn, mang nông trại đến tận cửa nhà bạn.",
      "author": "ChatGPT4.1"
    },
    "69665": {
      "id": 2591622,
      "text": "Bây giờ bạn có thể nhận được thực phẩm theo mùa yêu thích mà không cần rời khỏi nhà.",
      "author": "ChatGPT4.1"
    },
    "69666": {
      "id": 2591623,
      "text": "Đây là lựa chọn thuận tiện cho các gia đình bận rộn và các chuyên gia.",
      "author": "ChatGPT4.1"
    },
    "69667": {
      "id": 2591624,
      "text": "Hãy đến thăm chúng tôi tại 210 Maple Lane và tìm hiểu thêm về các sản phẩm tốt cho sức khỏe của chúng tôi!",
      "author": "ChatGPT4.1"
    }
  }
}
