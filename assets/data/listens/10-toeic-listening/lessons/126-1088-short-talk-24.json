    },
    "53205": {
      "id": 897770,
      "text": "Các sân này được phát triển như một phần của sáng kiến \"Trở nên khỏe mạnh\" của chúng ta,",
      "author": "a user"
    },
    "53209": {
      "id": 897795,
      "text": "Trước khi các sân mở cửa cho công chúng,",
      "author": "a user"
    },
    "53212": {
      "id": 897799,
      "text": "Hãy đi bộ đến quầy bán hàng để bắt đầu chuyến tham quan của chúng ta.",
      "author": "a user"
    },
    "53201": {
      "id": 2603772,
      "text": "Chào mừng đến với Cánh đồng Xanh của chúng tôi.",
      "author": "ChatGPT4.1"
    },
    "53202": {
      "id": 2603773,
      "text": "Chúng ta đã tụ họp ở đây tối nay để thông báo một điều đặc biệt.",
      "author": "ChatGPT4.1"
    },
    "53204": {
      "id": 2603774,
      "text": "Tôi tự hào thông báo rằng các sân bóng đá mới đã được mở cửa.",
      "author": "ChatGPT4.1"
    },
    "53206": {
      "id": 2603775,
      "text": "nhằm mục đích giúp giới trẻ rời xa màn hình và vận động nhiều hơn.",
      "author": "ChatGPT4.1"
    },
    "53207": {
      "id": 2603776,
      "text": "Rõ ràng đây chỉ là một phần của kế hoạch,",
      "author": "ChatGPT4.1"
    },
    "53208": {
      "id": 2603777,
      "text": "nhưng chúng tôi tin rằng điều này sẽ khiến các em nhỏ hào hứng.",
      "author": "ChatGPT4.1"
    },
    "53210": {
      "id": 2603778,
      "text": "đây là cơ hội tuyệt vời để chụp ảnh các sân cỏ xanh",
      "author": "ChatGPT4.1"
    },
    "53211": {
      "id": 2603779,
