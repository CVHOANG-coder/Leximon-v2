  "translations": {
    "55902": {
      "id": 2592127,
      "text": "Chào mừng trở lại WNCI, nơi bạn sẽ nghe những bản hit vĩ đại nhất của Pittsburgh.",
      "author": "ChatGPT4.1"
    },
    "55903": {
      "id": 2592128,
      "text": "Sau đây là bản tin địa phương về việc khôi phục Hillside Manor.",
      "author": "ChatGPT4.1"
    },
    "55904": {
      "id": 2592129,
      "text": "Các quan chức thành phố đã cập nhật về việc trùng tu dinh thự này,",
      "author": "ChatGPT4.1"
    },
    "55905": {
      "id": 2592130,
      "text": "bao gồm cả chi phí và ngày hoàn thành mới nhất.",
      "author": "ChatGPT4.1"
    },
    "55906": {
      "id": 2592131,
      "text": "Ủy viên hội đồng Ronnie Parsons đã đưa ra thông báo rằng dự án đang được thực hiện đúng tiến độ",
      "author": "ChatGPT4.1"
    },
    "55907": {
      "id": 2592132,
      "text": "và dự kiến hoàn thành vào cuối tháng Tư.",
      "author": "ChatGPT4.1"
    },
    "55908": {
      "id": 2592133,
      "text": "Ông cũng rất vui mừng thông báo rằng việc trùng tu đang diễn ra với chi phí thấp hơn ngân sách,",
      "author": "ChatGPT4.1"
    },
    "55909": {
      "id": 2592134,
      "text": "với khoản dư 100.000 đô la để chi cho khu vực xung quanh.",
      "author": "ChatGPT4.1"
    },
    "55910": {
      "id": 2592135,
      "text": "Hội đồng thành phố kỳ vọng việc khôi phục sẽ mang lại việc làm và du lịch trở lại Pittsburgh.",
      "author": "ChatGPT4.1"
    },
    "55911": {
      "id": 2592136,
      "text": "Để biết thêm chi tiết, hãy truy cập trang web của Hội đồng thành phố Pittsburgh.",
      "author": "ChatGPT4.1"
    }
  }
