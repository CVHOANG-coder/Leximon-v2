    },
    "55868": {
      "id": 2650578,
      "text": "Tôi đã mua chiếc máy ảnh kỹ thuật số này không lâu trước đây từ cửa hàng của bạn,",
      "author": "ChatGPT4.1"
    },
    "55869": {
      "id": 2650579,
      "text": "nhưng gần đây các bức ảnh chụp bị mờ,",
      "author": "ChatGPT4.1"
    },
    "55870": {
      "id": 2650580,
      "text": "và chế độ lấy nét tự động của nó có vẻ khá chậm.",
      "author": "ChatGPT4.1"
    },
    "55871": {
      "id": 2650581,
      "text": "Tôi có thể xem máy ảnh của bạn không?",
      "author": "ChatGPT4.1"
    },
    "55872": {
      "id": 2650582,
      "text": "Ừm... Tôi nghĩ tôi đã tìm ra vấn đề.",
      "author": "ChatGPT4.1"
    },
    "55873": {
      "id": 2650583,
      "text": "Theo bảng tra cứu của tôi, mã lỗi trên màn hình cho thấy có gì đó không ổn với ống kính.",
      "author": "ChatGPT4.1"
    },
    "55874": {
      "id": 2650584,
      "text": "Nghe có vẻ nghiêm trọng đấy.",
      "author": "ChatGPT4.1"
    },
    "55875": {
      "id": 2650585,
      "text": "Thay ống kính thì tốn bao nhiêu tiền?",
      "author": "ChatGPT4.1"
    },
    "55876": {
      "id": 2650586,
      "text": "À, bảo hành của chúng tôi áp dụng cho sản phẩm trong vòng một năm.",
      "author": "ChatGPT4.1"
    },
    "55877": {
      "id": 2650587,
      "text": "Bạn có nhớ mình đã mua nó khi nào không?",
      "author": "ChatGPT4.1"
    },
    "55878": {
      "id": 2650588,
      "text": "Chỉ mới năm tháng trước thôi.",
      "author": "ChatGPT4.1"
    },
    "55879": {
      "id": 2650589,
      "text": "Đây, tôi có hóa đơn đây.",
