  "translations": {
    "70033": {
      "id": 2643041,
      "text": "Chào buổi chiều, mọi người.",
      "author": "ChatGPT4.1"
    },
    "70034": {
      "id": 2643042,
      "text": "Tôi xin gửi lời chúc mừng chân thành đến từng người vì đã được chọn làm những lãnh đạo mới nhất của đội ngũ hỗ trợ khách hàng của chúng ta.",
      "author": "ChatGPT4.1"
    },
    "70035": {
      "id": 2643043,
      "text": "Đây là một thành tựu quan trọng mà ít người có thể đạt được.",
      "author": "ChatGPT4.1"
    },
    "70036": {
      "id": 2643044,
      "text": "Hôm nay, chúng ta sẽ cùng xem xét những quyền lợi đi kèm với vai trò quản lý mới của các bạn.",
      "author": "ChatGPT4.1"
    },
    "70037": {
      "id": 2643045,
      "text": "Xin vui lòng lật sang trang 18 của sổ tay lãnh đạo mà tôi đã phát lúc trước.",
      "author": "ChatGPT4.1"
    },
    "70038": {
      "id": 2643046,
      "text": "Hôm nay chúng ta sẽ không thảo luận về việc điều chỉnh lương,",
      "author": "ChatGPT4.1"
    },
    "70039": {
      "id": 2643047,
      "text": "vì tất cả mọi người đều nhận được mức tăng lương theo tỷ lệ như nhau.",
      "author": "ChatGPT4.1"
    },
    "70040": {
      "id": 2643048,
      "text": "Tuy nhiên, một số quyền lợi khác mang tính chi tiết cần chúng ta chú ý.",
      "author": "ChatGPT4.1"
    },
    "70041": {
      "id": 2643049,
      "text": "Bạn sẽ thấy có nhiều gói chăm sóc sức khỏe khác nhau để lựa chọn.",
      "author": "ChatGPT4.1"
    },
    "70042": {
      "id": 2643050,
      "text": "Xin hãy đảm bảo rằng bạn xem xét kỹ lưỡng trước khi chọn gói phù hợp nhất với nhu cầu của mình.",
      "author": "ChatGPT4.1"
    }
  }
