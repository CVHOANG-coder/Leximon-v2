  "translations": {
    "70251": {
      "id": 2638880,
      "text": "Chào buổi sáng, và chào mừng các bạn đến với hội thảo về Làm vườn bền vững tại nhà.",
      "author": "ChatGPT4.1"
    },
    "70252": {
      "id": 2638881,
      "text": "Tôi sẽ là người hướng dẫn các bạn hôm nay.",
      "author": "ChatGPT4.1"
    },
    "70253": {
      "id": 2638882,
      "text": "Tên tôi là Raymond Wolfe, và tôi làm việc tại Vườn Greenleaf.",
      "author": "ChatGPT4.1"
    },
    "70254": {
      "id": 2638883,
      "text": "Tôi rất vui khi thấy nhiều người ở đây, vì chúng ta sẽ nói về một chủ đề quan trọng có thể giúp bất kỳ ai muốn sống thân thiện với môi trường hơn.",
      "author": "ChatGPT4.1"
    },
    "70255": {
      "id": 2638884,
      "text": "Mỗi người đều có một bản lịch trình hôm nay, trong đó ghi rõ những gì chúng ta sẽ làm.",
      "author": "ChatGPT4.1"
    },
    "70256": {
      "id": 2638885,
      "text": "Buổi nói chuyện này sẽ kéo dài khoảng hai tiếng, kết thúc ngay trước giờ nghỉ trưa của chúng ta vào lúc 12 giờ.",
      "author": "ChatGPT4.1"
    },
    "70257": {
      "id": 2638886,
      "text": "Sau bữa trưa, lúc 1 giờ chiều, chúng ta sẽ bắt đầu phiên làm việc buổi chiều.",
      "author": "ChatGPT4.1"
    },
    "70258": {
      "id": 2638887,
      "text": "Trong phần đó, một chuyên gia làm vườn khác, Jamie Waters, sẽ hướng dẫn chúng ta cách làm phân hữu cơ.",
      "author": "ChatGPT4.1"
    },
    "70259": {
      "id": 2638888,
      "text": "Được rồi, chúng ta bắt đầu nhé.",
      "author": "ChatGPT4.1"
    }
  }
