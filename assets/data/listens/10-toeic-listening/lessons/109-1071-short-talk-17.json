  "translations": {
    "52969": {
      "id": 876563,
      "text": "Ban đầu chúng ta dự định tổ chức bài giảng về hàng dệt may bền vững trong ngành thời trang vào cuối buổi chiều nay.",
      "author": "a user"
    },
    "52971": {
      "id": 878360,
      "text": "chúng ta sẽ cần dời nó sang sáng thứ Tư.",
      "author": "a user"
    },
    "52972": {
      "id": 889875,
      "text": "Thêm vào đó, chúng tôi sẽ thay đổi thời gian của buổi diễn thuyết về các xu hướng phương Tây sang chiều thứ Năm.",
      "author": "a user"
    },
    "52974": {
      "id": 889883,
      "text": "Vậy chúng tôi sẽ đăng chương trình họp đã cập nhật lên mạng trong khoảng một giờ nữa.",
      "author": "a user"
    },
    "52967": {
      "id": 2592519,
      "text": "Mọi người chú ý lắng nghe.",
      "author": "ChatGPT4.1"
    },
    "52968": {
      "id": 2592520,
      "text": "Tôi cần thông báo cho tất cả các bạn về một sự thay đổi trong lịch trình hội nghị.",
      "author": "ChatGPT4.1"
    },
    "52970": {
      "id": 2592521,
      "text": "Do chuyến bay của giảng viên bị hoãn,",
      "author": "ChatGPT4.1"
    },
    "52973": {
      "id": 2592522,
      "text": "Hiện tại, do việc sắp xếp lại này, chúng ta đã phải thay đổi địa điểm của một số sự kiện,",
      "author": "ChatGPT4.1"
    },
    "52975": {
      "id": 2592523,
      "text": "Cuối cùng, Giáo sư Victoria Sky, giám đốc ngành thời trang tại Đại học New York,",
      "author": "ChatGPT4.1"
    },
    "52976": {
      "id": 2592524,
      "text": "sẽ đến vào chiều nay để tham gia các sự kiện cùng chúng ta và phát biểu.",
      "author": "ChatGPT4.1"
    },
    "52977": {
      "id": 2592525,
      "text": "Chúng ta rất may mắn khi có cô ấy ở đây, nên tôi mong mọi người sẽ có mặt tại buổi phát biểu của cô ấy.",
      "author": "ChatGPT4.1"
    }
  }
}
