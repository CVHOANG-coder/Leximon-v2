  "translations": {
    "69158": {
      "id": 2588488,
      "text": "Chào buổi sáng, cô Clayton.",
      "author": "ChatGPT4.1"
    },
    "69159": {
      "id": 2588489,
      "text": "Tôi là David Lee từ công ty bảo hiểm SafeGuard, liên hệ lại sau tin nhắn thoại mà cô đã để lại cho tôi ngày hôm qua.",
      "author": "ChatGPT4.1"
    },
    "69160": {
      "id": 2588490,
      "text": "Cô đã bày tỏ sự quan tâm muốn tìm hiểu thêm về các lựa chọn bảo hiểm nhà của chúng tôi.",
      "author": "ChatGPT4.1"
    },
    "69161": {
      "id": 2588491,
      "text": "Gói bảo hiểm toàn diện nhất của chúng tôi là Elite Home Shield.",
      "author": "ChatGPT4.1"
    },
    "69162": {
      "id": 2588492,
      "text": "Gói này cung cấp mức bảo hiểm lên đến 500.000 đô la Mỹ.",
      "author": "ChatGPT4.1"
    },
    "69163": {
      "id": 2588493,
      "text": "Đây là một lựa chọn tuyệt vời cho những chủ nhà đang tìm kiếm sự bảo vệ toàn diện.",
      "author": "ChatGPT4.1"
    },
    "69164": {
      "id": 2588494,
      "text": "Mức phí bảo hiểm cho gói này có thể thay đổi tùy vào các đặc điểm cụ thể của ngôi nhà, như vị trí và kích thước.",
      "author": "ChatGPT4.1"
    },
    "69165": {
      "id": 2588495,
      "text": "Vì vậy tôi cần thêm một số thông tin để có thể cung cấp cho cô một báo giá chính xác.",
      "author": "ChatGPT4.1"
    },
    "69166": {
      "id": 2588496,
      "text": "Xin vui lòng gọi cho tôi khi thuận tiện nhất để cung cấp những thông tin đó.",
      "author": "ChatGPT4.1"
    }
  }
}
