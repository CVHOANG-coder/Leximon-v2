  "translations": {
    "64246": {
      "id": 1444523,
      "text": "Tôi rất vui mừng khi chia sẻ rằng chiến lược tiếp thị tập trung vào gia đình gần đây của chúng ta đã thành công rực rỡ!",
      "author": "a user"
    },
    "64247": {
      "id": 1444524,
      "text": "Quảng cáo trực tuyến của chúng ta thực sự đã thúc đẩy độ nhận diện thương hiệu rất tốt,",
      "author": "a user"
    },
    "64249": {
      "id": 1444526,
      "text": "Chúng ta cũng đã chứng kiến sự gia tăng các sự kiện trong phòng tiệc,",
      "author": "a user"
    },
    "64250": {
      "id": 1444538,
      "text": "và chúng ta rất vinh dự khi được là địa điểm chính thức tổ chức Hội nghị Mẹ và Bé vào tháng 11 này.",
      "author": "a user"
    },
    "64245": {
      "id": 2592455,
      "text": "Là trưởng phòng marketing của Khách sạn Cheshire Country,",
      "author": "ChatGPT4.1"
    },
    "64248": {
      "id": 2592456,
      "text": "dẫn đến sự gia tăng đáng kể trong các lượt đặt phòng.",
      "author": "ChatGPT4.1"
    },
    "64251": {
      "id": 2592457,
      "text": "Để chuẩn bị, chúng tôi sẽ tổ chức các buổi họp phát triển cá nhân vào mỗi thứ Ba lúc 9 giờ sáng,",
      "author": "ChatGPT4.1"
    },
    "64252": {
      "id": 2592458,
      "text": "bắt đầu từ tuần sau cho đến tháng 11.",
      "author": "ChatGPT4.1"
    }
  }
