  "translations": {
    "53218": {
      "id": 897810,
      "text": "Hành khách được khuyến nghị nên dành thêm thời gian,",
      "author": "a user"
    },
    "53213": {
      "id": 2582952,
      "text": "Chúng tôi muốn nhắc nhở hành khách về việc thi công đường sắt sẽ diễn ra trong ba ngày tới",
      "author": "ChatGPT4.1"
    },
    "53214": {
      "id": 2582953,
      "text": "dọc theo tuyến phía bắc vào Manchester.",
      "author": "ChatGPT4.1"
    },
    "53215": {
      "id": 2582954,
      "text": "Tuyến đường sắt sẽ được thay thế bắt đầu từ ga Wilmslow và kết thúc tại ga Levenshulme,",
      "author": "ChatGPT4.1"
    },
    "53216": {
      "id": 2582955,
      "text": "điều này đã bị trì hoãn từ lâu.",
      "author": "ChatGPT4.1"
    },
    "53217": {
      "id": 2582956,
      "text": "Cơ quan giao thông vận tải mong đợi việc này sẽ ngăn chặn các sự chậm trễ đã xảy ra trong những năm gần đây.",
      "author": "ChatGPT4.1"
    },
    "53219": {
      "id": 2582957,
      "text": "do sẽ có xe buýt đưa đón phục vụ những ai muốn đi tàu.",
      "author": "ChatGPT4.1"
    },
    "53220": {
      "id": 2582958,
      "text": "Ngoài ra, tuyến Piccadilly sẽ hoạt động, chạy theo lộ trình tương tự.",
      "author": "ChatGPT4.1"
    }
  }
