  "translations": {
    "52898": {
      "id": 869789,
      "text": "Cửa hàng của bạn đang có đợt xả hàng cuối năm trong tháng này phải không?",
      "author": "a user"
    },
    "52900": {
      "id": 869791,
      "text": "Tuy nhiên, tôi tò mò liệu chương trình giảm giá có áp dụng cho tất cả các sản phẩm đang được trưng bày không?",
      "author": "a user"
    },
    "52901": {
      "id": 869792,
      "text": "Chắc chắn rồi, chúng đều được giảm giá 60% so với giá bán lẻ.",
      "author": "a user"
    },
    "52904": {
      "id": 869795,
      "text": "Thực ra thì tôi có, nhưng tôi để nó ở văn phòng.",
      "author": "a user"
    },
    "52905": {
      "id": 869796,
      "text": "Tôi nên đi ngay bây giờ,",
      "author": "a user"
    },
    "52903": {
      "id": 931505,
      "text": "bạn có thể được giảm thêm 5% chỉ cần sử dụng thẻ tín dụng của ngân hàng.",
      "author": "a user"
    },
    "52897": {
      "id": 2634508,
      "text": "Chào bạn.",
      "author": "ChatGPT4.1"
    },
    "52899": {
      "id": 2634509,
      "text": "Tôi đã thấy quảng cáo trên Internet.",
      "author": "ChatGPT4.1"
    },
    "52902": {
      "id": 2634510,
      "text": "Chỉ hôm nay, nếu bạn có thẻ tín dụng của Ngân hàng Wsun,",
      "author": "ChatGPT4.1"
    },
    "52906": {
      "id": 2634511,
      "text": "nhưng chắc chắn tôi sẽ quay lại để nhận thêm ưu đãi giảm giá đó.",
      "author": "ChatGPT4.1"
    }
  }
