  "translations": {
    "55299": {
      "id": 2645340,
      "text": "Chào mừng đến với Daily Morning Show, cùng Hannah Jeffers.",
      "author": "ChatGPT4.1"
    },
    "55300": {
      "id": 2645341,
      "text": "Chúng tôi có một vị khách đặc biệt hôm nay,",
      "author": "ChatGPT4.1"
    },
    "55301": {
      "id": 2645342,
      "text": "người nổi tiếng với công việc của mình trong các bộ phim quốc tế",
      "author": "ChatGPT4.1"
    },
    "55302": {
      "id": 2645343,
      "text": "như The Glass Door và The Babysitter's Nightmare.",
      "author": "ChatGPT4.1"
    },
    "55303": {
      "id": 2645344,
      "text": "Bộ phim bom tấn gần đây nhất của anh, Who Haunts, đã được đề cử ba giải thưởng.",
      "author": "ChatGPT4.1"
    },
    "55304": {
      "id": 2645345,
      "text": "Gần đây, anh ấy đã đảm nhận một vai trò mới,",
      "author": "ChatGPT4.1"
    },
    "55305": {
      "id": 2645346,
      "text": "trở thành thành viên ban quản trị của tổ chức The Children's Hope,",
      "author": "ChatGPT4.1"
    },
    "55306": {
      "id": 2645347,
      "text": "một tổ chức từ thiện quốc gia cung cấp bút, giấy và bút chì cho trẻ em vô gia cư.",
      "author": "ChatGPT4.1"
    },
    "55307": {
      "id": 2645348,
      "text": "Anh ấy sẽ kể cho chúng ta nghe về tổ chức đó,",
      "author": "ChatGPT4.1"
    },
    "55308": {
      "id": 2645349,
      "text": "và những gì anh ấy tin là cần thay đổi trong cộng đồng địa phương.",
      "author": "ChatGPT4.1"
    },
    "55309": {
      "id": 2645350,
      "text": "Bây giờ, không để quý vị phải đợi lâu hơn nữa, tôi xin giới thiệu Sam Clark.",
      "author": "ChatGPT4.1"
    }
  }
