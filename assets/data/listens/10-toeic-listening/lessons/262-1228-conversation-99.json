  "translations": {
    "55216": {
      "id": 966944,
      "text": "Vâng, đó là đơn hàng ban đầu của cô ấy.",
      "author": "a user"
    },
    "55222": {
      "id": 966950,
      "text": "Chà, tôi đã biết cô ấy mười lăm năm và tôi chưa bao giờ biết cô ấy thay đổi đơn hàng.",
      "author": "a user"
    },
    "55213": {
      "id": 2588524,
      "text": "Chào Sarah. Alexandria Madden vừa gọi về đơn hàng gần đây của cô ấy.",
      "author": "ChatGPT4.1"
    },
    "55214": {
      "id": 2588525,
      "text": "Ồ, tôi thấy đơn hàng của cô ấy đã đến.",
      "author": "ChatGPT4.1"
    },
    "55215": {
      "id": 2588526,
      "text": "Cô ấy đã đặt năm mươi thùng nước soda cho nhà hàng của mình, đúng không?",
      "author": "ChatGPT4.1"
    },
    "55217": {
      "id": 2588527,
      "text": "Cô ấy đã bị hủy một sự kiện lớn,",
      "author": "ChatGPT4.1"
    },
    "55218": {
      "id": 2588528,
      "text": "nên bây giờ cô ấy chỉ cần hai mươi thùng.",
      "author": "ChatGPT4.1"
    },
    "55219": {
      "id": 2588529,
      "text": "Thông thường chúng ta sẽ tính phí thay đổi sau khi đơn đặt hàng đã được đặt,",
      "author": "ChatGPT4.1"
    },
    "55220": {
      "id": 2588530,
      "text": "nhưng tôi không chắc liệu chúng ta có nên miễn phí đó không,",
      "author": "ChatGPT4.1"
    },
    "55221": {
      "id": 2588531,
      "text": "vì cô ấy đã là khách hàng trung thành trong nhiều năm rồi.",
      "author": "ChatGPT4.1"
    },
    "55223": {
      "id": 2588532,
      "text": "Tôi nghĩ chúng ta nên miễn phí đó.",
      "author": "ChatGPT4.1"
    },
    "55224": {
      "id": 2588533,
      "text": "Được rồi. Bạn nghĩ tôi có cần kiểm tra lại với cấp trên không?",
      "author": "ChatGPT4.1"
    },
    "55225": {
      "id": 2588534,
      "text": "Tôi không muốn gặp rắc rối.",
      "author": "ChatGPT4.1"
    },
    "55226": {
      "id": 2588535,
      "text": "Không, tôi có quyền miễn các loại phí.",
      "author": "ChatGPT4.1"
    },
    "55227": {
      "id": 2588536,
      "text": "Được rồi, tốt quá.",
      "author": "ChatGPT4.1"
    },
    "55228": {
      "id": 2588537,
      "text": "Tôi sẽ báo cho cô Madden, tôi chắc chắn cô ấy sẽ rất vui.",
      "author": "ChatGPT4.1"
    }
  }
