  "translations": {
    "70260": {
      "id": 2639102,
      "text": "Chào buổi chiều, quý vị và các bạn.",
      "author": "ChatGPT4.1"
    },
    "70261": {
      "id": 2639103,
      "text": "Chúng tôi rất vui mừng được chào đón các bạn đến với lễ khai trương trở lại của Đài quan sát Stellaris.",
      "author": "ChatGPT4.1"
    },
    "70262": {
      "id": 2639104,
      "text": "Khi các bạn vào hôm nay, các bạn sẽ thấy nhiều thay đổi trong toàn bộ tòa nhà.",
      "author": "ChatGPT4.1"
    },
    "70263": {
      "id": 2639105,
      "text": "Chúng tôi đặc biệt tự hào về các nâng cấp trong mái vòm của đài quan sát,",
      "author": "ChatGPT4.1"
    },
    "70264": {
      "id": 2639106,
      "text": "nay đã có kính thiên văn mới giúp việc ngắm sao tuyệt vời hơn nữa.",
      "author": "ChatGPT4.1"
    },
    "70265": {
      "id": 2639107,
      "text": "Để chào mừng ngày đặc biệt này,",
      "author": "ChatGPT4.1"
    },
    "70266": {
      "id": 2639108,
      "text": "nhà khoa học nổi tiếng Tiến sĩ Emma Liu sẽ có một buổi nói chuyện về khám phá mới của bà về hố đen tại Hội trường C.",
      "author": "ChatGPT4.1"
    },
    "70267": {
      "id": 2639109,
      "text": "Bài nói chuyện của bà sẽ bắt đầu muộn hơn dự kiến một tiếng vì bà đang chuẩn bị.",
      "author": "ChatGPT4.1"
    },
    "70268": {
      "id": 2639110,
      "text": "Trong lúc chờ đợi, xin mời các bạn tham quan đài quan sát và trải nghiệm các hoạt động thực tế mới của chúng tôi.",
      "author": "ChatGPT4.1"
    },
    "70269": {
      "id": 2639111,
      "text": "Chúc các bạn có một chuyến tham quan thú vị!",
      "author": "ChatGPT4.1"
    }
  }
