  "translations": {
    "55318": {
      "id": 2636792,
      "text": "Đừng bỏ lỡ Lễ hội Ẩm thực Yellowtown cuối tuần này!",
      "author": "ChatGPT4.1"
    },
    "55319": {
      "id": 2636793,
      "text": "Sự kiện thường niên đầy hứng khởi này sẽ diễn ra từ ngày 10 đến ngày 12 tháng 10 tại Công viên Trung tâm Yellowtown,",
      "author": "ChatGPT4.1"
    },
    "55320": {
      "id": 2636794,
      "text": "với hơn 50 nhà hàng địa phương tham gia.",
      "author": "ChatGPT4.1"
    },
    "55321": {
      "id": 2636795,
      "text": "Vé chỉ có 25 đô la cho toàn bộ cuối tuần.",
      "author": "ChatGPT4.1"
    },
    "55322": {
      "id": 2636796,
      "text": "Giá vé bao gồm các mẫu món ăn từ tất cả các nhà hàng tham gia,",
      "author": "ChatGPT4.1"
    },
    "55323": {
      "id": 2636797,
      "text": "bản sao công thức các món ăn yêu thích của Yellowtown và một chiếc tạp dề miễn phí!",
      "author": "ChatGPT4.1"
    },
    "55324": {
      "id": 2636798,
      "text": "Chưa hết đâu!",
      "author": "ChatGPT4.1"
    },
    "55325": {
      "id": 2636799,
      "text": "Mười khách tham dự lễ hội sẽ được chọn ngẫu nhiên để thưởng thức một bữa ăn được chuẩn bị đặc biệt cho lễ hội",
      "author": "ChatGPT4.1"
    },
    "55326": {
      "id": 2636800,
      "text": "bởi đầu bếp nổi tiếng thế giới Gordon Oliver.",
      "author": "ChatGPT4.1"
    },
    "55327": {
      "id": 2636801,
      "text": "Đâu là nhà hàng ngon nhất thị trấn?",
      "author": "ChatGPT4.1"
    },
    "55328": {
      "id": 2636802,
      "text": "Bạn hãy là người đánh giá!",
      "author": "ChatGPT4.1"
    }
  }
}
