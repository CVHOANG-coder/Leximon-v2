  "translations": {
    "70242": {
      "id": 2622448,
      "text": "Hãy đến tham dự cùng chúng tôi tại Nhà hát Văn hóa Rivera cho một buổi biểu diễn đặc biệt chỉ diễn ra một đêm cùng nghệ sĩ piano tài năng, Elena Novikov.",
      "author": "ChatGPT4.1"
    },
    "70243": {
      "id": 2622449,
      "text": "Được biết đến với những màn trình diễn đầy cảm xúc, Elena sẽ chơi một sự kết hợp giữa các bản nhạc cổ điển và hiện đại,",
      "author": "ChatGPT4.1"
    },
    "70244": {
      "id": 2622450,
      "text": "được đồng hành cùng Dàn nhạc thính phòng Riverfront nổi tiếng.",
      "author": "ChatGPT4.1"
    },
    "70245": {
      "id": 2622451,
      "text": "Sự kiện này hứa hẹn mang đến một trải nghiệm âm nhạc độc đáo và khó quên cho tất cả khán giả tham dự.",
      "author": "ChatGPT4.1"
    },
    "70246": {
      "id": 2622452,
      "text": "Sau buổi biểu diễn, bạn sẽ có cơ hội mua các bản ghi âm độc quyền những tác phẩm âm nhạc tuyệt vời của cô ấy.",
      "author": "ChatGPT4.1"
    },
    "70247": {
      "id": 2622453,
      "text": "Hãy chắc chắn đến đúng giờ, vì cửa nhà hát sẽ mở lúc 6:45 tối thứ Bảy, ngày 15 tháng 5 tới.",
      "author": "ChatGPT4.1"
    },
    "70248": {
      "id": 2622454,
      "text": "Để mua vé và đặt chỗ, vui lòng gọi phòng vé theo số 555-8342.",
      "author": "ChatGPT4.1"
    },
    "70249": {
      "id": 2622455,
      "text": "Đừng bỏ lỡ đêm nhạc đáng kinh ngạc đầy cảm xúc này.",
      "author": "ChatGPT4.1"
    },
    "70250": {
      "id": 2622456,
      "text": "Hãy đặt chỗ ngay hôm nay cho một buổi tối bạn sẽ không thể quên!",
      "author": "ChatGPT4.1"
    }
  }
}
