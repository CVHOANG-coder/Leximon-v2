  "translations": {
    "66746": {
      "id": 2582848,
      "text": "Chào buổi chiều, tôi là Russell Wilkes, gọi cho cô Merca.",
      "author": "ChatGPT4.1"
    },
    "66747": {
      "id": 2582849,
      "text": "Tôi gọi từ Canal Condos, liên quan đến yêu cầu của cô về việc sử dụng câu lạc bộ cộng đồng của chúng tôi",
      "author": "ChatGPT4.1"
    },
    "66748": {
      "id": 2582850,
      "text": "để tổ chức tiệc mừng em bé vào thứ Bảy, ngày 23 tháng 4.",
      "author": "ChatGPT4.1"
    },
    "66749": {
      "id": 2582851,
      "text": "Thật không may, chúng tôi đã phát hiện ra một vấn đề về hệ thống nước trong nhà câu lạc bộ,",
      "author": "ChatGPT4.1"
    },
    "66750": {
      "id": 2582852,
      "text": "vì vậy chúng tôi sẽ tiến hành sửa chữa vấn đề này trong vài tuần tới.",
      "author": "ChatGPT4.1"
    },
    "66751": {
      "id": 2582853,
      "text": "Chúng tôi sẽ không thể đặt bất kỳ sự kiện mới nào cho đến khi đảm bảo vấn đề hệ thống nước đã được giải quyết.",
      "author": "ChatGPT4.1"
    },
    "66752": {
      "id": 2582854,
      "text": "Tôi xin đề xuất công ty chị em của chúng tôi, Lancaster Homes,",
      "author": "ChatGPT4.1"
    },
    "66753": {
      "id": 2582855,
      "text": "vì họ có cả nhà câu lạc bộ và khu vực tổ chức sự kiện ngoài trời có thể phù hợp.",
      "author": "ChatGPT4.1"
    },
    "66754": {
      "id": 2582856,
      "text": "Bạn có thể điền vào cùng một mẫu đơn mà bạn đã sử dụng để liên hệ với chúng tôi trên trang web của họ,",
      "author": "ChatGPT4.1"
    },
    "66755": {
      "id": 2582857,
      "text": "lancasterclubhouse.com",
      "author": "ChatGPT4.1"
    }
  }
