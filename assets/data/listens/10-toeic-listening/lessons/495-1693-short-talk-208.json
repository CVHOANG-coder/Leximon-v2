  "translations": {
    "68922": {
      "id": 2587735,
      "text": "Xin chào, đây là Sophia gọi từ Phòng Khám Thú Y Oakwood.",
      "author": "ChatGPT4.1"
    },
    "68923": {
      "id": 2587736,
      "text": "Tôi liên hệ để thảo luận về kết quả xét nghiệm máu gần đây của Max.",
      "author": "ChatGPT4.1"
    },
    "68924": {
      "id": 2587737,
      "text": "Tin tốt là hầu hết các chỉ số của cậu ấy đều rất ổn,",
      "author": "ChatGPT4.1"
    },
    "68925": {
      "id": 2587738,
      "text": "nhưng có một vài điều chúng ta cần theo dõi thêm.",
      "author": "ChatGPT4.1"
    },
    "68926": {
      "id": 2587739,
      "text": "Chức năng thận của cậu ấy hơi thấp hơn mức chúng tôi mong muốn,",
      "author": "ChatGPT4.1"
    },
    "68927": {
      "id": 2587740,
      "text": "vì vậy tôi khuyên bạn nên đưa cậu ấy đến kiểm tra lại sau khoảng một tháng.",
      "author": "ChatGPT4.1"
    },
    "68928": {
      "id": 2587741,
      "text": "Chúng ta cũng có thể thảo luận về việc thay đổi chế độ ăn để hỗ trợ sức khỏe thận cho cậu ấy.",
      "author": "ChatGPT4.1"
    },
    "68929": {
      "id": 2587742,
      "text": "Xin vui lòng gọi lại cho chúng tôi khi thuận tiện nhất để đặt lịch hẹn.",
      "author": "ChatGPT4.1"
    },
    "68930": {
      "id": 2587743,
      "text": "Xin cảm ơn.",
      "author": "ChatGPT4.1"
    }
  }
