  "translations": {
    "53242": {
      "id": 892911,
      "text": "Hiện tại, chúng ta đang ở trong phòng tiếp tân thân mật hơn,",
      "author": "a user"
    },
    "53248": {
      "id": 892919,
      "text": "Và xin mời quý vị thưởng thức các món khai vị đang được phục vụ,",
      "author": "a user"
    },
    "53238": {
      "id": 2606558,
      "text": "Chào mừng bạn đến với ngày hội mở cửa của Juniper Hall.",
      "author": "ChatGPT4.1"
    },
    "53239": {
      "id": 2606559,
      "text": "Tôi không nghi ngờ gì rằng các bạn sẽ ấn tượng với những tính năng tuyệt vời của hội trường,",
      "author": "ChatGPT4.1"
    },
    "53240": {
      "id": 2606560,
      "text": "từ các phòng tiếp tân đến thực đơn phục vụ tiệc.",
      "author": "ChatGPT4.1"
    },
    "53241": {
      "id": 2606561,
      "text": "Hôm nay, tôi sẽ giới thiệu cho bạn tất cả các lựa chọn để bạn tổ chức đám cưới của mình tại Juniper.",
      "author": "a user"
    },
    "53243": {
      "id": 2606562,
      "text": "mà chúng tôi gọi là Phòng Hoa Hồng,",
      "author": "ChatGPT4.1"
    },
    "53244": {
      "id": 2606563,
      "text": "có thể chứa được 50 khách.",
      "author": "ChatGPT4.1"
    },
    "53245": {
      "id": 2606564,
      "text": "Tiếp theo, chúng ta sẽ ghé thăm Phòng Hoa Tulip của chúng tôi,",
      "author": "ChatGPT4.1"
    },
    "53246": {
      "id": 2606565,
      "text": "có thể phục vụ 100 khách.",
      "author": "ChatGPT4.1"
    },
    "53247": {
      "id": 2606566,
      "text": "Tôi sẽ dành thời gian cho bạn tham quan cả hai phòng,",
      "author": "ChatGPT4.1"
    },
    "53249": {
      "id": 2606567,
      "text": "tất cả đều có thể là lựa chọn cho ngày đặc biệt của bạn.",
      "author": "ChatGPT4.1"
    },
    "53250": {
      "id": 2606568,
      "text": "Hãy nhớ rằng, nếu bạn đặt chỗ với tôi trước khi kết thúc ngày hôm nay,",
      "author": "ChatGPT4.1"
    },
    "53251": {
      "id": 2606569,
      "text": "bạn sẽ được giảm 10% phí thuê phòng.",
      "author": "ChatGPT4.1"
    }
  }
}
