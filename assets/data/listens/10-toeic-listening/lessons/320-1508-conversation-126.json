  "translations": {
    "65625": {
      "id": 2619902,
      "text": "Chào mọi người!",
      "author": "ChatGPT4.1"
    },
    "65626": {
      "id": 2619903,
      "text": "Các bạn đã nghe tin tốt chưa?",
      "author": "ChatGPT4.1"
    },
    "65627": {
      "id": 2619904,
      "text": "Các buổi học ngôn ngữ được trông đợi từ lâu cuối cùng cũng sẽ bắt đầu vào đầu tháng sau!",
      "author": "ChatGPT4.1"
    },
    "65628": {
      "id": 2619905,
      "text": "Wow, thật là tin tuyệt vời!",
      "author": "ChatGPT4.1"
    },
    "65629": {
      "id": 2619906,
      "text": "Tôi nghĩ tất cả nhân viên đều đã mong chờ điều này.",
      "author": "ChatGPT4.1"
    },
    "65630": {
      "id": 2619907,
      "text": "Tôi chắc chắn là vậy.",
      "author": "ChatGPT4.1"
    },
    "65631": {
      "id": 2619908,
      "text": "Theo những gì tôi hiểu,",
      "author": "ChatGPT4.1"
    },
    "65632": {
      "id": 2619909,
      "text": "lớp học tiếng Trung lẽ ra chưa bắt đầu cho đến sau năm mới.",
      "author": "ChatGPT4.1"
    },
    "65633": {
      "id": 2619910,
      "text": "Tôi không thể chờ thêm được nữa!",
      "author": "ChatGPT4.1"
    },
    "65634": {
      "id": 2619911,
      "text": "Tôi vừa nghe điều đó từ tổng quản lý.",
      "author": "ChatGPT4.1"
    },
    "65635": {
      "id": 2619912,
      "text": "Chúng sẽ bắt đầu vào ngày 2 tháng 11.",
      "author": "ChatGPT4.1"
    },
    "65636": {
      "id": 2619913,
      "text": "Ừ, tôi rất vui vì họ đã đẩy sớm lịch trình.",
      "author": "ChatGPT4.1"
    },
    "65637": {
      "id": 2619914,
      "text": "Gần 30% khách của khách sạn là người Trung Quốc,",
      "author": "ChatGPT4.1"
    },
    "65638": {
      "id": 2619915,
      "text": "và giao tiếp có thể gặp nhiều khó khăn,",
      "author": "ChatGPT4.1"
    },
    "65639": {
      "id": 2619916,
      "text": "và tôi ghét việc không thể phục vụ tốt.",
      "author": "ChatGPT4.1"
    },
    "65640": {
      "id": 2619917,
      "text": "Tôi biết mà!",
      "author": "ChatGPT4.1"
    },
    "65641": {
      "id": 2619918,
      "text": "Ngay cả khi chúng ta chỉ học những điều cơ bản,",
      "author": "ChatGPT4.1"
    },
    "65642": {
      "id": 2619919,
      "text": "nó cũng sẽ giúp việc nhận và trả phòng trôi chảy hơn,",
      "author": "ChatGPT4.1"
    },
    "65643": {
      "id": 2619920,
      "text": "và tôi chắc chắn khách sẽ đánh giá cao nỗ lực học ngôn ngữ của chúng ta.",
      "author": "ChatGPT4.1"
    },
    "65644": {
      "id": 2619921,
      "text": "Tôi đồng ý!",
      "author": "ChatGPT4.1"
    },
    "65645": {
      "id": 2619922,
      "text": "Nhưng, tôi đã rất ngạc nhiên khi biết rằng các lớp này sẽ là bắt buộc",
      "author": "ChatGPT4.1"
    },
    "65646": {
      "id": 2619923,
      "text": "và họ sẽ sử dụng sự tham gia của chúng ta trong đánh giá nhân viên",
      "author": "ChatGPT4.1"
    },
    "65647": {
      "id": 2619924,
      "text": "để giúp quyết định việc thăng chức và tăng lương.",
      "author": "ChatGPT4.1"
    },
    "65648": {
      "id": 2619925,
      "text": "Tôi không biết điều đó!",
      "author": "ChatGPT4.1"
    },
    "65649": {
      "id": 2619926,
      "text": "Bây giờ, tôi thấy hơi kém hào hứng hơn một chút,",
      "author": "ChatGPT4.1"
    },
    "65650": {
      "id": 2619927,
      "text": "nghe có vẻ hơi căng thẳng đấy.",
      "author": "ChatGPT4.1"
    }
  }
