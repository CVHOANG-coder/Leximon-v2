  "translations": {
    "68408": {
      "id": 2589897,
      "text": "Chào bạn, tôi là Emily từ tiệm bánh Bella's Bakery.",
      "author": "ChatGPT4.1"
    },
    "68409": {
      "id": 2589898,
      "text": "Chỉ muốn xác nhận lại đơn đặt bánh của bạn cho ngày thứ Bảy.",
      "author": "ChatGPT4.1"
    },
    "68410": {
      "id": 2589899,
      "text": "Bạn đã đặt một chiếc bánh sô-cô-la với nhân mâm xôi và một thông điệp tùy chỉnh trên mặt bánh, đúng không?",
      "author": "ChatGPT4.1"
    },
    "68411": {
      "id": 2589900,
      "text": "Nếu bạn cần thay đổi gì, vui lòng thông báo cho chúng tôi trước chiều mai.",
      "author": "ChatGPT4.1"
    },
    "68412": {
      "id": 2589901,
      "text": "Chúng tôi cũng cung cấp dịch vụ giao hàng nếu điều đó thuận tiện hơn cho bạn.",
      "author": "ChatGPT4.1"
    },
    "68413": {
      "id": 2589902,
      "text": "Nếu không, bánh sẽ sẵn sàng để lấy bất cứ lúc nào sau 10 giờ sáng thứ Bảy.",
      "author": "ChatGPT4.1"
    },
    "68414": {
      "id": 2589903,
      "text": "Cảm ơn bạn một lần nữa vì đã chọn chúng tôi,",
      "author": "ChatGPT4.1"
    },
    "68415": {
      "id": 2589904,
      "text": "Và chúng tôi mong được góp phần làm cho buổi tiệc của bạn thêm ngọt ngào!",
      "author": "a user"
    }
  }
