  "translations": {
    "54772": {
      "id": 2648655,
      "text": "Bạn đã gọi đến Lawler and Co, một công ty từng đoạt giải thưởng, cung cấp dịch vụ pháp lý hình sự trên toàn nước Mỹ.",
      "author": "ChatGPT4.1"
    },
    "54773": {
      "id": 2648656,
      "text": "Văn phòng của chúng tôi đóng cửa vào cuối tuần",
      "author": "ChatGPT4.1"
    },
    "54774": {
      "id": 2648657,
      "text": "và sẽ mở cửa lại vào sáng thứ Hai lúc 9 giờ.",
      "author": "ChatGPT4.1"
    },
    "54775": {
      "id": 2648658,
      "text": "Chúng tôi làm việc từ thứ Hai đến thứ Sáu, từ 9 giờ sáng đến 5 giờ 30 chiều.",
      "author": "ChatGPT4.1"
    },
    "54776": {
      "id": 2648659,
      "text": "Nếu đây là việc khẩn cấp, vui lòng gửi email đến emergencies@lawlerandco.com kèm theo số điện thoại và tình huống của bạn.",
      "author": "ChatGPT4.1"
    },
    "54777": {
      "id": 2648660,
      "text": "Đối với các tin nhắn khác, vui lòng để lại lời nhắn cùng thông tin liên lạc của bạn",
      "author": "ChatGPT4.1"
    },
    "54778": {
      "id": 2648661,
      "text": "và chúng tôi sẽ liên lạc lại với bạn sớm nhất có thể.",
      "author": "ChatGPT4.1"
    },
    "54779": {
      "id": 2648662,
      "text": "Cảm ơn bạn đã gọi, và chúng tôi sẽ liên lạc với bạn sớm.",
      "author": "ChatGPT4.1"
    }
  }
