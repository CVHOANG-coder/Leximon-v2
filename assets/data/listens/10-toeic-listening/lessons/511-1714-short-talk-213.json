  "translations": {
    "69182": {
      "id": 2077711,
      "text": "Chúng tôi trân trọng sự thông cảm và ủng hộ của bạn.",
      "author": "a user"
    },
    "69176": {
      "id": 2588610,
      "text": "Cảm ơn bạn đã liên hệ với Lakeside Bistro,",
      "author": "ChatGPT4.1"
    },
    "69177": {
      "id": 2588611,
      "text": "điểm đến hàng đầu cho trải nghiệm ẩm thực hiện đại tại Dallas.",
      "author": "ChatGPT4.1"
    },
    "69178": {
      "id": 2588612,
      "text": "Xin lưu ý, chúng tôi sẽ điều chỉnh giờ hoạt động vào ngày 15 và 16 tháng 7",
      "author": "ChatGPT4.1"
    },
    "69179": {
      "id": 2588613,
      "text": "vì đội ngũ của chúng tôi sẽ tham gia Sự kiện Ẩm thực Thường niên.",
      "author": "ChatGPT4.1"
    },
    "69180": {
      "id": 2588614,
      "text": "Vào những ngày này, chúng tôi sẽ đóng cửa sớm lúc 2 giờ chiều.",
      "author": "ChatGPT4.1"
    },
    "69181": {
      "id": 2588615,
      "text": "Giờ hoạt động bình thường từ 12 giờ trưa đến 11 giờ đêm sẽ trở lại vào Thứ Hai, ngày 17 tháng 7.",
      "author": "ChatGPT4.1"
    },
    "69183": {
      "id": 2588616,
      "text": "Để xem thực đơn của chúng tôi, vui lòng bấm phím một.",
      "author": "ChatGPT4.1"
    },
    "69184": {
      "id": 2588617,
      "text": "Để đặt bàn, bấm phím hai",
      "author": "ChatGPT4.1"
    },
    "69185": {
      "id": 2588618,
      "text": "và để lại tên, thông tin liên hệ, cùng thời gian đặt bàn mong muốn sau tiếng bíp.",
      "author": "ChatGPT4.1"
    },
    "69186": {
      "id": 2588619,
      "text": "Thông tin chi tiết hơn về Sự kiện Ẩm thực Thường niên có thể được tìm thấy trên trang web của chúng tôi.",
      "author": "ChatGPT4.1"
    }
  }
