  "translations": {
    "71450": {
      "id": 2583389,
      "text": "Xin lỗi tôi đến muộn.",
      "author": "ChatGPT4.1"
    },
    "71451": {
      "id": 2583390,
      "text": "Hôm nay phải mất rất lâu mới đến được trung tâm.",
      "author": "ChatGPT4.1"
    },
    "71452": {
      "id": 2583391,
      "text": "Việc xây dựng trên đường Main đang gây ra sự chậm trễ lớn.",
      "author": "ChatGPT4.1"
    },
    "71453": {
      "id": 2583392,
      "text": "Thật sao?",
      "author": "ChatGPT4.1"
    },
    "71454": {
      "id": 2583393,
      "text": "Nghe có vẻ bực bội thật đấy.",
      "author": "ChatGPT4.1"
    },
    "71455": {
      "id": 2583394,
      "text": "Sao bạn không thử đi tàu tốc hành mới?",
      "author": "ChatGPT4.1"
    },
    "71456": {
      "id": 2583395,
      "text": "Nó đi vòng hoàn toàn qua khu vực đang xây dựng và có thể tiết kiệm thời gian cho bạn.",
      "author": "ChatGPT4.1"
    },
    "71457": {
      "id": 2583396,
      "text": "Vấn đề lớn nhất là đến được ga tàu.",
      "author": "ChatGPT4.1"
    },
    "71458": {
      "id": 2583397,
      "text": "Đi bộ từ nhà tôi đến đó mất khoảng 25 phút, và tôi không hứng thú làm điều đó trong thời tiết này.",
      "author": "ChatGPT4.1"
    },
    "71459": {
      "id": 2583398,
      "text": "Đó là lý do tôi chủ yếu vẫn lái xe.",
      "author": "ChatGPT4.1"
    },
    "71460": {
      "id": 2583399,
      "text": "Bạn đã nghe chưa?",
      "author": "ChatGPT4.1"
    },
    "71461": {
      "id": 2583400,
      "text": "Có dịch vụ gửi xe đi chung mới bắt đầu từ tuần trước.",
      "author": "ChatGPT4.1"
    },
    "71462": {
      "id": 2583401,
      "text": "Nó có điểm đón gần khu vực của bạn và trả khách ngay tại ga tàu tốc hành.",
      "author": "ChatGPT4.1"
    }
  }
