  "translations": {
    "68941": {
      "id": 2587502,
      "text": "Xin lưu ý tất cả những người yêu thích sân khấu!",
      "author": "ChatGPT4.1"
    },
    "68942": {
      "id": 2587503,
      "text": "Nhà hát Chesterton cuối cùng cũng đã mở cửa trở lại.",
      "author": "ChatGPT4.1"
    },
    "68943": {
      "id": 2587504,
      "text": "Nội thất được thiết kế lại của chúng tôi mang đến cho khán giả cảm giác trở về thời hoàng kim xa hoa của Broadway,",
      "author": "ChatGPT4.1"
    },
    "68944": {
      "id": 2587505,
      "text": "với những hàng ghế nhung sang trọng và một sân khấu chính công phu.",
      "author": "ChatGPT4.1"
    },
    "68945": {
      "id": 2587506,
      "text": "Hãy cùng tham dự buổi công chiếu hoành tráng vào tuần tới khi chúng tôi mang trở lại những tác phẩm kinh điển vượt thời gian.",
      "author": "ChatGPT4.1"
    },
    "68946": {
      "id": 2587507,
      "text": "Để tránh đông đúc trong thành phố,",
      "author": "ChatGPT4.1"
    },
    "68947": {
      "id": 2587508,
      "text": "nhà hát Chesterton có thể dễ dàng đến bằng tuyến metro đến ga Arts District.",
      "author": "ChatGPT4.1"
    }
  }
