  "translations": {
    "69701": {
      "id": 2592051,
      "text": "Xin chào, ông Martinez.",
      "author": "ChatGPT4.1"
    },
    "69702": {
      "id": 2592052,
      "text": "Đây là Randall gọi từ khách sạn Blue Horizon Inn về việc đặt phòng mà ông đã thực hiện trên trang web của chúng tôi.",
      "author": "ChatGPT4.1"
    },
    "69703": {
      "id": 2592053,
      "text": "Trong ghi chú của ông, ông đã đề cập rằng muốn có một giường cỡ king.",
      "author": "ChatGPT4.1"
    },
    "69704": {
      "id": 2592054,
      "text": "Rất tiếc, tất cả các phòng giường king của chúng tôi đã được đặt cho đêm ông lưu trú.",
      "author": "ChatGPT4.1"
    },
    "69705": {
      "id": 2592055,
      "text": "Tuy nhiên, tôi có thể cung cấp cho ông một phòng cao cấp với hai giường cỡ queen cùng mức giá đó.",
      "author": "ChatGPT4.1"
    },
    "69706": {
      "id": 2592056,
      "text": "Vui lòng gọi lại cho tôi để xác nhận liệu sự thay đổi này có phù hợp với ông không.",
      "author": "ChatGPT4.1"
    },
    "69707": {
      "id": 2592057,
      "text": "Ngoài ra, ông cũng đã hỏi về các lựa chọn ăn uống lân cận.",
      "author": "ChatGPT4.1"
    },
    "69708": {
      "id": 2592058,
      "text": "Chúng tôi có một nhà hàng tại khách sạn phục vụ nhiều món ăn đa dạng,",
      "author": "ChatGPT4.1"
    },
    "69709": {
      "id": 2592059,
      "text": "và nhà hàng này nằm ngay cạnh sảnh chính.",
      "author": "ChatGPT4.1"
    },
    "69710": {
      "id": 2592060,
      "text": "Tôi hy vọng những thông tin này hữu ích,",
      "author": "ChatGPT4.1"
    },
    "69711": {
      "id": 2592061,
      "text": "và tôi mong sớm nhận được phản hồi từ ông.",
      "author": "ChatGPT4.1"
    }
  }
