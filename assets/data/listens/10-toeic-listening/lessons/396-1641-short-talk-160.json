  "translations": {
    "68398": {
      "id": 3033200,
      "text": "Chào buổi tối và chào mừng đến với Citywide News.",
      "author": "ChatGPT4.1"
    },
    "68399": {
      "id": 3033201,
      "text": "Tôi đang ở Shelbourne, một khu dân cư đẹp trong thành phố.",
      "author": "ChatGPT4.1"
    },
    "68400": {
      "id": 3033202,
      "text": "Một thông báo lớn đã được đưa ra rằng Shelbourne sẽ là nơi đặt một cơ sở nghiên cứu mới tập trung vào năng lượng tái tạo.",
      "author": "ChatGPT4.1"
    },
    "68401": {
      "id": 3033203,
      "text": "Dự án này dự kiến sẽ tạo ra nhiều việc làm mới cho cư dân địa phương,",
      "author": "ChatGPT4.1"
    },
    "68402": {
      "id": 3033204,
      "text": "giúp phát triển kinh tế của cộng đồng.",
      "author": "ChatGPT4.1"
    },
    "68403": {
      "id": 3033205,
      "text": "Một cuộc họp cộng đồng gần đây đã thu hút đông người tham dự,",
      "author": "ChatGPT4.1"
    },
    "68404": {
      "id": 3033206,
      "text": "nơi mọi người có thể chia sẻ ý kiến về dự án này.",
      "author": "ChatGPT4.1"
    },
    "68405": {
      "id": 3033207,
      "text": "Điều bất ngờ là không ai nêu ra bất kỳ lo ngại nào.",
      "author": "ChatGPT4.1"
    },
    "68406": {
      "id": 3033208,
      "text": "Nếu bạn muốn tìm hiểu thêm về dự án thú vị này,",
      "author": "ChatGPT4.1"
    },
    "68407": {
      "id": 3033209,
      "text": "bạn có thể xem các mô hình và hình ảnh tại trung tâm cộng đồng địa phương.",
      "author": "ChatGPT4.1"
    }
  }
}
