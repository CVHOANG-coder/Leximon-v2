  "translations": {
    "66182": {
      "id": 2590793,
      "text": "Chào buổi chiều. Tôi là Neil Ecob, gọi từ văn phòng vật lý trị liệu của bác sĩ Patterson.",
      "author": "ChatGPT4.1"
    },
    "66183": {
      "id": 2590794,
      "text": "Văn phòng chúng tôi gần đây đã nhờ công ty của bạn sửa chữa một trong những chiếc bàn điều trị của chúng tôi vào ngày hôm qua",
      "author": "a user"
    },
    "66184": {
      "id": 2590795,
      "text": "nhưng có vẻ như ai đó trong đội của bạn đã để quên bộ dụng cụ ở đây.",
      "author": "ChatGPT4.1"
    },
    "66185": {
      "id": 2590796,
      "text": "Wow! Cảm ơn ông đã thông báo cho chúng tôi, ông Ecob.",
      "author": "ChatGPT4.1"
    },
    "66186": {
      "id": 2590797,
      "text": "Kỹ thuật viên của chúng tôi, anh Rob, đã lo lắng suốt cả ngày",
      "author": "ChatGPT4.1"
    },
    "66187": {
      "id": 2590798,
      "text": "và sẽ rất vui khi nghe tin này, như cả người quản lý của anh ấy.",
      "author": "ChatGPT4.1"
    },
    "66188": {
      "id": 2590799,
      "text": "Tôi nên cho anh ấy đến lấy dụng cụ lúc nào?",
      "author": "ChatGPT4.1"
    },
    "66189": {
      "id": 2590800,
      "text": "Chúng tôi chỉ đóng cửa vào ngày mai, ngoài ra thì",
      "author": "ChatGPT4.1"
    },
    "66190": {
      "id": 2590801,
      "text": "chúng tôi mở cửa từ thứ Ba đến Chủ Nhật, từ 9 giờ sáng đến 4 giờ chiều.",
      "author": "ChatGPT4.1"
    },
    "66191": {
      "id": 2590802,
      "text": "Anh ấy có thể ghé qua bất cứ lúc nào, bộ dụng cụ sẽ ở quầy lễ tân với tôi.",
      "author": "ChatGPT4.1"
    },
    "66192": {
      "id": 2590803,
      "text": "Tuyệt vời. Anh ấy thực ra đang ở ngay bên cạnh tôi",
      "author": "ChatGPT4.1"
    },
    "66193": {
      "id": 2590804,
      "text": "và bảo rằng sẽ đi ngay bây giờ để đến lấy chúng.",
      "author": "ChatGPT4.1"
    },
    "66194": {
      "id": 2590805,
      "text": "Anh ấy sẽ có mặt ở đó trong vòng ba mươi phút nữa.",
      "author": "ChatGPT4.1"
    },
    "66195": {
      "id": 2590806,
      "text": "Cảm ơn anh một lần nữa vì đã gọi cho chúng tôi!",
      "author": "ChatGPT4.1"
    }
  }
}
