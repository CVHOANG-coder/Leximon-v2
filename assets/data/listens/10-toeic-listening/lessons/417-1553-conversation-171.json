    },
    "66339": {
      "id": 2637505,
      "text": "Tôi có thể kích hoạt lại thẻ của bạn.",
      "author": "ChatGPT4.1"
    },
    "66340": {
      "id": 2637506,
      "text": "Bạn có thể cho tôi lên thủ công được không?",
      "author": "ChatGPT4.1"
    },
    "66341": {
      "id": 2637507,
      "text": "Tôi đang trễ buổi họp với quản lý của mình.",
      "author": "ChatGPT4.1"
    },
    "66342": {
      "id": 2637508,
      "text": "Xin lỗi, Courtney.",
      "author": "ChatGPT4.1"
    },
    "66343": {
      "id": 2637509,
      "text": "Theo quy định an toàn của chúng ta,",
