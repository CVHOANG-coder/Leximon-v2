    },
    "66335": {
      "id": 2637501,
      "text": "Chào Courtney, xin lỗi về việc đó nhé.",
      "author": "ChatGPT4.1"
    },
    "66336": {
      "id": 2637502,
      "text": "Việc này xảy ra khi thẻ ID đã khá cũ",
      "author": "ChatGPT4.1"
    },
    "66337": {
      "id": 2637503,
      "text": "và có vẻ như chúng tôi đã cấp cho bạn thẻ này gần năm năm trước!",
      "author": "ChatGPT4.1"
    },
    "66338": {
      "id": 2637504,
      "text": "Bạn có thể xác nhận lại mã nhân viên và ngày sinh của mình không?",
