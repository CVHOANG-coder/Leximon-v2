  "translations": {
    "66663": {
      "id": 2586817,
      "text": "Tôi đang tổ chức cuộc chạy vui cho công ty chúng ta, để gây quỹ cho Bệnh viện Nhi địa phương.",
      "author": "ChatGPT4.1"
    },
    "66664": {
      "id": 2586818,
      "text": "Tôi thực sự muốn sự kiện này thành công,",
      "author": "ChatGPT4.1"
    },
    "66665": {
      "id": 2586819,
      "text": "nhưng ngân sách dành cho quảng cáo lại quá nhỏ,",
      "author": "ChatGPT4.1"
    },
    "66666": {
      "id": 2586820,
      "text": "Tôi không chắc phải quảng bá sự kiện này như thế nào!",
      "author": "ChatGPT4.1"
    },
    "66667": {
      "id": 2586821,
      "text": "Tôi nghĩ lựa chọn tốt nhất là cố gắng xin thêm tiền cho quảng cáo.",
      "author": "ChatGPT4.1"
    },
    "66668": {
      "id": 2586822,
      "text": "Chắc chắn rồi.",
      "author": "ChatGPT4.1"
    },
    "66669": {
      "id": 2586823,
      "text": "Trước đây ngân sách gấp đôi của bạn bây giờ!",
      "author": "ChatGPT4.1"
    },
    "66670": {
      "id": 2586824,
      "text": "Vì lý do nào đó, quản lý không chịu phân bổ thêm tiền cho chương trình gây quỹ.",
      "author": "ChatGPT4.1"
    },
    "66671": {
      "id": 2586825,
      "text": "Thật sự rất thất vọng.",
      "author": "ChatGPT4.1"
    },
    "66672": {
      "id": 2586826,
      "text": "Bạn đã thử liên hệ các doanh nghiệp địa phương khác chưa?",
      "author": "ChatGPT4.1"
    },
    "66673": {
      "id": 2586827,
      "text": "Nhiều khi cộng đồng rất thích tham gia vào những sự kiện như thế này.",
      "author": "ChatGPT4.1"
    },
    "66674": {
      "id": 2586828,
      "text": "Bạn thật sự nghĩ họ sẽ đóng góp sao?",
      "author": "ChatGPT4.1"
    },
    "66675": {
      "id": 2586829,
      "text": "Bạn thử cũng chẳng mất gì mà!",
      "author": "ChatGPT4.1"
    }
  }
