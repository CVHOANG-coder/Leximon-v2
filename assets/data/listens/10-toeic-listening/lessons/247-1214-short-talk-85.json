  "translations": {
    "55041": {
      "id": 2582750,
      "text": "Chào mừng mọi người.",
      "author": "ChatGPT4.1"
    },
    "55042": {
      "id": 2582751,
      "text": "Đây là hội nghị thường niên lần thứ tư của Gary's Grocery tại Boise.",
      "author": "ChatGPT4.1"
    },
    "55043": {
      "id": 2582752,
      "text": "Tôi tên là Holly Hills,",
      "author": "ChatGPT4.1"
    },
    "55044": {
      "id": 2582753,
      "text": "và tôi phụ trách các sản phẩm thay thế thịt tại Beyond Meat,",
      "author": "ChatGPT4.1"
    },
    "55045": {
      "id": 2582754,
      "text": "sản phẩm được bán tại tất cả các cửa hàng Gary's Grocery trên toàn quốc.",
      "author": "ChatGPT4.1"
    },
    "55046": {
      "id": 2582755,
      "text": "Là một người ăn chay trường, tôi luôn tìm kiếm những cách ngon miệng để bổ sung protein vào chế độ ăn của mình.",
      "author": "ChatGPT4.1"
    },
    "55047": {
      "id": 2582756,
      "text": "Sáng nay, tôi muốn nói về ba sản phẩm mới mà chúng tôi sắp ra mắt.",
      "author": "ChatGPT4.1"
    },
    "55048": {
      "id": 2582757,
      "text": "Những sản phẩm này được làm hoàn toàn từ rau củ, gồm có cà rốt, đậu và bông cải xanh.",
      "author": "ChatGPT4.1"
    },
    "55049": {
      "id": 2582758,
      "text": "Mối quan tâm lớn đối với những người quan tâm đến ăn chay là thiếu protein,",
      "author": "ChatGPT4.1"
    },
    "55050": {
      "id": 2582759,
      "text": "nên chúng tôi muốn đảm bảo bao bì của mình giải thích rõ ràng lợi ích sức khỏe.",
      "author": "ChatGPT4.1"
    },
    "55051": {
      "id": 2582760,
      "text": "Tôi muốn mọi người cùng nhìn lên màn hình để so sánh các chiến lược tiếp thị khác nhau.",
      "author": "ChatGPT4.1"
    }
  }
