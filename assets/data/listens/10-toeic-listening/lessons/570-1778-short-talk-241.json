  "translations": {
    "69987": {
      "id": 2622015,
      "text": "Tại Marquis Inns, chúng tôi nhận thức được những kỳ vọng của các doanh nhân hiện đại ngày nay.",
      "author": "ChatGPT4.1"
    },
    "69988": {
      "id": 2622016,
      "text": "Với các khách sạn có mặt tại hơn 45 thành phố quốc tế,",
      "author": "ChatGPT4.1"
    },
    "69989": {
      "id": 2622017,
      "text": "Marquis Inns nổi tiếng với dịch vụ xuất sắc và sự chú ý tỉ mỉ đến từng chi tiết.",
      "author": "ChatGPT4.1"
    },
    "69990": {
      "id": 2622018,
      "text": "Chúng tôi hiện đã triển khai các tiện ích dành riêng cho doanh nhân tại tất cả các địa điểm trên toàn cầu.",
      "author": "ChatGPT4.1"
    },
    "69991": {
      "id": 2622019,
      "text": "Các trung tâm này cung cấp truy cập Internet miễn phí,",
      "author": "ChatGPT4.1"
    },
    "69992": {
      "id": 2622020,
      "text": "phòng hội nghị và họp được trang bị đầy đủ cùng dịch vụ in ấn.",
      "author": "ChatGPT4.1"
    },
    "69993": {
      "id": 2622021,
      "text": "Ngoài ra, khách hàng thường xuyên có thể tận dụng chương trình khách hàng thân thiết của chúng tôi,",
      "author": "ChatGPT4.1"
    },
    "69994": {
      "id": 2622022,
      "text": "để tích điểm nâng hạng phòng và thuê xe ô tô.",
      "author": "ChatGPT4.1"
    },
    "69995": {
      "id": 2622023,
      "text": "Để biết thêm thông tin về Marquis Inns hoặc đặt phòng,",
      "author": "ChatGPT4.1"
    },
    "69996": {
      "id": 2622024,
      "text": "hãy truy cập trang web của chúng tôi tại www.marquisinns.com.",
      "author": "ChatGPT4.1"
    }
  }
