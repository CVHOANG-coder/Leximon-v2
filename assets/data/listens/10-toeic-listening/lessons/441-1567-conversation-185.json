  "translations": {
    "66558": {
      "id": 2619602,
      "text": "Tôi cần đến cửa hàng bán đồ trang trí tiệc để lấy một số đồ trang trí cho buổi tiệc ra mắt vào tuần tới.",
      "author": "ChatGPT4.1"
    },
    "66559": {
      "id": 2619603,
      "text": "Cửa hàng trên phố High được giới thiệu là có nhiều lựa chọn tuyệt vời.",
      "author": "ChatGPT4.1"
    },
    "66560": {
      "id": 2619604,
      "text": "Bạn có đi cùng tôi không?",
      "author": "ChatGPT4.1"
    },
    "66561": {
      "id": 2619605,
      "text": "Tôi chưa bao giờ chịu trách nhiệm về việc như thế này trước đây.",
      "author": "ChatGPT4.1"
    },
    "66562": {
      "id": 2619606,
      "text": "À, xin lỗi nhé, hôm nay tôi không thể.",
      "author": "ChatGPT4.1"
    },
    "66563": {
      "id": 2619607,
      "text": "Tôi phải hoàn thành ngân sách cho năm sau trước cuối ngày hôm nay.",
      "author": "ChatGPT4.1"
    },
    "66564": {
      "id": 2619608,
      "text": "Ngày mai tôi sẽ rảnh vài tiếng, nếu bạn muốn đi lúc đó?",
      "author": "ChatGPT4.1"
    },
    "66565": {
      "id": 2619609,
      "text": "Ngày mai tôi kín lịch rồi.",
      "author": "ChatGPT4.1"
    },
    "66566": {
      "id": 2619610,
      "text": "Tôi có buổi thuyết trình lớn với các khách hàng mới.",
      "author": "ChatGPT4.1"
    },
    "66567": {
      "id": 2619611,
      "text": "Tôi khá căng thẳng về việc này,",
      "author": "ChatGPT4.1"
    },
    "66568": {
      "id": 2619612,
      "text": "Tôi ước là mình không phải rời văn phòng để đi lấy những đồ này.",
      "author": "ChatGPT4.1"
    },
    "66569": {
      "id": 2619613,
      "text": "Có lẽ hãy nhờ Karen đảm nhận công việc này.",
      "author": "ChatGPT4.1"
    },
    "66570": {
      "id": 2619614,
      "text": "Cô ấy nói rằng mình đang trong thời gian rảnh rỗi,",
      "author": "ChatGPT4.1"
    },
    "66571": {
      "id": 2619615,
      "text": "nên tôi chắc chắn cô ấy sẽ vui khi được ra ngoài một lúc và chuẩn bị cho buổi tiệc.",
      "author": "ChatGPT4.1"
    }
  }
}
