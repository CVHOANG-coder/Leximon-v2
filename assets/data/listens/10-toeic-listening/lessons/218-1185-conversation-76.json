  "translations": {
    "54684": {
      "id": 910982,
      "text": "Xin chào martin. Tôi ngạc nhiên là tôi đã gặp được bạn.",
      "author": "a user"
    },
    "54688": {
      "id": 940478,
      "text": "Mọi chuyện có thể tệ hơn! Bạn có thể đang ở khoang hạng phổ thông.",
      "author": "a user"
    },
    "54689": {
      "id": 940481,
      "text": "Tôi rất biết ơn công ty đã đánh giá cao chuyến đi của chúng ta",
      "author": "a user"
    },
    "54694": {
      "id": 940494,
      "text": "Tôi không hề biết về việc này.",
      "author": "a user"
    },
    "54695": {
      "id": 940495,
      "text": "Sau 15 năm đi công tác, tại sao bây giờ họ mới quyết định cho phép khoản chi tiêu này?",
      "author": "a user"
    },
    "54687": {
      "id": 1066551,
      "text": "Tôi thực sự sợ những chuyến bay đêm",
      "author": "a user"
    },
    "54685": {
      "id": 2623414,
      "text": "Tôi nghĩ bạn sẽ rời đi dự hội nghị ở Buffalo vào chiều nay.",
      "author": "ChatGPT4.1"
    },
    "54686": {
      "id": 2623415,
      "text": "Thực ra tôi chưa đi cho đến tối nay.",
      "author": "ChatGPT4.1"
    },
    "54690": {
      "id": 2623416,
      "text": "và đổi lại, giờ đã cho phép hoàn tiền vé hạng nhất.",
      "author": "ChatGPT4.1"
    },
    "54691": {
      "id": 2623417,
      "text": "Tôi biết, thật tuyệt phải không?",
      "author": "ChatGPT4.1"
    },
    "54692": {
      "id": 2623418,
      "text": "Quản lý nhân sự đã nói với tôi tuần trước.",
      "author": "ChatGPT4.1"
    },
    "54693": {
      "id": 2623419,
      "text": "Gì cơ? Bạn đùa à?!",
      "author": "ChatGPT4.1"
    },
    "54696": {
      "id": 2623420,
      "text": "Tôi nghe nói nhiều quản lý bán hàng dọa sẽ tìm việc mới vì phải bay chuyến dài.",
      "author": "ChatGPT4.1"
    },
    "54697": {
      "id": 2623421,
      "text": "Phòng nhân sự nghĩ điều này sẽ giảm bớt căng thẳng mà các quản lý đang gặp phải.",
      "author": "ChatGPT4.1"
    },
    "54698": {
      "id": 2623422,
      "text": "Đó là tin tuyệt vời!",
      "author": "ChatGPT4.1"
    },
    "54699": {
      "id": 2623423,
      "text": "Chắc chắn điều đó sẽ giúp tôi giảm bớt căng thẳng.",
      "author": "ChatGPT4.1"
    },
    "54700": {
      "id": 2623424,
      "text": "Tôi phải đi đây, tôi sẽ gọi hãng hàng không để nâng hạng vé ngay bây giờ.",
      "author": "ChatGPT4.1"
    }
  }
}
