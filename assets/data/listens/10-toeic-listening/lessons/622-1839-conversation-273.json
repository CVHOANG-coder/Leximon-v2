  "translations": {
    "70906": {
      "id": 2584606,
      "text": "Được rồi, ông Johnson, có chuyện gì với đầu gối của ông vậy?",
      "author": "ChatGPT4.1"
    },
    "70907": {
      "id": 2584607,
      "text": "Nó đã gây cho tôi rất nhiều rắc rối, đặc biệt là ở chỗ làm.",
      "author": "ChatGPT4.1"
    },
    "70908": {
      "id": 2584608,
      "text": "Tôi đứng hầu như cả ngày ở kho, nâng và di chuyển những thùng hàng nặng.",
      "author": "ChatGPT4.1"
    },
    "70909": {
      "id": 2584609,
      "text": "Tôi nghĩ tất cả việc nâng lặp đi lặp lại đó là nguyên nhân khiến đầu gối tôi đau và sưng lên.",
      "author": "ChatGPT4.1"
    },
    "70910": {
      "id": 2584610,
      "text": "Đến cuối ca làm, đầu gối tôi cứng và đau lắm.",
      "author": "ChatGPT4.1"
    },
    "70911": {
      "id": 2584611,
      "text": "Tôi hiểu rồi.",
      "author": "ChatGPT4.1"
    },
    "70912": {
      "id": 2584612,
      "text": "Tôi sẽ kê một số loại thuốc chống viêm để giúp ông giảm đau.",
      "author": "ChatGPT4.1"
    },
    "70913": {
      "id": 2584613,
      "text": "Ông cũng nên nói chuyện với sếp để xem có cách nào điều chỉnh công việc của mình không,",
      "author": "ChatGPT4.1"
    },
    "70914": {
      "id": 2584614,
      "text": "có thể thay đổi với công việc nhẹ hơn, hoặc thêm một vài khoảng nghỉ.",
      "author": "ChatGPT4.1"
    },
    "70915": {
      "id": 2584615,
      "text": "Như vậy, ông có thể giảm bớt áp lực và tránh làm tình trạng tệ hơn.",
      "author": "ChatGPT4.1"
    }
  }
