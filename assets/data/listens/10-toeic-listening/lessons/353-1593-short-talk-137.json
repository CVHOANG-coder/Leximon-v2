  "translations": {
    "66879": {
      "id": 2604434,
      "text": "Chào buổi chiều, mọi người.",
      "author": "ChatGPT4.1"
    },
    "66880": {
      "id": 2604435,
      "text": "Tối nay chúng ta sẽ rất bận rộn, xin mọi người chú ý.",
      "author": "ChatGPT4.1"
    },
    "66881": {
      "id": 2604436,
      "text": "Tối nay chúng ta có khá nhiều chương trình khuyến mãi,",
      "author": "ChatGPT4.1"
    },
    "66882": {
      "id": 2604437,
      "text": "bao gồm giảm giá 50% cho tất cả các chai rượu vang,",
      "author": "ChatGPT4.1"
    },
    "66883": {
      "id": 2604438,
      "text": "hoặc combo một phần bít tết, món phụ và một ly rượu vang chỉ với 20 đô la.",
      "author": "ChatGPT4.1"
    },
    "66884": {
      "id": 2604439,
      "text": "Hãy nhớ giới thiệu những chương trình này với khách hàng,",
      "author": "ChatGPT4.1"
    },
    "66885": {
      "id": 2604440,
      "text": "vì chúng ta thực sự muốn giải phóng lượng rượu vang hiện có.",
      "author": "ChatGPT4.1"
    },
    "66886": {
      "id": 2604441,
      "text": "Nếu có bất kỳ câu hỏi nào, hãy hỏi Ruthie, quản lý quầy bar mới của chúng ta.",
      "author": "ChatGPT4.1"
    },
    "66887": {
      "id": 2604442,
      "text": "Ngoài ra, nếu có thời gian rảnh trong ca tối nay,",
      "author": "ChatGPT4.1"
    },
    "66888": {
      "id": 2604443,
      "text": "bạn có thể giúp bằng cách sắp xếp lại hầm rượu vang,",
      "author": "ChatGPT4.1"
    },
    "66889": {
      "id": 2604444,
      "text": "danh sách sắp xếp đã được dán ở cạnh cửa.",
      "author": "ChatGPT4.1"
    }
  }
