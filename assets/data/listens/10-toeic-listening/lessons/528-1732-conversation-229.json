    },
    "69376": {
      "id": 2589717,
      "text": "Các đơn hàng gần đây của chúng tôi bị trễ do các vấn đề vận chuyển không lường trước được.",
      "author": "ChatGPT4.1"
    },
    "69377": {
      "id": 2589718,
      "text": "Tuy nhiên, tình hình đã được giải quyết,",
