  "translations": {
    "54554": {
      "id": 2655670,
      "text": "Chào mừng các nghệ sĩ biểu diễn!",
      "author": "ChatGPT4.1"
    },
    "54555": {
      "id": 2655671,
      "text": "Tôi rất vui mừng khi có tất cả các nhạc sĩ tài năng của các bạn ở đây biểu diễn tại Lễ hội Âm nhạc Columbus!",
      "author": "ChatGPT4.1"
    },
    "54556": {
      "id": 2655672,
      "text": "Tôi có một vài hướng dẫn muốn gửi đến các bạn trước khi chúng ta bắt đầu chương trình.",
      "author": "ChatGPT4.1"
    },
    "54557": {
      "id": 2655673,
      "text": "Các bạn có thể thoải mái ngồi ở khu vực khán giả trước hoặc sau khi biểu diễn.",
      "author": "ChatGPT4.1"
    },
    "54558": {
      "id": 2655674,
      "text": "Với sự kiện này, chúng tôi không có chỗ ngồi cố định,",
      "author": "ChatGPT4.1"
    },
    "54559": {
      "id": 2655675,
      "text": "nên các bạn có thể ngồi ở bất kỳ vị trí nào mình muốn,",
      "author": "ChatGPT4.1"
    },
    "54560": {
      "id": 2655676,
      "text": "nhưng tôi đề xuất các bạn ngồi gần cửa South 1,",
      "author": "ChatGPT4.1"
    },
    "54561": {
      "id": 2655677,
      "text": "để tránh làm phiền các thành viên của công chúng.",
      "author": "ChatGPT4.1"
    },
    "54562": {
      "id": 2655678,
      "text": "Cuối cùng, nhiếp ảnh gia muốn chụp một bức ảnh nhóm cho tạp chí Columbus Now!",
      "author": "ChatGPT4.1"
    },
    "54563": {
      "id": 2655679,
      "text": "vì vậy xin vui lòng gặp nhau tại sân khấu chính sau khi các tiết mục kết thúc.",
      "author": "ChatGPT4.1"
    }
  }
}
