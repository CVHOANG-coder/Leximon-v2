    "52908": {
      "id": 872322,
      "text": "Đây là Becky, đang gọi từ Fruit Arrangements.",
      "author": "a user"
    },
    "52909": {
      "id": 872325,
      "text": "Tôi gọi cho bạn để xác nhận đơn đặt hàng trực tuyến của giỏ trái cây cỡ cực lớn",
      "author": "a user"
    },
    "52912": {
      "id": 874070,
      "text": "Chúng tôi sẽ gửi kèm ghi chú cách bảo quản",
      "author": "a user"
    },
    "52913": {
      "id": 874076,
      "text": "nhưng bạn nên bảo người nhận để trái cây vào tủ lạnh trong vòng bốn giờ kể từ lúc giao đến",
      "author": "a user"
    },
    "52914": {
      "id": 874094,
      "text": "để tránh làm trái cây bị mốc.",
      "author": "a user"
    },
    "52915": {
      "id": 874101,
      "text": "Cảm ơn vì bạn đã đặt hàng",
      "author": "a user"
    },
    "52907": {
      "id": 2592219,
      "text": "Chào Sarah!",
      "author": "ChatGPT4.1"
    },
    "52910": {
      "id": 2592220,
      "text": "sẽ được giao đến Trường St. Catherine vào thứ Hai lúc 2:30 chiều.",
      "author": "ChatGPT4.1"
    },
    "52911": {
      "id": 2592221,
      "text": "Tôi sẽ đích thân giao bó hoa, và sẽ gửi hóa đơn cho bạn qua email khi tôi làm điều đó.",
      "author": "ChatGPT4.1"
    },
    "52916": {
      "id": 2592222,
      "text": "và vui lòng gọi cho tôi trước cuối ngày nếu bạn cần thay đổi điều gì.",
