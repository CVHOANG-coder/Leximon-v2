  "translations": {
    "71068": {
      "id": 2585375,
      "text": "Bạn đang nghe chương trình Sydney Hôm Nay trên sóng 92.7 FM.",
      "author": "ChatGPT4.1"
    },
    "71069": {
      "id": 2585376,
      "text": "Khách mời của tôi chiều nay là Tiến sĩ James Franklin,",
      "author": "ChatGPT4.1"
    },
    "71070": {
      "id": 2585377,
      "text": "một nhà cổ sinh vật học nổi tiếng thế giới từng xuất hiện trên kênh Discovery và Khoa Học,",
      "author": "ChatGPT4.1"
    },
    "71071": {
      "id": 2585378,
      "text": "cũng như trong nhiều tạp chí và ấn phẩm khoa học khác.",
      "author": "ChatGPT4.1"
    },
    "71072": {
      "id": 2585379,
      "text": "Trong suốt năm qua, ông đã đi khắp thế giới",
      "author": "ChatGPT4.1"
    },
    "71073": {
      "id": 2585380,
      "text": "để thực hiện các nghiên cứu đột phá tại nhiều địa điểm khai quật khác nhau.",
      "author": "ChatGPT4.1"
    },
    "71074": {
      "id": 2585381,
      "text": "Ông đã đến Úc vào ngày hôm qua và sẽ lên đường đến New Zealand vào ngày kia.",
      "author": "ChatGPT4.1"
    },
    "71075": {
      "id": 2585382,
      "text": "Tôi dự định hỏi Tiến sĩ Franklin về Earth Heritage,",
      "author": "ChatGPT4.1"
    },
    "71076": {
      "id": 2585383,
      "text": "một tổ chức phi lợi nhuận do ông sáng lập",
      "author": "ChatGPT4.1"
    },
    "71077": {
      "id": 2585384,
      "text": "chuyên bảo tồn và nghiên cứu hóa thạch cũng như hệ sinh thái thời tiền sử.",
      "author": "ChatGPT4.1"
    },
    "71078": {
      "id": 2585385,
      "text": "Vậy nên, không để quý vị chờ lâu nữa,",
      "author": "ChatGPT4.1"
    },
    "71079": {
      "id": 2585386,
      "text": "chúng ta hãy cùng bắt đầu cuộc trò chuyện ngay bây giờ.",
      "author": "ChatGPT4.1"
    }
  }
}
