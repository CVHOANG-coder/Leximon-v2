    },
    "65703": {
      "id": 2651079,
      "text": "Không thể tốt hơn được nữa.",
      "author": "ChatGPT4.1"
    },
    "65704": {
      "id": 2651080,
      "text": "Tôi vẫn thích chỗ này mà.",
