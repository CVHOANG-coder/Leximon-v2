    },
    "65699": {
      "id": 2651075,
      "text": "Tôi rất xin lỗi về điều đó.",
      "author": "ChatGPT4.1"
    },
    "65700": {
      "id": 2651076,
      "text": "Không sao đâu.",
      "author": "ChatGPT4.1"
    },
    "65701": {
      "id": 2651077,
      "text": "Thật ra, tôi thích ngồi gần màn hình hơn khi xem phim.",
      "author": "ChatGPT4.1"
    },
    "65702": {
      "id": 2651078,
      "text": "Vậy, nếu không phiền thì chúng ta đổi chỗ nhé?",
