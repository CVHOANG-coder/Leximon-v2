  "translations": {
    "65853": {
      "id": 2651408,
      "text": "Này Ian, cậu đang đăng nhập vào hệ thống phải không?",
      "author": "ChatGPT4.1"
    },
    "65854": {
      "id": 2651409,
      "text": "Ừ, sao cậu hỏi vậy?",
      "author": "ChatGPT4.1"
    },
    "65855": {
      "id": 2651410,
      "text": "À, máy tính của mình vừa bị sập đột ngột nửa tiếng trước,",
      "author": "ChatGPT4.1"
    },
    "65856": {
      "id": 2651411,
      "text": "nên mình không thể kiểm tra email.",
      "author": "ChatGPT4.1"
    },
    "65857": {
      "id": 2651412,
      "text": "Mình mượn máy tính của cậu một lát được không?",
      "author": "ChatGPT4.1"
    },
    "65858": {
      "id": 2651413,
      "text": "Nhưng máy tính công ty không cho phép đổi người dùng.",
      "author": "ChatGPT4.1"
    },
    "65859": {
      "id": 2651414,
      "text": "À đúng rồi, mình quên mất.",
      "author": "ChatGPT4.1"
    },
    "65860": {
      "id": 2651415,
      "text": "Vậy cậu có thể kiểm tra hộ hộp thư đến của mình không?",
      "author": "ChatGPT4.1"
    },
    "65861": {
      "id": 2651416,
      "text": "Mình muốn biết bộ phận phát triển sản phẩm đã nộp phiếu yêu cầu mua hàng chưa.",
      "author": "ChatGPT4.1"
    },
    "65862": {
      "id": 2651417,
      "text": "Được, đợi chút nhé...",
      "author": "ChatGPT4.1"
    },
    "65863": {
      "id": 2651418,
      "text": "Có rồi đây.",
      "author": "ChatGPT4.1"
    },
    "65864": {
      "id": 2651419,
      "text": "Cậu có muốn mình in nó ra cho không?",
      "author": "ChatGPT4.1"
    },
    "65865": {
      "id": 2651420,
      "text": "Thế thì tuyệt quá. Cảm ơn nhé!",
      "author": "ChatGPT4.1"
    },
    "65866": {
      "id": 2651421,
      "text": "Mình chỉ cần một bản sao của phiếu yêu cầu mua hàng này thôi.",
      "author": "ChatGPT4.1"
    }
  }
