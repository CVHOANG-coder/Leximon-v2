  "translations": {
    "53941": {
      "id": 892423,
      "text": "hoặc bất kỳ món đồ nào khác mà bạn nhìn thấy.",
      "author": "a user"
    },
    "53948": {
      "id": 892430,
      "text": "Cuối cùng, hãy nhớ rằng bảo tàng đóng cửa lúc 5 giờ chiều hôm nay.",
      "author": "a user"
    },
    "53935": {
      "id": 2614452,
      "text": "Mọi người chú ý lắng nghe nhé!",
      "author": "ChatGPT4.1"
    },
    "53936": {
      "id": 2614453,
      "text": "Trước khi chúng ta vào bảo tàng,",
      "author": "ChatGPT4.1"
    },
    "53937": {
      "id": 2614454,
      "text": "Tôi cần nhắc các bạn một vài điều.",
      "author": "ChatGPT4.1"
    },
    "53938": {
      "id": 2614455,
      "text": "Đầu tiên, theo quy định của bảo tàng,",
      "author": "ChatGPT4.1"
    },
    "53939": {
      "id": 2614456,
      "text": "các bạn không được chạm vào bất kỳ tác phẩm nghệ thuật nào.",
      "author": "ChatGPT4.1"
    },
    "53940": {
      "id": 2614457,
      "text": "Điều này bao gồm tranh, tượng, hiện vật,",
      "author": "ChatGPT4.1"
    },
    "53942": {
      "id": 2614458,
      "text": "Không chỉ là bàn tay của bạn đâu.",
      "author": "ChatGPT4.1"
    },
    "53943": {
      "id": 2614459,
      "text": "Hãy chú ý đến quần áo và túi xách khi đi lại trong bảo tàng.",
      "author": "ChatGPT4.1"
    },
    "53944": {
      "id": 2614460,
      "text": "Bạn không được phép ăn, uống hoặc hút thuốc trong bảo tàng.",
      "author": "ChatGPT4.1"
    },
    "53945": {
      "id": 2614461,
      "text": "Chụp ảnh được phép, nhưng vui lòng tắt đèn flash.",
      "author": "ChatGPT4.1"
    },
    "53946": {
      "id": 2614462,
      "text": "Ngoài ra còn có một triển lãm đặc biệt vào lúc 3 giờ chiều.",
      "author": "ChatGPT4.1"
    },
    "53947": {
      "id": 2614463,
      "text": "Triển lãm sẽ kéo dài khoảng một tiếng.",
      "author": "ChatGPT4.1"
    },
    "53949": {
      "id": 2614464,
      "text": "Vì vậy, chúng ta sẽ gặp lại nhau ở đây lúc 5 giờ 30.",
      "author": "ChatGPT4.1"
    },
    "53950": {
      "id": 2614465,
      "text": "Như vậy, các bạn có khoảng năm tiếng để tham quan.",
      "author": "ChatGPT4.1"
    },
    "53951": {
      "id": 2614466,
      "text": "Hãy đi vào bằng lối vào chính và tận hưởng thời gian của mình nhé.",
      "author": "ChatGPT4.1"
    }
  }
}
