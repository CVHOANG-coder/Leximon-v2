  "translations": {
    "69233": {
      "id": 1594271,
      "text": "Chỉ cần đăng ký hàng tháng, bạn sẽ không bao giờ phải lo lắng về việc cào lá nữa!",
      "author": "a user"
    },
    "69236": {
      "id": 1594274,
      "text": "Và nếu chúng tôi chậm trễ, tháng tiếp theo của bạn chúng tôi sẽ không tính tiền, không cần hỏi gì thêm.",
      "author": "a user"
    },
    "69231": {
      "id": 2588968,
      "text": "Bạn có chán ngán việc dọn lá trong sân vào mỗi mùa thu không?",
      "author": "ChatGPT4.1"
    },
    "69232": {
      "id": 2588969,
      "text": "Đừng tìm đâu xa, hãy chọn Dịch vụ LeafAway.",
      "author": "ChatGPT4.1"
    },
    "69234": {
      "id": 2588970,
      "text": "Tại LeafAway, chúng tôi tự hào về sự chú ý đến từng chi tiết và đúng giờ của mình,",
      "author": "ChatGPT4.1"
    },
    "69235": {
      "id": 2588971,
      "text": "đảm bảo sân vườn của bạn sẽ sạch lá trong vòng 48 giờ kể từ khi đặt dịch vụ.",
      "author": "ChatGPT4.1"
    },
    "69237": {
      "id": 2588972,
      "text": "Chỉ với một khoản phí nhỏ bổ sung,",
      "author": "ChatGPT4.1"
    },
    "69238": {
      "id": 2588973,
      "text": "chúng tôi còn cung cấp dịch vụ phủ phân hữu cơ từ lá rụng cho đất vườn của bạn thêm màu mỡ.",
      "author": "ChatGPT4.1"
    },
    "69239": {
      "id": 2588974,
      "text": "Truy cập leafawayservices.com để xem các khu vực chúng tôi phục vụ",
      "author": "ChatGPT4.1"
    },
    "69240": {
      "id": 2588975,
      "text": "và đọc hàng trăm đánh giá tích cực từ các khách hàng hài lòng của chúng tôi.",
      "author": "ChatGPT4.1"
    },
    "69241": {
      "id": 2588976,
      "text": "Đừng để những chiếc lá làm mất đi tinh thần mùa thu của bạn, hãy liên hệ với LeafAway ngay hôm nay!",
