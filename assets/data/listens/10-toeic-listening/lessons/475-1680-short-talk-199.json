  "translations": {
    "68730": {
      "id": 2660500,
      "text": "Trước khi chúng ta bắt đầu buổi đào tạo ngày hôm nay,",
      "author": "ChatGPT4.1"
    },
    "68731": {
      "id": 2660501,
      "text": "Tôi muốn nhắc nhanh bạn về chính sách làm việc từ xa mới của chúng ta.",
      "author": "ChatGPT4.1"
    },
    "68732": {
      "id": 2660502,
      "text": "Bắt đầu từ tháng tới, tất cả nhân viên sẽ có lựa chọn làm việc tại nhà hai ngày mỗi tuần.",
      "author": "ChatGPT4.1"
    },
    "68733": {
      "id": 2660503,
      "text": "Nếu bạn chưa làm, vui lòng đảm bảo hoàn tất quy trình thiết lập truy cập máy tính từ xa.",
      "author": "ChatGPT4.1"
    },
    "68734": {
      "id": 2660504,
      "text": "Nếu bạn gặp bất kỳ vấn đề kỹ thuật nào,",
      "author": "ChatGPT4.1"
    },
    "68735": {
      "id": 2660505,
      "text": "hãy liên hệ với bộ phận IT trước thứ Sáu",
      "author": "ChatGPT4.1"
    },
    "68736": {
      "id": 2660506,
      "text": "để họ có thể hỗ trợ bạn trước khi lịch làm việc mới bắt đầu.",
      "author": "ChatGPT4.1"
    },
    "68737": {
      "id": 2660507,
      "text": "Chúng tôi hy vọng sự linh hoạt này sẽ giúp cải thiện cân bằng giữa công việc và cuộc sống của bạn",
      "author": "ChatGPT4.1"
    },
    "68738": {
      "id": 2660508,
      "text": "và làm cho mọi việc trở nên thuận tiện hơn cho bạn.",
      "author": "ChatGPT4.1"
    }
  }
}
