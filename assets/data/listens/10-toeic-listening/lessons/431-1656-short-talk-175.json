  "translations": {
    "68527": {
      "id": 2605241,
      "text": "Tôi muốn dành một chút thời gian để chia sẻ một số tin tức thú vị về các sáng kiến hiện tại của chúng tôi.",
      "author": "ChatGPT4.1"
    },
    "68528": {
      "id": 2605242,
      "text": "Là một phần trong cam kết trở thành nhà cung cấp dịch vụ logistics hàng đầu,",
      "author": "ChatGPT4.1"
    },
    "68529": {
      "id": 2605243,
      "text": "chúng tôi phải liên tục đổi mới để phù hợp với nhu cầu thay đổi của khách hàng.",
      "author": "ChatGPT4.1"
    },
    "68530": {
      "id": 2605244,
      "text": "Khi ngày càng nhiều khách hàng lựa chọn các giải pháp số,",
      "author": "ChatGPT4.1"
    },
    "68531": {
      "id": 2605245,
      "text": "chúng tôi rất vui mừng thông báo ra mắt tính năng theo dõi kiện hàng theo thời gian thực mới.",
      "author": "ChatGPT4.1"
    },
    "68532": {
      "id": 2605246,
      "text": "Tính năng này sẽ được cung cấp thông qua một ứng dụng di động chuyên dụng,",
      "author": "ChatGPT4.1"
    },
    "68533": {
      "id": 2605247,
      "text": "cho phép khách hàng theo dõi hành trình vận chuyển của mình từ khi gửi cho đến khi giao nhận một cách liền mạch.",
      "author": "ChatGPT4.1"
    }
  }
