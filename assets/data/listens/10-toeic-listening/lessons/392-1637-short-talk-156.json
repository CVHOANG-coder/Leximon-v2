  "translations": {
    "68366": {
      "id": 2624966,
      "text": "Xin chào Amina.",
      "author": "ChatGPT4.1"
    },
    "68367": {
      "id": 2624967,
      "text": "Đây là Clara từ Golden Leaf Designs.",
      "author": "ChatGPT4.1"
    },
    "68368": {
      "id": 2624968,
      "text": "Tôi vừa gửi đi những chiếc vòng tay và nhẫn mà bạn đã đặt.",
      "author": "ChatGPT4.1"
    },
    "68369": {
      "id": 2624969,
      "text": "Như một lời cảm ơn vì bạn đã là khách hàng thân thiết hơn mười năm qua,",
      "author": "ChatGPT4.1"
    },
    "68370": {
      "id": 2624970,
      "text": "Tôi cũng đã thêm một món quà nhỏ bất ngờ vào trong gói hàng cho bạn.",
      "author": "ChatGPT4.1"
    },
    "68371": {
      "id": 2624971,
      "text": "Đó là một túi đựng phụ kiện du lịch dành cho bạn.",
      "author": "ChatGPT4.1"
    },
    "68372": {
      "id": 2624972,
      "text": "Đây là một sản phẩm hoàn toàn mới mà tôi đang giới thiệu,",
      "author": "ChatGPT4.1"
    },
    "68373": {
      "id": 2624973,
      "text": "Vì thế, xin hãy gọi cho tôi khi bạn nhận được nó.",
      "author": "ChatGPT4.1"
    },
    "68374": {
      "id": 2624974,
      "text": "Tôi rất mong nhận được ý kiến phản hồi của bạn về sản phẩm này.",
      "author": "ChatGPT4.1"
    }
  }
