    },
    "52980": {
      "id": 2592752,
      "text": "và tôi ở đây để nói với các bạn về cách đối phó với căng thẳng khi nộp đơn vào đại học.",
      "author": "ChatGPT4.1"
    },
    "52981": {
      "id": 2592753,
      "text": "Nhiều bạn đang nộp đơn vào nhiều trường đại học,",
      "author": "ChatGPT4.1"
    },
    "52982": {
      "id": 2592754,
      "text": "và tôi biết có nhiều yếu tố có thể góp phần vào sự căng thẳng của bạn,",
      "author": "ChatGPT4.1"
    },
    "52983": {
      "id": 2592755,
      "text": "bao gồm học phí, khoảng cách từ nhà bạn,",
      "author": "ChatGPT4.1"
    },
    "52984": {
      "id": 2592756,
      "text": "và cảm nhận chung về khuôn viên trường.",
      "author": "ChatGPT4.1"
    },
    "52985": {
      "id": 2592757,
      "text": "Chiều nay, tôi sẽ đưa ra cho bạn những chiến lược giúp bạn trong quá trình nộp đơn.",
      "author": "ChatGPT4.1"
    },
    "52986": {
      "id": 2592758,
      "text": "Nhìn chung, lời khuyên lớn nhất của tôi dành cho bạn là quản lý thời gian.",
      "author": "ChatGPT4.1"
    },
    "52987": {
      "id": 2592759,
      "text": "Đừng trì hoãn việc nộp đơn của bạn,",
      "author": "ChatGPT4.1"
    },
    "52988": {
