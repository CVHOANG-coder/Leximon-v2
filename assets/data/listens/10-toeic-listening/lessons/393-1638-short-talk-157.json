  "translations": {
    "68375": {
      "id": 2625069,
      "text": "Xin chào mọi người, chào mừng các bạn đến với buổi đào tạo tuần này trong chuỗi chương trình hỗ trợ bệnh nhân của chúng ta.",
      "author": "ChatGPT4.1"
    },
    "68376": {
      "id": 2625070,
      "text": "Trung tâm phục hồi chức năng của chúng ta nổi tiếng nhờ sự chăm sóc tuyệt vời dành cho khách hàng,",
      "author": "ChatGPT4.1"
    },
    "68377": {
      "id": 2625071,
      "text": "và đó là nhờ tất cả các bạn, những nhân viên tuyệt vời của chúng ta.",
      "author": "ChatGPT4.1"
    },
    "68378": {
      "id": 2625072,
      "text": "Buổi đào tạo hôm nay sẽ tập trung vào các cách thu hút các cư dân trong cơ sở của chúng ta thông qua các trò chơi.",
      "author": "ChatGPT4.1"
    },
    "68379": {
      "id": 2625073,
      "text": "Tôi đã chuẩn bị nhiều hoạt động khác nhau để chúng ta thử,",
      "author": "ChatGPT4.1"
    },
    "68380": {
      "id": 2625074,
      "text": "bao gồm một số hoạt động chú trọng vào kỹ năng tư duy và một số hoạt động vận động thể chất.",
      "author": "ChatGPT4.1"
    },
    "68381": {
      "id": 2625075,
      "text": "Hãy bắt đầu nào!",
      "author": "ChatGPT4.1"
    }
  }
}
