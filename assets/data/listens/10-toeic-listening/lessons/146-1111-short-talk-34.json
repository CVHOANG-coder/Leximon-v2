  "translations": {
    "53695": {
      "id": 897523,
      "text": "Hiện tại, Billy vừa trở về từ Nicarauga, nơi anh là giám đốc của một trại trẻ mồ côi có hoàn cảnh khó khăn.",
      "author": "a user"
    },
    "53692": {
      "id": 2589315,
      "text": "Xin chào mọi người, cảm ơn các bạn đã theo dõi chương trình.",
      "author": "ChatGPT4.1"
    },
    "53693": {
      "id": 2589316,
      "text": "Hôm nay, chúng tôi sẽ mang đến cho các bạn một chương trình đặc biệt.",
      "author": "ChatGPT4.1"
    },
    "53694": {
      "id": 2589317,
      "text": "Vị khách mời đầu tiên của chúng ta là Billy Hays.",
      "author": "ChatGPT4.1"
    },
    "53696": {
      "id": 2589318,
      "text": "Trại trẻ mồ côi này chịu trách nhiệm chăm sóc và giáo dục cho hơn năm mươi trẻ em mồ côi.",
      "author": "ChatGPT4.1"
    },
    "53697": {
      "id": 2589319,
      "text": "Nó mang lại lợi ích cho cả cộng đồng địa phương và quốc gia.",
      "author": "ChatGPT4.1"
    },
    "53698": {
      "id": 2589320,
      "text": "Hôm nay, Billy sẽ chia sẻ với chúng ta về trải nghiệm của mình tại quốc gia Trung Mỹ này,",
      "author": "ChatGPT4.1"
    },
    "53699": {
      "id": 2589321,
      "text": "và những gì bạn có thể làm để giúp đỡ.",
      "author": "ChatGPT4.1"
    },
    "53700": {
      "id": 2589322,
      "text": "Cuối cùng, chúng tôi sẽ mở điện thoại để khán giả có thể đặt câu hỏi.",
      "author": "ChatGPT4.1"
    }
  }
}
