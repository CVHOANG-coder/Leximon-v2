      "text": "Khi tôi mở hộp ở nhà, tôi phát hiện một chiếc ly bị sứt mẻ.",
      "author": "ChatGPT4.1"
    },
    "71121": {
      "id": 2589590,
      "text": "Tôi ở đây để giúp bạn về việc đó.",
      "author": "ChatGPT4.1"
    },
    "71122": {
      "id": 2589591,
      "text": "Bạn có thể cho tôi xem hóa đơn được không?",
