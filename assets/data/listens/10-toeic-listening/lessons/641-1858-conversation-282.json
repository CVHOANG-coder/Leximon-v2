    },
    "71123": {
      "id": 2589592,
      "text": "Tôi có thể đổi bộ mới cho bạn hoặc hoàn tiền lại.",
      "author": "ChatGPT4.1"
    },
    "71124": {
      "id": 2589593,
      "text": "Bạn muốn chọn phương án nào?",
      "author": "ChatGPT4.1"
    },
    "71125": {
      "id": 2589594,
      "text": "Tôi muốn đổi lấy một bộ khác.",
      "author": "ChatGPT4.1"
    },
    "71126": {
      "id": 2589595,
      "text": "Nhưng trước khi kết thúc, tôi muốn lấy thêm một vài khăn bếp.",
      "author": "ChatGPT4.1"
    },
    "71127": {
      "id": 2589596,
      "text": "Tôi có thể thanh toán những thứ đó ở quầy dịch vụ luôn không?",
      "author": "ChatGPT4.1"
    },
    "71128": {
