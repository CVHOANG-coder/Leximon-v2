  "translations": {
    "66527": {
      "id": 2619301,
      "text": "Xin chào, tôi là khách ở phòng 3110.",
      "author": "ChatGPT4.1"
    },
    "66528": {
      "id": 2619302,
      "text": "Tôi muốn biết tối nay còn vé xem vở The Lion King không.",
      "author": "ChatGPT4.1"
    },
    "66529": {
      "id": 2619303,
      "text": "Chắc chắn rồi.",
      "author": "ChatGPT4.1"
    },
    "66530": {
      "id": 2619304,
      "text": "Họ còn khá nhiều ghế orchestra,",
      "author": "ChatGPT4.1"
    },
    "66531": {
      "id": 2619305,
      "text": "giá từ 80 đô cho đến 220 đô một ghế.",
      "author": "ChatGPT4.1"
    },
    "66532": {
      "id": 2619306,
      "text": "Tôi gợi ý ghế ở khu vực orchestra trung tâm.",
      "author": "ChatGPT4.1"
    },
    "66533": {
      "id": 2619307,
      "text": "Có thể nói chúng là những chỗ tốt nhất trong rạp.",
      "author": "ChatGPT4.1"
    },
    "66534": {
      "id": 2619308,
      "text": "Ờ, làm ơn nhắc tôi lại...",
      "author": "ChatGPT4.1"
    },
    "66535": {
      "id": 2619309,
      "text": "Ghế orchestra là ghế ở tầng trệt, đúng không?",
      "author": "ChatGPT4.1"
    },
    "66536": {
      "id": 2619310,
      "text": "Tôi muốn hai ghế không quá gần sân khấu.",
      "author": "ChatGPT4.1"
    },
    "66537": {
      "id": 2619311,
      "text": "Chúng có giá bao nhiêu?",
      "author": "ChatGPT4.1"
    },
    "66538": {
      "id": 2619312,
      "text": "Vâng, hai ghế ở hàng Q sẽ là 240 đô, thưa ông.",
      "author": "ChatGPT4.1"
    },
    "66539": {
      "id": 2619313,
      "text": "Buổi diễn bắt đầu lúc 8 giờ tối.",
      "author": "ChatGPT4.1"
    },
    "66540": {
      "id": 2619314,
      "text": "Tôi sẽ để vé của ông ở quầy lễ tân vào lúc 4 giờ chiều.",
      "author": "ChatGPT4.1"
    },
    "66541": {
      "id": 2619315,
      "text": "Cảm ơn rất nhiều. Tôi rất trân trọng.",
      "author": "ChatGPT4.1"
    }
  }
