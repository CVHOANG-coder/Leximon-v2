  "translations": {
    "52809": {
      "id": 872319,
      "text": "Tôi muốn liên hệ về đơn ứng tuyển của bạn cho vị trí copywriter tại Ngân hàng Everyday.",
      "author": "a user"
    },
    "52813": {
      "id": 872330,
      "text": "và muốn hỏi về thời gian rảnh của bạn trong tuần này?",
      "author": "a user"
    },
    "52815": {
      "id": 872334,
      "text": "Tôi rất vui khi bạn liên hệ.",
      "author": "a user"
    },
    "52819": {
      "id": 876163,
      "text": "Bạn có rảnh để đến vào trưa thứ Năm không?",
      "author": "a user"
    },
    "52821": {
      "id": 876166,
      "text": "một thử thách viết lách nhỏ và một cuộc trò chuyện với nhóm nội dung.",
      "author": "a user"
    },
    "52823": {
      "id": 876171,
      "text": "nên chúng tôi sẽ giúp bạn rời khỏi đây trước 1 giờ.",
      "author": "a user"
    },
    "52808": {
      "id": 2591625,
      "text": "Xin chào, Andrea.",
      "author": "ChatGPT4.1"
    },
    "52810": {
      "id": 2591626,
      "text": "Tên tôi là Quint Daniels,",
      "author": "ChatGPT4.1"
    },
    "52811": {
      "id": 2591627,
      "text": "Tôi là trưởng phòng nhân sự.",
      "author": "ChatGPT4.1"
    },
    "52812": {
      "id": 2591628,
      "text": "Chúng tôi muốn mời bạn đến phỏng vấn",
      "author": "ChatGPT4.1"
    },
    "52814": {
      "id": 2591629,
      "text": "Chào buổi sáng, ông Daniels.",
      "author": "ChatGPT4.1"
    },
    "52816": {
      "id": 2591630,
      "text": "Hiện tại tôi đang ở ngoài thành phố và sẽ bay về vào ngày mai,",
      "author": "ChatGPT4.1"
    },
    "52817": {
      "id": 2591631,
      "text": "Nên tôi sẽ không rảnh cho đến thứ Năm hoặc thứ Sáu.",
      "author": "a user"
    },
    "52818": {
      "id": 2591632,
      "text": "Điều đó không thành vấn đề.",
      "author": "ChatGPT4.1"
    },
    "52820": {
      "id": 2591633,
      "text": "Bước tiếp theo sẽ gồm hai phần,",
      "author": "ChatGPT4.1"
    },
    "52822": {
      "id": 2591634,
      "text": "Toàn bộ quá trình sẽ mất khoảng một giờ,",
      "author": "ChatGPT4.1"
    }
  }
