  "translations": {
    "71522": {
      "id": 2583743,
      "text": "Chào mừng đến với Lễ hội Nghệ thuật và Thủ công Mỹ nghệ thường niên Greenfield.",
      "author": "ChatGPT4.1"
    },
    "71523": {
      "id": 2583744,
      "text": "Mỗi mùa xuân, chúng ta tụ họp để tôn vinh sự sáng tạo và tay nghề trong cộng đồng của mình.",
      "author": "ChatGPT4.1"
    },
    "71524": {
      "id": 2583745,
      "text": "Bên cạnh triển lãm và bán các sản phẩm thủ công từ các nghệ nhân địa phương,",
      "author": "ChatGPT4.1"
    },
    "71525": {
      "id": 2583746,
      "text": "chúng tôi rất vui mừng giới thiệu một không gian trưng bày đặc biệt năm nay:",
      "author": "ChatGPT4.1"
    },
    "71526": {
      "id": 2583747,
      "text": "một phòng trưng bày gốm sứ tinh xảo từ các nghệ sĩ nổi tiếng trên toàn thế giới.",
      "author": "ChatGPT4.1"
    },
    "71527": {
      "id": 2583748,
      "text": "Những tác phẩm này được cho mượn từ Viện Gốm sứ Quốc tế",
      "author": "ChatGPT4.1"
    },
    "71528": {
      "id": 2583749,
      "text": "và sẽ được trưng bày tại sảnh chính trong suốt lễ hội.",
      "author": "ChatGPT4.1"
    },
    "71529": {
      "id": 2583750,
      "text": "Ngoài ra, tôi xin gửi lời cảm ơn chân thành",
      "author": "ChatGPT4.1"
    },
    "71530": {
      "id": 2583751,
      "text": "đến nhà tài trợ doanh nghiệp năm nay, Palisade Innovations, vì sự hỗ trợ hào phóng của họ.",
      "author": "ChatGPT4.1"
    }
  }
}
