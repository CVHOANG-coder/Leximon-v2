  "translations": {
    "55276": {
      "id": 969579,
      "text": "Vui lòng cho khách hàng biết tối nay chúng tôi đang khuyến mại mua một ly martini được ưu đãi giảm giá 50% cho ly thứ 2.",
      "author": "a user"
    },
    "55268": {
      "id": 2644161,
      "text": "Mọi người hãy tập trung lại.",
      "author": "ChatGPT4.1"
    },
    "55269": {
      "id": 2644162,
      "text": "Trước ca phục vụ bữa tối tối nay, tôi muốn giới thiệu với các bạn một nhân viên pha chế mới, Ben Wilson.",
      "author": "ChatGPT4.1"
    },
    "55270": {
      "id": 2644163,
      "text": "Nhiều người trong số các bạn đã có mặt khi Alex Wills nghỉ việc giữa ca làm tuần trước,",
      "author": "ChatGPT4.1"
    },
    "55271": {
      "id": 2644164,
      "text": "nên rất rõ ràng là anh ấy sẽ không còn làm việc cho chúng ta nữa.",
      "author": "ChatGPT4.1"
    },
    "55272": {
      "id": 2644165,
      "text": "Ben là người thay thế Alex, người có nhiều kinh nghiệm.",
      "author": "ChatGPT4.1"
    },
    "55273": {
      "id": 2644166,
      "text": "Anh ấy đã làm việc ở nhiều quán cocktail tại Sydney và gần đây đã chuyển đến Melbourne.",
      "author": "ChatGPT4.1"
    },
    "55274": {
      "id": 2644167,
      "text": "Món đặc biệt của Ben là espresso martini,",
      "author": "ChatGPT4.1"
    },
    "55275": {
      "id": 2644168,
      "text": "vì vậy tối nay chúng ta sẽ có một chương trình khuyến mãi đặc biệt để chào đón anh ấy.",
      "author": "ChatGPT4.1"
    }
  }
