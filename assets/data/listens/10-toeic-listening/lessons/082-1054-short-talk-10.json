    },
    "52738": {
      "id": 872356,
      "text": "nhưng chúng tôi không có biên nhận trong ngày đó.",
      "author": "a user"
    },
    "52741": {
      "id": 872359,
      "text": "Nếu bạn không tìm thấy nó, hãy gọi cho tôi theo số máy nhánh số 4",
      "author": "a user"
    },
    "52742": {
      "id": 872360,
      "text": "và chúng ta sẽ nói về các bước tiếp theo để hoàn trả cho bạn.",
      "author": "a user"
    },
    "52734": {
      "id": 2593139,
      "text": "Chào Jack. Đây là Joe, từ phòng kế toán.",
