    },
    "52739": {
      "id": 2593141,
      "text": "Hoá đơn là bắt buộc cho bất kỳ khoản hoàn trả nào.",
      "author": "ChatGPT4.1"
    },
    "52740": {
      "id": 2593142,
      "text": "Bạn có thể tìm hóa đơn đó và gửi fax cho tôi không?",
