  "translations": {
    "69109": {
      "id": 2588139,
      "text": "Tôi rất quan tâm đến việc tham gia các buổi tập buổi sáng.",
      "author": "ChatGPT4.1"
    },
    "69110": {
      "id": 2588140,
      "text": "Bạn có thể cho tôi biết lịch học là khi nào không?",
      "author": "ChatGPT4.1"
    },
    "69111": {
      "id": 2588141,
      "text": "Chắc chắn rồi!",
      "author": "ChatGPT4.1"
    },
    "69112": {
      "id": 2588142,
      "text": "Các lớp yoga buổi sáng của chúng tôi diễn ra vào thứ Ba và thứ Năm hàng tuần,",
      "author": "ChatGPT4.1"
    },
    "69113": {
      "id": 2588143,
      "text": "bắt đầu từ 7 giờ sáng và kết thúc lúc 8 giờ 30 phút sáng.",
      "author": "ChatGPT4.1"
    },
    "69114": {
      "id": 2588144,
      "text": "Chúng tôi nhận thấy đó là thời gian tốt nhất để giúp mọi người bắt đầu ngày mới với năng lượng tích cực.",
      "author": "ChatGPT4.1"
    },
    "69115": {
      "id": 2588145,
      "text": "Tuyệt vời!",
      "author": "ChatGPT4.1"
    },
    "69116": {
      "id": 2588146,
      "text": "Thời gian đó rất phù hợp với lịch trình của tôi.",
      "author": "ChatGPT4.1"
    },
    "69117": {
      "id": 2588147,
      "text": "Bạn có thể cho tôi biết tôi sẽ trải nghiệm gì trong một buổi học thông thường không?",
      "author": "ChatGPT4.1"
    },
    "69118": {
      "id": 2588148,
      "text": "Chắc chắn rồi!",
      "author": "ChatGPT4.1"
    },
    "69119": {
      "id": 2588149,
      "text": "Nếu bạn quan tâm,",
      "author": "ChatGPT4.1"
    },
    "69120": {
      "id": 2588150,
      "text": "Tôi cũng có thể cung cấp cho bạn một tờ rơi chi tiết về các phong cách yoga mà chúng tôi giảng dạy,",
      "author": "ChatGPT4.1"
    },
    "69121": {
      "id": 2588151,
      "text": "các loại tư thế, và thông tin về các giảng viên.",
      "author": "ChatGPT4.1"
    },
    "69122": {
      "id": 2588152,
      "text": "Tờ rơi này có tất cả những gì bạn cần biết để bắt đầu.",
      "author": "ChatGPT4.1"
    },
    "69123": {
      "id": 2588153,
      "text": "Điều đó thật tuyệt, cảm ơn bạn!",
      "author": "ChatGPT4.1"
    },
    "69108": {
