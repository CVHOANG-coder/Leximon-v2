  "translations": {
    "68588": {
      "id": 2618287,
      "text": "Chào buổi sáng, cô Harper.",
      "author": "ChatGPT4.1"
    },
    "68589": {
      "id": 2618288,
      "text": "Tôi là Emily từ Công ty Bất động sản Coastal.",
      "author": "ChatGPT4.1"
    },
    "68590": {
      "id": 2618289,
      "text": "Tôi gọi để trao đổi thêm về yêu cầu gần đây của cô về các bất động sản ở khu vực Seaview Heights.",
      "author": "ChatGPT4.1"
    },
    "68591": {
      "id": 2618290,
      "text": "Chúng tôi có một số danh sách mới mà tôi nghĩ có thể sẽ khiến cô quan tâm,",
      "author": "ChatGPT4.1"
    },
    "68592": {
      "id": 2618291,
      "text": "bao gồm một ngôi nhà 3 phòng ngủ với tầm nhìn ra biển tuyệt đẹp.",
      "author": "ChatGPT4.1"
    },
    "68593": {
      "id": 2618292,
      "text": "Tôi rất sẵn lòng sắp xếp một buổi tham quan theo thời gian thuận tiện cho cô, trực tuyến hoặc trực tiếp.",
      "author": "ChatGPT4.1"
    },
    "68594": {
      "id": 2618293,
      "text": "Tôi cũng muốn đề cập rằng khu vực này có các trường học rất tốt, như cô đã hỏi,",
      "author": "ChatGPT4.1"
    },
    "68595": {
      "id": 2618294,
      "text": "và việc di chuyển đến trung tâm thành phố chỉ mất khoảng 20 phút.",
      "author": "ChatGPT4.1"
    },
    "68596": {
      "id": 2618295,
      "text": "Xin cho tôi biết nếu cô muốn biết thêm chi tiết!",
      "author": "ChatGPT4.1"
    }
  }
