  "translations": {
    "70978": {
      "id": 2585068,
      "text": "Chào mừng bạn đến với Nhà hát Paramount.",
      "author": "ChatGPT4.1"
    },
    "70979": {
      "id": 2585069,
      "text": "Tôi có thể xem vé của bạn không?",
      "author": "ChatGPT4.1"
    },
    "70980": {
      "id": 2585070,
      "text": "Tất nhiên rồi. Đây ạ.",
      "author": "ChatGPT4.1"
    },
    "70981": {
      "id": 2585071,
      "text": "Cảm ơn. Có vẻ như bạn ngồi ở ghế 45, khu B.",
      "author": "ChatGPT4.1"
    },
    "70982": {
      "id": 2585072,
      "text": "Bạn chỉ cần đi qua những cánh cửa đó, sẽ có người hướng dẫn giúp bạn tìm ghế.",
      "author": "ChatGPT4.1"
    },
    "70983": {
      "id": 2585073,
      "text": "Buổi hòa nhạc sẽ bắt đầu lúc tám giờ, nên... hãy tận hưởng nhé!",
      "author": "ChatGPT4.1"
    },
    "70984": {
      "id": 2585074,
      "text": "Cảm ơn bạn rất nhiều.",
      "author": "ChatGPT4.1"
    },
    "70985": {
      "id": 2585075,
      "text": "Nhân tiện, mình có được mang đồ ăn vặt vào không?",
      "author": "ChatGPT4.1"
    },
    "70986": {
      "id": 2585076,
      "text": "Tôi đang nghĩ sẽ mua gì đó ở quầy bán đồ ăn.",
      "author": "ChatGPT4.1"
    },
    "70987": {
      "id": 2585077,
      "text": "Vâng, được mà.",
      "author": "ChatGPT4.1"
    },
    "70988": {
      "id": 2585078,
      "text": "Chỉ nhắc trước, không được quay video nhé.",
      "author": "ChatGPT4.1"
    },
    "70989": {
      "id": 2585079,
      "text": "Và vui lòng để điện thoại ở chế độ im lặng để không làm gián đoạn chương trình.",
      "author": "ChatGPT4.1"
    }
  }
}
