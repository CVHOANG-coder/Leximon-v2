  "translations": {
    "55803": {
      "id": 2606540,
      "text": "Chào, Amanda.",
      "author": "ChatGPT4.1"
    },
    "55804": {
      "id": 2606541,
      "text": "Bella kể với tôi rằng bạn đã từng là người chơi bowling xuất sắc nhất trong đội ở trường cấp ba.",
      "author": "ChatGPT4.1"
    },
    "55805": {
      "id": 2606542,
      "text": "Bạn có hứng thú tham gia câu lạc bộ bowling của chúng tôi không?",
      "author": "ChatGPT4.1"
    },
    "55806": {
      "id": 2606543,
      "text": "Chúng tôi chơi tại trung tâm bowling gần trường tiểu học Boyd.",
      "author": "ChatGPT4.1"
    },
    "55807": {
      "id": 2606544,
      "text": "À, mặc dù tôi rất muốn nhận lời mời của bạn,",
      "author": "ChatGPT4.1"
    },
    "55808": {
      "id": 2606545,
      "text": "Tôi vẫn cần phải suy nghĩ vì tôi vừa mới chuyển nhà gần đây.",
      "author": "ChatGPT4.1"
    },
    "55809": {
      "id": 2606546,
      "text": "Chỗ đó quá xa nhà mới của tôi.",
      "author": "ChatGPT4.1"
    },
    "55810": {
      "id": 2606547,
      "text": "Ừ, có một trung tâm bowling liên kết với sòng bạc River Rock gần chỗ bạn ở.",
      "author": "ChatGPT4.1"
    },
    "55811": {
      "id": 2606548,
      "text": "Nhóm chúng ta có thể chơi ở đó.",
      "author": "ChatGPT4.1"
    },
    "55812": {
      "id": 2606549,
      "text": "Thật sao?",
      "author": "ChatGPT4.1"
    },
    "55813": {
      "id": 2606550,
      "text": "Có thể đi bộ tới đó không?",
      "author": "ChatGPT4.1"
    },
    "55814": {
      "id": 2606551,
      "text": "Có! Trung tâm bowling nằm ngay bên cạnh Blundell Mall.",
      "author": "ChatGPT4.1"
    },
    "55815": {
      "id": 2606552,
      "text": "Từ lúc chuyển đến, tôi chưa có thời gian tìm hiểu khu vực này.",
      "author": "ChatGPT4.1"
    },
    "55816": {
      "id": 2606553,
      "text": "Nó nằm trên đường Amadeus phải không?",
      "author": "ChatGPT4.1"
    },
    "55817": {
      "id": 2606554,
      "text": "Không, đó là tòa nhà lớn đối diện Trung tâm Hội nghị Oakridge.",
      "author": "ChatGPT4.1"
    },
    "55818": {
      "id": 2606555,
      "text": "Nó đối diện đường Georgia.",
      "author": "ChatGPT4.1"
    },
    "55819": {
      "id": 2606556,
      "text": "Cảm ơn, tôi nghĩ mình đã biết rồi.",
