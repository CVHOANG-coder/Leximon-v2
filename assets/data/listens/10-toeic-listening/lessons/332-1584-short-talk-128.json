  "translations": {
    "66786": {
      "id": 2622380,
      "text": "Chào buổi sáng, tôi là Sarah Cartlet, gọi từ We Plan, You Travel.",
      "author": "ChatGPT4.1"
    },
    "66787": {
      "id": 2622381,
      "text": "Tin nhắn này gửi đến Julia Stone.",
      "author": "ChatGPT4.1"
    },
    "66788": {
      "id": 2622382,
      "text": "Tôi gọi về chuyến đi mà bạn sẽ tham gia vào thứ Hai tới.",
      "author": "ChatGPT4.1"
    },
    "66789": {
      "id": 2622383,
      "text": "Chúng tôi đã xác nhận phòng đôi của bạn tại Hollywood Hills Inn cho chuyến đi ba ngày của bạn.",
      "author": "ChatGPT4.1"
    },
    "66790": {
      "id": 2622384,
      "text": "Ờ... Về chuyến bay của bạn, tôi biết bạn đã yêu cầu chuyến bay khởi hành lúc 2 giờ chiều.",
      "author": "ChatGPT4.1"
    },
    "66791": {
      "id": 2622385,
      "text": "Thật tiếc, chúng tôi không thể đặt cho bạn chuyến bay vào buổi chiều,",
      "author": "ChatGPT4.1"
    },
    "66792": {
      "id": 2622386,
      "text": "vì vậy tôi đã đặt cho bạn chuyến bay đầu buổi tối từ San Francisco đến Los Angeles.",
      "author": "ChatGPT4.1"
    },
    "66793": {
      "id": 2622387,
      "text": "Bạn sẽ khởi hành lúc 5:05 chiều và đến nơi lúc 6 giờ tối.",
      "author": "ChatGPT4.1"
    },
    "66794": {
      "id": 2622388,
      "text": "Vé có giá 76 đô la, và tôi sẽ gửi email cho bạn một bản sao hóa đơn.",
      "author": "ChatGPT4.1"
    },
    "66795": {
      "id": 2622389,
      "text": "Hãy gọi lại cho tôi để xác nhận thời gian này có phù hợp với bạn hay không theo số 555-6523.",
      "author": "ChatGPT4.1"
    },
    "66796": {
      "id": 2622390,
      "text": "Tôi sẽ sớm liên lạc lại với bạn.",
      "author": "ChatGPT4.1"
    }
  }
