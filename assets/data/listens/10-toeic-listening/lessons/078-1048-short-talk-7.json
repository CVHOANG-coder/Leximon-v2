  "translations": {
    "52667": {
      "id": 872336,
      "text": "hoặc NP, như ở đây chúng tôi thường gọi với cái tên đó.",
      "author": "a user"
    },
    "52670": {
      "id": 872339,
      "text": "Đây là một triển lãm mới khám phá công việc của những người có ảnh hưởng trên mạng xã hội,",
      "author": "a user"
    },
    "52665": {
      "id": 2590618,
      "text": "Chào mừng các học sinh thành phố New York,",
      "author": "ChatGPT4.1"
    },
    "52666": {
      "id": 2590619,
      "text": "Tôi xin chào mừng tất cả các bạn đến với Phòng Trưng Bày Chân Dung Quốc Gia ở London,",
      "author": "ChatGPT4.1"
    },
    "52668": {
      "id": 2590620,
      "text": "Chuyến tham quan hôm nay của chúng ta sẽ kéo dài một giờ,",
      "author": "ChatGPT4.1"
    },
    "52669": {
      "id": 2590621,
      "text": "và chúng ta sẽ tập trung vào triển lãm hiện tại mang tên \"The Selfie\".",
      "author": "ChatGPT4.1"
    },
    "52671": {
      "id": 2590622,
      "text": "và có thể không được một số người coi là nghệ thuật.",
      "author": "ChatGPT4.1"
    },
    "52672": {
      "id": 2590623,
      "text": "Chúng ta cũng sẽ đề cập đến cách các nghệ sĩ trẻ kết hợp nghệ thuật và công nghệ.",
      "author": "ChatGPT4.1"
    },
    "52673": {
      "id": 2590624,
      "text": "Tôi khuyên mọi người nên ghé thăm cửa hàng quà lưu niệm của chúng tôi sau chuyến tham quan,",
      "author": "ChatGPT4.1"
    },
    "52674": {
      "id": 2590625,
      "text": "có một số bản in tuyệt vời mà chúng tôi không bán trực tuyến,",
      "author": "ChatGPT4.1"
    },
    "52675": {
      "id": 2590626,
      "text": "cũng như một số vật dụng in ấn nếu bạn muốn tự tạo tác phẩm nghệ thuật của riêng mình.",
      "author": "ChatGPT4.1"
    },
    "52676": {
      "id": 2590627,
      "text": "Bây giờ, hãy bắt đầu với bức chân dung tự họa đầu tiên này.",
      "author": "ChatGPT4.1"
    }
  }
