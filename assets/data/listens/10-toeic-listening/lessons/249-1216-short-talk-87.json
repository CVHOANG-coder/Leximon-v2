  "translations": {
    "55063": {
      "id": 963916,
      "text": "Tôi rất vui mừng thông báo cho tất cả các bạn biết rằng công ty của chúng ta đã được vinh danh là công ty tiếp thị của năm 2015.",
      "author": "a user"
    },
    "55061": {
      "id": 2585294,
      "text": "Chào mọi người.",
      "author": "ChatGPT4.1"
    },
    "55062": {
      "id": 2585295,
      "text": "Như các bạn biết, tôi là trưởng phòng marketing.",
      "author": "ChatGPT4.1"
    },
    "55064": {
      "id": 2585296,
      "text": "Đây là nhờ vào sự siêng năng và làm việc chăm chỉ của tất cả mọi người.",
      "author": "ChatGPT4.1"
    },
    "55065": {
      "id": 2585297,
      "text": "Tôi muốn gửi lời cảm ơn cá nhân tới Jack Ross và nhóm của anh ấy vì công việc của họ trong dự án Sở thú.",
      "author": "ChatGPT4.1"
    },
    "55066": {
      "id": 2585298,
      "text": "Sở thú đã tăng lượng khách tham quan lên 20% nhờ chiến dịch này.",
      "author": "ChatGPT4.1"
    },
    "55067": {
      "id": 2585299,
      "text": "Hãy cùng nhau chúc mừng ông Ross và nhóm của ông ấy bằng một tràng pháo tay.",
      "author": "ChatGPT4.1"
    }
  }
