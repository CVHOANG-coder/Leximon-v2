  "translations": {
    "66347": {
      "id": 2594163,
      "text": "Chào mừng bạn đến với TrueBlue Furnishing.",
      "author": "ChatGPT4.1"
    },
    "66348": {
      "id": 2594164,
      "text": "Tôi có thể giúp gì cho bạn?",
      "author": "ChatGPT4.1"
    },
    "66349": {
      "id": 2594165,
      "text": "Ồ, xin chào,",
      "author": "ChatGPT4.1"
    },
    "66350": {
      "id": 2594166,
      "text": "Tôi chỉ đang chờ một nhân viên của bạn mang ra vài chiếc đèn bàn để tôi xem.",
      "author": "ChatGPT4.1"
    },
    "66351": {
      "id": 2594167,
      "text": "Tôi không có ý bất lịch sự, nhưng đã khá lâu rồi.",
      "author": "ChatGPT4.1"
    },
    "66352": {
      "id": 2594168,
      "text": "Để tôi đi kiểm tra xem có chuyện gì ở phía sau nhé.",
      "author": "ChatGPT4.1"
    },
    "66353": {
      "id": 2594169,
      "text": "Xin lỗi bạn về điều đó.",
      "author": "ChatGPT4.1"
    },
    "66354": {
      "id": 2594170,
      "text": "À, tiện thể, bạn có thể mang cho tôi thêm một chiếc đèn bàn nữa không?",
      "author": "ChatGPT4.1"
    },
    "66355": {
      "id": 2594171,
      "text": "Tôi muốn so sánh những chiếc tôi đã đặt với chiếc mà tôi vừa thấy trong danh mục sản phẩm này.",
      "author": "ChatGPT4.1"
    },
    "66356": {
      "id": 2594172,
      "text": "Rất sẵn lòng.",
      "author": "ChatGPT4.1"
    },
    "66357": {
      "id": 2594173,
      "text": "Tôi có thể hỏi đó là mẫu đèn bàn nào không?",
      "author": "ChatGPT4.1"
    },
    "66358": {
      "id": 2594174,
      "text": "À, tôi thích chiếc này, với bóng đèn tròn lớn bằng thủy tinh trong suốt.",
      "author": "ChatGPT4.1"
    }
  }
