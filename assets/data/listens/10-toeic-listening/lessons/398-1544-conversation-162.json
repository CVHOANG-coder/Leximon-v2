  "translations": {
    "66196": {
      "id": 2598715,
      "text": "Có ai trong số các bạn muốn đến Flor Patisserie vào Chủ nhật tới không?",
      "author": "ChatGPT4.1"
    },
    "66197": {
      "id": 2598716,
      "text": "Đó chẳng phải là tiệm bánh mới trên đường Main sao?",
      "author": "ChatGPT4.1"
    },
    "66198": {
      "id": 2598717,
      "text": "Vậy thì tính cả tôi nhé.",
      "author": "ChatGPT4.1"
    },
    "66199": {
      "id": 2598718,
      "text": "Tôi đã muốn thử bánh croissant bơ của họ kể từ khi tôi tình cờ đọc được một bài báo về chỗ này.",
      "author": "ChatGPT4.1"
    },
    "66200": {
      "id": 2598719,
      "text": "Blog ẩm thực nói rằng các loại bánh ở đây vừa chuẩn vị vừa độc đáo, và cho chỗ này đánh giá 4,9 sao.",
      "author": "ChatGPT4.1"
    },
    "66201": {
      "id": 2598720,
      "text": "Đúng vậy, nghe nói đầu bếp từng học Nghệ thuật Ẩm thực ở Pháp và đã giành giải thưởng cao nhất cho bánh croissant ngon nhất ở Paris.",
      "author": "ChatGPT4.1"
    },
    "66202": {
      "id": 2598721,
      "text": "Đó chưa phải là tất cả.",
      "author": "ChatGPT4.1"
    },
    "66203": {
      "id": 2598722,
      "text": "Nơi này tự hào là quan tâm đến sức khỏe và có trách nhiệm với môi trường.",
      "author": "ChatGPT4.1"
    },
    "66204": {
      "id": 2598723,
      "text": "Tất cả bánh của họ đều được làm từ bột mì và bơ hữu cơ.",
      "author": "ChatGPT4.1"
    },
    "66205": {
      "id": 2598724,
      "text": "Vậy thì tôi đồng ý luôn.",
      "author": "ChatGPT4.1"
    },
    "66206": {
      "id": 2598725,
      "text": "Hãy đặt chỗ trước đi.",
      "author": "ChatGPT4.1"
    },
    "66207": {
      "id": 2598726,
      "text": "Chủ nhật lúc 3 giờ chiều thì sao?",
      "author": "ChatGPT4.1"
    }
  }
