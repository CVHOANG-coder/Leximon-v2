  "translations": {
    "66028": {
      "id": 2643459,
      "text": "George, tôi rất mừng vì đã gặp được anh!",
      "author": "ChatGPT4.1"
    },
    "66029": {
      "id": 2643460,
      "text": "Bà Hasperth đã gọi điện suốt cả ngày.",
      "author": "ChatGPT4.1"
    },
    "66030": {
      "id": 2643461,
      "text": "Bà ấy muốn biết khi nào giấy dán tường cho văn phòng trên đồi Rose sẽ đến.",
      "author": "ChatGPT4.1"
    },
    "66031": {
      "id": 2643462,
      "text": "Anh có biết không?",
      "author": "ChatGPT4.1"
    },
    "66032": {
      "id": 2643463,
      "text": "Thật ra tôi vừa kết thúc cuộc gọi với nhà cung cấp.",
      "author": "ChatGPT4.1"
    },
    "66033": {
      "id": 2643464,
      "text": "Họ gặp chút khó khăn trong việc lấy giấy dán tường đúng màu bà ấy yêu cầu,",
      "author": "ChatGPT4.1"
    },
    "66034": {
      "id": 2643465,
      "text": "nên toàn bộ đơn hàng đang tạm hoãn lại.",
      "author": "ChatGPT4.1"
    },
    "66035": {
      "id": 2643466,
      "text": "Họ dự kiến sẽ báo cho tôi biết trước cuối ngày.",
      "author": "ChatGPT4.1"
    },
    "66036": {
      "id": 2643467,
      "text": "Anh có muốn tôi gọi cho bà Hasperth khi có tin không?",
      "author": "ChatGPT4.1"
    },
    "66037": {
      "id": 2643468,
      "text": "Không cần đâu, cảm ơn nhé.",
      "author": "ChatGPT4.1"
    },
    "66038": {
      "id": 2643469,
      "text": "Bà ấy còn nhờ tôi kiểm tra vài việc khác nữa,",
      "author": "ChatGPT4.1"
    },
    "66039": {
      "id": 2643470,
      "text": "nên dù sao tôi cũng phải gọi lại cho bà ấy vào sáng mai.",
      "author": "ChatGPT4.1"
    },
    "66040": {
      "id": 2643471,
      "text": "Tôi sẽ báo hết các thông tin mới cho bà ấy lúc đó.",
      "author": "ChatGPT4.1"
    },
    "66041": {
      "id": 2643472,
      "text": "Nhắn cho tôi bất cứ khi nào anh nghe được tin gì nhé.",
      "author": "ChatGPT4.1"
    },
    "66042": {
      "id": 2643473,
      "text": "Tôi sẽ làm vậy!",
      "author": "ChatGPT4.1"
    }
  }
}
