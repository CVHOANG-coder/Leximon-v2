  "translations": {
    "54764": {
      "id": 912474,
      "text": "Tất cả chúng ta đều có một chiếc tivi hoặc máy tính cũ nằm xung quanh mà chúng ta không sử dụng.",
      "author": "a user"
    },
    "54765": {
      "id": 2622424,
      "text": "Tại sao bạn không mang chúng đến cho chúng tôi, tại ReNew Electronics?",
      "author": "ChatGPT4.1"
    },
    "54766": {
      "id": 2622425,
      "text": "Chúng tôi có thể sắp xếp ngày để xe tải đến lấy các thiết bị điện tử không dùng đến của bạn và tái chế chúng, hoàn toàn miễn phí.",
      "author": "ChatGPT4.1"
    },
    "54767": {
      "id": 2622426,
      "text": "Đó chưa phải là tất cả!",
      "author": "ChatGPT4.1"
    },
    "54768": {
      "id": 2622427,
      "text": "Nếu chúng tôi có thể bán được sản phẩm của bạn,",
      "author": "ChatGPT4.1"
    },
    "54769": {
      "id": 2622428,
      "text": "bạn sẽ nhận được giảm giá 10% cho bất kỳ mặt hàng nào được bán tại cửa hàng của chúng tôi!",
      "author": "ChatGPT4.1"
    },
    "54770": {
      "id": 2622429,
      "text": "Để biết thêm chi tiết về quy trình quyên góp, hoặc tìm địa điểm gần bạn nhất,",
      "author": "ChatGPT4.1"
    },
    "54771": {
      "id": 2622430,
      "text": "hãy truy cập trang web của chúng tôi tại www.renew.com, hoặc tìm chúng tôi trên mạng xã hội!",
      "author": "ChatGPT4.1"
    }
  }
