  "translations": {
    "1147": {
      "id": 3911,
      "text": "Bữa sáng là một bữa ăn vội ở nhà của chúng tôi",
      "author": "a user"
    },
    "1150": {
      "id": 3914,
      "text": "Vào cuối tuần, mẹ tôi làm thịt xông khói và trứng cho chúng tôi",
      "author": "a user"
    },
    "1151": {
      "id": 3915,
      "text": "Ba tôi chỉ uống có một tách cà phê cho bữa sáng.",
      "author": "a user"
    },
    "1152": {
      "id": 3916,
      "text": "Mẹ tôi chuẩn bị đồ ăn trưa cho tất cả chúng tôi.",
      "author": "a user"
    },
    "1156": {
      "id": 3920,
      "text": "Anh trai tôi luôn muốn có bánh mì kẹp bơ đậu phộng và mứt.",
      "author": "a user"
    },
    "1157": {
      "id": 3921,
      "text": "Mẹ tôi thỉnh thoảng gói một món ăn vặt cho chúng tôi.",
      "author": "a user"
    },
    "1158": {
      "id": 3922,
      "text": "Hôm nay chúng tôi ăn bánh quy kèm với bữa trưa.",
      "author": "a user"
    },
    "1170": {
      "id": 3936,
      "text": "Tôi bày nĩa, dao và thìa ra.",
      "author": "a user"
    },
    "1172": {
      "id": 3940,
      "text": "Đối với món tráng miệng, đôi khi chúng tôi ăn kem, bánh ngọt hoặc bánh nướng",
      "author": "a user"
    },
    "1173": {
      "id": 3942,
      "text": "Mẹ tôi nói rằng tốt hơn là nên ăn trái cây vì nó tốt hơn cho bạn.",
      "author": "a user"
    },
    "1176": {
      "id": 3950,
      "text": "Sau bữa tối, mẹ luôn uống một tách trà với đường và kem trong đó.",
      "author": "a user"
    },
    "1148": {
      "id": 2594777,
      "text": "Anh chị em tôi và tôi ăn bánh mì nướng hoặc ngũ cốc.",
      "author": "ChatGPT4.1"
    },
    "1149": {
      "id": 2594778,
      "text": "Chúng tôi cũng uống nước cam.",
      "author": "ChatGPT4.1"
    },
    "1153": {
      "id": 2594779,
      "text": "Chúng tôi thường có một chiếc bánh mì kẹp",
      "author": "ChatGPT4.1"
    },
    "1154": {
      "id": 2594780,
      "text": "một miếng trái cây và một ly nước ép hoặc một ly sữa.",
      "author": "a user"
    },
    "1155": {
      "id": 2594781,
      "text": "Bánh mì kẹp tôi thích nhất là salad trứng, cá ngừ, bò nướng và giăm bông.",
      "author": "ChatGPT4.1"
    },
    "1159": {
      "id": 2594782,
      "text": "Vào giờ ăn tối, cả gia đình ngồi quanh bàn và nói chuyện về những gì họ đã làm cả ngày.",
      "author": "ChatGPT4.1"
    },
    "1160": {
      "id": 2594783,
      "text": "Những bữa cơm tối mẹ tôi nấu rất ngon.",
      "author": "a user"
    },
    "1161": {
      "id": 2594784,
      "text": "Thỉnh thoảng chúng tôi ăn mì ý.",
      "author": "ChatGPT4.1"
    },
    "1162": {
      "id": 2594785,
      "text": "Mẹ tôi khá thường xuyên làm món bò nướng với khoai tây và rau củ.",
      "author": "ChatGPT4.1"
    },
    "1163": {
      "id": 2594786,
      "text": "Bà ấy làm nhiều món khác nhau từ gà.",
      "author": "ChatGPT4.1"
    },
    "1164": {
      "id": 2594787,
      "text": "Bà ấy nấu súp hoặc các món hầm.",
      "author": "a user"
    },
    "1165": {
      "id": 2594788,
      "text": "Bà ấy cũng làm các món đút lò",
      "author": "a user"
    },
    "1166": {
      "id": 2594789,
      "text": "Anh chị em tôi và tôi uống sữa với bữa tối.",
      "author": "ChatGPT4.1"
    },
    "1167": {
      "id": 2594790,
      "text": "Ba mẹ tôi đôi khi uống rượu vang với bữa tối.",
      "author": "ChatGPT4.1"
    },
    "1168": {
      "id": 2594791,
      "text": "Đôi khi chúng tôi ăn salad trước bữa tối.",
      "author": "ChatGPT4.1"
    },
    "1169": {
      "id": 2594792,
      "text": "Tôi bày bàn ăn cho mẹ tôi.",
      "author": "ChatGPT4.1"
    },
    "1171": {
      "id": 2594793,
      "text": "Tôi cũng xếp ly và rót đầy sữa hoặc nước vào ly.",
      "author": "a user"
    },
    "1174": {
      "id": 2594794,
      "text": "Tối nay tôi đã ăn một quả đào cho món tráng miệng.",
      "author": "a user"
    },
    "1175": {
      "id": 2594795,
      "text": "Trái cây tôi yêu thích là táo, đào, mận và chuối.",
      "author": "ChatGPT4.1"
    },
    "1177": {
      "id": 2596870,
      "text": "Sau bữa tối, tôi phụ mẹ rửa chén.",
      "author": "ChatGPT4.1"
    },
    "1178": {
      "id": 2596871,
      "text": "Thông thường mẹ tôi rửa chén, còn tôi sẽ lau khô chúng.",
      "author": "a user"
    }
  }
}
