  "translations": {
    "1268": {
      "id": 4903,
      "text": "Có một sân chơi cho chúng.",
      "author": "a user"
    },
    "1271": {
      "id": 4912,
      "text": "Các học sinh ngồi vào bàn học của mình để làm việc của họ.",
      "author": "a user"
    },
    "1272": {
      "id": 4914,
      "text": "Có bãi đậu xe dành cho giáo viên.",
      "author": "a user"
    },
    "1280": {
      "id": 4945,
      "text": "Còn có một sân bóng đá bên ngoài.",
      "author": "a user"
    },
    "1281": {
      "id": 4947,
      "text": "Các học sinh đến các lớp học trong các phòng học khác nhau.",
      "author": "a user"
    },
    "1285": {
      "id": 4964,
      "text": "các buổi khiêu vũ cũng được tổ chức ở trong phòng thể dục.",
      "author": "a user"
    },
    "1287": {
      "id": 4976,
      "text": "Sinh viên tại trường đại học lớn tuổi hơn.",
      "author": "a user"
    },
    "1295": {
      "id": 5006,
      "text": "Họ gọi khu đất mà trường đại học tọa lạc là khuôn viên trường",
      "author": "a user"
    },
    "1296": {
      "id": 5010,
      "text": "Một vài sinh viên sống ở trong ký túc xá trong khuôn viên trường.",
      "author": "a user"
    },
    "1265": {
      "id": 2582556,
      "text": "Có nhiều loại trường học khác nhau.",
      "author": "ChatGPT4.1"
    },
    "1266": {
      "id": 2582557,
      "text": "Có một trường tiểu học.",
      "author": "ChatGPT4.1"
    },
    "1267": {
      "id": 2582558,
      "text": "Những đứa trẻ ở trường tiểu học còn nhỏ.",
      "author": "ChatGPT4.1"
    },
    "1269": {
      "id": 2582559,
      "text": "Các lớp học sáng sủa và thoáng đãng.",
      "author": "ChatGPT4.1"
    },
    "1270": {
      "id": 2582560,
      "text": "Có các bảng đen trong lớp học.",
      "author": "ChatGPT4.1"
    },
    "1273": {
      "id": 2582561,
      "text": "Có căng tin để học sinh lấy đồ ăn.",
      "author": "a user"
    },
    "1274": {
      "id": 2582562,
      "text": "Hiệu trưởng có một văn phòng.",
      "author": "ChatGPT4.1"
    },
    "1275": {
      "id": 2582563,
      "text": "Không một ai muốn vào văn phòng hiệu trưởng.",
      "author": "a user"
    },
    "1276": {
      "id": 2582564,
      "text": "Thường thì điều đó có nghĩa là bạn đang gặp rắc rối nếu bạn phải vào văn phòng hiệu trưởng.",
      "author": "ChatGPT4.1"
    },
    "1277": {
      "id": 2582565,
      "text": "Khi bạn hoàn thành trường tiểu học, bạn sẽ vào trường trung học.",
      "author": "ChatGPT4.1"
    },
    "1278": {
      "id": 2582566,
      "text": "Hầu hết học sinh ở trường trung học là thanh thiếu niên.",
      "author": "ChatGPT4.1"
    },
    "1279": {
      "id": 2582567,
      "text": "Có một bãi đậu xe bên ngoài trường trung học.",
      "author": "ChatGPT4.1"
    },
    "1282": {
      "id": 2582568,
      "text": "Các em chuyển từ lớp này sang lớp khác cho từng môn học.",
      "author": "ChatGPT4.1"
    },
    "1283": {
      "id": 2582569,
      "text": "Có một nhà ăn nơi các em có thể lấy bữa trưa hoặc ăn bữa trưa mang từ nhà đến.",
      "author": "ChatGPT4.1"
    },
    "1284": {
      "id": 2582570,
      "text": "Có một phòng thể dục nơi học sinh học giáo dục thể chất.",
      "author": "ChatGPT4.1"
    },
    "1286": {
      "id": 2582571,
      "text": "Một số học sinh từ trường trung học lên đại học.",
      "author": "ChatGPT4.1"
    },
    "1288": {
      "id": 2582572,
      "text": "Một số sinh viên thậm chí là người cao tuổi.",
      "author": "ChatGPT4.1"
    },
    "1289": {
      "id": 2582573,
      "text": "Mọi người đến từ khắp nơi trên thế giới để theo học đại học.",
      "author": "ChatGPT4.1"
    },
    "1290": {
      "id": 2582574,
      "text": "Có rất nhiều điều khác nhau ở trường đại học.",
      "author": "ChatGPT4.1"
    },
    "1291": {
      "id": 2582575,
      "text": "Có một nhà hát nơi các vở kịch và buổi hòa nhạc được tổ chức.",
      "author": "ChatGPT4.1"
    },
    "1292": {
      "id": 2582576,
      "text": "Có một hiệu sách nơi sinh viên có thể mua sách giáo khoa.",
      "author": "ChatGPT4.1"
    },
    "1293": {
      "id": 2582577,
      "text": "Có một tòa nhà giáo dục thể chất có hồ bơi bên trong.",
      "author": "ChatGPT4.1"
    },
    "1294": {
      "id": 2582578,
      "text": "Bãi đậu xe ở trường đại học rất lớn.",
      "author": "ChatGPT4.1"
    }
  }
