  "translations": {
    "6654": {
      "id": 22618,
      "text": "Khi người lớn mở cửa, lũ trẻ hét lên \"cho kẹo hay bị ghẹo\".",
      "author": "a user"
    },
    "6658": {
      "id": 22636,
      "text": "Trong vài ngày tới, bọn trẻ có thể đánh chén ngon lành những viên kẹo ngọt mà chúng được nhận.",
      "author": "a user"
    },
    "6662": {
      "id": 23022,
      "text": "và loại bỏ ruột và hạt của nó.",
      "author": "a user"
    },
    "6663": {
      "id": 23043,
      "text": "Sau đó, họ khoét các lỗ ở bên hông của quả bí ngô,",
      "author": "a user"
    },
    "6668": {
      "id": 23126,
      "text": "để quả bí ngô dường như phát sáng trong bóng tối.",
      "author": "a user"
    },
    "6669": {
      "id": 23127,
      "text": "Khuôn mặt kỳ lạ này được gọi là \"Đèn lồng bí ngô\".",
      "author": "a user"
    },
    "6670": {
      "id": 23132,
      "text": "Vào buổi tối Halloween, người ta có thể nhìn thấy nhiều Đèn lồng bí ngô này",
      "author": "a user"
    },
    "6640": {
      "id": 2595350,
      "text": "Ngày lễ gọi là Halloween được tổ chức vào ngày 31 tháng 10 hàng năm.",
      "author": "ChatGPT4.1"
    },
    "6641": {
      "id": 2595351,
      "text": "Halloween không phải là một ngày lễ chính thức.",
      "author": "ChatGPT4.1"
    },
    "6642": {
      "id": 2595352,
      "text": "Mọi người đều đi làm hoặc đi học vào ngày Halloween, giống như những ngày khác.",
      "author": "ChatGPT4.1"
    },
    "6643": {
      "id": 2595353,
      "text": "Nhưng Halloween vẫn là một trong những ngày lễ được trẻ em thích nhất.",
      "author": "a user"
    },
    "6644": {
      "id": 2595354,
      "text": "Tại sao trẻ em lại thích Halloween đến vậy?",
      "author": "ChatGPT4.1"
    },
    "6645": {
      "id": 2595355,
      "text": "Có hai lý do: trang phục hóa trang và kẹo.",
      "author": "a user"
    },
    "6646": {
      "id": 2595356,
      "text": "Vào buổi tối ngày 31 tháng 10,",
      "author": "ChatGPT4.1"
    },
    "6647": {
      "id": 2595357,
      "text": "trẻ em mặc những bộ trang phục kì lạ và khác thường.",
      "author": "a user"
    },
    "6648": {
      "id": 2595358,
      "text": "Chúng mặc các bộ trang phục có thể trông giống như một phù thủy,",
      "author": "ChatGPT4.1"
    },
    "6649": {
      "id": 2595359,
      "text": "một con quái vật, hoặc nhiều thứ kỳ lạ khác.",
      "author": "ChatGPT4.1"
    },
    "6650": {
      "id": 2595360,
      "text": "Việc mặc các trang phục đáng sợ này cực kỳ vui đối với trẻ em.",
      "author": "ChatGPT4.1"
    },
    "6651": {
      "id": 2595361,
      "text": "Sau khi mặc trang phục, bọn trẻ đi từ nhà này sang nhà khác vào buổi tối.",
      "author": "ChatGPT4.1"
    },
    "6652": {
      "id": 2595362,
      "text": "Chúng mang theo những chiếc túi lớn bên mình.",
      "author": "ChatGPT4.1"
    },
    "6653": {
      "id": 2595363,
      "text": "Đến mỗi nhà, chúng dừng lại và gõ cửa.",
      "author": "ChatGPT4.1"
    },
    "6655": {
      "id": 2595364,
      "text": "Người lớn mở cửa giả vờ sợ hãi,",
      "author": "ChatGPT4.1"
    },
    "6656": {
      "id": 2595365,
      "text": "rồi bỏ những viên kẹo vào túi đang mở của từng đứa trẻ.",
      "author": "a user"
    },
    "6657": {
      "id": 2595366,
      "text": "Cuối buổi tối, bọn trẻ đã ghé thăm nhiều nhà và thu thập được rất nhiều kẹo.",
      "author": "ChatGPT4.1"
    },
    "6659": {
      "id": 2595367,
      "text": "Một truyền thống khác của Halloween cũng rất đặc biệt.",
      "author": "ChatGPT4.1"
    },
    "6660": {
      "id": 2595368,
      "text": "Ở mỗi nhà, gia đình chọn một loại rau quả màu da cam to, tròn được gọi là bí ngô.",
      "author": "ChatGPT4.1"
    },
    "6661": {
      "id": 2595369,
      "text": "Họ cắt một lỗ ở trên đầu quả bí ngô,",
      "author": "ChatGPT4.1"
    },
    "6664": {
      "id": 2595370,
      "text": "để nó trông giống như có mắt, mũi và miệng.",
      "author": "ChatGPT4.1"
    },
    "6665": {
      "id": 2595371,
      "text": "Khi chạm khắc xong, quả bí ngô trông gần giống khuôn mặt người!",
      "author": "ChatGPT4.1"
    },
    "6666": {
      "id": 2595372,
      "text": "Khi quả bí ngô đã được chạm khắc giống khuôn mặt,",
      "author": "ChatGPT4.1"
    },
    "6667": {
      "id": 2595373,
      "text": "người ta đặt một chiếc đèn bên trong quả bí,",
      "author": "ChatGPT4.1"
    },
    "6671": {
      "id": 2597549,
      "text": "một số trong đó được khắc rất đẹp mắt.",
      "author": "ChatGPT4.1"
    },
    "6672": {
      "id": 2597550,
      "text": "Halloween thật sự là một ngày lễ vui vẻ và thú vị, đặc biệt là đối với trẻ em!",
      "author": "ChatGPT4.1"
    }
  }
