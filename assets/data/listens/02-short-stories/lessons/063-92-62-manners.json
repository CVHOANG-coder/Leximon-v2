  "translations": {
    "3881": {
      "id": 35542,
      "text": "Lịch sự là tốt.",
      "author": "a user"
    },
    "3882": {
      "id": 35544,
      "text": "Mọi người sẽ quý mến bạn hơn khi bạn lịch sự.",
      "author": "a user"
    },
    "3883": {
      "id": 35546,
      "text": "Hãy luôn nói vui lòng và cảm ơn",
      "author": "a user"
    },
    "3885": {
      "id": 35548,
      "text": "\"Vui lòng, cho tôi xin một ly sữa được không?\"",
      "author": "a user"
    },
    "3886": {
      "id": 35550,
      "text": "Khi ai đó đưa bạn sữa, bạn nên đáp lại bằng \"Cảm ơn\".",
      "author": "a user"
    },
    "3887": {
      "id": 35555,
      "text": "Không khó để lịch sự.",
      "author": "a user"
    },
    "3888": {
      "id": 35557,
      "text": "Bạn không nên xô đẩy hoặc chèn ép mọi người.",
      "author": "a user"
    },
    "3893": {
      "id": 35570,
      "text": "Có cách hành xử trên bàn ăn",
      "author": "a user"
    },
    "3895": {
      "id": 35574,
      "text": "Bạn không nên nhét thức ăn vào miệng.",
      "author": "a user"
    },
    "3896": {
      "id": 35577,
      "text": "Bạn không nên với tay qua đĩa của người khác.",
      "author": "a user"
    },
    "3897": {
      "id": 35579,
      "text": "Bạn không nên nói chuyện với miệng đầy thức ăn.",
      "author": "a user"
    },
    "3901": {
      "id": 35604,
      "text": "Chỉ tay vào mọi người được cho là không lịch sự. Ợ hơi thành tiếng cũng vậy.",
      "author": "a user"
    },
    "3903": {
      "id": 47255,
      "text": "Việc lịch sự sẽ trở nên tự nhiên nếu bạn được nuôi dưỡng trong một gia đình mà mọi người đều lịch sự.",
      "author": "a user"
    },
    "3884": {
      "id": 2589690,
      "text": "Nếu bạn xin một ít sữa, bạn nên nói,",
      "author": "ChatGPT4.1"
    },
    "3889": {
      "id": 2589691,
      "text": "Bạn nên che miệng khi ho hoặc hắt hơi.",
      "author": "ChatGPT4.1"
    },
    "3890": {
      "id": 2589692,
      "text": "Bạn nên xưng hô đúng cách với người khác.",
      "author": "ChatGPT4.1"
    },
    "3891": {
      "id": 2589693,
      "text": "Nếu bạn muốn gây chú ý với ai đó, bạn có thể nói \"xin lỗi\".",
      "author": "ChatGPT4.1"
    },
    "3892": {
      "id": 2589694,
      "text": "Bạn không nên nói \"này bạn\".",
      "author": "ChatGPT4.1"
    },
    "3894": {
      "id": 2589695,
      "text": "Đó là nơi bạn ăn uống đúng cách và lịch sự trên bàn ăn.",
      "author": "ChatGPT4.1"
    },
    "3898": {
      "id": 2589696,
      "text": "Tất cả những điều này đều là lẽ thường tình.",
      "author": "ChatGPT4.1"
    },
    "3899": {
      "id": 2589697,
      "text": "Lịch sự chủ yếu là nghĩ xem bạn muốn được đối xử như thế nào.",
      "author": "ChatGPT4.1"
    },
    "3900": {
      "id": 2589698,
      "text": "Bạn sẽ không muốn người khác bất lịch sự với bạn.",
      "author": "ChatGPT4.1"
    },
    "3902": {
      "id": 2589699,
      "text": "Sử dụng đồ của người khác mà không xin phép trước là bất lịch sự.",
      "author": "a user"
    }
  }
