  "translations": {
    "5061": {
      "id": 56609,
      "text": "Bàn trang điểm của tôi có một chiếc gương trên đó.",
      "author": "a user"
    },
    "5062": {
      "id": 56613,
      "text": "Tôi có một cái đèn trên bàn trang điểm của mình.",
      "author": "a user"
    },
    "5063": {
      "id": 56621,
      "text": "Tôi cũng có một số khung ảnh với hình ảnh của bạn bè và gia đình của tôi trên bàn trang điểm của tôi.",
      "author": "a user"
    },
    "5073": {
      "id": 56643,
      "text": "Tôi để đồ chơi trên đó",
      "author": "a user"
    },
    "5056": {
      "id": 2585312,
      "text": "Giường của tôi rất đẹp và mềm mại.",
      "author": "ChatGPT4.1"
    },
    "5057": {
      "id": 2585313,
      "text": "Tôi có một tấm trải giường đẹp trên giường của mình.",
      "author": "ChatGPT4.1"
    },
    "5058": {
      "id": 2585314,
      "text": "Tôi cũng có ga trải giường và chăn trên giường.",
      "author": "ChatGPT4.1"
    },
    "5059": {
      "id": 2585315,
      "text": "Tôi sử dụng hai chiếc gối lông vũ.",
      "author": "ChatGPT4.1"
    },
    "5060": {
      "id": 2585316,
      "text": "Gối của tôi có vỏ gối bọc bên ngoài.",
      "author": "ChatGPT4.1"
    },
    "5064": {
      "id": 2585317,
      "text": "Có một cái đồng hồ báo thức bên cạnh giường để tôi có thể thức dậy đúng giờ vào buổi sáng.",
      "author": "ChatGPT4.1"
    },
    "5065": {
      "id": 2585318,
      "text": "Tôi để nhiều quần áo trong ngăn kéo tủ quần áo.",
      "author": "ChatGPT4.1"
    },
    "5066": {
      "id": 2585319,
      "text": "Các ngăn kéo rất rộng và sâu.",
      "author": "ChatGPT4.1"
    },
    "5067": {
      "id": 2585320,
      "text": "Tủ quần áo của tôi lớn.",
      "author": "ChatGPT4.1"
    },
    "5068": {
      "id": 2585321,
      "text": "Đó là tủ quần áo có thể bước vào bên trong.",
      "author": "ChatGPT4.1"
    },
    "5069": {
      "id": 2585322,
      "text": "Tôi treo quần áo của mình trong tủ quần áo.",
      "author": "ChatGPT4.1"
    },
    "5070": {
      "id": 2585323,
      "text": "Tất cả quần áo đều được treo trên móc.",
      "author": "ChatGPT4.1"
    },
    "5071": {
      "id": 2585324,
      "text": "Tất cả giày dép của tôi đều được xếp ngay ngắn trên sàn tủ quần áo.",
      "author": "ChatGPT4.1"
    },
    "5072": {
      "id": 2585325,
      "text": "Có các kệ ở trên cùng của tủ quần áo.",
      "author": "ChatGPT4.1"
    },
    "5074": {
      "id": 2585326,
      "text": "Có một tấm thảm trên sàn phòng ngủ của tôi.",
      "author": "ChatGPT4.1"
    },
    "5075": {
      "id": 2585327,
      "text": "Cửa sổ phòng ngủ của tôi nhìn ra sân sau.",
      "author": "ChatGPT4.1"
    },
    "5076": {
      "id": 2585328,
      "text": "Có rèm cửa trên cửa sổ phòng ngủ của tôi.",
      "author": "ChatGPT4.1"
    },
    "5077": {
      "id": 2585329,
      "text": "Phòng ngủ của tôi rất ấm cúng.",
      "author": "ChatGPT4.1"
    },
    "5078": {
      "id": 2585330,
      "text": "Vào ban đêm, tôi tắt đèn và chui vào chăn.",
      "author": "ChatGPT4.1"
    },
    "5079": {
      "id": 2585331,
      "text": "Tôi đặt đồng hồ báo thức lúc bảy giờ.",
      "author": "ChatGPT4.1"
    },
    "5080": {
      "id": 2585332,
      "text": "Tôi đặt đầu lên gối và chìm vào giấc ngủ.",
      "author": "ChatGPT4.1"
    }
  }
