  "translations": {
    "5433": {
      "id": 22120,
      "text": "Việc hai người ở bên nhau suốt đời là điều không dễ dàng",
      "author": "a user"
    },
    "5434": {
      "id": 22156,
      "text": "Đôi khi, mọi người thay đổi khi họ già đi, và họ bước tiếp.",
      "author": "a user"
    },
    "5439": {
      "id": 22329,
      "text": "Đó là tùy thuộc vào các bậc cha mẹ.",
      "author": "a user"
    },
    "5445": {
      "id": 22344,
      "text": "Bạn chỉ cần hiểu và biết rằng bố mẹ vẫn yêu thương bạn.",
      "author": "a user"
    },
    "5446": {
      "id": 22350,
      "text": "Cuộc sống không phải lúc nào cũng diễn ra theo đúng như chúng ta dự tính, nhưng nó vẫn có những khúc quanh và ngã rẽ.",
      "author": "a user"
    },
    "5423": {
      "id": 2610851,
      "text": "Cha mẹ của Mary vừa mới ly hôn.",
      "author": "ChatGPT4.1"
    },
    "5424": {
      "id": 2610852,
      "text": "Mary rất buồn.",
      "author": "ChatGPT4.1"
    },
    "5425": {
      "id": 2610853,
      "text": "Cô ấy nghĩ rằng cha mẹ không còn yêu mình nữa.",
      "author": "ChatGPT4.1"
    },
    "5426": {
      "id": 2610854,
      "text": "Cô ấy nghĩ rằng họ ly hôn là vì cô ấy.",
      "author": "ChatGPT4.1"
    },
    "5427": {
      "id": 2610855,
      "text": "Cô ấy đã sai.",
      "author": "ChatGPT4.1"
    },
    "5428": {
      "id": 2610856,
      "text": "Cha mẹ cô ấy yêu cô ấy nhiều như trước đến giờ.",
      "author": "ChatGPT4.1"
    },
    "5429": {
      "id": 2610857,
      "text": "Họ không ly hôn vì Mary.",
      "author": "ChatGPT4.1"
    },
    "5430": {
      "id": 2610858,
      "text": "Đôi khi, hôn nhân chỉ đơn giản là không thành công.",
      "author": "ChatGPT4.1"
    },
    "5431": {
      "id": 2610859,
      "text": "Thật ra không phải lỗi của ai cả.",
      "author": "ChatGPT4.1"
    },
    "5432": {
      "id": 2610860,
      "text": "Hôn nhân không dễ dàng.",
      "author": "ChatGPT4.1"
    },
    "5435": {
      "id": 2610861,
      "text": "Một số người có cuộc hôn nhân rất tốt đẹp, và họ ở bên nhau suốt đời.",
      "author": "ChatGPT4.1"
    },
    "5436": {
      "id": 2610862,
      "text": "Ly hôn không phải vì cha mẹ không còn yêu các con nữa.",
      "author": "ChatGPT4.1"
    },
    "5437": {
      "id": 2610863,
      "text": "Nhiều trẻ em cảm thấy đó là lỗi của mình, nhưng thật ra không phải như vậy.",
      "author": "ChatGPT4.1"
    },
    "5438": {
      "id": 2610864,
      "text": "Trẻ em không phải là nguyên nhân gây ra ly hôn, cũng không thể ngăn nó xảy ra.",
      "author": "ChatGPT4.1"
    },
    "5440": {
      "id": 2610865,
      "text": "Ly hôn không phải là tận cùng của thế giới.",
      "author": "ChatGPT4.1"
    },
    "5441": {
      "id": 2610866,
      "text": "Trẻ em vẫn có thể gặp cả hai cha mẹ và ở bên họ.",
      "author": "ChatGPT4.1"
    },
    "5442": {
      "id": 2610867,
      "text": "Cuộc sống vẫn tiếp tục.",
      "author": "ChatGPT4.1"
    },
    "5443": {
      "id": 2610868,
      "text": "Đôi khi trẻ em có thể có mẹ kế hoặc cha dượng mới.",
      "author": "ChatGPT4.1"
    },
    "5444": {
      "id": 2610869,
      "text": "Điều đó đôi khi cũng là điều tốt.",
      "author": "ChatGPT4.1"
    },
    "5447": {
      "id": 2610870,
      "text": "Cuộc sống là một cuộc phiêu lưu.",
      "author": "ChatGPT4.1"
    },
    "5448": {
      "id": 2610871,
      "text": "Nếu cha mẹ bạn ly hôn, hãy cảm thông.",
      "author": "ChatGPT4.1"
    },
    "5449": {
      "id": 2610872,
      "text": "Hãy biết rằng họ vẫn yêu bạn và đây là khoảng thời gian khó khăn đối với họ.",
      "author": "ChatGPT4.1"
    },
    "5450": {
      "id": 2610873,
      "text": "Đây cũng là khoảng thời gian khó khăn với bạn,",
      "author": "ChatGPT4.1"
    },
    "5451": {
      "id": 2610874,
      "text": "nhưng cuối cùng thì những điều này rồi sẽ tự sắp xếp ổn thỏa thôi.",
      "author": "a user"
    }
  }
}
