  "translations": {
    "925": {
      "id": 1038,
      "text": "Hôm nay chúng ta tôn vinh những người lính.",
      "author": "a user"
    },
    "926": {
      "id": 1039,
      "text": "Mọi người đều đeo hoa anh túc.",
      "author": "a user"
    },
    "928": {
      "id": 1041,
      "text": "Hoa anh túc làm tôi nhớ đến ông bà tôi.",
      "author": "a user"
    },
    "929": {
      "id": 1042,
      "text": "Những đóa hoa anh túc nhắc nhở tôi về sự hy sinh của họ.",
      "author": "a user"
    },
    "924": {
      "id": 1056,
      "text": "Hôm nay là Ngày tưởng niệm.",
      "author": "a user"
    },
    "921": {
      "id": 2592875,
      "text": "Ông tôi đã chiến đấu trong Chiến tranh Thế giới thứ hai.",
      "author": "ChatGPT4.1"
    },
    "922": {
      "id": 2592876,
      "text": "Bà tôi là y tá trong Chiến tranh Thế giới thứ hai.",
      "author": "ChatGPT4.1"
    },
    "923": {
      "id": 2592877,
      "text": "Hôm nay là ngày 11 tháng 11.",
      "author": "ChatGPT4.1"
    },
    "927": {
      "id": 2592878,
      "text": "Hoa anh túc là những bông hoa màu đỏ.",
      "author": "ChatGPT4.1"
    },
    "930": {
      "id": 2592879,
      "text": "Vào lúc 11 giờ sáng, có hai phút mặc niệm.",
      "author": "ChatGPT4.1"
    },
    "931": {
      "id": 2592880,
      "text": "Mọi người nhớ về bạn bè và gia đình của mình.",
      "author": "ChatGPT4.1"
    },
    "932": {
      "id": 2592881,
      "text": "Mọi người đọc bài thơ \"Trên cánh đồng Flanders\".",
      "author": "ChatGPT4.1"
    },
    "933": {
      "id": 2592882,
      "text": "Đó là một bài thơ buồn.",
      "author": "ChatGPT4.1"
    },
    "934": {
      "id": 2592883,
      "text": "Nó giúp chúng ta ghi nhớ.",
      "author": "ChatGPT4.1"
    },
    "935": {
      "id": 2592884,
      "text": "Hôm nay, chúng ta ước mong hòa bình trên thế giới.",
      "author": "a user"
    }
