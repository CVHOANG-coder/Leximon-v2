  "translations": {
    "9116": {
      "id": 38496,
      "text": "bằng cách xuất sắc trong các môn thể thao như phóng lao và đẩy tạ,",
      "author": "a user"
    },
    "9118": {
      "id": 38498,
      "text": "Điều thú vị là Didrikson sẽ luôn phải tranh đấu với các bài tường thuật nổi tiếng đã tấn công hoặc đặt câu hỏi về nữ tính và bản năng tình dục của cô ấy.",
      "author": "a user"
    },
    "9124": {
      "id": 40675,
      "text": "nơi cô đã giành chiến thắng và lập kỷ lục ở môn phóng lao và 80 mét vượt rào.",
      "author": "a user"
    },
    "9129": {
      "id": 40680,
      "text": "cô ấy mặc váy và trang điểm thay vì những chiếc quần nỉ và vẻ ngoài không trang điểm.",
      "author": "a user"
    },
    "9131": {
      "id": 40682,
      "text": "vốn đã tước bỏ tư cách thể thao nghiệp dư của cô sau khi cô cho phép hình ảnh của mình được sử dụng để quảng bá  xe hơi.",
      "author": "a user"
    },
    "9137": {
      "id": 40688,
      "text": "vào thời điểm mà môi trường chính trị gây khó khăn cho việc thực hiện điều đó.",
      "author": "a user"
    },
    "9140": {
      "id": 40691,
      "text": "Didrikson buộc phải xem xét lại ý nghĩa của thể thao,",
      "author": "a user"
    },
    "9111": {
      "id": 2592090,
      "text": "Mildred \"Babe\" Didrikson (1913-1956)",
      "author": "ChatGPT4.1"
    },
    "9112": {
      "id": 2592091,
      "text": "là một trong những vận động viên nữ nổi tiếng nhất nửa đầu thế kỷ 20.",
      "author": "ChatGPT4.1"
    },
    "9113": {
      "id": 2592092,
      "text": "Thi đấu vào những năm 1930 và 1940, khi quan niệm truyền thống về sự tham gia của phụ nữ trong thể thao chi phối văn hóa Bắc Mỹ,",
      "author": "ChatGPT4.1"
    },
    "9114": {
      "id": 2592093,
      "text": "Babe Didrikson đã nổi tiếng bằng cách vượt trội không chỉ một mà nhiều môn thể thao.",
      "author": "ChatGPT4.1"
    },
    "9115": {
      "id": 2592094,
      "text": "Didrikson đã thách thức các quan niệm truyền thống về nữ tính và hoạt động \"phù hợp\" cho phụ nữ",
      "author": "ChatGPT4.1"
    },
    "9117": {
      "id": 2592095,
      "text": "ngoài ra còn có các môn thể thao thường do nam giới thống trị như bóng chày, bơi lội và golf.",
      "author": "ChatGPT4.1"
    },
    "9119": {
      "id": 2592096,
      "text": "Là một phụ nữ có thân hình to lớn, cơ bắp và thể thao,",
      "author": "ChatGPT4.1"
    },
    "9120": {
      "id": 2592097,
      "text": "Didrikson thường bị buộc tội có \"lợi thế không công bằng\" so với những phụ nữ khác,",
      "author": "ChatGPT4.1"
    },
    "9121": {
