  "translations": {
    "3721": {
      "id": 9917,
      "text": "\"Vui lòng đợi để được sắp xếp chỗ ngồi\".",
      "author": "a user"
    },
    "3722": {
      "id": 9923,
      "text": "Nữ hoặc nam nhân viên tiếp khách sẽ hỏi bạn có bao nhiêu người trong nhóm của bạn.",
      "author": "a user"
    },
    "3723": {
      "id": 9925,
      "text": "Sau đó, họ sẽ muốn biết bạn muốn ngồi ở khu vực hút thuốc hay cấm hút thuốc.",
      "author": "a user"
    },
    "3724": {
      "id": 9932,
      "text": "Tiếp viên nam hoặc nữ sẽ đưa bạn đến chỗ ngồi.",
      "author": "a user"
    },
    "3725": {
      "id": 9936,
      "text": "Bạn có thể ngồi ở bàn hoặc ở khu vực riêng.",
      "author": "a user"
    },
    "3726": {
      "id": 9939,
      "text": "Nữ hoặc nam nhân viên tiếp khách sẽ đưa cho bạn một thực đơn để bạn xem qua.",
      "author": "a user"
    },
    "3731": {
      "id": 9955,
      "text": "Trên bàn của bạn, sẽ có dụng cụ ăn uống.",
      "author": "a user"
    },
    "3732": {
      "id": 9958,
      "text": "Đồ dùng ăn uống gồm dao, nĩa và thìa.",
      "author": "a user"
    },
    "3734": {
      "id": 19925,
      "text": "Bạn nên đặt khăn ăn trên đùi khi ăn.",
      "author": "a user"
    },
    "3735": {
      "id": 19933,
      "text": "Nam hoặc nữ nhân viên phục vụ của bạn sẽ nhận yêu cầu đặt món của bạn.",
      "author": "a user"
    },
    "3739": {
      "id": 19953,
      "text": "Đến khi rời đi, bạn sẽ thanh toán hóa đơn của mình và để lại tiền boa cho người phục vụ nam hoặc phục vụ nữ.",
      "author": "a user"
    },
    "3720": {
      "id": 2585204,
      "text": "\"Khi bạn đến một nhà hàng, bạn có thể thấy một biển hiệu ghi rằng,\"",
      "author": "ChatGPT4.1"
    },
    "3727": {
      "id": 2585205,
      "text": "Đôi khi, có nhiều thực đơn khác nhau cho các bữa ăn khác nhau.",
      "author": "ChatGPT4.1"
    },
    "3728": {
      "id": 2585206,
      "text": "Có thể có thực đơn bữa sáng, thực đơn bữa trưa và thực đơn bữa tối.",
      "author": "ChatGPT4.1"
    },
    "3729": {
      "id": 2585207,
      "text": "Đôi khi, còn có thêm danh sách rượu vang và thực đơn tráng miệng.",
      "author": "ChatGPT4.1"
    },
    "3730": {
      "id": 2585208,
      "text": "Các món ăn và giá cả đều được liệt kê trên thực đơn.",
      "author": "ChatGPT4.1"
    },
    "3733": {
      "id": 2585209,
      "text": "Cũng sẽ có một chiếc khăn ăn.",
      "author": "ChatGPT4.1"
    },
    "3736": {
      "id": 2585210,
      "text": "Bạn có thể muốn gọi món khai vị trước bữa ăn.",
      "author": "ChatGPT4.1"
    },
    "3737": {
      "id": 2585211,
      "text": "Một số người muốn gọi salad hoặc súp trước bữa ăn.",
