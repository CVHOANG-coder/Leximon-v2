  "translations": {
    "4443": {
      "id": 59370,
      "text": "Tôi đã tâng bóng trong bếp,",
      "author": "a user"
    },
    "4445": {
      "id": 59372,
      "text": "Đó là một trong những chiếc cốc yêu thích nhất của mẹ tôi,",
      "author": "a user"
    },
    "4446": {
      "id": 59373,
      "text": "vì vậy tôi sợ rằng cô ấy sẽ tức giận.",
      "author": "a user"
    },
    "4449": {
      "id": 59376,
      "text": "Anh trai tôi nói, \"không phải con\".",
      "author": "a user"
    },
    "4450": {
      "id": 59377,
      "text": "Em gái tôi nói, \"con không làm điều đó\".",
      "author": "a user"
    },
    "4451": {
      "id": 59378,
      "text": "Tôi nói, \"Con không làm vỡ cái cốc\",",
      "author": "a user"
    },
    "4453": {
      "id": 59380,
      "text": "Mẹ tôi nói rằng tất cả chúng tôi sẽ bị phạt nếu không ai chịu nói sự thật và nhận là người đã làm vỡ chiếc cốc.",
      "author": "a user"
    },
    "4455": {
      "id": 59382,
      "text": "Cô ấy đã cho chúng tôi thêm một cơ hội, và cô ấy nói rằng cô ấy không tức giận vì chiếc cốc,",
      "author": "a user"
    },
    "4458": {
      "id": 59385,
      "text": "Anh trai, em gái tôi và tôi đều bị đưa về phòng.",
      "author": "a user"
    },
    "4461": {
      "id": 59388,
      "text": "Tôi cảm thấy rất tồi tệ vì anh trai và em gái của tôi đã bị phạt vì tôi.",
      "author": "a user"
    },
    "4465": {
      "id": 59392,
      "text": "Cô ấy thất vọng về tôi vì tôi đã không đứng lên và nói ra sự thật.",
      "author": "a user"
    },
    "4467": {
      "id": 59396,
      "text": "Tôi đã nói với anh chị tôi rằng tôi xin lỗi",
      "author": "a user"
    },
    "4468": {
      "id": 59400,
      "text": "Tôi cảm thấy tồi tệ vì họ đã bị phạt vì tôi không trung thực.",
      "author": "a user"
    },
    "4475": {
      "id": 59422,
      "text": "Đôi khi thật khó để thành thật, nhưng đó lại là cách tốt nhất.",
      "author": "a user"
    },
    "4441": {
      "id": 2582637,
      "text": "Hôm qua tôi đã nói dối.",
      "author": "ChatGPT4.1"
    },
    "4442": {
      "id": 2582638,
      "text": "Tôi cảm thấy không tốt về điều đó.",
      "author": "ChatGPT4.1"
    },
    "4444": {
      "id": 2582639,
      "text": "và quả bóng bật lên và làm vỡ một cái cốc.",
      "author": "ChatGPT4.1"
    },
    "4447": {
      "id": 2582640,
      "text": "Tôi đặt chiếc cốc bị vỡ trở lại lên bàn rồi không nói với ai rằng mình đã làm vỡ nó.",
      "author": "a user"
    },
    "4448": {
      "id": 2582641,
      "text": "Tối hôm đó, mẹ tôi hỏi ai đã làm vỡ cái cốc.",
      "author": "ChatGPT4.1"
    },
    "4452": {
      "id": 2582642,
      "text": "nhưng tôi đã nói dối.",
      "author": "ChatGPT4.1"
    },
    "4454": {
      "id": 2582643,
      "text": "Tôi vẫn không nói với mẹ rằng tôi đã làm vỡ nó.",
      "author": "ChatGPT4.1"
    },
    "4456": {
      "id": 2582644,
      "text": "mẹ chỉ muốn chúng tôi trung thực.",
      "author": "ChatGPT4.1"
    },
    "4457": {
      "id": 2582645,
      "text": "Tôi vẫn không nói gì.",
      "author": "ChatGPT4.1"
    },
    "4459": {
      "id": 2582646,
      "text": "Chúng tôi phải ở trong phòng suốt cả buổi sáng.",
      "author": "ChatGPT4.1"
    },
    "4460": {
      "id": 2582647,
      "text": "Anh/em trai tôi nói điều đó không công bằng.",
      "author": "a user"
    },
    "4462": {
      "id": 2582648,
      "text": "Tôi đến chỗ mẹ và nói với mẹ rằng tôi đã làm vỡ cái cốc.",
      "author": "ChatGPT4.1"
    },
    "4463": {
      "id": 2582649,
      "text": "Mẹ nói rằng mẹ không buồn về cái cốc bị vỡ.",
      "author": "ChatGPT4.1"
    },
    "4464": {
      "id": 2582650,
      "text": "Mẹ biết đó là một tai nạn.",
      "author": "ChatGPT4.1"
    },
