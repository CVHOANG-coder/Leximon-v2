  "translations": {
    "277": {
      "id": 34,
      "text": "Hôm nay là ngày đầu tiên đi mẫu giáo của Jessica.",
      "author": "a user"
    },
    "281": {
      "id": 40,
      "text": "Thầy ấy tên là Parker.",
      "author": "a user"
    },
    "282": {
      "id": 41,
      "text": "Chuông trường reo lúc 8 giờ 45 sáng.",
      "author": "a user"
    },
    "286": {
      "id": 48,
      "text": "Thầy Parker gọi to tên của những đứa trẻ.",
      "author": "a user"
    },
    "287": {
      "id": 49,
      "text": "Từng đứa trẻ hô lên: \" Dạ có\"",
      "author": "a user"
    },
    "288": {
      "id": 50,
      "text": "Thầy Parker dạy bọn trẻ về các chữ cái.",
      "author": "a user"
    },
    "289": {
      "id": 52,
      "text": "Thầy Parker dạy bọn trẻ về các con số.",
      "author": "a user"
    },
    "291": {
      "id": 55,
      "text": "Giờ ra chơi thật vui.",
      "author": "a user"
    },
    "293": {
      "id": 58,
      "text": "Vào lúc 10:30 sáng",
      "author": "a user"
    },
    "297": {
      "id": 63,
      "text": "Thầy Parker bảo các học sinh ngồi trên thảm.",
      "author": "a user"
    },
    "298": {
      "id": 64,
      "text": "Thầy Parker đọc một câu chuyện cho học sinh nghe.",
      "author": "a user"
    },
    "299": {
      "id": 66,
      "text": "Thầy Parker dạy học sinh một bài hát.",
      "author": "a user"
    },
    "278": {
      "id": 2588125,
      "text": "Jessica và bố mẹ cùng đi bộ tới trường.",
      "author": "ChatGPT4.1"
    },
    "279": {
      "id": 2588126,
      "text": "Mẹ của Jessica đi cùng cô bé đến lớp học.",
      "author": "a user"
    },
    "280": {
      "id": 2588127,
      "text": "Jessica gặp giáo viên của mình.",
      "author": "ChatGPT4.1"
    },
    "283": {
      "id": 2588128,
      "text": "Jessica ôm và hôn mẹ tạm biệt.",
      "author": "ChatGPT4.1"
    },
    "284": {
      "id": 2588129,
      "text": "Mẹ của Jessica nói: \"Mẹ yêu con!\".",
      "author": "a user"
    },
    "285": {
      "id": 2588130,
      "text": "Lúc 9 giờ sáng, Jessica đứng nghiêm trang để nghe quốc ca",
      "author": "a user"
    },
    "290": {
      "id": 2588131,
      "text": "Lúc 10:15 sáng, học sinh có giờ ra chơi.",
      "author": "a user"
    },
    "292": {
      "id": 2588132,
      "text": "Học sinh được vui chơi và ăn uống.",
      "author": "a user"
    },
    "294": {
      "id": 2588133,
      "text": "Các học sinh đi học thể dục.",
      "author": "ChatGPT4.1"
    },
    "295": {
      "id": 2588134,
      "text": "Lúc 11:15 sáng.",
      "author": "ChatGPT4.1"
    },
    "296": {
      "id": 2588135,
      "text": "Các học sinh quay lại lớp của thầy Parker.",
      "author": "ChatGPT4.1"
    },
    "300": {
      "id": 2588136,
      "text": "Chuông báo giờ ăn trưa vang lên.",
      "author": "ChatGPT4.1"
    },
    "301": {
      "id": 2588137,
      "text": "Ngày đi học đầu tiên của Jessica đã kết thúc.",
