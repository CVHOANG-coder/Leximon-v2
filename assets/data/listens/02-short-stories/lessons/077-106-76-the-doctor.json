  "translations": {
    "4299": {
      "id": 30009,
      "text": "và nói rằng bác sĩ sẽ sớm đến gặp tôi",
      "author": "a user"
    },
    "4300": {
      "id": 30019,
      "text": "Bác sĩ là một người đàn ông rất tử tế trong chiếc áo khoác trắng.",
      "author": "a user"
    },
    "4304": {
      "id": 30043,
      "text": "và anh ấy chiếu đèn vào miệng tôi.",
      "author": "a user"
    },
    "4307": {
      "id": 30058,
      "text": "Anh ấy sờ cổ tôi và nói rằng tuyến hạch của tôi bị sưng.",
      "author": "a user"
    },
    "4308": {
      "id": 30063,
      "text": "Anh ấy đã đo nhiệt độ của tôi và nói rằng nó khá cao.",
      "author": "a user"
    },
    "4309": {
      "id": 30069,
      "text": "Anh ấy đã lắng nghe nhịp tim tôi, và bảo tôi ho.",
      "author": "a user"
    },
    "4312": {
      "id": 30079,
      "text": "Anh ta bảo tôi đi lấy một ít máu ở tay",
      "author": "a user"
    },
    "4319": {
      "id": 30102,
      "text": "Không lâu sau đó tôi cảm thấy khỏe lại.",
      "author": "a user"
    },
    "4311": {
      "id": 2585100,
      "text": "Ông ấy nói rằng có thể sẽ phải làm một số xét nghiệm.",
      "author": "ChatGPT4.1"
    },
    "4313": {
      "id": 2585101,
      "text": "Tôi rất sợ, nhưng thực ra không đau lắm.",
      "author": "ChatGPT4.1"
    },
    "4314": {
      "id": 2585102,
      "text": "Bác sĩ đưa cho tôi một số viên thuốc",
      "author": "ChatGPT4.1"
    },
    "4315": {
      "id": 2585103,
      "text": "và nói tôi uống một viên vào buổi sáng và một viên vào buổi tối.",
      "author": "ChatGPT4.1"
    },
    "4316": {
      "id": 2585104,
      "text": "Ông ấy bảo tôi uống nhiều nước.",
      "author": "ChatGPT4.1"
    },
    "4317": {
      "id": 2585105,
      "text": "Ông ấy dặn tôi ngủ thật nhiều.",
      "author": "ChatGPT4.1"
    },
    "4318": {
      "id": 2585106,
      "text": "Tôi đã làm chính xác những gì bác sĩ dặn.",
      "author": "ChatGPT4.1"
    },
    "4320": {
      "id": 2585107,
      "text": "Tôi nghĩ tôi có thể muốn trở thành bác sĩ khi lớn lên.",
      "author": "ChatGPT4.1"
    },
    "4321": {
      "id": 2585108,
      "text": "Tôi muốn giúp mọi người cảm thấy khỏe hơn.",
      "author": "ChatGPT4.1"
    },
    "4296": {
      "id": 2640933,
      "text": "Tuần trước tôi cảm thấy không khỏe lắm.",
      "author": "ChatGPT4.1"
    },
    "86507": {
      "id": 2640934,
      "text": "Tôi bị đau họng và sốt.",
      "author": "ChatGPT4.1"
    },
    "4297": {
      "id": 3335324,
      "text": "Mẹ tôi đã đưa tôi đi khám bác sĩ.",
      "author": "ChatGPT4.1"
    },
    "4298": {
      "id": 3335325,
      "text": "Khi chúng tôi đến đó, y tá đã ghi tên tôi",
      "author": "ChatGPT4.1"
    },
    "4301": {
      "id": 3335326,
      "text": "Tôi đã gặp bác sĩ trước đây khi tôi cắt amidan ở bệnh viện.",
      "author": "ChatGPT4.1"
    },
    "4302": {
      "id": 3335327,
      "text": "Bác sĩ cầm đèn và soi vào tai tôi.",
      "author": "ChatGPT4.1"
    },
    "4303": {
      "id": 3335328,
      "text": "Ông ấy đặt một que trên lưỡi tôi,",
      "author": "ChatGPT4.1"
    },
    "4305": {
      "id": 3335329,
      "text": "Ông ấy nhìn vào cổ họng của tôi.",
      "author": "ChatGPT4.1"
    },
    "4306": {
      "id": 3335330,
      "text": "bác sĩ nói rằng cổ họng tôi hơi sưng và đỏ.",
      "author": "a user"
    },
    "4310": {
      "id": 3335331,
      "text": "Ông ấy hỏi tôi một vài câu hỏi.",
      "author": "ChatGPT4.1"
    }
  }
}
