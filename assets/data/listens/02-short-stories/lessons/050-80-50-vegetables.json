  "translations": {
    "3579": {
      "id": 42566,
      "text": "Rau củ rất tốt cho bạn.",
      "author": "a user"
    },
    "3581": {
      "id": 42568,
      "text": "Tôi thích đậu Hà Lan. Đậu Hà Lan có vỏ.",
      "author": "a user"
    },
    "3582": {
      "id": 42569,
      "text": "Tôi cũng thích đậu tuyết. Khi ăn đậu tuyết, bạn ăn luôn cả vỏ.",
      "author": "a user"
    },
    "3583": {
      "id": 42570,
      "text": "Tôi thích ăn bắp khi nó còn nguyên trái",
      "author": "a user"
    },
    "3587": {
      "id": 42576,
      "text": "Có đậu que, đậu tây( đậu thận), đậu nướng (đậu hầm) và rất nhiều loại đậu khác.",
      "author": "a user"
    },
    "3594": {
      "id": 45776,
      "text": "Bố tôi thích các loại rau củ như củ dền và củ cải vàng.",
      "author": "a user"
    },
    "3598": {
      "id": 45782,
      "text": "Bà nói ở đó chúng tươi hơn.",
      "author": "a user"
    },
    "3599": {
      "id": 45784,
      "text": "Mẹ tôi mua rất nhiều hành tây.",
      "author": "a user"
    },
    "3600": {
      "id": 45786,
      "text": "Mẹ tôi cho hành tây vào hầu hết các bữa ăn mà bà nấu.",
      "author": "a user"
    },
    "3603": {
      "id": 45792,
      "text": "nhưng tôi đã trở nên quen với chúng.",
      "author": "a user"
    },
    "3580": {
      "id": 2621459,
      "text": "Người ta nói rằng bạn nên ăn ba khẩu phần rau mỗi ngày.",
      "author": "ChatGPT4.1"
    },
    "3584": {
      "id": 2621460,
      "text": "Cà rốt tốt cho sức khỏe khi ăn sống.",
      "author": "ChatGPT4.1"
    },
    "3585": {
      "id": 2621461,
      "text": "Đậu cũng tốt cho bạn.",
      "author": "ChatGPT4.1"
    },
    "3586": {
      "id": 2621462,
      "text": "Có rất nhiều loại đậu khác nhau.",
      "author": "ChatGPT4.1"
    },
    "3588": {
      "id": 2621463,
      "text": "Một số người không thích rau xanh như bông cải xanh và bắp cải tí hon.",
      "author": "ChatGPT4.1"
    },
    "3589": {
      "id": 2621464,
      "text": "Tôi thích bông cải xanh và bắp cải tí hon.",
      "author": "ChatGPT4.1"
    },
    "3590": {
      "id": 2621465,
      "text": "Bạn có thể làm salad và cho nhiều loại rau khác nhau vào đó.",
      "author": "ChatGPT4.1"
    },
    "3591": {
      "id": 2621466,
      "text": "Trong món salad của tôi, tôi thích xà lách, cà chua, cần tây,",
      "author": "ChatGPT4.1"
    },
    "3592": {
      "id": 2621467,
      "text": "dưa chuột, củ cải đỏ, súp lơ trắng và hành lá.",
      "author": "ChatGPT4.1"
    },
    "3593": {
      "id": 2621468,
      "text": "Tôi cố gắng ăn salad với nước sốt mỗi ngày.",
      "author": "ChatGPT4.1"
    },
    "3595": {
      "id": 2621469,
      "text": "Em trai tôi chỉ ăn mỗi khoai tây.",
      "author": "a user"
    },
    "3596": {
      "id": 2621470,
      "text": "Nó thích khoai tây nướng.",
      "author": "ChatGPT4.1"
    },
    "3597": {
      "id": 2621471,
      "text": "Mẹ tôi thích mua rau ở chợ.",
      "author": "ChatGPT4.1"
    },
    "3601": {
      "id": 2621472,
      "text": "Một số trẻ em không chịu ăn rau.",
      "author": "ChatGPT4.1"
    },
    "3602": {
      "id": 2621473,
      "text": "Lúc đầu tôi cũng không thích một số loại rau,",
      "author": "ChatGPT4.1"
    },
    "3604": {
      "id": 2621474,
      "text": "Tôi thích ăn rau kèm với các bữa ăn của mình.",
      "author": "ChatGPT4.1"
    }
  }
}
