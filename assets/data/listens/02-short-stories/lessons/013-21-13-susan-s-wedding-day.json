      "text": "Susan cần một cái gì đó màu xanh nước biển.",
      "author": "a user"
    },
    "911": {
      "id": 6145,
      "text": "đai nịt tất của cô ấy màu xanh da trời.",
      "author": "a user"
    },
    "913": {
      "id": 6460,
      "text": "Chiếc nhẫn của bà của cô ấy đã cũ.",
      "author": "a user"
    },
    "914": {
      "id": 6462,
      "text": "Susan cần mượn một thứ gì đó",
      "author": "a user"
    },
    "918": {
      "id": 6469,
      "text": "Susan cần một xu cho chiếc giày của cô ấy",
      "author": "a user"
    },
    "901": {
      "id": 10074,
      "text": "Tên vị hôn phu của cô ấy là Michael.",
      "author": "a user"
    },
    "904": {
      "id": 10084,
      "text": "Susan thức dậy sớm.",
      "author": "a user"
    },
    "905": {
      "id": 10085,
      "text": "Cô ấy đang được làm tóc.",
      "author": "a user"
    },
    "900": {
      "id": 2582654,
      "text": "Susan sắp kết hôn.",
      "author": "ChatGPT4.1"
    },
    "902": {
      "id": 2582655,
      "text": "Họ đang yêu nhau.",
      "author": "ChatGPT4.1"
    },
    "903": {
      "id": 2582656,
      "text": "Họ sẽ kết hôn ngày hôm nay.",
      "author": "ChatGPT4.1"
    },
    "907": {
      "id": 2582657,
      "text": "Susan trông rất xinh đẹp.",
      "author": "ChatGPT4.1"
    },
    "908": {
      "id": 2582658,
      "text": "Cô ấy mặc chiếc váy cưới màu trắng.",
      "author": "a user"
    },
    "909": {
      "id": 2582659,
      "text": "Cô ấy đội khăn voan cưới.",
      "author": "ChatGPT4.1"
    },
    "912": {
      "id": 2582660,
      "text": "Susan cần một thứ gì đó cũ.",
      "author": "a user"
    },
    "915": {
      "id": 2582661,
      "text": "Cô ấy đang đeo trang sức của mẹ mình.",
      "author": "a user"
    },
    "916": {
      "id": 2582662,
      "text": "Susan cần một vật gì đó mới.",
      "author": "ChatGPT4.1"
    },
    "917": {
      "id": 2582663,
      "text": "Đôi giày và chiếc váy của cô ấy đều mới.",
