  "translations": {
    "3748": {
      "id": 9825,
      "text": "Nếu bạn thấy một biển báo cho biết có đường dành cho trường học",
      "author": "a user"
    },
    "3751": {
      "id": 9828,
      "text": "Một số nơi là vạch kẻ đường dành cho người đi bộ.",
      "author": "a user"
    },
    "3760": {
      "id": 9896,
      "text": "Mọi người tuyệt đối không nên uống rượu bia rồi lái xe.",
      "author": "a user"
    },
    "3761": {
      "id": 9897,
      "text": "Lái xe là một công việc nghiêm túc.",
      "author": "a user"
    },
    "3740": {
      "id": 2586394,
      "text": "Xe cộ lưu thông trên các đường phố và xa lộ.",
      "author": "a user"
    },
    "3741": {
      "id": 2586395,
      "text": "Có những quy tắc mà tài xế phải tuân theo để giao thông diễn ra suôn sẻ.",
      "author": "ChatGPT4.1"
    },
    "3742": {
      "id": 2586396,
      "text": "Bạn phải thắt dây an toàn.",
      "author": "ChatGPT4.1"
    },
    "3743": {
      "id": 2586398,
      "text": "Dây an toàn giúp bảo vệ bạn an toàn.",
      "author": "ChatGPT4.1"
    },
    "3744": {
      "id": 2586399,
      "text": "Bạn phải dừng lại ở tất cả các biển báo dừng.",
      "author": "ChatGPT4.1"
    },
    "3745": {
      "id": 2586400,
      "text": "Bạn cũng phải dừng lại khi đèn đỏ.",
      "author": "ChatGPT4.1"
    },
    "3746": {
      "id": 2586401,
      "text": "Đèn xanh nghĩa là đi,",
      "author": "ChatGPT4.1"
    },
    "3747": {
      "id": 2586402,
      "text": "và đèn vàng nghĩa là chú ý.",
      "author": "ChatGPT4.1"
    },
    "3749": {
      "id": 2586403,
      "text": "bạn phải cẩn thận vì bạn đang gần trường học,",
      "author": "ChatGPT4.1"
    },
    "3750": {
      "id": 2586404,
      "text": "và trẻ em có thể đang băng qua đường.",
      "author": "ChatGPT4.1"
    },
    "3752": {
      "id": 2586405,
      "text": "Đó là những nơi người đi bộ băng qua đường.",
      "author": "ChatGPT4.1"
    },
    "3753": {
      "id": 2586406,
      "text": "Người đi bộ có quyền ưu tiên.",
      "author": "ChatGPT4.1"
    },
    "3754": {
      "id": 2586407,
      "text": "Nếu bạn nghe tiếng còi sau lưng, bạn phải tấp vào lề.",
      "author": "ChatGPT4.1"
    },
    "3755": {
      "id": 2586408,
      "text": "Xe khẩn cấp như xe cảnh sát hoặc xe cứu thương có thể cần đi nhanh tới đâu đó.",
      "author": "ChatGPT4.1"
    },
    "3756": {
      "id": 2586409,
      "text": "Khi xe buýt trường học bật đèn tín hiệu nhấp nháy, bạn phải dừng lại.",
      "author": "ChatGPT4.1"
    },
    "3757": {
      "id": 2586410,
      "text": "Bạn không được vượt qua xe buýt trường học vì trẻ em có thể đang băng qua đường từ xe buýt.",
      "author": "ChatGPT4.1"
    },
    "3758": {
      "id": 2586411,
      "text": "Bạn nên luôn tuân thủ giới hạn tốc độ.",
      "author": "ChatGPT4.1"
    },
    "3759": {
      "id": 2586412,
      "text": "Lái xe quá nhanh là không tốt.",
      "author": "ChatGPT4.1"
    },
    "3762": {
      "id": 2586413,
      "text": "Bạn phải tuân theo tất cả các quy tắc để trở thành một tài xế tốt.",
      "author": "ChatGPT4.1"
    }
  }
