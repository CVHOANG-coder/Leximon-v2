  "translations": {
    "4389": {
      "id": 56880,
      "text": "Tôi không thích có nét nhăn nhó trên khuôn mặt của mình.",
      "author": "a user"
    },
    "4395": {
      "id": 56892,
      "text": "Tôi thích cười.",
      "author": "a user"
    },
    "4400": {
      "id": 56898,
      "text": "Tôi cố gắng không thể hiện ra ngoài khi tôi tức giận.",
      "author": "a user"
    },
    "4383": {
      "id": 2603887,
      "text": "Bạn có bao giờ nghĩ về những cảm xúc của mình không?",
      "author": "a user"
    },
    "4384": {
      "id": 2603888,
      "text": "Những điều gì khiến bạn buồn?",
      "author": "a user"
    },
    "4385": {
      "id": 2603889,
      "text": "Tôi buồn khi tôi bị điểm kém ở trường",
      "author": "ChatGPT4.1"
    },
    "4386": {
      "id": 2603890,
      "text": "hoặc khi người mà tôi thích chuyển đi nơi khác",
      "author": "a user"
    },
    "4387": {
      "id": 2603891,
      "text": "Thỉnh thoảng tôi xem những bộ phim buồn khiến tôi khóc.",
      "author": "ChatGPT4.1"
    },
    "4388": {
      "id": 2603892,
      "text": "Tôi không thích buồn.",
      "author": "ChatGPT4.1"
    },
    "4390": {
      "id": 2603893,
      "text": "Tôi thích hạnh phúc. Phần lớn thời gian tôi thấy vui vẻ.",
      "author": "ChatGPT4.1"
    },
    "4391": {
      "id": 2603894,
      "text": "Những bữa tiệc khiến tôi hạnh phúc.",
      "author": "a user"
    },
    "4392": {
      "id": 2603895,
      "text": "Tôi cảm thấy hạnh phúc khi được ở bên bạn bè.",
      "author": "a user"
    },
    "4393": {
      "id": 2603896,
      "text": "Có rất nhiều thứ khiến tôi hạnh phúc.",
      "author": "a user"
    },
    "4394": {
      "id": 2603897,
      "text": "Nếu ai đó kể chuyện cười, tôi cười.",
      "author": "ChatGPT4.1"
    },
    "4396": {
      "id": 2603898,
      "text": "Phim hài khiến tôi cười.",
      "author": "ChatGPT4.1"
    },
    "4397": {
      "id": 2603899,
      "text": "Tôi nghĩ mọi người trông đẹp nhất khi họ cười.",
      "author": "ChatGPT4.1"
    },
    "4398": {
      "id": 2603900,
      "text": "Những điều gì làm bạn tức giận?",
      "author": "ChatGPT4.1"
    },
    "4399": {
      "id": 2603901,
      "text": "Tôi tức giận khi em trai làm hỏng một món đồ chơi của tôi.",
      "author": "ChatGPT4.1"
    },
    "4401": {
      "id": 2603902,
      "text": "Bố mẹ tôi nổi giận nếu tôi về nhà muộn.",
      "author": "ChatGPT4.1"
    },
    "4402": {
      "id": 2603903,
      "text": "Tôi không nghĩ tức giận là một cảm xúc tốt.",
      "author": "ChatGPT4.1"
    },
    "4403": {
      "id": 2603904,
      "text": "Tốt nhất là nên giữ bình tĩnh và nói chuyện với nhau.",
      "author": "ChatGPT4.1"
    },
    "4404": {
      "id": 2603905,
      "text": "Cảm xúc xuất phát từ bên trong bạn,",
      "author": "ChatGPT4.1"
    },
    "4405": {
      "id": 2603906,
      "text": "nhưng chúng thể hiện trên khuôn mặt bạn.",
      "author": "ChatGPT4.1"
    },
    "4406": {
      "id": 2603907,
      "text": "Mọi người có thể nhận ra khi bạn tức giận, buồn, hoặc vui.",
      "author": "ChatGPT4.1"
    },
    "4407": {
      "id": 2603908,
      "text": "Tôi thích trông vui vẻ hơn.",
      "author": "ChatGPT4.1"
    },
    "4408": {
      "id": 2603909,
      "text": "Đôi khi, ngay cả khi đang buồn, tôi vẫn mỉm cười.",
      "author": "a user"
    },
    "4409": {
      "id": 2603910,
      "text": "và nụ cười giúp tôi cảm thấy tốt hơn một chút.",
      "author": "ChatGPT4.1"
    }
  }
}
