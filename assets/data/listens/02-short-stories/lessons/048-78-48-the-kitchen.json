  "translations": {
    "3534": {
      "id": 29869,
      "text": "Chúng tôi bật vòi nước nóng, và cho một ít nước rửa chén vào bồn rửa để rửa chén bát.",
      "author": "a user"
    },
    "3540": {
      "id": 30070,
      "text": "Có găng tay lò và miếng lót đỡ tay nồi để lấy đồ nóng ra khỏi lò.",
      "author": "a user"
    },
    "3543": {
      "id": 30075,
      "text": "Chúng ta có những cái đĩa để ăn.",
      "author": "a user"
    },
    "3546": {
      "id": 30085,
      "text": "Chúng tôi đựng nước ép trong bình hoặc ca.",
      "author": "a user"
    },
    "3516": {
      "id": 2583082,
      "text": "Nhà bếp là nơi chúng ta nấu và ăn các bữa ăn của mình.",
      "author": "ChatGPT4.1"
    },
    "3517": {
      "id": 2583083,
      "text": "Trong nhà bếp có một cái bếp.",
      "author": "ChatGPT4.1"
    },
    "3518": {
      "id": 2583084,
      "text": "Bên trong bếp có một lò nướng nơi bạn có thể nướng các món ăn.",
      "author": "ChatGPT4.1"
    },
    "3519": {
      "id": 2583085,
      "text": "Bạn có thể đặt một chiếc bánh vào lò để nướng.",
      "author": "ChatGPT4.1"
    },
    "3520": {
      "id": 2583086,
      "text": "Phía trên bếp có các bếp lửa.",
      "author": "ChatGPT4.1"
    },
    "3521": {
      "id": 2583087,
      "text": "Các bếp lửa sẽ nóng lên.",
      "author": "ChatGPT4.1"
    },
    "3522": {
      "id": 2583088,
      "text": "Bạn đặt nồi hoặc chảo lên các bếp lửa đó.",
      "author": "ChatGPT4.1"
    },
    "3523": {
      "id": 2583089,
      "text": "Tủ lạnh là nơi chúng ta cất giữ thực phẩm cần được giữ lạnh.",
      "author": "ChatGPT4.1"
    },
    "3524": {
      "id": 2583090,
      "text": "Chúng ta để sữa, trứng, phô mai và rau trong tủ lạnh.",
      "author": "ChatGPT4.1"
    },
    "3525": {
      "id": 2583091,
      "text": "Ngăn đá nằm ở phía trên cùng của tủ lạnh.",
      "author": "a user"
    },
    "3526": {
      "id": 2583092,
      "text": "Tủ đông giúp giữ cho thực phẩm luôn ở trạng thái đông lạnh.",
      "author": "a user"
    },
    "3527": {
      "id": 2583093,
      "text": "Chúng ta có rau củ đông lạnh, kem và đá viên trong ngăn đá.",
      "author": "ChatGPT4.1"
    },
    "3528": {
      "id": 2583094,
      "text": "Chúng ta có một cái máy nướng bánh mì trong nhà bếp.",
      "author": "ChatGPT4.1"
    },
    "3529": {
      "id": 2583095,
      "text": "Bạn cho bánh mì vào máy nướng bánh mì, và nó sẽ biến thành bánh mì nướng.",
      "author": "a user"
    },
    "3530": {
      "id": 2583096,
      "text": "Chúng ta có một ấm đun nước điện.",
      "author": "ChatGPT4.1"
    },
    "3531": {
      "id": 2583097,
      "text": "Chúng tôi đun sôi nước để pha trà trong ấm đun nước.",
      "author": "a user"
    },
    "3532": {
      "id": 2583098,
      "text": "Có một cái bồn rửa đôi trong nhà bếp.",
      "author": "ChatGPT4.1"
    },
    "3533": {
      "id": 2583099,
      "text": "Đó là nơi chúng ta rửa chén bát.",
      "author": "ChatGPT4.1"
    },
    "3535": {
      "id": 2583100,
      "text": "Đôi khi chúng ta cho chén bát vào máy rửa chén,",
      "author": "ChatGPT4.1"
    },
    "3536": {
      "id": 2583101,
      "text": "và máy rửa chén sẽ rửa sạch bát đĩa.",
      "author": "ChatGPT4.1"
    },
    "3537": {
      "id": 2583102,
      "text": "Trong nhà bếp còn có những thứ khác.",
      "author": "ChatGPT4.1"
    },
    "3538": {
      "id": 2583103,
      "text": "Có các dụng cụ như dao, nĩa và muỗng.",
      "author": "ChatGPT4.1"
    },
    "3539": {
      "id": 2583104,
      "text": "Có khăn lau trà và khăn lau bát đĩa.",
      "author": "a user"
    },
    "3541": {
      "id": 2583105,
      "text": "Có nồi để nấu và luộc đồ ăn.",
      "author": "ChatGPT4.1"
    },
    "3542": {
      "id": 2583106,
      "text": "Có chảo để chiên rán thức ăn.",
      "author": "ChatGPT4.1"
    },
    "3544": {
      "id": 2583107,
      "text": "Chúng ta có đĩa để ăn tối và tô để đựng súp.",
      "author": "ChatGPT4.1"
    },
    "3545": {
      "id": 2583108,
      "text": "Chúng ta uống từ tách, cốc cà phê hoặc ly thủy tinh.",
      "author": "a user"
    },
    "3547": {
      "id": 2587644,
      "text": "Có một đồng hồ hẹn giờ mà bạn có thể đặt khi nấu ăn.",
      "author": "ChatGPT4.1"
    },
    "3548": {
      "id": 2587645,
      "text": "Đồng hồ hẹn giờ sẽ kêu lên khi thức ăn đã sẵn sàng.",
      "author": "ChatGPT4.1"
    },
    "3549": {
      "id": 2587646,
      "text": "Chúng tôi cũng có một lò vi sóng trong bếp.",
      "author": "ChatGPT4.1"
    },
    "3550": {
      "id": 2587647,
      "text": "Nếu chúng tôi vội, chúng tôi sẽ nấu thức ăn trong lò vi sóng.",
      "author": "ChatGPT4.1"
    }
  }
}
