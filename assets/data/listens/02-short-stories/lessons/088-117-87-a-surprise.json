  "translations": {
    "4634": {
      "id": 10354,
      "text": "Anh trai tôi đoán rằng chúng tôi sẽ đi nhà hàng ăn tối.",
      "author": "a user"
    },
    "4636": {
      "id": 10369,
      "text": "Anh trai khác của tôi hỏi bố tôi liệu rằng có vé xem một trận khúc côn cầu không.",
      "author": "a user"
    },
    "4640": {
      "id": 23793,
      "text": "Mẹ tôi biết điều bất ngờ là gì, nên bà chỉ đứng và mỉm cười với chúng tôi.",
      "author": "a user"
    },
    "4644": {
      "id": 23813,
      "text": "Anh trai tôi hỏi rằng sự bất ngờ lớn đến mức nào.",
      "author": "a user"
    },
    "4645": {
      "id": 23814,
      "text": "Cha tôi nói rằng điều bất ngờ khá nhỏ.",
      "author": "a user"
    },
    "4646": {
      "id": 23818,
      "text": "Chúng tôi không biết chắc điều bất ngờ đó là gì.",
      "author": "a user"
    },
    "4647": {
      "id": 23819,
      "text": "\"Tất cả chúng con sẽ thích nó chứ?\" Tôi hỏi.",
      "author": "a user"
    },
    "4649": {
      "id": 23823,
      "text": "Mỗi người trong số các bạn sẽ thích điều bất ngờ này.",
      "author": "a user"
    },
    "4651": {
      "id": 23829,
      "text": "“điều bất ngờ của con muốn gặp con,” bố tôi nói.",
      "author": "a user"
    },
    "4652": {
      "id": 23831,
      "text": "Ông ấy mở cửa phòng ngủ, và một chú cún con nhỏ xíu chạy ào ra.",
      "author": "a user"
    },
    "4653": {
      "id": 23833,
      "text": "Tất cả chúng tôi đều rất thích thú. Điều bất ngờ của chúng tôi là một con cún con.",
      "author": "a user"
    },
    "4659": {
      "id": 23856,
      "text": "Nó đang lớn rất nhanh và sẽ sớm trở thành một chú chó trưởng thành.",
      "author": "a user"
    },
    "4660": {
      "id": 23858,
      "text": "Tất cả chúng tôi đều đồng ý rằng con chó con là điều bất ngờ tuyệt vời nhất mà bố tôi có thể dành cho chúng tôi.",
      "author": "a user"
    },
    "4632": {
      "id": 2605412,
      "text": "Thứ sáu tuần trước, ba tôi đi làm về và nói rằng ông ấy có một điều bất ngờ dành cho chúng tôi.",
      "author": "ChatGPT4.1"
    },
    "4633": {
      "id": 2605413,
      "text": "Chúng tôi cố gắng đoán xem điều bất ngờ đó có thể là gì.",
      "author": "ChatGPT4.1"
    },
    "4635": {
      "id": 2605414,
      "text": "Ba tôi nói \"không\".",
      "author": "ChatGPT4.1"
    },
    "4637": {
      "id": 2605415,
      "text": "Ba tôi nói \"không\".",
      "author": "ChatGPT4.1"
    },
    "4638": {
      "id": 2605416,
      "text": "Chị gái tôi hỏi liệu chúng tôi có đi du lịch không.",
      "author": "ChatGPT4.1"
    },
    "4639": {
      "id": 2605417,
      "text": "Ba tôi nói \"không\".",
      "author": "ChatGPT4.1"
    },
    "4641": {
      "id": 2605418,
      "text": "Tôi đoán rằng nhà tôi sắp có một hồ bơi.",
      "author": "a user"
    },
    "4642": {
      "id": 2605419,
      "text": "Ba tôi nói \"không\".",
      "author": "ChatGPT4.1"
    },
    "4643": {
      "id": 2605420,
      "text": "Chúng tôi bắt đầu cảm thấy rất bực bội khi cố đoán xem điều bất ngờ có thể là gì.",
      "author": "ChatGPT4.1"
    },
    "4648": {
      "id": 2605421,
      "text": "\"Đúng vậy,\" ba tôi trả lời.",
      "author": "ChatGPT4.1"
    },
    "4650": {
      "id": 2605422,
      "text": "Chúng tôi nghe thấy một tiếng động. Đó là tiếng khóc.",
      "author": "ChatGPT4.1"
    },
    "4654": {
      "id": 2605423,
      "text": "Đó là một chú chó Spaniel con nhỏ xíu.",
      "author": "ChatGPT4.1"
    },
    "4655": {
      "id": 2605424,
      "text": "Chú chó con rất yêu quý tất cả chúng tôi.",
      "author": "ChatGPT4.1"
    },
    "4656": {
      "id": 2605425,
      "text": "Nó chạy khắp nơi rồi liếm mặt tất cả chúng tôi.",
      "author": "a user"
    },
    "4657": {
      "id": 2605426,
      "text": "Chúng tôi luôn mong muốn có một chú chó.",
      "author": "ChatGPT4.1"
    },
    "4658": {
      "id": 2605427,
      "text": "Chúng tôi thay phiên nhau cho chó con ăn và dắt nó đi dạo.",
      "author": "ChatGPT4.1"
    }
  }
}
