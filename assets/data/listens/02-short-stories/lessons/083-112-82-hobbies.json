  "translations": {
    "4480": {
      "id": 69535,
      "text": "Một đoàn tàu điện tí hon chạy qua những ngôi làng mô phỏng.",
      "author": "a user"
    },
    "4483": {
      "id": 69538,
      "text": "Anh ấy có một chiếc thuyền buồm thật và chở chúng tôi ra ngoài bằng nó",
      "author": "a user"
    },
    "4487": {
      "id": 69542,
      "text": "Tôi trao đổi truyện tranh với một số người bạn của mình,",
      "author": "a user"
    },
    "4492": {
      "id": 69548,
      "text": "họ giữ lại con tem cho tôi.",
      "author": "a user"
    },
    "4497": {
      "id": 69567,
      "text": "nhưng tôi có một đồng 10 cents rất cũ từ Canada,",
      "author": "a user"
    },
    "4499": {
      "id": 69575,
      "text": "Mẹ tôi đã từng sưu tập búp bê khi bà còn là một cô bé.",
      "author": "a user"
    },
    "4507": {
      "id": 69583,
      "text": "Có lẽ Linda sẽ trở thành một nhà thiết kế thời trang khi cô ấy lớn hơn.",
      "author": "a user"
    },
    "4476": {
      "id": 2587478,
      "text": "Rất nhiều người có sở thích.",
      "author": "ChatGPT4.1"
    },
    "4477": {
      "id": 2587479,
      "text": "Sở thích là những hoạt động thú vị mà mọi người thích làm trong thời gian rảnh.",
      "author": "a user"
    },
    "4478": {
      "id": 2587480,
      "text": "Bố tôi có một sở thích.",
      "author": "ChatGPT4.1"
    },
    "4479": {
      "id": 2587481,
      "text": "Anh ấy có một bộ mô hình đường sắt do chính anh ấy lắp ráp.",
      "author": "a user"
    },
    "4481": {
      "id": 2587482,
      "text": "và chạy xuyên qua những đường hầm, băng qua những ngọn núi.",
      "author": "a user"
    },
    "4482": {
      "id": 2587483,
      "text": "Bố tôi cũng thích chèo thuyền buồm.",
      "author": "ChatGPT4.1"
    },
    "4484": {
      "id": 2587484,
      "text": "Ông đang dạy tôi cách chèo thuyền buồm.",
      "author": "ChatGPT4.1"
    },
    "4485": {
      "id": 2587485,
      "text": "Tôi thích sưu tầm đồ vật.",
      "author": "ChatGPT4.1"
    },
    "4486": {
      "id": 2587486,
      "text": "Tôi sưu tập truyện tranh, tem và tiền xu.",
      "author": "ChatGPT4.1"
    },
    "4488": {
      "id": 2587487,
      "text": "và đôi khi tôi mua truyện tranh ở các cửa hàng.",
      "author": "ChatGPT4.1"
    },
    "4489": {
      "id": 2587488,
      "text": "Một số truyện tranh rất cũ có giá trị rất cao.",
      "author": "ChatGPT4.1"
    },
    "4490": {
      "id": 2587489,
      "text": "Tôi có các con tem từ khắp nơi trên thế giới.",
      "author": "ChatGPT4.1"
    },
    "4491": {
      "id": 2587490,
      "text": "Bất cứ khi nào bạn bè tôi nhận được một bức thư từ nơi xa,",
      "author": "ChatGPT4.1"
    },
    "4493": {
      "id": 2587491,
      "text": "Tôi có tem từ Anh, Nhật Bản, Úc và thậm chí cả Nga.",
      "author": "ChatGPT4.1"
    },
    "4494": {
      "id": 2587492,
      "text": "Tôi sử dụng kính lúp để xem các con tem,",
      "author": "ChatGPT4.1"
    },
    "4495": {
      "id": 2587493,
      "text": "và tôi giữ chúng trong một quyển album đặc biệt.",
      "author": "ChatGPT4.1"
    },
    "4496": {
      "id": 2587494,
      "text": "Tôi chưa có nhiều tiền xu lắm,",
      "author": "ChatGPT4.1"
    },
    "4498": {
      "id": 2587495,
      "text": "và tôi có một đồng xu có lỗ ở giữa đến từ châu Phi.",
      "author": "ChatGPT4.1"
    },
    "4500": {
      "id": 2587496,
      "text": "Những con búp bê mặc trang phục của các quốc gia khác nhau.",
      "author": "ChatGPT4.1"
    },
    "4501": {
      "id": 2587497,
      "text": "Sở thích của bạn tôi, John, là vẽ tranh.",
      "author": "ChatGPT4.1"
    },
    "4502": {
      "id": 2587498,
      "text": "Cậu ấy vẽ tranh sơn dầu.",
      "author": "ChatGPT4.1"
    },
    "4503": {
      "id": 2587499,
      "text": "Cậu ấy thậm chí đã bán được một vài bức tranh của mình.",
      "author": "ChatGPT4.1"
    },
    "4504": {
      "id": 2587500,
      "text": "Cậu ấy là một họa sĩ giỏi.",
      "author": "ChatGPT4.1"
    },
    "4505": {
      "id": 2587501,
      "text": "Bạn tôi Linda thì may vá.",
      "author": "ChatGPT4.1"
    },
    "4506": {
      "id": 2608057,
      "text": "Cô ấy đã may quần áo cho mình và cho một số bạn bè.",
      "author": "ChatGPT4.1"
    },
    "4508": {
      "id": 2608058,
      "text": "Đôi khi sở thích của mọi người lại dẫn lối họ đến nghề nghiệp của mình.",
      "author": "ChatGPT4.1"
    }
  }
}
