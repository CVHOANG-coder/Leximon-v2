  "translations": {
    "8965": {
      "id": 2391733,
      "text": "Thế vận hội Olympic hiện đại bắt đầu vào cuối thế kỷ XIX như một sự phục hồi của Thế vận hội Hy Lạp cổ đại.",
      "author": "DeepSeekAI"
    },
    "8966": {
      "id": 2391734,
      "text": "Đến nay đã hơn 100 năm tuổi, phong trào Olympic hiện đại là phong trào thể thao lớn nhất và quan trọng nhất thế giới.",
      "author": "DeepSeekAI"
    },
    "8967": {
      "id": 2391735,
      "text": "Trên thực tế, nhiều người tin rằng Thế vận hội Olympic là sự kiện văn hóa quan trọng nhất thuộc bất kỳ loại hình nào trên thế giới.",
      "author": "DeepSeekAI"
    },
    "8968": {
      "id": 2391736,
      "text": "Thế vận hội Olympic hiện đại là ý tưởng của người Pháp - Nam tước Pierre de Coubertin.",
      "author": "DeepSeekAI"
    },
    "8969": {
      "id": 2391737,
      "text": "Giấc mơ của de Coubertin về một sự kiện thể thao quốc tế và phong trào văn hóa đã trở thành hiện thực vào năm 1894",
      "author": "DeepSeekAI"
    },
    "8970": {
      "id": 2391738,
      "text": "tại Đại hội Thể thao Quốc tế ở Paris.",
      "author": "DeepSeekAI"
    },
    "8971": {
      "id": 2391739,
      "text": "Sau khi Thế vận hội được thành lập vào năm 1894,",
      "author": "DeepSeekAI"
    },
    "8972": {
      "id": 2391740,
      "text": "kỳ Thế vận hội Olympic đầu tiên được tổ chức tại Athens, Hy Lạp, vào năm 1896,",
      "author": "DeepSeekAI"
    },
    "8973": {
      "id": 2391741,
      "text": "nhằm tôn vinh Thế vận hội Olympic cổ đại của Hy Lạp.",
      "author": "DeepSeekAI"
    },
    "8974": {
      "id": 2391742,
      "text": "Mục đích ban đầu của Thế vận hội Olympic trong suy nghĩ của de Coubertin",
      "author": "DeepSeekAI"
    },
    "8975": {
      "id": 2391743,
      "text": "là để tôn vinh và củng cố những phẩm chất thể chất, tinh thần và văn hóa của nhân loại.",
      "author": "DeepSeekAI"
    },
    "8976": {
      "id": 2391744,
      "text": "Thế vận hội sẽ kết hợp thể thao với văn hóa, truyền thống và giáo dục.",
      "author": "DeepSeekAI"
    },
    "8977": {
      "id": 2391745,
      "text": "Triết lý của chủ nghĩa Olympic dựa trên niềm vui của nỗ lực thể chất và tinh thần cùng sự tôn trọng các nguyên tắc đạo đức phổ quát.",
      "author": "DeepSeekAI"
    },
    "8978": {
      "id": 2391746,
      "text": "De Coubertin hình dung việc tạo ra một nhân loại cao quý và đồng cảm hơn thông qua phong trào Olympic.",
      "author": "DeepSeekAI"
    },
    "8979": {
      "id": 2391747,
      "text": "Các sự kiện thể thao mà de Coubertin mô phỏng theo hệ thống thể thao trường công của Anh.",
      "author": "DeepSeekAI"
    },
    "8980": {
      "id": 2391748,
      "text": "Ông nhìn thấy ở môn thể thao của các nam sinh tầng lớp thượng lưu Anh những phẩm chất của tình đồng đội, sự cao quý và trung thực.",
      "author": "DeepSeekAI"
    },
    "8981": {
      "id": 2391749,
      "text": "Tuy nhiên, quan trọng nhất là tuân thủ các quy tắc thể thao,",
      "author": "DeepSeekAI"
    },
    "8982": {
      "id": 2391750,
      "text": "đặc biệt là quy tắc quy định thể thao phải mang tính nghiệp dư.",
      "author": "DeepSeekAI"
    },
    "8983": {
      "id": 2391751,
      "text": "De Coubertin tin rằng người tham gia không bao giờ nên chơi thể thao vì mục đích kiếm tiền.",
      "author": "DeepSeekAI"
    },
    "8984": {
      "id": 2391752,
      "text": "Làm như vậy sẽ mâu thuẫn với triết lý cơ bản của thể thao.",
      "author": "DeepSeekAI"
    },
    "8985": {
      "id": 2391753,
      "text": "Việc vi phạm quy tắc nghiệp dư vào thời của de Coubertin",
      "author": "DeepSeekAI"
    },
    "8986": {
      "id": 2391754,
      "text": "là một hành vi vi phạm nghiêm trọng như việc sử dụng chất cấm để tăng thành tích trong thể thao ngày nay.",
      "author": "DeepSeekAI"
    },
    "8987": {
      "id": 2391755,
      "text": "Theo thời gian, Thế vận hội đã trở thành lễ hội quốc tế lớn nhất thuộc bất kỳ loại hình nào.",
      "author": "DeepSeekAI"
    },
    "8988": {
      "id": 2391756,
      "text": "Ngày nay, có nhiều tranh luận về mức độ mà Thế vận hội hiện đại tuân theo ý định ban đầu của de Coubertin.",
      "author": "DeepSeekAI"
    },
    "8989": {
      "id": 2391757,
      "text": "Một mặt, thể thao Olympic thực sự mang tính quốc tế,",
      "author": "DeepSeekAI"
    },
    "8990": {
      "id": 2391758,
      "text": "như de Coubertin mong muốn.",
      "author": "DeepSeekAI"
    },
    "8991": {
      "id": 2391759,
      "text": "Mặt khác, khó có thể tin rằng de Coubertin sẽ hài lòng với sự tồn tại của chính trị,",
      "author": "DeepSeekAI"
    },
    "8992": {
      "id": 2391760,
      "text": "thương mại hóa và việc sử dụng chất cấm trong thể thao.",
      "author": "DeepSeekAI"
    },
    "8993": {
      "id": 2391761,
      "text": "Thế vận hội đã thực sự trở nên toàn cầu, nhưng có lẽ phải trả giá.",
      "author": "DeepSeekAI"
    },
    "8994": {
      "id": 2391762,
      "text": "Không có nghi ngờ gì rằng Thế vận hội Olympic vẫn mang trong mình khả năng thực hiện mục tiêu ban đầu của de Coubertin",
      "author": "DeepSeekAI"
    },
    "8995": {
      "id": 2391763,
      "text": "về việc thể thao góp phần tạo nên một thế giới tốt đẹp, hòa bình và thấu hiểu hơn.",
      "author": "DeepSeekAI"
    }
  }
}
