      "id": 8132,
      "text": "Joe rất muốn chiếc xe này.",
      "author": "a user"
    },
    "849": {
      "id": 8134,
      "text": "Joe và bố anh ấy đã làm một thỏa thuận.",
      "author": "a user"
    },
