  "translations": {
    "6106": {
      "id": 74215,
      "text": "Tôi cảm thấy rất háo hức và có cảm giác hồi hộp (như có bướm bay trong bụng)",
      "author": "a user"
    },
    "6109": {
      "id": 74218,
      "text": "Chị gái cho tôi một vài cái kẹp xinh xinh để cài lên tóc.",
      "author": "a user"
    },
    "6111": {
      "id": 74220,
      "text": "Người hẹn của tôi đến rồi!",
      "author": "a user"
    },
    "6119": {
      "id": 74229,
      "text": "Người hẹn hò của tôi gọi bít tết.",
      "author": "a user"
    },
    "6121": {
      "id": 74232,
      "text": "Nhân viên phục vụ hỏi chúng tôi liệu chúng tôi có muốn món tráng miệng sau khi chúng tôi đã hoàn thành bữa ăn.",
      "author": "a user"
    },
    "6124": {
      "id": 74235,
      "text": "Người hẹn hò của tôi trả tiền cho bữa ăn.",
      "author": "a user"
    },
    "6131": {
      "id": 74247,
      "text": "Vì vậy, người hẹn hò của tôi đưa tôi về nhà.",
      "author": "a user"
    },
    "6133": {
      "id": 74250,
      "text": "Tôi hy vọng anh ấy sẽ mời tôi đi chơi lần nữa!",
      "author": "a user"
    },
    "6093": {
      "id": 2607158,
      "text": "\"Reng, reng.\" Điện thoại đang reo.",
      "author": "ChatGPT4.1"
    },
    "6094": {
      "id": 2607159,
      "text": "Mẹ tôi trả lời điện thoại.",
      "author": "ChatGPT4.1"
    },
    "6095": {
      "id": 2607160,
      "text": "\"Alo,\" mẹ nói. Cuộc gọi này dành cho tôi.",
      "author": "ChatGPT4.1"
    },
    "6096": {
      "id": 2607161,
      "text": "Khi tôi nhấc máy, tôi nghe thấy giọng một cậu bé.",
      "author": "ChatGPT4.1"
    },
    "6097": {
      "id": 2607162,
      "text": "Đó là một cậu bạn cùng trường với tôi.",
      "author": "ChatGPT4.1"
    },
    "6098": {
      "id": 2607163,
      "text": "Cậu ấy rất tốt bụng và cũng dễ thương nữa.",
      "author": "ChatGPT4.1"
    },
    "6099": {
      "id": 2607164,
      "text": "Cậu ấy hỏi tôi có muốn đi ăn tối với cậu ấy tối nay không.",
      "author": "ChatGPT4.1"
    },
    "6100": {
      "id": 2607165,
      "text": "Tôi đồng ý.",
      "author": "ChatGPT4.1"
    },
    "6101": {
      "id": 2607166,
      "text": "Cậu ấy sẽ đón tôi lúc 5:30 chiều.",
      "author": "ChatGPT4.1"
    },
    "6102": {
      "id": 2607167,
      "text": "Cậu ấy có một chiếc xe hơi màu đỏ đẹp.",
      "author": "ChatGPT4.1"
    },
    "6103": {
      "id": 2607168,
      "text": "Trước khi cậu ấy đến đón, tôi phải tìm một bộ đồ để mặc.",
      "author": "ChatGPT4.1"
    },
    "6104": {
      "id": 2607169,
      "text": "Tôi lo lắng và không biết nên mặc gì.",
      "author": "ChatGPT4.1"
    },
    "6105": {
      "id": 2607170,
      "text": "Vì thế chị gái tôi đã chọn giúp tôi một bộ đồ.",
      "author": "ChatGPT4.1"
    },
