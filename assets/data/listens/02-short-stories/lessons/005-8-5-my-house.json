      "id": 2585667,
      "text": "Nhà tôi có một phòng tắm lớn.",
      "author": "ChatGPT4.1"
    },
    "353": {
      "id": 2585668,
      "text": "Nhà tôi có nhiều tủ quần áo.",
      "author": "ChatGPT4.1"
    },
    "354": {
      "id": 2585669,
      "text": "Nhà tôi có một tầng hầm.",
      "author": "ChatGPT4.1"
    },
    "355": {
      "id": 2585670,
      "text": "Bố tôi có một xưởng làm việc dưới tầng hầm.",
      "author": "ChatGPT4.1"
    },
    "357": {
      "id": 2585671,
      "text": "Nhà tôi không có tầng hai.",
      "author": "ChatGPT4.1"
    },
    "358": {
      "id": 2585672,
      "text": "Nhà tôi có một nhà để xe.",
      "author": "ChatGPT4.1"
    },
    "360": {
      "id": 2585673,
      "text": "Sân sau nhà tôi có một cây phong.",
      "author": "ChatGPT4.1"
    },
    "362": {
      "id": 2585674,
      "text": "Sân sau nhà tôi có một vườn rau.",
      "author": "ChatGPT4.1"
    },
