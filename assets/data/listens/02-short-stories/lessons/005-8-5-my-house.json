  "translations": {
    "346": {
      "id": 4702,
      "text": "Bố mẹ tôi ngủ trong một phòng ngủ.",
      "author": "a user"
    },
    "347": {
      "id": 4703,
      "text": "Tôi và chị gái dùng chung phòng ngủ còn lại",
      "author": "a user"
    },
    "348": {
      "id": 4705,
      "text": "Nhà tôi có một phòng bếp",
      "author": "a user"
    },
    "349": {
      "id": 4706,
      "text": "Mẹ và bố tôi nấu bữa tối ở đó mỗi tối.",
      "author": "a user"
    },
    "350": {
      "id": 4708,
      "text": "Nhà tôi có một phòng khách.",
      "author": "a user"
    },
    "351": {
      "id": 4709,
      "text": "Gia đình tôi xem tivi ở đó mỗi tối",
      "author": "a user"
    },
    "356": {
      "id": 4718,
      "text": "Bố tôi làm đồ nội thất gỗ.",
      "author": "a user"
    },
    "359": {
      "id": 4726,
      "text": "Ngôi nhà của tôi có sân sau rộng",
      "author": "a user"
    },
    "361": {
      "id": 4730,
      "text": "Sân sau của tôi có một hồ bơi.\n",
      "author": "a user"
    },
    "343": {
      "id": 2585664,
      "text": "Tôi sống trong một ngôi nhà.",
      "author": "ChatGPT4.1"
    },
    "344": {
      "id": 2585665,
      "text": "Nhà tôi nhỏ.",
