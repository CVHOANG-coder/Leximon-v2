  "translations": {
    "5143": {
      "id": 63818,
      "text": "Nhiều người hạ quyết tâm.",
      "author": "a user"
    },
    "5148": {
      "id": 63827,
      "text": "Có đủ mọi loại quyết tâm mà người ta đặt ra.",
      "author": "a user"
    },
    "5155": {
      "id": 63837,
      "text": "Đó là điều quyết tâm của năm mới.",
      "author": "a user"
    },
    "5159": {
      "id": 63845,
      "text": "Tôi không tạo ra các quyết tâm của năm mới.",
      "author": "a user"
    },
    "5161": {
      "id": 63847,
      "text": "Tôi làm việc từng ngày để bỏ thói quen xấu.",
      "author": "a user"
    },
    "5142": {
      "id": 2596002,
      "text": "Vào ngày đầu năm mới, mọi người bắt đầu một năm mới.",
      "author": "ChatGPT4.1"
    },
    "5144": {
      "id": 2596003,
      "text": "Họ quyết tâm trở thành những người tốt hơn.",
      "author": "ChatGPT4.1"
    },
    "5145": {
      "id": 2596004,
      "text": "Một số người quyết định sẽ giảm cân để có thể khỏe mạnh hơn.",
      "author": "ChatGPT4.1"
    },
    "5146": {
      "id": 2596005,
      "text": "Một số người quyết định bỏ hút thuốc.",
      "author": "ChatGPT4.1"
    },
    "5147": {
      "id": 2596006,
      "text": "Họ cũng muốn trở nên khỏe mạnh hơn.",
      "author": "ChatGPT4.1"
    },
    "5149": {
      "id": 2596007,
      "text": "Một số người cố gắng không để mất bình tĩnh.",
      "author": "a user"
    },
    "5150": {
      "id": 2596008,
      "text": "Một số người nói rằng họ sẽ làm việc chăm chỉ hơn.",
      "author": "ChatGPT4.1"
    },
    "5151": {
      "id": 2596009,
      "text": "Có những người cố gắng từ bỏ những thói quen xấu.",
      "author": "ChatGPT4.1"
    },
    "5152": {
      "id": 2596010,
      "text": "Năm nào anh/em trai tôi cũng nói rằng sẽ không cắn móng tay nữa.",
      "author": "a user"
    },
    "5153": {
      "id": 2596011,
      "text": "Anh ấy ngừng cắn móng tay vào tháng Giêng,",
      "author": "ChatGPT4.1"
    },
    "5154": {
      "id": 2596012,
      "text": "nhưng đến tháng Hai thì anh ấy lại bắt đầu cắn tiếp.",
      "author": "ChatGPT4.1"
    },
    "5156": {
      "id": 2596013,
      "text": "Mọi người hiếm khi giữ được quyết tâm đó.",
      "author": "ChatGPT4.1"
    },
    "5157": {
      "id": 2596014,
      "text": "Ai cũng bắt đầu với những ý định tốt đẹp,",
      "author": "ChatGPT4.1"
    },
    "5158": {
      "id": 2596015,
      "text": "nhưng rất khó để gắn bó với chúng.",
      "author": "ChatGPT4.1"
    },
    "5160": {
      "id": 2596016,
      "text": "Tôi thấy rằng mình chỉ phá vỡ những quyết tâm ấy.",
      "author": "ChatGPT4.1"
    },
    "5162": {
      "id": 2596017,
      "text": "Tôi biết mình ăn quá nhiều đồ ngọt.",
      "author": "ChatGPT4.1"
    },
    "5163": {
      "id": 2596018,
      "text": "Mỗi ngày, tôi chỉ cố gắng cưỡng lại chúng.",
      "author": "ChatGPT4.1"
    },
    "5164": {
      "id": 2596019,
      "text": "Tôi nghĩ rằng mỗi ngày đều là một ngày mới, bất kể đó có phải ngày đầu năm mới hay không.",
      "author": "ChatGPT4.1"
    },
    "5165": {
      "id": 2596020,
      "text": "Thói xấu rất khó bỏ.",
      "author": "ChatGPT4.1"
    },
    "5166": {
      "id": 2596021,
      "text": "Điều tốt nhất là không bao giờ bắt đầu bất kỳ thói xấu nào.",
      "author": "ChatGPT4.1"
    },
    "5167": {
      "id": 2596022,
      "text": "Tôi không biết liệu anh trai mình có bao giờ thôi cắn móng tay không,",
      "author": "ChatGPT4.1"
    },
    "5168": {
      "id": 2596023,
      "text": "nhưng tôi biết rằng mỗi tháng Giêng anh ấy đều có ý định dừng lại.",
      "author": "ChatGPT4.1"
    },
    "5169": {
      "id": 2596024,
      "text": "Có thể một ngày đầu năm nào đó, anh ấy sẽ vượt qua được thói quen đó.",
      "author": "ChatGPT4.1"
    }
  }
}
