  "translations": {
    "5622": {
      "id": 2080046,
      "text": "vì vậy, bạn càng thuyết trình nhiều thì bạn sẽ càng giỏi hơn trong việc đó",
      "author": "a user"
    },
    "5631": {
      "id": 2080055,
      "text": "Đôi khi tôi cảm thấy một chút lo lắng thoáng qua.",
      "author": "a user"
    },
    "5633": {
      "id": 2082715,
      "text": "Việc phát biểu không hề đáng sợ như bạn nghĩ.",
      "author": "a user"
    },
    "5601": {
      "id": 2582523,
      "text": "Tôi đã phải phát biểu vào tuần trước.",
      "author": "ChatGPT4.1"
    },
    "5602": {
      "id": 2582524,
      "text": "Tôi đã phát biểu trước 300 người.",
      "author": "ChatGPT4.1"
    },
    "5603": {
      "id": 2582525,
      "text": "Tôi đã phải nói trước một nhóm sinh viên.",
      "author": "ChatGPT4.1"
    },
    "5604": {
      "id": 2582526,
      "text": "Tôi đã phải nói cho họ về một chiến dịch mà chúng tôi tổ chức để gây quỹ nghiên cứu ung thư.",
      "author": "ChatGPT4.1"
    },
    "5605": {
      "id": 2582527,
      "text": "Phát biểu trước đám đông có thể là một việc khó khăn.",
      "author": "ChatGPT4.1"
    },
    "5606": {
      "id": 2582528,
      "text": "Khi bạn đứng trước một đám đông lớn, bạn có thể rất hồi hộp.",
      "author": "ChatGPT4.1"
    },
    "5607": {
      "id": 2582529,
      "text": "Một số người cảm thấy như đầu gối mình yếu đi.",
      "author": "ChatGPT4.1"
    },
    "5608": {
      "id": 2582530,
      "text": "Chân họ cảm giác như làm bằng cao su vậy.",
      "author": "ChatGPT4.1"
    },
    "5609": {
      "id": 2582531,
      "text": "Tim họ đập rất mạnh trong lồng ngực.",
      "author": "ChatGPT4.1"
    },
    "5610": {
      "id": 2582532,
      "text": "Lòng bàn tay họ trở nên ướt đẫm mồ hôi.",
      "author": "ChatGPT4.1"
    },
    "5611": {
      "id": 2582533,
      "text": "Một số người còn cảm thấy khó thở.",
      "author": "ChatGPT4.1"
    },
    "5612": {
      "id": 2582534,
      "text": "Với một số người, phát biểu trước đám đông chính là nỗi sợ lớn nhất của họ.",
      "author": "a user"
    },
    "5613": {
      "id": 2582535,
      "text": "Khi bạn phát biểu, mọi người đều nhìn vào bạn.",
      "author": "ChatGPT4.1"
    },
    "5614": {
      "id": 2582536,
      "text": "Họ đang chờ để nghe xem bạn nói điều gì.",
      "author": "a user"
    },
    "5615": {
      "id": 2582537,
      "text": "Khi bạn có 300 người đang nhìn vào mình; bạn có 600 con mắt đang hướng về bạn.",
      "author": "ChatGPT4.1"
    },
    "5616": {
      "id": 2582538,
      "text": "Nghĩ như vậy thực sự hơi đáng sợ.",
      "author": "ChatGPT4.1"
    },
    "5617": {
      "id": 2582539,
      "text": "Trước khi phát biểu, tôi hít thở sâu ba lần.",
      "author": "ChatGPT4.1"
    },
    "5618": {
      "id": 2582540,
      "text": "Tôi trấn an bản thân và nhắc mình rằng điều mình sắp nói là quan trọng.",
      "author": "ChatGPT4.1"
    },
    "5619": {
      "id": 2582541,
      "text": "Tôi muốn chắc chắn về những gì mình sắp nói nên tôi luyện tập nói trước gương ở nhà.",
      "author": "a user"
    },
    "5620": {
      "id": 2582542,
      "text": "Tôi muốn trông thật thoải mái và thân thiện.",
      "author": "ChatGPT4.1"
    },
    "5621": {
      "id": 2582543,
      "text": "Người ta nói rằng luyện tập sẽ tạo nên sự hoàn hảo;",
      "author": "ChatGPT4.1"
    },
    "5623": {
      "id": 2582544,
      "text": "Mỗi khi phải phát biểu, tôi tưởng tượng cả khán phòng chỉ là một người lớn.",
      "author": "ChatGPT4.1"
    },
    "5624": {
      "id": 2582545,
      "text": "Tôi nhìn vào khán giả cho đến khi tìm thấy một khuôn mặt thân thiện, mỉm cười.",
      "author": "ChatGPT4.1"
    },
    "5625": {
      "id": 2582546,
      "text": "Tôi tập trung vào người đó,",
      "author": "ChatGPT4.1"
    },
    "5626": {
      "id": 2582547,
