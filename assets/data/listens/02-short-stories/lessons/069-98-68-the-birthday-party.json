  "translations": {
    "4032": {
      "id": 11127,
      "text": "Bạn tôi, Jane đã tổ chức sinh nhật lần thứ mười của cô ấy.",
      "author": "a user"
    },
    "4033": {
      "id": 11129,
      "text": "Ngôi nhà của cô ấy được trang trí với nhiều bóng bay và băng giấy màu.",
      "author": "a user"
    },
    "4037": {
      "id": 11149,
      "text": "Jane thổi nến và ước một điều ước.",
      "author": "a user"
    },
    "4047": {
      "id": 11180,
      "text": "Cô ấy có một số đĩa CD, một số quần áo và một số trò chơi máy tính.",
      "author": "a user"
    },
    "4050": {
      "id": 11192,
      "text": "Chúng tôi đã ăn bánh mì kẹp xúc xích",
      "author": "a user"
    },
    "4051": {
      "id": 11194,
      "text": "Tôi cho mù tạt và sốt cà chua vào bánh mì kẹp xúc xích của mình.",
      "author": "a user"
    },
    "4053": {
      "id": 11198,
      "text": "Chúng tôi đã có nước ngọt để uống.",
      "author": "a user"
    },
    "4031": {
      "id": 2606655,
      "text": "Hôm qua tôi đã đi dự một bữa tiệc sinh nhật.",
      "author": "ChatGPT4.1"
    },
    "4034": {
      "id": 2606656,
      "text": "Mẹ cô ấy đã nướng một chiếc bánh sinh nhật lớn.",
      "author": "ChatGPT4.1"
    },
    "4035": {
      "id": 2606657,
      "text": "Trên bánh có ghi dòng chữ \"Chúc mừng sinh nhật lần thứ mười, Jane\".",
      "author": "a user"
    },
    "4036": {
      "id": 2606658,
      "text": "Có mười cây nến trên bánh.",
      "author": "ChatGPT4.1"
    },
    "4038": {
      "id": 2606659,
      "text": "Tôi tự hỏi không biết cô ấy đã ước điều gì.",
      "author": "ChatGPT4.1"
    },
    "4039": {
      "id": 2606660,
      "text": "Điều ước sẽ không trở thành sự thật nếu bạn nói cho ai biết đó là gì.",
      "author": "ChatGPT4.1"
    },
    "4040": {
      "id": 2606661,
      "text": "Chúng tôi hát bài \"Chúc mừng sinh nhật\".",
      "author": "ChatGPT4.1"
    },
    "4041": {
      "id": 2606662,
      "text": "Chúng tôi đã chơi vài trò chơi ở bữa tiệc.",
      "author": "ChatGPT4.1"
    },
    "4042": {
      "id": 2606663,
      "text": "Tôi đã thắng một trò chơi nên tôi nhận được một phần thưởng.",
      "author": "ChatGPT4.1"
    },
    "4043": {
      "id": 2606664,
      "text": "Chúng tôi cũng bơi ở hồ bơi nhà Jane.",
      "author": "ChatGPT4.1"
    },
    "4044": {
      "id": 2606665,
      "text": "Jane mở quà của mình.",
      "author": "ChatGPT4.1"
    },
    "4045": {
      "id": 2606666,
      "text": "Những món quà được gói bằng giấy sáng màu và thắt nơ.",
      "author": "ChatGPT4.1"
    },
    "4046": {
      "id": 2606667,
      "text": "Cô ấy nhận được rất nhiều quà đẹp.",
      "author": "ChatGPT4.1"
    },
    "4048": {
      "id": 2606668,
      "text": "Jane đã cảm ơn mọi người.",
      "author": "ChatGPT4.1"
    },
    "4049": {
      "id": 2606669,
      "text": "Chúng tôi đã ăn rất nhiều món ăn ở bữa tiệc của Jane.",
      "author": "ChatGPT4.1"
    },
    "4052": {
      "id": 2606670,
      "text": "Sau đó chúng tôi ăn bánh và kem.",
      "author": "ChatGPT4.1"
    },
    "4054": {
      "id": 2606671,
      "text": "Tôi nghĩ mình đã ăn quá nhiều bánh và kem.",
      "author": "ChatGPT4.1"
    },
    "4055": {
      "id": 2606672,
      "text": "Tôi rất no khi bữa tiệc kết thúc.",
      "author": "ChatGPT4.1"
    },
    "4056": {
      "id": 2606673,
      "text": "Chúng tôi cảm ơn Jane và mẹ cô ấy trước khi tất cả về nhà.",
      "author": "ChatGPT4.1"
    },
    "4057": {
      "id": 2606674,
      "text": "Đó là một bữa tiệc rất tuyệt vời.",
      "author": "ChatGPT4.1"
    },
    "4058": {
      "id": 2606675,
      "text": "Ai cũng có một khoảng thời gian vui vẻ.",
      "author": "ChatGPT4.1"
    },
    "4059": {
      "id": 2606676,
      "text": "Tôi hy vọng Jane đã có một sinh nhật lần thứ mười thật hạnh phúc.",
      "author": "ChatGPT4.1"
    }
  }
}
