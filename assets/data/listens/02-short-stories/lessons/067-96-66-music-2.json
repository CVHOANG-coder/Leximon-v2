  "translations": {
    "3975": {
      "id": 6329,
      "text": "Gia đình tôi rất đam mê âm nhạc.",
      "author": "a user"
    },
    "3981": {
      "id": 6335,
      "text": "Tôi đã học sáo trong lớp học âm nhạc ở trường.",
      "author": "a user"
    },
    "3984": {
      "id": 6338,
      "text": "Tôi có giọng trầm",
      "author": "a user"
    },
    "3985": {
      "id": 6339,
      "text": "Chị gái tôi có chất giọng cao.",
      "author": "a user"
    },
    "3988": {
      "id": 6342,
      "text": "nhưng mẹ tôi nói rằng nó quá ồn ào.",
      "author": "a user"
    },
    "3991": {
      "id": 6346,
      "text": "Tôi muốn tham gia một ban nhạc rock.",
      "author": "a user"
    },
    "3993": {
      "id": 6368,
      "text": "Chị gái tôi là một người chơi piano rất giỏi.",
      "author": "a user"
    },
    "3996": {
      "id": 6376,
      "text": "nhưng đôi khi tôi rủ cô ấy chơi nhạc rock với tôi.",
      "author": "a user"
    },
    "4005": {
      "id": 6409,
      "text": "Có thể một ngày nào đó chúng tôi sẽ thành lập ban nhạc rock của riêng mình,",
      "author": "a user"
    },
    "3976": {
      "id": 2589566,
      "text": "Bố tôi chơi đàn guitar.",
      "author": "ChatGPT4.1"
    },
    "3977": {
      "id": 2589567,
      "text": "Ông ấy chơi trong một ban nhạc.",
      "author": "ChatGPT4.1"
    },
    "3978": {
      "id": 2589568,
      "text": "Ban nhạc chơi nhạc đồng quê.",
      "author": "ChatGPT4.1"
    },
    "3979": {
      "id": 2589569,
      "text": "Mẹ tôi là ca sĩ trong ban nhạc.",
      "author": "ChatGPT4.1"
    },
    "3980": {
      "id": 2589570,
      "text": "Bà ấy cũng chơi đàn piano.",
      "author": "ChatGPT4.1"
    },
    "3982": {
      "id": 2589571,
      "text": "Tôi thổi sáo trong dàn nhạc của trường.",
      "author": "ChatGPT4.1"
    },
    "3983": {
      "id": 2589572,
      "text": "Tôi cũng hát trong dàn hợp xướng của trường.",
      "author": "ChatGPT4.1"
    },
    "3986": {
      "id": 2589573,
      "text": "Chị ấy là giọng nữ cao.",
      "author": "ChatGPT4.1"
    },
    "3987": {
      "id": 2589574,
      "text": "Ở nhà, tôi thích tập chơi trống,",
      "author": "a user"
    },
    "3989": {
      "id": 2589575,
      "text": "Có lúc tôi chơi mạnh đến mức gãy cả dùi trống.",
      "author": "ChatGPT4.1"
    },
    "3990": {
      "id": 2589576,
      "text": "Tôi luyện tập mỗi khi mẹ ra ngoài.",
      "author": "ChatGPT4.1"
    },
    "3992": {
      "id": 2589577,
      "text": "Một số bạn và tôi đang nghĩ đến việc thành lập một ban nhạc rock riêng.",
      "author": "ChatGPT4.1"
    },
    "3994": {
      "id": 2589578,
      "text": "Chị ấy đã giành được nhiều giải thưởng tại các lễ hội âm nhạc.",
      "author": "ChatGPT4.1"
    },
    "3995": {
      "id": 2589579,
      "text": "Chị ấy thích chơi nhạc cổ điển,",
      "author": "ChatGPT4.1"
    },
    "3997": {
      "id": 2589580,
      "text": "Chị ấy cũng là một ca sĩ rất giỏi.",
      "author": "ChatGPT4.1"
    },
    "3998": {
      "id": 2589581,
      "text": "Tôi thích hát cùng chị ấy.",
      "author": "ChatGPT4.1"
    },
    "3999": {
      "id": 2589582,
      "text": "Chúng tôi hát hòa âm với nhau.",
      "author": "ChatGPT4.1"
    },
    "4000": {
      "id": 2589583,
      "text": "Tôi nghe nhạc trên radio suốt thời gian.",
      "author": "ChatGPT4.1"
    },
    "4001": {
      "id": 2589584,
      "text": "Tôi biết rất nhiều bài hát.",
      "author": "ChatGPT4.1"
    },
    "4002": {
      "id": 2589585,
      "text": "Tôi có thể hát theo hầu hết các bài hát trên radio.",
      "author": "ChatGPT4.1"
    },
    "4003": {
      "id": 2589586,
      "text": "Tôi nhớ lời các bài hát.",
      "author": "ChatGPT4.1"
    },
    "4004": {
      "id": 2589587,
      "text": "Thỉnh thoảng tôi và chị tôi tụ họp và hát những bài hát yêu thích của chúng tôi.",
      "author": "ChatGPT4.1"
    },
    "4006": {
      "id": 2591397,
      "text": "và tôi sẽ là tay trống.",
      "author": "ChatGPT4.1"
    }
  }
}
