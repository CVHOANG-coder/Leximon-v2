  "translations": {
    "3904": {
      "id": 2776,
      "text": "Có hai giới tính.",
      "author": "a user"
    },
    "3906": {
      "id": 2784,
      "text": "Nam giới và nữ giới thì khác nhau, cả về thể chất lẫn tinh thần.",
      "author": "a user"
    },
    "3907": {
      "id": 2791,
      "text": "Con người có cả nam và nữ, và động vật có đực và cái.",
      "author": "a user"
    },
    "3908": {
      "id": 2792,
      "text": "Nếu bạn nuôi chó, thì đó hoặc là chó cái hoặc là chó đực.",
      "author": "a user"
    },
    "3910": {
      "id": 2795,
      "text": "Đàn ông mọc râu trên mặt.",
      "author": "a user"
    },
    "3913": {
      "id": 2800,
      "text": "Đàn ông là giống đực. Giống đực thì nam tính.",
      "author": "a user"
    },
    "3916": {
      "id": 2809,
      "text": "Phụ nữ là phái nữ. Phái nữ thì nữ tính.",
      "author": "a user"
    },
    "3917": {
      "id": 2814,
      "text": "Một từ khác dành cho phụ nữ là quý cô.",
      "author": "a user"
    },
    "3918": {
      "id": 2815,
      "text": "Thật tốt là chúng ta có giới tính nam và giới tính nữ.",
      "author": "a user"
    },
    "3905": {
      "id": 2594214,
      "text": "Có giới nam và có giới nữ.",
      "author": "ChatGPT4.1"
    },
    "3909": {
      "id": 2594215,
      "text": "Con trai lớn lên trở thành đàn ông.",
      "author": "ChatGPT4.1"
    },
    "3911": {
      "id": 2594216,
      "text": "Đàn ông thường có nhiều cơ bắp hơn phụ nữ.",
      "author": "ChatGPT4.1"
    },
    "3912": {
      "id": 2594217,
      "text": "Đàn ông mặc khác phụ nữ.",
      "author": "ChatGPT4.1"
    },
    "3914": {
      "id": 2594218,
      "text": "Con gái lớn lên trở thành phụ nữ.",
      "author": "ChatGPT4.1"
    },
    "3915": {
      "id": 2594219,
      "text": "Chỉ có phụ nữ mới có thể sinh con.",
      "author": "ChatGPT4.1"
    },
    "3919": {
      "id": 2594220,
      "text": "Cha của bạn là nam giới.",
      "author": "ChatGPT4.1"
    },
    "3920": {
      "id": 2594221,
      "text": "Ông, anh/em trai và chú/bác/cậu của bạn là nam giới.",
      "author": "ChatGPT4.1"
    },
    "3921": {
      "id": 2594222,
      "text": "Mẹ của bạn là nữ giới.",
      "author": "ChatGPT4.1"
    },
    "3922": {
      "id": 2594223,
      "text": "Bà, chị/em gái và cô/dì/thím của bạn là nữ giới.",
      "author": "ChatGPT4.1"
    }
  }
}
