  "translations": {
    "1666": {
      "id": 9660,
      "text": "Cổ tôi nâng đỡ đầu tôi",
      "author": "a user"
    },
    "1667": {
      "id": 9667,
      "text": "Cổ tôi nối đầu với ngực tôi",
      "author": "a user"
    },
    "1674": {
      "id": 10061,
      "text": "Lưng của tôi là ở phía sau tôi.",
      "author": "a user"
    },
    "1675": {
      "id": 10063,
      "text": "Xuống dưới nữa, là eo của tôi",
      "author": "a user"
    },
    "1676": {
      "id": 10064,
      "text": "Nếu tôi đeo thắt lưng, tôi đeo nó vào eo của tôi.",
      "author": "a user"
    },
    "1678": {
      "id": 10066,
      "text": "Từ hông đi xuống là chân của tôi",
      "author": "a user"
    },
    "1680": {
      "id": 10071,
      "text": "Đầu gối tôi có thể gập lại",
      "author": "a user"
    },
    "1685": {
      "id": 10083,
      "text": "Tôi là chính tôi từ đỉnh đầu đến đầu ngón chân",
      "author": "a user"
    },
    "1655": {
      "id": 2587037,
      "text": "Trên đỉnh đầu của tôi có tóc.",
      "author": "a user"
    },
    "1656": {
      "id": 2587038,
      "text": "Bên dưới tóc của tôi là khuôn mặt của tôi.",
      "author": "ChatGPT4.1"
    },
    "1657": {
      "id": 2587039,
      "text": "Tôi có hai mắt.",
      "author": "ChatGPT4.1"
    },
    "1658": {
      "id": 2587040,
      "text": "Tôi có lông mày và lông mi.",
      "author": "ChatGPT4.1"
    },
    "1659": {
      "id": 2587041,
      "text": "Bên dưới mắt tôi có một cái mũi.",
      "author": "a user"
    },
    "1660": {
      "id": 2587042,
      "text": "Miệng của tôi ở dưới mũi.",
      "author": "ChatGPT4.1"
    },
    "1661": {
      "id": 2587043,
      "text": "Tôi có đôi môi.",
      "author": "ChatGPT4.1"
    },
    "1662": {
      "id": 2587044,
      "text": "Nếu tôi mở môi ra, bạn sẽ thấy răng và lưỡi của tôi.",
      "author": "ChatGPT4.1"
    },
    "1663": {
      "id": 2587045,
      "text": "Dưới miệng của tôi là cằm.",
      "author": "ChatGPT4.1"
    },
    "1664": {
      "id": 2587046,
      "text": "Hai bên đầu tôi, tôi có hai tai.",
      "author": "ChatGPT4.1"
    },
    "1665": {
      "id": 2587047,
      "text": "Má của tôi ở hai bên mũi.",
      "author": "ChatGPT4.1"
    },
    "1668": {
      "id": 2587048,
      "text": "Hai bên ngực của tôi là vai.",
      "author": "ChatGPT4.1"
    },
    "1669": {
      "id": 2587049,
      "text": "Tay tôi thả xuống từ vai.",
      "author": "ChatGPT4.1"
    },
    "1670": {
      "id": 2587050,
      "text": "Tôi có cổ tay trên cánh tay của mình.",
      "author": "ChatGPT4.1"
    },
    "1671": {
      "id": 2587051,
      "text": "Bàn tay của tôi gắn vào cổ tay.",
      "author": "ChatGPT4.1"
    },
    "1672": {
      "id": 2587052,
      "text": "Ngón tay là một phần của bàn tay tôi.",
      "author": "ChatGPT4.1"
    },
    "1673": {
      "id": 2587053,
      "text": "Tôi có mười ngón tay và mười móng tay.",
      "author": "ChatGPT4.1"
    },
    "1677": {
      "id": 2587054,
      "text": "Hông của tôi ở dưới eo tôi.",
      "author": "ChatGPT4.1"
    },
    "1679": {
      "id": 2587055,
      "text": "Chân của tôi gồm có đùi, đầu gối và bắp chân.",
      "author": "ChatGPT4.1"
    },
    "1681": {
      "id": 2587056,
      "text": "Mắt cá chân của tôi ở dưới chân.",
      "author": "ChatGPT4.1"
    },
    "1682": {
      "id": 2587057,
      "text": "Bàn chân của tôi nối với mắt cá chân.",
      "author": "ChatGPT4.1"
    },
    "1683": {
      "id": 2587058,
      "text": "Ngón chân là một phần của bàn chân tôi.",
      "author": "ChatGPT4.1"
    },
    "1684": {
      "id": 2587059,
      "text": "Tôi có mười ngón chân và mười móng chân.",
      "author": "ChatGPT4.1"
    }
  }
