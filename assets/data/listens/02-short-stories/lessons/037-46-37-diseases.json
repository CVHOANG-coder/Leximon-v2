  "translations": {
    "1603": {
      "id": 2588406,
      "text": "Có nhiều loại bệnh.",
      "author": "ChatGPT4.1"
    },
    "1604": {
      "id": 2588407,
      "text": "Một số bệnh rất nguy hiểm, và một số thì không nghiêm trọng lắm.",
      "author": "ChatGPT4.1"
    },
    "1605": {
      "id": 2588408,
      "text": "Hầu hết mọi người đôi khi bị cảm lạnh.",
      "author": "ChatGPT4.1"
    },
    "1606": {
      "id": 2588409,
      "text": "Cảm lạnh khiến bạn ho và hắt hơi.",
      "author": "ChatGPT4.1"
    },
    "1607": {
      "id": 2588410,
      "text": "Cảm lạnh có thể lây truyền từ người này sang người khác.",
      "author": "ChatGPT4.1"
    },
    "1608": {
      "id": 2588411,
      "text": "Một số người bị cúm.",
      "author": "ChatGPT4.1"
    },
    "1609": {
      "id": 2588412,
      "text": "Khi bị cúm, bạn sẽ bị ớn lạnh và sốt.",
      "author": "ChatGPT4.1"
    },
    "1610": {
      "id": 2588413,
      "text": "Sốt là nhiệt độ cơ thể cao.",
      "author": "ChatGPT4.1"
    },
    "1611": {
      "id": 2588414,
      "text": "Nếu bị cúm, bạn sẽ cảm thấy rất mệt mỏi.",
      "author": "ChatGPT4.1"
    },
    "1612": {
      "id": 2588415,
      "text": "Bạn phải ở nhà nằm nghỉ trên giường.",
      "author": "ChatGPT4.1"
    },
    "1613": {
      "id": 2588416,
      "text": "Có những căn bệnh mà trẻ em mắc phải.",
      "author": "ChatGPT4.1"
    },
    "1614": {
      "id": 2588417,
      "text": "Bệnh quai bị khiến bạn bị nổi các cục sưng ở cổ.",
      "author": "a user"
    },
    "1615": {
      "id": 2588418,
      "text": "Bệnh thủy đậu và sởi khiến bạn có các chấm đỏ ngứa trên da.",
      "author": "ChatGPT4.1"
    },
    "1616": {
      "id": 2588419,
      "text": "Người già đôi khi bị viêm khớp.",
      "author": "ChatGPT4.1"
    },
    "1617": {
      "id": 2588420,
      "text": "Xương của họ trở nên cứng và đau.",
      "author": "ChatGPT4.1"
    },
    "1618": {
      "id": 2588421,
      "text": "Có những người mắc bệnh tim.",
      "author": "ChatGPT4.1"
    },
    "1619": {
      "id": 2588422,
      "text": "Trong nhiều trường hợp, lối sống lành mạnh có thể phòng ngừa bệnh tim.",
      "author": "ChatGPT4.1"
    },
    "1620": {
      "id": 2588423,
      "text": "Ung thư có thể tấn công các bộ phận khác nhau của cơ thể.",
      "author": "ChatGPT4.1"
    },
    "1621": {
      "id": 2588424,
      "text": "Nhiều người hút thuốc bị ung thư phổi.",
      "author": "ChatGPT4.1"
    },
    "1622": {
      "id": 2588425,
      "text": "Một số bệnh được điều trị bằng thuốc viên hoặc thuốc uống.",
      "author": "ChatGPT4.1"
    },
    "1623": {
      "id": 2588426,
      "text": "Một số bệnh khác cần được điều trị tại bệnh viện.",
      "author": "ChatGPT4.1"
    },
    "1624": {
      "id": 2588427,
      "text": "Đôi khi bác sĩ cần làm xét nghiệm để biết bạn mắc loại bệnh gì.",
      "author": "ChatGPT4.1"
    },
    "1625": {
      "id": 2588428,
      "text": "Bác sĩ có thể phải làm xét nghiệm máu hoặc chụp X-quang để biết bạn bị gì.",
      "author": "ChatGPT4.1"
    },
    "1626": {
      "id": 2588429,
      "text": "Hầu hết các bệnh đều có thể được chữa khỏi bởi bác sĩ.",
      "author": "ChatGPT4.1"
    }
  }
