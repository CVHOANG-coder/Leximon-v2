  "translations": {
    "5843": {
      "id": 27619,
      "text": "Tôi lúc nào cũng làm những việc vụng về",
      "author": "a user"
    },
    "5846": {
      "id": 27642,
      "text": "Tôi chắc chắn sẽ vấp phải nó và ngã xuống.",
      "author": "a user"
    },
    "5847": {
      "id": 27644,
      "text": "Nếu tôi mang một đĩa thức ăn trong căng tin,",
      "author": "a user"
    },
    "5848": {
      "id": 27646,
      "text": "Tôi hầu như luôn đánh rơi nó hoặc va vào ai đó.",
      "author": "a user"
    },
    "5850": {
      "id": 27649,
      "text": "Khi uống nước trái cây, tôi uống bị rớt làm nước ép dính đầy lên áo.",
      "author": "a user"
    },
    "5853": {
      "id": 27652,
      "text": "Cái lọ bay ra khỏi tay tôi và rớt lộn ngược trên sàn.",
      "author": "a user"
    },
    "5856": {
      "id": 27658,
      "text": "Có một mớ hỗn độn lớn dính trên sàn nhà.",
      "author": "a user"
    },
    "5857": {
      "id": 27659,
      "text": "Tôi va đầu vào xe khi lên xe.",
      "author": "a user"
    },
    "5858": {
      "id": 27660,
      "text": "Tôi rách quần vì nhiều thứ.",
      "author": "a user"
    },
    "5859": {
      "id": 27661,
      "text": "Tôi đánh rơi tiền ra khỏi túi",
      "author": "a user"
    },
    "5864": {
      "id": 27667,
      "text": "Bố mẹ bảo tôi đi chậm lại.",
      "author": "a user"
    },
    "5840": {
      "id": 2586923,
      "text": "Mẹ tôi nói rằng tôi vụng về.",
      "author": "ChatGPT4.1"
    },
    "5841": {
      "id": 2586924,
      "text": "Bố tôi nói rằng tôi vụng về.",
      "author": "ChatGPT4.1"
    },
    "5842": {
      "id": 2586925,
      "text": "Tôi biết là tôi vụng về.",
      "author": "ChatGPT4.1"
    },
    "5844": {
      "id": 2586926,
      "text": "Tôi ngã mà không có lý do gì cả.",
      "author": "ChatGPT4.1"
    },
    "5845": {
      "id": 2586927,
      "text": "Nếu có một vết nứt trên vỉa hè,",
      "author": "ChatGPT4.1"
    },
    "5849": {
      "id": 2586928,
      "text": "Tôi không cố ý làm những điều này, nó chỉ tự xảy ra thôi.",
      "author": "ChatGPT4.1"
    },
    "5851": {
      "id": 2586929,
      "text": "Tôi lúc nào cũng có gì đó đổ lên quần áo mình.",
      "author": "ChatGPT4.1"
    },
    "5852": {
      "id": 2586930,
      "text": "Tuần trước tôi mở một hũ bơ đậu phộng.",
      "author": "ChatGPT4.1"
    },
    "5854": {
      "id": 2586931,
      "text": "Có một cục bơ đậu phộng lớn trên sàn.",
      "author": "ChatGPT4.1"
    },
    "5855": {
      "id": 2586932,
      "text": "Hôm qua tôi làm đổ bát đựng đường.",
      "author": "a user"
    },
    "5860": {
      "id": 2586933,
      "text": "Tôi dẫm lên đuôi con mèo.",
      "author": "ChatGPT4.1"
    },
    "5861": {
      "id": 2586934,
      "text": "Tôi luôn cảm thấy tệ khi làm thế vì con mèo nghĩ tôi không yêu nó.",
      "author": "ChatGPT4.1"
    },
    "5862": {
      "id": 2586935,
      "text": "Tôi không cố ý làm những điều này.",
      "author": "ChatGPT4.1"
    },
    "5863": {
      "id": 2586936,
      "text": "Tôi chỉ là một người vụng về.",
      "author": "ChatGPT4.1"
    },
    "5865": {
      "id": 2586937,
      "text": "Tôi lúc nào cũng vội vàng;",
      "author": "ChatGPT4.1"
    },
    "5866": {
      "id": 2586938,
      "text": "có lẽ đó là lý do tôi vụng về như vậy.",
      "author": "ChatGPT4.1"
    },
    "5867": {
      "id": 2586939,
      "text": "Có thể đây chỉ là giai đoạn tôi đang trải qua.",
      "author": "ChatGPT4.1"
    },
    "5868": {
      "id": 2586940,
      "text": "Nếu đúng như thế, tôi hy vọng nó sẽ sớm kết thúc.",
      "author": "ChatGPT4.1"
    },
    "5869": {
      "id": 2586941,
      "text": "Vụng về chẳng vui chút nào.",
      "author": "ChatGPT4.1"
    }
  }
}
