  "translations": {
    "3794": {
      "id": 15277,
      "text": "Ai sẽ cùng tôi đi xem trận đấu?",
      "author": "a user"
    },
    "3796": {
      "id": 15281,
      "text": "\"What\" là về một sự vật.",
      "author": "a user"
    },
    "3797": {
      "id": 15282,
      "text": "Thứ to lớn trên vỉa hè đó là gì?",
      "author": "a user"
    },
    "3799": {
      "id": 15286,
      "text": "Loại quần áo nào tôi nên mặc đến bữa tiệc?",
      "author": "a user"
    },
    "3800": {
      "id": 15288,
      "text": "Tôi nên mua gì cho ngày sinh nhật của bạn?",
      "author": "a user"
    },
    "3802": {
      "id": 15291,
      "text": "Bạn sẽ đi đâu trong kỳ nghỉ của bạn?",
      "author": "a user"
    },
    "3806": {
      "id": 15296,
      "text": "\"Why\" là từ dùng để yêu cầu lời giải thích.",
      "author": "a user"
    },
    "3808": {
      "id": 15300,
      "text": "Tại sao Trái Đất lại là hình tròn?",
      "author": "a user"
    },
    "3809": {
      "id": 15301,
      "text": "Tại sao tôi nên đưa cho bạn tiền?\n",
      "author": "a user"
    },
    "3789": {
      "id": 2583873,
      "text": "Đây là những từ quan trọng.",
      "author": "ChatGPT4.1"
    },
    "3790": {
      "id": 2583874,
      "text": "Chúng đều là những từ bắt đầu cho các câu hỏi.",
      "author": "ChatGPT4.1"
    },
    "3791": {
      "id": 2583875,
      "text": "“Từ ‘Ai’” là về một người.",
      "author": "a user"
    },
    "3792": {
      "id": 2583876,
      "text": "Cô gái mặc chiếc váy xanh dương là ai vậy?",
      "author": "a user"
    },
    "3793": {
      "id": 2583877,
      "text": "Ai đã lấy trộm đồng hồ của tôi?",
      "author": "ChatGPT4.1"
    },
    "3795": {
      "id": 2583878,
      "text": "Ai sẽ lái xe đưa chúng ta tới bữa tiệc?",
      "author": "ChatGPT4.1"
    },
    "3798": {
      "id": 2583879,
      "text": "Tôi nên làm gì khi đến nhà bạn?",
      "author": "ChatGPT4.1"
    },
    "3801": {
      "id": 2583880,
      "text": "\"Where\" (ở đâu) nói về một địa điểm.",
      "author": "a user"
    },
    "3803": {
      "id": 2583881,
      "text": "Tôi đã để kính của mình ở đâu?",
      "author": "ChatGPT4.1"
    },
    "3804": {
      "id": 2583882,
      "text": "Anh trai tôi đã đi đâu rồi?",
      "author": "a user"
    },
    "3805": {
      "id": 2583883,
      "text": "Timmins nằm ở đâu vậy?",
      "author": "a user"
    },
    "3807": {
      "id": 2583884,
      "text": "Tại sao bạn lại lấy miếng bánh cuối cùng?",
      "author": "ChatGPT4.1"
    },
    "3810": {
      "id": 2583885,
      "text": "Tại sao con gà lại băng qua đường?",
      "author": "ChatGPT4.1"
    },
    "3811": {
      "id": 2583886,
      "text": "Người ta nói rằng bạn nên trả lời tất cả các câu hỏi này nếu muốn viết một câu chuyện hay.",
      "author": "ChatGPT4.1"
    },
    "3812": {
      "id": 2583887,
      "text": "Bạn phải đưa ra ‘ai, cái gì, ở đâu và tại sao’ để viết một câu chuyện hay.",
      "author": "ChatGPT4.1"
    }
  }
