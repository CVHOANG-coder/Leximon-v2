  "translations": {
    "7037": {
      "id": 64049,
      "text": "Gió bắt đầu gào rú, và những cái cây rung lắc rồi uốn cong trong gió.",
      "author": "a user"
    },
    "7038": {
      "id": 64058,
      "text": "Sấm sét bắt đầu lóe lên trên bầu trời.",
      "author": "a user"
    },
    "7040": {
      "id": 64070,
      "text": "Tôi liếc nhìn quanh phòng mình.",
      "author": "a user"
    },
    "7044": {
      "id": 64083,
      "text": "Tôi nhìn xuống gầm giường để chắc chắn rằng không có gì ở dưới đó.",
      "author": "a user"
    },
    "7045": {
      "id": 64085,
      "text": "Tôi trốn dưới tấm chăn và lén nhìn ra ngoài.",
      "author": "a user"
    },
    "7047": {
      "id": 64467,
      "text": "Một tia sét lớn lóe lên trên bầu trời,",
      "author": "a user"
    },
    "7048": {
      "id": 64473,
      "text": "và một tiếng sấm lớn làm tôi giật mình.",
      "author": "a user"
    },
    "7051": {
      "id": 64479,
      "text": "Nó phát ra từ tủ quần áo của tôi.",
      "author": "a user"
    },
    "7053": {
      "id": 64485,
      "text": "Tôi nhìn ra ngoài từ trong chăn và đợi con ma xuất hiện.",
      "author": "a user"
    },
    "7058": {
      "id": 64510,
      "text": "Tôi quan sát tủ quần áo và hy vọng rằng con ma sẽ không bay ra đến chỗ tôi.",
      "author": "a user"
    },
    "7069": {
      "id": 64539,
      "text": "Tôi cười và cảm thấy mình thật ngu ngốc.",
      "author": "a user"
    },
    "7035": {
      "id": 2618703,
      "text": "Một đêm tối tăm và u ám, tôi đang ngồi trong phòng ngủ của mình đọc truyện ma.",
      "author": "ChatGPT4.1"
    },
    "7036": {
      "id": 2618704,
      "text": "Những câu chuyện đó rất đáng sợ. Một cơn bão đang hình thành bên ngoài cửa sổ của tôi.",
      "author": "ChatGPT4.1"
    },
    "7039": {
      "id": 2618705,
      "text": "Tôi cảm thấy bất an khi nghe tiếng sấm rền từ xa.",
      "author": "ChatGPT4.1"
    },
    "7041": {
      "id": 2618706,
      "text": "Những bóng tối thật dày đặc và u ám.",
      "author": "ChatGPT4.1"
    },
    "7042": {
      "id": 2618707,
      "text": "Mấy câu chuyện ma cứ làm tôi tưởng tượng lung tung rồi tự dọa chính mình thôi.",
      "author": "a user"
    },
    "7043": {
      "id": 2618708,
      "text": "Tôi tưởng những cái bóng đang di chuyển.",
      "author": "ChatGPT4.1"
    },
    "7046": {
      "id": 2618709,
      "text": "Tôi bắt đầu nghe thấy những điều kỳ lạ.",
      "author": "ChatGPT4.1"
    },
    "7049": {
      "id": 2618710,
      "text": "Tôi cực kỳ lo lắng.",
      "author": "ChatGPT4.1"
    },
    "7050": {
      "id": 2618711,
      "text": "Đột nhiên, tôi nghe thấy một tiếng động.",
      "author": "ChatGPT4.1"
    },
    "7052": {
      "id": 2618712,
      "text": "Tôi nghĩ chắc chắn đó là một con ma.",
      "author": "ChatGPT4.1"
    },
    "7054": {
      "id": 2618713,
      "text": "Mặt tôi tái mét, và tôi cảm thấy vô cùng sợ hãi.",
      "author": "ChatGPT4.1"
    },
    "7055": {
      "id": 2618714,
      "text": "Rồi, tôi lại nghe thấy tiếng động đó lần nữa.",
      "author": "ChatGPT4.1"
    },
    "7056": {
      "id": 2618715,
      "text": "Đúng vậy, chắc chắn có tiếng sột soạt trong tủ quần áo của tôi.",
      "author": "ChatGPT4.1"
    },
    "7057": {
      "id": 2618716,
      "text": "Tôi nằm yên bất động và không dám phát ra tiếng động nào.",
      "author": "ChatGPT4.1"
    },
    "7059": {
      "id": 2618717,
      "text": "Có thứ gì đó bắt đầu trườn ra khỏi tủ.",
      "author": "ChatGPT4.1"
    },
    "7060": {
      "id": 2618718,
      "text": "Tôi nhắm chặt mắt lại.",
      "author": "ChatGPT4.1"
    },
    "7061": {
      "id": 2618719,
      "text": "Tôi không dám nhìn vào con ma.",
      "author": "ChatGPT4.1"
    },
    "7062": {
      "id": 2618720,
      "text": "Tôi nghe thấy nó ra khỏi tủ.",
      "author": "ChatGPT4.1"
    },
    "7063": {
      "id": 2618721,
      "text": "Tôi cảm giác nó nhảy lên giường của tôi.",
      "author": "ChatGPT4.1"
    },
    "7064": {
      "id": 2618722,
      "text": "Tôi vẫn quá sợ hãi để dám nhìn.",
      "author": "ChatGPT4.1"
    },
    "7065": {
      "id": 2639041,
      "text": "Rồi con ma phát ra một tiếng động.",
      "author": "ChatGPT4.1"
    },
