  "translations": {
    "5250": {
      "id": 2082894,
      "text": "Tôi sẽ ngủ rất nhiều, vì tôi sẽ không cảm thấy khoẻ lắm trong vài ngày",
      "author": "a user"
    },
    "5225": {
      "id": 2599629,
      "text": "Tôi phải cắt amidan.",
      "author": "ChatGPT4.1"
    },
    "5226": {
      "id": 2599630,
      "text": "Tôi không thực sự vui về điều đó, nhưng tôi đã mệt mỏi vì bị bệnh và đau họng.",
      "author": "ChatGPT4.1"
    },
    "5227": {
      "id": 2599631,
      "text": "Tôi phải đến bệnh viện trước ca phẫu thuật hai tiếng.",
      "author": "ChatGPT4.1"
    },
    "5228": {
      "id": 2599632,
      "text": "Mẹ tôi sẽ đi cùng tôi.",
      "author": "ChatGPT4.1"
    },
    "5229": {
      "id": 2599633,
      "text": "Y tá sẽ đo thân nhiệt và kiểm tra huyết áp cho tôi.",
      "author": "a user"
    },
    "5230": {
      "id": 2599634,
      "text": "Họ sẽ đảm bảo rằng tôi đã sẵn sàng cho ca phẫu thuật.",
      "author": "ChatGPT4.1"
    },
    "5231": {
      "id": 2599635,
      "text": "Tôi sẽ được mặc một chiếc áo choàng trắng, và tôi sẽ được đẩy xuống hành lang đến phòng mổ.",
      "author": "a user"
    },
    "5232": {
      "id": 2599636,
      "text": "Tôi không được ăn uống gì trong một thời gian dài trước khi phẫu thuật.",
      "author": "ChatGPT4.1"
    },
    "5233": {
      "id": 2599637,
      "text": "Mẹ tôi sẽ bước cùng tôi xuống hành lang;",
      "author": "ChatGPT4.1"
    },
    "5234": {
      "id": 2599638,
      "text": "sau đó mẹ sẽ vẫy tay tạm biệt tôi khi họ đẩy tôi vào phòng phẫu thuật.",
      "author": "a user"
    },
    "5235": {
      "id": 2599639,
      "text": "Bác sĩ và y tá sẽ rất bận rộn trong phòng mổ.",
      "author": "ChatGPT4.1"
    },
    "5236": {
      "id": 2599640,
      "text": "Họ sẽ chuẩn bị để tiến hành ca phẫu thuật cho tôi.",
      "author": "ChatGPT4.1"
    },
    "5237": {
      "id": 2599641,
      "text": "Bác sĩ sẽ chào tôi và nói rằng ông ấy sẽ gây mê để tôi ngủ.",
      "author": "a user"
    },
    "5238": {
      "id": 2599642,
      "text": "Ông ấy sẽ tiêm thứ gì đó vào tay tôi.",
      "author": "ChatGPT4.1"
    },
    "5239": {
      "id": 2599643,
      "text": "Ông ấy sẽ bảo tôi đếm ngược từ mười.",
      "author": "ChatGPT4.1"
    },
    "5240": {
      "id": 2599644,
      "text": "Tôi nghĩ là tôi sẽ chỉ kịp nói \"mười, chín\" và sau đó sẽ ngủ ngay.",
      "author": "a user"
    },
    "5241": {
      "id": 2599645,
      "text": "Tôi sẽ không tỉnh khi phẫu thuật diễn ra.",
      "author": "ChatGPT4.1"
    },
    "5242": {
      "id": 2599646,
      "text": "Khi tỉnh lại, tôi sẽ ngạc nhiên vì ca phẫu thuật đã xong.",
      "author": "ChatGPT4.1"
    },
    "5243": {
      "id": 2599647,
      "text": "Họng tôi sẽ đau, và tôi có lẽ sẽ cảm thấy không ổn.",
      "author": "a user"
    },
    "5244": {
      "id": 2599648,
      "text": "Mẹ tôi sẽ ở bên tôi.",
      "author": "ChatGPT4.1"
    },
    "5245": {
      "id": 2599649,
      "text": "Các y tá sẽ đưa tôi nước để uống và cố gắng làm tôi cảm thấy thoải mái.",
      "author": "a user"
    },
    "5246": {
      "id": 2599650,
      "text": "Tôi sẽ không phải ở lại bệnh viện qua đêm.",
      "author": "ChatGPT4.1"
    },
    "5247": {
      "id": 2599651,
      "text": "Tôi sẽ về nhà vào cuối ngày.",
      "author": "ChatGPT4.1"
    },
    "5248": {
      "id": 2599652,
      "text": "Bố mẹ tôi sẽ phải đảm bảo rằng tôi uống đủ nước.",
      "author": "ChatGPT4.1"
    },
    "5249": {
      "id": 2599653,
      "text": "Tôi không được ăn các thức ăn cứng nếu không sẽ làm họng tôi đau.",
      "author": "ChatGPT4.1"
    },
    "5251": {
      "id": 2599654,
      "text": "Tôi sẽ hồi phục sau phẫu thuật trong thời gian ngắn.",
      "author": "ChatGPT4.1"
    },
    "5252": {
      "id": 2599655,
      "text": "Đôi khi chúng ta cần phẫu thuật để cảm thấy tốt hơn.",
      "author": "ChatGPT4.1"
    },
    "5253": {
      "id": 2599656,
      "text": "Bệnh viện có thể hơi đáng sợ,",
      "author": "ChatGPT4.1"
    },
    "5254": {
      "id": 2599657,
      "text": "nhưng các bác sĩ và y tá đều rất dễ mến, và công việc của họ là giúp bạn khỏe lại.",
      "author": "ChatGPT4.1"
    }
  }
}
