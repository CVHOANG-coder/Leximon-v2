  "translations": {
    "5035": {
      "id": 54147,
      "text": "Nếu muốn tắm thì chúng ta đóng rèm.",
      "author": "a user"
    },
    "5037": {
      "id": 54150,
      "text": "Xà phòng được dùng để tắm rửa",
      "author": "a user"
    },
    "5040": {
      "id": 54158,
      "text": "Có khăn lau hoặc khăn rửa mặt để bạn dùng khi vệ sinh cá nhân",
      "author": "a user"
    },
    "5044": {
      "id": 54173,
      "text": "Có một cái bồn cầu trong phòng tắm.",
      "author": "a user"
    },
    "5050": {
      "id": 54184,
      "text": "Mẹ tôi thích trang điểm đậm trên mặt.",
      "author": "a user"
    },
    "5051": {
      "id": 54187,
      "text": "Ngoài ra còn có keo xịt tóc và keo vuốt tóc.",
      "author": "a user"
    },
    "5054": {
      "id": 54193,
      "text": "Chúng tôi chỉ có một phòng tắm, vì vậy chúng tôi xếp hàng để sử dụng.",
      "author": "a user"
    },
    "5032": {
      "id": 2626908,
      "text": "Có một bồn tắm trong phòng tắm của tôi.",
      "author": "ChatGPT4.1"
    },
    "5033": {
      "id": 2626909,
      "text": "Trên tường phía trên bồn tắm có một vòi sen.",
      "author": "ChatGPT4.1"
    },
    "5034": {
      "id": 2626910,
      "text": "Chúng tôi có một tấm rèm tắm treo trên thanh phía trên bồn tắm.",
      "author": "ChatGPT4.1"
    },
    "5036": {
      "id": 2626911,
      "text": "Có xà phòng và dầu gội trong phòng tắm.",
      "author": "ChatGPT4.1"
    },
    "5038": {
      "id": 2626912,
      "text": "và dầu gội dùng để gội đầu.",
      "author": "ChatGPT4.1"
    },
    "5039": {
      "id": 2626913,
      "text": "Khăn tắm đang treo trên giá.",
      "author": "a user"
    },
    "5041": {
      "id": 2626914,
      "text": "Bồn rửa mặt có vòi nước nóng và lạnh.",
      "author": "ChatGPT4.1"
    },
    "5042": {
      "id": 2626915,
      "text": "Có một nút bịt thoát nước.",
      "author": "ChatGPT4.1"
    },
    "5043": {
      "id": 2626916,
      "text": "Khi bạn rút nút, nước sẽ chảy ra khỏi bồn rửa.",
      "author": "ChatGPT4.1"
    },
    "5045": {
      "id": 2626917,
      "text": "Khi bạn xả nước bồn cầu,",
      "author": "ChatGPT4.1"
    },
    "5046": {
      "id": 2626918,
      "text": "nước sẽ chảy ào ào ra khỏi đó.",
      "author": "a user"
    },
    "5047": {
      "id": 2626919,
      "text": "Có giấy vệ sinh treo bên cạnh bồn cầu.",
      "author": "ChatGPT4.1"
    },
    "5048": {
      "id": 2626920,
      "text": "Chúng tôi cũng để những thứ khác trong phòng tắm.",
      "author": "ChatGPT4.1"
    },
    "5049": {
      "id": 2626921,
      "text": "Có một tủ thuốc đựng thuốc giảm đau, kem đánh răng và đồ trang điểm.",
      "author": "ChatGPT4.1"
    },
    "5052": {
      "id": 2626922,
      "text": "Có nhiều bàn chải và lược cho tóc của chúng tôi.",
      "author": "ChatGPT4.1"
    },
    "5053": {
      "id": 2626923,
      "text": "Có bàn chải đánh răng và chỉ nha khoa cho răng của chúng tôi.",
      "author": "ChatGPT4.1"
    },
    "5055": {
      "id": 2626924,
      "text": "Thật tốt khi có nhiều hơn một phòng tắm trong nhà.",
      "author": "ChatGPT4.1"
    }
  }
}
