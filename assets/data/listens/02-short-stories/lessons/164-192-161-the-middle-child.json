  "translations": {
    "6982": {
      "id": 5016,
      "text": "Tôi có một người chị mà tôi có thể mượn quần áo của chị ấy, nếu chị ấy cho phép tôi.",
      "author": "a user"
    },
    "6986": {
      "id": 8594,
      "text": "Cậu ấy dễ thương lắm, nhưng đôi khi tôi phải trông chừng cậu ấy.",
      "author": "a user"
    },
    "6988": {
      "id": 12944,
      "text": " Chị gái tôi là con cả.",
      "author": "a user"
    },
    "6990": {
      "id": 12949,
      "text": "Cô ấy được nhiều người chú ý khi mới lọt lòng.",
      "author": "a user"
    },
    "6993": {
      "id": 13138,
      "text": "Tôi dùng đồ cũ của chị ấy",
      "author": "a user"
    },
    "6997": {
      "id": 13143,
      "text": "Em trai tôi là đứa con bé bỏng của gia đình.",
      "author": "a user"
    },
    "6999": {
      "id": 13147,
      "text": "Chúng tôi đã bỏ qua cho cậu ấy vài chuyện mà thật ra cậu ấy không đáng được bỏ qua.",
      "author": "a user"
    },
    "7007": {
      "id": 13171,
      "text": "Tôi có thể đồng cảm với chị gái và em trai của mình.",
      "author": "a user"
    },
    "7008": {
      "id": 13172,
      "text": "Vâng, tôi nghĩ rằng con giữa có lẽ là một vị trí tốt.",
      "author": "a user"
    },
    "6980": {
      "id": 2596988,
      "text": "Tôi là con giữa trong gia đình.",
      "author": "ChatGPT4.1"
    },
    "6981": {
      "id": 2596989,
      "text": "Tôi nghĩ điều đó cũng tốt ở một số mặt.",
      "author": "ChatGPT4.1"
    },
    "6983": {
      "id": 2596990,
      "text": "Tôi có cơ hội gặp gỡ bạn bè của chị gái tôi,",
      "author": "ChatGPT4.1"
    },
    "6984": {
      "id": 2596991,
      "text": "mặc dù đôi khi họ nghĩ tôi còn quá nhỏ để đi cùng họ.",
      "author": "ChatGPT4.1"
    },
    "6985": {
      "id": 2596992,
      "text": "Tôi có một em trai.",
      "author": "a user"
    },
    "6987": {
      "id": 2596993,
      "text": "Việc làm con giữa có cả điểm tốt lẫn điểm xấu.",
      "author": "ChatGPT4.1"
    },
    "6989": {
      "id": 2596994,
      "text": "Chị ấy là con đầu lòng, nên đã có thời gian ở riêng với bố mẹ tôi.",
      "author": "ChatGPT4.1"
    },
    "6991": {
      "id": 2596995,
      "text": "Họ đã chụp rất nhiều ảnh cho chị ấy.",
      "author": "ChatGPT4.1"
    },
    "6992": {
      "id": 2596996,
      "text": "Tất cả quần áo và đồ chơi của chị đều mới tinh.",
      "author": "ChatGPT4.1"
    },
    "6994": {
      "id": 2596997,
      "text": "Bố mẹ tôi nghiêm khắc nhất với chị ấy.",
      "author": "ChatGPT4.1"
    },
    "6995": {
      "id": 2596998,
      "text": "Họ có rất nhiều quy tắc cho chị ấy phải tuân theo.",
      "author": "ChatGPT4.1"
    },
    "6996": {
      "id": 2596999,
      "text": "Chị ấy là con đầu lòng, nên họ muốn chị ấy phải hoàn hảo.",
      "author": "ChatGPT4.1"
    },
    "6998": {
      "id": 2597000,
      "text": "Tôi nghĩ rằng tất cả chúng tôi đều chiều hư em ấy.",
      "author": "a user"
    },
    "7000": {
      "id": 2597001,
      "text": "Phòng của em ấy lúc nào cũng bừa bộn,",
      "author": "ChatGPT4.1"
    },
    "7001": {
      "id": 2597002,
      "text": "và mẹ tôi chẳng bao giờ giận chuyện đó.",
      "author": "ChatGPT4.1"
    },
    "7002": {
      "id": 2597003,
      "text": "Mẹ lại nổi giận với tôi nếu phòng tôi bừa bộn.",
      "author": "ChatGPT4.1"
    },
    "7003": {
      "id": 2597004,
      "text": "Mẹ nói rằng tôi đủ lớn để giữ phòng sạch đẹp rồi.",
      "author": "ChatGPT4.1"
    },
    "7004": {
      "id": 2597005,
      "text": "Không có ích gì khi nghĩ về việc bạn muốn làm con thứ mấy trong gia đình.",
      "author": "ChatGPT4.1"
    },
    "7005": {
      "id": 2597006,
      "text": "Bạn thật sự không có quyền chọn điều đó",
      "author": "a user"
    },
    "7006": {
      "id": 2597007,
      "text": "Tôi nghĩ tôi thích làm con giữa.",
      "author": "ChatGPT4.1"
    }
  }
}
