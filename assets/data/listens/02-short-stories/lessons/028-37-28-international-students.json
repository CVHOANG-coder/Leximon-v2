  "translations": {
    "1325": {
      "id": 6888,
      "text": "Họ đang học ngôn ngữ và phong tục của chúng tôi.",
      "author": "a user"
    },
    "1339": {
      "id": 6983,
      "text": "Việc đặt câu hỏi bằng tiếng Anh là rất tốt.",
      "author": "a user"
    },
    "1340": {
      "id": 6987,
      "text": "Người Canada cố gắng giúp đỡ các sinh viên quốc tế.",
      "author": "a user"
    },
    "1342": {
      "id": 6992,
      "text": "Các gia đình chủ nhà đón tiếp sinh viên sống trong nhà của họ.",
      "author": "a user"
    },
    "1344": {
      "id": 6996,
      "text": "Nhiều sinh viên quốc tế giữ liên lạc với bạn bè và gia đình bản xứ ",
      "author": "a user"
    },
    "1346": {
      "id": 7000,
      "text": "Các sinh viên quốc tế học được rất nhiều điều từ gia đình bản xứ ",
      "author": "a user"
    },
    "1348": {
      "id": 7004,
      "text": "và họ tìm hiểu cuộc sống trong một gia đình người Canada sẽ như thế nào.",
      "author": "a user"
    },
    "1321": {
      "id": 2591931,
      "text": "Trường tôi có nhiều sinh viên quốc tế.",
      "author": "ChatGPT4.1"
    },
    "1322": {
      "id": 2591932,
      "text": "Một số sinh viên đến từ nước Anh.",
      "author": "ChatGPT4.1"
    },
    "1323": {
      "id": 2591933,
      "text": "Họ nói tiếng Anh, nhưng họ có giọng khác với giọng Canada.",
      "author": "ChatGPT4.1"
    },
    "1324": {
      "id": 2591934,
      "text": "Nhiều sinh viên đến từ Nhật Bản.",
      "author": "ChatGPT4.1"
    },
    "1326": {
      "id": 2591935,
      "text": "Chúng tôi có sinh viên từ Đức, Ý, Trung Quốc, Hàn Quốc và Iran.",
      "author": "ChatGPT4.1"
    },
    "1327": {
      "id": 2591936,
      "text": "Chúng tôi cố gắng làm cho những sinh viên đó cảm thấy được chào đón ở đây.",
      "author": "ChatGPT4.1"
    },
    "1328": {
      "id": 2591937,
      "text": "Các sinh viên thích xem những gì có ở đây.",
      "author": "ChatGPT4.1"
    },
    "1329": {
      "id": 2591938,
      "text": "Họ đi tham quan.",
      "author": "ChatGPT4.1"
    },
    "1330": {
      "id": 2591939,
      "text": "Họ thăm tất cả những nơi mà du khách thích đến.",
      "author": "ChatGPT4.1"
    },
    "1331": {
      "id": 2591940,
      "text": "Thác Niagara và Toronto là những nơi thú vị để tham quan.",
      "author": "ChatGPT4.1"
    },
    "1332": {
      "id": 2591941,
      "text": "Các sinh viên luyện tập tiếng Anh bằng cách nói chuyện với người Canada.",
      "author": "ChatGPT4.1"
    },
    "1333": {
      "id": 2591942,
      "text": "Khi họ mới đến đây, chúng tôi dẫn họ đi tham quan.",
      "author": "ChatGPT4.1"
    },
    "1334": {
      "id": 2591943,
      "text": "Họ làm nhiều bài tập để học ngôn ngữ.",
      "author": "ChatGPT4.1"
    },
    "1335": {
      "id": 2591944,
      "text": "Họ nghe các bài hát tiếng Anh.",
      "author": "ChatGPT4.1"
    },
    "1336": {
      "id": 2591945,
      "text": "Họ đọc sách truyện được viết bằng tiếng Anh.",
      "author": "a user"
    },
    "1337": {
      "id": 2591946,
      "text": "Họ nghe băng tiếng Anh.",
      "author": "ChatGPT4.1"
    },
    "1338": {
      "id": 2591947,
      "text": "Cách tốt nhất để học ngôn ngữ là nói chuyện với người khác.",
      "author": "ChatGPT4.1"
    },
    "1341": {
      "id": 2591948,
      "text": "Một số sinh viên quốc tế sống với các gia đình bản xứ.",
      "author": "ChatGPT4.1"
    },
    "1343": {
      "id": 2591949,
      "text": "Đó là một cách tốt để các gia đình bản xứ và sinh viên kết bạn với nhau.",
      "author": "ChatGPT4.1"
    },
    "1345": {
      "id": 2591950,
      "text": "ngay cả sau khi họ đã quay trở về quê hương.",
      "author": "ChatGPT4.1"
    },
    "1347": {
      "id": 2591951,
      "text": "bởi vì họ ăn các món ăn Canada,",
      "author": "ChatGPT4.1"
    }
  }
}
