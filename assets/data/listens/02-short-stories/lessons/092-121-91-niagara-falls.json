  "translations": {
    "4759": {
      "id": 49743,
      "text": "Vào ban đêm, họ chiếu đèn trên thác khiến chúng càng trở nên ấn tượng hơn.",
      "author": "a user"
    },
    "4761": {
      "id": 49753,
      "text": "Có những thứ khác ở thác Niagara mà du khách thích đến thăm.",
      "author": "a user"
    },
    "4767": {
      "id": 49762,
      "text": "Bạn có thể đi 1 chuyến xe buýt đặc biệt và tham quan Thác Niagara.",
      "author": "a user"
    },
    "4769": {
      "id": 49765,
      "text": "bạn có thể đi khinh khí cầu qua thác từ phía bên Mỹ.",
      "author": "a user"
    },
    "4777": {
      "id": 49782,
      "text": "Có những câu chuyện kể về những kẻ liều lĩnh tưởng rằng mình mạnh hơn cả thác nước.",
      "author": "a user"
    },
    "4782": {
      "id": 49791,
      "text": "Tôi biết thác nước có sức mạnh như thế nào.",
      "author": "a user"
    },
    "4783": {
      "id": 49794,
      "text": "Thật thú vị khi khám phá tất cả những câu chuyện nói về Thác Niagara.",
      "author": "a user"
    },
    "4754": {
      "id": 2589485,
      "text": "Tôi sống ở Niagara Falls.",
      "author": "ChatGPT4.1"
    },
    "4755": {
      "id": 2589486,
      "text": "Niagara Falls là một nơi nổi tiếng.",
      "author": "ChatGPT4.1"
    },
    "4756": {
      "id": 2589487,
      "text": "Rất nhiều khách du lịch đến thăm nơi này mỗi năm.",
      "author": "ChatGPT4.1"
    },
    "4757": {
      "id": 2589488,
      "text": "Phần lớn khách du lịch đến để ngắm thác nước.",
      "author": "ChatGPT4.1"
    },
    "4758": {
      "id": 2589489,
      "text": "Những thác nước rất đẹp và hùng vĩ.",
      "author": "ChatGPT4.1"
    },
    "4760": {
      "id": 2589490,
      "text": "Du khách xếp hàng dọc theo lan can để ngắm dòng nước đổ ầm ầm xuống sông Niagara.",
      "author": "a user"
    },
    "4762": {
      "id": 2589491,
      "text": "Có rất nhiều cửa hàng quà lưu niệm và bảo tàng.",
      "author": "ChatGPT4.1"
    },
    "4763": {
      "id": 2589492,
      "text": "Có nhiều khách sạn để khách du lịch nghỉ chân.",
      "author": "ChatGPT4.1"
    },
    "4764": {
      "id": 2589493,
      "text": "Du lịch rất quan trọng đối với Niagara Falls.",
      "author": "ChatGPT4.1"
    },
    "4765": {
      "id": 2589494,
      "text": "Nhiều người làm việc trong ngành du lịch.",
      "author": "ChatGPT4.1"
    },
    "4766": {
      "id": 2589495,
      "text": "Có nhiều công việc trong ngành du lịch.",
      "author": "ChatGPT4.1"
    },
    "4768": {
      "id": 2589496,
      "text": "Bạn có thể đi xe ngựa kéo ở Niagara-on-the-Lake, hoặc",
      "author": "a user"
    },
    "4770": {
      "id": 2589497,
      "text": "Bạn thậm chí có thể đi trực thăng bay qua thác nước.",
      "author": "ChatGPT4.1"
    },
    "4771": {
      "id": 2589498,
      "text": "Niagara Falls rất đông đúc vào mùa hè.",
      "author": "ChatGPT4.1"
    },
    "4772": {
      "id": 2589499,
      "text": "Mùa hè là thời điểm hầu hết khách du lịch đến đây.",
      "author": "ChatGPT4.1"
    },
    "4773": {
      "id": 2589500,
      "text": "Đôi khi, du khách nghĩ rằng trời đang mưa gần thác.",
      "author": "a user"
    },
    "4774": {
      "id": 2589501,
      "text": "Nhưng đó chỉ là làn sương nước bốc lên từ những thác nước hùng vĩ.",
      "author": "a user"
    },
    "4775": {
      "id": 2589502,
      "text": "Có rất nhiều truyền thuyết và câu chuyện liên quan đến Niagara Falls.",
      "author": "ChatGPT4.1"
    },
    "4776": {
      "id": 2589503,
      "text": "Có một truyền thuyết đặc biệt gọi là \"Nàng thiếu nữ của sương mù\".",
      "author": "ChatGPT4.1"
    },
    "4778": {
      "id": 2589504,
      "text": "Một số người trong số họ đã lao xuống thác trong những chiếc thùng gỗ.",
      "author": "a user"
    },
    "4779": {
      "id": 2589505,
      "text": "Và những người khác đã đi trên dây cáp bắc qua thác nước.",
      "author": "a user"
    },
    "4780": {
      "id": 2589506,
      "text": "Cả hai điều đó đều rất nguy hiểm.",
      "author": "ChatGPT4.1"
    },
    "4781": {
      "id": 2589507,
      "text": "Tôi luôn đứng sau lan can khi ngắm thác nước.",
      "author": "ChatGPT4.1"
    }
  }
}
