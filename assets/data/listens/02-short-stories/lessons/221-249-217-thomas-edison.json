  "translations": {
    "9224": {
      "id": 2589232,
      "text": "Thomas Edison là một trong những nhà phát minh nổi tiếng nhất mọi thời đại.",
      "author": "ChatGPT4.1"
    },
    "9225": {
      "id": 2589233,
      "text": "Ông sinh ra tại một thị trấn nhỏ ở Hoa Kỳ vào năm 1847.",
      "author": "ChatGPT4.1"
    },
    "9226": {
      "id": 2589234,
      "text": "Khi còn nhỏ, Thomas cảm thấy trường học rất nhàm chán.",
      "author": "ChatGPT4.1"
    },
    "9227": {
      "id": 2589235,
      "text": "Một giáo viên từng nói với mẹ của Thomas rằng ông tin Thomas là một cậu bé khá ngốc nghếch.",
      "author": "ChatGPT4.1"
    },
    "9228": {
      "id": 2589236,
      "text": "Tuy nhiên, mẹ của Edison biết rõ hơn.",
      "author": "ChatGPT4.1"
    },
    "9229": {
      "id": 2589237,
      "text": "Bà hiểu rằng con trai mình rất thông minh.",
      "author": "ChatGPT4.1"
    },
    "9230": {
      "id": 2589238,
      "text": "Sau đó bà đưa ông ra khỏi trường học và tự mình dạy dỗ ông.",
      "author": "ChatGPT4.1"
    },
    "9231": {
      "id": 2589239,
      "text": "Khi trưởng thành, Thomas Edison trở nên rất thích thú với việc phát minh các loại máy móc mới.",
      "author": "ChatGPT4.1"
    },
    "9232": {
      "id": 2589240,
      "text": "Một trong những phát minh đầu tiên của ông là một thiết bị điện nhỏ có thể dùng để đếm phiếu bầu.",
      "author": "ChatGPT4.1"
    },
    "9233": {
      "id": 2589241,
      "text": "Tuy nhiên, chính phủ không quan tâm đến phát minh này của ông.",
      "author": "ChatGPT4.1"
    },
    "9234": {
      "id": 2589242,
      "text": "Nhưng Edison không nản lòng. Ông tiếp tục phát minh,",
      "author": "ChatGPT4.1"
    },
    "9235": {
      "id": 2589243,
      "text": "và phát minh tiếp theo của ông là một thiết bị điện có thể dùng để ghi lại giá cổ phiếu.",
      "author": "ChatGPT4.1"
    },
    "9236": {
      "id": 2589244,
      "text": "Phát minh này rất phổ biến và thành công.",
      "author": "ChatGPT4.1"
    },
    "9237": {
      "id": 2589245,
      "text": "Có lẽ phát minh nổi tiếng nhất của Edison là bóng đèn điện.",
      "author": "ChatGPT4.1"
    },
    "9238": {
      "id": 2589246,
      "text": "Trước Edison, đã có một vài loại đèn điện, nhưng chúng rất đắt đỏ.",
      "author": "ChatGPT4.1"
    },
    "9239": {
      "id": 2589247,
      "text": "Năm 1879, Edison đã phát minh ra một loại bóng đèn mới có thể chiếu sáng trong thời gian dài.",
      "author": "ChatGPT4.1"
    },
    "9240": {
      "id": 2589248,
