  "translations": {
    "1181": {
      "id": 3961,
      "text": "Có tuyết rơi vào mùa đông.",
      "author": "a user"
    },
    "1198": {
      "id": 3982,
      "text": "Tiếp theo mùa hè là mùa thu.",
      "author": "a user"
    },
    "1202": {
      "id": 3987,
      "text": "Những chiếc lá rơi khỏi cây",
      "author": "a user"
    },
    "1179": {
      "id": 2592724,
      "text": "Có bốn mùa trong năm.",
      "author": "ChatGPT4.1"
    },
    "1180": {
      "id": 2592725,
      "text": "Mùa đông là mùa lạnh.",
      "author": "ChatGPT4.1"
    },
    "1182": {
      "id": 2592726,
      "text": "Gió thổi,",
      "author": "ChatGPT4.1"
    },
    "1183": {
      "id": 2592727,
      "text": "và băng hình thành trên mặt nước.",
      "author": "ChatGPT4.1"
    },
    "1184": {
      "id": 2592728,
      "text": "Chúng tôi chơi khúc côn cầu trên băng.",
      "author": "ChatGPT4.1"
    },
    "1185": {
      "id": 2592729,
      "text": "Chúng tôi chơi trong tuyết.",
      "author": "ChatGPT4.1"
    },
    "1186": {
      "id": 2592730,
      "text": "Sau mùa đông là mùa xuân.",
      "author": "ChatGPT4.1"
    },
    "1187": {
      "id": 2592731,
      "text": "Đó là lúc thời tiết bắt đầu ấm lên.",
      "author": "ChatGPT4.1"
    },
    "1188": {
      "id": 2592732,
      "text": "Cây bắt đầu đâm chồi.",
      "author": "ChatGPT4.1"
    },
    "1189": {
      "id": 2592733,
      "text": "Hoa bắt đầu nở.",
      "author": "ChatGPT4.1"
    },
    "1190": {
      "id": 2592734,
      "text": "Mùa xuân thường mưa nhiều.",
      "author": "a user"
    },
    "1191": {
      "id": 2592735,
      "text": "Sau mùa xuân là mùa hè.",
      "author": "ChatGPT4.1"
    },
    "1192": {
      "id": 2592736,
      "text": "Mùa hè có thể rất nóng.",
      "author": "ChatGPT4.1"
    },
    "1193": {
      "id": 2592737,
      "text": "Mặt trời chiếu sáng rực rỡ.",
      "author": "ChatGPT4.1"
    },
    "1194": {
      "id": 2592738,
      "text": "Chúng tôi đi bơi vào mùa hè.",
      "author": "ChatGPT4.1"
    },
    "1195": {
      "id": 2592739,
      "text": "Chúng tôi dành nhiều thời gian ngoài trời.",
      "author": "ChatGPT4.1"
    },
    "1196": {
      "id": 2592740,
      "text": "Nhiều người đi du lịch vào mùa hè.",
      "author": "ChatGPT4.1"
    },
    "1197": {
      "id": 2592741,
      "text": "Chúng tôi được nghỉ hè ở trường.",
      "author": "ChatGPT4.1"
    },
    "1199": {
      "id": 2592742,
      "text": "Lá trên cây thay đổi màu sắc.",
      "author": "ChatGPT4.1"
    },
    "1200": {
      "id": 2592743,
      "text": "Chúng chuyển từ màu xanh sang màu đỏ,",
      "author": "ChatGPT4.1"
    },
    "1201": {
      "id": 2592744,
      "text": "cam và nâu.",
      "author": "ChatGPT4.1"
    },
    "1203": {
      "id": 2592745,
      "text": "Thời tiết trở nên mát mẻ hơn.",
      "author": "ChatGPT4.1"
    },
    "1204": {
      "id": 2592746,
      "text": "Ban ngày ngắn lại.",
      "author": "ChatGPT4.1"
    },
    "1205": {
      "id": 2592747,
      "text": "Chúng tôi đi học lại vào mùa thu.",
      "author": "ChatGPT4.1"
    },
    "1206": {
      "id": 2592748,
      "text": "Rồi mùa đông lại đến.",
      "author": "ChatGPT4.1"
    },
    "1207": {
      "id": 2592749,
      "text": "Các mùa nối tiếp nhau liên tục.",
      "author": "ChatGPT4.1"
    }
  }
}
