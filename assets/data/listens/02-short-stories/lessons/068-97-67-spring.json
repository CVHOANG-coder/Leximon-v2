  "translations": {
    "4011": {
      "id": 10431,
      "text": "Chim bay về từ phương nam.",
      "author": "a user"
    },
    "4012": {
      "id": 10432,
      "text": "Tôi luôn có thể nói rằng mùa xuân là đây",
      "author": "a user"
    },
    "4013": {
      "id": 10434,
      "text": "Khi tôi nhìn thấy chú chim cổ đỏ đầu tiên trong mùa",
      "author": "a user"
    },
    "4014": {
      "id": 10438,
      "text": "Các chú chim cổ đỏ kéo giun từ mặt đất ẩm ướt.",
      "author": "a user"
    },
    "4018": {
      "id": 10444,
      "text": "Mẹ tôi luôn dặn tôi không được để dấu chân bùn vào nhà.",
      "author": "a user"
    },
    "4022": {
      "id": 10450,
      "text": "Đôi khi tôi nghịch trong vũng nước,",
      "author": "a user"
    },
    "4024": {
      "id": 10454,
      "text": "Tôi thích trời khi tuyết đã tan, mưa đã ngừng và mặt trời ló dạng.",
      "author": "a user"
    },
    "4007": {
      "id": 2590302,
      "text": "Trời mưa rất nhiều vào mùa xuân.",
      "author": "ChatGPT4.1"
    },
    "4008": {
      "id": 2590303,
      "text": "Cây cối đầy nụ non,",
      "author": "ChatGPT4.1"
    },
    "4009": {
      "id": 2590304,
      "text": "và hoa bắt đầu nở rộ.",
      "author": "ChatGPT4.1"
    },
    "4010": {
      "id": 2590305,
      "text": "Loài hoa mùa xuân tôi thích nhất là hoa tulip và thủy tiên.",
      "author": "ChatGPT4.1"
    },
    "4015": {
      "id": 2590306,
      "text": "Khi trời không mưa, tôi và các bạn ra ngoài ném bóng.",
      "author": "ChatGPT4.1"
    },
    "4016": {
      "id": 2590307,
      "text": "Chúng tôi mong chờ mùa hè, nhưng cũng rất vui khi được ra ngoài sau mùa đông dài.",
      "author": "ChatGPT4.1"
    },
    "4017": {
      "id": 2590308,
      "text": "Không khí mùa xuân thật trong lành.",
      "author": "ChatGPT4.1"
    },
    "4019": {
      "id": 2590309,
      "text": "Sân nhà tôi rất lầy lội vào mùa xuân.",
      "author": "ChatGPT4.1"
    },
    "4020": {
      "id": 2590310,
      "text": "Tôi lau chân đầy bùn trước khi vào nhà.",
      "author": "ChatGPT4.1"
    },
    "4021": {
      "id": 2590311,
      "text": "Sân nhà tôi có rất nhiều vũng nước.",
      "author": "ChatGPT4.1"
    },
    "4023": {
      "id": 2590312,
      "text": "và tôi bị ướt lạnh, nên phải vào trong nhà.",
      "author": "ChatGPT4.1"
    },
    "4025": {
      "id": 2590313,
      "text": "Vào những ngày nắng, tôi luôn tụ tập cùng bạn bè.",
      "author": "ChatGPT4.1"
    },
    "4026": {
      "id": 2590314,
      "text": "Những lúc đó chúng tôi hoặc đạp xe hoặc chơi bóng.",
      "author": "ChatGPT4.1"
    },
    "4027": {
      "id": 2590315,
      "text": "Bố mẹ tôi thích đi dạo vào các buổi tối mùa xuân.",
      "author": "ChatGPT4.1"
    },
    "4028": {
      "id": 2590316,
      "text": "Họ cũng thích dọn dẹp sân vườn vào mùa xuân.",
      "author": "ChatGPT4.1"
    },
    "4029": {
      "id": 2590317,
      "text": "Dường như ai cũng ra ngoài.",
      "author": "ChatGPT4.1"
    },
    "4030": {
      "id": 2590318,
      "text": "Mùa xuân khiến mọi người ra khỏi nhà.",
      "author": "ChatGPT4.1"
    }
  }
}
