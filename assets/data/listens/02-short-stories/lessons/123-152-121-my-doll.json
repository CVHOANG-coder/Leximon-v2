  "translations": {
    "5666": {
      "id": 2592331,
      "text": "Khi tôi còn nhỏ, tôi đã có một con búp bê vải.",
      "author": "ChatGPT4.1"
    },
    "5667": {
      "id": 2592332,
      "text": "Đó là một con búp bê nhỏ, rất đơn giản, và nó mặc một bộ đồ hề cùng chiếc mũ hề.",
      "author": "ChatGPT4.1"
    },
    "5668": {
      "id": 2592333,
      "text": "Tôi thường mang con búp bê đó lên giường cùng tôi mỗi đêm.",
      "author": "ChatGPT4.1"
    },
    "5669": {
      "id": 2592334,
      "text": "Tôi không thể đi ngủ mà không có con búp bê của mình.",
      "author": "ChatGPT4.1"
    },
    "5670": {
      "id": 2592335,
      "text": "Mẹ tôi từng giả vờ như con búp bê đang nói chuyện với tôi.",
      "author": "ChatGPT4.1"
    },
    "5671": {
      "id": 2592336,
      "text": "Bà ấy sẽ làm cho con búp bê nhảy múa và hát những bài hát.",
      "author": "ChatGPT4.1"
    },
    "5672": {
      "id": 2592337,
      "text": "Tôi sẽ nói chuyện với con búp bê.",
      "author": "ChatGPT4.1"
    },
    "5673": {
      "id": 2592338,
      "text": "Mẹ tôi sẽ trả lời thay cho búp bê, nhưng lúc đó tôi còn nhỏ,",
      "author": "ChatGPT4.1"
    },
    "5674": {
      "id": 2592339,
      "text": "và tôi nghĩ rằng con búp bê thực sự đang nói chuyện với mình.",
      "author": "ChatGPT4.1"
    },
    "5675": {
      "id": 2592340,
      "text": "Con búp bê đó là người bạn thân nhất của tôi.",
      "author": "ChatGPT4.1"
    },
    "5676": {
      "id": 2592341,
      "text": "Tôi mang nó đi mọi nơi.",
      "author": "ChatGPT4.1"
    },
    "5677": {
      "id": 2592342,
      "text": "Có lần tôi mang nó đến cửa hàng cùng mình, và tôi để quên nó trên một chiếc kệ trong cửa hàng.",
      "author": "ChatGPT4.1"
    },
    "5678": {
      "id": 2592343,
      "text": "Khi chúng tôi đã về nửa đường thì tôi mới nhận ra mình không mang theo búp bê.",
      "author": "ChatGPT4.1"
    },
    "5679": {
      "id": 2592344,
      "text": "Tôi đã rất buồn.",
      "author": "ChatGPT4.1"
    },
    "5680": {
      "id": 2592345,
      "text": "Mẹ tôi và tôi vội vàng quay lại cửa hàng.",
      "author": "ChatGPT4.1"
    },
    "5681": {
      "id": 2592346,
      "text": "Con búp bê của tôi vẫn còn đó. Tôi đã rất nhẹ nhõm.",
      "author": "ChatGPT4.1"
    },
    "5682": {
      "id": 2592347,
      "text": "Tôi ôm lấy búp bê và tự hứa với mình rằng sẽ không bao giờ để quên nó ở đâu nữa.",
      "author": "ChatGPT4.1"
    },
    "5683": {
      "id": 2592348,
      "text": "Tôi không thể tưởng tượng cuộc sống mà không có con búp bê đó.",
      "author": "ChatGPT4.1"
    },
    "5684": {
      "id": 2592349,
      "text": "Qua năm tháng, con búp bê trở nên ít quan trọng hơn trong cuộc sống của tôi.",
      "author": "ChatGPT4.1"
    },
    "5685": {
      "id": 2592350,
      "text": "Tôi có nhiều việc khác phải làm, nhưng con búp bê vẫn ngồi trên giường tôi vào ban ngày,",
      "author": "ChatGPT4.1"
    },
    "5686": {
      "id": 2592351,
      "text": "và tôi vẫn mang nó lên giường vào ban đêm.",
      "author": "ChatGPT4.1"
    },
    "5687": {
      "id": 2592352,
      "text": "Tôi đã dành rất nhiều tình yêu cho búp bê đó khi tôi còn nhỏ.",
      "author": "ChatGPT4.1"
    },
    "5688": {
      "id": 2592353,
      "text": "Thực tế, tôi yêu con búp bê đó đến nỗi bây giờ trông nó đã rách nát và sờn cũ.",
      "author": "ChatGPT4.1"
    },
    "5689": {
      "id": 2592354,
      "text": "Có những phần trên mặt và tay nó gần như đã mòn hết.",
      "author": "ChatGPT4.1"
    },
    "5690": {
      "id": 2592355,
      "text": "Tôi có rất nhiều đồ chơi khác khi còn nhỏ,",
      "author": "ChatGPT4.1"
    },
    "5691": {
      "id": 2592356,
      "text": "nhưng không cái nào quan trọng như con búp bê đó.",
      "author": "ChatGPT4.1"
    },
    "5692": {
      "id": 2592357,
      "text": "Tôi không còn chơi đồ chơi nữa,",
      "author": "ChatGPT4.1"
    },
    "5693": {
      "id": 2592358,
      "text": "nhưng con búp bê đó vẫn còn ở trong phòng tôi.",
      "author": "ChatGPT4.1"
    },
    "5694": {
      "id": 2592359,
      "text": "Nó ngồi trên một chiếc ghế đặc biệt ở góc phòng.",
      "author": "ChatGPT4.1"
    },
    "5695": {
      "id": 2592360,
      "text": "Tôi sẽ luôn giữ con búp bê đó.",
      "author": "ChatGPT4.1"
    },
    "5696": {
      "id": 2594161,
      "text": "Dù nó có sờn rách đến đâu,",
      "author": "ChatGPT4.1"
    },
    "5697": {
      "id": 2594162,
      "text": "tôi sẽ luôn giữ gìn và trân quý nó như một phần tuổi thơ của mình.",
      "author": "ChatGPT4.1"
    }
  }
}
