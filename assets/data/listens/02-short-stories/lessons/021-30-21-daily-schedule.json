  "translations": {
    "1117": {
      "id": 3774,
      "text": "Tôi ăn bữa sáng của tôi.",
      "author": "a user"
    },
    "1118": {
      "id": 3776,
      "text": "Tôi thường ăn bánh mì nướng hoặc ngũ cốc.",
      "author": "a user"
    },
    "1122": {
      "id": 3785,
      "text": "Tôi đạp xe đến trường.",
      "author": "a user"
    },
    "1123": {
      "id": 3786,
      "text": "Trong lớp của tôi, chúng tôi học toán và tiếng Anh trước giờ ra chơi.",
      "author": "a user"
    },
    "1124": {
      "id": 3788,
      "text": "Vào giờ ra chơi, các bạn gái nhảy dây, hoặc đi loanh quanh và nói chuyện.",
      "author": "a user"
    },
    "1130": {
      "id": 3813,
      "text": "Sau bữa trưa, chúng tôi học lịch sử và khoa học.",
      "author": "a user"
    },
    "1132": {
      "id": 3820,
      "text": "Một số bạn nữ cũng chơi bóng.",
      "author": "a user"
    },
    "1133": {
      "id": 3822,
      "text": "Vào mùa đông, chúng tôi làm người tuyết.",
      "author": "a user"
    },
    "1135": {
      "id": 3829,
      "text": "Sau giờ giải lao, chúng tôi có tiết âm nhạc và sức khỏe.",
      "author": "a user"
    },
    "1138": {
      "id": 3856,
      "text": "Tôi ăn một bữa ăn nhẹ và thay quần áo khi về đến nhà.",
      "author": "a user"
    },
    "1142": {
      "id": 3871,
      "text": "Vào một số buổi tối, tôi giúp mẹ rửa chén",
      "author": "a user"
    },
    "1127": {
      "id": 601927,
      "text": "Sau giờ ra chơi, chúng tôi học thể dục và môn địa lý.",
      "author": "a user"
    },
    "1115": {
      "id": 2586231,
      "text": "Tôi thức dậy mỗi sáng lúc bảy giờ.",
      "author": "ChatGPT4.1"
    },
    "1116": {
      "id": 2586232,
      "text": "Tôi đi tắm.",
      "author": "a user"
    },
    "1119": {
      "id": 2586233,
      "text": "Tôi đánh răng.",
      "author": "ChatGPT4.1"
    },
    "1120": {
      "id": 2586234,
      "text": "Tôi mặc quần áo.",
      "author": "ChatGPT4.1"
    },
    "1121": {
      "id": 2586235,
      "text": "Tôi bắt xe buýt đến trường.",
      "author": "ChatGPT4.1"
    },
    "1125": {
      "id": 2586236,
      "text": "Các bạn nam chơi ngoài sân hoặc chơi bóng chày.",
      "author": "ChatGPT4.1"
    },
    "1128": {
      "id": 2586237,
      "text": "Chúng tôi ăn trưa, rồi chơi ở ngoài trời.",
      "author": "ChatGPT4.1"
    },
    "1129": {
      "id": 2586238,
      "text": "Khi chuông reo, chúng tôi xếp hàng quay lại lớp học.",
      "author": "ChatGPT4.1"
    },
    "1131": {
      "id": 2586239,
      "text": "Trong giờ ra chơi, chúng tôi lại chơi bóng.",
      "author": "ChatGPT4.1"
    },
    "1134": {
      "id": 2586240,
      "text": "Nếu trời quá lạnh, chúng tôi ở trong nhà và trò chuyện với nhau.",
      "author": "ChatGPT4.1"
    },
    "1136": {
      "id": 2586241,
      "text": "Chúng tôi tan trường lúc 3:30.",
      "author": "ChatGPT4.1"
    },
    "1137": {
      "id": 2586242,
      "text": "Thỉnh thoảng tôi đi bộ về nhà với bạn bè, hoặc tôi đi xe buýt.",
      "author": "ChatGPT4.1"
    },
    "1139": {
      "id": 2586243,
      "text": "Nếu trời mưa, tôi xem tivi.",
      "author": "ChatGPT4.1"
    },
    "1140": {
      "id": 2586244,
      "text": "Nếu thời tiết đẹp, tôi chơi với những người bạn của tôi.",
      "author": "a user"
    },
    "1141": {
      "id": 2586245,
      "text": "Tôi ăn tối lúc 5:30.",
      "author": "ChatGPT4.1"
    },
    "1143": {
      "id": 2586246,
      "text": "Sau bữa tối, tôi làm bài tập về nhà.",
      "author": "ChatGPT4.1"
    },
    "1144": {
      "id": 2586247,
      "text": "Tôi rửa mặt và tay, và đánh răng.",
      "author": "ChatGPT4.1"
    },
    "1145": {
      "id": 2586248,
      "text": "Tôi thay sang bộ đồ ngủ.",
      "author": "a user"
    },
    "1146": {
      "id": 2592266,
      "text": "Tôi đi ngủ lúc 9 giờ.",
      "author": "ChatGPT4.1"
    }
  }
