  "translations": {
    "8942": {
      "id": 26699,
      "text": "Được thành lập vào năm 1971 bởi chính phủ liên bang, ParticipAction đã thành công trong việc khuyến khích người dân Canada hoạt động tích cực và giữ gìn sức khỏe.",
      "author": "a user"
    },
    "8943": {
      "id": 26702,
      "text": "ParticipAction được tạo ra bởi chính phủ Tự do Canada của Thủ tướng Pierre Trudeau.",
      "author": "a user"
    },
    "8949": {
      "id": 27259,
      "text": "Chính từ cơ quan thứ hai này, ParticipAction đã được sinh ra.",
      "author": "a user"
    },
    "8955": {
      "id": 31373,
      "text": "Ngoài ra, chính phủ cũng đóng vai trò rất ít trong việc khuyến khích hoạt động thể chất trước ParticipAction.",
      "author": "a user"
    },
    "8956": {
      "id": 31375,
      "text": "Kết quả của ParticipAction rất ấn tượng.",
      "author": "a user"
    },
    "8959": {
      "id": 31379,
      "text": "ParticipAction được coi là một chương trình tích cực",
      "author": "a user"
    },
    "8962": {
      "id": 31392,
      "text": "Nhiều người cho rằng điều này thật đáng tiếc, bởi chương trình đã truyền tải những thông điệp tích cực đến những người Canada vốn dĩ ít vận động.",
      "author": "a user"
    },
    "8941": {
      "id": 2592695,
      "text": "\"ParticipAction\" là tên của chương trình của chính phủ Canada nhằm khuyến khích người Canada vận động và duy trì thể lực.",
      "author": "ChatGPT4.1"
    },
    "8944": {
      "id": 2592696,
      "text": "Trudeau tin rằng thể thao và giải trí nên đóng vai trò quan trọng trong cuộc sống của công dân Canada.",
      "author": "ChatGPT4.1"
    },
    "8945": {
      "id": 2592697,
      "text": "Chính phủ của ông đã thực hiện hai bước để đạt được mục tiêu này.",
      "author": "ChatGPT4.1"
    },
    "8946": {
      "id": 2592698,
      "text": "Trước tiên, một cơ quan chính phủ đã được thành lập để cung cấp kinh phí cho các vận động viên thành tích cao,",
      "author": "ChatGPT4.1"
    },
    "8947": {
      "id": 2592699,
      "text": "chẳng hạn như những người đang tập luyện và thi đấu tại Thế vận hội Olympic.",
      "author": "ChatGPT4.1"
    },
    "8948": {
      "id": 2592700,
      "text": "Một cơ quan thứ hai được thành lập để khuyến khích sự tham gia và hoạt động thể chất trong dân số Canada nói chung.",
      "author": "ChatGPT4.1"
    },
    "8950": {
      "id": 2592701,
      "text": "ParticipAction trở nên nổi tiếng vào những năm 1970 nhờ loạt quảng cáo trên truyền hình.",
      "author": "ChatGPT4.1"
    },
    "8951": {
      "id": 2592702,
      "text": "Trong các quảng cáo này, một chàng trai Canada khoảng 20 tuổi đã bị một người đàn ông Thụy Điển 60 tuổi chạy nhanh hơn.",
      "author": "ChatGPT4.1"
    },
    "8952": {
      "id": 2592703,
      "text": "Thông điệp là người Canada đã trở nên lười biếng và thiếu vận động.",
      "author": "ChatGPT4.1"
    },
    "8953": {
      "id": 2592704,
      "text": "Điều này có lẽ đúng với người Canada vào thời điểm đó.",
      "author": "ChatGPT4.1"
    },
    "8954": {
      "id": 2592705,
      "text": "Việc rèn luyện thể lực không được khuyến khích mạnh trong các trường học, đặc biệt là đối với phụ nữ.",
      "author": "ChatGPT4.1"
    },
    "8957": {
      "id": 2592706,
      "text": "Người Canada đã trở nên năng động hơn trong những năm sau khi chương trình được khởi xướng.",
      "author": "ChatGPT4.1"
    },
    "8958": {
      "id": 2592707,
      "text": "Bên cạnh đó, việc rèn luyện thể lực và hoạt động được khuyến khích thông qua các chương trình giáo dục thể chất.",
      "author": "ChatGPT4.1"
    },
    "8960": {
      "id": 2592708,
      "text": "bởi vì nó khiến người Canada vận động đồng thời giảm chi phí y tế do lười vận động và thể lực kém gây ra.",
      "author": "ChatGPT4.1"
    },
    "8961": {
      "id": 2592709,
      "text": "Gần đây, chương trình ParticipAction đã bị chính phủ liên bang chấm dứt do thiếu nguồn tài trợ.",
      "author": "ChatGPT4.1"
    },
    "8963": {
      "id": 2592710,
      "text": "Dù chương trình đã kết thúc, ParticipAction vẫn để lại ấn tượng lâu dài đối với người Canada.",
      "author": "ChatGPT4.1"
    },
    "8964": {
      "id": 2592711,
      "text": "Hy vọng rằng tấm gương tích cực về rèn luyện thể chất cho người Canada của chương trình sẽ tiếp tục trong tương lai.",
      "author": "ChatGPT4.1"
    }
  }
}
