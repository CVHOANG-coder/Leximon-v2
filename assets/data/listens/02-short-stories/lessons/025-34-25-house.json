  "translations": {
    "1238": {
      "id": 2144,
      "text": "Có một chiếc ghế dài, hai chiếc ghế, một bàn cà phê và một chiếc tivi trong phòng khách. ",
      "author": "a user"
    },
    "1241": {
      "id": 2152,
      "text": "Có một bàn bếp và những cái ghế.",
      "author": "a user"
    },
    "1251": {
      "id": 2167,
      "text": "Chúng tôi cũng có bàn trang điểm trong phòng của chúng tôi.",
      "author": "a user"
    },
    "1258": {
      "id": 2176,
      "text": "Đây là nơi chúng tôi giặt và phơi quần áo.",
      "author": "a user"
    },
    "1236": {
      "id": 2594490,
      "text": "Một ngôi nhà được chia thành nhiều phòng khác nhau.",
      "author": "ChatGPT4.1"
    },
    "1237": {
      "id": 2594491,
      "text": "Trong nhà tôi có một phòng khách.",
      "author": "ChatGPT4.1"
    },
    "1239": {
      "id": 2594492,
      "text": "Trong bếp có một cái bếp và một cái tủ lạnh.",
      "author": "ChatGPT4.1"
    },
    "1240": {
      "id": 2594493,
      "text": "Ngoài ra còn có một bồn rửa chén và một máy rửa bát trong bếp.",
      "author": "ChatGPT4.1"
    },
    "1242": {
      "id": 2594494,
      "text": "Chúng tôi ăn hầu hết các bữa ăn trên bàn ăn ở bếp.",
      "author": "ChatGPT4.1"
    },
    "1243": {
      "id": 2594495,
      "text": "Nhà chúng tôi có một phòng ăn.",
      "author": "ChatGPT4.1"
    },
    "1244": {
      "id": 2594496,
      "text": "Trong đó có một bàn ăn và các ghế.",
      "author": "ChatGPT4.1"
    },
    "1245": {
      "id": 2594497,
      "text": "Có một phòng vệ sinh hoặc phòng tắm.",
      "author": "a user"
    },
    "1246": {
      "id": 2594498,
      "text": "Trong phòng tắm có một cái bồn cầu, một cái bồn rửa mặt và một bồn tắm.",
      "author": "ChatGPT4.1"
    },
    "1247": {
      "id": 2594499,
      "text": "Ngoài ra còn có một vòi hoa sen trong phòng tắm.",
      "author": "a user"
    },
    "1248": {
      "id": 2594500,
      "text": "Nhà chúng tôi có ba phòng ngủ.",
      "author": "ChatGPT4.1"
    },
    "1249": {
      "id": 2594501,
      "text": "Các phòng ngủ đều ở tầng trên.",
      "author": "ChatGPT4.1"
    },
    "1250": {
      "id": 2594502,
      "text": "Phòng của anh trai tôi, phòng tôi và phòng của bố mẹ tôi đều có giường.",
      "author": "ChatGPT4.1"
    },
    "1252": {
      "id": 2594503,
      "text": "Tất cả các phòng ngủ đều có tủ quần áo",
      "author": "a user"
    },
    "1253": {
      "id": 2594504,
      "text": "Chúng tôi cất quần áo trong các tủ quần áo",
      "author": "a user"
    },
    "1254": {
      "id": 2594505,
      "text": "Nhà chúng tôi có tầng hầm.",
      "author": "ChatGPT4.1"
    },
    "1255": {
      "id": 2594506,
      "text": "Chúng tôi cất giữ đồ đạc ở tầng hầm.",
      "author": "ChatGPT4.1"
    },
    "1256": {
      "id": 2594507,
      "text": "Trong tầng hầm có một phòng giặt là.",
      "author": "ChatGPT4.1"
    },
    "1257": {
      "id": 2594508,
      "text": "Trong phòng giặt có một máy giặt và một máy sấy.",
      "author": "ChatGPT4.1"
    },
    "1259": {
      "id": 2594509,
      "text": "Nhà chúng tôi có một gara liền kề.",
      "author": "ChatGPT4.1"
    },
    "1260": {
      "id": 2594510,
      "text": "Chúng tôi để xe hơi trong gara.",
      "author": "ChatGPT4.1"
    },
    "1261": {
      "id": 2594511,
      "text": "Bạn lái xe dọc theo lối vào nhà rồi đi vào gara.",
      "author": "a user"
    },
    "1262": {
      "id": 2594512,
      "text": "Nhà chúng tôi cũng có một sân trước và một sân sau.",
      "author": "ChatGPT4.1"
    },
    "1263": {
      "id": 2594513,
      "text": "Ở sân sau có một vườn rau.",
      "author": "ChatGPT4.1"
    },
    "1264": {
      "id": 2594514,
      "text": "Có một vài bông hoa và một cái cây được trồng ở sân trước.",
      "author": "ChatGPT4.1"
    }
  }
