  "translations": {
    "1633": {
      "id": 9525,
      "text": "Bạn có thể lái taxi hoặc phi công lái máy bay.",
      "author": "a user"
    },
    "1635": {
      "id": 9528,
      "text": "Bạn có thể muốn làm nhân viên bán hàng trong một cửa hàng",
      "author": "a user"
    },
    "1638": {
      "id": 9532,
      "text": "Làm một nha sĩ là một công việc tốt.",
      "author": "a user"
    },
    "1639": {
      "id": 9533,
      "text": "Một nha sĩ chữa răng.",
      "author": "a user"
    },
    "1642": {
      "id": 9540,
      "text": "Bạn có thể là một thợ làm tóc (làm cho nữ) hoặc một thợ cắt tóc (cắt tóc nam).",
      "author": "a user"
    },
    "1646": {
      "id": 9550,
      "text": "Bạn là người có khiếu nghệ thuật hay sáng tạo ?",
      "author": "a user"
    },
    "1648": {
      "id": 9558,
      "text": "Bạn có thể làm việc trong ngành xây dựng và xây dựng những ngôi nhà.",
      "author": "a user"
    },
    "1650": {
      "id": 9564,
      "text": "Nếu bạn thích nấu ăn, bạn có thể là đầu bếp hoặc đầu bếp trưởng.",
      "author": "a user"
    },
    "1654": {
      "id": 9576,
      "text": "Không có giới hạn cho những gì bạn có thể trở thành",
      "author": "a user"
    },
    "1627": {
      "id": 2585912,
      "text": "Có rất nhiều nghề khác nhau mà bạn có thể lựa chọn.",
      "author": "ChatGPT4.1"
    },
    "1628": {
      "id": 2585913,
      "text": "Bạn có thể trở thành bác sĩ hoặc y tá.",
      "author": "ChatGPT4.1"
    },
    "1629": {
      "id": 2585914,
      "text": "Bạn có thể làm việc ở bệnh viện hoặc phòng khám.",
      "author": "ChatGPT4.1"
    },
    "1630": {
      "id": 2585915,
      "text": "Bạn có thể là lính cứu hỏa và dập tắt đám cháy.",
      "author": "ChatGPT4.1"
    },
    "1631": {
      "id": 2585916,
      "text": "Cảnh sát thực thi pháp luật.",
      "author": "ChatGPT4.1"
    },
    "1632": {
      "id": 2585917,
      "text": "Diễn viên đóng vai trên sân khấu hoặc trong phim.",
      "author": "ChatGPT4.1"
    },
    "1634": {
      "id": 2585918,
      "text": "Bạn thích làm những việc gì?",
      "author": "ChatGPT4.1"
    },
    "1636": {
      "id": 2585919,
      "text": "Có thể bạn giỏi một môn thể thao nào đó.",
      "author": "ChatGPT4.1"
    },
    "1637": {
      "id": 2585920,
      "text": "Bạn có thể là cầu thủ bóng chày hoặc khúc côn cầu.",
      "author": "ChatGPT4.1"
    },
    "1640": {
      "id": 2585921,
      "text": "Nếu bạn giỏi tranh luận, bạn có thể muốn trở thành luật sư.",
      "author": "ChatGPT4.1"
    },
    "1641": {
      "id": 2585922,
      "text": "Bạn có thích làm tóc cho người khác không?",
      "author": "ChatGPT4.1"
    },
    "1643": {
      "id": 2585923,
      "text": "Nếu bạn khéo tay, bạn có thể muốn làm thợ mộc hoặc thợ máy.",
      "author": "ChatGPT4.1"
    },
    "1644": {
      "id": 2585924,
      "text": "Nếu bạn thích đi du lịch, bạn có thể làm tiếp viên hàng không hoặc nhân viên du lịch.",
      "author": "ChatGPT4.1"
    },
    "1645": {
      "id": 2585925,
      "text": "Bạn có thể là giáo viên hoặc nhiếp ảnh gia.",
      "author": "ChatGPT4.1"
    },
    "1647": {
      "id": 2585926,
      "text": "Bạn có thể muốn trở thành họa sĩ hoặc nhà văn.",
      "author": "ChatGPT4.1"
    },
    "1649": {
      "id": 2585927,
      "text": "Bạn có thể chăm sóc động vật và trở thành bác sĩ thú y.",
      "author": "ChatGPT4.1"
    },
    "1651": {
      "id": 2585928,
      "text": "Có rất nhiều nơi để làm việc, và rất nhiều công việc để làm.",
      "author": "ChatGPT4.1"
    },
    "1652": {
      "id": 2585929,
      "text": "Có thể bạn có thể sửa máy tính hoặc làm việc ở thư viện.",
      "author": "ChatGPT4.1"
    },
    "1653": {
      "id": 2585930,
      "text": "Bạn có thể lau cửa kính hoặc làm thuyền trưởng.",
      "author": "ChatGPT4.1"
    }
  }
