  "translations": {
    "3839": {
      "id": 31558,
      "text": "Thư ký có bút và bút chì trên bàn làm việc.",
      "author": "a user"
    },
    "3843": {
      "id": 31562,
      "text": "một máy photocopy để copy các trang,",
      "author": "a user"
    },
    "3844": {
      "id": 31563,
      "text": "một cái gọt bút chì để gọt bút chì,",
      "author": "a user"
    },
    "3847": {
      "id": 31568,
      "text": "và bút xóa được sử dụng để xóa các lỗi trên một trang.",
      "author": "a user"
    },
    "3852": {
      "id": 44488,
      "text": "và sau đó là sếp trong một phòng khác.",
      "author": "a user"
    },
    "3853": {
      "id": 44491,
      "text": "Trong văn phòng thường có nhiều giấy tờ quan trọng.",
      "author": "a user"
    },
    "3855": {
      "id": 44498,
      "text": "Bạn có thể sẽ phải ký một tài liệu hoặc điền vào một mẫu đơn trong văn phòng.",
      "author": "a user"
    },
    "3858": {
      "id": 44518,
      "text": "bạn sẽ phải ghé thăm một văn phòng vào một lúc nào đó\n.",
      "author": "a user"
    },
    "3834": {
      "id": 2582338,
      "text": "Một số người làm việc trong văn phòng.",
      "author": "ChatGPT4.1"
    },
    "3835": {
      "id": 2582339,
      "text": "Có những dụng cụ đặc biệt mà người làm việc trong văn phòng cần để làm việc.",
      "author": "ChatGPT4.1"
    },
    "3836": {
      "id": 2582340,
      "text": "Trong văn phòng có một chiếc máy tính. Có một chiếc điện thoại.",
      "author": "ChatGPT4.1"
    },
    "3837": {
      "id": 2582341,
      "text": "Hầu hết thời gian, thư ký là người trả lời điện thoại.",
      "author": "ChatGPT4.1"
    },
    "3838": {
      "id": 2582342,
      "text": "Thư ký ngồi tại bàn làm việc.",
      "author": "ChatGPT4.1"
    },
    "3840": {
      "id": 2582343,
      "text": "Thư ký ghi chú trên sổ tay.",
      "author": "ChatGPT4.1"
    },
    "3841": {
      "id": 2582344,
      "text": "Một số vật dụng khác mà bạn có thể thấy trong văn phòng bao gồm:",
      "author": "ChatGPT4.1"
    },
    "3842": {
      "id": 2582345,
      "text": "một cái dập ghim để ghim các trang giấy lại với nhau,",
      "author": "ChatGPT4.1"
    },
    "3845": {
      "id": 2582346,
      "text": "một máy làm mát nước nơi nhân viên có thể uống nước,",
      "author": "ChatGPT4.1"
    },
    "3846": {
      "id": 2582347,
      "text": "một cái đục lỗ để tạo lỗ trên tờ giấy,",
      "author": "ChatGPT4.1"
    },
    "3848": {
      "id": 2582348,
      "text": "Một số văn phòng có nhiều nhân viên.",
      "author": "ChatGPT4.1"
    },
    "3849": {
      "id": 2582349,
      "text": "Tất cả các nhân viên đều có bàn làm việc riêng.",
      "author": "ChatGPT4.1"
    },
    "3850": {
      "id": 2582350,
      "text": "Một số văn phòng khác chỉ có một người ngồi tại bàn.",
      "author": "ChatGPT4.1"
    },
    "3851": {
      "id": 2582351,
      "text": "Ở một số văn phòng, có một thư ký hoặc lễ tân,",
      "author": "ChatGPT4.1"
    },
    "3854": {
      "id": 2582352,
      "text": "Giấy tờ quan trọng có thể được gọi là tài liệu.",
      "author": "ChatGPT4.1"
    },
    "3856": {
      "id": 2582353,
      "text": "Một số văn phòng có kệ sách đầy sách.",
      "author": "ChatGPT4.1"
    },
    "3857": {
      "id": 2582354,
      "text": "Những cuốn sách chứa đầy thông tin mà người làm việc trong văn phòng cần.",
      "author": "ChatGPT4.1"
    },
    "3859": {
      "id": 2582355,
      "text": "Có thể đó sẽ là văn phòng bác sĩ hoặc văn phòng luật sư.",
      "author": "ChatGPT4.1"
    },
    "3860": {
      "id": 2582356,
      "text": "Có nhiều loại văn phòng khác nhau.",
      "author": "ChatGPT4.1"
    }
  }
}
