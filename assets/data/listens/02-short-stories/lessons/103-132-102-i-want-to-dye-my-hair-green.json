  "translations": {
    "5089": {
      "id": 58939,
      "text": "Tôi nói nếu tôi không thể nhuộm tóc xanh thì tôi có thể xỏ khuyên mũi",
      "author": "a user"
    },
    "5099": {
      "id": 58949,
      "text": "Tôi không nghĩ rằng ông ấy thực sự có ý đó.",
      "author": "a user"
    },
    "5100": {
      "id": 58950,
      "text": "Mẹ tôi nói rằng khi tôi trưởng thành",
      "author": "a user"
    },
    "5102": {
      "id": 58955,
      "text": "nhưng bây giờ bà ấy muốn tôi để tóc màu tự nhiên.",
      "author": "a user"
    },
    "5104": {
      "id": 58959,
      "text": "Mẹ tôi hỏi, \"nếu tất cả bạn bè của con đều nhảy từ một vách đá, con cũng sẽ làm như vậy ư?\"",
      "author": "a user"
    },
    "5111": {
      "id": 58967,
      "text": "Tôi tự hỏi tháng tới sẽ có trào lưu gì đây.",
      "author": "a user"
    },
    "5081": {
      "id": 2589541,
      "text": "Nhiều người bạn của tôi đã nhuộm tóc các màu khác nhau.",
      "author": "ChatGPT4.1"
    },
    "5082": {
      "id": 2589542,
      "text": "Tôi không có ý nói những màu tóc bình thường như nâu hoặc đen.",
      "author": "ChatGPT4.1"
    },
    "5083": {
      "id": 2589543,
      "text": "Bạn bè tôi đã nhuộm tóc màu cam, tím và xanh dương.",
      "author": "ChatGPT4.1"
    },
    "5084": {
      "id": 2589544,
      "text": "Tôi đã nói với mẹ rằng tôi muốn nhuộm tóc màu xanh lá cây.",
      "author": "ChatGPT4.1"
    },
    "5085": {
      "id": 2589545,
      "text": "Tôi giải thích với mẹ rằng tôi chỉ sử dụng phẩm màu thực phẩm thôi.",
      "author": "ChatGPT4.1"
    },
    "5086": {
      "id": 2589546,
      "text": "Màu xanh đó sẽ không tồn tại mãi mãi.",
      "author": "ChatGPT4.1"
    },
    "5087": {
      "id": 2589547,
      "text": "Mẹ tôi nói rằng việc nhuộm tóc chỉ là một trào lưu ngớ ngẩn.",
      "author": "ChatGPT4.1"
    },
    "5088": {
      "id": 2589548,
      "text": "Mẹ nói rằng tôi sẽ không hợp với mái tóc màu xanh lá cây.",
      "author": "ChatGPT4.1"
    },
    "5090": {
      "id": 2589549,
      "text": "Mẹ tôi nói \"không\".",
      "author": "ChatGPT4.1"
    },
    "5091": {
      "id": 2589550,
      "text": "Tôi nói có lẽ một hình xăm trên cánh tay sẽ đẹp.",
      "author": "ChatGPT4.1"
    },
    "5092": {
      "id": 2589551,
      "text": "Mẹ tôi nói \"không đời nào\".",
      "author": "ChatGPT4.1"
    },
    "5093": {
      "id": 2589552,
      "text": "Mẹ tôi bảo rằng khi còn trẻ mẹ đã từng làm nhiều điều điên rồ.",
      "author": "ChatGPT4.1"
    },
    "5094": {
      "id": 2589553,
      "text": "Mẹ nói mẹ từng duỗi tóc bằng bàn ủi để cho thẳng ra.",
      "author": "ChatGPT4.1"
    },
    "5095": {
      "id": 2589554,
      "text": "Điều đó nghe có vẻ khá nhàm chán đối với tôi.",
      "author": "ChatGPT4.1"
    },
    "5096": {
      "id": 2589555,
      "text": "Bạn của tôi là Joan đã ghé qua.",
      "author": "ChatGPT4.1"
    },
    "5097": {
      "id": 2589556,
      "text": "Tóc cô ấy được nhuộm màu hồng rực rỡ.",
      "author": "ChatGPT4.1"
    },
    "5098": {
      "id": 2589557,
      "text": "Bố tôi nói \"tóc đẹp đấy, Joan\".",
      "author": "ChatGPT4.1"
    },
    "5101": {
      "id": 2589558,
      "text": "Tôi có thể nhuộm tóc bất kỳ màu nào tôi thích,",
      "author": "ChatGPT4.1"
    },
    "5103": {
      "id": 2589559,
      "text": "Tôi đã cố gắng nói với mẹ rằng tất cả bạn bè của tôi đều làm như vậy.",
      "author": "ChatGPT4.1"
    },
    "5105": {
      "id": 2589560,
      "text": "Tôi nói \"không\".",
      "author": "a user"
    },
    "5106": {
      "id": 2589561,
      "text": "Tôi nghĩ tôi sẽ phải đợi để có mái tóc xanh, nhưng có lẽ đến khi tôi đủ tuổi để nhuộm tóc xanh,",
      "author": "ChatGPT4.1"
    },
    "5107": {
      "id": 2589562,
      "text": "Tôi lại không muốn màu đó nữa.",
      "author": "ChatGPT4.1"
    },
    "5108": {
      "id": 2589563,
      "text": "Mẹ tôi nói các trào lưu thay đổi liên tục.",
      "author": "ChatGPT4.1"
    },
    "5109": {
      "id": 2589564,
      "text": "Một ngày nào đó thứ gì đó có thể nổi tiếng, rồi hôm sau lại lỗi mốt hoàn toàn.",
      "author": "ChatGPT4.1"
    },
    "5110": {
      "id": 2589565,
      "text": "Có lẽ bây giờ tôi đành phải sống mà không có mái tóc màu xanh thôi.",
