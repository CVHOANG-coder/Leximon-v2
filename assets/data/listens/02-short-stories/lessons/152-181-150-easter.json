  "translations": {
    "6673": {
      "id": 2835801,
      "text": "Theo truyền thống, Lễ Phục Sinh là một trong những dịp lễ quan trọng nhất của đạo Thiên Chúa.",
      "author": "ChatGPT4.1"
    },
    "6674": {
      "id": 2835802,
      "text": "Đối với các tín đồ Thiên Chúa giáo, Lễ Phục Sinh kỷ niệm cái chết của Chúa Giê-su,",
      "author": "ChatGPT4.1"
    },
    "6675": {
      "id": 2835803,
      "text": "người đã hy sinh vì lợi ích của toàn nhân loại.",
      "author": "ChatGPT4.1"
    },
    "6676": {
      "id": 2835804,
      "text": "Ngày cụ thể tổ chức Lễ Phục Sinh thay đổi mỗi năm,",
      "author": "ChatGPT4.1"
    },
    "6677": {
      "id": 2835805,
      "text": "nhưng luôn diễn ra vào đầu mùa xuân, thường là vào tháng Ba hoặc tháng Tư.",
      "author": "ChatGPT4.1"
    },
    "6678": {
      "id": 2835806,
      "text": "Có hai ngày rất quan trọng tạo nên dịp Lễ Phục Sinh,",
      "author": "ChatGPT4.1"
    },
    "6679": {
      "id": 2835807,
      "text": "được tổ chức vào mùa xuân.",
      "author": "ChatGPT4.1"
    },
    "6680": {
      "id": 2835808,
      "text": "Ngày đầu tiên trong số những ngày này được gọi là Thứ Sáu Tuần Thánh.",
      "author": "a user"
    },
    "6681": {
      "id": 2835809,
      "text": "Tín đồ Thiên Chúa giáo xem Thứ Sáu Tuần Thánh là ngày Chúa Giê-su chịu đau khổ và chết thay cho nhân loại.",
      "author": "a user"
    },
    "6682": {
      "id": 2835810,
      "text": "Ngày thứ hai trong số này được gọi là Chủ Nhật Phục Sinh.",
      "author": "ChatGPT4.1"
    },
    "6683": {
      "id": 2835811,
      "text": "Chủ Nhật Phục Sinh diễn ra hai ngày sau Thứ Sáu Tuần Thánh.",
      "author": "ChatGPT4.1"
    },
    "6684": {
      "id": 2835812,
      "text": "Các tín đồ Thiên Chúa giáo kỷ niệm Chủ Nhật Phục Sinh",
      "author": "ChatGPT4.1"
    },
    "6685": {
      "id": 2835813,
      "text": "như là ngày Chúa Giê-su sống lại từ cõi chết và lên Thiên Đàng.",
      "author": "ChatGPT4.1"
    },
    "6686": {
      "id": 2835814,
      "text": "Đối với Ki Tô hữu, Lễ Phục Sinh là dịp lễ trang trọng nhất trong năm.",
      "author": "a user"
    },
    "6687": {
      "id": 2835815,
      "text": "Nhiều người tham dự các buổi lễ nhà thờ vào Thứ Sáu Tuần Thánh và Chủ Nhật Phục Sinh.",
      "author": "ChatGPT4.1"
    },
    "6688": {
      "id": 2835816,
      "text": "Lễ Phục Sinh cũng là thời điểm để vui chơi, ăn mừng.",
      "author": "ChatGPT4.1"
    },
    "6689": {
      "id": 2835817,
      "text": "Một số truyền thống của Lễ Phục Sinh bắt nguồn từ những lễ hội mùa xuân cổ xưa",
      "author": "ChatGPT4.1"
    },
    "6690": {
      "id": 2835818,
      "text": "từng tồn tại trước cả khi đạo Thiên Chúa xuất hiện.",
      "author": "ChatGPT4.1"
    },
    "6691": {
      "id": 2835819,
      "text": "Một trong những truyền thống liên quan đến lễ Phục sinh là vẽ trứng Phục sinh.",
      "author": "a user"
    },
    "6692": {
      "id": 2835820,
      "text": "Người ta lấy trứng gà, đục rỗng bên trong, sau đó sơn lên những màu sắc rực rỡ.",
      "author": "ChatGPT4.1"
    },
    "6693": {
      "id": 2835821,
      "text": "Có người còn vẽ những hoa văn rất đẹp và phức tạp lên trứng Phục Sinh.",
      "author": "ChatGPT4.1"
    },
    "6694": {
      "id": 2835822,
      "text": "Một truyền thống khác của Lễ Phục Sinh là Thỏ Phục Sinh.",
      "author": "ChatGPT4.1"
    },
    "6695": {
      "id": 2835823,
      "text": "Theo truyền thuyết, Thỏ Phục Sinh là một chú thỏ thần kỳ",
      "author": "ChatGPT4.1"
    },
    "6696": {
      "id": 2835824,
      "text": "sẽ ghé thăm các ngôi nhà có trẻ em vào đêm trước Chủ Nhật Phục Sinh.",
      "author": "ChatGPT4.1"
    },
    "6697": {
      "id": 2835825,
      "text": "Thỏ Phục Sinh sẽ giấu các viên kẹo sô-cô-la hình trứng khắp nhà của những đứa trẻ.",
      "author": "ChatGPT4.1"
    },
    "6698": {
      "id": 2835826,
      "text": "Vào sáng Chủ Nhật Phục Sinh,",
      "author": "ChatGPT4.1"
    },
    "6699": {
      "id": 2835827,
      "text": "trẻ em sẽ đi tìm khắp nhà để thu thập những món quà ngọt ngào được giấu kín này!",
      "author": "ChatGPT4.1"
    },
    "6700": {
      "id": 2835828,
      "text": "Lễ Phục Sinh là một dịp quan trọng, vừa là ngày lễ tôn giáo, vừa là lễ hội chào đón mùa xuân.",
      "author": "ChatGPT4.1"
    }
  }
}
