  "translations": {
    "4165": {
      "id": 21190,
      "text": "Cha tôi rất hạnh phúc vì họ là cha mẹ của ông ấy",
      "author": "a user"
    },
    "4166": {
      "id": 21191,
      "text": "và anh ấy rất vui vì anh ấy sẽ nhìn thấy họ.",
      "author": "a user"
    },
    "4171": {
      "id": 21202,
      "text": "Chú Bill đã kết hôn với dì (thím) Susan của tôi.",
      "author": "a user"
    },
    "4173": {
      "id": 21206,
      "text": "Chị họ của tôi lớn hơn tôi rất nhiều,",
      "author": "a user"
    },
    "4178": {
      "id": 21214,
      "text": "và các trò chơi giống nhau.",
      "author": "a user"
    },
    "4180": {
      "id": 21217,
      "text": "Các em trai của tôi đều trẻ hơn tôi.",
      "author": "a user"
    },
    "4182": {
      "id": 21221,
      "text": "Chị gái tôi hơn tôi một tuổi.",
      "author": "a user"
    },
    "4185": {
      "id": 21228,
      "text": "Ông bà ngoại của tôi sống gần nhà chúng tôi",
      "author": "a user"
    },
    "4186": {
      "id": 21230,
      "text": "Họ là bà ngoại và ông ngoại của tôi, những người thường xuyên đến thăm chúng tôi.",
      "author": "a user"
    },
    "4188": {
      "id": 21239,
      "text": "Mẹ tôi là con một.",
      "author": "a user"
    },
    "4189": {
      "id": 21241,
      "text": "Tôi thích thời gian khi mà cả gia đình tôi ở bên nhau.",
      "author": "a user"
    },
    "4192": {
      "id": 21249,
      "text": "Chú tôi thường đưa tôi và em họ đi xem phim.",
      "author": "a user"
    },
    "4164": {
      "id": 2589813,
      "text": "Ông bà tôi sẽ đến thăm chúng tôi từ Calgary, Alberta.",
      "author": "ChatGPT4.1"
    },
    "4167": {
      "id": 2589814,
      "text": "Chúng tôi không thường xuyên gặp họ vì Calgary cách xa Toronto.",
      "author": "ChatGPT4.1"
    },
    "4169": {
      "id": 2589815,
      "text": "Ông bà tôi có hai người con trai:",
      "author": "ChatGPT4.1"
    },
    "4170": {
      "id": 2589816,
      "text": "bố tôi và chú Bill của tôi.",
      "author": "ChatGPT4.1"
    },
    "4172": {
      "id": 2589817,
      "text": "Họ có một con gái là chị họ của tôi.",
      "author": "ChatGPT4.1"
    },
    "4174": {
      "id": 2589818,
      "text": "nên chúng tôi không có nhiều điểm chung.",
      "author": "ChatGPT4.1"
    },
    "4175": {
      "id": 2589819,
      "text": "Họ cũng có một con trai cùng tuổi với tôi.",
      "author": "ChatGPT4.1"
    },
    "4176": {
      "id": 2589820,
      "text": "Cậu ấy là anh họ mà tôi yêu thích nhất",
      "author": "ChatGPT4.1"
    },
    "4177": {
      "id": 2589821,
      "text": "vì chúng tôi đều thích cùng một chương trình truyền hình",
      "author": "ChatGPT4.1"
    },
    "4179": {
      "id": 2589822,
      "text": "Tôi có hai em trai và một chị gái.",
      "author": "ChatGPT4.1"
    },
    "4181": {
      "id": 2589823,
      "text": "Hai em là sinh đôi nên có chung ngày sinh nhật.",
      "author": "ChatGPT4.1"
    },
    "4183": {
      "id": 2589824,
      "text": "Mọi người nói rằng tôi và chị rất giống nhau.",
      "author": "ChatGPT4.1"
    },
    "4184": {
      "id": 2589825,
      "text": "Chúng tôi đều có tóc vàng và mắt xanh.",
      "author": "ChatGPT4.1"
    },
    "4187": {
      "id": 2589826,
      "text": "Mẹ tôi không có anh chị em.",
      "author": "ChatGPT4.1"
    },
    "4190": {
      "id": 2589827,
      "text": "Tôi không có nhiều anh chị em họ như nhiều người khác,",
      "author": "ChatGPT4.1"
    },
    "4191": {
      "id": 2589828,
      "text": "nhưng tôi luôn vui vẻ với những người họ hàng của mình.",
      "author": "a user"
    },
    "4193": {
      "id": 2589829,
      "text": "Tôi thích đưa ông bà đi dạo",
      "author": "a user"
    },
    "4194": {
      "id": 2589830,
      "text": "để ông bà có thể xem trường tôi, và gặp gỡ bạn bè của tôi.",
      "author": "ChatGPT4.1"
    },
    "4195": {
      "id": 2604014,
      "text": "Bố mẹ tôi nói chuyện rất nhiều với các em trai, chị gái và tôi.",
      "author": "ChatGPT4.1"
    },
    "4196": {
      "id": 2604015,
      "text": "Chúng tôi là một gia đình rất gắn bó.",
      "author": "ChatGPT4.1"
    },
    "4197": {
      "id": 2604016,
      "text": "Những người có gia đình thân thiết là rất may mắn.",
      "author": "ChatGPT4.1"
    }
  }
