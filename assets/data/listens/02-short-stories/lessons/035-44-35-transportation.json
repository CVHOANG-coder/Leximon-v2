  "translations": {
    "1546": {
      "id": 11545,
      "text": "Nếu bố tôi lấy xe đi làm thì mẹ tôi đi xe buýt.",
      "author": "a user"
    },
    "1548": {
      "id": 11549,
      "text": "Chị gái tôi làm việc ở một thị trấn khác.",
      "author": "a user"
    },
    "1553": {
      "id": 11658,
      "text": "Ông đã đến bằng thuyền.",
      "author": "a user"
    },
    "1554": {
      "id": 11659,
      "text": "Ông phải vượt đại dương.",
      "author": "a user"
    },
    "1557": {
      "id": 11662,
      "text": "Máy bay đã bay xuyên thẳng qua những đám mây.",
      "author": "a user"
    },
    "1561": {
      "id": 11680,
      "text": "Tôi phải ngồi ở sau và giữ chặt.",
      "author": "a user"
    },
    "1563": {
      "id": 11708,
      "text": "Tôi cũng có một chiếc xe tay ga mà tôi sử dụng để di chuyển xung quanh.",
      "author": "a user"
    },
    "1565": {
      "id": 11725,
      "text": "Cánh quạt của trực thăng vẫn đang quay khi tôi bước lên.",
      "author": "a user"
    },
    "1569": {
      "id": 11751,
      "text": "Tôi thích bay trong không trung",
      "author": "a user"
    },
    "1542": {
      "id": 2586798,
      "text": "Mỗi gia đình mà tôi biết đều có ít nhất một chiếc ô tô.",
      "author": "ChatGPT4.1"
    },
    "1543": {
      "id": 2586799,
      "text": "Một số gia đình có hai, thậm chí ba chiếc ô tô.",
      "author": "ChatGPT4.1"
    },
    "1544": {
      "id": 2586800,
      "text": "Hầu hết mọi người lấy giấy phép lái xe khi họ mười sáu tuổi.",
      "author": "ChatGPT4.1"
    },
    "1545": {
      "id": 2586801,
      "text": "Nhà tôi chỉ có một chiếc ô tô.",
      "author": "ChatGPT4.1"
    },
    "1547": {
      "id": 2586802,
      "text": "Tôi đi xe buýt trường đến trường học.",
      "author": "ChatGPT4.1"
    },
    "1549": {
      "id": 2586803,
      "text": "Chị ấy đi tàu để đi làm.",
      "author": "ChatGPT4.1"
    },
    "1550": {
      "id": 2586804,
      "text": "Nhà ga tàu hoả không xa nhà tôi.",
      "author": "a user"
    },
    "1551": {
      "id": 2586805,
      "text": "Đường ray tàu hỏa chạy ngay cạnh nhà tôi.",
      "author": "ChatGPT4.1"
    },
    "1552": {
      "id": 2586806,
      "text": "Ông tôi từ Ireland đến thăm chúng tôi.",
      "author": "ChatGPT4.1"
    },
    "1555": {
      "id": 2586807,
      "text": "Chúng tôi đã đi Florida năm ngoái.",
      "author": "ChatGPT4.1"
    },
    "1556": {
      "id": 2586808,
      "text": "Chúng tôi bay bằng máy bay.",
      "author": "ChatGPT4.1"
    },
    "1558": {
      "id": 2586809,
      "text": "Anh trai của bạn tôi lái một chiếc xe máy.",
      "author": "ChatGPT4.1"
    },
    "1559": {
      "id": 2586810,
      "text": "Anh ấy đội mũ bảo hiểm.",
      "author": "ChatGPT4.1"
    },
    "1560": {
      "id": 2586811,
      "text": "Tôi đã từng ngồi trên xe máy của anh ấy một lần.",
      "author": "ChatGPT4.1"
    },
    "1562": {
      "id": 2586812,
      "text": "Tôi đi xe đạp khi thời tiết đẹp.",
      "author": "ChatGPT4.1"
    },
    "1564": {
      "id": 2586813,
      "text": "Tôi đã từng đi trực thăng một lần.",
      "author": "ChatGPT4.1"
    },
    "1566": {
      "id": 2586814,
      "text": "Tôi bay thẳng lên trời.",
      "author": "ChatGPT4.1"
    },
    "1567": {
      "id": 2586815,
      "text": "Tôi rất thích chuyến đi đó.",
      "author": "ChatGPT4.1"
    },
    "1568": {
      "id": 2586816,
      "text": "Tôi muốn học cách lái máy bay hoặc trực thăng.",
      "author": "ChatGPT4.1"
    }
  }
}
