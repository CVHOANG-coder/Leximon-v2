  "translations": {
    "3644": {
      "id": 21907,
      "text": "Một số người trang trí bằng những dải dây ruy băng và những quả bóng bay.",
      "author": "a user"
    },
    "3652": {
      "id": 22001,
      "text": "Có những bữa tiệc khác nơi mà bạn phải mặc trang phục hóa trang.",
      "author": "a user"
    },
    "3655": {
      "id": 22018,
      "text": "Tiệc chia tay, và tiệc tùng không vì lý do gì cả.\n",
      "author": "a user"
    },
    "3663": {
      "id": 22582,
      "text": "Tất cả các buổi tiệc đều khác nhau.",
      "author": "a user"
    },
    "3638": {
      "id": 2586467,
      "text": "Các bữa tiệc có thể rất vui.",
      "author": "ChatGPT4.1"
    },
    "3639": {
      "id": 2586468,
      "text": "Mọi người được mời đến các bữa tiệc.",
      "author": "ChatGPT4.1"
    },
    "3640": {
      "id": 2586469,
      "text": "Bạn có thể tổ chức một bữa tiệc vì đó là một dịp đặc biệt,",
      "author": "ChatGPT4.1"
    },
    "3641": {
      "id": 2586470,
      "text": "hoặc chỉ đơn giản là bạn muốn tổ chức một bữa tiệc.",
      "author": "ChatGPT4.1"
    },
    "3642": {
      "id": 2586471,
      "text": "Đôi khi, mọi người đội mũ giấy ở các bữa tiệc.",
      "author": "ChatGPT4.1"
    },
    "3643": {
      "id": 2586472,
      "text": "Những chiếc mũ này được gọi là mũ tiệc.",
      "author": "ChatGPT4.1"
    },
    "3645": {
      "id": 2586473,
      "text": "Ở một số bữa tiệc, có bánh ngọt.",
      "author": "ChatGPT4.1"
    },
    "3646": {
      "id": 2586474,
      "text": "Đôi khi, chỉ có đồ ăn nhẹ và đồ uống.",
      "author": "ChatGPT4.1"
    },
    "3647": {
      "id": 2586475,
      "text": "Ở một số bữa tiệc, mọi người chơi trò chơi.",
      "author": "ChatGPT4.1"
    },
    "3648": {
      "id": 2586476,
      "text": "Cũng có những bữa tiệc mà mọi người chỉ đứng quanh và trò chuyện.",
      "author": "ChatGPT4.1"
    },
    "3649": {
      "id": 2586477,
      "text": "Mọi người mặc nhiều loại trang phục khác nhau đến các bữa tiệc.",
      "author": "ChatGPT4.1"
    },
    "3650": {
      "id": 2586478,
      "text": "Bạn có thể đến một số bữa tiệc trong trang phục thường ngày.",
      "author": "ChatGPT4.1"
    },
    "3651": {
      "id": 2586479,
      "text": "Ở những bữa tiệc khác, bạn cần mặc trang phục đẹp.",
      "author": "ChatGPT4.1"
    },
    "3653": {
      "id": 2586480,
      "text": "Có rất nhiều loại tiệc khác nhau.",
      "author": "ChatGPT4.1"
    },
    "3654": {
      "id": 2586481,
      "text": "Có tiệc Giáng sinh, tiệc sinh nhật,",
      "author": "ChatGPT4.1"
    },
    "3656": {
      "id": 2586482,
      "text": "Tôi đã từng tham dự các buổi tiệc cho những người nghỉ hưu,",
      "author": "ChatGPT4.1"
    },
    "3657": {
      "id": 2586483,
      "text": "hoặc cho những người vừa có em bé.",
      "author": "ChatGPT4.1"
    },
    "3658": {
      "id": 2586484,
      "text": "Có hàng trăm lý do để tổ chức một bữa tiệc.",
      "author": "ChatGPT4.1"
    },
    "3659": {
      "id": 2586485,
      "text": "Ở một số bữa tiệc, bạn mang theo một món quà.",
      "author": "ChatGPT4.1"
    },
    "3660": {
      "id": 2586486,
      "text": "Nếu đó là tiệc sinh nhật,",
      "author": "ChatGPT4.1"
    },
    "3661": {
      "id": 2586487,
      "text": "bạn sẽ mang theo một món quà và một tấm thiệp sinh nhật cho người có sinh nhật đó.",
      "author": "ChatGPT4.1"
    },
    "3662": {
      "id": 2586488,
      "text": "Đôi khi, mọi người sẽ nhờ bạn mang theo đồ ăn hoặc đồ uống đến bữa tiệc.",
      "author": "ChatGPT4.1"
    },
    "3664": {
      "id": 2586489,
      "text": "Thật vui khi được mời đến các bữa tiệc.",
      "author": "ChatGPT4.1"
    }
  }
}
