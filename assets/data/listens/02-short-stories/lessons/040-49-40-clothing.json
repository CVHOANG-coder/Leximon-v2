  "translations": {
    "1689": {
      "id": 10093,
      "text": "Nếu tôi định chơi thể thao, tôi mặc áo nỉ và quần jean.",
      "author": "a user"
    },
    "1692": {
      "id": 10096,
      "text": "Tại nơi làm việc, tôi mặc váy và áo sơ mi kiểu nữ.",
      "author": "a user"
    },
    "1693": {
      "id": 10098,
      "text": "Bên dưới lớp quần áo của tôi, tôi mặc đồ lót.",
      "author": "a user"
    },
    "1694": {
      "id": 10101,
      "text": "Một quý bà mặc áo lót và quần lót như đồ lót.",
      "author": "a user"
    },
    "1695": {
      "id": 10105,
      "text": "Một người đàn ông mặc quần đùi hoặc quần đùi bó sát người làm đồ lót.",
      "author": "a user"
    },
    "1696": {
      "id": 10107,
      "text": "Hôm nay, tôi mặc một chiếc áo sơ mi kiểu và một chiếc quần jean bên ngoài quần áo lót.",
      "author": "a user"
    },
    "1698": {
      "id": 10112,
      "text": "Vào mùa hè, tôi thường đi dép xăng-đan vào chân.",
      "author": "a user"
    },
    "1699": {
      "id": 10114,
      "text": "Vào mùa hè, những chiếc áo mà tôi mặc thường sát nách.",
      "author": "a user"
    },
    "1703": {
      "id": 10120,
      "text": "Tôi đeo thắt lưng để giữ quần jean hoặc quần tây của mình.",
      "author": "a user"
    },
    "1704": {
      "id": 10121,
      "text": "Phụ nữ đôi khi mặc một chiếc váy đầm hoặc một chiếc váy ngắn.",
      "author": "a user"
    },
    "1705": {
      "id": 10122,
      "text": "Nam giới mặc quần tây, áo sơ mi.",
      "author": "a user"
    },
    "1708": {
      "id": 10127,
      "text": "Nếu trời lạnh, tôi thích đeo găng tay hoặc bao tay len trên tay của tôi",
      "author": "a user"
    },
    "1710": {
      "id": 10130,
      "text": "Tôi đội một chiếc mũ bằng len trên đầu trong thời tiết lạnh giá.",
      "author": "a user"
    },
    "1686": {
      "id": 2629660,
      "text": "Tôi thay quần áo rất nhiều.",
      "author": "ChatGPT4.1"
    },
    "1687": {
      "id": 2629661,
      "text": "Nếu tôi đi đến một nơi sang trọng, tôi mặc váy.",
      "author": "ChatGPT4.1"
    },
    "1688": {
      "id": 2629662,
      "text": "Tôi mang tất dài ở chân, và tôi đi một đôi giày đẹp.",
      "author": "ChatGPT4.1"
    },
    "1690": {
      "id": 2629663,
      "text": "Nếu tôi đi biển, tôi mặc đồ tắm hoặc bikini.",
      "author": "ChatGPT4.1"
    },
    "1691": {
      "id": 2629664,
      "text": "Em trai tôi mặc quần tắm khi ra biển.",
      "author": "ChatGPT4.1"
    },
    "1697": {
      "id": 2629665,
      "text": "Tôi đi tất và giày ở chân.",
      "author": "ChatGPT4.1"
    },
    "1700": {
      "id": 2629666,
      "text": "Tôi thường mặc quần short vào mùa hè.",
      "author": "ChatGPT4.1"
    },
    "1701": {
      "id": 2629667,
      "text": "Đôi khi, tôi mặc áo len hoặc áo khoác nếu thời tiết mát.",
      "author": "ChatGPT4.1"
    },
    "1702": {
      "id": 2629668,
      "text": "Tôi đội mũ lưỡi trai hoặc mũ trên đầu.",
      "author": "ChatGPT4.1"
    },
    "1706": {
      "id": 2629669,
      "text": "Một số đàn ông mặc bộ vest, áo sơ mi và cà vạt.",
      "author": "ChatGPT4.1"
    },
    "1707": {
      "id": 2629670,
      "text": "Nếu bên ngoài rất lạnh, tôi mặc áo khoác mùa đông.",
      "author": "ChatGPT4.1"
    },
    "1709": {
      "id": 2629671,
      "text": "Đôi khi, tôi quấn khăn quanh cổ để giữ ấm.",
      "author": "ChatGPT4.1"
    },
    "1711": {
      "id": 2629672,
      "text": "Tôi đi ủng vào mùa đông.",
      "author": "ChatGPT4.1"
    },
    "1712": {
      "id": 2629673,
      "text": "Nếu trời mưa, tôi mặc áo mưa.",
      "author": "ChatGPT4.1"
    },
    "1713": {
      "id": 2629674,
      "text": "Cách tôi ăn mặc phụ thuộc rất nhiều vào thời tiết.",
      "author": "ChatGPT4.1"
    }
  }
}
