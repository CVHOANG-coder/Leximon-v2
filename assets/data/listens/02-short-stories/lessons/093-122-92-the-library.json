  "translations": {
    "4784": {
      "id": 1151,
      "text": "Thư viện là một trong những nơi tôi yêu thích nhất.",
      "author": "a user"
    },
    "4790": {
      "id": 1162,
      "text": "Vào mùa đông, tôi phải đọc sách để học ở trường.",
      "author": "a user"
    },
    "4797": {
      "id": 1212,
      "text": "Bây giờ tôi có thể tự thực hiện tất cả việc nghiên cứu của mình.",
      "author": "a user"
    },
    "4800": {
      "id": 1222,
      "text": "Tôi luôn mang trả sách đúng hạn để không bị phạt.",
      "author": "a user"
    },
    "4801": {
      "id": 1262,
      "text": "Tôi đang sưu tầm sách ở nhà.",
      "author": "a user"
    },
    "4808": {
      "id": 1284,
      "text": "Tại thư viện cũng có các đĩa CD.",
      "author": "a user"
    },
    "4809": {
      "id": 1285,
      "text": "Tôi có thẻ thư viện nên tôi có thể lấy sách,",
      "author": "a user"
    },
    "4818": {
      "id": 1304,
      "text": "Mẹ tôi nói rằng đọc sách là một thói quen tốt nên hình thành",
      "author": "a user"
    },
    "4785": {
      "id": 2593187,
      "text": "Tôi đến đó để mượn sách cho việc học ở trường,",
      "author": "ChatGPT4.1"
    },
    "4786": {
      "id": 2593188,
      "text": "và tôi đến đó để mượn sách giải trí.",
      "author": "ChatGPT4.1"
    },
    "4787": {
      "id": 2593189,
      "text": "Tôi thường đọc truyện trinh thám để giải trí.",
      "author": "ChatGPT4.1"
    },
    "4788": {
      "id": 2593190,
      "text": "Vào mùa hè, tôi đọc rất nhiều truyện trinh thám.",
      "author": "ChatGPT4.1"
    },
    "4789": {
      "id": 2593191,
      "text": "Tôi thích ngồi ngoài trời và đọc sách.",
      "author": "ChatGPT4.1"
    },
    "4791": {
      "id": 2593192,
      "text": "Tôi đến thư viện để tìm hiểu thông tin cho các dự án của mình.",
      "author": "ChatGPT4.1"
    },
    "4792": {
      "id": 2593193,
      "text": "Tôi thường sử dụng từ điển và bản đồ.",
      "author": "ChatGPT4.1"
    },
    "4793": {
      "id": 2593194,
      "text": "Một số người bạn của tôi đi cùng tôi, rồi chúng tôi ngồi vào bàn và làm bài tập về nhà.",
      "author": "a user"
    },
    "4794": {
      "id": 2593195,
      "text": "Chúng tôi không được gây nhiều tiếng ồn trong thư viện. Mọi người phải giữ im lặng khi ở trong thư viện.",
      "author": "a user"
    },
    "4795": {
      "id": 2593196,
      "text": "Khi lần đầu tiên tôi đến thư viện, tôi đã bối rối về cách tìm sách.",
      "author": "ChatGPT4.1"
    },
    "4796": {
      "id": 2593197,
      "text": "Thủ thư đã chỉ cho tôi cách sử dụng máy tính để tìm sách.",
      "author": "ChatGPT4.1"
    },
    "4798": {
      "id": 2593198,
      "text": "Tôi đã đọc một số cuốn sách rất thú vị.",
      "author": "ChatGPT4.1"
    },
    "4799": {
      "id": 2593199,
      "text": "Tôi đã học được rất nhiều điều từ những cuốn sách trong thư viện.",
      "author": "ChatGPT4.1"
    },
    "4802": {
      "id": 2593200,
      "text": "Mọi người thường tặng tôi sách làm quà.",
      "author": "ChatGPT4.1"
    },
    "4803": {
      "id": 2593201,
      "text": "Chẳng bao lâu nữa tôi sẽ có thư viện riêng của mình.",
      "author": "ChatGPT4.1"
    },
    "4804": {
      "id": 2593202,
      "text": "Đọc sách là một sở thích tốt.",
      "author": "ChatGPT4.1"
    },
    "4805": {
      "id": 2593203,
      "text": "Mọi người trong gia đình tôi đều thích đọc sách.",
      "author": "ChatGPT4.1"
    },
    "4806": {
      "id": 2593204,
      "text": "Thư viện còn có những thứ khác ngoài sách.",
      "author": "ChatGPT4.1"
    },
    "4807": {
      "id": 2593205,
      "text": "Có các băng đĩa video ở thư viện.",
      "author": "ChatGPT4.1"
    },
    "4810": {
      "id": 2593206,
      "text": "băng đĩa video hoặc đĩa CD bất cứ khi nào tôi muốn.",
      "author": "ChatGPT4.1"
    },
    "4811": {
      "id": 2593207,
      "text": "Mẹ tôi đôi khi đến thư viện để xem tạp chí.",
      "author": "ChatGPT4.1"
    },
    "4812": {
      "id": 2593208,
      "text": "Bà ấy tìm được vài công thức nấu ăn ngon từ tạp chí.",
      "author": "ChatGPT4.1"
    },
    "4813": {
      "id": 2593209,
      "text": "Bố tôi tìm sách về cách xây dựng mọi thứ.",
      "author": "ChatGPT4.1"
    },
    "4814": {
      "id": 2595267,
      "text": "Hiện tại bố tôi đang đóng một số kệ sách cho tôi.",
      "author": "a user"
    },
    "4815": {
      "id": 2595268,
      "text": "Ông ấy đã tìm thấy hướng dẫn trong một cuốn sách.",
      "author": "ChatGPT4.1"
    },
    "4816": {
      "id": 2595269,
      "text": "Em trai tôi đọc sách thiếu nhi. Nó thích những cuốn sách về tàu hỏa.",
      "author": "ChatGPT4.1"
    },
    "4817": {
      "id": 2595270,
      "text": "Tôi đã thích sách từ khi còn rất nhỏ.",
      "author": "ChatGPT4.1"
    }
  }
