  "translations": {
    "1384": {
      "id": 7887,
      "text": "Tôi thích những người tốt giành chiến thắng.",
      "author": "a user"
    },
    "1389": {
      "id": 7967,
      "text": "Tôi không thích những thứ đó.",
      "author": "a user"
    },
    "1391": {
      "id": 7970,
      "text": "Cô ấy có rất nhiều nam và nữ diễn viên yêu thích.",
      "author": "a user"
    },
    "1392": {
      "id": 7971,
      "text": "Đôi khi cô ấy xem những bộ phim buồn khiến cô ấy khóc.",
      "author": "a user"
    },
    "1395": {
      "id": 7979,
      "text": "Bố của tôi thích phim kinh dị.",
      "author": "a user"
    },
    "1396": {
      "id": 7982,
      "text": "Ông ấy thích những bộ phim có quái vật trong đó.",
      "author": "a user"
    },
    "1397": {
      "id": 7987,
      "text": "Ông ấy cũng thích phim kịch tính.",
      "author": "a user"
    },
    "1398": {
      "id": 8000,
      "text": "Tôi đã xem một số bộ phim kinh dị khiến bạn căng thẳng và đứng ngồi không yên",
      "author": "a user"
    },
    "1400": {
      "id": 8021,
      "text": "Em trai tôi thích những bộ phim hoạt hình.",
      "author": "a user"
    },
    "1402": {
      "id": 8028,
      "text": "Anh trai tôi đi xem phim vào các buổi chiều thứ bảy với bạn bè của anh ấy",
      "author": "a user"
    },
    "1403": {
      "id": 8029,
      "text": "Cậu ấy đi xem suất chiếu buổi chiều",
      "author": "a user"
    },
    "1404": {
      "id": 8031,
      "text": "Anh ấy mua bỏng ngô, kẹo và nước ngọt.",
      "author": "a user"
    },
    "1409": {
      "id": 8047,
      "text": "Tôi thỉnh thoảng xem phim tài liệu với ông ấy, nhưng tôi thích xem phim hành động hơn.",
      "author": "a user"
    },
    "1379": {
      "id": 2588371,
      "text": "Tôi đi xem phim gần như mỗi tuần.",
      "author": "ChatGPT4.1"
    },
    "1380": {
      "id": 2588372,
      "text": "Đôi khi, tôi thuê phim từ cửa hàng băng đĩa.",
      "author": "ChatGPT4.1"
    },
    "1381": {
      "id": 2588373,
      "text": "Những bộ phim yêu thích của tôi là phim hành động.",
      "author": "ChatGPT4.1"
    },
    "1382": {
      "id": 2588374,
      "text": "Tôi thích xem các cảnh rượt đuổi bằng xe hơi.",
      "author": "ChatGPT4.1"
    },
    "1383": {
      "id": 2588375,
      "text": "Tôi thích khi nhân vật xấu đấu súng với những người tốt.",
      "author": "ChatGPT4.1"
    },
    "1385": {
      "id": 2588376,
      "text": "Tôi cũng thích phim khoa học viễn tưởng.",
      "author": "ChatGPT4.1"
    },
    "1386": {
      "id": 2588377,
      "text": "Tôi thích những điều xảy ra trong tương lai.",
      "author": "ChatGPT4.1"
    },
    "1387": {
      "id": 2588378,
      "text": "Tôi thích những bộ phim có người ngoài hành tinh từ các hành tinh khác.",
      "author": "ChatGPT4.1"
    },
    "1388": {
      "id": 2588379,
      "text": "Một số phim khoa học viễn tưởng có thể ngớ ngẩn và khó tin.",
      "author": "ChatGPT4.1"
    },
    "1390": {
      "id": 2588380,
      "text": "Mẹ tôi thích phim tâm lý.",
      "author": "ChatGPT4.1"
    },
    "1393": {
      "id": 2588381,
      "text": "Bà cũng thích phim hài.",
      "author": "ChatGPT4.1"
    },
    "1394": {
      "id": 2588382,
      "text": "Bà cười lớn nếu phim hài rất vui nhộn.",
      "author": "ChatGPT4.1"
    },
    "1399": {
      "id": 2588383,
      "text": "Đôi khi, tôi phải nhắm mắt lại nếu phim quá đáng sợ.",
      "author": "ChatGPT4.1"
    },
    "1401": {
      "id": 2588384,
      "text": "Trong phim hoạt hình, không có diễn viên mà chỉ có các nhân vật hoạt hình.",
      "author": "ChatGPT4.1"
    },
    "1405": {
      "id": 2588385,
      "text": "Cậu thường về nhà với cái bụng đau vì ăn quá nhiều.",
      "author": "ChatGPT4.1"
    },
    "1406": {
      "id": 2588386,
      "text": "Đôi khi, bố tôi xem phim tài liệu.",
      "author": "ChatGPT4.1"
    },
    "1407": {
      "id": 2588387,
      "text": "Phim tài liệu là về những điều có thật.",
      "author": "ChatGPT4.1"
    },
    "1408": {
      "id": 2588388,
      "text": "Bạn có thể học được rất nhiều khi xem phim tài liệu.",
      "author": "ChatGPT4.1"
    }
  }
}
