    },
    "794": {
      "id": 5101,
      "text": "Mỗi lần luyện tập dài hai giờ",
      "author": "a user"
    },
    "795": {
      "id": 5106,
      "text": "Mark chơi một trận mỗi tuần.",
      "author": "a user"
    },
    "803": {
      "id": 5135,
      "text": "Các huấn luyện viên sẽ đến xem Mark thi đấu.",
      "author": "a user"
    },
    "807": {
      "id": 5151,
      "text": "Cha mẹ của Mark muốn anh ấy học đại học.",
      "author": "a user"
    },
    "808": {
      "id": 5156,
      "text": "Họ muốn anh ấy được học hành",
      "author": "a user"
    },
    "791": {
      "id": 2582324,
      "text": "Môn thể thao yêu thích của Mark là khúc côn cầu.",
      "author": "ChatGPT4.1"
    },
    "792": {
      "id": 2582325,
      "text": "Cậu ấy 15 tuổi.",
      "author": "ChatGPT4.1"
    },
    "796": {
      "id": 2582326,
      "text": "Mark là một cầu thủ khúc côn cầu giỏi.",
      "author": "ChatGPT4.1"
    },
    "797": {
      "id": 2582327,
      "text": "Cậu ấy chơi vào mỗi tối thứ sáu.",
      "author": "a user"
    },
    "798": {
      "id": 2582328,
      "text": "Các trận khúc côn cầu vào tối thứ sáu rất được yêu thích.",
      "author": "a user"
    },
    "799": {
      "id": 2582329,
      "text": "Gia đình của Mark xem cậu ấy thi đấu.",
      "author": "ChatGPT4.1"
    },
    "800": {
      "id": 2582330,
      "text": "Bạn bè của Mark cũng xem cậu ấy thi đấu.",
