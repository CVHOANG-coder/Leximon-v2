  "translations": {
    "5946": {
      "id": 27952,
      "text": "Có một bản nhạc organ tuyệt vời đang chơi.",
      "author": "a user"
    },
    "5950": {
      "id": 27957,
      "text": "Cô ấy đây rồi!",
      "author": "a user"
    },
    "5953": {
      "id": 27961,
      "text": "Tóc cô ấy được chải gọn không làm che khuất khuôn mặt.",
      "author": "a user"
    },
    "5955": {
      "id": 27966,
      "text": "Thay vì đội voan cô dâu, cô ấy cài những bông hoa nhỏ trên tóc.",
      "author": "a user"
    },
    "5961": {
      "id": 27975,
      "text": "Anh nắm tay cô dâu của mình khi bố cô ấy để lại cô ấy ở đó.",
      "author": "a user"
    },
    "5963": {
      "id": 27978,
      "text": "Vị mục sư đã đọc, cầu nguyện và đưa ra một số lời khuyên cho cặp đôi đáng yêu này.",
      "author": "a user"
    },
    "5965": {
      "id": 27981,
      "text": "Chú rể luồn chiếc nhẫn cưới giản dị lên ngón tay của cô dâu.",
      "author": "a user"
    },
    "5966": {
      "id": 27982,
      "text": "Cô loay hoay một chút để đeo một chiếc nhẫn vào ngón tay anh.",
      "author": "a user"
    },
    "5967": {
      "id": 27984,
      "text": "Không lâu sau, vị mục sư cho biết họ đã là vợ chồng.",
      "author": "a user"
    },
    "5944": {
      "id": 2587273,
      "text": "Chúng tôi bước vào nhà thờ và ngồi xuống.",
      "author": "ChatGPT4.1"
    },
    "5945": {
      "id": 2587274,
      "text": "Có những bông hoa xinh đẹp ở phía trước.",
      "author": "ChatGPT4.1"
    },
    "5947": {
      "id": 2587275,
      "text": "Nhà thờ đầy những người ăn mặc thật đẹp.",
      "author": "ChatGPT4.1"
    },
    "5948": {
      "id": 2587276,
      "text": "Mọi người đều chờ đợi để thấy cô dâu xinh đẹp bước lên lối đi.",
      "author": "ChatGPT4.1"
    },
    "5949": {
      "id": 2587277,
      "text": "Một sự im lặng và mọi người nín thở.",
      "author": "ChatGPT4.1"
    },
    "5951": {
      "id": 2587278,
      "text": "Ôi, cô ấy thật xinh đẹp!",
      "author": "ChatGPT4.1"
    },
    "5952": {
      "id": 2587279,
      "text": "Cô ấy mặc một chiếc váy trắng dài duyên dáng với ren và hạt trang trí đẹp mắt.",
      "author": "ChatGPT4.1"
    },
    "5954": {
      "id": 2587280,
      "text": "Những lọn tóc uốn lượn xuống lưng cô ấy.",
      "author": "ChatGPT4.1"
    },
    "5956": {
      "id": 2587281,
      "text": "Bó hoa gồm những bông hoa nhỏ xíu của cô ấy thật sự rất, rất xinh.",
      "author": "a user"
    },
    "5957": {
      "id": 2587282,
      "text": "Cha cô ấy trông rất tự hào về con gái mình.",
      "author": "ChatGPT4.1"
    },
    "5958": {
      "id": 2587283,
      "text": "Ông ấy cũng có vẻ hơi buồn một chút.",
      "author": "ChatGPT4.1"
    },
    "5959": {
      "id": 2587284,
      "text": "Ở phía trước nhà thờ, chú rể đang đứng chờ.",
      "author": "ChatGPT4.1"
    },
    "5960": {
      "id": 2587285,
      "text": "Anh ấy có một nụ cười dịu dàng rất đẹp trên khuôn mặt.",
      "author": "ChatGPT4.1"
    },
    "5962": {
      "id": 2587286,
      "text": "Họ mỉm cười nhìn nhau.",
      "author": "ChatGPT4.1"
    },
    "5964": {
      "id": 2587287,
      "text": "Ai đó hát một bài hát ngọt ngào.",
      "author": "ChatGPT4.1"
    },
    "5968": {
      "id": 2587288,
      "text": "Họ trao nhau nụ hôn.",
      "author": "ChatGPT4.1"
    },
    "5969": {
      "id": 2587289,
      "text": "Tất cả chúng tôi đứng dậy, khi họ đi xuống lối đi",
      "author": "ChatGPT4.1"
    },
    "5970": {
      "id": 2587290,
      "text": "để sống cùng nhau suốt quãng đời còn lại với tư cách vợ chồng!",
      "author": "ChatGPT4.1"
    },
    "5971": {
      "id": 2587291,
      "text": "Chúng tôi đã khóc.",
      "author": "ChatGPT4.1"
    }
  }
}
