  "translations": {
    "4608": {
      "id": 36953,
      "text": "Tôi đang ở trong nhà thờ, chờ anh/chị/em họ của tôi bước xuống lối đi giữa.",
      "author": "a user"
    },
    "4610": {
      "id": 36957,
      "text": "Cô ấy là cô dâu.",
      "author": "a user"
    },
    "4611": {
      "id": 36958,
      "text": "Nhạc công organ đang chơi một bản nhạc trên đàn organ.",
      "author": "a user"
    },
    "4612": {
      "id": 36959,
      "text": "Tất cả chúng tôi đều đứng dậy và nhìn cô em họ của tôi tiến vào lễ đường",
      "author": "a user"
    },
    "4614": {
      "id": 36961,
      "text": "Cô ấy mặc một chiếc váy cưới trắng dài và đội một chiếc khăn voan.",
      "author": "a user"
    },
    "4616": {
      "id": 36964,
      "text": "Người đàn ông mà cô ấy sắp kết hôn đang đứng trước nhà thờ.",
      "author": "a user"
    },
    "4619": {
      "id": 36969,
      "text": "Vị chủ hôn nói những lời để chính thức kết họ thành vợ chồng.",
      "author": "a user"
    },
    "4621": {
      "id": 36973,
      "text": "Họ trao cho nhau những chiếc nhẫn vàng để đeo để tượng trưng cho việc họ đã kết hôn.",
      "author": "a user"
    },
    "4625": {
      "id": 36979,
      "text": "Một nhiếp ảnh gia chụp ảnh cho cặp đôi hạnh phúc.",
      "author": "a user"
    },
    "4626": {
      "id": 36981,
      "text": "Chúng tôi chúc họ mọi điều tốt đẹp và mong chờ buổi tiệc chiêu đãi, nơi chúng tôi sẽ dùng bữa tối.",
      "author": "a user"
    },
    "4607": {
      "id": 2600171,
      "text": "Chuông nhà thờ đang vang lên.",
      "author": "ChatGPT4.1"
    },
    "4609": {
      "id": 2600172,
      "text": "Hôm nay là ngày cưới của cô ấy.",
      "author": "ChatGPT4.1"
    },
    "4613": {
      "id": 2600173,
      "text": "Cô ấy khoác tay cha mình.",
      "author": "ChatGPT4.1"
    },
    "4615": {
      "id": 2600174,
      "text": "Cô ấy trông thật xinh đẹp. Cô ấy trông như một nàng công chúa.",
      "author": "ChatGPT4.1"
    },
    "4617": {
      "id": 2600175,
      "text": "Anh ấy là chú rể. Anh ấy cũng trông rất bảnh bao.",
      "author": "ChatGPT4.1"
    },
    "4618": {
      "id": 2600176,
      "text": "Anh ấy đang mặc một bộ vest và cài một bông hoa trên ve áo.",
      "author": "a user"
    },
    "4620": {
      "id": 2600177,
      "text": "Cô dâu và chú rể mỉm cười với nhau, nhưng họ có vẻ hơi lo lắng.",
      "author": "ChatGPT4.1"
    },
    "4622": {
      "id": 2600178,
      "text": "Họ hôn nhau và bước ra khỏi nhà thờ khi người chơi đàn organ cất lên nhạc vui tươi.",
      "author": "ChatGPT4.1"
    },
    "4623": {
      "id": 2600179,
      "text": "Một số người trong nhà thờ đã khóc trong lễ cưới, nhưng không phải vì họ buồn.",
      "author": "a user"
    },
    "4624": {
      "id": 2600180,
      "text": "Mọi người trong nhà thờ đều rất vui mừng cho cặp đôi.",
      "author": "ChatGPT4.1"
    },
    "4627": {
      "id": 2600181,
      "text": "và chúng tôi sẽ khiêu vũ và vui vẻ cho đến tận khuya.",
      "author": "ChatGPT4.1"
    },
    "4628": {
      "id": 2600182,
      "text": "Cô dâu sẽ tung bó hoa cưới của mình.",
      "author": "a user"
    },
    "4629": {
      "id": 2600183,
      "text": "và người ta nói rằng ai bắt được bó hoa sẽ là cô dâu tiếp theo.",
      "author": "ChatGPT4.1"
    },
    "4630": {
      "id": 2600184,
      "text": "Ngày hôm sau, cô dâu và chú rể sẽ đi hưởng tuần trăng mật.",
      "author": "ChatGPT4.1"
    },
    "4631": {
      "id": 2600185,
      "text": "Em họ tôi và chồng sẽ đến Mexico để hưởng tuần trăng mật.",
      "author": "ChatGPT4.1"
    }
  }
}
