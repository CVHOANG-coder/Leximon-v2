  "translations": {
    "5312": {
      "id": 3012970,
      "text": "Mỗi đêm khi tôi còn nhỏ, mẹ tôi thường đọc cho tôi nghe một câu chuyện trước khi đi ngủ.",
      "author": "ChatGPT4.1"
    },
    "5313": {
      "id": 3012971,
      "text": "Câu chuyện yêu thích nhất của tôi là Khu vườn lúc nửa đêm của Tom.",
      "author": "ChatGPT4.1"
    },
    "5314": {
      "id": 3012972,
      "text": "Đây là một câu chuyện của Philippa Pearce.",
      "author": "ChatGPT4.1"
    },
    "5315": {
      "id": 3012973,
      "text": "Đó là một cuốn sách khá dài,",
      "author": "ChatGPT4.1"
    },
    "5316": {
      "id": 3012974,
      "text": "và mẹ tôi đã mất khá nhiều đêm để đọc hết cuốn sách đó cho tôi nghe.",
      "author": "ChatGPT4.1"
    },
    "5317": {
      "id": 3012975,
      "text": "Trong Khu vườn lúc nửa đêm của Tom, Tom chuyển đến thành phố để ở với dì và chú của mình.",
      "author": "ChatGPT4.1"
    },
    "5318": {
      "id": 3012976,
      "text": "Cậu ấy cảm thấy rất chán ở căn hộ của họ.",
      "author": "ChatGPT4.1"
    },
    "5319": {
      "id": 3012977,
      "text": "Họ không có con, nên Tom không có gì để làm.",
      "author": "ChatGPT4.1"
    },
    "5320": {
      "id": 3012978,
      "text": "Một đêm nọ, chiếc đồng hồ điểm mười ba tiếng.",
      "author": "ChatGPT4.1"
    },
    "5321": {
      "id": 3012979,
      "text": "Tom biết rằng điều này là không thể.",
      "author": "ChatGPT4.1"
    },
    "5322": {
      "id": 3012980,
      "text": "Một chiếc đồng hồ chỉ có thể điểm tối đa mười hai tiếng.",
      "author": "ChatGPT4.1"
    },
    "5323": {
      "id": 3012981,
      "text": "Cậu lẻn xuống cầu thang và đi ra ngoài.",
      "author": "ChatGPT4.1"
    },
    "5324": {
      "id": 3012982,
      "text": "Khi cậu ra ngoài, có một khu vườn tuyệt đẹp mà ngày hôm trước chưa từng có.",
      "author": "ChatGPT4.1"
    },
    "5325": {
      "id": 3012983,
      "text": "Ngày hôm sau, Tom ra ngoài và thấy không có khu vườn nào cả.",
      "author": "ChatGPT4.1"
    },
    "5326": {
      "id": 3012984,
      "text": "Khu vườn dường như chỉ xuất hiện vào ban đêm.",
      "author": "ChatGPT4.1"
    },
    "5327": {
      "id": 3012985,
      "text": "Mỗi đêm, Tom lẻn ra khu vườn tuyệt vời đó, và gặp một vài người trong khu vườn ấy.",
      "author": "ChatGPT4.1"
    },
    "5328": {
      "id": 3012986,
      "text": "Cậu gặp một cô gái tên là Hattie.",
      "author": "a user"
    },
    "5329": {
      "id": 3012987,
      "text": "Hattie và Tom trở thành những người bạn rất thân trong khu vườn này.",
      "author": "ChatGPT4.1"
    },
    "5330": {
      "id": 3012988,
      "text": "Một vài điều rất kỳ lạ đã xảy ra trong cuốn sách này.",
      "author": "ChatGPT4.1"
    },
    "5331": {
      "id": 3012989,
      "text": "Có một vài sự trùng hợp khiến bạn đoán xem chuyện gì thực sự đang xảy ra.",
      "author": "a user"
    },
    "5332": {
      "id": 3012990,
      "text": "Kết thúc bất ngờ thật tuyệt vời.",
      "author": "ChatGPT4.1"
    },
    "5333": {
      "id": 3012991,
      "text": "Tôi thực sự rất thích Khu vườn lúc nửa đêm của Tom",
      "author": "ChatGPT4.1"
    },
    "5334": {
      "id": 3012992,
      "text": "và tôi đã rất buồn khi mẹ tôi và tôi đọc đến cuối cuốn sách.",
      "author": "ChatGPT4.1"
    },
    "5335": {
      "id": 3012993,
      "text": "Tôi cảm thấy như mình đã đến thăm khu vườn kỳ diệu đó cùng với Tom.",
      "author": "ChatGPT4.1"
    },
    "5336": {
      "id": 3012994,
      "text": "Đó là một cuốn sách mà tôi sẽ nhớ suốt đời.",
      "author": "ChatGPT4.1"
    }
  }
}
