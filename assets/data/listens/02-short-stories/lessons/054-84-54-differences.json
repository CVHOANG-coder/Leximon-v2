  "translations": {
    "3699": {
      "id": 3389,
      "text": "Mọi người có nhiều hình dáng và kích thước khác nhau.",
      "author": "a user"
    },
    "3708": {
      "id": 3412,
      "text": "Một số người lại không có tóc.",
      "author": "a user"
    },
    "3709": {
      "id": 3414,
      "text": "Không có hai người nào giống hệt nhau.",
      "author": "a user"
    },
    "3712": {
      "id": 3421,
      "text": "Tôi không đi bộ nhanh như một người có đôi chân dài.",
      "author": "a user"
    },
    "3714": {
      "id": 3428,
      "text": "Chân tôi đi giày cỡ bảy",
      "author": "a user"
    },
    "3715": {
      "id": 3431,
      "text": "Mẹ tôi đi giày cỡ năm",
      "author": "a user"
    },
    "3716": {
      "id": 3433,
      "text": "Bố tôi đi giày cỡ mười hai",
      "author": "a user"
    },
    "3717": {
      "id": 3434,
      "text": "Chúng ta đều có kích cỡ khác nhau.",
      "author": "a user"
    },
    "3719": {
      "id": 3447,
      "text": "Thật tốt khi mỗi người chúng ta đều độc đáo.",
      "author": "a user"
    },
    "3697": {
