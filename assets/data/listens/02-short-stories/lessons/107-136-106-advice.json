  "translations": {
    "5213": {
      "id": 29028,
      "text": "Tôi nên nghe theo tiếng nói lương tâm và làm những gì tôi cho là đúng.",
      "author": "a user"
    },
    "5215": {
      "id": 29036,
      "text": "Nếu bạn đã cố gắng hết sức, thì đó mới là điều quan trọng nhất.",
      "author": "a user"
    },
    "5217": {
      "id": 29050,
      "text": "Mẹ tôi có rất nhiều lẽ thường tình",
      "author": "a user"
    },
    "5224": {
      "id": 29080,
      "text": "họ thật lòng chỉ muốn điều tốt nhất cho bạn.",
      "author": "a user"
    },
    "5193": {
      "id": 29088,
      "text": "Cô ấy bảo tôi tiết kiệm tiền cho những lúc khó khăn",
      "author": "a user"
    },
    "5195": {
      "id": 54314,
      "text": "Cô ấy nói rằng gieo nhân nào gặt quả nấy.",
      "author": "a user"
    },
    "5205": {
      "id": 2602179,
      "text": "Cô ấy nói với tôi rằng cô ấy muốn tôi không phạm sai lầm,",
      "author": "ChatGPT4.1"
    },
    "5206": {
      "id": 2602180,
      "text": "nhưng cô ấy nói rằng ai cũng mắc lỗi.",
      "author": "ChatGPT4.1"
    },
    "5207": {
      "id": 2602181,
      "text": "Điều quan trọng là chúng ta học hỏi từ những sai lầm của mình.",
      "author": "ChatGPT4.1"
    },
    "5208": {
      "id": 2602182,
      "text": "Mẹ tôi nói rằng không ai là hoàn hảo cả.",
      "author": "ChatGPT4.1"
    },
    "5209": {
      "id": 2602183,
      "text": "Mẹ tôi nói với chị gái tôi rằng thời gian là quý giá.",
      "author": "ChatGPT4.1"
    },
    "5210": {
      "id": 2602184,
      "text": "Chị tôi lãng phí thời gian, và mẹ tôi không thích điều đó.",
      "author": "ChatGPT4.1"
    },
    "5211": {
      "id": 2602185,
      "text": "Mẹ tôi bảo tôi hãy sống thật với bản thân mình.",
      "author": "ChatGPT4.1"
    },
    "5212": {
      "id": 2602186,
      "text": "Mẹ nói rằng tôi không nên chạy theo đám đông.",
      "author": "ChatGPT4.1"
    },
    "5214": {
      "id": 2602187,
      "text": "Mẹ nói rằng không quan trọng nếu bạn thất bại, điều quan trọng là bạn đã cố gắng.",
      "author": "ChatGPT4.1"
    },
    "5216": {
      "id": 2602188,
      "text": "Tôi nghe theo mẹ tôi. Tôi nghĩ mẹ tôi cho tôi những lời khuyên rất hay.",
      "author": "a user"
    },
    "5218": {
      "id": 2602189,
      "text": "Tôi hy vọng mình sẽ thông thái như mẹ khi tôi có con của riêng mình.",
      "author": "ChatGPT4.1"
    },
    "5219": {
      "id": 2602190,
      "text": "Đôi khi tôi ước mẹ đừng cho tôi quá nhiều lời khuyên.",
      "author": "ChatGPT4.1"
    },
    "5220": {
      "id": 2602191,
      "text": "Tôi nghĩ rằng mình biết mình đang làm gì.",
      "author": "ChatGPT4.1"
    },
    "5221": {
      "id": 2602192,
      "text": "Nhưng cuối cùng, tôi luôn nhớ những gì mẹ đã nói,",
      "author": "ChatGPT4.1"
    },
    "5222": {
      "id": 2602193,
      "text": "và tôi cố gắng sống theo những chuẩn mực mẹ đã đặt ra cho tôi.",
      "author": "ChatGPT4.1"
    },
    "5223": {
      "id": 2602194,
      "text": "Hãy nhận những lời khuyên mà cha mẹ bạn dành cho bạn.",
      "author": "ChatGPT4.1"
    },
    "5192": {
      "id": 2615541,
      "text": "Đôi khi mẹ tôi đưa ra lời khuyên cho tôi.",
      "author": "ChatGPT4.1"
    },
    "5194": {
      "id": 2615542,
      "text": "Mẹ nói rằng tôi nên ăn rau nếu muốn khỏe mạnh khi lớn lên.",
      "author": "ChatGPT4.1"
    },
    "5196": {
      "id": 2615543,
      "text": "Tôi không hiểu câu đó nghĩa là gì nên tôi hỏi mẹ.",
      "author": "ChatGPT4.1"
    },
    "5197": {
      "id": 2615544,
      "text": "Mẹ nói rằng nếu mình tốt với người khác thì họ cũng sẽ tốt với mình.",
      "author": "ChatGPT4.1"
    },
    "5198": {
      "id": 2615545,
      "text": "Nếu bạn làm điều xấu thì điều xấu sẽ quay lại với bạn.",
      "author": "ChatGPT4.1"
    },
    "5199": {
      "id": 2615546,
      "text": "Mẹ tôi luôn đưa ra lời khuyên cho tôi.",
      "author": "ChatGPT4.1"
    },
    "5200": {
      "id": 2615547,
      "text": "Mẹ nói rằng một đồng tiết kiệm là một đồng kiếm được.",
      "author": "ChatGPT4.1"
    },
    "5201": {
      "id": 2615548,
      "text": "Tôi vẫn đang suy nghĩ về điều đó.",
      "author": "a user"
    },
    "5202": {
      "id": 2615549,
      "text": "Một số điều này thật khó để hiểu.",
      "author": "ChatGPT4.1"
    },
    "5203": {
      "id": 2615550,
      "text": "Mẹ tôi rất thông thái.",
      "author": "ChatGPT4.1"
    },
    "5204": {
      "id": 2615551,
      "text": "Mẹ nói rằng mẹ đã học được từ những sai lầm của mình.",
      "author": "ChatGPT4.1"
    }
  }
