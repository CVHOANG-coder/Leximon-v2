  "translations": {
    "4717": {
      "id": 28883,
      "text": "Buổi sáng thì sáng, nhưng đêm thì tối.",
      "author": "a user"
    },
    "4718": {
      "id": 28884,
      "text": "Một chiếc lông thì nhẹ, nhưng một con voi thì nặng.",
      "author": "a user"
    },
    "4691": {
      "id": 30388,
      "text": "Một số thứ đối lập với nhau.",
      "author": "a user"
    },
    "4695": {
      "id": 40777,
      "text": "điều đó có nghĩa là tôi đang ở phía bên kia của căn phòng mà bạn đang đứng.",
      "author": "a user"
    },
    "4697": {
      "id": 40783,
      "text": "và đối lập với bên trái là bên phải.",
      "author": "a user"
    },
    "4698": {
      "id": 40784,
      "text": "Bạn có biết điều ngược lại với trẻ sẽ là gì không?",
      "author": "a user"
    },
    "4702": {
      "id": 40792,
      "text": "To thì đối lập với nhỏ.",
      "author": "a user"
    },
    "4704": {
      "id": 40795,
      "text": "Con trai thì đối lập với con gái.",
      "author": "a user"
    },
    "4710": {
      "id": 40810,
      "text": "và thời tiết thì nóng bức vào mùa hè.",
      "author": "a user"
    },
    "4712": {
      "id": 40813,
      "text": "còn anh trai tôi rất lùn.",
      "author": "a user"
    },
    "4713": {
      "id": 40814,
      "text": "Đá thì cứng, nhưng gối thì mềm.",
      "author": "a user"
    },
    "4714": {
      "id": 42533,
      "text": "Đại dương thì sâu, nhưng vũng nước thì cạn.",
      "author": "a user"
    },
    "4703": {
      "id": 2616316,
      "text": "Đàn ông thì đối lập với phụ nữ.",
      "author": "a user"
    },
    "4705": {
      "id": 2616317,
      "text": "Đôi khi người ta nghĩ những điều trái ngược với người khác.",
      "author": "ChatGPT4.1"
    },
    "4706": {
      "id": 2616318,
      "text": "Có người có thể sai và có người có thể đúng.",
      "author": "ChatGPT4.1"
    },
    "4707": {
      "id": 2616319,
      "text": "Điều ngược lại của mẹ là cha.",
      "author": "ChatGPT4.1"
    },
    "4708": {
      "id": 2616320,
      "text": "Hãy thử xem bạn có thể nghĩ ra một vài điều đối lập không.",
      "author": "ChatGPT4.1"
    },
    "4709": {
      "id": 2616321,
      "text": "Trời lạnh vào mùa đông,",
      "author": "ChatGPT4.1"
    },
    "4711": {
      "id": 2616322,
      "text": "Cha tôi rất cao,",
      "author": "ChatGPT4.1"
    },
    "4715": {
      "id": 2616323,
      "text": "Tôi có thể nói sự thật, nhưng tôi cũng có thể nói dối.",
      "author": "ChatGPT4.1"
    },
    "4716": {
      "id": 2616324,
      "text": "Tất cả những điều này đều là những điều đối lập.",
      "author": "a user"
    },
    "4719": {
      "id": 2616325,
      "text": "Đường thì ngọt, còn chanh thì chua.",
      "author": "ChatGPT4.1"
    },
    "4720": {
      "id": 2616326,
      "text": "Máy bay phản lực thì nhanh, còn rùa thì chậm.",
      "author": "ChatGPT4.1"
    },
    "4721": {
      "id": 2616327,
      "text": "Tôi có thể ra ngoài vào ban ngày, hoặc tôi có thể ra ngoài vào ban đêm.",
      "author": "ChatGPT4.1"
    },
    "4722": {
      "id": 2616328,
      "text": "Tôi có thể thích bơi, hoặc tôi cũng có thể ghét bơi.",
      "author": "ChatGPT4.1"
    },
    "4723": {
      "id": 2616329,
      "text": "Thật thú vị khi thấy bạn có thể nghĩ ra bao nhiêu điều đối lập.",
      "author": "a user"
    },
    "4724": {
      "id": 2616330,
      "text": "Tôi có thể chào bạn, nhưng tôi nghĩ đã đến lúc phải nói tạm biệt.",
      "author": "ChatGPT4.1"
    },
    "4692": {
      "id": 2618751,
      "text": "Đối lập với màu đen là màu trắng.",
      "author": "ChatGPT4.1"
    },
    "4693": {
      "id": 2618752,
      "text": "Đối lập với vui là buồn.",
      "author": "ChatGPT4.1"
    },
    "4694": {
      "id": 2618753,
      "text": "Nếu tôi ở phía đối diện căn phòng với bạn,",
      "author": "ChatGPT4.1"
    },
    "4696": {
      "id": 2618754,
      "text": "Đối lập với hướng lên là hướng xuống",
      "author": "ChatGPT4.1"
    },
    "4699": {
      "id": 2618755,
      "text": "Già là đối lập với trẻ.",
      "author": "ChatGPT4.1"
    },
    "4700": {
      "id": 2618756,
      "text": "Đối lập với bẩn là gì?",
      "author": "ChatGPT4.1"
    },
    "4701": {
      "id": 2618757,
      "text": "Sạch là đối lập với bẩn.",
      "author": "ChatGPT4.1"
    }
  }
}
