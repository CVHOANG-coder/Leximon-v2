  "translations": {
    "1063": {
      "id": 1933,
      "text": "Bạn phải lau chùi cửa sổ để bạn có thể nhìn ra bên ngoài.",
      "author": "a user"
    },
    "1064": {
      "id": 1934,
      "text": "Sàn nhà và thảm cần được hút bụi.",
      "author": "a user"
    },
    "1066": {
      "id": 1936,
      "text": "và một số trong số chúng cần được đánh sáp ( sáp để làm bóng) .",
      "author": "a user"
    },
    "1075": {
      "id": 1945,
      "text": "Đôi khi, chúng ta treo quần áo ra ngoài dây phơi để khô.",
      "author": "a user"
    },
    "1077": {
      "id": 1947,
      "text": "Bạn phải mua hàng tạp hóa và cất chúng đi.",
      "author": "a user"
    },
    "1078": {
      "id": 1948,
      "text": "Các bữa ăn cần phải được chế biến.",
      "author": "a user"
    },
    "1080": {
      "id": 1950,
      "text": "Chén đĩa ăn phải được rửa sạch,",
      "author": "a user"
    },
    "1081": {
      "id": 1951,
      "text": "và các quầy cần được lau sạch.",
      "author": "a user"
    },
    "1083": {
      "id": 1953,
      "text": "và đôi khi tủ lạnh và tủ chén cần được dọn sạch.",
      "author": "a user"
    },
    "1086": {
      "id": 3596,
      "text": "Giường cũng phải được thay ga .",
      "author": "a user"
    },
    "1087": {
      "id": 3597,
      "text": "Chúng cần ga trải giường sạch sẽ phủ lên ",
      "author": "a user"
    },
    "1062": {
      "id": 2586506,
      "text": "Luôn có việc nhà phải làm khi bạn sống trong một ngôi nhà.",
      "author": "ChatGPT4.1"
    },
    "1065": {
      "id": 2586507,
      "text": "Sàn nhà cũng cần được lau,",
      "author": "ChatGPT4.1"
    },
    "1067": {
      "id": 2586508,
      "text": "Đồ đạc phải được đánh bóng.",
      "author": "ChatGPT4.1"
    },
    "1068": {
      "id": 2586509,
      "text": "Phòng tắm phải được giữ sạch sẽ.",
      "author": "a user"
    },
    "1069": {
      "id": 2586510,
      "text": "Sau khi bạn tắm xong,",
      "author": "ChatGPT4.1"
    },
    "1070": {
      "id": 2586511,
      "text": "bạn cần làm sạch bồn tắm.",
      "author": "ChatGPT4.1"
    },
    "1071": {
      "id": 2586512,
      "text": "Giặt giũ cần được thực hiện thường xuyên",
      "author": "a user"
    },
    "1072": {
      "id": 2586513,
      "text": "nếu không bạn sẽ hết quần áo để mặc.",
      "author": "ChatGPT4.1"
    },
    "1073": {
      "id": 2586514,
      "text": "Quần áo được cho vào máy giặt,",
      "author": "ChatGPT4.1"
    },
    "1074": {
      "id": 2586515,
      "text": "và sau đó chúng phải được sấy khô trong máy sấy.",
      "author": "a user"
    },
    "1076": {
      "id": 2586516,
      "text": "Một số quần áo cần được ủi.",
      "author": "a user"
    },
    "1079": {
      "id": 2586517,
      "text": "Bạn không thể để bát đĩa chất đống trong bếp.",
      "author": "ChatGPT4.1"
    },
    "1082": {
      "id": 2586518,
      "text": "Bếp nấu cần được làm sạch,",
      "author": "ChatGPT4.1"
    },
    "1084": {
      "id": 2586519,
      "text": "Bạn có thể lau bụi đồ đạc và quét dọn bụi bẩn.",
      "author": "ChatGPT4.1"
    },
    "1085": {
      "id": 2586520,
      "text": "Bạn có thể dọn giường.",
      "author": "ChatGPT4.1"
    },
    "1088": {
      "id": 2586521,
      "text": "Có quá nhiều việc phải làm.",
      "author": "ChatGPT4.1"
    },
    "1089": {
      "id": 2586522,
      "text": "Các công việc nhà chiếm rất nhiều thời gian",
      "author": "ChatGPT4.1"
    }
  }
}
