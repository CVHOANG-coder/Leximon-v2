  "translations": {
    "1412": {
      "id": 3033,
      "text": "Hoa hồng mọc thành bụi, tỏa hương thơm ngát.",
      "author": "a user"
    },
    "1419": {
      "id": 3136,
      "text": "Hoa lưu ly cũng là hoa của mùa xuân.",
      "author": "a user"
    },
    "1421": {
      "id": 3142,
      "text": "Hoa linh lan trông giống như những chiếc chuông trắng.",
      "author": "a user"
    },
    "1422": {
      "id": 3295,
      "text": "Nơi tôi sống, nhiều cây cối nở hoa vào mùa xuân.",
      "author": "a user"
    },
    "1430": {
      "id": 3324,
      "text": "Nếu khu vườn của bạn có bóng râm, bạn phải trồng những thứ khác.",
      "author": "a user"
    },
    "1431": {
      "id": 3330,
      "text": "Cây Hosta phát triển tốt trong một khu vườn râm mát.",
      "author": "a user"
    },
    "1435": {
      "id": 3347,
      "text": "Hoa thích hợp để làm quà tặng.",
      "author": "a user"
    },
    "1439": {
      "id": 3362,
      "text": "Nhiều người tặng hoa ly cho lễ Phục sinh.",
      "author": "a user"
    },
    "1440": {
      "id": 3365,
      "text": "Hoa Trạng nguyên mang không khí lễ hội cho dịp Giáng sinh.",
      "author": "a user"
    },
    "1441": {
      "id": 3371,
      "text": "Nếu ai đó đi khiêu vũ, họ thường tặng cho bạn nhảy của mình một bông hoa để đeo.",
      "author": "a user"
    },
    "1444": {
      "id": 3384,
      "text": "Hoa giúp làm cho các nơi trở nên đẹp đẽ.",
      "author": "a user"
    },
    "1410": {
      "id": 2584712,
      "text": "Có hàng trăm loại hoa khác nhau.",
      "author": "ChatGPT4.1"
    },
    "1411": {
      "id": 2584713,
      "text": "Hầu hết mọi người đều thích hoa hồng.",
      "author": "ChatGPT4.1"
    },
    "1413": {
      "id": 2584714,
      "text": "Bạn phải cẩn thận để không bị gai hoa hồng đâm vào tay.",
      "author": "ChatGPT4.1"
    },
    "1414": {
      "id": 2584715,
      "text": "Hoa hồng có nhiều màu sắc khác nhau.",
      "author": "ChatGPT4.1"
    },
    "1415": {
      "id": 2584716,
      "text": "Có hoa hồng đỏ, hồng, vàng và trắng.",
      "author": "ChatGPT4.1"
    },
    "1416": {
      "id": 2584717,
      "text": "Vào mùa xuân, hoa tulip nở rộ.",
      "author": "ChatGPT4.1"
    },
    "1417": {
      "id": 2584718,
      "text": "Ở Ottawa, có rất nhiều hoa tulip.",
      "author": "ChatGPT4.1"
    },
    "1418": {
      "id": 2584719,
      "text": "Một số người đến đó chỉ để ngắm tất cả hoa tulip vào mùa xuân.",
      "author": "ChatGPT4.1"
    },
    "1420": {
      "id": 2584720,
      "text": "Chúng nhỏ xíu và có màu xanh dương.",
      "author": "ChatGPT4.1"
    },
    "1423": {
      "id": 2584721,
      "text": "Cây táo và cây anh đào trông đặc biệt đẹp khi nở hoa.",
      "author": "ChatGPT4.1"
    },
    "1424": {
      "id": 2584722,
      "text": "Chúng tôi có một lễ hội hoa nở ở thị trấn của tôi.",
      "author": "ChatGPT4.1"
    },
    "1425": {
      "id": 2584723,
      "text": "Hàng xóm của tôi thích trồng phong lữ, dạ yến thảo và cúc vạn thọ vào mùa hè.",
      "author": "ChatGPT4.1"
    },
    "1426": {
      "id": 2584724,
      "text": "Một số người trồng hoa hướng dương.",
      "author": "ChatGPT4.1"
    },
    "1427": {
      "id": 2584725,
      "text": "Hoa hướng dương mọc rất cao.",
      "author": "ChatGPT4.1"
    },
    "1428": {
      "id": 2584726,
      "text": "Chúng có cánh hoa vàng tươi rực rỡ.",
      "author": "ChatGPT4.1"
    },
    "1429": {
      "id": 2584727,
      "text": "Tất cả những loài hoa đó phát triển tốt nhất dưới ánh nắng mặt trời.",
      "author": "ChatGPT4.1"
    },
    "1432": {
      "id": 2584728,
      "text": "Hoa cúc là loài hoa của mùa thu.",
      "author": "ChatGPT4.1"
    },
    "1433": {
      "id": 2584729,
      "text": "Hoa cúc cũng có nhiều màu sắc khác nhau.",
      "author": "ChatGPT4.1"
    },
    "1434": {
      "id": 2584730,
      "text": "Có hoa cúc tím, vàng và trắng.",
      "author": "ChatGPT4.1"
    },
    "1436": {
      "id": 2584731,
      "text": "Phụ nữ thích nhận một tá hoa hồng vào ngày lễ Tình nhân.",
      "author": "ChatGPT4.1"
    },
    "1437": {
      "id": 2584732,
      "text": "Hoa cẩm chướng cũng là món quà đẹp.",
      "author": "ChatGPT4.1"
    },
    "1438": {
      "id": 2584733,
      "text": "Chúng có mùi thơm rất ngọt ngào.",
      "author": "ChatGPT4.1"
    },
    "1442": {
      "id": 2589454,
      "text": "Đôi khi, một cô gái sẽ nhận được một bông phong lan từ người hẹn hò của mình.",
      "author": "a user"
    },
    "1443": {
      "id": 2589455,
      "text": "Nếu bạn tham dự một đám cưới, có lẽ bạn sẽ thấy rất nhiều hoa ở đó.",
      "author": "ChatGPT4.1"
    }
  }
}
