  "translations": {
    "40685": {
      "id": 716244,
      "text": "Rất ít loài thành công hơn những con kiến.",
      "author": "a user"
    },
    "40686": {
      "id": 716246,
      "text": "Có thể có 8 triệu cá thể trong một hecta.",
      "author": "a user"
    },
    "40687": {
      "id": 716248,
      "text": "Nhưng kiến rừng không phải muốn gì cũng được.",
      "author": "a user"
    },
    "40689": {
      "id": 716252,
      "text": "Các bào tử từ một loại nấm ký sinh gọi là \"cordyceps\" đã xâm nhập vào cơ thể và tâm trí của chúng.",
      "author": "a user"
    },
    "40690": {
      "id": 716253,
      "text": "Bộ não bị nhiễm bệnh của nó dẫn đường cho con kiến này đi lên phía trên.",
      "author": "a user"
    },
    "40692": {
      "id": 716255,
      "text": "Những con bị nhiễm bệnh được kiến thợ phát hiện sẽ nhanh chóng được đưa đi và vứt xa khỏi tổ.",
      "author": "a user"
    },
    "40697": {
      "id": 716262,
      "text": "và khi hoàn thành các bào tử cực độc sẽ bùng phát từ đầu của nó",
      "author": "a user"
    },
    "40698": {
      "id": 716263,
      "text": "thì bất kỳ con kiến nào ở gần đó sẽ có nguy cơ cao đối diện với cái chết",
      "author": "a user"
    },
    "40701": {
      "id": 716269,
      "text": "Có hàng nghìn loại nấm cordyceps khác nhau",
      "author": "a user"
    },
    "40706": {
      "id": 716285,
      "text": "Một loài càng đông thì càng có nhiều khả năng bị tấn công bởi khắc tinh của chúng - một loại nấm cordyceps.",
      "author": "a user"
    },
    "40684": {
      "id": 3196476,
      "text": "Thật đáng kinh ngạc, 80% tất cả các loài côn trùng sống trong rừng rậm.",
      "author": "ChatGPT4.1"
    },
    "40688": {
      "id": 3196477,
      "text": "Những con kiến đạn này đang thể hiện một số triệu chứng đáng lo ngại.",
      "author": "ChatGPT4.1"
    },
    "40691": {
      "id": 3196478,
      "text": "Sau đó, hoàn toàn mất phương hướng, nó bám vào một cành cây bằng hàm dưới của mình.",
      "author": "ChatGPT4.1"
    },
    "40693": {
      "id": 3196479,
      "text": "Điều này có vẻ cực đoan nhưng đây là lý do.",
      "author": "ChatGPT4.1"
    },
    "40694": {
      "id": 3196480,
      "text": "Như thể bước ra từ truyện khoa học viễn tưởng,",
      "author": "ChatGPT4.1"
    },
    "40695": {
      "id": 3196481,
      "text": "cơ quan sinh sản của nấm cordyceps mọc trồi ra từ đầu con kiến.",
      "author": "ChatGPT4.1"
    },
    "40696": {
      "id": 3196482,
      "text": "Nó có thể mất ba tuần để phát triển",
      "author": "ChatGPT4.1"
    },
    "40699": {
      "id": 3196483,
      "text": "Loài nấm này nguy hiểm đến mức nó có thể quét sạch cả một tổ kiến.",
      "author": "ChatGPT4.1"
    },
    "40700": {
      "id": 3196484,
      "text": "Và không chỉ kiến là nạn nhân của sát thủ này.",
      "author": "ChatGPT4.1"
