  "translations": {
    "52461": {
      "id": 862566,
      "text": "Thức ăn rất khó tìm ở vùng xa về phía bắc đến mức một bầy sói phải tìm kiếm hàng trăm ki-lô-mét vuông nếu muốn thành công...",
      "author": "a user"
