    "52462": {
      "id": 862568,
      "text": "và thành công có nghĩa là nuôi lớn thế hệ tiếp theo.",
      "author": "a user"
    },
    "52465": {
      "id": 862570,
      "text": "mà còn bởi các dì và chú của chúng nữa.",
      "author": "a user"
    },
    "52466": {
      "id": 862571,
      "text": "Cùng nhau, họ cố gắng đảm bảo rằng mỗi chú sói con đều đạt kích thước gần như trưởng thành trước khi tuyết quay trở lại.",
      "author": "a user"
    },
    "52467": {
      "id": 862572,
      "text": "Một chú chó sói con đang lớn cần nhiều hơn là vài con thỏ con.",
      "author": "a user"
    },
    "52472": {
      "id": 862577,
      "text": "Chúng chạy với tốc độ 60 km một giờ.",
