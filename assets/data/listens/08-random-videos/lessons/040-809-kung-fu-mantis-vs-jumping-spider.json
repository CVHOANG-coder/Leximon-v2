    },
    "40678": {
      "id": 2647228,
      "text": "Chỉ việc sống sót trong vài giờ đầu đời đã là một thành tựu lớn đối với côn trùng mới nở.",
      "author": "ChatGPT4.1"
    },
    "40679": {
      "id": 2647229,
      "text": "Nhưng chặng đường phía trước còn rất dài.",
