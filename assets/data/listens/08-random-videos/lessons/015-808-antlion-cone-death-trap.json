  "translations": {
    "40631": {
      "id": 714486,
      "text": "Sa mạc Namib, một trong những nơi tiếp xúc (ánh nắng) nhiều nhất trên Trái đất.",
      "author": "a user"
    },
    "40634": {
      "id": 714492,
      "text": "Khi các loài khác trú ẩn, ngày của chúng chỉ mới bắt đầu...",
      "author": "a user"
    },
    "40635": {
      "id": 714493,
      "text": "dọn dẹp tổ.",
      "author": "a user"
    },
    "40637": {
      "id": 714495,
      "text": "Đôi chân dài của loài kiến nâng cơ thể chúng lên khỏi mặt đất, nơi có nhiệt độ mát hơn 10 độ.",
      "author": "a user"
    },
    "40638": {
      "id": 714499,
      "text": "Nhưng nếu chúng đứng yên, chúng sẽ bị chiên sống.",
      "author": "a user"
    },
    "40639": {
      "id": 714500,
      "text": "Chúng phải tiếp tục di chuyển hoặc chịu chung số phận với con mồi của mình,",
      "author": "a user"
    },
    "40640": {
      "id": 714502,
      "text": "những sinh vật đã gục ngã vì sốc nhiệt.",
      "author": "a user"
    },
    "40645": {
      "id": 714510,
      "text": "Trở về tổ trước khi chúng cũng chết.",
      "author": "a user"
    },
    "40646": {
      "id": 714511,
      "text": "Nhưng chúng đã đi lạc vào một bãi mìn.",
      "author": "a user"
    },
    "40647": {
      "id": 714512,
      "text": "Mỗi cái hố hình nón kỳ lạ này là một cái bẫy chết chóc...",
      "author": "a user"
    },
    "40648": {
      "id": 714513,
      "text": "với một kẻ săn mồi tàn bạo ở trung tâm của cái hố",
      "author": "a user"
    },
    "40649": {
      "id": 714515,
      "text": "Nằm ở đây là ấu trùng kiến sư tử",
      "author": "a user"
    },
    "40651": {
      "id": 714518,
      "text": "Một số con kiến trốn thoát được, nhưng kiến sư tử có những mánh khóe khác.",
      "author": "a user"
    },
    "40652": {
      "id": 714520,
      "text": "Ném cát vào không khí, nó tạo ra một trận sạt lở.",
      "author": "a user"
    },
    "40632": {
      "id": 2625220,
      "text": "Khi mặt trời lên cao, mọi sinh vật đều ẩn náu tránh cái nóng cực độ.",
      "author": "ChatGPT4.1"
    },
    "40633": {
      "id": 2625221,
      "text": "Tất cả mọi sinh vật ngoại trừ loài kiến \"hotrod\".",
      "author": "ChatGPT4.1"
    },
    "40636": {
      "id": 2625222,
      "text": "Cát có thể đạt tới nhiệt độ bỏng rát 70 độ C.",
      "author": "ChatGPT4.1"
    },
    "40641": {
      "id": 2625223,
      "text": "Chôn quá sâu, nhưng cũng là nơi lý tưởng để làm mát.",
      "author": "ChatGPT4.1"
    },
    "40642": {
      "id": 2625224,
      "text": "Quyết định kiếm ăn phải thật nhanh.",
      "author": "ChatGPT4.1"
    },
    "40643": {
      "id": 2625225,
      "text": "Quá to...",
      "author": "ChatGPT4.1"
    },
    "40644": {
      "id": 2625226,
      "text": "Hoàn hảo.",
      "author": "ChatGPT4.1"
    },
    "40650": {
      "id": 2625227,
      "text": "những kẻ săn mồi nhỏ bé có càng đầy nọc độc.",
      "author": "ChatGPT4.1"
    },
    "40653": {
      "id": 2625228,
      "text": "Trong chiếc nón tử thần này, vách tường dốc tới mức cát trượt dưới chân kiến.",
      "author": "ChatGPT4.1"
    },
    "40654": {
      "id": 2625229,
      "text": "Khi những tảng đá rơi như mưa từ trên xuống, việc thoát thân gần như là bất khả thi.",
      "author": "ChatGPT4.1"
    },
    "40655": {
      "id": 2625230,
      "text": "Phù!",
      "author": "ChatGPT4.1"
    }
  }
}
