  "translations": {
    "49331": {
      "id": 3203240,
      "text": "Người đầu tiên bước vào Shark Tank là Aaron Krause,",
      "author": "ChatGPT4.1"
    },
    "49332": {
      "id": 3203241,
      "text": "người tin rằng sản phẩm của mình sẽ giúp việc vệ sinh hàng ngày trở nên dễ dàng hơn.",
      "author": "ChatGPT4.1"
    },
    "49333": {
      "id": 3203242,
      "text": "Chào các Shark, tôi là Aaron Krause đến từ Philadelphia",
      "author": "ChatGPT4.1"
    },
    "49334": {
      "id": 3203243,
      "text": "và tôi được biết đến là cha đẻ của Scrub Daddy -",
      "author": "ChatGPT4.1"
    },
    "49335": {
      "id": 3203244,
      "text": "dụng cụ chà rửa dễ thương nhưng công nghệ cao nhất trên thế giới.",
      "author": "ChatGPT4.1"
    },
    "49336": {
      "id": 3203245,
      "text": "Hôm nay, tôi muốn kêu gọi khoản đầu tư 100.000 đô la",
      "author": "ChatGPT4.1"
    },
    "49337": {
      "id": 3203246,
      "text": "đổi lấy 10% cổ phần trong công ty Scrub Daddy.",
      "author": "ChatGPT4.1"
    },
    "49338": {
      "id": 3203247,
      "text": "Đây là dụng cụ chà rửa nhà bếp tuyệt vời nhất mà bạn từng sử dụng",
      "author": "ChatGPT4.1"
    },
    "49339": {
      "id": 3203248,
      "text": "bởi vì Scrub Daddy hoàn toàn thay đổi kết cấu chỉ bằng cách điều chỉnh nhiệt độ nước.",
      "author": "ChatGPT4.1"
    },
    "49340": {
      "id": 3203249,
      "text": "Để tôi cho bạn xem cách nó hoạt động như thế nào.",
      "author": "ChatGPT4.1"
    },
    "49341": {
      "id": 3203250,
      "text": "Ở đây tôi có nước nóng. Ở đây tôi có nước lạnh.",
      "author": "ChatGPT4.1"
    },
    "49342": {
      "id": 3203251,
      "text": "Khi tôi nhúng các Scrub Daddy vào nước nóng và nước lạnh,",
      "author": "ChatGPT4.1"
    },
    "49343": {
      "id": 3203252,
      "text": "một sự biến đổi hoàn toàn sẽ xảy ra.",
      "author": "ChatGPT4.1"
    },
    "49344": {
      "id": 3203253,
      "text": "Bây giờ, để chứng minh điều đó, tôi có quả tạ 10 pound.",
      "author": "ChatGPT4.1"
    },
    "49345": {
      "id": 3203254,
      "text": "Ở đây dưới sức nặng 10 pound, nó mềm và có thể nén được, giống như một miếng bọt biển.",
      "author": "ChatGPT4.1"
    },
    "49346": {
      "id": 3203255,
      "text": "Điều đó dùng cho các công việc chà rửa thông thường.",
      "author": "ChatGPT4.1"
    },
    "49347": {
      "id": 3203256,
      "text": "Nhưng đây, hãy xem này.",
      "author": "a user"
    },
    "49348": {
      "id": 3203257,
      "text": "Nó cứng và chắc.",
      "author": "ChatGPT4.1"
    },
    "49349": {
      "id": 3203258,
      "text": "Điều đó dành cho những công việc chà rửa nặng.",
      "author": "ChatGPT4.1"
    },
    "49350": {
      "id": 3203259,
      "text": "Chúng tôi đã đốt cháy nước sốt cà chua, phô mai và mù tạt",
      "author": "ChatGPT4.1"
    },
    "49351": {
      "id": 3203260,
      "text": "lên bề mặt bếp kính và chảo thép không gỉ.",
      "author": "ChatGPT4.1"
    },
    "49352": {
      "id": 3203261,
      "text": "Tôi sẽ dùng Scrub Daddy và bạn sẽ thấy nó sẽ tấn công ngay vào chỗ cháy đó, chà sạch nó ngay lập tức.",
      "author": "ChatGPT4.1"
    },
    "49353": {
      "id": 3203262,
      "text": "Và nhớ rằng, tôi chỉ dùng nước ở đây thôi.",
      "author": "ChatGPT4.1"
    },
    "49354": {
      "id": 3203263,
      "text": "Không có hóa chất nào cả.",
      "author": "ChatGPT4.1"
    },
    "49355": {
      "id": 3203264,
      "text": "Và nó sẽ làm sạch ngay chỗ đó.",
      "author": "ChatGPT4.1"
    },
    "49356": {
      "id": 3203265,
      "text": "Nó sẽ không làm xước bề mặt nào của bạn mà lại làm sạch rất đẹp.",
      "author": "ChatGPT4.1"
    },
    "49357": {
      "id": 3203266,
      "text": "Bây giờ miếng Scrub Daddy này không còn cười nữa,",
      "author": "a user"
    },
    "49358": {
      "id": 3203267,
      "text": "nên tôi sẽ để nó vào đây trong nước ấm, chỉ trong vài giây...",
      "author": "ChatGPT4.1"
    },
    "49359": {
      "id": 3203268,
      "text": "Voila! Nó lại tươi mới, sạch sẽ mỗi lần sử dụng.",
      "author": "ChatGPT4.1"
    },
    "49360": {
      "id": 3203269,
      "text": "Các Shark, đó không chỉ là một khuôn mặt cười nữa,",
      "author": "ChatGPT4.1"
    },
    "49361": {
      "id": 3203270,
      "text": "bạn đeo vào tay, có thể chạm xuống đáy và làm sạch các cạnh chỉ trong một lần di chuyển.",
      "author": "ChatGPT4.1"
    },
    "49362": {
      "id": 3224205,
      "text": "Và miệng cười đó làm sạch thìa, dao, nĩa, xẻng,",
      "author": "ChatGPT4.1"
    },
    "49363": {
      "id": 3224206,
      "text": "thậm chí cả muỗng lớn, đồng thời hai mặt cùng một lúc.",
      "author": "ChatGPT4.1"
    },
    "49364": {
      "id": 3224207,
      "text": "Sharks, với sự giúp đỡ của các bạn, Scrub Daddy sẽ chà rửa và mỉm cười trong mọi căn bếp trên thế giới.",
      "author": "ChatGPT4.1"
    }
  }
