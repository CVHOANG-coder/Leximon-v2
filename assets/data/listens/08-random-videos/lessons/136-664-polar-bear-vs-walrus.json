  "translations": {
    "31396": {
      "id": 530951,
      "text": "Kiệt sức vì bơi, chú gấu phải lấy lại sức.",
      "author": "a user"
    },
    "31398": {
      "id": 530954,
      "text": "Những con hải mã cảm thấy chúng đang gặp nguy hiểm.",
      "author": "a user"
    },
    "31400": {
      "id": 530956,
      "text": "Những con trưởng thành xếp thành hàng quanh con non, tạo thành bức tường mỡ và da.",
      "author": "a user"
    },
    "31401": {
      "id": 530957,
      "text": "Anh ta thử rào chắn nhưng nó vẫn đứng vững.",
      "author": "a user"
    },
    "31402": {
      "id": 530958,
      "text": "Có vẻ như loài ăn thịt trên cạn lớn nhất thế giới đã gặp được đối thủ xứng tầm.",
      "author": "a user"
    },
    "31403": {
      "id": 530959,
      "text": "Chắc chắn phải có một khe hở nào đó ở lớp giáp này.",
      "author": "a user"
    },
    "31405": {
      "id": 532355,
      "text": "Con hải mã cái này đang che chở cho con của mình.",
      "author": "a user"
    },
    "31407": {
      "id": 532357,
      "text": "Móng vuốt và răng của con gấu không thể xuyên thủng lớp da dày của cô.",
      "author": "a user"
    },
    "31408": {
      "id": 532358,
      "text": "Khi cả đàn rút lui về phía nước, con gấu phải di chuyển thật nhanh.",
      "author": "a user"
    },
    "31409": {
      "id": 532359,
      "text": "Thất bại với một mục tiêu, anh ta tiến thẳng đến mục tiêu khác.",
      "author": "a user"
    },
    "31410": {
      "id": 532360,
      "text": "Cơ hội được ăn bữa đầu tiên sau nhiều tháng của anh đang dần trôi qua.",
      "author": "a user"
    },
    "31411": {
      "id": 532361,
      "text": "Anh ấy có vẻ ngày càng tuyệt vọng.",
      "author": "a user"
    },
    "31414": {
      "id": 532365,
      "text": "Con hải mã quẫy đạp vô cùng mạnh mẽ và kéo con gấu ra khỏi vùng nước nông đến nơi an toàn của đàn.",
      "author": "a user"
    },
    "31406": {
      "id": 610469,
      "text": "Nếu anh ta có thể tách cô ấy ra...",
      "author": "a user"
    },
    "31397": {
      "id": 2594729,
