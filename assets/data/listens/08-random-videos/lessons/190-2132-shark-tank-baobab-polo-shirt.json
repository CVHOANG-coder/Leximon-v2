  "translations": {
    "84215": {
      "id": 2606363,
      "text": "Tiếp theo là một món đồ thời trang vừa tiện dụng vừa thời thượng.",
      "author": "ChatGPT4.1"
    },
    "84216": {
      "id": 2606364,
      "text": "Chào các Sharks, tôi tên là Brandon.",
      "author": "ChatGPT4.1"
    },
    "84217": {
      "id": 2606365,
      "text": "Và tôi tên là Marcellus.",
      "author": "ChatGPT4.1"
    },
    "84218": {
      "id": 2606366,
      "text": "Chúng tôi kêu gọi 150.000 đô la đổi lấy 10% cổ phần của công ty chúng tôi, Baobab.",
      "author": "ChatGPT4.1"
    },
    "84219": {
      "id": 2606367,
      "text": "Chúng tôi là hai chuyên gia chăm chỉ sống tại thành phố New York, rất yêu thích mặc áo polo.",
      "author": "ChatGPT4.1"
    },
    "84220": {
      "id": 2606368,
      "text": "Nó gần như là đồng phục của chúng tôi.",
      "author": "ChatGPT4.1"
    },
    "84221": {
      "id": 2606369,
      "text": "Nhưng chúng tôi cảm thấy mệt mỏi và thất vọng vì chúng xuống cấp chỉ sau vài lần mặc và giặt.",
      "author": "ChatGPT4.1"
    },
    "84222": {
      "id": 2606370,
      "text": "Và các bạn biết chính xác anh ấy đang nói về điều gì.",
      "author": "ChatGPT4.1"
    },
    "84223": {
      "id": 2606371,
      "text": "Khi áo của bạn phai màu và từ sang trọng thành xỉn màu.",
      "author": "a user"
    },
    "84224": {
      "id": 2606372,
      "text": "Hoặc khi nó bị co lại sau khi giặt",
      "author": "ChatGPT4.1"
    },
    "84225": {
      "id": 2606373,
      "text": "và áo size lớn biến thành size \"vừa nhỏ\".",
      "author": "ChatGPT4.1"
    },
    "84226": {
      "id": 2606374,
      "text": "Ôi trời, tôi ghét áo \"vừa nhỏ\" lắm.",
      "author": "ChatGPT4.1"
    },
    "84227": {
      "id": 2606375,
      "text": "Hoặc khi cổ áo bị xoắn lại và nhăn nhúm.",
      "author": "ChatGPT4.1"
    },
    "84228": {
      "id": 2606376,
      "text": "Đó là điều chúng tôi gọi là cổ áo \"thịt xông khói\".",
      "author": "ChatGPT4.1"
    },
    "84229": {
      "id": 2606377,
      "text": "Vì vậy chúng tôi đã bắt tay vào một sứ mệnh giải quyết tất cả những vấn đề này và nhiều hơn nữa.",
      "author": "ChatGPT4.1"
    },
    "84230": {
      "id": 2606378,
      "text": "Thông qua việc sử dụng thiết kế, công nghệ và sáng tạo.",
      "author": "ChatGPT4.1"
    },
    "84231": {
      "id": 2606379,
      "text": "Và đó là lý do chúng tôi tạo ra áo polo Baobab.",
      "author": "ChatGPT4.1"
    },
    "84232": {
      "id": 2606380,
      "text": "Chiếc áo polo hoàn hảo.",
      "author": "ChatGPT4.1"
    },
    "84233": {
      "id": 2606381,
      "text": "Áo polo Baobab được làm từ loại cotton tốt nhất thế giới, cotton Pima Peru.",
      "author": "ChatGPT4.1"
    },
    "84234": {
      "id": 2606382,
      "text": "Giờ đây, nhờ quy trình sản xuất độc quyền của chúng tôi gọi là Baotech.",
      "author": "ChatGPT4.1"
    },
    "84235": {
      "id": 2606383,
      "text": "Quy trình này giúp áo hoàn toàn chống lại các vết bẩn như cà phê.",
      "author": "ChatGPT4.1"
    },
    "84236": {
      "id": 2606384,
      "text": "Sắp trình diễn đây.",
      "author": "ChatGPT4.1"
    },
    "84237": {
      "id": 2606385,
      "text": "Wow, wow.",
      "author": "ChatGPT4.1"
    },
    "84238": {
      "id": 2606386,
      "text": "Rượu vang? Bạn gọi Pinot Noir à? Đúng rồi, đúng rồi.",
      "author": "ChatGPT4.1"
    },
    "84239": {
      "id": 2606387,
      "text": "Ôi, đừng là sốt cà chua chứ.",
      "author": "ChatGPT4.1"
    },
    "84240": {
      "id": 2606388,
      "text": "Tôi từng rất ghét khi chuyện như thế này xảy ra.",
      "author": "ChatGPT4.1"
    },
    "84242": {
      "id": 2606389,
      "text": "Sharks, khi tôi quyết định giặt nó, áo sẽ không bị co lại hay phai màu.",
      "author": "ChatGPT4.1"
    },
    "84243": {
      "id": 2606390,
      "text": "Và với cổ áo giữ phẳng đang chờ cấp bằng sáng chế của chúng tôi,",
      "author": "ChatGPT4.1"
    },
    "84244": {
      "id": 2606391,
      "text": "Chúng tôi giữ cho cổ áo luôn đẹp trong một thời gian rất dài.",
      "author": "ChatGPT4.1"
    },
    "84245": {
      "id": 2606392,
      "text": "Sharks, hãy cùng chúng tôi chinh phục thị trường thời trang nam trị giá 30 tỷ đô la này.",
      "author": "ChatGPT4.1"
    },
    "84246": {
      "id": 3011648,
      "text": "Và đồng hành cùng chúng tôi tạo ra những chiếc áo polo tốt hơn không thể phủ nhận.",
      "author": "ChatGPT4.1"
    },
