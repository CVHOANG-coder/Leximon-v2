  "translations": {
    "84019": {
      "id": 2638904,
      "text": "Đầu tiên vào \"bể cá mập\" là một sản phẩm hai trong một được thiết kế với sự tiện lợi trong tâm trí.",
      "author": "ChatGPT4.1"
    },
    "84020": {
      "id": 2638905,
      "text": "Xin chào các Shark, tôi là Rener Gracie.",
      "author": "ChatGPT4.1"
    },
    "84021": {
      "id": 2638906,
      "text": "Và tôi đang tìm kiếm một khoản đầu tư 500.000 đô la",
      "author": "ChatGPT4.1"
    },
    "84022": {
      "id": 2638907,
      "text": "đổi lấy 5% cổ phần trong công ty thời trang của tôi, Quik Flip.",
      "author": "ChatGPT4.1"
    },
    "84023": {
      "id": 2638908,
      "text": "Đó là một buổi sáng tháng Mười Hai lạnh lẽo,",
      "author": "ChatGPT4.1"
    },
    "84024": {
      "id": 2638909,
      "text": "và con trai tôi muốn đi công viên.",
      "author": "ChatGPT4.1"
    },
    "84025": {
      "id": 2638910,
      "text": "Vì vậy, tôi mặc chiếc áo hoodie yêu thích của mình và chúng tôi lên đường.",
      "author": "ChatGPT4.1"
    },
    "84026": {
      "id": 2638911,
      "text": "Sau khoảng 30 phút đuổi theo cậu nhóc này vòng quanh công viên,",
      "author": "ChatGPT4.1"
    },
    "84027": {
      "id": 2638912,
      "text": "mặt trời bắt đầu ló ra khỏi những đám mây.",
      "author": "ChatGPT4.1"
    },
    "84028": {
      "id": 2638913,
      "text": "Và tôi bắt đầu đổ mồ hôi.",
      "author": "ChatGPT4.1"
    },
    "84029": {
      "id": 2638914,
      "text": "Lúc đó, tôi không còn lựa chọn nào khác ngoài việc cởi áo hoodie ra.",
      "author": "ChatGPT4.1"
    },
    "84030": {
      "id": 2638915,
      "text": "Bạn có thể đoán được các lựa chọn của tôi là gì.",
      "author": "ChatGPT4.1"
    },
    "84031": {
      "id": 2638916,
      "text": "Chúng ta có túi đeo hông.",
      "author": "ChatGPT4.1"
    },
    "84032": {
      "id": 2638917,
      "text": "Chúng ta có kiểu đeo áo qua vai kiểu \"câu lạc bộ du thuyền châu Âu\".",
      "author": "ChatGPT4.1"
    },
    "84034": {
      "id": 2638918,
      "text": "Và rồi là kiểu trông-cho-ngầu.",
      "author": "ChatGPT4.1"
    },
    "84035": {
      "id": 2638919,
      "text": "Đây là lựa chọn mà tôi đã chọn.",
      "author": "ChatGPT4.1"
    },
    "84036": {
      "id": 2638920,
      "text": "Nhưng khi cuối cùng tôi cũng bắt kịp cậu bé, tôi cúi xuống để bế cậu lên.",
      "author": "ChatGPT4.1"
    },
    "84037": {
      "id": 2638921,
      "text": "Chiếc áo hoodie trượt khỏi vai tôi xuống bãi cỏ ướt.",
      "author": "ChatGPT4.1"
    },
    "84038": {
      "id": 2638922,
      "text": "Phải có cách nào tốt hơn chứ.",
      "author": "ChatGPT4.1"
    },
    "84039": {
      "id": 2638923,
      "text": "Các Shark, chính vì vậy, Quik Flip đã ra đời.",
      "author": "ChatGPT4.1"
    },
    "84040": {
      "id": 2638924,
      "text": "Xem này nhé: lật áo, nhét lại,",
      "author": "ChatGPT4.1"
    },
    "84041": {
      "id": 2638925,
      "text": "lắc nhẹ, và xong.",
      "author": "ChatGPT4.1"
    },
    "84042": {
      "id": 2638926,
      "text": "Chỉ trong vài giây, sử dụng công nghệ chuyển đổi độc quyền của chúng tôi,",
      "author": "ChatGPT4.1"
    },
    "84043": {
      "id": 2638927,
      "text": "chúng tôi có thể biến bất kỳ trang phục khoác ngoài nào thành một chiếc ba lô hoàn chỉnh chỉ trong chớp mắt.",
      "author": "ChatGPT4.1"
    },
    "84044": {
      "id": 2638928,
      "text": "Với công nghệ trượt và kẹp của chúng tôi, bạn có thể điều chỉnh ba lô để giữ an toàn và chắc chắn",
      "author": "ChatGPT4.1"
    },
    "84045": {
      "id": 2638929,
      "text": "trong bất kỳ hoạt động nào.",
      "author": "ChatGPT4.1"
    },
    "84046": {
      "id": 2638930,
      "text": "Thậm chí cả Jiu-Jitsu với anh trai bạn.",
      "author": "ChatGPT4.1"
    },
    "84047": {
      "id": 2638931,
      "text": "Nhưng khoan, vẫn còn nữa.",
      "author": "ChatGPT4.1"
    },
    "84048": {
      "id": 2638932,
      "text": "Bạn có thể cất bất cứ gì bạn muốn bên trong ba lô.",
      "author": "ChatGPT4.1"
    },
    "84049": {
      "id": 2638933,
      "text": "Khi nhiệt độ giảm, chỉ cần thò tay vào, lấy đồ ra bằng một tay.",
      "author": "ChatGPT4.1"
    },
    "84050": {
      "id": 3033116,
      "text": "Các Sharks, đếm đến ba đi.",
      "author": "ChatGPT4.1"
    },
    "84051": {
      "id": 3033117,
      "text": "Quá trễ! Chúng tôi đã trở lại chức năng áo hoodie trong vài giây rồi.",
      "author": "ChatGPT4.1"
    },
    "84052": {
      "id": 3033118,
      "text": "Tôi chỉ cần những đối tác kinh doanh đai đen giúp tôi khuất phục ngành hàng...",
      "author": "ChatGPT4.1"
    },
    "84053": {
      "id": 3033119,
      "text": "để cùng tôi khuất phục ngành hàng áo khoác ngoài và biến khoản đầu tư của bạn thành lợi nhuận đai đen.",
      "author": "ChatGPT4.1"
    },
    "84054": {
      "id": 3033120,
      "text": "Ai sẽ cùng tôi?",
      "author": "ChatGPT4.1"
    }
  }
}
