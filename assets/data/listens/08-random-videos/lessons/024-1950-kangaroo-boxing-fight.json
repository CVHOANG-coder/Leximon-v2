  "translations": {
    "75214": {
      "id": 2590819,
      "text": "Đối với kangaroo, những thử thách lớn nhất đến từ chính xã hội của chúng.",
      "author": "ChatGPT4.1"
    },
    "75215": {
      "id": 2590820,
      "text": "Đối với một con đực, chỉ có một bài học quan trọng duy nhất cần học trong cuộc đời.",
      "author": "ChatGPT4.1"
    },
    "75216": {
      "id": 2590821,
      "text": "Để đứng đầu, nó phải trở thành một chiến binh.",
      "author": "ChatGPT4.1"
    },
    "75217": {
      "id": 2590822,
      "text": "Những trận chiến khốc liệt đến mức con đực cần nhiều năm huấn luyện để chuẩn bị.",
      "author": "ChatGPT4.1"
    },
    "75218": {
      "id": 2590823,
      "text": "Những nỗ lực này rất xứng đáng, vì một chiến binh vô địch sẽ có đặc quyền tiếp cận các con cái.",
      "author": "ChatGPT4.1"
    },
    "75219": {
      "id": 2590824,
      "text": "Cánh đồng này là nơi huấn luyện cho những chú kangaroo trẻ khao khát trở thành võ sĩ.",
      "author": "ChatGPT4.1"
    },
    "75220": {
      "id": 2590825,
      "text": "Việc huấn luyện bắt đầu ngay khi một con non rời khỏi túi mẹ.",
      "author": "ChatGPT4.1"
    },
    "75221": {
      "id": 2590826,
      "text": "Mẹ là đối thủ đầu tiên lý tưởng cho chú kangaroo con học những điều cơ bản.",
      "author": "ChatGPT4.1"
    },
    "75223": {
      "id": 2590827,
      "text": "Nhưng nó sẽ sớm rời đi để tìm kiếm những đối thủ tập luyện khác.",
      "author": "ChatGPT4.1"
    },
    "75225": {
      "id": 2590828,
      "text": "Các con trưởng thành khác không khoan dung với kẻ nhẹ ký này.",
      "author": "ChatGPT4.1"
    },
    "75227": {
      "id": 2590829,
      "text": "Chỉ một con đực này thống trị cả cánh đồng.",
      "author": "ChatGPT4.1"
    },
    "75228": {
      "id": 2590830,
      "text": "Nó cao tới tám feet, cơ bắp rắn chắc qua nhiều năm tập luyện.",
      "author": "ChatGPT4.1"
    },
    "75229": {
      "id": 2590831,
      "text": "Hôm nay, một kẻ thách thức ngôi vị của nó đã xuất hiện.",
      "author": "ChatGPT4.1"
    },
    "75230": {
      "id": 2590832,
      "text": "Các cuộc chiến thực sự rất nguy hiểm, không ai dám xem nhẹ.",
      "author": "ChatGPT4.1"
    },
    "75231": {
      "id": 2590833,
      "text": "Nhưng khi hai con đực đấu nhau, đã tới lúc phải dọn sạch đấu trường.",
      "author": "ChatGPT4.1"
    },
    "75233": {
      "id": 2590834,
      "text": "Bất kỳ chiêu trò nào cũng được chấp nhận trong những cuộc tranh giành quyền lực này.",
      "author": "ChatGPT4.1"
    },
    "75234": {
      "id": 2590835,
      "text": "Móc mắt hoàn toàn nằm trong luật chơi.",
      "author": "ChatGPT4.1"
    },
    "75236": {
      "id": 2590836,
      "text": "Đá vào hạ bộ cũng được phép.",
      "author": "ChatGPT4.1"
    },
    "75237": {
      "id": 2590837,
      "text": "Kỹ năng của con đực thống trị đã thể hiện rõ ràng.",
      "author": "ChatGPT4.1"
    },
    "75239": {
      "id": 2590838,
      "text": "Cái giá phải trả rất lớn.",
      "author": "ChatGPT4.1"
    },
    "75240": {
      "id": 2590839,
      "text": "Chúng có nguy cơ gãy xương và tổn thương nội tạng.",
      "author": "ChatGPT4.1"
    },
    "75242": {
      "id": 2590840,
      "text": "Đột nhiên... mọi thứ kết thúc.",
      "author": "ChatGPT4.1"
    },
    "75243": {
      "id": 2590841,
      "text": "Nhà vô địch đã đánh bại kẻ thách thức, ít nhất là vào lúc này.",
      "author": "ChatGPT4.1"
    },
