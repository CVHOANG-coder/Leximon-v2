  "translations": {
    "74856": {
      "id": 1733757,
      "text": "Người ta biết rằng có ít hơn 40 loài tồn tại.",
      "author": "a user"
    },
    "74857": {
      "id": 1733758,
      "text": "Người ta rất hiếm khi nhìn thấy chúng nên người ta cho rằng chúng chỉ là một huyền thoại.",
      "author": "a user"
    },
    "74860": {
      "id": 1733761,
      "text": "Chúng đang bám víu vào sự tồn tại.",
      "author": "a user"
    },
    "74864": {
      "id": 1733765,
      "text": "Chúng phải đối mặt với một hành trình gian khổ băng qua sa mạc.",
      "author": "a user"
    },
    "74855": {
      "id": 2592399,
      "text": "Gấu Gobi.",
      "author": "ChatGPT4.1"
    },
    "74858": {
      "id": 2592400,
      "text": "Cuộc sống ở đây, giữa vùng đất khô cằn của châu Á...",
      "author": "ChatGPT4.1"
    },
    "74859": {
      "id": 2592401,
      "text": "đã biến chúng thành một trong những loài động vật cứng cỏi nhất trên trái đất.",
      "author": "ChatGPT4.1"
    },
    "74861": {
      "id": 2592402,
      "text": "Trong tiếng Mông Cổ, Gobi có nghĩa là vùng đất không nước",
      "author": "ChatGPT4.1"
    },
    "74862": {
      "id": 2592403,
      "text": "và ở đó chính là thử thách lớn nhất đối với loài gấu này.",
      "author": "ChatGPT4.1"
    },
    "74863": {
      "id": 2592404,
      "text": "Các nguồn nước có thể cách nhau tới 100 dặm.",
      "author": "ChatGPT4.1"
    },
    "74865": {
      "id": 2592405,
      "text": "Để tìm nước, bầy gấu đi theo những lối mòn đã in dấu qua sa mạc rộng lớn này.",
      "author": "ChatGPT4.1"
    },
    "74866": {
      "id": 2592406,
      "text": "Và đây là lý do.",
      "author": "ChatGPT4.1"
    },
    "74867": {
      "id": 2592407,
      "text": "Một ốc đảo.",
      "author": "ChatGPT4.1"
    },
    "74868": {
      "id": 2592408,
      "text": "Một mạch nước ngọt được cung cấp từ lòng đất sâu.",
      "author": "ChatGPT4.1"
    },
    "74869": {
      "id": 2592409,
      "text": "Cuối cùng, một ngụm nước,",
      "author": "ChatGPT4.1"
    },
    "74870": {
      "id": 2592410,
      "text": "và một lần tắm mát sảng khoái.",
      "author": "ChatGPT4.1"
    },
    "74871": {
      "id": 2592411,
      "text": "Những ốc đảo là nguồn sống cho loài gấu,",
      "author": "ChatGPT4.1"
    },
    "74872": {
      "id": 2592412,
      "text": "đặc biệt đối với những cá thể vô cùng quý giá:",
      "author": "ChatGPT4.1"
    },
    "74873": {
      "id": 2592413,
      "text": "một chú gấu con Gobi.",
      "author": "ChatGPT4.1"
    },
    "74874": {
      "id": 2592414,
      "text": "Tương lai của loài gấu này phụ thuộc vào chỉ vài cá thể hiếm hoi.",
      "author": "ChatGPT4.1"
    },
    "74875": {
      "id": 2592415,
      "text": "Nhưng chú gấu nhỏ này là biểu tượng của hy vọng cho loài gấu Gobi.",
      "author": "ChatGPT4.1"
    }
  }
}
