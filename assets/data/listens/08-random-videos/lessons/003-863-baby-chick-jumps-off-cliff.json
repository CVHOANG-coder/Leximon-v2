  "translations": {
    "44348": {
      "id": 745819,
      "text": "Và một pha rơi trong kiểm soát.",
      "author": "a user"
    },
    "44349": {
      "id": 745820,
      "text": "Đây là một màn hạ cánh tốt nhất có thể thực hiện được.",
      "author": "a user"
    },
    "44353": {
      "id": 745824,
      "text": "Có lẽ một chút choáng váng, nhưng vẫn còn một mảnh (nguyên vẹn).",
      "author": "a user"
    },
    "44355": {
      "id": 745826,
      "text": "Và chú ngỗng con này nhìn như đang ở trong tình trạng xấu.",
      "author": "a user"
    },
    "44359": {
      "id": 745828,
      "text": "Khả năng phục hồi của ngỗng barnacle con thật phi thường.",
      "author": "a user"
    },
    "44360": {
      "id": 745829,
      "text": "Nhưng vẫn còn những chú ngỗng con chưa được tìm thấy, ở đâu đó giữa đống đất đá.",
      "author": "a user"
    },
    "44361": {
      "id": 745830,
      "text": "Ngỗng cha mẹ không thể mạo hiểm tìm kiếm",
      "author": "a user"
    },
    "44362": {
      "id": 745831,
      "text": "vì chúng cần nhanh chóng dẫn hai đứa con sống sót của mình rời đi, trước khi những kẻ săn mồi đến.",
      "author": "a user"
    },
    "44363": {
      "id": 745832,
      "text": "Một con thứ ba đã làm được điều đó\n",
      "author": "a user"
    },
    "44366": {
      "id": 745835,
      "text": "Ba trong số năm chú ngỗng con đã làm được.",
      "author": "a user"
    },
    "44367": {
      "id": 745836,
      "text": "Nếu không có một khởi đầu kịch tính như vậy trong cuộc đời, có lẽ không con nào trong số chúng có thể tiến xa đến thế.",
      "author": "a user"
    },
    "44347": {
      "id": 1348378,
      "text": "Một cú phóng hoàn hảo.",
      "author": "a user"
    },
    "44351": {
      "id": 2592981,
      "text": "Bố mẹ của nó đang ở đó để đón nó.",
      "author": "ChatGPT4.1"
    },
    "44354": {
      "id": 2592982,
      "text": "Ít nhất thì một con ngỗng con đã không qua được.",
      "author": "ChatGPT4.1"
    },
    "44357": {
      "id": 2592983,
      "text": "Cuối cùng, nó cũng đáp lại tiếng gọi của mẹ nó.",
      "author": "ChatGPT4.1"
    },
    "44364": {
      "id": 2592984,
      "text": "Nhưng nó cần phải bắt kịp.",
      "author": "ChatGPT4.1"
    },
    "44365": {
      "id": 2592985,
      "text": "Đoàn tụ.",
      "author": "ChatGPT4.1"
