  "translations": {
    "31945": {
      "id": 2594934,
      "text": "Đây sẽ là điểm kết thúc của hành trình đối với nhiều con cá hồi.",
      "author": "ChatGPT4.1"
    },
    "31946": {
      "id": 2594935,
      "text": "Những con gấu này thực sự rất đói.",
      "author": "ChatGPT4.1"
    },
    "31947": {
      "id": 2594936,
      "text": "Chúng đã không được nếm cá hồi trong mười tháng.",
      "author": "ChatGPT4.1"
    },
    "31948": {
      "id": 2594937,
      "text": "Và những con đực lớn tranh đấu cho những vị trí bắt cá tốt nhất.",
      "author": "ChatGPT4.1"
    },
    "31949": {
      "id": 2594938,
      "text": "Cá hồi càng mất nhiều thời gian bơi ngược dòng thì chúng càng yếu đi.",
      "author": "ChatGPT4.1"
    },
    "31950": {
      "id": 2594939,
      "text": "Và thác nước này đặt ra cho chúng thử thách lớn nhất từ trước đến nay.",
      "author": "ChatGPT4.1"
    },
    "31951": {
      "id": 2594940,
      "text": "Mặc dù thác nước không cao lắm, những con gấu vẫn chiếm vị trí thượng phong.",
      "author": "ChatGPT4.1"
    },
    "31952": {
      "id": 2594941,
      "text": "Cá hồi nhảy thử ngắn để dò xem gấu ở đâu.",
      "author": "ChatGPT4.1"
    },
    "31953": {
      "id": 2594942,
      "text": "Nhưng chúng không phải lúc nào cũng đoán đúng.",
      "author": "ChatGPT4.1"
    },
    "31954": {
      "id": 2594943,
      "text": "Con gấu mẹ này đã chờ đợi nhiều tháng cho khoảnh khắc này.",
      "author": "ChatGPT4.1"
    },
    "31955": {
      "id": 2594944,
      "text": "Cạnh tranh khốc liệt cho những con cá hồi đầu tiên này,",
      "author": "ChatGPT4.1"
    },
    "31956": {
      "id": 2594945,
      "text": "thậm chí giữa gấu mẹ và chính con của mình.",
      "author": "ChatGPT4.1"
    },
    "31957": {
      "id": 2594946,
      "text": "Ngày càng nhiều cá bơi đến chân thác nước.",
      "author": "ChatGPT4.1"
    },
    "31958": {
      "id": 2594947,
      "text": "Cuối cùng, chúng phải thử sức, bất chấp nguy hiểm.",
      "author": "ChatGPT4.1"
    },
    "31959": {
      "id": 2594948,
      "text": "Nhưng số lượng lại nghiêng về phía chúng.",
      "author": "ChatGPT4.1"
    },
    "31960": {
      "id": 2594949,
      "text": "Cứ mỗi con cá hồi bị bắt, hàng trăm con khác vượt qua được những con gấu.",
      "author": "ChatGPT4.1"
    },
