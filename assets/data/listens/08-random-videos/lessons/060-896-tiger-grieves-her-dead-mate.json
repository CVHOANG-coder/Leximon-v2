  "translations": {
    "46870": {
      "id": 2636246,
      "text": "Baghani lại sẵn sàng giao phối.",
      "author": "ChatGPT4.1"
    },
    "46871": {
      "id": 2636247,
      "text": "Cô ấy đã dành cả buổi sáng để gọi Rajore.",
      "author": "ChatGPT4.1"
    },
    "46873": {
      "id": 2636248,
      "text": "Nhưng cho đến giờ vẫn chưa có hồi âm.",
      "author": "ChatGPT4.1"
    },
    "46874": {
      "id": 2636249,
      "text": "Khi anh ấy không xuất hiện suốt ba ngày, tất cả chúng tôi cùng tham gia tìm kiếm.",
      "author": "ChatGPT4.1"
    },
    "46875": {
      "id": 2636250,
      "text": "Lần theo dấu vết của anh ấy...",
      "author": "ChatGPT4.1"
    },
    "46876": {
      "id": 2636251,
      "text": "Theo dõi dấu chân của anh ấy.",
      "author": "ChatGPT4.1"
    },
    "46877": {
      "id": 2636252,
      "text": "Tất cả chúng tôi đều lo lắng.",
      "author": "ChatGPT4.1"
    },
    "46878": {
      "id": 2636253,
      "text": "Và rồi chúng tôi phát hiện anh ấy... đã chết.",
      "author": "ChatGPT4.1"
    },
    "46879": {
      "id": 2636254,
      "text": "Không phải bị thợ săn trộm giết...",
      "author": "ChatGPT4.1"
    },
    "46880": {
      "id": 2636255,
      "text": "mà bị một người dân đầu độc để bảo vệ gia súc.",
      "author": "ChatGPT4.1"
    },
    "46881": {
      "id": 2636256,
      "text": "Nhưng Baghani không biết bạn đời của mình đã chết.",
      "author": "ChatGPT4.1"
    },
    "46882": {
      "id": 2636257,
      "text": "Cô ấy vẫn đang tìm kiếm anh ấy.",
      "author": "ChatGPT4.1"
    },
    "46884": {
      "id": 2636258,
      "text": "Cô ấy có thể ngửi thấy mùi anh ấy, nhưng anh đã đi rồi.",
      "author": "ChatGPT4.1"
    },
    "46885": {
      "id": 2636259,
      "text": "Cô ấy khóc suốt ba ngày sau cái chết của anh ấy.",
      "author": "ChatGPT4.1"
    },
    "46886": {
      "id": 2636260,
