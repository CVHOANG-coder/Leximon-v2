  "translations": {
    "28486": {
      "id": 455158,
      "text": "hoặc khiến nhiều người trong chúng ta bị bệnh hơn",
      "author": "a user"
    },
    "28487": {
      "id": 455159,
      "text": "Vậy điều gì khiến vết muỗi đốt có hiệu quả đến vậy?",
      "author": "a user"
    },
    "28488": {
      "id": 455160,
      "text": "Đầu tiên, chúng có động lực.",
      "author": "a user"
    },
    "28489": {
      "id": 455161,
      "text": "Chỉ có con cái cắn chúng ta.",
      "author": "a user"
    },
    "28494": {
      "id": 455167,
      "text": "Nhưng những công cụ nó sử dụng ở đây rất phức tạp.",
      "author": "a user"
    },
    "28495": {
      "id": 455168,
      "text": "Đầu tiên, một lớp vỏ bảo vệ rút lại — bạn thấy nó đang cong ngược ra phía sau không?",
      "author": "a user"
    },
    "28496": {
      "id": 455170,
      "text": "Nếu bạn nhìn vào đầu muỗi dưới kính hiển vi, bạn có thể thấy lớp vỏ đó bảo vệ cái gì.",
      "author": "a user"
    },
    "28498": {
      "id": 455172,
      "text": "Hai trong số những cây kim đó có răng cưa nhỏ.",
      "author": "a user"
    },
    "28499": {
      "id": 455173,
      "text": "Con muỗi dùng chúng để cưa xuyên qua da.",
      "author": "a user"
    },
    "28500": {
      "id": 455174,
      "text": "Chúng sắc đến mức bạn hầu như không thể cảm thấy con muỗi đang đẩy vào da.",
      "author": "a user"
    },
    "28501": {
      "id": 455175,
      "text": "Hai cây kim khác giữ các mô tách biệt nhau trong khi nó làm việc.",
      "author": "a user"
    },
    "28502": {
      "id": 455176,
      "text": "Từ dưới da, bạn có thể thấy con muỗi đang thăm dò, tìm kiếm mạch máu.",
      "author": "a user"
    },
    "28503": {
      "id": 455177,
      "text": "Các thụ thể ở đầu một trong những cây kim khác của cô ấy sẽ nhận biết các chất hóa học mà mạch máu của chúng ta tiết ra một cách tự nhiên và hướng dẫn cô ấy đến đó.",
      "author": "a user"
    },
    "28504": {
      "id": 455178,
      "text": "Sau đó, con muỗi sử dụng chính chiếc kim này như một chiếc ống hút.",
      "author": "a user"
    },
    "28505": {
      "id": 455179,
      "text": "Khi ruột của nó đầy lên, nó tách nước ra khỏi máu và ép nước ra ngoài.",
      "author": "a user"
    },
    "28506": {
      "id": 455180,
      "text": "Bạn có thấy giọt nước kia không?",
      "author": "a user"
    },
    "28507": {
      "id": 455181,
      "text": "Việc này giải phóng không gian để nó có thể nạp thêm các tế bào hồng cầu giàu dinh dưỡng hơn.",
      "author": "a user"
    },
    "28508": {
      "id": 455182,
      "text": "Với một cây kim khác, con muỗi bơm hoá chất vào người chúng ta.",
      "author": "a user"
    },
    "28509": {
      "id": 455183,
      "text": "Chúng khiến máu của chúng ta chảy dễ dàng hơn, và sau đó để lại những vết sưng ngứa.",
      "author": "a user"
    },
    "28510": {
      "id": 455184,
      "text": "Và đôi khi, trước khi bỏ đi, con muỗi để lại một món quà chia tay trong nước bọt của mình:",
      "author": "a user"
    },
    "28512": {
      "id": 455186,
      "text": "Con muỗi không hưởng lợi gì cả.",
      "author": "a user"
    },
    "28514": {
      "id": 455188,
      "text": "Nhưng đây chính là điều khiến chúng ta và muỗi trở thành kẻ thù không đội trời chung.",
      "author": "a user"
    },
    "28515": {
      "id": 455189,
      "text": "Muỗi hút máu chúng ta.",
      "author": "a user"
    },
    "28516": {
      "id": 455190,
      "text": "Đôi khi chúng ta trả đũa lại.",
      "author": "a user"
    },
    "28517": {
      "id": 455191,
      "text": "Nhưng thường là không đủ sớm.",
      "author": "a user"
    },
    "28482": {
      "id": 2583449,
      "text": "Đây là loài động vật chết người nhất trên thế giới.",
      "author": "ChatGPT4.1"
    },
    "28483": {
      "id": 2583450,
      "text": "Muỗi giết chết hàng trăm nghìn người mỗi năm...",
      "author": "ChatGPT4.1"
    },
    "28484": {
      "id": 2583451,
      "text": "Những người dễ bị tổn thương nhất: trẻ em, phụ nữ mang thai...",
      "author": "ChatGPT4.1"
    },
    "28485": {
      "id": 2583452,
      "text": "Không có vết cắn nào khác giết nhiều người hơn...",
      "author": "ChatGPT4.1"
    },
    "28490": {
      "id": 2583453,
      "text": "Chúng cần máu để tạo trứng...",
      "author": "ChatGPT4.1"
    },
    "28491": {
      "id": 2583454,
      "text": "Và một vũng nước để con của chúng nở ra.",
      "author": "ChatGPT4.1"
    },
    "28492": {
      "id": 2583455,
      "text": "Thậm chí một mảnh rác cũng có thể đủ nước.",
      "author": "ChatGPT4.1"
    },
    "28493": {
      "id": 2583456,
      "text": "Nhìn sơ qua, có vẻ đơn giản - con muỗi này đang đâm vòi vào chúng ta.",
      "author": "ChatGPT4.1"
    },
    "28497": {
      "id": 2583457,
      "text": "Và bên trong, có tới sáu chiếc kim nhỏ!",
      "author": "ChatGPT4.1"
    },
    "28511": {
      "id": 2583458,
      "text": "Một loại vi rút hoặc ký sinh trùng có thể làm chúng ta bệnh hoặc chết.",
      "author": "ChatGPT4.1"
    },
    "28513": {
      "id": 2585188,
      "text": "Vi rút và ký sinh trùng chỉ đang quá giang mà thôi.",
      "author": "ChatGPT4.1"
    }
  }
}
