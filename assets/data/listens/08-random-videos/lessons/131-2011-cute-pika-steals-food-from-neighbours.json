  "translations": {
    "78307": {
      "id": 1820951,
      "text": "Sống bằng nguồn lương thực dự trữ mà anh ta tích lũy được vào năm ngoái.",
      "author": "a user"
    },
    "78308": {
      "id": 1820952,
      "text": "Với anh ấy, mùa hè cứ như đến chậm quá!",
      "author": "a user"
    },
    "78311": {
      "id": 1820955,
      "text": "Đây chính là điều mà tất cả các chú chuột pika ở đây đang mong đợi...",
      "author": "a user"
    },
    "78313": {
      "id": 1820957,
      "text": "Không còn thời gian để lãng phí.",
      "author": "a user"
    },
    "78314": {
      "id": 1820958,
      "text": "Sẵn sàng… Chuẩn bị…",
      "author": "a user"
    },
    "78315": {
      "id": 1820959,
      "text": "Bây giờ chúng phải thu thập càng nhiều thức ăn càng tốt trong thời gian nhanh nhất.",
      "author": "a user"
    },
    "78316": {
      "id": 1820960,
      "text": "Nhưng một một vài trong số chúng có vẻ không vội vã như vậy.",
      "author": "a user"
    },
    "78317": {
      "id": 1820961,
      "text": "Rõ ràng là chúng đang chờ thời cơ.",
      "author": "a user"
    },
    "78318": {
      "id": 1820962,
      "text": "Những con khác đang không ngừng thu thập lá.",
      "author": "a user"
    },
    "78319": {
      "id": 1820963,
      "text": "Chúng xây dựng những đống cỏ khô và việc đó đòi hỏi rất nhiều công sức.",
      "author": "a user"
    },
    "78320": {
      "id": 1820964,
      "text": "Mỗi miếng ăn phải được đặt cẩn thận để ánh sáng mặt trời có thể làm khô chúng.",
      "author": "a user"
    },
    "78321": {
      "id": 1820965,
      "text": "Họ cũng thêm một vài chiếc lá khô từ các loại cây khác có chứa hóa chất",
      "author": "a user"
    },
    "78323": {
      "id": 1820967,
      "text": "Có thể cần tới khoảng 11.000 lượt đi và về",
      "author": "a user"
    },
    "78325": {
      "id": 1820969,
      "text": "Và rồi, phải đề phòng những kẻ láng giềng có cơ hội.",
      "author": "a user"
    },
    "78305": {
      "id": 2627822,
      "text": "Chuột núi Pika.",
      "author": "ChatGPT4.1"
    },
    "78306": {
