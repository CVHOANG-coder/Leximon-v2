  "translations": {
    "82489": {
      "id": 1928389,
      "text": "nhưng nó cần phải nhớ mình đã để ở những nơi nào.",
      "author": "a user"
    },
    "82496": {
      "id": 1928400,
      "text": "nhưng điều này cho phép chúng đến được những nơi mà những thứ khác không thể đến được.",
      "author": "a user"
    },
    "82497": {
      "id": 1928403,
      "text": "Đây có thể là nơi hoàn hảo.",
      "author": "a user"
    },
    "82502": {
      "id": 1930444,
      "text": "Con cái có thể làm được điều mà con đực không thể.",
      "author": "a user"
    },
    "82503": {
      "id": 1930445,
      "text": "Nhưng trước tiên, bố phải đưa bạn đời của mình đến chỗ con nòng nọc đói của chúng.",
      "author": "a user"
    },
    "82484": {
      "id": 2637425,
      "text": "Đây là một con ếch phi tiêu độc.",
      "author": "ChatGPT4.1"
    },
    "82485": {
      "id": 2637426,
      "text": "Con đực nuôi dưỡng con của mình theo một cách rất đặc biệt.",
      "author": "ChatGPT4.1"
    },
    "82486": {
      "id": 2637427,
      "text": "Người cha sẽ đặt từng con nòng nọc của mình vào mỗi vũng nước nhỏ riêng biệt.",
      "author": "ChatGPT4.1"
    },
    "82487": {
      "id": 2637428,
      "text": "Đây là một vũng. Đẹp và an toàn.",
      "author": "ChatGPT4.1"
    },
    "82488": {
      "id": 2637429,
      "text": "Anh ta có thể có tới năm con nòng nọc khác...",
      "author": "ChatGPT4.1"
    },
    "82490": {
      "id": 2637430,
      "text": "Con này thì không ổn lắm.",
      "author": "ChatGPT4.1"
    },
    "82491": {
      "id": 2637431,
      "text": "Vũng nước nhỏ của nó gần như đã cạn khô.",
      "author": "ChatGPT4.1"
    },
    "82492": {
      "id": 2637432,
      "text": "Nòng nọc sẽ chết nếu cha nó không thể tìm cho nó một nơi tốt hơn.",
      "author": "ChatGPT4.1"
    },
    "82493": {
      "id": 2637433,
      "text": "Nếu có điều gì mà các ông bố giỏi, thì đó là cho cưỡi lưng.",
      "author": "ChatGPT4.1"
    },
    "82495": {
      "id": 2637434,
      "text": "Những ông bố này không lớn hơn móng tay cái của con người,",
      "author": "ChatGPT4.1"
    },
    "82498": {
      "id": 2637435,
      "text": "Vấn đề duy nhất là ở đây không có thức ăn.",
      "author": "ChatGPT4.1"
    },
    "82499": {
      "id": 2637436,
      "text": "Những ông bố cần sự giúp đỡ.",
      "author": "ChatGPT4.1"
    },
    "82500": {
      "id": 2637437,
      "text": "Ở đâu đó trong khu rừng này...",
      "author": "ChatGPT4.1"
    },
    "82501": {
      "id": 2637438,
      "text": "là... Mẹ.",
      "author": "ChatGPT4.1"
    },
    "82505": {
      "id": 2637439,
      "text": "Và mẹ sẽ giải quyết vấn đề đó.",
      "author": "ChatGPT4.1"
    },
    "82506": {
      "id": 2637440,
      "text": "Mẹ để lại một quả trứng chưa thụ tinh.",
      "author": "ChatGPT4.1"
    },
    "82507": {
      "id": 2637441,
      "text": "Và nòng nọc của bà được bữa ăn rất cần thiết.",
      "author": "ChatGPT4.1"
    },
    "82508": {
      "id": 2637442,
      "text": "Trong sáu tuần tiếp theo, bố mẹ tiếp tục đi tuần quanh.",
      "author": "ChatGPT4.1"
    },
    "82509": {
      "id": 2637443,
      "text": "Một thử thách phi thường về làm việc nhóm và trí nhớ.",
      "author": "ChatGPT4.1"
    },
    "82494": {
