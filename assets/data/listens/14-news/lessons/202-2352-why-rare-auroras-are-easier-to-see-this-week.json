    },
    "92301": {
      "id": 3709787,
      "text": "Một cực quang đỏ.",
      "author": "ChatGPT4.1"
    },
    "92302": {
      "id": 3709788,
      "text": "Đây là video được quay bởi Don Pettit, người nói rằng ông đã nhìn thấy những cảnh như thế này hai hoặc ba lần trong nhiệm vụ 6 tháng của mình tại ISS.",
      "author": "ChatGPT4.1"
    },
    "92303": {
      "id": 3709789,
      "text": "Cực quang được tạo thành bởi sự tương tác của các hạt mang điện từ mặt trời khi chúng va chạm với từ trường và bầu khí quyển của Trái Đất.",
      "author": "ChatGPT4.1"
    },
    "92304": {
      "id": 3709790,
      "text": "Tuy nhiên, cực quang đỏ hiếm hơn cực quang xanh lá vì chúng liên quan đến các hoạt động mặt trời mạnh mẽ.",
      "author": "ChatGPT4.1"
    },
    "92305": {
      "id": 3709791,
      "text": "Một cơn bão mặt trời mạnh trong tuần này cũng khiến những đợt sóng cực quang tuyệt đẹp xuất hiện rõ ràng hơn bình thường đối với một số người trong chúng ta trên Trái Đất.",
      "author": "ChatGPT4.1"
    },
    "92306": {
      "id": 3709792,
      "text": "Một số khu vực phía nam Trung Tây nước Mỹ và Oregon đã nhìn thấy ánh sáng phương Bắc.",
      "author": "ChatGPT4.1"
    },
    "92307": {
      "id": 3709793,
      "text": "Bạn có nhìn thấy điều đó không?",
      "author": "ChatGPT4.1"
    },
    "92308": {
      "id": 3709794,
      "text": "Bạn có chụp được hình ảnh hoặc video nào không? Nếu có, hãy gửi chúng tới tài khoản Instagram @CNN10 của chúng tôi để chúng tôi có thể chia sẻ.",
      "author": "ChatGPT4.1"
    }
  }
