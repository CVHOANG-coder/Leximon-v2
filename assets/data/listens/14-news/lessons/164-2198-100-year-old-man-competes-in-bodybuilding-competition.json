  "translations": {
    "86923": {
      "id": 3184928,
      "text": "Anh chàng đang khoe cơ bắp trong cuộc thi thể hình này đã 100 tuổi.",
      "author": "ChatGPT4.1"
    },
    "86925": {
      "id": 3184930,
      "text": "Điều đó khiến Andrew Bostinto trở thành vận động viên thể hình thi đấu lớn tuổi nhất thế giới.",
      "author": "ChatGPT4.1"
    },
    "86926": {
      "id": 3184931,
      "text": "Ông ấy đã trình diễn trên sân khấu chính tại cuộc thi thể hình của Hiệp hội Thể hình Quốc gia ở Florida.",
      "author": "ChatGPT4.1"
    },
    "86927": {
      "id": 3184932,
      "text": "Bostinto mới 13 tuổi khi lần đầu tiên tham gia thi đấu.",
      "author": "ChatGPT4.1"
    },
    "86928": {
      "id": 3184933,
      "text": "Ông đoạt danh hiệu senior Mr. America năm 1977 khi 52 tuổi.",
      "author": "ChatGPT4.1"
    },
    "86929": {
      "id": 3184934,
      "text": "Tại cuộc thi gần đây nhất, ông được vợ mình, Francine, 67 tuổi, hộ tống lên sân khấu.",
      "author": "ChatGPT4.1"
    },
    "86930": {
      "id": 3184935,
      "text": "Nhạc vang lên, ông tháo dây áo choàng và đã đến giờ trình diễn.",
      "author": "ChatGPT4.1"
    },
    "86931": {
      "id": 3184936,
      "text": "Khán giả phấn khích mỗi lần ông khoe cơ bắp.",
      "author": "ChatGPT4.1"
    },
    "86932": {
      "id": 3184937,
      "text": "Và ông thực hiện xuất sắc từng động tác.",
      "author": "ChatGPT4.1"
    },
    "86933": {
      "id": 3184938,
      "text": "Ông đã trình diễn tất cả các tư thế kinh điển.",
      "author": "ChatGPT4.1"
    },
    "86934": {
      "id": 3184939,
      "text": "Bostinto giành giải cao nhất và nhận được cúp cùng đai vô địch.",
      "author": "ChatGPT4.1"
    },
    "86935": {
      "id": 3184940,
      "text": "Ông không phải là người duy nhất 100 tuổi còn trong tình trạng tuyệt vời.",
      "author": "ChatGPT4.1"
    },
    "86936": {
      "id": 3184941,
      "text": "Jerry Leo ở Long Island, New York cũng đã 100 tuổi.",
      "author": "ChatGPT4.1"
    },
    "86937": {
      "id": 3184942,
      "text": "Bà tập luyện năm ngày một tuần và nghe điều này:",
      "author": "ChatGPT4.1"
    },
    "86938": {
      "id": 3184943,
      "text": "Bà có thể plank trong năm phút.",
      "author": "ChatGPT4.1"
    },
    "86939": {
      "id": 3184944,
      "text": "Phần lớn chúng ta không thể plank nổi năm giây.",
      "author": "ChatGPT4.1"
    },
    "86940": {
      "id": 3184945,
      "text": "Bà cảm thấy khỏe như vẻ ngoài của mình không?",
      "author": "ChatGPT4.1"
    },
    "86941": {
      "id": 3184946,
      "text": "Có.",
      "author": "ChatGPT4.1"
    },
    "86942": {
      "id": 3184947,
      "text": "Bà quyết định thử thách tôi xem tôi có thể plank năm phút hay không.",
      "author": "ChatGPT4.1"
    },
    "86943": {
      "id": 3184948,
      "text": "Bạn cảm thấy thế nào?",
      "author": "ChatGPT4.1"
    },
    "86944": {
      "id": 3184949,
      "text": "Cảm thấy ổn, cảm thấy tuyệt.",
      "author": "ChatGPT4.1"
    },
    "86945": {
      "id": 3184950,
      "text": "Rất tuyệt. Không vấn đề gì.",
      "author": "ChatGPT4.1"
    },
    "86946": {
      "id": 3184951,
      "text": "Vậy bạn làm được đến đâu rồi?",
      "author": "ChatGPT4.1"
    },
    "86947": {
      "id": 3184952,
      "text": "Tôi sắp bỏ cuộc rồi...",
      "author": "ChatGPT4.1"
    },
    "86948": {
      "id": 3184953,
      "text": "Sau ba phút, tôi chịu thua.",
      "author": "ChatGPT4.1"
    },
    "86949": {
      "id": 3184954,
      "text": "Bị một bà cụ trăm tuổi plank lâu hơn.",
      "author": "ChatGPT4.1"
    },
    "86950": {
      "id": 3184955,
      "text": "Jerry, bà đánh bại tôi rồi.",
      "author": "ChatGPT4.1"
    },
    "86951": {
      "id": 3184956,
      "text": "Làm tốt lắm các cụ trăm tuổi.",
      "author": "ChatGPT4.1"
    },
    "86924": {
      "id": 3196967,
      "text": "À... chỉnh lại: 100 tuổi và 6 tháng.",
      "author": "ChatGPT4.1"
    }
  }
}
