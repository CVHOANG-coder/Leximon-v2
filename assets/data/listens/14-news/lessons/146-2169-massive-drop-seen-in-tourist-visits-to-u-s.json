  "translations": {
    "85812": {
      "id": 2653047,
      "text": "Những hình ảnh tuyệt đẹp về các máy bay chở khách gần như trống không đang xuất hiện trên mạng xã hội.",
      "author": "ChatGPT4.1"
    },
    "85813": {
      "id": 2653048,
      "text": "Những chuyến bay quốc tế này có nhiều du khách bay đến Mỹ gần như một mình.",
      "author": "ChatGPT4.1"
    },
    "85814": {
      "id": 2653049,
      "text": "Shauna Massengill đã bay từ London đến Chicago.",
      "author": "ChatGPT4.1"
    },
    "85815": {
      "id": 2653050,
      "text": "Nhìn này, hầu như chẳng có ai trên khoang cả.",
      "author": "ChatGPT4.1"
    },
    "85816": {
      "id": 2653051,
      "text": "Không có ai ở đó. Không có ai ở dãy ghế của tôi.",
      "author": "ChatGPT4.1"
    },
    "85817": {
      "id": 2653052,
      "text": "Thật sự sốc. Tôi chưa bao giờ đi chuyến bay nào như thế.",
      "author": "ChatGPT4.1"
    },
    "85818": {
      "id": 2653053,
      "text": "Chuyến bay từ Toronto đến New York này cũng gần như trống không.",
      "author": "ChatGPT4.1"
    },
    "85819": {
      "id": 2653054,
      "text": "Và một chuyến bay từ Toronto đến Fort Meyers.",
      "author": "ChatGPT4.1"
    },
    "85820": {
      "id": 2653055,
      "text": "Hàng ghế này đến hàng ghế khác đều trống không.",
      "author": "ChatGPT4.1"
    },
    "85821": {
      "id": 2653056,
      "text": "Tại California, dự đoán du lịch quốc tế sẽ giảm 9% trong năm nay,",
      "author": "ChatGPT4.1"
    },
    "85822": {
      "id": 2653057,
      "text": "do các mức thuế cao hơn do chính quyền Trump áp đặt và cảm xúc tiêu cực đối với Mỹ.",
      "author": "ChatGPT4.1"
    },
    "85823": {
      "id": 2653058,
      "text": "Biên tập viên du lịch của CBS, Peter Greenberg.",
      "author": "ChatGPT4.1"
    },
    "85824": {
      "id": 2653059,
      "text": "Số lượng người châu Âu đi đến Mỹ giảm đáng kể và tùy theo mỗi quốc gia…",
      "author": "ChatGPT4.1"
    },
    "85825": {
      "id": 2653060,
      "text": "con số này đã giảm tới 42% so với năm ngoái.",
      "author": "ChatGPT4.1"
    },
    "85826": {
      "id": 2653061,
      "text": "Chỉ riêng khách châu Âu không đến Mỹ thôi.",
      "author": "ChatGPT4.1"
    },
    "85827": {
      "id": 2653062,
      "text": "Ông ấy nói rằng con số còn tệ hơn nữa đối với những người hàng xóm phía bắc của chúng ta.",
      "author": "ChatGPT4.1"
    },
    "85828": {
      "id": 2653063,
      "text": "Người Canada đi đến Mỹ giảm tới 75%.",
      "author": "ChatGPT4.1"
    },
    "85829": {
      "id": 2653064,
      "text": "Bạn đến từ Montreal đúng không?",
      "author": "ChatGPT4.1"
    },
    "85830": {
      "id": 2653065,
      "text": "Chuyến bay có đông không?",
      "author": "ChatGPT4.1"
    },
    "85831": {
      "id": 2653066,
      "text": "Không, chỉ khoảng 70% thôi.",
      "author": "ChatGPT4.1"
    },
    "85832": {
      "id": 2653067,
      "text": "Bạn có nhận thấy rằng người Canada xung quanh bạn ít quan tâm tới việc đến đây không?",
      "author": "ChatGPT4.1"
    },
    "85833": {
      "id": 2653068,
      "text": "Vâng, rất nhiều người trong số họ.",
      "author": "ChatGPT4.1"
    },
    "85834": {
      "id": 2653069,
      "text": "Ở New York, du lịch cũng chịu ảnh hưởng nặng nề.",
      "author": "ChatGPT4.1"
    },
    "85835": {
      "id": 2653070,
      "text": "Một lần nữa, do cảm xúc tiêu cực đối với Hoa Kỳ.",
      "author": "ChatGPT4.1"
    },
    "85836": {
      "id": 2653071,
      "text": "Năm nay, dự kiến sẽ có ít hơn 400.000 du khách đến thăm Big Apple.",
      "author": "ChatGPT4.1"
    },
    "85837": {
      "id": 2653072,
      "text": "Nhưng những du khách đến từ Pháp này nói rằng họ rất vui khi ở đây.",
      "author": "ChatGPT4.1"
    },
    "85838": {
      "id": 2653073,
      "text": "Và các bạn đang vui chứ?",
      "author": "ChatGPT4.1"
    },
    "85839": {
      "id": 2653074,
      "text": "Vâng. Tôi yêu nước Mỹ.",
      "author": "ChatGPT4.1"
    }
  }
}
