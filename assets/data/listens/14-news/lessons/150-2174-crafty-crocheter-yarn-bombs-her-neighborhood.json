  "translations": {
    "85966": {
      "id": 2232593,
      "text": "London Kaye khiến khu phố Los Angeles của cô ấy đầy \"các mũi khâu\".",
      "author": "a user"
    },
    "85967": {
      "id": 2232594,
      "text": "Đó là vì cô ấy là một người thả bom len - treo lên những tác phẩm đan móc của cô ấy ở nơi công cộng.",
      "author": "a user"
    },
    "85970": {
      "id": 2232597,
      "text": "vì vậy bạn muốn làm nó lớn và ấn tượng, nhưng đồng thời không mất quá nhiều thời gian vào một mẫu nhất định.",
      "author": "a user"
    },
    "85974": {
      "id": 2232601,
      "text": "Đó là lý do tại sao tôi yêu thích việc đánh bom len.",
      "author": "a user"
    },
    "85975": {
      "id": 2232602,
      "text": "Số lượng người có cơ hội xem tác phẩm của bạn khi bạn đem nó ra bên ngoài trong cộng đồng của mình nhiều hơn rất nhiều so với nếu bạn giữ nó ở nhà, nhét dưới giường.",
      "author": "a user"
    },
    "85978": {
      "id": 2232740,
      "text": "Có gì sai với \"crocheting\"? (phát âm sai)",
      "author": "a user"
    },
    "85968": {
      "id": 2607904,
      "text": "Bạn đang đặt những thứ ở bên ngoài. Bạn để chúng ở đó để mọi người thưởng thức.",
      "author": "ChatGPT4.1"
    },
    "85969": {
      "id": 2607905,
      "text": "Bạn không biết nó sẽ tồn tại bao lâu,",
      "author": "ChatGPT4.1"
    },
    "85971": {
      "id": 2607906,
      "text": "London nói với KCBS rằng cô ấy luôn xin phép trước để treo các tác phẩm của mình nhằm tránh bị gỡ xuống quá sớm,",
      "author": "ChatGPT4.1"
    },
    "85972": {
      "id": 2607907,
      "text": "nhưng cô ấy không bao giờ biết mình sẽ nhận được phản ứng như thế nào.",
      "author": "ChatGPT4.1"
    },
    "85973": {
      "id": 2607908,
      "text": "\"Thật tuyệt vời.\" - \"Cảm ơn bạn.\"",
      "author": "ChatGPT4.1"
    },
    "85976": {
      "id": 2607909,
      "text": "Cô ấy hy vọng rằng một thế hệ nghệ nhân móc len mới sẽ giữ cho nghề thủ công này tiếp tục phát triển.",
      "author": "ChatGPT4.1"
    },
    "85977": {
      "id": 2607910,
      "text": "Thiếu niên này cho thấy một chút hy vọng, dù vẫn còn đang học cách phát âm \"crochet\".",
      "author": "ChatGPT4.1"
    }
  }
}
