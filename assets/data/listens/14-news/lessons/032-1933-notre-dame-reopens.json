  "translations": {
    "74757": {
      "id": 2583720,
      "text": "Lần đầu tiên sau hơn năm năm,",
      "author": "ChatGPT4.1"
    },
    "74758": {
      "id": 2583721,
      "text": "chuông lại vang lên tại Nhà thờ Đức Bà.",
      "author": "ChatGPT4.1"
    },
    "74759": {
      "id": 2583722,
      "text": "Nhà thờ đã chính thức mở cửa trở lại.",
      "author": "ChatGPT4.1"
    },
    "74760": {
      "id": 2583723,
      "text": "Lễ nghi long trọng chào mừng tượng đài được phục hồi.",
      "author": "ChatGPT4.1"
    },
    "74761": {
      "id": 2583724,
      "text": "Một bối cảnh ấn tượng cho sự trở lại của Donald Trump trên vũ đài thế giới với tư cách tổng thống đắc cử.",
      "author": "ChatGPT4.1"
    },
    "74762": {
      "id": 2583725,
      "text": "Một cú gõ cửa mang tính biểu tượng của Tổng Giám mục Paris.",
      "author": "ChatGPT4.1"
    },
    "74763": {
      "id": 2583726,
      "text": "Nhà thờ tỉnh giấc,",
      "author": "ChatGPT4.1"
    },
    "74764": {
      "id": 2583727,
      "text": "và vang lên bản thánh ca ngợi khen,",
      "author": "ChatGPT4.1"
    },
    "74765": {
      "id": 2583728,
      "text": "sau đó là những tràng pháo tay dành cho lính cứu hỏa đã liều mình cứu những gì còn có thể.",
      "author": "ChatGPT4.1"
    },
    "74766": {
      "id": 2583729,
      "text": "Một vụ hỏa hoạn tàn khốc đã làm hư hại công trình biểu tượng của Paris vào tháng 4 năm 2019.",
      "author": "ChatGPT4.1"
    },
    "74767": {
      "id": 2583730,
      "text": "Khán giả toàn cầu đã chứng kiến trong kinh hoàng khi ngọn tháp nổi tiếng đổ xuống.",
      "author": "ChatGPT4.1"
    },
    "74768": {
      "id": 2583731,
      "text": "Sự kiện tái mở cửa mang tính lịch sử này đã quy tụ khoảng 50 nguyên thủ quốc gia,",
      "author": "ChatGPT4.1"
    },
    "74769": {
      "id": 2583732,
      "text": "bao gồm Trump, người đã gặp Tổng thống Macron tại Điện Elysee trước khi buổi lễ bắt đầu.",
      "author": "ChatGPT4.1"
    },
    "74770": {
      "id": 2583733,
      "text": "Tổng thống Ukraine, Volodymyr Zelenskyy, cũng có mặt tại Paris cho sự kiện này,",
      "author": "ChatGPT4.1"
    },
    "74771": {
      "id": 2583734,
      "text": "và nhân dịp này tiếp tục kêu gọi sự ủng hộ của Hoa Kỳ trong cuộc chiến của đất nước ông với Nga.",
      "author": "ChatGPT4.1"
    },
    "74772": {
      "id": 2583735,
      "text": "Trump và Macron ngồi cùng nhau khi Tổng thống Pháp nhấn mạnh ý nghĩa biểu tượng trong việc tái thiết công trình này.",
      "author": "ChatGPT4.1"
    },
    "74773": {
      "id": 2583736,
      "text": "\"Chúng ta đã tái khám phá những gì các quốc gia vĩ đại có thể làm được.\"",
      "author": "ChatGPT4.1"
    },
    "74774": {
      "id": 2583737,
      "text": "\"Chúng ta có thể làm được những điều tưởng như không thể.\"",
      "author": "ChatGPT4.1"
    },
    "74775": {
      "id": 2583738,
      "text": "\"Và nhà thờ này là một phép ẩn dụ tươi đẹp về những gì một quốc gia và thế giới có thể trở thành.\"",
      "author": "ChatGPT4.1"
    },
    "74776": {
      "id": 2583739,
      "text": "Tiếp theo, đàn organ đã được hồi sinh.",
      "author": "ChatGPT4.1"
    },
    "74777": {
      "id": 2583740,
      "text": "8.000 ống của nó đã mất sáu tháng để làm sạch, chỉnh âm và lắp ráp lại.",
      "author": "ChatGPT4.1"
    },
    "74778": {
      "id": 2583741,
      "text": "Nhà thờ Đức Bà giờ đây được khôi phục vượt xa vẻ huy hoàng trước kia,",
      "author": "ChatGPT4.1"
    },
    "74779": {
      "id": 2583742,
      "text": "và sẵn sàng cho thánh lễ đầu tiên vào Chủ Nhật.",
      "author": "ChatGPT4.1"
    }
  }
