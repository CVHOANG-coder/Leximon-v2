  "translations": {
    "82789": {
      "id": 2379135,
      "text": "Chúng ta bắt đầu hôm nay với hiện tượng nguyệt thực toàn phần đã quan sát được khắp Tây Bán Cầu đêm qua và sáng sớm nay.",
      "author": "DeepSeekAI"
    },
    "82790": {
      "id": 2379136,
      "text": "Nguyệt thực xảy ra khi Trái Đất đi qua giữa Mặt Trời và Mặt Trăng, đổ bóng lên Mặt Trăng.",
      "author": "DeepSeekAI"
    },
    "82791": {
      "id": 2379137,
      "text": "Nguyệt thực toàn phần là khi toàn bộ Mặt Trăng lọt vào vùng tối nhất của một trong những bóng của Trái Đất.",
      "author": "DeepSeekAI"
    },
    "82792": {
      "id": 2379138,
      "text": "Đúng vậy! Một trong những bóng của Trái Đất.",
      "author": "DeepSeekAI"
    },
    "82793": {
      "id": 2379139,
      "text": "Bạn có biết Trái Đất có hai bóng không?",
      "author": "DeepSeekAI"
    },
    "82794": {
      "id": 2379140,
      "text": "Theo NASA, vùng bóng tối bên trong gọi là umbra (vùng tối hoàn toàn),",
      "author": "DeepSeekAI"
    },
    "82795": {
      "id": 2379141,
      "text": "còn vùng bóng nhạt bên ngoài gọi là penumbra (vùng nửa tối). Vậy nên...",
      "author": "DeepSeekAI"
    },
    "82796": {
      "id": 2379142,
      "text": "Độ nghiêng của Mặt Trăng quanh Trái Đất cùng hai vùng bóng khác nhau này mà Mặt Trăng có thể đi qua",
      "author": "DeepSeekAI"
    },
    "82797": {
      "id": 2379143,
      "text": "tạo ra ba loại nguyệt thực khác nhau.",
      "author": "DeepSeekAI"
    },
    "82798": {
      "id": 2379144,
      "text": "Một loại gọi là nguyệt thực penumbra,",
      "author": "DeepSeekAI"
    },
    "82799": {
      "id": 2379145,
      "text": "khi Mặt Trăng đi qua vùng bóng ngoài nhạt hơn.",
      "author": "DeepSeekAI"
    },
    "82800": {
      "id": 2379146,
      "text": "NASA cho biết loại nguyệt thực này rất khó nhận biết, nếu không để ý, bạn có thể không hay biết nó đang xảy ra.",
      "author": "DeepSeekAI"
    },
    "82801": {
      "id": 2379147,
      "text": "Một loại khác là nguyệt thực một phần, xảy ra ít nhất hai lần mỗi năm.",
      "author": "DeepSeekAI"
    },
    "82802": {
      "id": 2379148,
      "text": "Đó là khi Mặt Trăng chỉ bị che phủ một phần bởi umbra của Trái Đất.",
      "author": "DeepSeekAI"
    },
    "82803": {
      "id": 2379149,
      "text": "Chỉ một phần của nó chìm trong bóng tối từ Trái Đất.",
      "author": "DeepSeekAI"
    },
    "82804": {
      "id": 2379150,
      "text": "Cuối cùng, loại lớn nhất và hiếm gặp nhất: nguyệt thực toàn phần.",
      "author": "DeepSeekAI"
    },
    "82805": {
      "id": 2379151,
      "text": "Những lần nguyệt thực này thường cách nhau nhiều năm",
      "author": "DeepSeekAI"
    },
    "82806": {
      "id": 2379152,
      "text": "vì chúng đòi hỏi sự thẳng hàng chính xác của Mặt Trăng, Trái Đất và Mặt Trời.",
      "author": "DeepSeekAI"
    },
    "82807": {
      "id": 2379153,
      "text": "Dù ta có thể nghĩ rằng nguyệt thực toàn phần sẽ khiến Mặt Trăng tối đen hoàn toàn,",
      "author": "DeepSeekAI"
    },
    "82808": {
      "id": 2379154,
      "text": "thực tế Mặt Trăng chuyển sang màu đỏ sẫm khi tiến sâu vào umbra.",
      "author": "DeepSeekAI"
    },
    "82809": {
      "id": 2379155,
      "text": "Đây là lý do nó đôi khi được gọi là Trăng Máu.",
      "author": "DeepSeekAI"
    },
    "82810": {
      "id": 2379156,
      "text": "Mặt Trăng đỏ lên vì bầu khí quyển lọc bỏ màu ở đầu đối diện của quang phổ nhìn thấy - ánh sáng xanh.",
      "author": "DeepSeekAI"
    },
    "82811": {
      "id": 2379157,
      "text": "Bước sóng ngắn của ánh sáng xanh không truyền xa như bước sóng dài của ánh sáng đỏ, nên...",
      "author": "DeepSeekAI"
    },
    "82812": {
      "id": 2379158,
      "text": "chúng bị tán xạ trước khi đến mắt ta, để lại ánh đỏ này.",
      "author": "DeepSeekAI"
    },
    "82813": {
      "id": 2379379,
      "text": "Không phải ai trên Trái Đất cũng có thể nhìn thấy nguyệt thực cùng một lúc.",
      "author": "DeepSeekAI"
    },
    "82814": {
      "id": 2379380,
      "text": "Bạn cần ở khu vực hướng về Mặt Trăng trong khoảng thời gian nó bị che khuất bởi Trái Đất.",
      "author": "DeepSeekAI"
    },
    "82815": {
      "id": 2379381,
      "text": "Nhưng khác với nhật thực,",
      "author": "DeepSeekAI"
    },
    "82816": {
      "id": 2379382,
      "text": "bạn không cần thiết bị đặc biệt nào để quan sát nguyệt thực.",
      "author": "DeepSeekAI"
    },
    "82817": {
      "id": 2379383,
      "text": "Chúng an toàn để xem ở mọi giai đoạn, dù một cặp ống nhòm có thể khiến trải nghiệm thú vị hơn.",
      "author": "DeepSeekAI"
    }
  }
}
