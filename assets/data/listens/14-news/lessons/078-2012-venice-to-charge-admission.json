  "translations": {
    "78333": {
      "id": 2616929,
      "text": "Và bây giờ, hãy nói về Venice, còn được gọi là thành phố nổi.",
      "author": "ChatGPT4.1"
    },
    "78334": {
      "id": 2616930,
      "text": "Nơi đây có lịch sử phong phú, nghệ thuật, kiến trúc và sức quyến rũ đặc biệt",
      "author": "ChatGPT4.1"
    },
    "78335": {
      "id": 2616931,
      "text": "mà có thể mang lại sự phấn khích cho nhiều du khách ghé thăm.",
      "author": "ChatGPT4.1"
    },
    "78336": {
      "id": 2616932,
      "text": "Nếu bạn biết ai đó đang nghĩ đến việc đi tham quan thành phố nổi trong ngày, hãy nghe điều này.",
      "author": "ChatGPT4.1"
    },
    "78337": {
      "id": 2616933,
      "text": "Bắt đầu từ mùa xuân năm 2024, nếu bạn không ngủ lại qua đêm,",
      "author": "ChatGPT4.1"
    },
    "78338": {
      "id": 2616934,
      "text": "bạn sẽ phải trả 5 euro, khoảng 5 đô la 40 cent",
      "author": "ChatGPT4.1"
    },
    "78339": {
      "id": 2616935,
      "text": "để vào thành phố vào những ngày cực kỳ đông đúc.",
      "author": "ChatGPT4.1"
    },
    "78340": {
      "id": 2616936,
      "text": "Thành phố này đang làm nên lịch sử khi là nơi đầu tiên trên thế giới thu phí vào cửa đối với du khách.",
      "author": "ChatGPT4.1"
    },
    "78341": {
      "id": 2616937,
      "text": "Điều này không phải là vĩnh viễn. Nó giống như một giai đoạn thử nghiệm 30 ngày.",
      "author": "ChatGPT4.1"
    },
    "78342": {
      "id": 2616938,
      "text": "Thay vì thực hiện tất cả trong một tháng,",
      "author": "ChatGPT4.1"
    },
    "78343": {
      "id": 2616939,
      "text": "họ sẽ chọn những ngày dự kiến có rất nhiều du khách, như các ngày lễ trong mùa lễ hội Carnival cao điểm.",
      "author": "ChatGPT4.1"
    },
    "78344": {
      "id": 2616940,
      "text": "Mục tiêu: hạn chế khách du lịch đi về trong ngày vào những thời điểm đông đúc đó.",
      "author": "ChatGPT4.1"
    },
    "78345": {
      "id": 2616941,
      "text": "Vậy nên đây là vấn đề.",
      "author": "ChatGPT4.1"
    },
    "78346": {
      "id": 2616942,
      "text": "Venice có thể trở nên vô cùng đông đúc.",
      "author": "ChatGPT4.1"
    },
    "78347": {
      "id": 2616943,
      "text": "Vào một số ngày, số du khách còn nhiều hơn cả số dân cư thực tế.",
      "author": "ChatGPT4.1"
    },
    "78348": {
      "id": 2616944,
      "text": "Họ vẫn đang xác định các ngày chính thức sẽ áp dụng việc thu phí này.",
      "author": "ChatGPT4.1"
    },
    "78349": {
      "id": 2616945,
      "text": "Nhưng đây là thông tin chi tiết.",
      "author": "ChatGPT4.1"
    },
    "78350": {
      "id": 2616946,
      "text": "Những người sống ở đó, đi làm, sở hữu nhà thứ hai hoặc ở lại qua đêm,",
      "author": "ChatGPT4.1"
    },
    "78351": {
      "id": 2616947,
      "text": "sẽ được miễn phí.",
      "author": "ChatGPT4.1"
    },
    "78352": {
      "id": 2616948,
      "text": "Bạn chỉ cần đăng ký trực tuyến cho chuyến thăm của mình.",
      "author": "ChatGPT4.1"
    },
    "78353": {
      "id": 2616949,
      "text": "Số tiền họ thu được từ phí vào cửa này",
      "author": "ChatGPT4.1"
    },
    "78354": {
      "id": 2616950,
      "text": "một phần sẽ giúp trang trải chi phí của hệ thống đặt chỗ này.",
      "author": "ChatGPT4.1"
    },
    "78355": {
      "id": 2616951,
      "text": "Và bạn biết không?",
      "author": "ChatGPT4.1"
    },
    "78356": {
      "id": 2616952,
      "text": "Các thành phố châu Âu khác đang gặp vấn đề với lượng lớn khách du lịch trong ngày đang theo dõi sát sao thử nghiệm này ở Venice.",
      "author": "ChatGPT4.1"
    },
    "78357": {
      "id": 2616953,
      "text": "Họ đang tự hỏi liệu mình cũng có thể áp dụng một giải pháp tương tự",
      "author": "ChatGPT4.1"
    },
    "78358": {
      "id": 2616954,
      "text": "để giải quyết vấn đề du lịch quá tải này.",
      "author": "ChatGPT4.1"
    }
  }
}
