  "translations": {
    "79867": {
      "id": 3041324,
      "text": "Các nhà sinh vật biển cho biết họ đã phát hiện một con cá cần câu quỷ biển đen còn sống gần bề mặt đại dương",
      "author": "ChatGPT4.1"
    },
    "79868": {
      "id": 3041325,
      "text": "trong khi đang thực hiện một chiến dịch nghiên cứu cá mập.",
      "author": "ChatGPT4.1"
    },
    "79869": {
      "id": 3041326,
      "text": "Tổ chức phi chính phủ Condrik Tenerife đang trong một chuyến thám hiểm ngoài khơi đảo của Tây Ban Nha.",
      "author": "ChatGPT4.1"
    },
    "79870": {
      "id": 3041327,
      "text": "Các nhà nghiên cứu đã rất ngạc nhiên vì loài cá biển sâu này, nổi tiếng với ngoại hình đáng sợ,",
      "author": "ChatGPT4.1"
    },
    "79871": {
      "id": 3041328,
      "text": "thường sống ở độ sâu từ 200 đến 2000 mét.",
      "author": "ChatGPT4.1"
    },
    "79872": {
      "id": 3041329,
      "text": "Một loài săn mồi ở vùng nước sâu của đại dương, nó sử dụng một chiếc cột phát sáng sinh học trên đầu để thu hút con mồi.",
      "author": "ChatGPT4.1"
    },
    "79873": {
      "id": 3041330,
      "text": "Theo tổ chức này, trước đây chỉ có các mẫu vật chết, ấu trùng hoặc hình ảnh được chụp bởi tàu ngầm là đã được ghi nhận về loài cá cần câu này.",
      "author": "ChatGPT4.1"
    }
  }
