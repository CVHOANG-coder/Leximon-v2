  "translations": {
    "82603": {
      "id": 2677372,
      "text": "Một vụ cháy trên biển.",
      "author": "ChatGPT4.1"
    },
    "82604": {
      "id": 2677373,
      "text": "Một vụ va chạm giữa một tàu chở hóa chất và một tàu chở container của Bồ Đào Nha ngoài khơi bờ biển Anh ở Biển Bắc đã gây ra vụ việc.",
      "author": "ChatGPT4.1"
    },
    "82605": {
      "id": 2677374,
      "text": "Tàu chở hóa chất đang chở nhiên liệu máy bay cho quân đội Mỹ.",
      "author": "ChatGPT4.1"
    },
    "82606": {
      "id": 2677375,
      "text": "Đây là cảnh trước khi vụ va chạm xảy ra.",
      "author": "ChatGPT4.1"
    },
    "82607": {
      "id": 2677376,
      "text": "Theo cơ quan chức năng, tàu chở hóa chất đang neo đậu thì bị tàu chở container đâm phải,",
      "author": "ChatGPT4.1"
    },
    "82608": {
      "id": 2677377,
      "text": "gây ra vụ cháy nổ.",
      "author": "ChatGPT4.1"
    },
    "82609": {
      "id": 2677378,
      "text": "Hiện chưa rõ có bao nhiêu nhiên liệu đã tràn xuống biển.",
      "author": "ChatGPT4.1"
    },
    "82610": {
      "id": 2677379,
      "text": "36 người đã được đưa trở lại bờ.",
      "author": "ChatGPT4.1"
    },
    "82611": {
      "id": 2677380,
      "text": "Một thành viên thủy thủ đoàn được cho là đã tử vong.",
      "author": "ChatGPT4.1"
    },
    "82612": {
      "id": 2677381,
      "text": "Tất cả những người còn lại đã được xác định an toàn.",
      "author": "ChatGPT4.1"
    },
    "82613": {
      "id": 2677382,
      "text": "Nhiều khả năng tàu chở container sẽ không thể nổi lâu và có thể bị chìm.",
      "author": "ChatGPT4.1"
    },
    "82614": {
      "id": 2677383,
      "text": "Một cuộc điều tra hình sự đang được tiến hành, vì một người đã bị bắt giữ liên quan đến vụ va chạm,",
      "author": "ChatGPT4.1"
    },
    "82615": {
      "id": 2677384,
      "text": "theo hãng tin Associated Press.",
      "author": "ChatGPT4.1"
    },
    "82616": {
      "id": 2677385,
      "text": "Tên của người này chưa được tiết lộ, và chưa có cáo buộc chính thức nào được đưa ra.",
      "author": "ChatGPT4.1"
    }
  }
