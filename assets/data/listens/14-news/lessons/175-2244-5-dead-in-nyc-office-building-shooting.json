  "translations": {
    "89179": {
      "id": 3509150,
      "text": "Năm người đã thiệt mạng sau khi một tay súng xông vào một tòa nhà văn phòng ở thành phố New York,",
      "author": "ChatGPT4.1"
    },
    "89180": {
      "id": 3509151,
      "text": "bắn chết bốn người, bao gồm một sĩ quan cảnh sát,",
      "author": "ChatGPT4.1"
    },
    "89181": {
      "id": 3509152,
      "text": "trước khi tự sát bằng chính khẩu súng đó.",
      "author": "ChatGPT4.1"
    },
    "89182": {
      "id": 3509153,
      "text": "Nhiều người khác bị thương trong vụ xả súng hàng loạt, bắt đầu sau 6 giờ tối thứ Hai.",
      "author": "ChatGPT4.1"
    },
    "89183": {
      "id": 3509154,
      "text": "Tòa nhà văn phòng 345 Park Avenue là nơi đặt trụ sở của NFL cùng nhiều doanh nghiệp khác.",
      "author": "ChatGPT4.1"
    },
    "89184": {
      "id": 3509155,
      "text": "Ủy viên Cảnh sát thành phố New York, Jessica Tisch, nói với các phóng viên,",
      "author": "ChatGPT4.1"
    },
    "89185": {
      "id": 3509156,
      "text": "\"Đối tượng được cho là Shane Tamura, nam, 27 tuổi, có địa chỉ tại Las Vegas.\"",
      "author": "ChatGPT4.1"
    },
    "89186": {
      "id": 3509157,
      "text": "\"Chiếc xe mà đối tượng sử dụng được đăng ký tại Nevada dưới tên ông Tamura.\"",
      "author": "ChatGPT4.1"
    },
    "89187": {
      "id": 3509158,
      "text": "\"Bên trong xe, cảnh sát tìm thấy một hộp đựng súng trường cùng đạn dược, một khẩu súng lục nạp đạn sẵn, đạn và nhiều băng đạn,\"",
      "author": "ChatGPT4.1"
    },
    "89188": {
      "id": 3509159,
      "text": "\"một chiếc ba lô và thuốc do bác sĩ kê đơn cho ông Tamura.\"",
      "author": "ChatGPT4.1"
    },
    "89189": {
      "id": 3509160,
      "text": "\"Xe đã được đội rà phá bom mìn kiểm tra và không phát hiện chất nổ.\"",
      "author": "ChatGPT4.1"
    },
    "89190": {
      "id": 3509161,
      "text": "Sở cảnh sát New York cho biết sĩ quan tử vong trong vụ xả súng là Didarul Islam, 36 tuổi.",
      "author": "ChatGPT4.1"
    },
    "89191": {
      "id": 3509162,
      "text": "Hiện các nhà chức trách đang tập hợp các dữ kiện về những ngày cuối cùng của Tamura và điều tra động cơ vụ việc.",
      "author": "ChatGPT4.1"
    },
    "89192": {
      "id": 3509163,
      "text": "Đây là một câu chuyện đang tiếp tục được cập nhật....",
      "author": "ChatGPT4.1"
    }
  }
}
