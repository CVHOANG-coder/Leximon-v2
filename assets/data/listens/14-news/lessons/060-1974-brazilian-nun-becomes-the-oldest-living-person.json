  "translations": {
    "76074": {
      "id": 2626796,
      "text": "Bà ấy đã chứng kiến mọi thứ.",
      "author": "ChatGPT4.1"
    },
    "76075": {
      "id": 2626797,
      "text": "Thực ra, nhiều hơn hầu hết chúng ta từng thấy.",
      "author": "ChatGPT4.1"
    },
    "76076": {
      "id": 2626798,
      "text": "Đó là vì nữ tu này từ Brazil vừa được công nhận là người sống thọ nhất thế giới.",
      "author": "ChatGPT4.1"
    },
    "76077": {
      "id": 2626799,
      "text": "Inah Canabarro Lucas đã đạt đến tuổi 116.",
      "author": "ChatGPT4.1"
    },
    "76078": {
      "id": 2626800,
      "text": "Bà được sinh ra vào ngày 8 tháng 6 năm 1908,",
      "author": "ChatGPT4.1"
    },
    "76079": {
      "id": 2626801,
      "text": "và hiện tại sống tại một viện dưỡng lão ở Porto Alegre.",
      "author": "ChatGPT4.1"
    },
    "76080": {
      "id": 2626802,
      "text": "Bà bắt đầu con đường tu hành năm 16 tuổi và đã dành phần lớn cuộc đời làm giáo viên.",
      "author": "ChatGPT4.1"
    },
    "76081": {
      "id": 2626803,
      "text": "Khi được hỏi về tuổi thọ của mình, bà dành tất cả công lao cho Chúa và đức tin của mình.",
      "author": "ChatGPT4.1"
    },
    "76082": {
      "id": 2626804,
      "text": "Được biết, bà chỉ bắt đầu gặp vấn đề đi lại khi đến tuổi 110.",
      "author": "ChatGPT4.1"
    },
    "76083": {
      "id": 2626805,
      "text": "Và hiện nay, bà ấy dùng xe lăn.",
      "author": "ChatGPT4.1"
    },
    "76084": {
      "id": 2626806,
      "text": "nhưng bà vẫn có thể cổ vũ cho đội bóng yêu thích của mình, Sport Club Internacional.",
      "author": "ChatGPT4.1"
    },
    "76085": {
      "id": 2626807,
      "text": "Tất cả những điều này là theo LongeviQuest,",
      "author": "ChatGPT4.1"
    },
    "76086": {
      "id": 2626808,
      "text": "tổ chức theo dõi những người thọ trên 105 tuổi trên khắp thế giới.",
      "author": "ChatGPT4.1"
    },
    "76087": {
      "id": 2626809,
      "text": "Tổ chức cho biết Sơ Canabarro đã trở thành người sống thọ nhất thế giới",
      "author": "ChatGPT4.1"
    },
    "76088": {
      "id": 2626810,
      "text": "khi người giữ kỷ lục trước đó, một phụ nữ đến từ Nhật Bản, qua đời vào tháng trước.",
      "author": "ChatGPT4.1"
    }
  }
}
