  "translations": {
    "75422": {
      "id": 2585022,
      "text": "Volkswagen đã đạt được thỏa thuận với các công đoàn sẽ mang lại những thay đổi lớn cho hoạt động tại Đức,",
      "author": "ChatGPT4.1"
    },
    "75423": {
      "id": 2585023,
      "text": "bao gồm việc cắt giảm mạnh công suất và hơn 35.000 vị trí việc làm trong tương lai sẽ bị cắt giảm.",
      "author": "ChatGPT4.1"
    },
    "75424": {
      "id": 2585024,
      "text": "Các lãnh đạo công đoàn ca ngợi thỏa thuận này là một \"kỳ tích Giáng sinh\"",
      "author": "ChatGPT4.1"
    },
    "75425": {
      "id": 2585025,
      "text": "sau 70 giờ đàm phán căng thẳng, dài nhất trong lịch sử 87 năm của VW.",
      "author": "ChatGPT4.1"
    },
    "75426": {
      "id": 2585026,
      "text": "Đây là ông Thorsten Groeger, nhà đàm phán của công đoàn IG Metall,",
      "author": "ChatGPT4.1"
    },
    "75427": {
      "id": 2585027,
      "text": "\"Chúng tôi vui mừng vì đã xây dựng được một gói thỏa thuận trong đó các lằn ranh đỏ đã được tuân thủ.\"",
      "author": "ChatGPT4.1"
    },
    "75428": {
      "id": 2585028,
      "text": "\"Sẽ không có việc đóng cửa nhà máy hoặc sa thải nhân viên ngay lập tức tại Volkswagen.\"",
      "author": "ChatGPT4.1"
    },
    "75429": {
      "id": 2585029,
      "text": "Và công ty dường như cũng đã rút lại yêu cầu cắt giảm 10% lương.",
      "author": "ChatGPT4.1"
    },
    "75430": {
      "id": 2585030,
      "text": "Nhà sản xuất ô tô lớn nhất châu Âu đã đàm phán về lương và việc làm từ tháng Chín.",
      "author": "ChatGPT4.1"
    },
    "75431": {
      "id": 2585031,
      "text": "Họ cho biết các biện pháp cắt giảm chi phí là cần thiết để cạnh tranh với các đối thủ Trung Quốc,",
      "author": "ChatGPT4.1"
    },
