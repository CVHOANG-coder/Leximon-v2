  "translations": {
    "89321": {
      "id": 3554758,
      "text": "Chào mừng đến với Asheville, Bắc Carolina.",
      "author": "ChatGPT4.1"
    },
    "89322": {
      "id": 3554759,
      "text": "Nhiều tháng sau sự tàn phá của Bão Helen, thị trấn miền núi này đang phục hồi trở lại.",
      "author": "ChatGPT4.1"
    },
    "89323": {
      "id": 3554760,
      "text": "Có điều gì đó dành cho tất cả mọi người.",
      "author": "ChatGPT4.1"
    },
    "89324": {
      "id": 3554761,
      "text": "Và tôi cảm thấy cách tốt nhất để khám phá nơi này là trên hai bánh xe.",
      "author": "ChatGPT4.1"
    },
    "89325": {
      "id": 3554762,
      "text": "Bất động sản Biltmore rộng 8000 mẫu Anh là ngôi nhà thuộc sở hữu tư nhân lớn nhất cả nước.",
      "author": "a user"
    },
    "89326": {
      "id": 3554763,
      "text": "Được George Vanderbilt sáng lập, nó đã giúp đưa Asheville lên bản đồ.",
      "author": "ChatGPT4.1"
    },
    "89327": {
      "id": 3554764,
      "text": "Bạn về cơ bản đang du hành thời gian.",
      "author": "ChatGPT4.1"
    },
    "89328": {
      "id": 3554765,
      "text": "Bạn đang quay trở lại những năm 1890 của thời kỳ vàng son.",
      "author": "ChatGPT4.1"
    },
    "89329": {
      "id": 3554766,
      "text": "Nơi đây có 75 lò sưởi và 250 phòng.",
      "author": "ChatGPT4.1"
    },
    "89330": {
      "id": 3554767,
      "text": "Bạn có thể tham quan ngôi nhà sang trọng và thậm chí nghỉ qua đêm tại đây.",
      "author": "ChatGPT4.1"
    },
    "89331": {
      "id": 3554768,
      "text": "Bên ngoài bạn có thể đạp xe, đi bộ đường dài, và khám phá nghệ thuật săn chim cổ xưa.",
      "author": "ChatGPT4.1"
    },
    "89332": {
      "id": 3554769,
      "text": "Săn chim là gì?",
      "author": "ChatGPT4.1"
    },
    "89333": {
      "id": 3554770,
      "text": "Săn chim thực ra là săn bắt bằng các loài chim săn mồi.",
      "author": "ChatGPT4.1"
    },
    "89334": {
      "id": 3554771,
      "text": "Chúng tôi không dùng súng trường, súng săn hay cung tên.",
      "author": "ChatGPT4.1"
    },
    "89335": {
      "id": 3554772,
      "text": "Chim làm công việc giết mồi.",
      "author": "ChatGPT4.1"
    },
    "89336": {
      "id": 3554773,
      "text": "Chúng ta hiếm khi ở gần chim săn mồi đến vậy.",
      "author": "ChatGPT4.1"
    },
    "89337": {
      "id": 3554774,
      "text": "Có người chăm sóc, họ nhìn những chú chim này theo cách khác biệt.",
      "author": "ChatGPT4.1"
    },
    "89338": {
      "id": 3554775,
      "text": "Trên đường vào thị trấn, chúng tôi đã đi đường vòng ngắm cảnh trên tuyến đường Blue Ridge Parkway.",
      "author": "ChatGPT4.1"
    },
    "89339": {
      "id": 3554776,
      "text": "Nó đã dần dần mở cửa trở lại sau cơn bão Helen.",
      "author": "ChatGPT4.1"
    },
    "89340": {
      "id": 3554777,
      "text": "Nhưng trước đó, đây là khu công viên quốc gia được ghé thăm nhiều nhất ở quốc gia này.",
      "author": "ChatGPT4.1"
    },
    "89341": {
      "id": 3554778,
      "text": "Nó kéo dài 469 dặm đường dành cho xe cơ giới không bị gián đoạn.",
      "author": "ChatGPT4.1"
    },
    "89342": {
      "id": 3554779,
      "text": "Công viên này được các kiến trúc sư cảnh quan thiết kế với suy nghĩ khi tôi rẽ qua góc cua này, đâu sẽ là khung cảnh tuyệt đẹp để ngắm nhìn?",
      "author": "ChatGPT4.1"
    },
    "89343": {
      "id": 3554780,
      "text": "Vì vậy đã có rất nhiều suy nghĩ được đầu tư để tạo nên trải nghiệm trọn vẹn trên tuyến đường Blue Ridge Parkway.",
      "author": "ChatGPT4.1"
    },
    "89344": {
      "id": 3554781,
      "text": "Sau một ngày ở Asheville, chúng tôi mới chỉ khám phá được một phần nhỏ.",
      "author": "ChatGPT4.1"
    },
    "89345": {
      "id": 3554782,
      "text": "Nhưng nếu bạn có dịp đặt chân đến đây, lựa chọn tốt nhất là hãy cứ mạnh dạn trải nghiệm.",
      "author": "ChatGPT4.1"
    }
  }
}
