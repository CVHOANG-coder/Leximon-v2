  "translations": {
    "75447": {
      "id": 2658214,
      "text": "Chỉ trong 2 ngày, 10 cuộc đời đã thay đổi hoàn toàn nhờ món quà hiến tạng từ người hiến còn sống.",
      "author": "ChatGPT4.1"
    },
    "75448": {
      "id": 2658215,
      "text": "Các bác sĩ phẫu thuật tại Đại học Bang Ohio đã lập kỷ lục mới bằng cách thực hiện một chuỗi đồng bộ gồm 20 ca phẫu thuật,",
      "author": "ChatGPT4.1"
    },
    "75449": {
      "id": 2658216,
      "text": "kết quả là 10 người đã có được thận mới cho mình.",
      "author": "ChatGPT4.1"
    },
    "75450": {
      "id": 2658217,
      "text": "Trong khi nhiều người phải sống ở giai đoạn cuối của suy thận và phải chạy thận,",
      "author": "ChatGPT4.1"
    },
    "75451": {
      "id": 2658218,
      "text": "một loại điều trị giúp cơ thể loại bỏ chất lỏng dư thừa và các sản phẩm thải từ máu khi thận không còn khả năng làm việc.",
      "author": "ChatGPT4.1"
    },
    "75452": {
      "id": 2658219,
      "text": "Chế độ điều trị này có thể rất vất vả.",
      "author": "ChatGPT4.1"
    },
    "75453": {
      "id": 2658220,
      "text": "Có 104.840 người đang chờ danh sách ghép tạng.",
      "author": "ChatGPT4.1"
    },
    "75454": {
      "id": 2658221,
      "text": "Theo Mạng lưới Thu nhận và Cấy ghép Nội tạng,",
      "author": "ChatGPT4.1"
    },
    "75455": {
      "id": 2658222,
      "text": "có 90.506 người cần một quả thận.",
      "author": "ChatGPT4.1"
    },
    "75456": {
      "id": 2658223,
      "text": "Nhờ chuỗi ghép tạng này, 10 người đã được loại khỏi danh sách đó,",
      "author": "ChatGPT4.1"
    },
    "75457": {
      "id": 2658224,
      "text": "hy vọng sẽ rút ngắn thời gian chờ đợi cho những người khác.",
      "author": "ChatGPT4.1"
    },
    "75458": {
      "id": 2658225,
      "text": "Chuỗi ghép tạng này đã mất nhiều tháng lên kế hoạch và hàng trăm giờ lao động từ các đội ngũ y tế.",
      "author": "ChatGPT4.1"
    },
    "75459": {
      "id": 2658226,
      "text": "Giám đốc phẫu thuật ghép thận của Bang Ohio nói: \"Đây là nhờ những người hiến tặng của chúng tôi, những anh hùng của chúng tôi.\"",
      "author": "ChatGPT4.1"
    }
  }
