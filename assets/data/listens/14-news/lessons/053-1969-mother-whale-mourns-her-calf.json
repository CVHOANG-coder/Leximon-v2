  "translations": {
    "75928": {
      "id": 2585080,
      "text": "Bây giờ là cá voi mẹ ở Tây Bắc và hành động tang thương rõ ràng của nó.",
      "author": "ChatGPT4.1"
    },
    "75929": {
      "id": 2585081,
      "text": "Đây là một cảnh tượng khiến các nhà nghiên cứu phải xem xét kỹ cảm xúc của những sinh vật khổng lồ này.",
      "author": "ChatGPT4.1"
    },
    "75930": {
      "id": 2585082,
      "text": "Nỗi đau cho một đàn cá voi orca có nguy cơ tuyệt chủng ở vùng Tây Bắc Thái Bình Dương.",
      "author": "ChatGPT4.1"
    },
    "75931": {
      "id": 2585083,
      "text": "Một con cá voi mẹ đang đau buồn, được biết đến với tên gọi J35,",
      "author": "ChatGPT4.1"
    },
    "75932": {
      "id": 2585084,
      "text": "đã được nhìn thấy trong tuần này mang theo xác con non đã chết của nó trong điều mà các nhà nghiên cứu gọi là hành động để tang.",
      "author": "ChatGPT4.1"
    },
    "75933": {
      "id": 2585085,
      "text": "J35 đã lên báo khi làm điều tương tự bảy năm trước sau khi mất một con non khác.",
      "author": "ChatGPT4.1"
    },
    "75934": {
      "id": 2585086,
      "text": "Cô ấy đã mang xác con non đó hơn 1.000 dặm trong suốt 17 ngày.",
      "author": "ChatGPT4.1"
    },
    "75935": {
      "id": 2585087,
      "text": "Việc lại rơi vào hoàn cảnh tương tự thực sự là cú sốc cho tất cả chúng ta, kể cả con cá voi.",
      "author": "ChatGPT4.1"
    },
    "75936": {
      "id": 2585088,
      "text": "Tỷ lệ tử vong ở cá voi con rất cao; chỉ 50% cá thể orca mới sinh sống sót đến sinh nhật đầu tiên.",
      "author": "ChatGPT4.1"
    },
    "75937": {
      "id": 2585089,
      "text": "Và các nhà nghiên cứu cảnh báo rằng cá voi sát thủ cư trú phía Nam, như J35, có thể đang bên bờ tuyệt chủng",
      "author": "ChatGPT4.1"
    },
    "75938": {
      "id": 2585090,
      "text": "do sự khan hiếm thức ăn, ô nhiễm và tiếng ồn từ tàu thuyền, làm gián đoạn việc săn mồi.",
      "author": "ChatGPT4.1"
    },
    "75939": {
      "id": 2585091,
      "text": "Sự thương tiếc của J35 chỉ là ví dụ mới nhất về hành vi kỳ lạ của loài orca.",
      "author": "ChatGPT4.1"
    },
    "75940": {
      "id": 2585092,
      "text": "Các nhóm cá voi sát thủ đã tấn công tàu thuyền ở châu Âu,",
      "author": "ChatGPT4.1"
    },
    "75941": {
      "id": 2585093,
      "text": "xé rời bánh lái, thậm chí đánh chìm cả du thuyền.",
      "author": "ChatGPT4.1"
    },
    "75942": {
      "id": 2585094,
      "text": "Các nhà nghiên cứu về hành vi này nói rằng nó có chủ đích, nhưng thực ra tương tự như thanh thiếu niên đùa giỡn.",
      "author": "ChatGPT4.1"
    },
    "75943": {
      "id": 2585095,
      "text": "Quay lại Bờ Tây, khi đàn J của cá voi sát thủ đang đau buồn,",
      "author": "ChatGPT4.1"
    },
    "75944": {
      "id": 2585096,
      "text": "vẫn còn lý do để hy vọng.",
      "author": "ChatGPT4.1"
    },
    "75945": {
      "id": 2585097,
      "text": "Các nhà nghiên cứu đã quan sát thấy một con non mới sinh khác trong đàn vẫn còn sống và có vẻ khoẻ mạnh.",
      "author": "ChatGPT4.1"
    },
    "75946": {
      "id": 2585098,
      "text": "Các nhà nghiên cứu dự định theo dõi đàn của J35 thêm vài tuần nữa...",
      "author": "ChatGPT4.1"
    },
    "75947": {
      "id": 2585099,
      "text": "trước khi đàn cá voi cư trú phía Nam di cư khỏi Seattle.",
      "author": "ChatGPT4.1"
    }
  }
