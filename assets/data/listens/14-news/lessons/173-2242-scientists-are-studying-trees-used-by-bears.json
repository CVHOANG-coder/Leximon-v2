    "89135": {
      "id": 3442110,
      "text": "Ôi, cảm giác dễ chịu khi gãi một chỗ ngứa.",
      "author": "ChatGPT4.1"
    },
    "89136": {
      "id": 3442111,
      "text": "Những chú gấu này dường như rất giỏi trong việc tìm đúng cây để thực hiện điều đó.",
      "author": "ChatGPT4.1"
    },
    "89137": {
      "id": 3442112,
      "text": "Những chiếc máy quay đặt trong rừng đã ghi lại cảnh chúng trườn lên xuống các thân cây khắp khu rừng.",
      "author": "ChatGPT4.1"
    },
    "89138": {
      "id": 3442113,
      "text": "Các nhà khoa học cho biết hành vi dễ thương nhưng bình dị này có thể giúp họ hiểu thêm về loài vật này.",
      "author": "ChatGPT4.1"
    },
    "89139": {
      "id": 3442114,
      "text": "Các nhà nghiên cứu ở Thổ Nhĩ Kỳ đã phát hiện ra rằng gấu cũng dùng một số cây nhất định để đánh dấu mùi hương.",
      "author": "ChatGPT4.1"
    },
    "89140": {
      "id": 3442115,
      "text": "Đây là cách chúng đánh dấu lãnh thổ và giao tiếp với các loài động vật khác.",
      "author": "ChatGPT4.1"
    },
    "89141": {
      "id": 3442116,
      "text": "Hiện các nhà khoa học đang nghiên cứu các đặc điểm của những cây này",
      "author": "ChatGPT4.1"
    },
    "89142": {
      "id": 3442117,
      "text": "như chiều cao, tuổi đời, loài cây và vị trí của chúng.",
      "author": "ChatGPT4.1"
    },
    "89143": {
      "id": 3442118,
      "text": "Những cây đánh dấu mùi hương đang được bảo vệ để không làm ảnh hưởng đến mùi hương đã được hấp thụ.",
      "author": "ChatGPT4.1"
    },
    "89144": {
      "id": 3442119,
      "text": "Liệu con người có thể giải mã được những thông điệp mà những chú gấu này muốn truyền đạt cho nhau không?",
      "author": "ChatGPT4.1"
    },
    "89145": {
      "id": 3442120,
      "text": "Họ chắc chắn hy vọng như vậy.",
      "author": "ChatGPT4.1"
    },
    "89146": {
      "id": 3442121,
      "text": "Nếu không gì khác, họ cũng được ngắm nhìn những gã khổng lồ lông xù này khiêu vũ một chút lúc chúng nghĩ rằng không ai quan sát.",
      "author": "ChatGPT4.1"
    }
  }
