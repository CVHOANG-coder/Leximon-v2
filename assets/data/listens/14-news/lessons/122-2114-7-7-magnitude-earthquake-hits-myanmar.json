  "translations": {
    "83566": {
      "id": 2593361,
      "text": "Ít nhất 150 người đã thiệt mạng sau một trận động đất ở Đông Nam Á.",
      "author": "ChatGPT4.1"
    },
    "83567": {
      "id": 2593362,
      "text": "Các báo cáo cho biết trận động đất có độ lớn 7,7 đã xảy ra ở Myanmar.",
      "author": "ChatGPT4.1"
    },
    "83568": {
      "id": 2593363,
      "text": "Sau đó là một dư chấn có độ lớn 6,4.",
      "author": "ChatGPT4.1"
    },
    "83569": {
      "id": 2593364,
      "text": "Các rung chấn lan xa tới tận Bangkok, Thái Lan, nơi có báo cáo tám người đã thiệt mạng",
      "author": "ChatGPT4.1"
    },
    "83570": {
      "id": 2593365,
      "text": "sau khi một tòa nhà cao tầng đang xây dựng bị sập.",
      "author": "ChatGPT4.1"
    },
    "83571": {
      "id": 2593366,
      "text": "Một người phụ nữ đã kể lại những gì cô cảm nhận.",
      "author": "ChatGPT4.1"
    },
    "83572": {
      "id": 2593367,
      "text": "Tôi đang ngủ trên giường thì lúc đầu tôi tưởng đầu mình đang quay cuồng.",
      "author": "ChatGPT4.1"
    },
    "83573": {
      "id": 2593368,
      "text": "Vì vậy tôi đã di chuyển để xem chuyện gì đang xảy ra",
      "author": "ChatGPT4.1"
    },
    "83574": {
      "id": 2593369,
      "text": "và mọi thứ bắt đầu lắc lư mạnh hơn nữa.",
      "author": "ChatGPT4.1"
    },
    "83575": {
      "id": 2593370,
      "text": "Vì thế tôi nhanh chóng chạy đến chỗ các con tôi",
      "author": "ChatGPT4.1"
    },
    "83576": {
      "id": 2593371,
      "text": "và chúng tôi nhanh chóng trú ẩn dưới gầm bàn.",
      "author": "ChatGPT4.1"
    },
    "83577": {
      "id": 2593372,
      "text": "Hàng trăm người đã bị thương trên khắp khu vực và các quan chức cho biết số người chết được dự đoán sẽ tăng lên.",
      "author": "ChatGPT4.1"
    },
    "83578": {
      "id": 2593373,
      "text": "Myanmar hiện đang chìm trong một cuộc nội chiến",
      "author": "ChatGPT4.1"
    },
    "83579": {
      "id": 2593374,
      "text": "và chính phủ do quân đội điều hành đã ban bố tình trạng khẩn cấp.",
      "author": "ChatGPT4.1"
    }
  }
}
