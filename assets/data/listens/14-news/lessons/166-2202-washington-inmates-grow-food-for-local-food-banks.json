  "translations": {
    "87077": {
      "id": 3271111,
      "text": "Những người này có thể tham gia các khóa học về nuôi ong, làm vườn, thậm chí cả nuôi gà.",
      "author": "ChatGPT4.1"
    },
    "87078": {
      "id": 3271112,
      "text": "Nhà kính trong khuôn viên nhà tù bắt đầu với số hạt giống trị giá 500 đô la từ một tổ chức phi lợi nhuận",
      "author": "ChatGPT4.1"
    },
    "87079": {
      "id": 3271113,
      "text": "và các phạm nhân trồng đủ loại nông sản khác nhau,",
      "author": "ChatGPT4.1"
    },
    "87080": {
      "id": 3271114,
      "text": "bí ngòi, chanh, bơ,",
      "author": "ChatGPT4.1"
    },
    "87081": {
      "id": 3271115,
      "text": "và sau đó hoa quả cùng rau củ sẽ được quyên góp cho một ngân hàng thực phẩm địa phương.",
      "author": "ChatGPT4.1"
    },
    "87082": {
      "id": 3271116,
      "text": "Anh ấy quyên góp tất cả và thật tốt khi biết rằng có những người ngoài kia,",
      "author": "ChatGPT4.1"
    },
    "87083": {
      "id": 3271117,
      "text": "đặc biệt là ngay bây giờ, bạn biết đấy, khi mà...",
      "author": "ChatGPT4.1"
    },
    "87084": {
      "id": 3271118,
      "text": "tất cả các khoản tài trợ đều bị cắt giảm và những thứ khác, tôi xem tin tức mỗi ngày về các ngân hàng thực phẩm.",
      "author": "ChatGPT4.1"
    },
    "87085": {
      "id": 3271119,
      "text": "Và bây giờ khi chúng tôi có thể quyên góp 40-50.000 pound thực phẩm...",
      "author": "ChatGPT4.1"
    },
    "87086": {
      "id": 3271120,
      "text": "thật tuyệt vời.",
      "author": "ChatGPT4.1"
    },
    "87087": {
      "id": 3271121,
      "text": "Sáng kiến này đã thành công đến mức truyền cảm hứng cho tám cơ sở cải huấn khác ở Washington bắt đầu các chương trình làm vườn riêng của họ.",
      "author": "ChatGPT4.1"
    },
    "87076": {
      "id": 3273416,
      "text": "Một nhà tù bang ở Washington đang cung cấp những kỹ năng hữu ích trong khi các tù nhân thi hành án.",
      "author": "ChatGPT4.1"
    }
  }
