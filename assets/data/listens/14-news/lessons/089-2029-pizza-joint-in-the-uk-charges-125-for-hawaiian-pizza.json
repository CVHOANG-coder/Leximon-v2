  "translations": {
    "79184": {
      "id": 2625764,
      "text": "Một tiệm pizza ở Vương quốc Anh đang đưa ra tuyên bố về cảm nhận của họ đối với một loại topping pizza gây tranh cãi.",
      "author": "ChatGPT4.1"
    },
    "79185": {
      "id": 2625765,
      "text": "Chúng tôi rất, phải nói là cực kỳ, không thích dứa trên pizza.",
      "author": "ChatGPT4.1"
    },
    "79186": {
      "id": 2625766,
      "text": "Chúng tôi cảm thấy nó hoàn toàn không hợp với pizza, và thực sự không hiểu tại sao nó lại tồn tại.",
      "author": "ChatGPT4.1"
    },
    "79187": {
      "id": 2625767,
      "text": "Dù rất bực bội, Lupa Pizza ở Norwich",
      "author": "ChatGPT4.1"
    },
    "79188": {
      "id": 2625768,
      "text": "vẫn sẽ phục vụ bạn một chiếc pizza Hawaii như gọi là,",
      "author": "ChatGPT4.1"
    },
    "79189": {
      "id": 2625769,
      "text": "nhưng bạn sẽ phải trả một cái giá rất cao.",
      "author": "ChatGPT4.1"
    },
    "79190": {
      "id": 2625770,
      "text": "100 bảng Anh hoặc khoảng 125 đô la Mỹ.",
      "author": "ChatGPT4.1"
    },
    "79191": {
      "id": 2625771,
      "text": "Dứa và pizza là sai.",
      "author": "ChatGPT4.1"
    },
    "79192": {
      "id": 2625772,
      "text": "Điều đó không nên làm.",
      "author": "ChatGPT4.1"
    },
    "79193": {
      "id": 2625773,
      "text": "Tôi chắc chắn 100% sẽ không trả tiền cho thứ đó.",
      "author": "ChatGPT4.1"
    },
    "79194": {
      "id": 2625774,
      "text": "Ý tôi là, nó không tệ lắm.",
      "author": "ChatGPT4.1"
    },
    "79195": {
      "id": 2625775,
      "text": "Chắc có lẽ nó xếp thứ hai sau pepperoni đối với tôi.",
      "author": "ChatGPT4.1"
    },
    "79196": {
      "id": 2625776,
      "text": "Nhà hàng đã tổ chức một cuộc khảo sát trên mạng xã hội,",
      "author": "ChatGPT4.1"
    },
    "79197": {
      "id": 2625777,
      "text": "và khách hàng chia đều 50/50 về việc dứa có phải là một topping pizza chấp nhận được không.",
      "author": "ChatGPT4.1"
    },
    "79198": {
      "id": 2625778,
      "text": "Họ cho biết không ai đặt pizza Hawaii kể từ khi giá thay đổi.",
      "author": "ChatGPT4.1"
    },
    "79199": {
      "id": 2625779,
      "text": "Dù có người thích nó, rõ ràng vẫn chưa đủ khiến họ bỏ ra số tiền như vậy.",
      "author": "ChatGPT4.1"
    }
  }
