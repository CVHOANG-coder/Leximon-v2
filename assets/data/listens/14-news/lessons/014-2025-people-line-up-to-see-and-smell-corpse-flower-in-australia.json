  "translations": {
    "79121": {
      "id": 2593125,
      "text": "Mọi người xếp hàng để ngắm, nhưng chủ yếu là để ngửi mùi của loài hoa này.",
      "author": "ChatGPT4.1"
    },
    "79122": {
      "id": 2593126,
      "text": "Sau khi nghe những đánh giá của họ, bạn có thể sẽ tự hỏi tại sao.",
      "author": "ChatGPT4.1"
    },
    "79123": {
      "id": 2593127,
      "text": "Ờ, khá là kinh khủng.",
      "author": "ChatGPT4.1"
    },
    "79124": {
      "id": 2593128,
      "text": "Hãy nghĩ về lần cuối cùng bạn ở phòng gym cùng với rất nhiều người đàn ông mồ hôi nhễ nhại.",
      "author": "a user"
    },
    "79125": {
      "id": 2593129,
      "text": "Vườn Bách Thảo ở Sydney, Úc đã trưng bày loài hoa này.",
      "author": "ChatGPT4.1"
    },
    "79126": {
      "id": 2593130,
      "text": "Nó có tên khoa học là Amorphophallus Titanum khổng lồ,",
      "author": "a user"
    },
    "79127": {
      "id": 2593131,
      "text": "nhưng người dân địa phương đặt biệt danh là Putricia vì mùi hôi thối của nó.",
      "author": "ChatGPT4.1"
    },
    "79128": {
      "id": 2593132,
      "text": "Nó chỉ kéo dài trong 24 giờ,",
      "author": "a user"
    },
    "79129": {
      "id": 2593133,
      "text": "nên bất cứ ai tò mò về mùi hương này đều phải xếp hàng để tự mình trải nghiệm.",
      "author": "ChatGPT4.1"
    },
    "79130": {
      "id": 2593134,
      "text": "Tất cả họ đều nói rằng họ đã nhận đúng như quảng cáo.",
      "author": "ChatGPT4.1"
    },
    "79131": {
      "id": 2593135,
      "text": "Mùi hôi như rác nóng.",
      "author": "ChatGPT4.1"
    },
    "79132": {
      "id": 2593136,
      "text": "Nó có mùi như thứ gì đó đang thối rữa.",
      "author": "ChatGPT4.1"
    },
    "79133": {
      "id": 2593137,
      "text": "Lần cuối cùng Putricia nở hoa là cách đây 15 năm.",
      "author": "ChatGPT4.1"
    },
    "79134": {
      "id": 2593138,
      "text": "Vì vậy, nếu bạn tò mò, bạn có thể sẽ phải chờ một thời gian nữa mới biết được mùi hương của nó.",
      "author": "ChatGPT4.1"
    }
  }
