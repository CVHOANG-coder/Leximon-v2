  "translations": {
    "74885": {
      "id": 2624336,
      "text": "Trong một xưởng chứa đầy tivi, máy tính và điện thoại di động,",
      "author": "ChatGPT4.1"
    },
    "74886": {
      "id": 2624337,
      "text": "những thiết bị điện tử này chỉ hữu ích dựa vào những gì có bên trong chúng.",
      "author": "ChatGPT4.1"
    },
    "74887": {
      "id": 2624338,
      "text": "Những công nhân tháo rời chúng bằng kìm hoặc bằng tay không,",
      "author": "ChatGPT4.1"
    },
    "74888": {
      "id": 2624339,
      "text": "tìm kiếm vàng trong các bảng mạch của chúng.",
      "author": "ChatGPT4.1"
    },
    "74889": {
      "id": 2624340,
      "text": "Khi kim loại được tách ra, các microgram sẽ được gom lại và tách bằng axit.",
      "author": "ChatGPT4.1"
    },
    "74890": {
      "id": 2624341,
      "text": "Đó là một công việc vừa tẻ nhạt vừa nguy hiểm.",
      "author": "ChatGPT4.1"
    },
    "74891": {
      "id": 2624342,
      "text": "Những người ở các quốc gia giàu có thường dựa vào công nghệ với các biện pháp an toàn tốt hơn cho cùng quy trình đó.",
      "author": "ChatGPT4.1"
    },
    "74892": {
      "id": 2624343,
      "text": "\"Mất rất nhiều thời gian để tháo rời mọi thứ.\"",
      "author": "ChatGPT4.1"
    },
    "74893": {
      "id": 2624344,
      "text": "\"Chúng tôi không có máy móc cần thiết, và chúng tôi cũng không có nhiều thiết bị.\"",
      "author": "ChatGPT4.1"
    },
    "74894": {
      "id": 2624345,
      "text": "\"Chúng tôi không có nhiều axit, chúng tôi phải nhập từ Pakistan,\"",
      "author": "ChatGPT4.1"
    },
    "74895": {
      "id": 2624346,
      "text": "\"nên chúng tôi không thể tách được gì ngoài vàng, thậm chí cả bạc cũng không.\"",
      "author": "ChatGPT4.1"
    },
    "74896": {
      "id": 2624347,
      "text": "Những người đàn ông này nhận mức lương điển hình ở Afghanistan,",
      "author": "ChatGPT4.1"
    },
    "74897": {
      "id": 2624348,
      "text": "khoảng 166 đô la Mỹ một tháng tại xưởng này, chủ xưởng cho biết.",
      "author": "ChatGPT4.1"
    },
    "74898": {
      "id": 2624349,
      "text": "Nhưng dù mang lại lợi nhuận cho một số người, tương lai của nghề này rất ảm đạm.",
      "author": "ChatGPT4.1"
    },
    "74899": {
      "id": 2624350,
      "text": "Theo các công nhân, ngày càng nhiều thiết bị điện tử được sản xuất với kim loại rẻ hơn,",
      "author": "ChatGPT4.1"
    },
    "74900": {
      "id": 2624351,
      "text": "làm giảm dần lượng vàng có thể khai thác từ các mặt hàng mới.",
      "author": "ChatGPT4.1"
    }
  }
}
