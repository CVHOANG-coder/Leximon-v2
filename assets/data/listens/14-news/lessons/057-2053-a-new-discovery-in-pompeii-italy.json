      "text": "Và chúng ta đang thoáng nhìn thấy những điểm đến cao cấp, giống như khu nghỉ dưỡng mà người xưa đã tận hưởng cách đây gần 2.000 năm.",
      "author": "ChatGPT4.1"
    },
    "80534": {
      "id": 2655097,
      "text": "Phóng viên Ben Wedeman của chúng tôi đang ở đó để giới thiệu cho chúng ta về một khu phức hợp spa xa hoa vừa mới được khai quật ở Pompeii.",
      "author": "ChatGPT4.1"
    },
    "80535": {
      "id": 2655098,
      "text": "Vào khoảng trưa năm 79 sau Công nguyên, núi Vesuvius bắt đầu phun trào.",
      "author": "ChatGPT4.1"
    },
    "80536": {
      "id": 2655099,
      "text": "Nếu may mắn, cư dân kịp chạy thoát. Số còn lại đã chết.",
      "author": "ChatGPT4.1"
    },
    "80537": {
      "id": 2655100,
      "text": "Trong nhiều thế kỷ sau đó, Pompeii gần như đã bị lãng quên",
      "author": "ChatGPT4.1"
    },
    "80538": {
      "id": 2655101,
      "text": "cho đến giữa thế kỷ 18, khi việc khai quật bắt đầu một cách nghiêm túc.",
      "author": "ChatGPT4.1"
    },
    "80539": {
      "id": 2655102,
      "text": "Khu di tích này rất rộng lớn, với khoảng... bạn biết đấy, 13.000 phòng đã được khai quật trong suốt hai thế kỷ rưỡi.",
      "author": "ChatGPT4.1"
    },
    "80540": {
      "id": 2655103,
      "text": "Vẫn còn những phát hiện mới.",
      "author": "ChatGPT4.1"
    },
    "80541": {
      "id": 2655104,
      "text": "Mới nhất: khu phức hợp nhà tắm sang trọng này, bao gồm một caldarium (phòng tắm nóng),",
      "author": "ChatGPT4.1"
    },
    "80542": {
      "id": 2655105,
      "text": "một tepidarium (phòng tắm ấm),",
      "author": "ChatGPT4.1"
    },
    "80543": {
      "id": 2655106,
      "text": "và một frigidarium (phòng có hồ nước lạnh)",
      "author": "ChatGPT4.1"
    },
    "80544": {
      "id": 2655107,
      "text": "và phòng đại tiệc.",
      "author": "ChatGPT4.1"
    },
    "80545": {
      "id": 2655108,
      "text": "Bây giờ, một trong những lý do khiến Pompeii được bảo tồn tốt như vậy là vì...",
      "author": "ChatGPT4.1"
    },
    "80546": {
      "id": 2655109,
      "text": "khi vụ phun trào Vesuvius xảy ra,",
      "author": "ChatGPT4.1"
    },
    "80547": {
      "id": 2655110,
      "text": "nó đã bị bao phủ bởi thứ này: đá bọt - dung nham nhẹ đã đông đặc.",
      "author": "ChatGPT4.1"
    }
  }
