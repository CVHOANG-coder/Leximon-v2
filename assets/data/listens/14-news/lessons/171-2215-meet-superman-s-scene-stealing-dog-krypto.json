  "translations": {
    "87582": {
      "id": 3370758,
      "text": "Có một ngôi sao mới đang làm náo loạn Hollywood.",
      "author": "ChatGPT4.1"
    },
    "87583": {
      "id": 3370759,
      "text": "Đó là chú chó mới của Superman, Krypto, và cậu ấy cũng có siêu năng lực.",
      "author": "ChatGPT4.1"
    },
    "87584": {
      "id": 3370760,
      "text": "Theo lời đồn ban đầu, Krypto đã \"chiếm sóng\" cả bộ phim.",
      "author": "ChatGPT4.1"
    },
    "87585": {
      "id": 3370761,
      "text": "Đạo diễn James Gunn đã lấy ý tưởng cho chú chó tai cụp này từ chính chú chó Ozu của mình.",
      "author": "ChatGPT4.1"
    },
    "87586": {
      "id": 3370762,
      "text": "Bạn có thể gọi đó là câu chuyện “đổi đời nhờ vẫy đuôi”.",
      "author": "ChatGPT4.1"
    },
    "87587": {
      "id": 3370763,
      "text": "“Tôi đã nhận nuôi chú chó này.”",
      "author": "ChatGPT4.1"
    },
    "87588": {
      "id": 3370764,
      "text": "“Nó đã được nuôi cùng với 60 con chó khác ở phía sau nhà...”",
      "author": "ChatGPT4.1"
    },
    "87589": {
      "id": 3370765,
      "text": "“Nó bị rơi vào một hoàn cảnh nuôi nhốt số lượng lớn.”",
      "author": "ChatGPT4.1"
    },
    "87590": {
      "id": 3370766,
      "text": "“Tôi nghĩ nó trông buồn cười vì cái tai của nó.”",
      "author": "ChatGPT4.1"
    },
    "87591": {
      "id": 3370767,
      "text": "Một cảnh trong bộ phim mới được lấy cảm hứng từ đời thực.",
      "author": "ChatGPT4.1"
    },
    "87592": {
      "id": 3370768,
      "text": "“Mỗi khi tôi đi chân trần quanh nhà...”",
      "author": "ChatGPT4.1"
    },
    "87593": {
      "id": 3370769,
      "text": "“Nó sẽ cắn chân tôi mạnh nhất có thể.”",
      "author": "ChatGPT4.1"
    },
    "87594": {
      "id": 3370770,
      "text": "Bây giờ, hãy chuẩn bị tinh thần đi. Krypto không phải là chó thật đâu.",
      "author": "ChatGPT4.1"
    },
    "87595": {
      "id": 3370771,
      "text": "Nó là sản phẩm hoàn toàn do máy tính tạo ra.",
      "author": "ChatGPT4.1"
    },
    "87596": {
      "id": 3370772,
      "text": "“Đúng là nó rất đáng yêu và mọi người đang phát cuồng vì nó,”",
