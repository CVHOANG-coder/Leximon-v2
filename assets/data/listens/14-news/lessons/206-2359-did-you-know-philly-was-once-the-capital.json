  "translations": {
    "92693": {
      "id": 4046582,
      "text": "Tôi đang đến với bạn từ bang quê nhà của tôi là Pennsylvania.",
      "author": "ChatGPT4.1"
    },
    "92694": {
      "id": 4046583,
      "text": "Chúng tôi đang ở thành phố tuyệt vời Philadelphia - quê hương của đội Philadelphia Eagles.",
      "author": "ChatGPT4.1"
    },
    "92695": {
      "id": 4046584,
      "text": "Đây là một trong những sân vận động náo nhiệt nhất mà tôi từng thi đấu trong sự nghiệp NFL của mình.",
      "author": "ChatGPT4.1"
    },
    "92696": {
      "id": 4046585,
      "text": "Mùa giải NFL đã bắt đầu vào tối qua.",
      "author": "ChatGPT4.1"
    },
    "92697": {
      "id": 4046586,
      "text": "Nhà vô địch Super Bowl đương kim đối đầu với Dallas Cowboys.",
      "author": "ChatGPT4.1"
    },
    "92698": {
      "id": 4046587,
      "text": "Tấm bảo vệ va chạm mạnh, người hâm mộ hét vang.",
      "author": "ChatGPT4.1"
    },
    "92699": {
      "id": 4046588,
      "text": "Tôi nghĩ là có mùi Philly cheese steak.",
      "author": "ChatGPT4.1"
    },
    "92700": {
      "id": 4046589,
      "text": "Khoảnh khắc này thật thích hợp cho câu hỏi “Bạn có biết không?”",
      "author": "ChatGPT4.1"
    },
    "92701": {
      "id": 4046590,
      "text": "Philadelphia từng là thủ đô tạm thời của quốc gia trong 10 năm?",
      "author": "ChatGPT4.1"
    },
    "92702": {
      "id": 4046591,
      "text": "Khi Washington DC còn đang được xây dựng, các cha lập quốc và những nhà lãnh đạo đầu tiên của Mỹ đã tụ họp tại Philadelphia từ năm 1790 đến 1800.",
      "author": "ChatGPT4.1"
    },
    "92703": {
      "id": 4046592,
      "text": "Cả Tuyên ngôn Độc lập và Hiến pháp Hoa Kỳ đều được ký tại Phòng Độc lập ở Philadelphia.",
      "author": "ChatGPT4.1"
    },
    "92704": {
      "id": 4046593,
      "text": "Thành phố này cũng là thành phố đầu tiên của Mỹ thành lập bệnh viện và thư viện",
      "author": "ChatGPT4.1"
    },
    "92705": {
      "id": 4046594,
      "text": "do Benjamin Franklin sáng lập, bạn có biết không?",
      "author": "ChatGPT4.1"
    },
    "92706": {
      "id": 4046595,
      "text": "Vì tất cả những lý do này, Philadelphia thường được gọi là cái nôi của nước Mỹ.",
      "author": "ChatGPT4.1"
    }
  }
