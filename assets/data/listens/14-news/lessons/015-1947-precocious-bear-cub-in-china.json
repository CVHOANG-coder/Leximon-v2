  "translations": {
    "75177": {
      "id": 2589400,
      "text": "Một con thú con lanh lợi khác đang gây sốt trên Internet.",
      "author": "ChatGPT4.1"
    },
    "75178": {
      "id": 2589401,
      "text": "Gặp gỡ Junjun, một chú gấu con 11 tháng tuổi sống tại Sở thú Thượng Hải, Trung Quốc.",
      "author": "ChatGPT4.1"
    },
    "75179": {
      "id": 2589402,
      "text": "Sự nổi tiếng của chú tăng vọt khi khách tham quan vườn thú đăng ảnh và video về chú gấu tinh nghịch này.",
      "author": "ChatGPT4.1"
    },
    "75180": {
      "id": 2589403,
      "text": "Nhiều người nhận thấy sự giống nhau giữa Junjun và một chú gấu nổi tiếng khác,",
      "author": "ChatGPT4.1"
    },
    "75181": {
      "id": 2589404,
      "text": "Duffy, chú Gấu của Disney.",
      "author": "ChatGPT4.1"
    },
    "75182": {
      "id": 2589405,
      "text": "Junjun, một chú gấu con rất năng động, được sinh ra tại sở thú.",
      "author": "ChatGPT4.1"
    },
    "75183": {
      "id": 2589406,
      "text": "Chỉ chưa đầy một tuổi, chú cao hơn 3 feet một chút và nặng 77 pound.",
      "author": "ChatGPT4.1"
    },
    "75184": {
      "id": 2589407,
      "text": "Khi trưởng thành, chiều cao của Junjun có thể gấp ba lần,",
      "author": "ChatGPT4.1"
    },
    "75185": {
      "id": 2589408,
      "text": "và cân nặng của chú có thể lên tới 1.000 pound.",
      "author": "ChatGPT4.1"
    },
    "75186": {
      "id": 2589409,
      "text": "Bạn có thể nhận ra chỉ sau vài phút quan sát rằng Junjun có tính cách năng động.",
      "author": "ChatGPT4.1"
    },
    "75187": {
      "id": 2589410,
      "text": "Vì Junjun được nuôi bởi con người nên chú thân thiện với mọi người và thích nô đùa.",
      "author": "ChatGPT4.1"
    },
    "75188": {
      "id": 2589411,
      "text": "Ngay cả vào những ngày lạnh giá, chú gấu con đáng yêu này vẫn thu hút đám đông.",
      "author": "ChatGPT4.1"
    }
  }
