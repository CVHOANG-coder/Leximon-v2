  "translations": {
    "78612": {
      "id": 2622191,
      "text": "Xem chiếc điện thoại bị rơi của một du khách bắt đầu chuyến phiêu lưu dưới nước đầy kỳ thú...",
      "author": "ChatGPT4.1"
    },
    "78613": {
      "id": 2622192,
      "text": "và sau đó trở nên nổi tiếng.",
      "author": "ChatGPT4.1"
    },
    "78614": {
      "id": 2622193,
      "text": "Khi đang nghỉ dưỡng ở Tulum, Mexico, Lina Nassiri đã tự quay lại cảnh mình nhảy xuống nước nhiệt đới",
      "author": "ChatGPT4.1"
    },
    "78615": {
      "id": 2622194,
      "text": "nhưng cuối cùng lại làm rơi chiếc iPhone của mình trong quá trình đó.",
      "author": "ChatGPT4.1"
    },
    "78616": {
      "id": 2622195,
      "text": "Tôi có một chiếc điện thoại... kiểu như một ốp chống nước, nên điện thoại tôi ở trong đó.",
      "author": "ChatGPT4.1"
    },
    "78617": {
      "id": 2622196,
      "text": "Với áp lực nước và mọi thứ, tôi đã đánh rơi nó.",
      "author": "ChatGPT4.1"
    },
    "78618": {
      "id": 2622197,
      "text": "Một nhân viên cứu hộ đã lấy lại được chiếc điện thoại vẫn đang quay sau đó không lâu.",
      "author": "ChatGPT4.1"
    },
    "78619": {
      "id": 2622198,
      "text": "\"Nó vẫn đang quay phim này!\"",
      "author": "ChatGPT4.1"
    },
    "78620": {
      "id": 2622199,
      "text": "Và khi Nassiri xem lại video, cô ấy thấy những gì chiếc điện thoại đã ghi lại:",
      "author": "ChatGPT4.1"
    },
    "78621": {
      "id": 2622200,
      "text": "một khung cảnh dưới nước đầy màu sắc với những chú cá thân thiện lọt vào khung hình và đủ thứ khác nữa.",
      "author": "a user"
    },
    "78622": {
      "id": 2622201,
      "text": "Nassiri đã quyết định chia sẻ đoạn video dưới nước đầy bất ngờ lên TikTok",
      "author": "ChatGPT4.1"
    },
    "78623": {
      "id": 2622202,
      "text": "và cho biết cô đã rất ngạc nhiên trước phản hồi nhận được.",
      "author": "ChatGPT4.1"
    },
    "78624": {
      "id": 2622203,
      "text": "Tôi đã không nghĩ rằng sẽ có tới 50 triệu người xem nó.",
      "author": "ChatGPT4.1"
    }
  }
