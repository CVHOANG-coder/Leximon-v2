  "translations": {
    "86684": {
      "id": 3054669,
      "text": "Dầu thầu dầu đang trở thành cơn sốt.",
      "author": "ChatGPT4.1"
    },
    "86685": {
      "id": 3054670,
      "text": "\"Thứ này thật kỳ diệu.\"",
      "author": "ChatGPT4.1"
    },
    "86686": {
      "id": 3054671,
      "text": "\"Ôi trời ơi, có quá nhiều khả năng.\"",
      "author": "ChatGPT4.1"
    },
    "86687": {
      "id": 3054672,
      "text": "Nó không còn là loại thuốc đáng sợ của những năm về trước nữa.",
      "author": "ChatGPT4.1"
    },
    "86688": {
      "id": 3054673,
      "text": "Nhớ đến bọn trẻ và Mary Poppins chứ?",
      "author": "ChatGPT4.1"
    },
    "86690": {
      "id": 3054675,
      "text": "Ngày nay, các video quảng bá lợi ích của dầu thầu dầu đã thu hút tới 400 triệu lượt xem trên mạng xã hội.",
      "author": "ChatGPT4.1"
    },
    "86691": {
      "id": 3054676,
      "text": "\"Chúng ta có thể loại bỏ được lớp mỡ dưới da.\"",
      "author": "ChatGPT4.1"
    },
    "86692": {
      "id": 3054677,
      "text": "Mọi người đang dùng nó để mọc tóc.",
      "author": "ChatGPT4.1"
    },
    "86693": {
      "id": 3054678,
      "text": "\"Dầu thầu dầu là một trong những loại dầu tốt nhất để mọc tóc và làm mờ nếp nhăn.\"",
      "author": "ChatGPT4.1"
    },
    "86694": {
      "id": 3054679,
      "text": "\"Tôi bắt đầu thoa dầu thầu dầu lên mặt vào ban đêm, và hầu hết các nếp nhăn của tôi đã biến mất.\"",
      "author": "ChatGPT4.1"
    },
    "86695": {
      "id": 3054680,
      "text": "Cô ấy nói móng tay mình đã khỏe hơn và dài hơn.",
      "author": "ChatGPT4.1"
    },
    "86696": {
      "id": 3054681,
      "text": "\"Tôi chưa bao giờ có móng tay dài như thế này.\"",
      "author": "ChatGPT4.1"
    },
    "86697": {
      "id": 3054682,
      "text": "\"Đây là một trong những điều đã hoàn toàn thay đổi cuộc sống của tôi.\"",
      "author": "ChatGPT4.1"
    },
    "86698": {
      "id": 3054683,
      "text": "Người ảnh hưởng trong lĩnh vực thể hình Emma Citarelli rất tin tưởng vào nó.",
      "author": "ChatGPT4.1"
    },
    "86699": {
      "id": 3054684,
      "text": "\"Hai năm trước, tôi từng bị đầy hơi rất nặng và u nang buồng trứng.\"",
      "author": "ChatGPT4.1"
    },
    "86700": {
      "id": 3054685,
      "text": "Trong năm qua, cô ấy đã thoa dầu thầu dầu lên bụng trước khi ngủ.",
      "author": "ChatGPT4.1"
    },
    "86701": {
      "id": 3054686,
      "text": "Cô ấy đắp lên bằng một miếng gạc bông.",
      "author": "ChatGPT4.1"
    },
    "86702": {
      "id": 3054687,
      "text": "\"Những u nang trên buồng trứng của tôi đã giảm.\"",
      "author": "ChatGPT4.1"
    },
    "86703": {
      "id": 3054688,
      "text": "\"Nó rất tốt cho tóc... Tôi thoa nó lên lông mi và lông mày.\"",
      "author": "ChatGPT4.1"
    },
    "86704": {
      "id": 3054689,
      "text": "\"Nó chỉ đơn giản giúp những thứ đó mọc dài hơn.\"",
      "author": "ChatGPT4.1"
    },
    "86705": {
      "id": 3054690,
      "text": "Người ta tin rằng cả Cleopatra và người phụ nữ nổi tiếng thủ vai bà, Elizabeth Taylor, đều sử dụng dầu thầu dầu trong quy trình làm đẹp của mình.",
      "author": "ChatGPT4.1"
    },
    "86706": {
      "id": 3054691,
      "text": "Vậy kết quả có thật không hay chỉ là chuyện truyền miệng?",
      "author": "ChatGPT4.1"
    },
    "86707": {
      "id": 3054692,
      "text": "\"Bạn không thể tin tất cả những gì nhìn thấy trên TikTok,\"",
      "author": "ChatGPT4.1"
    },
    "86708": {
      "id": 3054693,
      "text": "\"và nhiều điều bạn thấy chỉ là kinh nghiệm truyền miệng, không dựa trên bằng chứng khoa học đáng tin cậy.\"",
      "author": "ChatGPT4.1"
    },
    "86709": {
      "id": 3054694,
      "text": "Nhưng đối với những người hâm mộ dầu thầu dầu, không gì có thể vượt qua dầu thầu dầu.",
      "author": "ChatGPT4.1"
    },
    "86689": {
      "id": 3064170,
      "text": "\"Đừng bao giờ cho chúng tôi uống dầu thầu dầu hoặc cháo loãng.\"",
      "author": "ChatGPT4.1"
    }
  }
}
