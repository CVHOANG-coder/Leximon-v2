    },
    "75440": {
      "id": 2615054,
      "text": "Đó là giải độc đắc tháng 12 lớn nhất trong lịch sử của trò chơi này.",
      "author": "a user"
    },
    "75441": {
      "id": 2615055,
      "text": "Giá trị tiền mặt của nó, nhân tiện nói luôn, chỉ hơn 429 triệu.",
