  "translations": {
    "74584": {
      "id": 2588827,
      "text": "Sake có ý nghĩa văn hóa sâu sắc ở Nhật Bản,",
      "author": "ChatGPT4.1"
    },
    "74585": {
      "id": 2588828,
      "text": "và hiện nay quốc gia này đang yêu cầu Liên Hợp Quốc bảo tồn sự thiêng liêng của nó.",
      "author": "ChatGPT4.1"
    },
    "74586": {
      "id": 2588829,
      "text": "Trong hơn 1.000 năm, rượu gạo Nhật Bản được gọi là sake đã được ủ.",
      "author": "ChatGPT4.1"
    },
    "74587": {
      "id": 2588830,
      "text": "Nó có thể được phục vụ nóng hoặc lạnh, và sự phổ biến của nó đã lan rộng trên toàn thế giới.",
      "author": "ChatGPT4.1"
    },
    "74588": {
      "id": 2588831,
      "text": "Những người nấu loại đồ uống có cồn lên men này hy vọng sake sẽ được công nhận là Di sản Văn hóa Phi vật thể của UNESCO.",
      "author": "ChatGPT4.1"
    },
    "74589": {
      "id": 2588832,
      "text": "Chương trình này đã đưa những người sản xuất rượu rum nhẹ của Cuba và kỹ thuật chế biến trà truyền thống của Trung Quốc",
      "author": "ChatGPT4.1"
    },
    "74590": {
      "id": 2588833,
      "text": "vào danh sách tri thức và kỹ năng cần được bảo vệ.",
      "author": "ChatGPT4.1"
    },
    "74591": {
      "id": 2588834,
      "text": "Theo Hiệp hội Sản xuất Sake và Shochu,",
      "author": "ChatGPT4.1"
    },
    "74592": {
      "id": 2588835,
      "text": "xuất khẩu sake mang lại khoảng 265 triệu đô la mỗi năm.",
      "author": "ChatGPT4.1"
    },
    "74593": {
      "id": 2588836,
      "text": "Sake mất khoảng hai tháng để sản xuất,",
      "author": "ChatGPT4.1"
    },
    "74594": {
      "id": 2588837,
      "text": "và cũng giống như champagne chỉ đến từ vùng Champagne của Pháp,",
      "author": "ChatGPT4.1"
    },
    "74595": {
      "id": 2588838,
      "text": "trong khi các loại đồ uống tương tự khác chỉ được gọi là rượu vang sủi tăm,",
      "author": "ChatGPT4.1"
    },
    "74596": {
      "id": 2588839,
      "text": "sake phải được làm từ gạo Nhật Bản.",
      "author": "ChatGPT4.1"
    },
    "74597": {
      "id": 2588840,
      "text": "Nếu không, nó chỉ là rượu gạo.",
      "author": "ChatGPT4.1"
    },
    "74598": {
      "id": 2588841,
      "text": "Các nhà sản xuất sake cũng hy vọng danh hiệu của UNESCO sẽ giúp tăng doanh số bán hàng.",
      "author": "ChatGPT4.1"
    }
  }
}
