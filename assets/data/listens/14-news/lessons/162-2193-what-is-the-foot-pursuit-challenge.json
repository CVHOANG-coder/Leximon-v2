  "translations": {
    "86725": {
      "id": 3102696,
      "text": "Viên cảnh sát này đang truy đuổi gắt gao, nhưng cô ấy không phải là nghi phạm.",
      "author": "ChatGPT4.1"
    },
    "86726": {
      "id": 3102697,
      "text": "Cô ấy là vợ anh ấy.",
      "author": "ChatGPT4.1"
    },
    "86727": {
      "id": 3102698,
      "text": "Viên cảnh sát này cũng đang đuổi theo.",
      "author": "ChatGPT4.1"
    },
    "86728": {
      "id": 3102699,
      "text": "Vài giây sau, vợ anh ấy bị bắt.",
      "author": "ChatGPT4.1"
    },
    "86729": {
      "id": 3102700,
      "text": "Vậy chuyện gì đang xảy ra?",
      "author": "ChatGPT4.1"
    },
    "86730": {
      "id": 3102701,
      "text": "Đây là một trào lưu mới đang lan truyền trên mạng xã hội.",
      "author": "ChatGPT4.1"
    },
    "86731": {
      "id": 3102702,
      "text": "Những người vợ cố gắng chạy nhanh hơn chồng mình là cảnh sát.",
      "author": "ChatGPT4.1"
    },
    "86732": {
      "id": 3102703,
      "text": "Trào lưu này gọi là Thử Thách Rượt Đuổi, theo nhạc nền Bad Boys của Cops.",
      "author": "ChatGPT4.1"
    },
    "86733": {
      "id": 3102704,
      "text": "Hãy xem người vợ này được chạy trước, nhưng 20 giây sau thì bị bắt lại.",
      "author": "ChatGPT4.1"
    },
    "86734": {
      "id": 3102705,
      "text": "Tôi đã trò chuyện với Acasia Vincent và chồng cô, sĩ quan tuần tra Rick ở Cedar City, Utah.",
      "author": "ChatGPT4.1"
    },
    "86735": {
      "id": 3102706,
      "text": "Acasia, bạn nghĩ gì? Bạn có nghĩ mình có cơ hội không?",
      "author": "ChatGPT4.1"
    },
    "86736": {
      "id": 3102707,
      "text": "Không, tôi không nghĩ vậy, tôi đã không tập thể dục từ khoảng năm 2016,",
      "author": "ChatGPT4.1"
    },
    "86737": {
      "id": 3102708,
      "text": "nên tôi nghĩ sẽ nhanh thôi, nhưng tôi nhanh hơn tôi tưởng.",
      "author": "ChatGPT4.1"
    },
    "86738": {
      "id": 3102709,
      "text": "Anh ấy khá giỏi trong việc rượt đuổi nhỉ?",
      "author": "ChatGPT4.1"
    },
    "86739": {
      "id": 3102710,
      "text": "Ừ, chúng tôi đã cắt phần anh ấy cố gắng còng tay tôi...",
      "author": "ChatGPT4.1"
    }
  }
}
