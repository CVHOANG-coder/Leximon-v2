    "78593": {
      "id": 2640784,
      "text": "Điều đó đã gây ra việc đóng cửa hàng loạt trường học và nơi làm việc cũng như gián đoạn giao thông,",
      "author": "ChatGPT4.1"
    },
    "78594": {
