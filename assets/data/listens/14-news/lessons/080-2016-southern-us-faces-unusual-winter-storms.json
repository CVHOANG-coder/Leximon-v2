  "translations": {
    "78590": {
      "id": 2640781,
      "text": "Chúng ta bắt đầu hôm nay với đợt thời tiết mùa đông phá vỡ kỷ lục khiến vùng Bờ biển Vịnh Hoa Kỳ tê liệt.",
      "author": "ChatGPT4.1"
    },
    "78591": {
      "id": 2640782,
      "text": "Tuần này, một cơn bão mùa đông lớn đã ảnh hưởng đến một vùng rộng lớn của miền Nam sâu.",
      "author": "ChatGPT4.1"
    },
    "78592": {
      "id": 2640783,
      "text": "Nơi vốn không quen đối phó với băng giá hay tuyết rơi.",
      "author": "ChatGPT4.1"
