  "translations": {
    "89394": {
      "id": 3564525,
      "text": "Một vận động viên bơi lội 12 tuổi thi đấu với các vận động viên Olympic.",
      "author": "ChatGPT4.1"
    },
    "89395": {
      "id": 3564526,
      "text": "Hiện tượng người Trung Quốc Yu Zidi đã làm nên lịch sử vào tuần trước, trở thành vận động viên trẻ nhất từng đoạt huy chương tại Giải vô địch Bơi lội Thế giới ở Singapore.",
      "author": "ChatGPT4.1"
    },
    "89396": {
      "id": 3564527,
      "text": "Mới chỉ 12 tuổi, cô đã là thành viên của đội tiếp sức tự do 4x200 mét của Trung Quốc và giành huy chương đồng.",
      "author": "ChatGPT4.1"
    },
    "89397": {
      "id": 3564528,
      "text": "Người trẻ nhất giành huy chương tại một giải đấu quốc tế lớn kể từ năm 1936.",
      "author": "ChatGPT4.1"
    },
    "89398": {
      "id": 3564529,
      "text": "Thành tích của cô ấy nhanh đến mức cho phép cô được tham dự giải vô địch,",
      "author": "ChatGPT4.1"
    },
    "89399": {
      "id": 3564530,
      "text": "mặc dù yêu cầu độ tuổi tối thiểu là 14.",
      "author": "ChatGPT4.1"
    },
    "89400": {
      "id": 3564531,
      "text": "Cô bắt đầu bơi lội từ năm 6 tuổi chỉ như một cách để tránh nóng ở quê nhà tỉnh Hà Bắc.",
      "author": "ChatGPT4.1"
    },
    "89401": {
      "id": 3564532,
      "text": "Nhưng cô đã quyết định thử sức với bơi lội thi đấu khi một huấn luyện viên giới thiệu điều đó với cô.",
      "author": "ChatGPT4.1"
    },
    "89402": {
