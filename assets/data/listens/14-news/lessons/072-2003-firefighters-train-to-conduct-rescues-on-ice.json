  "translations": {
    "77936": {
      "id": 3139252,
      "text": "Nhiều người trong chúng ta biết rằng lính cứu hỏa không chỉ là những anh hùng khi chiến đấu với lửa.",
      "author": "ChatGPT4.1"
    },
    "77937": {
      "id": 3139253,
      "text": "Họ đáp ứng lời kêu gọi trong nhiều tình huống khẩn cấp",
      "author": "ChatGPT4.1"
    },
    "77938": {
      "id": 3139254,
      "text": "như tai nạn xe hơi, thiên tai, và...",
      "author": "ChatGPT4.1"
    },
    "77939": {
      "id": 3139255,
      "text": "một số lính cứu hỏa được đào tạo đặc biệt cũng có thể được gọi là chiến binh băng giá.",
      "author": "ChatGPT4.1"
    },
    "77940": {
      "id": 3139256,
      "text": "Khi thời tiết mùa đông đóng băng các ao hồ ở Kentucky,",
      "author": "ChatGPT4.1"
    },
    "77941": {
      "id": 3139257,
      "text": "đội lính cứu hỏa Đặc Nhiệm của Sở cứu hỏa Lexington trang bị bộ đồ khô chịu lạnh dưới 0 độ,",
      "author": "ChatGPT4.1"
    },
    "77942": {
      "id": 3139258,
      "text": "và mô phỏng các tình huống cứu hộ khẩn cấp với hy vọng cứu sống mạng người và...",
      "author": "ChatGPT4.1"
    },
    "77943": {
      "id": 3139259,
      "text": "Chúng ta đang có cái nhìn cận cảnh về cách những chuyên gia cứu hộ trên băng này luyện tập.",
      "author": "ChatGPT4.1"
    },
    "77944": {
      "id": 3139260,
      "text": "Một ngày trên mặt nước với đội này mang ý nghĩa cứu người nhiều hơn là thư giãn.",
      "author": "ChatGPT4.1"
    },
    "77945": {
      "id": 3139261,
      "text": "Khi các ao hồ trong vùng cuối cùng đã đóng băng,",
      "author": "ChatGPT4.1"
    },
    "77946": {
      "id": 3139262,
      "text": "những lính cứu hỏa đặc nhiệm có cơ hội huấn luyện cho kịch bản tồi tệ nhất của mùa đông.",
      "author": "ChatGPT4.1"
    },
    "77947": {
      "id": 3139263,
      "text": "Tập trung quanh Đội trưởng Ryan Hogston, mặc bộ đồ khô đắt tiền,",
      "author": "ChatGPT4.1"
    },
    "77948": {
      "id": 3139264,
      "text": "các lính cứu hỏa học về các quy tắc cứu hộ trên băng.",
      "author": "ChatGPT4.1"
    },
    "77949": {
      "id": 3139265,
      "text": "Những quy tắc này cũng áp dụng cho công chúng:",
      "author": "ChatGPT4.1"
    },
    "77950": {
      "id": 3139266,
      "text": "Tìm người đang mắc kẹt trên băng.",
      "author": "ChatGPT4.1"
    },
    "77951": {
      "id": 3139267,
      "text": "Chúng tôi thực hiện một quy trình gọi là \"với tới, ném đồ, và di chuyển\".",
      "author": "ChatGPT4.1"
    },
    "77952": {
      "id": 3139268,
      "text": "Khi bạn đã gọi 911,",
      "author": "ChatGPT4.1"
    },
    "77953": {
      "id": 3139269,
      "text": "hãy đưa đến nạn nhân một cây gậy, thang, hoặc bất cứ thứ gì bạn có thể tìm thấy.",
      "author": "ChatGPT4.1"
    },
    "77954": {
      "id": 3139270,
      "text": "Ném dây thừng hoặc vật gì để họ bám vào và hành động ngay!",
      "author": "ChatGPT4.1"
    },
    "77955": {
      "id": 3139271,
      "text": "Đó là tín hiệu để lính cứu hỏa lao vào hành động.",
      "author": "ChatGPT4.1"
    },
    "77956": {
      "id": 3139272,
      "text": "Hogston cho biết các sự cố trên băng có thể xảy ra dễ dàng hơn bạn nghĩ.",
      "author": "ChatGPT4.1"
    },
    "77957": {
      "id": 3139273,
      "text": "\"Chỉ mới năm ngoái, có một con vật bị kẹt ngoài đó, và một người đã ra cố cứu nó rồi rơi xuống băng.\"",
      "author": "ChatGPT4.1"
    },
    "77958": {
      "id": 3139274,
      "text": "Nhưng không phải sở cứu hỏa nào cũng được trang bị để ứng phó.",
      "author": "ChatGPT4.1"
    },
    "77959": {
      "id": 3139275,
      "text": "Trong số 600 lính cứu hỏa của LFD,",
      "author": "ChatGPT4.1"
    },
    "77960": {
      "id": 3139276,
      "text": "chỉ khoảng 10% được huấn luyện cho loại hình cứu hộ này.",
      "author": "ChatGPT4.1"
    },
    "77961": {
      "id": 3139277,
      "text": "Những người này vừa là lính cứu hỏa bình thường, nhưng còn có thêm 400 giờ huấn luyện cứu hộ bổ sung",
      "author": "ChatGPT4.1"
    },
    "77962": {
      "id": 3139278,
      "text": "để có thể thực hiện các tình huống này.",
      "author": "ChatGPT4.1"
    },
    "77963": {
      "id": 3139279,
      "text": "Nếu họ có thể cứu được chỉ một người, thì việc đào tạo đó cũng xứng đáng.",
      "author": "ChatGPT4.1"
    },
    "77964": {
      "id": 3139280,
      "text": "Và vào một ngày như hôm nay,",
      "author": "ChatGPT4.1"
    },
    "77965": {
      "id": 3139281,
      "text": "một chút giải tỏa khỏi áp lực của các tình huống khẩn cấp ngoài đời thực, thì điều đó... thật vô giá.",
      "author": "ChatGPT4.1"
    }
  }
}
