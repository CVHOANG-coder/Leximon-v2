  "translations": {
    "79778": {
      "id": 2485877,
      "text": "Ben Melham hiện là người giữ kỷ lục Guinness thế giới về số lượng bảo tàng được tham quan nhiều nhất trong 24 giờ, nhưng...",
      "author": "ChatGPT4.1"
    },
    "79779": {
      "id": 2485878,
      "text": "người Anh này chỉ cần một nửa thời gian đó, phá vỡ kỷ lục với 42 bảo tàng ở London chỉ trong 12 giờ.",
      "author": "ChatGPT4.1"
    },
    "79780": {
      "id": 2485879,
      "text": "Anh ấy nói rằng việc đọc về kỷ lục thế giới cùng các con đã truyền cảm hứng cho anh.",
      "author": "ChatGPT4.1"
    },
    "79781": {
      "id": 2485880,
      "text": "Khi các con thách thức anh thực hiện nó, thì đó trở thành một thỏa thuận chắc chắn.",
      "author": "ChatGPT4.1"
    },
    "79782": {
      "id": 2485881,
      "text": "Và anh ấy vẫn chưa dừng lại.",
      "author": "ChatGPT4.1"
    },
    "79783": {
      "id": 2485882,
      "text": "Hiện tại anh đang cố gắng phá kỷ lục thế giới về số lượng bảo tàng được tham quan nhiều nhất trong một năm.",
      "author": "ChatGPT4.1"
    },
    "79784": {
      "id": 2485883,
      "text": "Anh ấy đã có 85 lần tham quan kể từ khi bắt đầu thử thách vào tháng Mười.",
      "author": "ChatGPT4.1"
    }
  }
