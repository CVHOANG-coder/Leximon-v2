  "translations": {
    "74537": {
      "id": 2622959,
      "text": "Loài động vật cao nhất thế giới có thể sớm được thêm vào danh sách các loài bị đe dọa và nguy cấp.",
      "author": "ChatGPT4.1"
    },
    "74538": {
      "id": 2622960,
      "text": "Theo Cơ quan Cá và Động vật Hoang dã Hoa Kỳ, số lượng hươu cao cổ đang giảm nhanh chóng.",
      "author": "ChatGPT4.1"
    },
    "74539": {
      "id": 2622961,
      "text": "Điều này đã xảy ra như thế nào?",
      "author": "ChatGPT4.1"
    },
    "74540": {
      "id": 2622962,
      "text": "Các quan chức động vật hoang dã Hoa Kỳ cho biết nguyên nhân có thể là do mất môi trường sống, đô thị hóa, hạn hán gia tăng,",
      "author": "ChatGPT4.1"
    },
    "74541": {
      "id": 2622963,
      "text": "cũng như săn bắn trái phép - thợ săn giết chúng để lấy các bộ phận trên cơ thể.",
      "author": "ChatGPT4.1"
    },
    "74542": {
      "id": 2622964,
      "text": "Kể từ năm 1985, số lượng ba phân loài hươu cao cổ phía Bắc",
      "author": "ChatGPT4.1"
    },
    "74543": {
      "id": 2622965,
      "text": "đã giảm từ gần 26.000 cá thể xuống còn chưa đến 6.000 cá thể ngày nay.",
      "author": "ChatGPT4.1"
    },
    "74544": {
      "id": 2622966,
      "text": "Đó là mức giảm 77% trong 39 năm qua.",
      "author": "ChatGPT4.1"
    },
    "74545": {
      "id": 2622967,
      "text": "Cơ quan Cá và Động vật Hoang dã Hoa Kỳ đã đề xuất đưa nhiều loài hươu cao cổ vào danh sách các loài nguy cấp hoặc bị đe dọa,",
      "author": "ChatGPT4.1"
    },
    "74546": {
      "id": 2622968,
      "text": "điều này sẽ giúp tăng cường các biện pháp bảo vệ cho chúng theo Đạo luật Các loài có nguy cơ tuyệt chủng.",
      "author": "ChatGPT4.1"
    },
    "74547": {
      "id": 2622969,
      "text": "Nếu đề xuất này được phê duyệt,",
      "author": "ChatGPT4.1"
    },
    "74548": {
      "id": 2622970,
      "text": "đây sẽ là lần đầu tiên hươu cao cổ nhận được những hình thức bảo vệ liên bang như vậy.",
      "author": "ChatGPT4.1"
    }
