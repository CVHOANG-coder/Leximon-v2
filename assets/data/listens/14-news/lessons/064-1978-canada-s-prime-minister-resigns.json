    "76131": {
      "id": 2595317,
      "text": "Justin Trudeau, thủ tướng Canada, đã từ chức.",
      "author": "ChatGPT4.1"
    },
    "76132": {
      "id": 2595318,
      "text": "Vì vậy, tối qua trong bữa tối,",
      "author": "ChatGPT4.1"
    },
    "76133": {
      "id": 2595319,
      "text": "tôi đã nói với các con mình về quyết định mà tôi đang chia sẻ với các bạn hôm nay.",
      "author": "ChatGPT4.1"
    },
    "76134": {
      "id": 2595320,
      "text": "Tôi dự định sẽ từ chức lãnh đạo đảng, từ chức thủ tướng",
      "author": "ChatGPT4.1"
    },
    "76135": {
      "id": 2595321,
      "text": "sau khi đảng chọn ra người lãnh đạo tiếp theo thông qua một quá trình cạnh tranh mạnh mẽ trên toàn quốc.",
      "author": "ChatGPT4.1"
    },
    "76136": {
      "id": 2595322,
      "text": "Người đàn ông 53 tuổi này đã là thủ tướng Canada từ năm 2015",
      "author": "ChatGPT4.1"
    },
    "76137": {
      "id": 2595323,
      "text": "và là lãnh đạo Đảng Tự do từ năm 2013.",
      "author": "ChatGPT4.1"
    },
    "76138": {
      "id": 2595324,
      "text": "Sáng nay, tôi đã thông báo cho toàn quyền rằng chúng ta cần một kỳ họp quốc hội mới.",
      "author": "ChatGPT4.1"
    },
    "76139": {
      "id": 2595325,
      "text": "Cha của Trudeau, ông Pierre Trudeau, từng là thủ tướng từ năm 1968 đến 1979.",
      "author": "ChatGPT4.1"
    },
    "76140": {
      "id": 2595326,
      "text": "Con trai ông đã mang lại sức sống mới cho Đảng Tự do Canada khi tiếp quản hơn một thập kỷ trước.",
      "author": "ChatGPT4.1"
    },
    "76141": {
      "id": 2595327,
      "text": "Nhưng những cuộc thăm dò gần đây cho thấy mức độ ủng hộ ông sụt giảm mạnh.",
      "author": "ChatGPT4.1"
    },
