  "translations": {
    "92747": {
      "id": 5618132,
      "text": "Khoảnh khắc tuyệt vời nhất từ thế giới thể thao mà lại không đến từ một siêu sao.",
      "author": "ChatGPT4.1"
    },
    "92748": {
      "id": 5618133,
      "text": "Tại sân bóng ở Pittsburgh, cầu thủ Jake Mangum của đội Pirates thấy một cô bé mặc áo của mình.",
      "author": "ChatGPT4.1"
    },
    "92749": {
      "id": 5618134,
      "text": "Anh ấy ném quả bóng cho cô bé, nhưng một cậu bé lại bắt lấy.",
      "author": "ChatGPT4.1"
    },
    "92750": {
      "id": 5618135,
      "text": "Đó là anh trai của cô bé.",
      "author": "ChatGPT4.1"
    },
    "92751": {
      "id": 5618136,
      "text": "Không do dự, không nghĩ ngợi, cậu bé đưa quả bóng cho em gái và họ ôm nhau thật chặt.",
      "author": "ChatGPT4.1"
    },
    "92752": {
      "id": 5618137,
      "text": "Chỉ như vậy thôi, tiếng hò reo lớn nhất của đám đông không dành cho trận đấu.",
      "author": "ChatGPT4.1"
    },
    "92753": {
      "id": 5618138,
      "text": "Nó dành cho lòng tốt.",
      "author": "ChatGPT4.1"
    },
    "92754": {
      "id": 5618139,
      "text": "Kỷ niệm đã được lưu giữ, ký ức đã được tạo nên.",
      "author": "ChatGPT4.1"
    },
    "92755": {
      "id": 5618140,
      "text": "Trong một thế giới đôi khi khá nặng nề, những khoảnh khắc như thế này nhắc nhở chúng ta rằng vẫn còn rất nhiều điều tươi sáng ngoài kia.",
      "author": "ChatGPT4.1"
    },
    "92756": {
      "id": 5618141,
      "text": "Thật ấm lòng!",
      "author": "ChatGPT4.1"
    }
  }
