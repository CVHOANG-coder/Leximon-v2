  "translations": {
    "76116": {
      "id": 2652725,
      "text": "Đi đi Poppy, đi nào!",
      "author": "ChatGPT4.1"
    },
    "76117": {
      "id": 2652726,
      "text": "Đây là lần bơi đầu tiên của em bé sở thú này.",
      "author": "ChatGPT4.1"
    },
    "76118": {
      "id": 2652727,
      "text": "Poppy là một con hà mã lùn con sống tại Sở thú Metro Richmond ở Virginia.",
      "author": "ChatGPT4.1"
    },
    "76119": {
      "id": 2652728,
      "text": "Cô bé chưa sống ở đó lâu.",
      "author": "ChatGPT4.1"
    },
    "76120": {
      "id": 2652729,
      "text": "Em bé vừa mới chào đời bởi mẹ Iris và bố Corwin vào ngày 9 tháng 12 năm 2024.",
      "author": "ChatGPT4.1"
    },
    "76121": {
      "id": 2652730,
      "text": "Tên dễ thương của cô bé vừa được sở thú thông báo tuần này, được chọn sau khi thắng một cuộc bình chọn của khách tham quan.",
      "author": "ChatGPT4.1"
    },
    "76122": {
      "id": 2652731,
      "text": "Có vẻ rất hợp với cô bé!",
      "author": "ChatGPT4.1"
    },
    "76123": {
      "id": 2652732,
      "text": "Poppy là thành viên của một “câu lạc bộ” rất đặc biệt.",
      "author": "ChatGPT4.1"
    },
    "76124": {
      "id": 2652733,
      "text": "Có nguồn gốc từ Tây Phi, hà mã lùn đang bị đe dọa tuyệt chủng.",
      "author": "ChatGPT4.1"
    },
    "76125": {
      "id": 2652734,
      "text": "Người ta cho rằng có ít hơn 2.500 cá thể còn sống trong tự nhiên.",
      "author": "ChatGPT4.1"
    },
    "76126": {
      "id": 2652735,
      "text": "Thành viên nổi tiếng nhất của loài này có thể là Mudang,",
      "author": "ChatGPT4.1"
    },
    "76127": {
      "id": 2652736,
      "text": "một con non đã trở thành hiện tượng trên mạng xã hội tại một sở thú ở Thái Lan.",
      "author": "ChatGPT4.1"
    },
    "76128": {
      "id": 2652737,
      "text": "Thời gian sẽ trả lời liệu Poppy có nổi tiếng như thế hay không.",
      "author": "ChatGPT4.1"
    },
    "76129": {
      "id": 2652738,
      "text": "Hiện tại, cô bé vẫn đang học những điều cơ bản, như cách “làm một chú hà mã” thực thụ.",
      "author": "ChatGPT4.1"
    },
    "76130": {
      "id": 2652739,
      "text": "Để giúp cô bé bơi, sở thú đã hạ mực nước trong khu vực sống của cô bé và đang dần tăng lên khi cô ấy cảm thấy thoải mái hơn.",
      "author": "ChatGPT4.1"
    }
  }
}
