  "translations": {
    "84616": {
      "id": 3070825,
      "text": "Một trong những núi lửa hoạt động mạnh nhất thế giới lại đang phun trào lần nữa,",
      "author": "ChatGPT4.1"
    },
    "84617": {
      "id": 3070826,
      "text": "nhưng lần này nó đang đạt đến những độ cao mới.",
      "author": "ChatGPT4.1"
    },
    "84618": {
      "id": 3070827,
      "text": "Núi lửa Kilauea ở Hawaii đang phun trào dung nham lên tới 650 feet trên không trung.",
      "author": "ChatGPT4.1"
    },
    "84619": {
      "id": 3070828,
      "text": "Cơ quan Khảo sát Địa chất Hoa Kỳ cho biết đây là lần phun trào thứ 18 của Kilauea",
      "author": "ChatGPT4.1"
    },
    "84620": {
      "id": 3070829,
      "text": "kể từ khi nó hoạt động trở lại vào tháng 12 năm ngoái.",
      "author": "ChatGPT4.1"
    },
    "84621": {
      "id": 3070830,
      "text": "Tin tốt là dung nham không còn là mối nguy hiểm đối với người Hawaii sống gần đó.",
      "author": "ChatGPT4.1"
    },
    "84622": {
      "id": 3070831,
      "text": "Và vùng hoạt động của núi lửa vẫn nằm trong công viên quốc gia, là đất được bảo vệ.",
      "author": "ChatGPT4.1"
    },
    "84623": {
      "id": 3070832,
      "text": "Nhưng tin xấu cho du khách thích xem dung nham:",
      "author": "ChatGPT4.1"
    },
    "84624": {
      "id": 3070833,
      "text": "Mức độ cao của khí sulfur dioxide đã được phát hiện cùng với các mảnh thủy tinh núi lửa có thể trôi nổi trong không khí.",
      "author": "ChatGPT4.1"
    }
  }
