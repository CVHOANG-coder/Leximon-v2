  "translations": {
    "80191": {
      "id": 2609233,
      "text": "Các nhà tổ chức muốn biến môn này thành môn thể thao Olympic tiếp theo.",
      "author": "ChatGPT4.1"
    },
    "80192": {
      "id": 2609234,
      "text": "Thật vậy, tại tỉnh Niigata, Nhật Bản, trò ném bóng tuyết cổ điển được coi trọng một cách nghiêm túc.",
      "author": "ChatGPT4.1"
    },
    "80193": {
      "id": 2609235,
      "text": "Nghiêm túc đến mức, môn thể thao mùa lạnh này đã trở thành một sự kiện thường niên.",
      "author": "ChatGPT4.1"
    },
    "80194": {
      "id": 2609236,
      "text": "Các đối thủ dành cả năm để rèn luyện sức mạnh phần thân trên chuẩn bị cho trận chiến lạnh giá này.",
      "author": "ChatGPT4.1"
    },
    "80195": {
      "id": 2609237,
      "text": "Luật chơi rất đơn giản.",
      "author": "ChatGPT4.1"
    },
    "80196": {
      "id": 2609238,
      "text": "Hai đội có 2 phút để ném bóng tuyết vào nhau.",
      "author": "ChatGPT4.1"
    },
    "80197": {
      "id": 2609239,
      "text": "Người chơi sẽ bị loại nếu bị bóng tuyết trúng.",
      "author": "ChatGPT4.1"
    },
    "80198": {
      "id": 2609240,
      "text": "Và đội còn nhiều thành viên trụ lại nhất sau 2 phút sẽ chiến thắng.",
      "author": "ChatGPT4.1"
    },
    "80199": {
      "id": 2609241,
      "text": "Một số người cho rằng trò chơi này khiến mọi người sống lại tuổi thơ.",
      "author": "ChatGPT4.1"
    },
    "80200": {
      "id": 2609242,
      "text": "Ném bóng tuyết vốn dĩ chỉ là một trò chơi,",
      "author": "ChatGPT4.1"
    },
    "80201": {
      "id": 2609243,
      "text": "nên tôi thích việc khi biến nó thành môn thi đấu,",
      "author": "ChatGPT4.1"
    },
    "80202": {
      "id": 2609244,
      "text": "nó trở thành một môn thể thao kịch tính mà bạn có thể tận hưởng.",
      "author": "ChatGPT4.1"
    },
    "80203": {
      "id": 2609245,
      "text": "Sự kiện này bắt đầu với 120 đội",
      "author": "ChatGPT4.1"
    },
    "80204": {
      "id": 2609246,
      "text": "và dần chọn ra nhà vô địch cuối cùng.",
      "author": "ChatGPT4.1"
    },
    "80205": {
      "id": 2609247,
      "text": "Ủy ban Olympic vẫn chưa công nhận ném bóng tuyết là một môn thể thao chính thức.",
      "author": "ChatGPT4.1"
    },
    "80206": {
      "id": 2609248,
      "text": "Nhưng họ đã công nhận môn nhảy break dance,",
      "author": "ChatGPT4.1"
    },
    "80207": {
      "id": 2609249,
      "text": "vì thế những người yêu thích môn ném bóng tuyết vẫn còn hy vọng.",
      "author": "ChatGPT4.1"
    }
  }
