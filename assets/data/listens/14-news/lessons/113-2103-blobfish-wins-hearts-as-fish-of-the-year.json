  "translations": {
    "83114": {
      "id": 2727149,
      "text": "Mọi người đã hoàn toàn chuộc lại lỗi lầm của mình sau khi làm đẹp cho một chú cá tội nghiệp.",
      "author": "ChatGPT4.1"
    },
    "83115": {
      "id": 2727150,
      "text": "Hóa ra, khi cá blob gelatinous được tuyên bố là động vật xấu nhất thế giới vào năm 2013. Ôi đau!",
      "author": "ChatGPT4.1"
    },
    "83116": {
      "id": 2727151,
      "text": "Nó đã không được đối xử công bằng.",
      "author": "ChatGPT4.1"
    },
    "83117": {
      "id": 2727152,
      "text": "Sinh vật biển sâu mà bạn nhìn thấy sống hàng nghìn feet dưới nước,",
      "author": "ChatGPT4.1"
    },
    "83118": {
      "id": 2727153,
      "text": "và nó trông ít phồng hơn rất nhiều dưới đó, nơi mà...",
      "author": "ChatGPT4.1"
    },
    "83119": {
      "id": 2727154,
      "text": "áp lực nước mạnh hơn 100 lần so với áp suất không khí mà chúng ta cảm nhận trên cạn.",
      "author": "ChatGPT4.1"
    },
    "83120": {
      "id": 2727155,
      "text": "Giờ đây, cá blob có một danh hiệu mới: Cá của năm.",
      "author": "ChatGPT4.1"
    },
    "83121": {
      "id": 2727156,
      "text": "Sau khi cử tri ở New Zealand tham gia một cuộc thi nhằm nâng cao nhận thức về đời sống biển của quốc gia này.",
      "author": "ChatGPT4.1"
    },
    "83122": {
      "id": 2727157,
      "text": "Vì vậy, lần tới khi bạn cảm thấy mọi người không thích bạn, hãy kiên nhẫn! Mọi thứ đều có thể.",
      "author": "ChatGPT4.1"
    },
    "83123": {
      "id": 2727158,
      "text": "Tuyệt vời! Chúc mừng nhé, Blob!",
      "author": "ChatGPT4.1"
    }
  }
}
