    "86666": {
      "id": 3054420,
      "text": "Đằng sau tấm kính an ninh này là gì?",
      "author": "ChatGPT4.1"
    },
    "86667": {
      "id": 3054421,
      "text": "Đó là chiếc túi Birkin đầu tiên từng được sản xuất bởi thương hiệu thời trang cao cấp Hermes,",
      "author": "ChatGPT4.1"
    },
    "86668": {
      "id": 3054422,
      "text": "và nó sẽ được đưa ra đấu giá tại Sotheby's vào tháng sau.",
      "author": "ChatGPT4.1"
    },
    "86669": {
      "id": 3054423,
      "text": "Khi chiếc búa đấu giá gõ xuống, nó được dự đoán sẽ là chiếc túi xách đắt nhất thế giới.",
      "author": "ChatGPT4.1"
    },
    "86670": {
      "id": 3054424,
      "text": "Chiếc túi được làm dành riêng cho ngôi sao điện ảnh Pháp Jane Birkin, được nhìn thấy trong bức ảnh này cùng chiếc Birkin của bà.",
      "author": "ChatGPT4.1"
    },
    "86671": {
      "id": 3054425,
      "text": "Vậy làm sao chiếc túi Birkin ra đời?",
      "author": "ChatGPT4.1"
    },
    "86672": {
      "id": 3054426,
      "text": "Chuyện là nữ diễn viên Jane Birkin tình cờ ngồi cạnh giám đốc điều hành Hermes trên một chuyến bay.",
      "author": "ChatGPT4.1"
    },
    "86673": {
      "id": 3054427,
      "text": "Bà đã dùng một chiếc giỏ đan thay cho túi xách, và nó bị hỏng.",
      "author": "ChatGPT4.1"
    },
    "86674": {
      "id": 3054428,
