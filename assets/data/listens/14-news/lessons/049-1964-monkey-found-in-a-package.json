  "translations": {
    "75807": {
      "id": 2612645,
      "text": "Nếu có một hạng ghế du lịch nào tệ hơn cả hạng phổ thông, chú khỉ tội nghiệp này đã phải trải qua nó.",
      "author": "ChatGPT4.1"
    },
    "75808": {
      "id": 2612646,
      "text": "Nhà chức trách Thổ Nhĩ Kỳ cho biết họ đã tìm thấy một chú khỉ rhesus con",
      "author": "ChatGPT4.1"
    },
    "75809": {
      "id": 2612647,
      "text": "trong một cuộc kiểm tra định kỳ tại một bến xe buýt.",
      "author": "ChatGPT4.1"
    },
    "75810": {
      "id": 2612648,
      "text": "Họ nói rằng bưu kiện đã bị bỏ rơi,",
      "author": "ChatGPT4.1"
    },
    "75811": {
      "id": 2612649,
      "text": "nên các nhân viên đã cho nó đi qua máy quét X-quang.",
      "author": "ChatGPT4.1"
    },
    "75812": {
      "id": 2612650,
      "text": "Phát hiện có chuyển động nên họ quyết định mở gói hàng ra.",
      "author": "ChatGPT4.1"
    },
    "75813": {
      "id": 2612651,
      "text": "Họ phát hiện chú khỉ nhỏ này đã bị nhốt trong một thùng gỗ có khoét lỗ thông hơi.",
      "author": "ChatGPT4.1"
    },
    "75814": {
      "id": 2612652,
      "text": "Biết rằng đó không phải là cách vận chuyển động vật, các nhân viên bảo vệ động vật hoang dã đã tịch thu nó và đưa đến một công viên động vật.",
      "author": "ChatGPT4.1"
    },
    "75815": {
      "id": 2612653,
      "text": "Chú đã được kiểm tra sức khỏe toàn diện để đảm bảo không bị thương tổn gì.",
      "author": "ChatGPT4.1"
    },
    "75816": {
      "id": 2612654,
      "text": "Chú khỉ sau đó đã được chuyển đến nơi ở tốt hơn nhiều.",
      "author": "ChatGPT4.1"
    },
    "75817": {
      "id": 2612655,
      "text": "Theo báo cáo, một người đàn ông đã xuất hiện để nhận bưu kiện,",
      "author": "ChatGPT4.1"
    },
    "75818": {
      "id": 2612656,
      "text": "nhưng thay vào đó, ông ta đã bị báo cáo cho nhà chức trách vì sở hữu loài động vật bị cấm.",
      "author": "ChatGPT4.1"
    }
  }
}
