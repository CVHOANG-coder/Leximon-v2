  "translations": {
    "74729": {
      "id": 2687396,
      "text": "Đây không phải là những chiếc thuyền bình thường.",
      "author": "ChatGPT4.1"
    },
    "74730": {
      "id": 2687397,
      "text": "Thực ra, chúng là những quả bí ngô khổng lồ đã được khoét rỗng.",
      "author": "ChatGPT4.1"
    },
    "74731": {
      "id": 2687398,
      "text": "Theo Reuters, lễ hội đua thuyền bí ngô thường niên ở Bỉ năm nay đã thu hút hơn 300 người tham gia.",
      "author": "ChatGPT4.1"
    },
    "74732": {
      "id": 2687399,
      "text": "Cuộc đua bắt đầu vào năm 2008 như một cách sáng tạo để những người trồng địa phương tận dụng các quả bí ngô quá khổ.",
      "author": "ChatGPT4.1"
    },
    "74733": {
      "id": 2687400,
      "text": "Sau cuộc đua, những quả bí ngô được biến thành phân bón cho các vụ mùa tiếp theo,",
      "author": "ChatGPT4.1"
    },
    "74734": {
      "id": 2687401,
      "text": "và hạt giống được lưu trữ cho năm sau.",
      "author": "ChatGPT4.1"
    }
  }
