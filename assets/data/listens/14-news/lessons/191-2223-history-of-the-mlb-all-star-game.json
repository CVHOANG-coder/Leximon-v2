  "translations": {
    "87975": {
      "id": 3427968,
      "text": "Chào các siêu sao! Tôi là Coy Wire, hôm nay là thứ Sáu, ngày 18 tháng Bảy... Hãy đứng dậy!",
      "author": "ChatGPT4.1"
    },
    "87976": {
      "id": 3427969,
      "text": "Ấn bản mùa hè đặc biệt tuần này của CNN 10 được gửi tới bạn từ công viên tuyệt vời nhất ở Hạt Cobb, tiểu bang Georgia -",
      "author": "ChatGPT4.1"
    },
    "87977": {
      "id": 3427970,
      "text": "nơi đây là sân nhà của đội Atlanta Braves và tuần này cũng là nơi tổ chức trận MLB All-Star.",
      "author": "ChatGPT4.1"
    },
    "87978": {
      "id": 3427971,
      "text": "Chuẩn bị đánh bóng nào! Hãy bắt đầu chương trình hôm nay bằng một chuyên mục... \"Bạn Có Biết Không?\"",
      "author": "ChatGPT4.1"
    },
    "87979": {
      "id": 3427972,
      "text": "Trận đấu MLB All-Star, lần đầu tiên được tổ chức vào tháng 7 năm 1933, ban đầu dự định chỉ tổ chức một lần (với tên gọi) \"Trận đấu của Thế kỷ.\"",
      "author": "a user"
    },
    "87980": {
      "id": 3427973,
      "text": "Ý tưởng này nhằm nâng cao tinh thần quốc gia trong thời kỳ Đại Suy Thoái khi người dân không còn mua vé xem các trận đấu,",
      "author": "ChatGPT4.1"
    },
    "87981": {
      "id": 3427974,
      "text": "và các đội bóng phải cắt giảm chi phí.",
      "author": "ChatGPT4.1"
    },
    "87982": {
      "id": 3427975,
      "text": "Đó là ý tưởng của một biên tập viên thể thao của tờ báo Chicago Tribune.",
      "author": "ChatGPT4.1"
    },
    "87983": {
      "id": 3427976,
      "text": "Chuyện kể rằng, biên tập viên này đã nói với sếp rằng ông tự tin trận đấu sẽ thành công đến mức sẵn sàng lấy tiền lương của mình để bù lỗ nếu thất bại.",
      "author": "ChatGPT4.1"
    },
    "87984": {
      "id": 3427977,
      "text": "Và ông ấy đã không sai.",
      "author": "ChatGPT4.1"
    },
    "87985": {
      "id": 3427978,
      "text": "Trận đấu MLB All-Star giờ đây đã trở thành một phần không thể thiếu và rất được yêu thích của mùa giải bóng chày Mỹ.",
      "author": "ChatGPT4.1"
    }
  }
}
