  "translations": {
    "86256": {
      "id": 2514818,
      "text": "Người mẹ này cảm thấy cực kỳ may mắn.",
      "author": "ChatGPT4.1"
    },
    "86257": {
      "id": 2514819,
      "text": "Con gái nhỏ của cô ấy vẫn sống sót sau khi bị một con rắn đuôi chuông độc cắn hai lần.",
      "author": "ChatGPT4.1"
    },
    "86258": {
      "id": 2514820,
      "text": "\"Tôi nhìn vào bàn chân con bé và thấy có bốn vết thủng đặc trưng đang chảy máu.\"",
      "author": "a user"
    },
    "86259": {
      "id": 2514821,
      "text": "\"Mắt con bé trợn ngược về phía sau đầu.\"",
      "author": "a user"
    },
    "86260": {
      "id": 2514822,
      "text": "Chuyện đó xảy ra ở sân sau nhà họ tại Florence, Arizona.",
      "author": "ChatGPT4.1"
    },
    "86261": {
      "id": 2514823,
      "text": "Chân con bé đã chuyển sang màu đen và bé bắt đầu mất ý thức, và nôn mửa.",
      "author": "a user"
    },
    "86262": {
      "id": 2514824,
      "text": "Mẹ Jacqueline Reed biết cô phải đưa Cara đến phòng cấp cứu gần nhất thật nhanh.",
      "author": "ChatGPT4.1"
    },
    "86263": {
      "id": 2514825,
      "text": "Mẹ là y tá nhi khoa và cô hiểu rằng từng giây đều quan trọng.",
      "author": "ChatGPT4.1"
    },
    "86264": {
      "id": 2514826,
      "text": "Cô phải đến một bệnh viện có sẵn thuốc kháng nọc rắn.",
      "author": "ChatGPT4.1"
    },
    "86265": {
      "id": 2514827,
      "text": "Cô nói kinh nghiệm chuyên môn đã giúp cô bình tĩnh.",
      "author": "ChatGPT4.1"
    },
    "86266": {
      "id": 2514828,
      "text": "Tổng cộng, Cara đã phải được tiêm 20 ống thuốc kháng nọc.",
      "author": "ChatGPT4.1"
    },
    "86267": {
      "id": 2514829,
      "text": "Em bé 15 tháng tuổi cũng phải được đặt máy thở.",
      "author": "ChatGPT4.1"
    },
    "86268": {
      "id": 2514830,
      "text": "\"Tôi thực sự rất sợ hãi, nhưng tôi kiên quyết phải hành động và làm tất cả những gì có thể.\"",
      "author": "ChatGPT4.1"
    },
    "86269": {
      "id": 2514831,
      "text": "\"Tốt quá cho bạn.\"",
      "author": "ChatGPT4.1"
    },
    "86270": {
      "id": 2514832,
      "text": "\"May mắn thay, cô bé có một người mẹ biết chính xác phải làm gì và hành động ngay lập tức.\"",
      "author": "ChatGPT4.1"
    }
  }
}
