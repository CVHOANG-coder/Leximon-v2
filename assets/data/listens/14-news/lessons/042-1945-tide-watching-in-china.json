  "translations": {
    "74977": {
      "id": 2659592,
      "text": "Đây là hiện tượng thủy triều \"Rồng Bạc\" trên sông Tiền Đường ở Trung Quốc.",
      "author": "ChatGPT4.1"
    },
    "74978": {
      "id": 2659593,
      "text": "Một đợt triều dâng xảy ra khi dòng đầu tiên của thủy triều tạo ra một con sóng tràn lên sông.",
      "author": "ChatGPT4.1"
    },
    "74979": {
      "id": 2659594,
      "text": "Quan sát thủy triều là một truyền thống của người Trung Quốc trong dịp Tết Trung Thu, diễn ra vào đêm trăng tròn.",
      "author": "ChatGPT4.1"
    },
    "74980": {
      "id": 2659595,
      "text": "Thủy triều năm nay cao hơn thường lệ sau khi cơn bão Bebinka vừa qua -",
      "author": "ChatGPT4.1"
    },
    "74981": {
      "id": 2659596,
      "text": "Theo truyền thông nhà nước, đây là cơn bão mạnh nhất đổ bộ Thượng Hải trong 75 năm qua.",
      "author": "ChatGPT4.1"
    }
  }
