  "translations": {
    "89359": {
      "id": 3569523,
      "text": "Hôm nay đánh dấu một cột mốc u buồn cho một khoảnh khắc đã thay đổi thế giới mãi mãi.",
      "author": "ChatGPT4.1"
    },
    "89360": {
      "id": 3569524,
      "text": "Chính xác 80 năm trước vào ngày hôm nay, ngày 6 tháng 8 năm 1945,",
      "author": "ChatGPT4.1"
    },
    "89361": {
      "id": 3569525,
      "text": "một quả bom nguyên tử đã được sử dụng lần đầu tiên trong chiến tranh.",
      "author": "ChatGPT4.1"
    },
    "89362": {
      "id": 3569526,
      "text": "Mỹ đã thả một quả bom nguyên tử xuống thành phố cảng Hiroshima, Nhật Bản.",
      "author": "ChatGPT4.1"
    },
    "89363": {
      "id": 3569527,
      "text": "70.000 người đã thiệt mạng ngay lập tức.",
      "author": "ChatGPT4.1"
    },
    "89364": {
      "id": 3569528,
      "text": "\"Thế giới sẽ ghi nhận rằng quả bom nguyên tử đầu tiên đã được thả xuống Hiroshima.\"",
      "author": "ChatGPT4.1"
    },
    "89365": {
      "id": 3569529,
      "text": "Chỉ vài ngày sau, quả bom nguyên tử thứ hai đã được thả xuống thành phố Nagasaki,",
      "author": "ChatGPT4.1"
    },
    "89366": {
      "id": 3569530,
      "text": "giết chết thêm hơn 40.000 người nữa.",
      "author": "ChatGPT4.1"
    },
    "89367": {
      "id": 3569531,
      "text": "Những vụ ném bom này đã khiến Nhật Bản đầu hàng vô điều kiện, chính thức kết thúc Thế chiến thứ hai.",
      "author": "ChatGPT4.1"
    },
    "89368": {
      "id": 3569532,
      "text": "Nhưng chúng cũng mở đầu cho Chiến tranh Lạnh, một chương đau buồn khác trong lịch sử thế giới.",
      "author": "ChatGPT4.1"
    },
    "89369": {
      "id": 3569533,
      "text": "Tới ngày nay, đây vẫn là lần duy nhất một quốc gia từng sử dụng bom nguyên tử trong chiến tranh.",
      "author": "ChatGPT4.1"
    },
    "89370": {
      "id": 3569534,
      "text": "Ước tính tổng cộng số người chết chỉ riêng ở Hiroshima đã vượt quá 200.000 người,",
      "author": "ChatGPT4.1"
    },
    "89371": {
      "id": 3569535,
      "text": "bao gồm cả những cái chết do nhiễm phóng xạ hoặc các tác động lâu dài như ung thư.",
      "author": "ChatGPT4.1"
    },
    "89372": {
      "id": 3569536,
      "text": "Ngày nay, Công viên Tưởng niệm Hòa bình Hiroshima nằm trên khu vực trung tâm thương mại sầm uất,",
      "author": "ChatGPT4.1"
    },
    "89373": {
      "id": 3569537,
      "text": "là nơi tưởng niệm các nạn nhân và là lời nhắc nhở rõ ràng về sức mạnh hủy diệt lớn nhất từng được con người tạo ra.",
      "author": "ChatGPT4.1"
    }
  }
}
