  "translations": {
    "89374": {
      "id": 3563887,
      "text": "Chúng ta bắt đầu tại Flint, Michigan, nơi Cơ quan Bảo vệ Môi trường cho biết nước ở đây cuối cùng cũng đã an toàn sau hơn một thập kỷ kể từ khi cuộc khủng hoảng nước lịch sử của thành phố bắt đầu.",
      "author": "ChatGPT4.1"
    },
    "89375": {
      "id": 3563888,
      "text": "Tuy nhiên, về phía cư dân, họ không đồng ý và nói rằng họ vẫn đang phải đối mặt với nguồn nước bị ô nhiễm và các vấn đề sức khỏe lâu dài.",
      "author": "ChatGPT4.1"
    },
    "89376": {
      "id": 3563889,
      "text": "Hãy tưởng tượng việc không thể uống nước từ vòi hoặc tắm ở chính ngôi nhà của bạn mà không có nguy cơ về sức khỏe.",
      "author": "ChatGPT4.1"
    },
    "89377": {
      "id": 3563890,
      "text": "Vào năm 2014, người dân nhận thấy nước có sự thay đổi về màu sắc, mùi và vị sau khi các quan chức chuyển nguồn cung cấp nước thành phố sang sông Flint.",
      "author": "ChatGPT4.1"
    },
    "89378": {
      "id": 3563891,
      "text": "Các cuộc kiểm tra cho thấy việc chuyển đổi đó đã ăn mòn các ống chì cũ của thành phố, khiến người dân tiếp xúc với mức chì nguy hiểm.",
      "author": "ChatGPT4.1"
    },
    "89379": {
      "id": 3563892,
      "text": "Việc tiếp xúc với chì có liên quan đến các vấn đề chậm phát triển ở trẻ em, các vấn đề về ngôn ngữ và hành vi, thậm chí là tổn thương não.",
      "author": "ChatGPT4.1"
    },
    "89380": {
      "id": 3563893,
      "text": "Những người quyết định ở lại Flint đã phải sống thiếu nước sạch trong nhiều năm,",
      "author": "ChatGPT4.1"
    },
    "89381": {
      "id": 3563894,
      "text": "chịu đựng các vấn đề sức khỏe từ động kinh đến bệnh Legionnaire,",
      "author": "ChatGPT4.1"
    },
    "89382": {
      "id": 3563895,
      "text": "(một loại viêm phổi nặng do uống nước bị ô nhiễm gây ra).",
      "author": "ChatGPT4.1"
    }
  }
