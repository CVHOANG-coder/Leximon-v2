  "translations": {
    "79764": {
      "id": 2837378,
      "text": "Núi lửa Kilauea là một trong những núi lửa hoạt động mạnh nhất thế giới,",
      "author": "ChatGPT4.1"
    },
    "79765": {
      "id": 2837379,
      "text": "và hiện đang trong giai đoạn phun trào bắt đầu từ ngày 23 tháng 12.",
      "author": "ChatGPT4.1"
    },
    "79766": {
      "id": 2837380,
      "text": "Đợt phun trào hiện tại đã trải qua bảy giai đoạn hoạt động, với các quãng nghỉ xen kẽ giữa mỗi giai đoạn.",
      "author": "ChatGPT4.1"
    },
    "79767": {
      "id": 2837381,
      "text": "Nhưng tại sao nó lại hoạt động mạnh như vậy?",
      "author": "ChatGPT4.1"
    },
    "79768": {
      "id": 2837382,
      "text": "Các đảo Hawaii được hình thành bởi một điểm nóng núi lửa, và Kilauea nằm ngay trên điểm nóng đó,",
      "author": "ChatGPT4.1"
    },
    "79769": {
      "id": 2837383,
      "text": "điểm này có nguồn cung cấp dung nham lớn và bơm dung nham từ lớp phủ của Trái Đất.",
      "author": "ChatGPT4.1"
    },
    "79770": {
      "id": 2837384,
      "text": "Điều này gây ra các đợt phun trào thường xuyên và lý giải tại sao núi lửa này có các đợt phun trào theo chu kỳ.",
      "author": "ChatGPT4.1"
    },
    "79771": {
      "id": 2837385,
      "text": "Các nhà khoa học cảnh báo rằng lượng khí núi lửa cao đang được giải phóng từ núi lửa,",
      "author": "ChatGPT4.1"
    },
    "79772": {
      "id": 2837386,
      "text": "và đang gây lo ngại cho người dân sống ở khu vực hướng gió.",
      "author": "ChatGPT4.1"
    },
    "79773": {
      "id": 2837387,
      "text": "Các khí như sulfur dioxide có thể phản ứng với khí quyển và tạo ra thứ được gọi là “vog,”",
      "author": "ChatGPT4.1"
    },
    "79774": {
      "id": 2837388,
      "text": "một loại ô nhiễm không khí mờ đục có thể gây kích ứng da và ảnh hưởng đến hô hấp.",
      "author": "ChatGPT4.1"
    },
    "79775": {
      "id": 2837389,
      "text": "Chỉ khi núi lửa hoạt động, lượng khí thải mới tăng lên.",
      "author": "ChatGPT4.1"
    },
    "79776": {
      "id": 2837390,
      "text": "Đợt phun trào này sẽ dừng lại khi dung nham có đủ thời gian để nguội đi trong miệng phun,",
      "author": "ChatGPT4.1"
    },
    "79777": {
      "id": 2837391,
      "text": "nên nó sẽ không thể bùng phát trở lại.",
      "author": "ChatGPT4.1"
    }
  }
}
