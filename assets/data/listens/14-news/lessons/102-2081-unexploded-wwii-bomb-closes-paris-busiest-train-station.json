  "translations": {
    "82095": {
      "id": 3017535,
      "text": "Một quả bom chưa nổ từ Thế chiến II đã làm ngưng dịch vụ tàu hỏa xuất phát từ Paris, Pháp.",
      "author": "ChatGPT4.1"
    },
    "82096": {
      "id": 3017536,
      "text": "Các công nhân xây dựng làm ca đêm đã phát hiện vũ khí này vào khoảng 3 giờ 30 sáng.",
      "author": "ChatGPT4.1"
    },
    "82097": {
      "id": 3017537,
      "text": "Quả bom được tìm thấy gần đường ray xe lửa ở vùng ngoại ô Saint-Denis của Paris,",
      "author": "ChatGPT4.1"
    },
    "82098": {
      "id": 3017538,
      "text": "cách Gare du Nord khoảng một dặm rưỡi.",
      "author": "ChatGPT4.1"
    },
    "82099": {
      "id": 3017539,
      "text": "Hơn 210 triệu người đi qua Gare du Nord mỗi năm,",
      "author": "ChatGPT4.1"
    },
    "82100": {
      "id": 3017540,
      "text": "khiến đây trở thành nhà ga xe lửa bận rộn nhất châu Âu.",
      "author": "ChatGPT4.1"
    },
    "82101": {
      "id": 3017541,
      "text": "Nhà chức trách ước tính quả bom có tuổi đời hàng thập kỷ này nặng khoảng 1.100 pound",
      "author": "ChatGPT4.1"
    },
    "82102": {
      "id": 3017542,
      "text": "và có khả năng là của Mỹ hoặc Anh.",
      "author": "ChatGPT4.1"
    },
    "82103": {
      "id": 3017543,
      "text": "Trong Thế chiến II, các tuyến đường sắt Pháp bị quân Đức chiếm đóng đã bị đánh bom nặng nề,",
      "author": "ChatGPT4.1"
    },
    "82104": {
      "id": 3017544,
      "text": "đặc biệt là ở phía bắc Paris, nơi có nhiều nhà máy đặt trụ sở.",
      "author": "ChatGPT4.1"
    },
    "82106": {
      "id": 3017546,
      "text": "Ý tôi là, tôi nghĩ tốt hơn là họ đã tìm ra nó chứ không phải để nó không được phát hiện rồi có chuyện gì đó xảy ra.",
      "author": "ChatGPT4.1"
    },
    "82107": {
      "id": 3017547,
      "text": "Việc ngừng di chuyển rời khỏi Paris có ảnh hưởng ở tầm quốc tế.",
      "author": "ChatGPT4.1"
    },
    "82108": {
      "id": 3017548,
      "text": "Hành khách ở London, Brussels và Amsterdam đều bị ảnh hưởng.",
      "author": "ChatGPT4.1"
    },
    "82109": {
