  "translations": {
    "79785": {
      "id": 3287696,
      "text": "Khách tham quan và nhân viên tại Sở thú Knoxville đang thương tiếc sự ra đi của con tê giác già nhất Hoa Kỳ.",
      "author": "ChatGPT4.1"
    },
    "79786": {
      "id": 3287697,
      "text": "Dolly là một con tê giác trắng phương Nam đã sống hàng thập kỷ tại sở thú Tennessee.",
      "author": "ChatGPT4.1"
    },
    "79787": {
      "id": 3287698,
      "text": "Theo Hiệp hội Sở thú và Thủy cung,",
      "author": "ChatGPT4.1"
    },
    "79788": {
      "id": 3287699,
      "text": "đa số tê giác trắng phương Nam sống khoảng 36 năm rưỡi.",
      "author": "ChatGPT4.1"
    },
    "79789": {
      "id": 3287700,
      "text": "Chúng tôi đã chăm sóc Dolly, một con tê giác trắng phương Nam, tại sở thú này khoảng 50 năm,",
      "author": "ChatGPT4.1"
    },
    "79790": {
      "id": 3287701,
      "text": "ờ... thật ra là một trong những con tê giác được con người chăm sóc già nhất trên thế giới.",
      "author": "ChatGPT4.1"
    },
    "79791": {
      "id": 3287702,
      "text": "Và giống như tất cả các động vật của chúng tôi, và cả con người nữa, chúng đều già đi.",
      "author": "ChatGPT4.1"
    },
    "79792": {
      "id": 3287703,
      "text": "Và khi chúng già đi, chúng gặp phải nhiều vấn đề, giống như chúng ta vậy.",
      "author": "ChatGPT4.1"
    },
    "79793": {
      "id": 3287704,
      "text": "Chúng tôi phải đưa ra những quyết định về chất lượng cuộc sống cho các động vật này.",
      "author": "ChatGPT4.1"
    },
    "79794": {
      "id": 3287705,
      "text": "Phần lớn thời gian, bạn biết đó, chúng được chăm sóc thú y hoàn hảo.",
      "author": "ChatGPT4.1"
    },
    "79795": {
      "id": 3287706,
      "text": "Chúng được người chăm sóc chăm chút kỹ càng, chế độ dinh dưỡng tốt.",
      "author": "ChatGPT4.1"
    },
    "79796": {
      "id": 3287707,
      "text": "Vì thế, chúng sống rất lâu dưới sự chăm sóc của con người.",
      "author": "ChatGPT4.1"
    },
    "79797": {
      "id": 3287708,
      "text": "Các chuyên gia từ Trường Thú y Đại học Tennessee",
      "author": "ChatGPT4.1"
    },
    "79798": {
      "id": 3287709,
      "text": "và đội ngũ thú y sở thú của Dolly đã đưa ra quyết định khó khăn là an tử cho cô ấy.",
      "author": "ChatGPT4.1"
    },
    "79799": {
      "id": 3287710,
      "text": "Khi những động vật này bắt đầu già đi, chúng tôi tiến hành đánh giá trọng tâm, đánh giá chất lượng cuộc sống cho chúng và...",
      "author": "ChatGPT4.1"
    },
    "79800": {
      "id": 3287711,
      "text": "Xem xét năm hoặc sáu chỉ số khác nhau để xác định chất lượng cuộc sống, để có thể đo lường và định lượng được.",
      "author": "ChatGPT4.1"
    },
    "79801": {
      "id": 3287712,
      "text": "Khi đến lúc chúng tôi cảm thấy cần đưa ra quyết định an tử nhân đạo cho chúng.",
      "author": "ChatGPT4.1"
    },
    "79802": {
      "id": 3287713,
      "text": "Chúng tôi đã đi đến quyết định đó như một đội ngũ.",
      "author": "ChatGPT4.1"
    },
    "79803": {
      "id": 3287714,
      "text": "Chúng tôi đã cùng các nhân viên chăm sóc và các bác sĩ thú y, tất cả cùng ngồi lại, bàn về các chỉ số đánh giá,",
      "author": "ChatGPT4.1"
    },
    "79804": {
      "id": 3287715,
      "text": "và đảm bảo rằng đây là thời điểm thích hợp.",
      "author": "ChatGPT4.1"
    },
    "79805": {
      "id": 3287716,
      "text": "Bởi vì đây không phải là việc bạn muốn làm quá sớm, nhưng cũng rất quan trọng là không được làm quá muộn.",
      "author": "ChatGPT4.1"
    },
    "79806": {
      "id": 3287717,
      "text": "Chấm dứt nỗi đau cho Dolly là điều nhân đạo nên làm,",
      "author": "ChatGPT4.1"
    },
    "79807": {
      "id": 3287718,
      "text": "nhưng mất đi một cư dân được yêu quý tại Sở thú Knoxville thật sự rất khó khăn.",
      "author": "ChatGPT4.1"
    },
    "79808": {
      "id": 3287719,
      "text": "Đây thực sự là một thời điểm nhiều cảm xúc. Một thời điểm khó khăn. Và là thời điểm cần thiết.",
      "author": "ChatGPT4.1"
    },
    "79809": {
      "id": 3287720,
      "text": "Khách tham quan của chúng tôi đều gắn bó với cô ấy.",
      "author": "ChatGPT4.1"
    },
    "79810": {
