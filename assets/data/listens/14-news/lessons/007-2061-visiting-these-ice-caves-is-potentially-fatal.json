  "translations": {
    "81226": {
      "id": 2685385,
      "text": "Những người leo núi đang đổ xô đến Thụy Sĩ để xem những hang động băng chỉ tồn tại trong một thời gian ngắn.",
      "author": "ChatGPT4.1"
    },
    "81227": {
      "id": 2685386,
      "text": "Đừng bận tâm rằng chúng cực kỳ nguy hiểm và có thể gây chết người.",
      "author": "ChatGPT4.1"
    },
    "81228": {
      "id": 2685387,
      "text": "Những hang động băng này trên sông băng Morteratsch thu hút rất đông người.",
      "author": "ChatGPT4.1"
    },
    "81229": {
      "id": 2685388,
      "text": "\"Tôi nghĩ đó là một cánh cửa dẫn đến thế giới song song,\"",
      "author": "ChatGPT4.1"
    },
    "81230": {
      "id": 2685389,
      "text": "\"và nếu bạn đi rất, rất sâu, có thể bạn sẽ không bao giờ quay trở lại.\"",
      "author": "ChatGPT4.1"
    },
    "81231": {
      "id": 2685390,
      "text": "Anh ấy không hoàn toàn sai.",
      "author": "ChatGPT4.1"
    },
    "81232": {
      "id": 2685391,
      "text": "Cần có nước tan mới có thể khoét được các đường hầm bên dưới lớp băng của sông băng",
      "author": "ChatGPT4.1"
    },
    "81233": {
      "id": 2685392,
      "text": "và các luồng không khí ấm để tạo ra những hang động băng ngoạn mục này.",
      "author": "ChatGPT4.1"
    },
    "81234": {
      "id": 2685393,
      "text": "\"Bạn biết đấy, khi tôi bước vào, cảm giác như nó rất lớn so với tôi.\"",
      "author": "ChatGPT4.1"
    },
    "81235": {
      "id": 2685394,
      "text": "\"Tôi cảm thấy mình như một sinh vật nhỏ bé khi ở đây,\"",
      "author": "ChatGPT4.1"
    },
    "81236": {
      "id": 2685395,
      "text": "\"và tôi cảm thấy mình là một phần của thiên nhiên.\"",
      "author": "ChatGPT4.1"
    },
    "81237": {
      "id": 2685396,
      "text": "Những du khách ưa phiêu lưu hiểu rằng những hang động băng này sẽ không tồn tại lâu.",
      "author": "ChatGPT4.1"
    },
    "81238": {
      "id": 2685397,
      "text": "Và nếu lượng khí thải nhà kính tiếp tục gia tăng, toàn bộ sông băng này cũng sẽ biến mất.",
      "author": "ChatGPT4.1"
    },
    "81239": {
      "id": 2685398,
      "text": "Các nhà khoa học ước tính các sông băng ở dãy Alps có thể mất hơn 80% khối lượng hiện tại trong 75 năm tới.",
      "author": "ChatGPT4.1"
    },
    "81240": {
      "id": 2685399,
      "text": "Hãy chụp ảnh ngay bây giờ đi, những du khách dũng cảm.",
      "author": "ChatGPT4.1"
    },
    "81241": {
      "id": 2685400,
      "text": "Có thể sẽ không còn nhiều cơ hội để các bạn mạo hiểm mạng sống trong những hang động đang tan chảy nhanh chóng này nữa.",
      "author": "ChatGPT4.1"
    }
  }
}
