  "translations": {
    "85234": {
      "id": 2622280,
      "text": "Hôm nay chúng ta bắt đầu với các khoản vay sinh viên.",
      "author": "ChatGPT4.1"
    },
    "85235": {
      "id": 2622281,
      "text": "Khi một sinh viên đại học không đủ khả năng chi trả học phí của mình, dù bằng học bổng, trợ cấp hay tiền tiết kiệm khó nhọc,",
      "author": "ChatGPT4.1"
    },
    "85236": {
      "id": 2622282,
      "text": "họ có thể tìm đến chính phủ để vay tiền",
      "author": "ChatGPT4.1"
    },
    "85237": {
      "id": 2622283,
      "text": "và trả lại sau khi họ tốt nghiệp.",
      "author": "ChatGPT4.1"
    },
    "85238": {
      "id": 2622284,
      "text": "Khi đại dịch Covid 19 tấn công nước Mỹ,",
      "author": "ChatGPT4.1"
    },
    "85239": {
      "id": 2622285,
      "text": "chính phủ liên bang đã quyết định cho sinh viên đại học một kỳ nghỉ",
      "author": "ChatGPT4.1"
    },
    "85240": {
      "id": 2622286,
      "text": "và nói rằng họ có thể tạm dừng việc trả các khoản vay đó hàng tháng",
      "author": "ChatGPT4.1"
    },
    "85241": {
      "id": 2622287,
      "text": "và không bị phạt bổ sung khi trả hết khoản vay sau này.",
      "author": "ChatGPT4.1"
    },
    "85242": {
      "id": 2622288,
      "text": "Tuy nhiên, sau 5 năm, kỳ nghỉ đó sắp kết thúc.",
      "author": "ChatGPT4.1"
    },
    "85243": {
      "id": 2622289,
      "text": "Và hôm nay, sinh viên phải tiếp tục trả khoản nợ đó.",
      "author": "ChatGPT4.1"
    },
    "85244": {
      "id": 2622290,
      "text": "Sau đây là phát ngôn viên Nhà Trắng về vấn đề này.",
      "author": "ChatGPT4.1"
    },
    "85245": {
      "id": 2622291,
      "text": "Danh mục khoản vay sinh viên do chính phủ liên bang kiểm soát gần 1,6 nghìn tỷ đô la.",
      "author": "ChatGPT4.1"
    },
    "85246": {
      "id": 2622292,
      "text": "Nhưng chưa tới 4 trong số 10 người vay là đang trả nợ.",
      "author": "ChatGPT4.1"
    },
    "85247": {
      "id": 2622293,
      "text": "Điều này là không bền vững, không công bằng và là một gánh nặng lớn cho những người nộp thuế Mỹ.",
      "author": "ChatGPT4.1"
    },
    "85248": {
      "id": 2622294,
      "text": "Bây giờ, bộ đang yêu cầu hàng triệu người vay có khoản vay sinh viên bị quá hạn phải trả nợ bằng cách nối lại việc thu hồi nợ.",
      "author": "ChatGPT4.1"
    },
    "85249": {
      "id": 2622295,
      "text": "Khoản vay sinh viên sẽ bị quá hạn sau 270 ngày không thanh toán.",
      "author": "ChatGPT4.1"
    },
    "85250": {
      "id": 2622296,
      "text": "Và những người vay không trả nợ có thể phải đối mặt với các hình phạt nghiêm trọng.",
      "author": "ChatGPT4.1"
    },
    "85251": {
      "id": 2622297,
      "text": "Ngay trong mùa hè này, nếu những sinh viên hoặc cựu sinh viên này không trả số tiền họ nợ,",
      "author": "ChatGPT4.1"
    },
    "85252": {
      "id": 2622298,
      "text": "chính phủ thậm chí có thể yêu cầu chủ lao động của họ trừ một phần tiền lương để trả nợ.",
      "author": "ChatGPT4.1"
    },
    "85253": {
      "id": 2622299,
      "text": "Hiện nay, có một số nhà lập pháp tin rằng một phần khoản nợ sinh viên này nên được xóa bỏ hoàn toàn,",
      "author": "ChatGPT4.1"
    },
    "85254": {
      "id": 2622300,
      "text": "một phần vì học phí tại các trường đại học và cao đẳng Mỹ đang ở mức cao nhất mọi thời đại.",
      "author": "ChatGPT4.1"
    },
    "85255": {
      "id": 2622301,
      "text": "Đây là Thượng nghị sĩ Massachusetts Elizabeth Warren.",
      "author": "ChatGPT4.1"
    },
    "85256": {
      "id": 2622302,
      "text": "Vì vậy, hãy nhớ rằng đề xuất là sẽ áp dụng giới hạn thu nhập cho việc này.",
      "author": "ChatGPT4.1"
    },
    "85257": {
      "id": 2622303,
      "text": "Vì vậy, không phải xóa nợ sinh viên cho những người có thu nhập cực lớn.",
      "author": "ChatGPT4.1"
    },
    "85258": {
      "id": 2622304,
      "text": "Tôi biết mọi người muốn nói về, bạn biết đấy, những người có tấm bằng danh giá hoặc gì đó.",
      "author": "ChatGPT4.1"
    },
    "85259": {
      "id": 2622305,
      "text": "40% trong số những người này chưa từng tốt nghiệp đại học.",
      "author": "ChatGPT4.1"
    },
    "85260": {
      "id": 2622306,
      "text": "Vì vậy, họ đang vật lộn với nợ sinh viên dù chỉ có mức thu nhập của một người tốt nghiệp phổ thông.",
      "author": "ChatGPT4.1"
    },
    "85261": {
      "id": 2622307,
      "text": "Đã đến lúc thả tự do cho họ.",
      "author": "ChatGPT4.1"
    }
  }
