  "translations": {
    "83619": {
      "id": 2834373,
      "text": "Một móng vuốt khiến người ta kinh ngạc vừa được phát hiện nhờ công việc không biết mệt mỏi của nhà cổ sinh vật học ở Mông Cổ.",
      "author": "ChatGPT4.1"
    },
    "83620": {
      "id": 2834374,
      "text": "Nó thật sự ấn tượng, nhưng hãy chờ đến khi bạn thấy thứ mà họ nghĩ rằng móng vuốt này thuộc về.",
      "author": "ChatGPT4.1"
    },
    "83621": {
      "id": 2834375,
      "text": "Phóng viên Jeremy Roth của chúng tôi có thêm thông tin.",
      "author": "ChatGPT4.1"
    },
    "83622": {
      "id": 2834376,
      "text": "Các nhà cổ sinh vật học đã tạo ra một bước đột phá hấp dẫn ở châu Á,",
      "author": "ChatGPT4.1"
    },
    "83623": {
      "id": 2834377,
      "text": "khai quật được móng vuốt khủng long lớn nhất còn nguyên vẹn thuộc loại này ở Mông Cổ.",
      "author": "ChatGPT4.1"
    },
    "83624": {
      "id": 2834378,
      "text": "Các chuyên gia cho biết bàn tay hai móng độc đáo này thuộc về một loài khủng long chưa từng được biết đến trước đây.",
      "author": "ChatGPT4.1"
    },
    "83625": {
      "id": 2834379,
      "text": "Họ đang gọi... ờ... cái này,",
      "author": "ChatGPT4.1"
    },
    "83626": {
      "id": 2834380,
      "text": "được cho là thuộc cùng họ khủng long với loài T-Rex.",
      "author": "ChatGPT4.1"
    },
    "83627": {
      "id": 2834381,
      "text": "Một số nhà nghiên cứu ví những móng vuốt dài này như cái kẹp dùng để nướng thịt.",
      "author": "ChatGPT4.1"
    },
    "83628": {
      "id": 2834382,
      "text": "Những người khác lại so sánh loài mới này với nhân vật Edward Tay Kéo.",
      "author": "ChatGPT4.1"
    },
    "83629": {
      "id": 2834383,
      "text": "Tôi thì nói, này, sao nó không thể là cả hai nhỉ?",
      "author": "ChatGPT4.1"
    }
  }
