  "translations": {
    "82222": {
      "id": 2915199,
      "text": "Tảng băng trôi lớn nhất trên Trái Đất đã bị dừng lại trên hành trình của nó.",
      "author": "ChatGPT4.1"
    },
    "82223": {
      "id": 2915200,
      "text": "Được gọi là A23a, siêu băng này đã trôi nổi ở Nam Đại Tây Dương.",
      "author": "ChatGPT4.1"
    },
    "82224": {
      "id": 2915201,
      "text": "Nhưng các nhà khoa học theo dõi đường đi của nó cho biết dường như nó đã mắc cạn gần đảo South Georgia.",
      "author": "ChatGPT4.1"
    },
    "82225": {
      "id": 2915202,
      "text": "Một vùng đất xa xôi là nơi sinh sống của hải cẩu và chim cánh cụt.",
      "author": "ChatGPT4.1"
    },
    "82226": {
      "id": 2915203,
      "text": "Những người quan sát nghĩ rằng nó có thể thực sự va chạm với hòn đảo.",
      "author": "ChatGPT4.1"
    },
    "82227": {
      "id": 2915204,
      "text": "Nhưng hiện tại, họ cho biết đang chờ đợi nó di chuyển tiếp.",
      "author": "ChatGPT4.1"
    },
    "82228": {
      "id": 2915205,
      "text": "\"Chúng tôi nghĩ rằng nó sẽ từ từ di chuyển khỏi vị trí đó...\"",
      "author": "ChatGPT4.1"
    },
    "82229": {
      "id": 2915206,
      "text": "\"khi nước ấm xâm nhập bên dưới tảng băng và làm tan chảy nó thêm một chút nữa.\"",
      "author": "ChatGPT4.1"
    },
    "82230": {
      "id": 2915207,
      "text": "Và quỹ đạo hiện tại có thể sẽ đưa nó vòng quanh đảo South Georgia.",
      "author": "ChatGPT4.1"
    },
    "82231": {
      "id": 2915208,
      "text": "A23a tách ra khỏi lục địa Nam Cực vào những năm 1980.",
      "author": "ChatGPT4.1"
    },
    "82232": {
      "id": 2915209,
      "text": "Các nhà khoa học cho biết nó nặng hơn một nghìn tỷ tấn.",
      "author": "ChatGPT4.1"
    },
    "82233": {
      "id": 2915210,
      "text": "Nhưng một khi nó di chuyển trở lại,",
      "author": "ChatGPT4.1"
    },
    "82234": {
      "id": 2915211,
      "text": "các nhà nghiên cứu nói rằng nó có thể khuấy động nguồn thức ăn dinh dưỡng cho động vật hoang dã địa phương.",
      "author": "ChatGPT4.1"
    }
  }
