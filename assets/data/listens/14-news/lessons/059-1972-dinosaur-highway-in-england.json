  "translations": {
    "75990": {
      "id": 2620718,
      "text": "Ngày nay, khu vực này được gọi là Mỏ đá Dewars Farm ở Oxfordshire, Anh.",
      "author": "ChatGPT4.1"
    },
    "75991": {
      "id": 2620719,
      "text": "Nhưng vào thời kỳ Trung Jura, khủng long đã coi khu vực này là nhà.",
      "author": "ChatGPT4.1"
    },
    "75992": {
      "id": 2620720,
      "text": "Làm sao chúng ta biết điều này?",
      "author": "ChatGPT4.1"
    },
    "75993": {
      "id": 2620721,
      "text": "200 bộ dấu chân khác nhau vẫn còn thấy rõ sau 166 triệu năm.",
      "author": "ChatGPT4.1"
    },
    "75994": {
      "id": 2620722,
      "text": "Có rất nhiều khủng long đã đi qua con đường này, các nhà cổ sinh vật học gọi nó là “Xa lộ Khủng long.”",
      "author": "ChatGPT4.1"
    },
    "75995": {
      "id": 2620723,
      "text": "Phát hiện này xảy ra khi một công nhân tại mỏ đá vôi nhận thấy một số chỗ gồ ghề lạ trên mặt đất.",
      "author": "ChatGPT4.1"
    },
    "75996": {
      "id": 2620724,
      "text": "Điều đó đã thúc đẩy một nhóm hơn 100 người đến từ các trường đại học địa phương tiến hành khai quật khu vực này một cách cẩn thận.",
      "author": "ChatGPT4.1"
    },
    "75997": {
      "id": 2620725,
      "text": "Để ghi lại công việc của mình, nhóm đã chụp hơn 20.000 bức ảnh kỹ thuật số.",
      "author": "ChatGPT4.1"
    },
    "75998": {
      "id": 2620726,
      "text": "Máy bay không người lái được sử dụng để có cái nhìn tổng thể từ trên cao về các dấu chân khổng lồ này.",
      "author": "ChatGPT4.1"
    },
    "75999": {
      "id": 2620727,
      "text": "Các nhà cổ sinh vật học đã xác định được dấu chân của cả khủng long ăn cỏ lẫn ăn thịt.",
      "author": "ChatGPT4.1"
    },
    "76000": {
      "id": 2620728,
      "text": "Các nhà khoa học hy vọng những nghiên cứu trong tương lai tại khu vực này sẽ mang lại nhiều hiểu biết hơn về kích thước và hình dạng của các loài đã tuyệt chủng.",
      "author": "ChatGPT4.1"
    },
    "76001": {
      "id": 2620729,
      "text": "Và giờ khi chúng ta biết được nơi chúng từng đi qua,",
      "author": "ChatGPT4.1"
    },
    "76002": {
      "id": 2620730,
      "text": "chúng có thể cho ta ý tưởng về tốc độ mà chúng di chuyển.",
      "author": "ChatGPT4.1"
    },
    "76003": {
      "id": 2620731,
      "text": "Nhưng đây mới là câu hỏi thực sự:",
      "author": "ChatGPT4.1"
    },
    "76004": {
      "id": 2620732,
      "text": "tất cả những con khủng long này đã đi đâu?",
      "author": "ChatGPT4.1"
    }
  }
}
