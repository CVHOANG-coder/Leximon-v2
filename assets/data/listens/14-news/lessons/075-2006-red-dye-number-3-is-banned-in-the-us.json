  "translations": {
    "78000": {
      "id": 3058759,
      "text": "Cục Quản lý Thực phẩm và Dược phẩm Hoa Kỳ vừa cấm sử dụng phẩm màu đỏ số ba - đây là phẩm màu nhân tạo dùng trong thực phẩm, đồ uống và thuốc.",
      "author": "ChatGPT4.1"
    },
    "78001": {
      "id": 3058760,
      "text": "Và nó được làm từ dầu mỏ. Đúng vậy, nhiên liệu hóa thạch có trong thực phẩm.",
      "author": "ChatGPT4.1"
    },
    "78002": {
      "id": 3058761,
      "text": "Đây là một chất tạo màu tổng hợp tạo nên màu đỏ anh đào tươi sáng.",
      "author": "ChatGPT4.1"
    },
    "78003": {
      "id": 3058762,
      "text": "Và trong nhiều thập kỷ, các nhà khoa học đã biết về mối liên hệ của nó với việc gây ung thư ở động vật.",
      "author": "ChatGPT4.1"
    },
    "78004": {
      "id": 3058763,
      "text": "Jacquline Howard của CNN giải thích những gì cần thiết để FDA cấm loại phẩm màu này",
      "author": "ChatGPT4.1"
    },
    "78005": {
      "id": 3058764,
      "text": "và cách những thay đổi này sẽ có hiệu lực.",
      "author": "ChatGPT4.1"
    },
    "78006": {
      "id": 3058765,
      "text": "Cụ thể, FDA đang thu hồi sự cho phép sử dụng phẩm màu đỏ số ba như một loại chất tạo màu.",
      "author": "ChatGPT4.1"
    },
    "78007": {
      "id": 3058766,
      "text": "Và điều này diễn ra sau một đơn kiến nghị năm 2022 kêu gọi FDA xem xét lại việc sử dụng chất này.",
      "author": "ChatGPT4.1"
    },
    "78008": {
      "id": 3058767,
      "text": "Và điều này xảy ra hơn 30 năm sau khi các nhà khoa học phát hiện mối liên hệ với ung thư ở động vật.",
      "author": "ChatGPT4.1"
    },
    "78009": {
      "id": 3058768,
      "text": "Vậy điều gì sẽ xảy ra tiếp theo đối với các nhà sản xuất đang sử dụng phẩm màu đỏ số ba trong thực phẩm?",
      "author": "ChatGPT4.1"
    },
    "78010": {
      "id": 3058769,
      "text": "Họ có thời hạn đến ngày 15 tháng 1 năm 2027 để thay đổi công thức sản phẩm của mình.",
      "author": "ChatGPT4.1"
    },
    "78011": {
      "id": 3058770,
      "text": "Và những sản phẩm dùng trong thuốc uống có thời hạn đến ngày 18 tháng 1 năm 2028.",
      "author": "ChatGPT4.1"
    },
    "78012": {
      "id": 3058771,
      "text": "Một số bang, như California, đã cấm thành phần này nhưng...",
      "author": "ChatGPT4.1"
    },
    "78013": {
      "id": 3058772,
      "text": "giờ đây đây là lệnh cấm trên toàn quốc theo quy định của FDA.",
      "author": "ChatGPT4.1"
    },
    "78014": {
      "id": 3058773,
      "text": "Và loại phẩm màu đỏ tươi này, là một loại màu nhân tạo, được làm từ dầu mỏ,",
      "author": "ChatGPT4.1"
    },
    "78015": {
      "id": 3058774,
      "text": "Và nó được sử dụng trong ít nhất hàng chục loại kẹo, thực phẩm, đồ uống.",
      "author": "ChatGPT4.1"
    },
    "78016": {
      "id": 3058775,
      "text": "Nhưng một số thương hiệu nổi tiếng nhất hoặc không sử dụng nó hoặc đã ngừng sử dụng.",
      "author": "ChatGPT4.1"
    },
    "78017": {
      "id": 3058776,
      "text": "Thay vào đó, họ có xu hướng sử dụng một thành phần khác, phẩm màu đỏ số 40,",
      "author": "ChatGPT4.1"
    },
    "78018": {
      "id": 3058777,
      "text": "được xem là một lựa chọn thay thế lành mạnh hơn.",
      "author": "ChatGPT4.1"
    },
    "78019": {
      "id": 3058778,
      "text": "Tuy nhiên, vẫn có một số lo ngại về sức khỏe đối với phẩm màu đỏ số 40.",
      "author": "ChatGPT4.1"
    },
    "78020": {
      "id": 3058779,
      "text": "Và bang California đã cấm nó trong các thực phẩm và đồ uống được bán tại trường học công lập.",
      "author": "ChatGPT4.1"
    },
    "78021": {
      "id": 3058780,
      "text": "Vì vậy, chúng ta có thể mong đợi sẽ có thêm nhiều cuộc thảo luận về vấn đề này trong tương lai.",
      "author": "ChatGPT4.1"
    }
  }
