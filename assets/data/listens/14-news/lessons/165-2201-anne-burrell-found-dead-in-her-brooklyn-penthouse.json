  "translations": {
    "87052": {
      "id": 3210157,
      "text": "Phản ứng lớn trước cái chết đột ngột và bất ngờ của một trong những nhân vật nổi tiếng nhất của Food Network, Anne Burrell.",
      "author": "ChatGPT4.1"
    },
    "87053": {
      "id": 3210158,
      "text": "Cô được phát hiện bất tỉnh trên sàn nhà của một căn nhà ở Brooklyn khi chỉ mới 55 tuổi.",
      "author": "ChatGPT4.1"
    },
    "87054": {
      "id": 3210159,
      "text": "Chúng ta sẽ không có nguyên nhân chính thức cho đến khi khám nghiệm tử thi, nhưng người gọi 911 đã nói Burrell bị ngưng tim.",
      "author": "ChatGPT4.1"
    },
    "87055": {
      "id": 3210160,
      "text": "Vậy đó có phải là một cơn đau tim không?",
      "author": "ChatGPT4.1"
    },
    "87056": {
      "id": 3210161,
      "text": "Đây là Stephen Fabian.",
      "author": "ChatGPT4.1"
    },
    "87057": {
      "id": 3210162,
      "text": "Chúng ta đang tìm hiểu thêm về những ngày cuối cùng của ngôi sao Food Network Anne Burrell,",
      "author": "ChatGPT4.1"
    },
    "87058": {
      "id": 3210163,
      "text": "sau cái chết gây sốc của cô ở tuổi 55.",
      "author": "ChatGPT4.1"
    },
    "87059": {
      "id": 3210164,
      "text": "Có thông tin cho rằng Burrell rất vui vẻ vào đêm trước khi cô được tìm thấy đã qua đời trong căn hộ penthouse tầng bảy ở Brooklyn.",
      "author": "ChatGPT4.1"
    },
    "87060": {
      "id": 3210165,
      "text": "Nữ đầu bếp truyền hình nổi tiếng với mái tóc bạch kim dựng đứng đang thử sức mình với điều cô chưa từng làm: hài kịch ứng tác.",
      "author": "ChatGPT4.1"
    },
    "87061": {
      "id": 3210166,
      "text": "\"Tôi biết dạo này mình khá im lặng, nhưng tôi đang tham gia lớp học hài ứng tác cho diễn viên tại Second City, New York.\"",
      "author": "ChatGPT4.1"
    },
    "87062": {
      "id": 3210167,
      "text": "\"Cho tôi nói thật nhé, điều này rất vui và tôi đang học được rất, rất nhiều.\"",
      "author": "ChatGPT4.1"
    },
    "87063": {
      "id": 3210168,
      "text": "Burrell đã trình diễn cùng lớp học hài ứng tác của mình vào tối thứ Hai.",
      "author": "ChatGPT4.1"
    },
    "87064": {
      "id": 3210169,
      "text": "Chỉ vài giờ sau buổi diễn, nhân viên y tế đã được gọi tới nhà Burrell ở Brooklyn vào lúc 7:50 sáng.",
      "author": "ChatGPT4.1"
    },
    "87065": {
      "id": 3210170,
      "text": "Báo cáo ban đầu cho biết Anne Burrell bị ngừng tim.",
      "author": "ChatGPT4.1"
    },
    "87066": {
      "id": 3210171,
      "text": "Cô được xác định đã qua đời tại hiện trường.",
      "author": "ChatGPT4.1"
    },
    "87067": {
      "id": 3210172,
      "text": "Burrell là người dẫn chương trình nổi tiếng của \"Worst Cooks in America\" trên Food Network suốt bảy mùa giải.",
      "author": "ChatGPT4.1"
    },
    "87068": {
      "id": 3210173,
      "text": "Người hâm mộ nhận ra sự vắng mặt của cô ở mùa hiện tại, thắc mắc trên mạng xã hội rằng điều gì đã xảy ra với cô.",
      "author": "ChatGPT4.1"
    },
    "87069": {
      "id": 3210174,
      "text": "\"Thật lòng mà nói, tôi không biết.\", cô trả lời khi một người hâm mộ khác nói rằng họ hy vọng Burrell sẽ quay lại.",
      "author": "ChatGPT4.1"
    },
    "87070": {
      "id": 3210175,
      "text": "Burrell viết, \"Tôi sẽ cố gắng hết sức.\"",
      "author": "ChatGPT4.1"
    },
    "87071": {
      "id": 3210176,
      "text": "Burrell đã kết hôn và có một con trai riêng.",
      "author": "ChatGPT4.1"
    },
    "87072": {
      "id": 3210177,
      "text": "Năm 2023, cô đã giới thiệu về ngôi nhà của mình...",
      "author": "ChatGPT4.1"
    },
    "87073": {
      "id": 3210178,
      "text": "Burrell cũng từng xuất hiện trên chương trình Inside Edition.",
      "author": "ChatGPT4.1"
    },
    "87074": {
      "id": 3210179,
      "text": "Tại đây, cô dạy Hoa hậu Hoàn vũ một bài học nấu ăn tại Super Bowl 2016.",
      "author": "ChatGPT4.1"
    },
    "87075": {
      "id": 3210180,
      "text": "Trong một tuyên bố, gia đình cô cho biết nụ cười của Burrell luôn làm bừng sáng mọi căn phòng cô bước vào, cô sẽ được nhớ mãi.",
      "author": "ChatGPT4.1"
    }
  }
}
