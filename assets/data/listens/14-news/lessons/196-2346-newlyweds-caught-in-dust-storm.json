      "id": 3691055,
      "text": "“Nó dày đến mức bạn hầu như không thể mở mắt, và như kiểu bụi bay vào miệng.”",
      "author": "ChatGPT4.1"
    },
    "92216": {
      "id": 3691056,
      "text": "Cặp đôi mới cưới cùng nhiếp ảnh gia chạy dọc phố để tìm nơi trú ẩn.",
      "author": "ChatGPT4.1"
    },
    "92217": {
      "id": 3691057,
      "text": "Đó là lúc một người lạ hoàn toàn, chủ một quán cà phê gần đó, nhìn thấy tình cảnh của họ và đến giúp đỡ.",
      "author": "ChatGPT4.1"
    },
    "92218": {
      "id": 3691058,
      "text": "“Tôi chỉ nghĩ, ừm, đây là một bữa tiệc cưới... mình có thể làm gì để khiến ngày của họ thật đặc biệt nhỉ?”",
      "author": "ChatGPT4.1"
    },
    "92219": {
      "id": 3691059,
      "text": "Paul Roupas đã mời tất cả họ vào cửa hàng của mình, Aristocrat Coffee Roasters,",
      "author": "ChatGPT4.1"
    },
    "92220": {
      "id": 3691060,
      "text": "và tổ chức một bữa tiệc tiếp đãi ngẫu hứng.",
      "author": "ChatGPT4.1"
    },
    "92221": {
      "id": 3691061,
      "text": "Bao gồm cả màn đút kem cho nhau, tất nhiên theo phong cách bánh cưới,",
      "author": "ChatGPT4.1"
    },
    "92222": {
      "id": 3691062,
      "text": "và nhạc vang lên từ một máy phát nhạc kiểu cổ.",
      "author": "ChatGPT4.1"
    },
    "92223": {
      "id": 3691063,
      "text": "Cặp đôi mới cưới đã có điệu nhảy đầu tiên trong khi ngoài kia cơn bão lớn đang cuồng nộ trên đường phố.",
      "author": "ChatGPT4.1"
    },
    "92224": {
      "id": 3691064,
      "text": "“Anh ấy làm latte với hình trái tim trên đó.”",
      "author": "ChatGPT4.1"
    },
    "92225": {
      "id": 3691065,
      "text": "“Thật sự rất ngọt ngào.”",
      "author": "ChatGPT4.1"
    },
    "92226": {
      "id": 3691066,
      "text": "Bất chấp một cơn bão bụi khổng lồ đang hình thành bên ngoài,",
      "author": "ChatGPT4.1"
    },
    "92227": {
      "id": 3691067,
      "text": "một đám cưới vui vẻ đã diễn ra nhờ vào một ông chủ quán cà phê tốt bụng.",
      "author": "ChatGPT4.1"
    },
    "92228": {
      "id": 3691068,
      "text": "“Tôi nói với anh ấy, kiểu như là, anh nên làm người điều phối đám cưới đấy.”",
      "author": "ChatGPT4.1"
    }
  }
}
