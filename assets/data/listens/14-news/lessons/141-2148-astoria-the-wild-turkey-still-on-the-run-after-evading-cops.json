  "translations": {
    "84798": {
      "id": 2652892,
      "text": "Bắt con gà tây đó đi.",
      "author": "ChatGPT4.1"
    },
    "84799": {
      "id": 2652893,
      "text": "Một con gà tây hoang bay lên, đậu tạm thời trên gờ nhỏ trước khi rơi xuống.",
      "author": "ChatGPT4.1"
    },
    "84800": {
      "id": 2652894,
      "text": "Đó là lúc một sĩ quan cảnh sát lao vào với một tấm ga giường màu trắng.",
      "author": "ChatGPT4.1"
    },
    "84801": {
      "id": 2652895,
      "text": "Nhưng anh ấy không thể so được với con gà tây tinh nghịch đã tránh né cảnh sát suốt hai tuần qua.",
      "author": "ChatGPT4.1"
    },
    "84802": {
      "id": 2652896,
      "text": "Tên cô ấy là Astoria.",
      "author": "ChatGPT4.1"
    },
    "84803": {
      "id": 2652897,
      "text": "Cô ấy được đặt tên theo khu phố nơi cô ấy được nhìn thấy lần đầu tiên.",
      "author": "ChatGPT4.1"
    },
    "84804": {
      "id": 2652898,
      "text": "Nhưng bây giờ cô ấy đã bay khỏi chuồng, bay qua sông East và hạ cánh tại Manhattan.",
      "author": "ChatGPT4.1"
    },
    "84805": {
      "id": 2652899,
      "text": "Đã có những lần nhìn thấy Astoria khắp thành phố.",
      "author": "ChatGPT4.1"
    },
    "84806": {
      "id": 2652900,
      "text": "Cô ấy thậm chí còn đến Starbucks để uống cà phê.",
      "author": "ChatGPT4.1"
    },
    "84807": {
      "id": 2652901,
      "text": "Vào Chủ nhật, cô ấy xuất hiện ở Công viên Trung tâm.",
      "author": "ChatGPT4.1"
    },
    "84808": {
      "id": 2652902,
      "text": "Bắt anh ta đi, Allison, bảo chiếc xe tải đó dừng lại.",
      "author": "ChatGPT4.1"
    },
    "84809": {
      "id": 2652903,
      "text": "Hôm nay tôi đã giúp cô ấy sang đường để không bị xe đâm trên đại lộ Park sành điệu của New York.",
      "author": "ChatGPT4.1"
    },
    "84810": {
      "id": 2652904,
      "text": "Được rồi...",
      "author": "ChatGPT4.1"
    },
    "84811": {
      "id": 2652905,
      "text": "Bây giờ là mùa giao phối.",
      "author": "ChatGPT4.1"
    },
    "84812": {
      "id": 2652906,
      "text": "Vì vậy chúng tôi nghĩ rằng lý do cô ấy lang thang là để tìm bạn tình.",
      "author": "ChatGPT4.1"
    },
    "84813": {
      "id": 2652907,
      "text": "Mọi người đều cổ vũ cho Astoria tìm được tình yêu đích thực ở thành phố New York.",
      "author": "ChatGPT4.1"
    }
  }
}
