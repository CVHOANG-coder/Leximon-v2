  "translations": {
    "77966": {
      "id": 2835427,
      "text": "Một số món ăn sáng yêu thích của bạn có thể gây hại cho sức khỏe não bộ không?",
      "author": "ChatGPT4.1"
    },
    "77967": {
      "id": 2835428,
      "text": "Một nghiên cứu mới được công bố trên tạp chí Neurology",
      "author": "ChatGPT4.1"
    },
    "77968": {
      "id": 2835429,
      "text": "cho biết những người ăn nhiều thịt đỏ đã qua chế biến có nguy cơ mắc chứng sa sút trí tuệ cao hơn.",
      "author": "ChatGPT4.1"
    },
    "77969": {
      "id": 2835430,
      "text": "Khi xem xét thói quen ăn uống của hơn 133.000 người đều làm việc trong ngành y tế,",
      "author": "ChatGPT4.1"
    },
    "77970": {
      "id": 2835431,
      "text": "Tiến sĩ Wen và nhóm của ông phát hiện rằng:",
      "author": "ChatGPT4.1"
    },
    "77971": {
      "id": 2835432,
      "text": "Những người ăn một phần tư khẩu phần thịt đỏ chế biến, như xúc xích baloney hoặc hot dog,",
      "author": "ChatGPT4.1"
    },
    "77972": {
      "id": 2835433,
      "text": "có nguy cơ mắc chứng sa sút trí tuệ cao hơn 13%",
      "author": "ChatGPT4.1"
    },
    "77973": {
      "id": 2835434,
      "text": "so với những người chỉ ăn ít hơn 1/10 khẩu phần mỗi ngày.",
      "author": "ChatGPT4.1"
    },
    "77974": {
      "id": 2835435,
      "text": "Khẩu phần cho nghiên cứu này khá nhỏ,",
      "author": "ChatGPT4.1"
    },
    "77975": {
      "id": 2835436,
      "text": "chỉ 3 ounce hoặc khoảng hai lát thịt xông khói.",
      "author": "ChatGPT4.1"
    },
    "77976": {
      "id": 2835437,
      "text": "Suy giảm nhận thức này không xảy ra ở những người thường ăn thịt chưa qua chế biến",
      "author": "ChatGPT4.1"
    },
    "77977": {
      "id": 2835438,
      "text": "như bít tết, sườn heo hoặc thậm chí là bánh hamburger không phụ gia.",
      "author": "ChatGPT4.1"
    },
    "77978": {
      "id": 2835439,
      "text": "Giờ đây mọi người có phải ăn chay không? Không.",
      "author": "ChatGPT4.1"
    },
    "77979": {
      "id": 2835440,
      "text": "Nhưng khi đi ăn nướng, hãy chọn hamburger thay vì hot dog,",
      "author": "ChatGPT4.1"
    },
    "77980": {
      "id": 2835441,
      "text": "và hãy thử giảm bớt khẩu phần ăn của bạn.",
      "author": "ChatGPT4.1"
    }
  }
