  "translations": {
    "92283": {
      "id": 3695535,
      "text": "Một chuyến đi cực chất từ bờ biển này sang bờ biển khác, quyên góp số tiền khổng lồ cho một mục đích.",
      "author": "ChatGPT4.1"
    },
    "92284": {
      "id": 3695536,
      "text": "Brooke Johnson vừa trở thành người phụ nữ đầu tiên trượt ván xuyên nước Mỹ,",
      "author": "ChatGPT4.1"
    },
    "92285": {
      "id": 3695537,
      "text": "hoàn thành một hành trình trượt ván gian khổ từ California đến Virginia Beach.",
      "author": "ChatGPT4.1"
    },
    "92286": {
      "id": 3695538,
      "text": "\"Có những lúc thật khó khăn... ôi trời ơi, tôi đã khóc rất nhiều lần.\"",
      "author": "ChatGPT4.1"
    },
    "92287": {
      "id": 3695539,
      "text": "\"Tôi chỉ là một cô gái.\"",
      "author": "ChatGPT4.1"
    },
    "92288": {
      "id": 3695540,
      "text": "\"Tôi chỉ là một cô gái.\"",
      "author": "ChatGPT4.1"
    },
    "92289": {
      "id": 3695541,
      "text": "Nhưng cô ấy không chỉ là một cô gái bình thường.",
      "author": "ChatGPT4.1"
    },
    "92290": {
      "id": 3695542,
      "text": "Brooke đã kiên trì liên tục trong 118 ngày,",
      "author": "ChatGPT4.1"
    },
    "92291": {
      "id": 3695543,
      "text": "băng qua đất nước và đối mặt với mọi thử thách trên đường đi.",
      "author": "ChatGPT4.1"
    },
    "92292": {
      "id": 3695544,
      "text": "Cô đã quyên góp được hơn 50.000 đô la cho nghiên cứu về tủy sống",
      "author": "ChatGPT4.1"
    },
    "92293": {
      "id": 3695545,
      "text": "để tưởng nhớ người cha dượng đã khuất của cô, người vừa qua đời sau khi bị chấn thương tủy sống.",
      "author": "ChatGPT4.1"
    },
    "92294": {
      "id": 3695546,
      "text": "Brooke hy vọng chuyến đi lập kỷ lục này sẽ truyền cảm hứng cho những người khác nhận ra rằng họ mạnh mẽ hơn họ nghĩ.",
      "author": "ChatGPT4.1"
    },
