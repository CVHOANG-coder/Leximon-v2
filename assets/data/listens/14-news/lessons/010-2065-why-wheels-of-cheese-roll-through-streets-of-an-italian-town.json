  "translations": {
    "81354": {
      "id": 2612124,
      "text": "Phô mai bỏ trốn!",
      "author": "ChatGPT4.1"
    },
    "81355": {
      "id": 2612125,
      "text": "Nhưng những người mặc đồ sặc sỡ đi theo không cố gắng ngăn nó lại.",
      "author": "ChatGPT4.1"
    },
    "81356": {
      "id": 2612126,
      "text": "Họ muốn xem chiếc phô mai pecorino này có thể lăn xa đến đâu.",
      "author": "ChatGPT4.1"
    },
    "81358": {
      "id": 2612127,
      "text": "Đây là một trò chơi gọi là Maiorchino,",
      "author": "ChatGPT4.1"
    },
    "81359": {
      "id": 2612128,
      "text": "và nó có từ thế kỷ 17.",
      "author": "ChatGPT4.1"
    },
    "81360": {
      "id": 2612129,
      "text": "Nino 85 tuổi thì không sống lâu đến vậy,",
      "author": "ChatGPT4.1"
    },
    "81361": {
      "id": 2612130,
      "text": "nhưng ông là người chơi lớn tuổi nhất còn sống ở thị trấn Novara di Sicilia.",
      "author": "ChatGPT4.1"
    },
    "81362": {
      "id": 2612131,
      "text": "Trò chơi không bao giờ thay đổi. Trò chơi luôn luôn như vậy.",
      "author": "ChatGPT4.1"
    },
    "81363": {
      "id": 2612132,
      "text": "Người chơi thay đổi, nhưng luật chơi thì luôn giống nhau.",
      "author": "ChatGPT4.1"
    },
    "81364": {
      "id": 2612133,
      "text": "Phô mai Maiorchino, sợi dây thừng, và những thứ còn lại.",
      "author": "ChatGPT4.1"
    },
    "81365": {
      "id": 2612134,
      "text": "Maiorchino được sáng tạo sau khi các con đường trong thị trấn được xây dựng để phù hợp với các lối đi cần thiết để lăn bánh phô mai.",
      "author": "ChatGPT4.1"
    },
    "81366": {
      "id": 2612135,
      "text": "Mục tiêu là làm cho phô mai lăn càng xa càng tốt trên con đường dài 2 km mà không bị lạc vào hẻm hoặc rơi xuống mương.",
      "author": "ChatGPT4.1"
    },
    "81367": {
      "id": 2612136,
      "text": "Đây là một truyền thống rất quan trọng vì bạn không đánh mất cội nguồn.",
      "author": "ChatGPT4.1"
    },
    "81368": {
      "id": 2612137,
      "text": "Bạn không đánh mất lịch sử.",
      "author": "ChatGPT4.1"
    },
    "81369": {
      "id": 2612138,
      "text": "Với những người mới tham gia trò chơi mỗi năm, hy vọng truyền thống này sẽ còn tiếp diễn qua nhiều thế hệ nữa.",
      "author": "ChatGPT4.1"
    },
