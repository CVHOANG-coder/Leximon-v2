  "translations": {
    "86710": {
      "id": 3088054,
      "text": "Mọi điều tốt đẹp rồi cũng kết thúc.",
      "author": "ChatGPT4.1"
    },
    "86711": {
      "id": 3088055,
      "text": "Cứ hỏi Ed thì biết.",
      "author": "ChatGPT4.1"
    },
    "86712": {
      "id": 3088056,
      "text": "Con ngựa vằn trốn thoát đã chạy quanh Tennessee suốt một tuần trước khi cuối cùng bị bắt.",
      "author": "ChatGPT4.1"
    },
    "86713": {
      "id": 3088057,
      "text": "Nhưng người dân địa phương thì không thực sự sợ hãi co rúm trong nhà.",
      "author": "ChatGPT4.1"
    },
    "86714": {
      "id": 3088058,
      "text": "Chúng tôi đùa rất nhiều, bạn biết đấy, cậu ta đã nổi tiếng trên mạng mà...",
      "author": "ChatGPT4.1"
    },
    "86715": {
      "id": 3088059,
      "text": "Mandy Motes nói với WTVF rằng Ed đã sổng khỏi chuồng và bỏ trốn với đội truy tìm ráo riết bám theo.",
      "author": "ChatGPT4.1"
    },
    "86716": {
      "id": 3088060,
      "text": "Con ngựa vằn này thực sự rất khó bắt.",
      "author": "ChatGPT4.1"
    },
    "86717": {
      "id": 3088061,
      "text": "Khi các nguồn lực địa phương không thể bắt được cậu ta sau gần một tuần,",
      "author": "ChatGPT4.1"
    },
    "86718": {
      "id": 3088062,
      "text": "chủ của Ed được cho là đã gọi một đội từ Texas đến để truy tìm,",
      "author": "ChatGPT4.1"
    },
    "86719": {
      "id": 3088063,
      "text": "bẫy cậu bằng lưới, sau đó dùng trực thăng đưa cậu về nơi an toàn.",
      "author": "ChatGPT4.1"
    },
    "86720": {
      "id": 3088064,
      "text": "Văn phòng Cảnh sát trưởng hạt Rutherford đã theo dõi và báo cáo về việc nhìn thấy Ed trên mạng xã hội.",
      "author": "ChatGPT4.1"
    },
    "86721": {
      "id": 3088065,
      "text": "Họ cũng rất vui khi chia sẻ video về việc đưa Ed trở về với chủ,",
      "author": "ChatGPT4.1"
    },
    "86722": {
      "id": 3088066,
      "text": "những người cho biết Ed vẫn khỏe mạnh sau khi được bác sĩ thú y kiểm tra.",
      "author": "ChatGPT4.1"
    },
    "86723": {
      "id": 3088067,
      "text": "Chưa rõ liệu Ed đã rút ra bài học hay chưa, nhưng nếu cậu ấy lại cố gắng bỏ trốn lần nữa,",
      "author": "ChatGPT4.1"
    },
    "86724": {
      "id": 3088068,
      "text": "có lẽ vì cậu lại muốn được đi trực thăng tiếp.",
      "author": "ChatGPT4.1"
    }
  }
