  "translations": {
    "76103": {
      "id": 2657752,
      "text": "Xem khi camera giám sát này ghi lại cảnh mặt đất rung chuyển.",
      "author": "ChatGPT4.1"
    },
    "76104": {
      "id": 2657753,
      "text": "Những vật thể gần đó như chiếc quạt trần này lắc lư không kiểm soát được.",
      "author": "ChatGPT4.1"
    },
    "76105": {
      "id": 2657754,
      "text": "Đó là dấu hiệu của một trận động đất mạnh đã xảy ra ở Tây Tạng trong tuần này.",
      "author": "ChatGPT4.1"
    },
    "76106": {
      "id": 2657755,
      "text": "Được ước tính có cường độ từ 6,8 đến 7,1 độ,",
      "author": "ChatGPT4.1"
    },
    "76107": {
      "id": 2657756,
      "text": "tác động của nó rất tàn khốc.",
      "author": "ChatGPT4.1"
    },
    "76108": {
      "id": 2657757,
      "text": "Những nhân chứng đã chia sẻ hình ảnh các con phố đầy đổ nát của một thành phố ở khu vực Himalaya, được biết đến là cửa ngõ lên đỉnh Everest.",
      "author": "ChatGPT4.1"
    },
    "76109": {
      "id": 2657758,
      "text": "Vật liệu xây dựng vương vãi khắp nơi,",
      "author": "ChatGPT4.1"
    },
    "76110": {
      "id": 2657759,
      "text": "và một chiếc ô tô đã bị đè nát bởi đống đổ nát rơi xuống.",
      "author": "ChatGPT4.1"
    },
    "76111": {
      "id": 2657760,
      "text": "Lực lượng cứu hộ cứu hỏa Tây Tạng đã khẩn trương tìm kiếm người sống sót trong các tòa nhà bị sập.",
      "author": "ChatGPT4.1"
    },
    "76112": {
      "id": 2657761,
      "text": "Họ được nhìn thấy đang di chuyển một nạn nhân động đất lên cáng.",
      "author": "ChatGPT4.1"
    },
    "76113": {
      "id": 2657762,
      "text": "Đài truyền hình nhà nước Trung Quốc đưa tin ít nhất 120 người thiệt mạng",
      "author": "ChatGPT4.1"
    },
    "76114": {
      "id": 2657763,
      "text": "và hơn 180 người bị thương do vụ động đất.",
      "author": "ChatGPT4.1"
    },
    "76115": {
      "id": 2657764,
      "text": "Nhiều dư chấn, trong đó có những trận mạnh tới 3,0 độ, đã được cảm nhận sau đó.",
      "author": "ChatGPT4.1"
    }
  }
