      "id": 2616139,
      "text": "từ nền móng đến khung nhà,",
      "author": "ChatGPT4.1"
    },
    "83586": {
      "id": 2616140,
      "text": "đến tường thạch cao, điện và hệ thống ống nước.",
      "author": "ChatGPT4.1"
    },
    "83587": {
      "id": 2616141,
      "text": "\"Một khi chúng ta đã bố trí chúng, thì có thể đặt tất cả các thanh đỡ vào đúng vị trí của chúng.\"",
      "author": "ChatGPT4.1"
    },
    "83588": {
      "id": 2616142,
      "text": "Trước đây, nó được gọi là lớp mộc, nhưng ngày nay nó được gọi là nghề mộc và xây dựng",
      "author": "ChatGPT4.1"
    },
    "83589": {
      "id": 2616143,
      "text": "tại Trường Trung học Chuyên Piscataway ở New Jersey.",
      "author": "ChatGPT4.1"
    },
    "83590": {
      "id": 2616144,
      "text": "Đây chỉ là một trong nhiều lớp dạy nghề đang được hồi sinh cho thế kỷ 21",
      "author": "ChatGPT4.1"
    },
    "83591": {
      "id": 2616145,
      "text": "tại các trường trung học trên khắp nước Mỹ.",
      "author": "ChatGPT4.1"
    },
    "83592": {
      "id": 2616146,
      "text": "Hầu hết học sinh hiện nay đã nhận ra rằng đại học không phải là con đường duy nhất dẫn đến thành công.",
      "author": "ChatGPT4.1"
    },
    "83593": {
      "id": 2616147,
      "text": "Ý tưởng là những thanh thiếu niên này có thể ngay lập tức có được một công việc lương cao ngay sau khi tốt nghiệp trung học.",
      "author": "ChatGPT4.1"
    },
    "83594": {
      "id": 2616148,
      "text": "\"Bao nhiêu người trong số các em dự định theo đuổi một công việc trong ngành nghề này?\"",
      "author": "ChatGPT4.1"
    },
    "83595": {
      "id": 2616149,
      "text": "Gần như tất cả mọi người đều giơ tay.",
      "author": "ChatGPT4.1"
    },
    "83596": {
      "id": 2616150,
      "text": "Ngoài ra còn có lớp học hàn, thường được gọi là xưởng kim loại,",
      "author": "ChatGPT4.1"
    },
    "83597": {
      "id": 2616151,
      "text": "và đây là chương trình nghệ thuật ẩm thực, trước đây gọi là môn kinh tế gia đình.",
      "author": "ChatGPT4.1"
    },
    "83598": {
      "id": 2616152,
      "text": "Họ đang chế biến rất nhiều món ăn hấp dẫn.",
      "author": "ChatGPT4.1"
    },
    "83599": {
      "id": 2616153,
      "text": "Khi họ hoàn thành ở đây, thế giới sẽ là của họ để thưởng thức và tận hưởng.",
      "author": "ChatGPT4.1"
    }
  }
}
