  "translations": {
    "81242": {
      "id": 2622623,
      "text": "Nữ diễn viên Michelle Trachtenberg đã qua đời.",
      "author": "ChatGPT4.1"
    },
    "81243": {
      "id": 2622624,
      "text": "Cô gái 39 tuổi này nổi tiếng nhất với vai em gái của Sarah Michelle Gellar trong Buffy the Vampire Slayer.",
      "author": "ChatGPT4.1"
    },
    "81244": {
      "id": 2622625,
      "text": "Cô cũng từng đóng cùng Blake Lively trong Gossip Girl.",
      "author": "ChatGPT4.1"
    },
    "81245": {
      "id": 2622626,
      "text": "\"Đừng tự ái, tôi chỉ cố gắng làm bạn cười thôi mà.\"",
      "author": "ChatGPT4.1"
    },
    "81246": {
      "id": 2622627,
      "text": "Michelle Trachtenberg được mẹ cô phát hiện đã qua đời sáng nay tại căn hộ sang trọng của cô ở New York City,",
      "author": "ChatGPT4.1"
    },
    "81247": {
      "id": 2622628,
      "text": "người đã gọi 911.",
      "author": "ChatGPT4.1"
    },
    "81248": {
      "id": 2622629,
      "text": "Theo báo cáo, Michelle gần đây đã trải qua phẫu thuật ghép gan",
      "author": "ChatGPT4.1"
    },
    "81249": {
      "id": 2622630,
      "text": "và có thể đã gặp biến chứng.",
      "author": "ChatGPT4.1"
    },
    "81250": {
      "id": 2622631,
      "text": "Không nghi ngờ có sự tác động của người khác.",
      "author": "ChatGPT4.1"
    },
    "81251": {
      "id": 2622632,
      "text": "Ngôi sao này đã khiến nhiều người lo lắng những tháng gần đây khi đăng ảnh selfie trông hốc hác và yếu ớt.",
      "author": "ChatGPT4.1"
    },
    "81252": {
      "id": 2622633,
      "text": "\"Mong bạn đừng ngại hỏi xin giúp đỡ nếu cần,\" một fan bình luận.",
      "author": "ChatGPT4.1"
    },
    "81253": {
      "id": 2622634,
      "text": "Bức ảnh này từ năm ngoái cho thấy cô ấy có vẻ tóc mỏng đi và mắt vàng,",
      "author": "ChatGPT4.1"
    },
    "81254": {
      "id": 2622635,
      "text": "hai triệu chứng của bệnh gan.",
      "author": "ChatGPT4.1"
    },
    "81255": {
      "id": 2622636,
      "text": "\"Chúng tôi lo lắng cho bạn, bạn trông ốm yếu quá,\" bình luận này cho biết.",
      "author": "ChatGPT4.1"
    },
    "81256": {
      "id": 2622637,
      "text": "Cô đáp lại, \"Gần đây tôi nhận được khá nhiều bình luận về ngoại hình của mình.\"",
      "author": "ChatGPT4.1"
    },
    "81257": {
      "id": 2622638,
      "text": "\"Tôi vui vẻ và khỏe mạnh.\"",
      "author": "ChatGPT4.1"
    },
    "81258": {
      "id": 2622639,
      "text": "\"Nhìn lại mình đi, những kẻ ghét bỏ.\"",
      "author": "ChatGPT4.1"
    },
    "81259": {
      "id": 2622640,
      "text": "Cơ hội lớn đến với Trachtenberg khi cô chỉ mới 10 tuổi,",
      "author": "ChatGPT4.1"
    },
    "81260": {
      "id": 2622641,
      "text": "đóng vai chính trong Harriet the Spy.",
      "author": "ChatGPT4.1"
    },
    "81261": {
      "id": 2622642,
      "text": "Cô từng đến thăm trường quay của chúng tôi năm 1996.",
      "author": "ChatGPT4.1"
    },
    "81262": {
      "id": 2622643,
      "text": "\"Thật là một màn xuất hiện ấn tượng!\"",
      "author": "ChatGPT4.1"
    },
    "81263": {
      "id": 2622644,
      "text": "Bạn diễn của cô trong Harriet the Spy, Rosie O'Donnell, đã có phản ứng này:",
      "author": "ChatGPT4.1"
    },
    "81264": {
      "id": 2622645,
      "text": "\"Thật đau lòng. Tôi rất yêu quý cô ấy.\"",
      "author": "ChatGPT4.1"
    },
    "81265": {
      "id": 2622646,
      "text": "\"Cô ấy đã gặp nhiều khó khăn vài năm gần đây. Ước gì tôi có thể giúp đỡ.\"",
      "author": "ChatGPT4.1"
    },
    "81266": {
      "id": 2622647,
      "text": "Một ngôi sao trẻ, đầy triển vọng... giờ đã ra đi quá sớm.",
      "author": "ChatGPT4.1"
    }
  }
}
