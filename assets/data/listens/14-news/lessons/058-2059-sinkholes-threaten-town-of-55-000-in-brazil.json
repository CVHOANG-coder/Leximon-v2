  "translations": {
    "81194": {
      "id": 2615864,
      "text": "Một thị trấn toàn bộ ở Brazil có thể bị nuốt chửng bởi Trái Đất.",
      "author": "ChatGPT4.1"
    },
    "81195": {
      "id": 2615865,
      "text": "Thành phố Buri Tipu, nơi có 55.000 cư dân,",
      "author": "ChatGPT4.1"
    },
    "81196": {
      "id": 2615866,
      "text": "đã tuyên bố tình trạng thảm họa khi các hố sụt lún đe dọa nhà cửa.",
      "author": "ChatGPT4.1"
    },
    "81197": {
      "id": 2615867,
      "text": "Hiện tượng này là tự nhiên, nhưng các hoạt động của con người làm nó nghiêm trọng hơn.",
      "author": "ChatGPT4.1"
    },
    "81198": {
      "id": 2615868,
      "text": "Sự gia tăng này xảy ra thông qua việc xây dựng đường phố, đường sá, cống rãnh và hệ thống thu gom nước mưa,",
      "author": "ChatGPT4.1"
    },
    "81199": {
      "id": 2615869,
      "text": "những điều này cuối cùng làm tăng tốc một quá trình tự nhiên.",
      "author": "ChatGPT4.1"
    },
    "81200": {
      "id": 2615870,
      "text": "Các chuyên gia cho biết họ lo ngại về tốc độ mở rộng nhanh chóng của các hố sụt lún.",
      "author": "ChatGPT4.1"
    },
    "81201": {
      "id": 2615871,
      "text": "Cho đến nay, khoảng 1.200 ngôi nhà có nguy cơ bị sập,",
      "author": "ChatGPT4.1"
    },
    "81202": {
      "id": 2615872,
      "text": "và những người sống ở đó nói rằng họ không biết phải làm gì.",
      "author": "ChatGPT4.1"
    },
    "81203": {
      "id": 2615873,
      "text": "\"Đây là mối nguy hiểm: không ai biết cái hố này sẽ mở ra ở đâu bên dưới.\"",
      "author": "ChatGPT4.1"
    },
    "81204": {
      "id": 2615874,
      "text": "\"Khi nó mở ra, hàng rào được tạo ngay trước nhà ở gốc cây xoài,\"",
      "author": "ChatGPT4.1"
    },
    "81205": {
      "id": 2615875,
      "text": "\"và có một tiếng động lớn làm rung chuyển cả ngôi nhà.\"",
      "author": "ChatGPT4.1"
    },
    "81206": {
      "id": 2615876,
      "text": "\"Vì vậy, chúng tôi cần rời khỏi nơi nguy hiểm.\"",
      "author": "ChatGPT4.1"
    },
    "81207": {
      "id": 2615877,
      "text": "Giới chức tại thị trấn cho biết phương án tốt nhất là di dời cư dân,",
      "author": "ChatGPT4.1"
    },
    "81208": {
      "id": 2615878,
      "text": "mặc dù chưa có kế hoạch cụ thể nào để thực hiện việc này.",
      "author": "ChatGPT4.1"
    }
  }
}
