  "translations": {
    "92262": {
      "id": 3687828,
      "text": "Giờ đây là hai cô bé 10 tuổi đang gây náo động trong thế giới cờ vua thi đấu.",
      "author": "ChatGPT4.1"
    },
    "92263": {
      "id": 3687829,
      "text": "Các em đã trở thành cơn ác mộng đối với một vài đại kiện tướng.",
      "author": "ChatGPT4.1"
    },
    "92264": {
      "id": 3687830,
      "text": "Bodhana Sivanandan, 10 tuổi, đã làm nên lịch sử khi trở thành nữ trẻ nhất từng đánh bại một đại kiện tướng (đó là cấp bậc cao nhất trong cờ vua).",
      "author": "ChatGPT4.1"
    },
    "92265": {
      "id": 3687831,
      "text": "Cô đã đánh bại Pete Wells, 60 tuổi, trong vòng chung kết Giải vô địch Cờ vua Anh 2025 vào tuần trước.",
      "author": "ChatGPT4.1"
    },
    "92266": {
      "id": 3687832,
      "text": "Chỉ mới 10 tuổi, 5 tháng và 3 ngày, nhưng cô bé không phải là người mới.",
      "author": "ChatGPT4.1"
    },
    "92267": {
      "id": 3687833,
      "text": "Cô bắt đầu chơi từ năm 5 tuổi và giờ đã trở thành nữ kiện tướng trẻ nhất thế giới.",
      "author": "ChatGPT4.1"
    },
    "92268": {
      "id": 3687834,
      "text": "Và nghe này, bạn ơi, chỉ vài tiếng sau đó, một bé gái 10 tuổi khác lớn hơn chút đến từ Redwoods, California...",
      "author": "ChatGPT4.1"
    },
    "92269": {
      "id": 3687835,
      "text": "Keya Jha đã lập kỷ lục Mỹ là bé gái trẻ nhất đánh bại đại kiện tướng trong ván cờ tiêu chuẩn tại giải Joe Yun Memorial.",
      "author": "ChatGPT4.1"
    },
    "92270": {
      "id": 3687836,
      "text": "Với chiến thắng này, cô nhận được tấm séc trị giá 2000 đô la, bạn cờ nhé.",
      "author": "ChatGPT4.1"
    },
    "92271": {
      "id": 3687837,
      "text": "Đúng vậy, các nữ hoàng, hãy tiếp tục tỏa sáng!",
      "author": "ChatGPT4.1"
    }
  }
