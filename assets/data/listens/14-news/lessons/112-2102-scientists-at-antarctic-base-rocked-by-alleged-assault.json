  "translations": {
    "83087": {
      "id": 2671966,
      "text": "Một nhóm nhà khoa học nghiên cứu làm việc ở Nam Cực được cho là đã gửi lời kêu cứu khẩn thiết",
      "author": "ChatGPT4.1"
    },
    "83088": {
      "id": 2671967,
      "text": "sau khi họ nói rằng một đồng nghiệp đã đe dọa giết một trong số họ.",
      "author": "ChatGPT4.1"
    },
    "83089": {
      "id": 2671968,
      "text": "Nhóm Nam Phi hoàn toàn bị cô lập tại một trạm nghiên cứu xa xôi hàng ngàn dặm cách Nam Phi.",
      "author": "ChatGPT4.1"
    },
    "83090": {
      "id": 2671969,
      "text": "Mùa đông đang đến gần",
      "author": "ChatGPT4.1"
    },
    "83091": {
      "id": 2671970,
      "text": "và điều đó có nghĩa là phải mất nhiều tháng nữa nhóm này mới có thể được thay thế.",
      "author": "ChatGPT4.1"
    },
    "83092": {
      "id": 2671971,
      "text": "Sau đây là phóng viên khí hậu Justin Rollett của chúng tôi.",
      "author": "ChatGPT4.1"
    },
    "83093": {
      "id": 2671972,
      "text": "Trạm Sanae là một trong những nơi hẻo lánh nhất trên trái đất.",
      "author": "ChatGPT4.1"
    },
    "83094": {
      "id": 2671973,
      "text": "Mười người đã chuẩn bị để trải qua mùa đông Nam Cực ở đây.",
      "author": "ChatGPT4.1"
    },
    "83095": {
      "id": 2671974,
      "text": "Trạm nghiên cứu có đầy đủ tiện nghi như trong đoạn video tham quan quay cách đây bốn năm cho thấy.",
      "author": "ChatGPT4.1"
    },
    "83096": {
      "id": 2671975,
      "text": "Và ở đây chúng ta có phòng chơi game, đúng vậy, nơi mọi niềm vui diễn ra.",
      "author": "ChatGPT4.1"
    },
    "83097": {
      "id": 2671976,
      "text": "Nhưng thời tiết khắc nghiệt và bóng tối suốt 24 giờ",
      "author": "ChatGPT4.1"
    },
    "83098": {
      "id": 2671977,
      "text": "đồng nghĩa với việc nhóm hiện tại không mong gặp thêm con người nào trong khoảng sáu tháng.",
      "author": "ChatGPT4.1"
    },
    "83099": {
      "id": 2671978,
      "text": "Sau đó một email vào tuần trước cho rằng đã xảy ra một vụ tấn công bạo lực theo các báo Nam Phi.",
      "author": "ChatGPT4.1"
    },
    "83100": {
      "id": 2671979,
      "text": "Email này được cho là nói rằng một thành viên trong nhóm đã đe dọa giết một thành viên khác,",
      "author": "ChatGPT4.1"
    },
    "83101": {
      "id": 2671980,
      "text": "gây ra, theo lời email, một môi trường sợ hãi và đe dọa.",
      "author": "ChatGPT4.1"
    },
    "83102": {
      "id": 2671981,
      "text": "Các nhà chức trách Nam Phi đã xác nhận rằng đã có một vụ hành hung.",
      "author": "ChatGPT4.1"
    },
    "83103": {
      "id": 2671982,
      "text": "Họ cho biết đó là một tranh cãi về một nhiệm vụ phụ thuộc vào thời tiết đòi hỏi phải thay đổi lịch trình.",
      "author": "ChatGPT4.1"
    },
    "83104": {
      "id": 2671983,
      "text": "Nghe có vẻ không lớn nhưng những người từng sống ở Nam Cực nói rằng việc trú đông tại trạm nghiên cứu có thể là trải nghiệm cực kỳ căng thẳng.",
      "author": "ChatGPT4.1"
    },
    "83105": {
      "id": 2671984,
      "text": "Nếu bạn ở đó chỉ với, bạn biết đấy, có lẽ mười người khác như ở Sanae,",
      "author": "ChatGPT4.1"
    },
    "83106": {
      "id": 2671985,
      "text": "bạn sẽ biết mọi thứ về người còn lại.",
      "author": "ChatGPT4.1"
    },
    "83107": {
      "id": 2671986,
      "text": "Bạn biết chính xác cách họ đặt tách cà phê của mình xuống và quai tách chỉ về hướng nào.",
      "author": "ChatGPT4.1"
    },
    "83108": {
      "id": 2671987,
      "text": "Bạn biết rằng họ gãi mũi ba lần trước khi ngồi xuống.",
      "author": "ChatGPT4.1"
    },
    "83109": {
      "id": 2671988,
      "text": "Bạn biết tất cả về họ.",
      "author": "ChatGPT4.1"
    },
    "83110": {
      "id": 2671989,
      "text": "Và trong những hoàn cảnh xấu, điều đó có thể bắt đầu làm bạn khó chịu.",
      "author": "ChatGPT4.1"
    },
    "83111": {
      "id": 2671990,
      "text": "Bộ Môi trường Nam Phi cho biết họ đang phản ứng với sự khẩn cấp tối đa",
      "author": "ChatGPT4.1"
    },
    "83112": {
      "id": 2671991,
      "text": "nhưng với nhiệt độ giảm và thời tiết xấu đi khi mùa đông Nam Cực đến gần,",
      "author": "ChatGPT4.1"
    },
    "83113": {
      "id": 2671992,
      "text": "việc đưa một đội cứu hộ vào sẽ vô cùng thách thức.",
      "author": "ChatGPT4.1"
    }
  }
}
