  "translations": {
    "81398": {
      "id": 2642356,
      "text": "Nhìn chiếc xe này cất cánh và nhảy qua một chiếc xe tải.",
      "author": "ChatGPT4.1"
    },
    "81399": {
      "id": 2642357,
      "text": "Đây là một nguyên mẫu được chế tạo bởi công ty Alef Aeronautics,",
      "author": "ChatGPT4.1"
    },
    "81400": {
      "id": 2642358,
      "text": "công ty này hy vọng sẽ đưa chiếc xe bay trị giá 300.000 đô la này đến gần thực tế hơn.",
      "author": "ChatGPT4.1"
    },
    "81401": {
      "id": 2642359,
      "text": "Hiện tại, đối với hầu hết mọi người (đối với người tiêu dùng thông thường),",
      "author": "ChatGPT4.1"
    },
    "81402": {
      "id": 2642360,
      "text": "nó cực kỳ đắt đỏ vì chi phí sản xuất một chiếc rất cao đối với chúng tôi",
      "author": "ChatGPT4.1"
    },
    "81403": {
      "id": 2642361,
      "text": "nhưng đó là do sản xuất với số lượng rất thấp và rất kém hiệu quả.",
      "author": "ChatGPT4.1"
    },
    "81404": {
      "id": 2642362,
      "text": "Video dựng CGI này cho thấy chiếc xe đang bay xuyên qua những ngọn núi.",
      "author": "ChatGPT4.1"
    },
    "81405": {
      "id": 2642363,
      "text": "Cục Hàng không Liên bang Mỹ (FAA) cho biết xe của Alef Aeronautics không phải là loại máy bay đầu tiên kiểu này được cấp giấy chứng nhận đủ điều kiện bay đặc biệt.",
      "author": "ChatGPT4.1"
    },
    "81406": {
      "id": 2642364,
      "text": "Tuy nhiên, công ty lưu ý rằng phương tiện của họ nổi bật",
      "author": "ChatGPT4.1"
    },
    "81407": {
      "id": 2642365,
      "text": "vì nó có thể chạy trên đường, bay, và được sử dụng cho công tác tìm kiếm cứu nạn.",
      "author": "ChatGPT4.1"
    },
    "81408": {
      "id": 2642366,
      "text": "Các mẫu xe từ các công ty như SkyDrive, HoverSurf, Volocopter và những công ty khác vẫn chưa ra mắt thị trường",
      "author": "ChatGPT4.1"
    },
    "81409": {
      "id": 2642367,
      "text": "và biến xe bay thành hiện thực.",
      "author": "ChatGPT4.1"
    }
  }
