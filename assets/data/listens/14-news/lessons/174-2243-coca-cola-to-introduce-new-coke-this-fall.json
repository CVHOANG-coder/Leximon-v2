  "translations": {
    "89147": {
      "id": 3509185,
      "text": "\"CocaCola có một thông báo quan trọng...\"",
      "author": "ChatGPT4.1"
    },
    "89148": {
      "id": 3509186,
      "text": "\"Họ sẽ bắt đầu sử dụng đường mía thật ở Hoa Kỳ.\"",
      "author": "ChatGPT4.1"
    },
    "89149": {
      "id": 3509187,
      "text": "Mùa thu này, Coca-Cola sẽ ra mắt một loại Coke mới được làm ngọt bằng đường mía Mỹ thay vì siro bắp nhiều đường fructose.",
      "author": "ChatGPT4.1"
    },
    "89150": {
      "id": 3509188,
      "text": "Tổng thống Trump, người có một nút gọi Diet Coke trên bàn làm việc Resolute, đang ăn mừng tin tức này.",
      "author": "ChatGPT4.1"
    },
    "89151": {
      "id": 3509189,
      "text": "\"Đây sẽ là một bước đi rất tốt của họ, các bạn sẽ thấy, nó thực sự tốt hơn,\" ông đăng tải.",
      "author": "ChatGPT4.1"
    },
    "89152": {
      "id": 3509190,
      "text": "Nếu bạn hỏi chính quyền Trump, bao gồm cả Bộ trưởng Y tế và Dịch vụ Nhân sinh, Robert F. Kennedy Jr.,",
      "author": "ChatGPT4.1"
    },
    "89153": {
      "id": 3509191,
      "text": "họ sẽ nói đúng, đây là phản hồi cho chiến dịch Làm nước Mỹ khỏe lại của chúng tôi.",
      "author": "ChatGPT4.1"
    },
    "89154": {
      "id": 3509192,
      "text": "Tuy nhiên, đây cũng là những xu hướng mà ngành công nghiệp đã theo đuổi.",
      "author": "ChatGPT4.1"
    },
    "89155": {
      "id": 3509193,
      "text": "\"Đây là một chai thật với sản phẩm thật được làm ngọt bằng đường mía.\"",
      "author": "ChatGPT4.1"
    },
    "89156": {
      "id": 3509194,
      "text": "Giám đốc điều hành Coke, James Quincy, đã giới thiệu Coke mới trên Fox Business.",
      "author": "ChatGPT4.1"
    },
    "89157": {
      "id": 3509195,
      "text": "\"Việc sản xuất sẽ tốn kém hơn một chút.\"",
      "author": "ChatGPT4.1"
    },
    "89158": {
      "id": 3509196,
      "text": "Loại Coca-Cola bạn thường uống được làm ngọt bằng siro bắp nhiều fructose,",
      "author": "ChatGPT4.1"
    },
    "89159": {
      "id": 3509197,
      "text": "nhưng bây giờ bạn có thể chọn uống với đường mía nguyên chất, giống như cách được làm ở nhiều quốc gia khác, bao gồm cả Mexico.",
      "author": "ChatGPT4.1"
    },
    "89160": {
      "id": 3509198,
      "text": "Nhưng liệu vị của nó có khác không?",
      "author": "ChatGPT4.1"
    },
    "89161": {
      "id": 3509199,
      "text": "Chúng tôi đã đến giao lộ của thế giới, Quảng trường Thời Đại, để làm thử nghiệm vị của mình.",
      "author": "ChatGPT4.1"
    },
    "89162": {
      "id": 3509200,
      "text": "\"Tôi sẽ để các bạn thử Coke thường và Coke làm bằng đường thật.\"",
      "author": "ChatGPT4.1"
    },
    "89163": {
      "id": 3509201,
      "text": "\"Xem thử các bạn có nhận ra sự khác biệt không nhé?\"",
      "author": "ChatGPT4.1"
    },
    "89164": {
      "id": 3509202,
      "text": "\"Loại đầu tiên là đường mía và loại thứ hai là siro bắp nhiều fructose.\"",
      "author": "ChatGPT4.1"
    },
    "89165": {
      "id": 3509203,
      "text": "Và anh ta hoàn toàn đúng.",
      "author": "ChatGPT4.1"
    },
    "89166": {
      "id": 3509204,
      "text": "Liệu đường mía có phải là lựa chọn lành mạnh hơn không?",
      "author": "ChatGPT4.1"
    },
    "89167": {
      "id": 3509205,
      "text": "Và nếu xét về việc mọi người nghĩ đó là lựa chọn lành mạnh hơn, thì không phải vậy.",
      "author": "ChatGPT4.1"
    },
    "89168": {
      "id": 3509206,
      "text": "Lượng đường sẽ vẫn như nhau, đúng không?",
      "author": "ChatGPT4.1"
    },
    "89169": {
      "id": 3509207,
      "text": "Trong khi đó, Pepsi đang ra mắt một loại nước ngọt prebiotic mới.",
      "author": "ChatGPT4.1"
    },
    "89171": {
      "id": 3509209,
      "text": "Tốt cho sức khỏe đường ruột.",
      "author": "ChatGPT4.1"
    },
