  "translations": {
    "79838": {
      "id": 2689502,
      "text": "Nhiều người tin rằng đồng xu 1 cent thật phiền toái và gây rắc rối,",
      "author": "ChatGPT4.1"
    },
    "79839": {
      "id": 2689503,
      "text": "nói rằng những đồng xu mệnh giá một cent này chẳng hợp lý chút nào.",
      "author": "ChatGPT4.1"
    },
    "79840": {
      "id": 2689504,
      "text": "Tuần này, Tổng thống Donald Trump cho biết ông sẽ ra lệnh cho Sở đúc tiền Hoa Kỳ ngừng sản xuất đồng penny,",
      "author": "ChatGPT4.1"
    },
    "79841": {
      "id": 2689505,
      "text": "chủ yếu vì chi phí chế tạo chúng cao hơn rất nhiều so với giá trị thực để lưu trữ, nhưng...",
      "author": "ChatGPT4.1"
    },
    "79842": {
      "id": 2689506,
      "text": "liệu có thực sự hợp lý khi loại bỏ đồng penny không?",
      "author": "ChatGPT4.1"
    },
    "79843": {
      "id": 2689507,
      "text": "Nhiều người khác lại cho rằng không nên.",
      "author": "ChatGPT4.1"
    },
    "79844": {
      "id": 2689508,
      "text": "Phóng viên Brian Todd của chúng tôi sẽ phân tích một số ưu và nhược điểm của việc loại bỏ đồng xu 1 cent mang tính biểu tượng này.",
      "author": "ChatGPT4.1"
    },
    "79845": {
      "id": 2689509,
      "text": "Với một số người, chúng mang lại cảm giác an tâm, kêu lách cách trong túi quần,",
      "author": "ChatGPT4.1"
    },
    "79846": {
      "id": 2689510,
      "text": "luôn sẵn có nếu cần dùng tại cửa hàng tiện lợi hoặc quán cà phê để thanh toán đúng số tiền.",
      "author": "ChatGPT4.1"
    },
    "79847": {
      "id": 2689511,
      "text": "Với người khác, chúng là điều phiền phức, gần như không bao giờ dùng đến nên bị bỏ trong lọ, khay đựng cốc, hoặc trên đường phố.",
      "author": "ChatGPT4.1"
    },
    "79848": {
      "id": 2689512,
      "text": "Hiện nay, đang có làn sóng mới kêu gọi loại bỏ đồng penny, hoặc ít nhất là ngừng sản xuất nó.",
      "author": "ChatGPT4.1"
    },
    "79849": {
      "id": 2689513,
      "text": "Trong suốt thời gian dài, Hoa Kỳ đã đúc những đồng penny thực tế có chi phí hơn 2 cent cho mỗi đồng.",
      "author": "ChatGPT4.1"
    },
    "79850": {
      "id": 2689514,
      "text": "Điều này thật lãng phí; thực tế phải tốn 3,7 cent để sản xuất một đồng penny,",
      "author": "ChatGPT4.1"
    },
    "79851": {
      "id": 2689515,
      "text": "theo một báo cáo năm ngoái từ Sở đúc tiền Hoa Kỳ.",
      "author": "ChatGPT4.1"
    },
    "79852": {
      "id": 2689516,
      "text": "Một trong những lý do khiến các chuyên gia phản đối penny như Giáo sư Robert Whaples cho rằng đã đến lúc chấm dứt mối liên kết với đồng xu này:",
      "author": "ChatGPT4.1"
    },
    "79853": {
      "id": 2689517,
      "text": "Bạn có thể thấy nhiều người coi chúng là điều phiền toái và chẳng mang chúng trở lại cửa hàng.",
      "author": "ChatGPT4.1"
    },
    "79854": {
      "id": 2689518,
      "text": "Bạn bắt gặp chúng nằm trên vỉa hè; người ta thậm chí còn chẳng buồn nhặt lên.",
      "author": "ChatGPT4.1"
    },
    "79855": {
      "id": 2689519,
      "text": "Ông Whaples lập luận rằng vì nhiều người Mỹ không mang penny quay lại cửa hàng để tiêu,",
      "author": "ChatGPT4.1"
    },
    "79856": {
      "id": 2689520,
      "text": "nên các cửa hàng bị thiếu penny và phải xin thêm từ ngân hàng,",
      "author": "ChatGPT4.1"
    },
    "79857": {
      "id": 2689521,
      "text": "rồi ngân hàng lại yêu cầu Sở đúc tiền Hoa Kỳ sản xuất thêm loại tiền mà chúng ta ngày càng ít sử dụng.",
      "author": "ChatGPT4.1"
    },
    "79858": {
      "id": 2689522,
      "text": "Nhưng ông Mark Weller, giám đốc nhóm ủng hộ penny “Người Mỹ Vì Lẽ Thường”,",
      "author": "ChatGPT4.1"
    },
    "79859": {
      "id": 2689523,
      "text": "được tài trợ bởi một công ty sản xuất đĩa kim loại dùng để đúc xu,",
      "author": "ChatGPT4.1"
    },
    "79860": {
      "id": 2689524,
      "text": "lập luận rằng việc loại bỏ đồng penny sẽ gây ra lạm phát,",
      "author": "ChatGPT4.1"
    },
    "79861": {
      "id": 2689525,
      "text": "vì các doanh nghiệp sẽ bắt đầu làm tròn giao dịch lên đồng nickel gần nhất",
      "author": "ChatGPT4.1"
    },
    "79862": {
      "id": 2689526,
      "text": "và thường có xu hướng làm tròn lên hơn là làm tròn xuống.",
      "author": "ChatGPT4.1"
    },
    "79863": {
      "id": 2689527,
      "text": "Liệu Tổng thống Trump có quyền đơn phương loại bỏ đồng penny không?",
      "author": "ChatGPT4.1"
    },
    "79864": {
      "id": 2689528,
      "text": "Các chuyên gia cho rằng ông có thể ra lệnh cho Bộ Tài chính ngừng sản xuất các đồng penny mới,",
      "author": "ChatGPT4.1"
    },
    "79865": {
      "id": 2689529,
      "text": "nhưng muốn ngừng sử dụng các đồng penny đã lưu hành thì cần phải có một đạo luật của Quốc hội.",
      "author": "ChatGPT4.1"
    },
    "79866": {
      "id": 2689530,
      "text": "Và chính phủ liên bang cũng sẽ phải mua lại các đồng penny đã phát hành, điều này sẽ rất tốn kém.",
      "author": "ChatGPT4.1"
    }
  }
