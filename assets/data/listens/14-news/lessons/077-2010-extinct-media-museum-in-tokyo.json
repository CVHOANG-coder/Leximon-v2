  "translations": {
    "78291": {
      "id": 2588317,
      "text": "Những người sinh năm 2004 có lẽ chưa bao giờ phải trả lời điện thoại quay số.",
      "author": "ChatGPT4.1"
    },
    "78292": {
      "id": 2588318,
      "text": "Nhưng bảo tàng này cho họ cơ hội được trải nghiệm điều đó.",
      "author": "ChatGPT4.1"
    },
    "78293": {
      "id": 2588319,
      "text": "Bảo tàng Truyền thông Tuyệt chủng thu hút những bộ óc tò mò ở Tokyo, Nhật Bản.",
      "author": "ChatGPT4.1"
    },
    "78294": {
      "id": 2588320,
      "text": "Những kệ trưng bày lộn xộn này là nơi đặt các di vật từ quá khứ công nghệ chung của chúng ta.",
      "author": "ChatGPT4.1"
    },
    "78295": {
      "id": 2588321,
      "text": "Phó giám tuyển của bảo tàng giải thích:",
      "author": "ChatGPT4.1"
    },
    "78296": {
      "id": 2588322,
      "text": "bảo tàng được thành lập dựa trên nguyên tắc rằng mọi phương tiện truyền thông ngoài giấy và đá đều sẽ biến mất.",
      "author": "ChatGPT4.1"
    },
    "78297": {
      "id": 2588323,
      "text": "Khác với hầu hết các bảo tàng, tất cả vật trưng bày ở đây đều được phép chạm và cầm nắm.",
      "author": "ChatGPT4.1"
    },
    "78298": {
      "id": 2588324,
      "text": "Mọi người được khuyến khích cảm nhận máy ảnh trước đây từng nặng như thế nào",
      "author": "ChatGPT4.1"
    },
    "78299": {
      "id": 2588325,
      "text": "trước khi chúng trở thành bộ phận thường thấy trên điện thoại di động của chúng ta.",
      "author": "ChatGPT4.1"
    },
    "78300": {
      "id": 2588326,
      "text": "Cũng như loài khủng long, các đĩa mềm và dụng cụ lưu trữ truyền thông sơ khai này đều đã tuyệt chủng.",
      "author": "ChatGPT4.1"
    },
    "78301": {
      "id": 2588327,
      "text": "Thấy chúng được trưng bày cho thấy công nghệ máy tính đã đi được bao xa và thu nhỏ đến mức nào.",
      "author": "ChatGPT4.1"
    },
    "78302": {
      "id": 2588328,
      "text": "Theo bảo tàng, phần lớn các hiện vật được trưng bày đều do quyên tặng.",
      "author": "ChatGPT4.1"
    },
    "78303": {
      "id": 2588329,
      "text": "Với một số người, Bảo tàng Truyền thông Tuyệt chủng mang lại cảm giác hoài niệm về quá khứ.",
      "author": "ChatGPT4.1"
    },
    "78304": {
      "id": 2588330,
      "text": "Và với người khác, đây là một cái nhìn thoáng qua về lịch sử.",
      "author": "ChatGPT4.1"
    }
  }
}
