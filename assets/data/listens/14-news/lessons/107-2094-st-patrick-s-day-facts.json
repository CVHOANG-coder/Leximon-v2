  "translations": {
    "82818": {
      "id": 2685954,
      "text": "Chào bạn, ánh nắng!",
      "author": "ChatGPT4.1"
    },
    "82819": {
      "id": 2685955,
      "text": "Hôm nay là thứ Hai, ngày 17 tháng 3. Chúc mừng ngày Thánh Patrick!",
      "author": "ChatGPT4.1"
    },
    "82820": {
      "id": 2685956,
      "text": "Hy vọng bạn gặp một chút may mắn của ngày Thánh Patrick vào ngày thứ Hai này.",
      "author": "ChatGPT4.1"
    },
    "82821": {
      "id": 2685957,
      "text": "Thánh Patrick, được kỷ niệm vào ngày này mỗi năm vì người ta cho rằng ông đã qua đời vào khoảng thời gian này vào giữa thế kỷ 5.",
      "author": "ChatGPT4.1"
    },
    "82822": {
      "id": 2685958,
      "text": "Bạn có biết rằng vị thánh bảo trợ chính của Ireland này không phải là người Ireland không?",
      "author": "ChatGPT4.1"
    },
    "82823": {
      "id": 2685959,
      "text": "Ông sinh ra ở Anh quốc thuộc La Mã, không phải ở Ireland,",
      "author": "ChatGPT4.1"
    },
    "82824": {
      "id": 2685960,
      "text": "và bị bắt cóc đưa sang Ireland làm nô lệ khi mới 16 tuổi.",
      "author": "ChatGPT4.1"
    },
    "82825": {
      "id": 2685961,
      "text": "Ông đã chăn cừu nhiều năm trước khi trốn thoát đến một tu viện ở Anh.",
      "author": "ChatGPT4.1"
    },
    "82826": {
      "id": 2685962,
      "text": "Và tại đó, ông trở thành một tín đồ trung thành của Kitô giáo và được phong làm giám mục.",
      "author": "ChatGPT4.1"
    },
    "82827": {
      "id": 2685963,
      "text": "Sau đó, ông đã trở lại Ireland với vai trò nhà truyền giáo, nơi người ta nói rằng ông đã sử dụng cây cỏ ba lá",
      "author": "ChatGPT4.1"
    },
    "82828": {
      "id": 2685964,
      "text": "để giải thích về ba ngôi Thiên Chúa khi thuyết giảng.",
      "author": "ChatGPT4.1"
    }
  }
