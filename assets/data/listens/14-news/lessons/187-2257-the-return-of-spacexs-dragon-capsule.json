  "translations": {
    "89410": {
      "id": 3582888,
      "text": "Một nhóm phi hành gia đã trở về Trái Đất sau gần 5 tháng trên Trạm Vũ trụ Quốc tế.",
      "author": "ChatGPT4.1"
    },
    "89411": {
      "id": 3582889,
      "text": "Họ đã trở về bằng một tàu con thoi SpaceX Dragon vào thứ Bảy.",
      "author": "ChatGPT4.1"
    },
    "89412": {
      "id": 3582890,
      "text": "Đây là lần hạ cánh có người lái xuống Thái Bình Dương thứ ba của SpaceX, một công ty thám hiểm tư nhân.",
      "author": "ChatGPT4.1"
    },
    "89413": {
      "id": 3582891,
      "text": "Nhưng vì công ty đã hợp tác với các phi hành gia của NASA, đây là một cột mốc quan trọng đối với Mỹ.",
      "author": "ChatGPT4.1"
    },
    "89414": {
      "id": 3582892,
      "text": "Đây là lần hạ cánh xuống biển đầu tiên của NASA trong 50 năm qua.",
      "author": "ChatGPT4.1"
    },
    "89415": {
      "id": 3582893,
      "text": "Hai người Mỹ đã trở về trên tàu Dragon cùng với các phi hành gia từ Nhật Bản và Nga.",
      "author": "ChatGPT4.1"
    },
    "89416": {
      "id": 3582894,
      "text": "Lần cuối cùng các phi hành gia của NASA đáp xuống Thái Bình Dương là trong sứ mệnh Apollo Soya năm 1975.",
      "author": "ChatGPT4.1"
    }
  }
