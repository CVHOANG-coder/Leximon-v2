  "translations": {
    "77896": {
      "id": 2655644,
      "text": "Một tài xế Uber ở Colorado đang nổi tiếng trên mạng xã hội sau khi nâng tầm công việc lái xe của mình",
      "author": "ChatGPT4.1"
    },
    "77897": {
      "id": 2655645,
      "text": "bằng một ý tưởng rất đơn giản:",
      "author": "ChatGPT4.1"
    },
    "77898": {
      "id": 2655646,
      "text": "Ai mà không yêu chó cơ chứ?",
      "author": "ChatGPT4.1"
    },
    "77899": {
      "id": 2655647,
      "text": "Kevin Ferman nói rằng việc mang theo chú chó 3 tuổi của mình, Bowie, trong các ca lái Uber thực ra là điều quá dễ dàng.",
      "author": "ChatGPT4.1"
    },
    "77900": {
      "id": 2655648,
      "text": "Colorado là nơi rất thân thiện với chó, nên tôi biết mọi người sẽ thích điều đó.",
      "author": "ChatGPT4.1"
    },
    "77901": {
      "id": 2655649,
      "text": "Ngay lập tức, ý tưởng này đã thành công lớn. Tất cả hành khách của tôi đều yêu thích điều đó.",
      "author": "ChatGPT4.1"
    },
    "77902": {
      "id": 2655650,
      "text": "Bowie không chỉ được khách đi xe yêu thích mà còn được rất nhiều người theo dõi trên mạng xã hội.",
      "author": "ChatGPT4.1"
    },
    "77903": {
      "id": 2655651,
      "text": "Kevin cho biết Bowie đã trở nên nổi tiếng trên YouTube và TikTok.",
      "author": "ChatGPT4.1"
    },
    "77904": {
      "id": 2655652,
      "text": "Và lượt xem cùng người theo dõi tăng vọt chỉ sau một đêm,",
      "author": "ChatGPT4.1"
    },
    "77905": {
      "id": 2655653,
      "text": "biến chú chó Uber tuyệt vời này thành hiện tượng mạng xã hội cực kỳ nhanh chóng.",
      "author": "ChatGPT4.1"
    },
    "77906": {
      "id": 2655654,
      "text": "Thỉnh thoảng tôi tự hỏi không biết nó có biết điều đó không...",
      "author": "ChatGPT4.1"
    },
    "77907": {
      "id": 2655655,
      "text": "nó cũng khá nổi tiếng.",
      "author": "ChatGPT4.1"
    },
    "77908": {
      "id": 2655656,
      "text": "Dù đã đạt được sự nổi tiếng, công thức vẫn không đổi.",
      "author": "ChatGPT4.1"
    },
    "77909": {
      "id": 2655657,
      "text": "Bowie mang lại tình yêu thương nhẹ nhàng và sự quan tâm.",
      "author": "ChatGPT4.1"
    },
    "77910": {
      "id": 2655658,
      "text": "Kevin sẽ đưa bạn đến nơi an toàn.",
      "author": "ChatGPT4.1"
    }
  }
}
