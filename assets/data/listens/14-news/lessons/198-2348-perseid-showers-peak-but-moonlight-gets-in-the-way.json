  "translations": {
    "92249": {
      "id": 3687811,
      "text": "Gọi tất cả những người yêu thích ngắm sao!",
      "author": "ChatGPT4.1"
    },
    "92250": {
      "id": 3687812,
      "text": "Tối nay đánh dấu đỉnh điểm của trận mưa sao băng nổi tiếng nhất trong năm, mưa sao băng Perseids.",
      "author": "ChatGPT4.1"
    },
    "92251": {
      "id": 3687813,
      "text": "Nhưng bạn có thể sẽ khó quan sát được nó.",
      "author": "ChatGPT4.1"
    },
    "92252": {
      "id": 3687814,
      "text": "Thủ phạm là gì? Một mặt trăng tròn.",
      "author": "ChatGPT4.1"
    },
    "92253": {
      "id": 3687815,
      "text": "Ánh sáng từ người hàng xóm mặt trăng của chúng ta sẽ làm lu mờ bóng tối,",
      "author": "ChatGPT4.1"
    },
    "92254": {
      "id": 3687816,
      "text": "khiến cho việc nhìn thấy các sao băng bay qua bầu trời với vận tốc 37 dặm mỗi giây trở nên khó khăn hơn.",
      "author": "ChatGPT4.1"
    },
    "92255": {
      "id": 3687817,
      "text": "Vẫn muốn thử vận may chứ?",
      "author": "ChatGPT4.1"
    },
    "92256": {
      "id": 3687818,
      "text": "Các nhà khoa học cho biết lựa chọn tốt nhất của bạn là từ 10 giờ tối đến trước bình minh.",
      "author": "ChatGPT4.1"
    },
    "92257": {
      "id": 3687819,
      "text": "Bạn có thể quan sát sao băng bằng mắt thường, nhưng...",
      "author": "ChatGPT4.1"
    },
    "92258": {
      "id": 3687820,
      "text": "bạn nên mang theo một cái ghế thoải mái và sự kiên nhẫn.",
      "author": "ChatGPT4.1"
    },
    "92259": {
      "id": 3687821,
      "text": "Dù bạn có thể quan sát tới 25 sao băng mỗi giờ, nhưng không có gì đảm bảo cả.",
      "author": "ChatGPT4.1"
    },
    "92260": {
      "id": 3687822,
      "text": "Và nếu bạn bỏ lỡ, đừng lo lắng.",
      "author": "ChatGPT4.1"
    },
    "92261": {
      "id": 3687823,
      "text": "NASA cho biết một trận mưa sao băng nổi tiếng khác, Geminids, sẽ có điều kiện quan sát không có mặt trăng vào tháng Mười Hai.",
      "author": "ChatGPT4.1"
    }
  }
}
