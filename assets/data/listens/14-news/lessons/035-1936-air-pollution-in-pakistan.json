  "translations": {
    "74815": {
      "id": 2589772,
      "text": "Giao thông ở Lahore vẫn đang lưu thông.",
      "author": "ChatGPT4.1"
    },
    "74816": {
      "id": 2589773,
      "text": "Các quan chức chính phủ đang kêu gọi người dân ở nhà.",
      "author": "ChatGPT4.1"
    },
    "74817": {
      "id": 2589774,
      "text": "Sương mù quá độc hại.",
      "author": "ChatGPT4.1"
    },
    "74818": {
      "id": 2589775,
      "text": "Đối với một thành phố thường được xếp vào nhóm ô nhiễm không khí tồi tệ nhất thế giới,",
      "author": "ChatGPT4.1"
    },
    "74819": {
      "id": 2589776,
      "text": "khẩu trang là bắt buộc.",
      "author": "ChatGPT4.1"
    },
    "74820": {
      "id": 2589777,
      "text": "Một lớp màng mỏng chống lại lượng chất ô nhiễm trong không khí tăng vọt.",
      "author": "ChatGPT4.1"
    },
    "74821": {
      "id": 2589778,
      "text": "Chỉ số chất lượng không khí của thành phố lại vượt ngưỡng 1000 vào tuần trước.",
      "author": "ChatGPT4.1"
    },
    "74822": {
      "id": 2589779,
      "text": "Đó là một mức độ chưa từng có,",
      "author": "ChatGPT4.1"
    },
    "74823": {
      "id": 2589780,
      "text": "vì chỉ số AQI định nghĩa mức nguy hiểm là bất cứ gì trên 301.",
      "author": "ChatGPT4.1"
    },
    "74824": {
      "id": 2589781,
      "text": "Nhiều không gian công cộng như sở thú, công viên và di tích lịch sử đã bị đóng cửa.",
      "author": "ChatGPT4.1"
    },
    "74825": {
      "id": 2589782,
      "text": "Cùng với nhiều trường học chuyển sang dạy trực tuyến ít nhất một tuần nữa.",
      "author": "ChatGPT4.1"
    }
  }
