  "translations": {
    "87156": {
      "id": 3289918,
      "text": "Mỗi tháng, một nhóm người tập trung tại một ngôi nhà lịch sử ở New York để tham gia một hoạt động yên tĩnh.",
      "author": "ChatGPT4.1"
    },
    "87157": {
      "id": 3289919,
      "text": "\"Hãy chọn tài liệu mà bạn muốn và bạn có thể bắt đầu viết.\"",
      "author": "ChatGPT4.1"
    },
    "87158": {
      "id": 3289920,
      "text": "Họ dành thời gian để chép tay lại bản Hiến pháp Hoa Kỳ.",
      "author": "ChatGPT4.1"
    },
    "87159": {
      "id": 3289921,
      "text": "Maggie Weber nói với CBS News rằng bà tổ chức các sự kiện này tại Old Stonehouse ở Brooklyn, nơi diễn ra trận chiến quan trọng của Chiến tranh Cách mạng,",
      "author": "ChatGPT4.1"
    },
    "87160": {
      "id": 3289922,
      "text": "để giúp người tham gia có cảm giác gắn kết với quãng thời gian trong quá khứ đó.",
      "author": "ChatGPT4.1"
    },
    "87161": {
      "id": 3289923,
      "text": "Được viết cách đây hàng trăm năm, những lời lẽ ấy vẫn còn quan trọng đến ngày nay.",
      "author": "ChatGPT4.1"
    },
    "87162": {
      "id": 3289924,
      "text": "\"Bạn không cần một luật sư về hiến pháp để giải thích nó cho bạn.\"",
      "author": "ChatGPT4.1"
    },
    "87163": {
      "id": 3289925,
      "text": "\"Bạn có thể tự lấy một bản và đọc nó cho riêng mình.\"",
      "author": "ChatGPT4.1"
    },
    "87164": {
      "id": 3289926,
      "text": "Trong khi một số người cho rằng họ được tập luyện khá tốt...",
      "author": "ChatGPT4.1"
    },
    "87165": {
      "id": 3289927,
      "text": "\"Tay tôi bị đau... đặc biệt là cánh tay.\"",
      "author": "ChatGPT4.1"
    },
    "87166": {
      "id": 3289928,
      "text": "những người khác cho rằng đây là dịp để suy ngẫm về tự do ở Hoa Kỳ và trên khắp thế giới.",
      "author": "ChatGPT4.1"
    },
    "87167": {
      "id": 3289929,
      "text": "\"Thật khó để đọc những lời này và biết rằng nó áp dụng ở một số nơi nhưng không phải nơi khác, kể cả ở đất nước này.\"",
      "author": "ChatGPT4.1"
    },
    "87168": {
      "id": 3289930,
      "text": "Người sáng lập sự kiện nói rằng hoạt động này không bao giờ mang tính chính trị và tài liệu đó được viết cho tất cả người Mỹ.",
      "author": "ChatGPT4.1"
    }
  }
}
