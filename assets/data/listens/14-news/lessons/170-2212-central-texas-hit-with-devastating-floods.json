  "translations": {
    "87466": {
      "id": 3353747,
      "text": "Các cộng đồng ở miền trung Texas đang choáng váng sau trận lũ lụt tàn phá cuối tuần qua.",
      "author": "ChatGPT4.1"
    },
    "87467": {
      "id": 3353748,
      "text": "Một nhân chứng nói với các phóng viên: \"Có hàng chục xe chỉ trôi đi mất.\"",
      "author": "ChatGPT4.1"
    },
    "87468": {
      "id": 3353749,
      "text": "Nhà chức trách báo cáo đã tiến hành hàng chục cuộc cứu hộ bằng trực thăng.",
      "author": "ChatGPT4.1"
    },
    "87469": {
      "id": 3353750,
      "text": "Các đội tìm kiếm cứu hộ và tình nguyện viên đã lùng sục dọc bờ sông Guadalupe để tìm kiếm người sống sót và nạn nhân.",
      "author": "ChatGPT4.1"
    },
    "87470": {
      "id": 3353751,
      "text": "Một tình nguyện viên nói: \"Nó sẽ giúp tôi cảm thấy nhẹ lòng khi biết chắc chắn chuyện gì đã xảy ra thay vì cứ băn khoăn tự hỏi liệu người tôi yêu còn ở ngoài đó không.\"",
      "author": "ChatGPT4.1"
    },
    "87471": {
      "id": 3353752,
      "text": "Các quan chức cho biết số người chết đã vượt quá 80 và còn nhiều người mất tích.",
      "author": "ChatGPT4.1"
    },
    "87472": {
      "id": 3353753,
      "text": "Trên đường đi của lũ lụt có Trại Mystic, một trại hè dành cho các bé gái.",
      "author": "ChatGPT4.1"
    },
    "87473": {
      "id": 3353754,
      "text": "Có khoảng 750 trẻ em ở trong trại vào lúc lũ ập đến.",
      "author": "ChatGPT4.1"
    },
    "87474": {
      "id": 3353755,
      "text": "Nhà chức trách cho biết ít nhất 27 trại sinh và cố vấn đã thiệt mạng.",
      "author": "ChatGPT4.1"
    },
    "87475": {
      "id": 3353756,
      "text": "Thống đốc Texas Greg Abbott đã đi thị sát hiện trường.",
      "author": "ChatGPT4.1"
    },
    "87476": {
      "id": 3353757,
      "text": "\"Chúng tôi sẽ cống hiến 100% công sức để tìm kiếm từng em nhỏ.\"",
      "author": "ChatGPT4.1"
    },
    "87477": {
      "id": 3353758,
      "text": "Theo yêu cầu của thống đốc, Tổng thống Trump đã ký ban bố tình trạng thảm họa nghiêm trọng cho hạt Kerr.",
      "author": "ChatGPT4.1"
    }
  }
}
