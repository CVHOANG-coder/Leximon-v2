  "translations": {
    "81727": {
      "id": 3045428,
      "text": "Dolly Parton đang đau buồn trước sự ra đi của người chồng gần 60 năm, Carl Dean.",
      "author": "ChatGPT4.1"
    },
    "81728": {
      "id": 3045429,
      "text": "Đây là bức ảnh của họ trong những ngày đầu tiên của cuộc hôn nhân.",
      "author": "ChatGPT4.1"
    },
    "81729": {
      "id": 3045430,
      "text": "Và đây là ông trong một bức ảnh hiếm hoi chụp năm 2019.",
      "author": "ChatGPT4.1"
    },
    "81730": {
      "id": 3045431,
      "text": "\"Carl và tôi đã cùng nhau trải qua nhiều năm tháng tuyệt vời.\"",
      "author": "ChatGPT4.1"
    },
    "81731": {
      "id": 3045432,
      "text": "\"Không lời nào có thể lột tả hết tình yêu chúng tôi đã cùng chia sẻ suốt hơn 60 năm.\"",
      "author": "ChatGPT4.1"
    },
    "81732": {
      "id": 3045433,
      "text": "\"Cảm ơn vì những lời cầu nguyện và sự chia sẻ của các bạn,\" Dolly đăng tải.",
      "author": "ChatGPT4.1"
    },
    "81733": {
      "id": 3045434,
      "text": "Bà từng kể với Johnny Carson rằng họ gặp nhau ở tiệm giặt ủi",
      "author": "ChatGPT4.1"
    },
    "81734": {
      "id": 3045435,
      "text": "vào chính ngày bà chuyển đến Nashville năm 1964.",
      "author": "ChatGPT4.1"
    },
    "81735": {
      "id": 3045436,
      "text": "\"Tôi cho quần áo vào máy giặt,\"",
      "author": "ChatGPT4.1"
    },
    "81736": {
      "id": 3045437,
      "text": "\"và tôi lấy một ly nước lạnh. Tôi chỉ đi dọc theo vỉa hè, lang thang ngắm nhìn Nashville.\"",
      "author": "ChatGPT4.1"
    },
    "81737": {
      "id": 3045438,
      "text": "\"Rồi một chàng trai bảnh bao đi ngang qua, và chúng tôi gặp nhau ở tiệm Wishy-Washy...\"",
      "author": "ChatGPT4.1"
    },
    "81738": {
      "id": 3045439,
      "text": "Ca khúc hit Jolene của bà được lấy cảm hứng từ một sự kiện khi Parton nói rằng một nhân viên ngân hàng đã tán tỉnh chồng bà.",
      "author": "ChatGPT4.1"
    },
    "81739": {
      "id": 3045440,
      "text": "Nữ danh ca Dolly Parton và ông xã Carl: một chuyện tình bền lâu.",
      "author": "ChatGPT4.1"
    },
    "81740": {
      "id": 3045441,
      "text": "Và em sẽ mãi yêu anh...",
      "author": "ChatGPT4.1"
    }
  }
}
