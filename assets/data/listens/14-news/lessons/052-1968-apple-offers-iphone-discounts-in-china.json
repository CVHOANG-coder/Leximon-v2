  "translations": {
    "75911": {
      "id": 2656388,
      "text": "Apple đang thực hiện các bước để bảo vệ thị phần của mình trên thị trường điện thoại di động Trung Quốc.",
      "author": "ChatGPT4.1"
    },
    "75912": {
      "id": 2656389,
      "text": "Khi hãng đang đối mặt với sự cạnh tranh ngày càng gia tăng từ các đối thủ trong nước như Huawei.",
      "author": "ChatGPT4.1"
    },
    "75913": {
      "id": 2656390,
      "text": "Gã khổng lồ công nghệ Mỹ này đang tung ra các chương trình giảm giá hiếm hoi lên đến 68,50 đô la cho các mẫu iPhone mới nhất tại Trung Quốc.",
      "author": "ChatGPT4.1"
    },
    "75914": {
      "id": 2656391,
      "text": "Chương trình khuyến mãi kéo dài 4 ngày, từ ngày 4 đến ngày 7 tháng 1,",
      "author": "ChatGPT4.1"
    },
    "75915": {
      "id": 2656392,
      "text": "áp dụng cho một số mẫu iPhone khi mua bằng các phương thức thanh toán nhất định.",
      "author": "ChatGPT4.1"
    },
    "75916": {
      "id": 2656393,
      "text": "Hai mẫu iPhone 16 Pro và iPhone 16 Pro Max sẽ được giảm giá nhiều nhất.",
      "author": "ChatGPT4.1"
    },
    "75917": {
      "id": 2656394,
      "text": "Tuy nhiên, người tiêu dùng vẫn thận trọng trong việc chi tiêu giữa bối cảnh kinh tế Trung Quốc tăng trưởng chậm và áp lực giảm phát.",
      "author": "ChatGPT4.1"
    },
    "75918": {
      "id": 2656395,
      "text": "Apple đang đối mặt với tình trạng thị phần suy giảm tại Trung Quốc,",
      "author": "ChatGPT4.1"
    },
    "75919": {
      "id": 2656396,
      "text": "nơi được xem là thị trường điện thoại thông minh lớn nhất thế giới.",
      "author": "ChatGPT4.1"
