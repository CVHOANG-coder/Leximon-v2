  "translations": {
    "92389": {
      "id": 3733162,
      "text": "Chúng ta bắt đầu hôm nay với một số địa danh quốc tế mà chúng ta có thể cần thêm vào danh sách điểm đến của mình.",
      "author": "ChatGPT4.1"
    },
    "92390": {
      "id": 3733163,
      "text": "26 địa điểm mới đã được bổ sung vào danh sách di sản thế giới của UNESCO,",
      "author": "ChatGPT4.1"
    },
    "92391": {
      "id": 3733164,
      "text": "một danh mục gồm hơn 1000 địa điểm có giá trị nổi bật đối với toàn nhân loại.",
      "author": "ChatGPT4.1"
    },
    "92392": {
      "id": 3733165,
      "text": "Những địa danh quan trọng này trải dài từ các khu khảo cổ cổ đại đến các tòa nhà và công viên quốc gia",
      "author": "ChatGPT4.1"
    },
    "92393": {
      "id": 3733166,
      "text": "nơi giàu ý nghĩa văn hóa, lịch sử hoặc đơn giản chỉ là vẻ đẹp thiên nhiên.",
      "author": "ChatGPT4.1"
    },
    "92394": {
      "id": 3733167,
      "text": "Những nơi như kim tự tháp Giza ở Ai Cập, Vạn Lý Trường Thành ở Trung Quốc,",
      "author": "ChatGPT4.1"
    },
    "92395": {
      "id": 3733168,
      "text": "Taj Mahal ở Ấn Độ hoặc Vườn quốc gia dãy núi Great Smoky ở Tennessee.",
      "author": "ChatGPT4.1"
    },
    "92396": {
      "id": 3733169,
      "text": "Những người phụ trách danh sách này là Ủy ban Di sản Thế giới.",
      "author": "ChatGPT4.1"
    },
    "92397": {
      "id": 3733170,
      "text": "Và mỗi năm, họ xem xét các địa điểm mới được các quốc gia chủ nhà đề cử để ghi danh hoặc bổ sung vào danh sách di sản UNESCO.",
      "author": "ChatGPT4.1"
    },
    "92398": {
      "id": 3733171,
      "text": "Khi đã có tên trong danh sách, một địa điểm sẽ được đánh dấu là vùng được bảo vệ",
      "author": "ChatGPT4.1"
    },
    "92399": {
      "id": 3733172,
      "text": "và các nỗ lực bảo tồn được thực hiện để bảo vệ địa điểm này khỏi du lịch quá mức, biến đổi khí hậu và các yếu tố khác có thể gây hại.",
      "author": "ChatGPT4.1"
    },
    "92400": {
      "id": 3733173,
      "text": "Năm nay, quốc gia Tây Phi Sierra Leone đã nhận được sự công nhận đầu tiên với tổ hợp Gola-Tiwai.",
      "author": "ChatGPT4.1"
    },
    "92401": {
      "id": 3733174,
      "text": "Điểm nóng đa dạng sinh học này bao gồm một vườn quốc gia rừng mưa nhiệt đới",
      "author": "ChatGPT4.1"
    },
    "92402": {
      "id": 3733175,
      "text": "và một khu bảo tồn động vật hoang dã trên đảo là nơi cư trú của nhiều loài voi và hà mã.",
      "author": "ChatGPT4.1"
    },
    "92403": {
      "id": 3733176,
      "text": "Cũng được bổ sung vào danh sách năm nay là bốn cung điện lớn của vua Ludwig II",
      "author": "ChatGPT4.1"
    },
    "92404": {
      "id": 3733177,
      "text": "được xây dựng ở vùng Bavaria của Đức vào những năm 1800, bao gồm cả lâu đài Neuschwanstein giống như trong phim Disney.",
      "author": "ChatGPT4.1"
    },
    "92405": {
      "id": 3733178,
      "text": "Tại Các Tiểu vương quốc Ả Rập Thống nhất, một khu khảo cổ trên sa mạc có bằng chứng về hoạt động của con người từ hơn 200.000 năm trước.",
      "author": "ChatGPT4.1"
    },
    "92406": {
      "id": 3733179,
      "text": "Và ở Hy Lạp, một quần thể cung điện từng là trung tâm hoạt động hàng ngày của nền văn minh Mycenae cách đây hàng nghìn năm.",
      "author": "ChatGPT4.1"
    },
    "92407": {
      "id": 3733180,
      "text": "Cung điện này chứa các ví dụ về chữ viết, kiến trúc và nghệ thuật thời kỳ đầu,",
      "author": "ChatGPT4.1"
    },
    "92408": {
      "id": 3733181,
      "text": "và được gọi là kho báu văn hóa tiền sử của vùng Địa Trung Hải.",
      "author": "ChatGPT4.1"
    }
  }
}
