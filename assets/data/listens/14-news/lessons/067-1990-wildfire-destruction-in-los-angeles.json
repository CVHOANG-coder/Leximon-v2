  "translations": {
    "76991": {
      "id": 2681324,
      "text": "Mọi người đang quay trở lại khu phố của mình và nhận ra không còn gì để trở về.",
      "author": "ChatGPT4.1"
    },
    "76992": {
      "id": 2681325,
      "text": "Chỉ còn đống tro tàn và gạch đá nơi từng có những ngôi nhà trị giá hàng triệu đô la.",
      "author": "ChatGPT4.1"
    },
    "76993": {
      "id": 2681326,
      "text": "Đó là một khung cảnh như tận thế.",
      "author": "ChatGPT4.1"
    },
    "76994": {
      "id": 2681327,
      "text": "Nhưng giữa sa mạc tàn phá này ở Pacific Palisades,",
      "author": "ChatGPT4.1"
    },
    "76995": {
      "id": 2681328,
      "text": "Jim Morray đã phát hiện ra ngôi nhà trị giá 3 triệu đô la này gần như không bị ảnh hưởng gì.",
      "author": "ChatGPT4.1"
    },
    "76996": {
      "id": 2681329,
      "text": "Khi cư dân kiểm tra thiệt hại, họ sẽ thấy từng ngôi nhà, từng dãy phố bị phá huỷ hoàn toàn.",
      "author": "ChatGPT4.1"
    },
    "76997": {
      "id": 2681330,
      "text": "Rồi họ sẽ bắt gặp những trường hợp như thế này, và họ sẽ đặt ra một câu hỏi:",
      "author": "ChatGPT4.1"
    },
    "76998": {
      "id": 2681331,
      "text": "Tại sao đây lại là ngôi nhà cuối cùng còn đứng vững?",
      "author": "ChatGPT4.1"
    },
    "76999": {
      "id": 2681332,
      "text": "Vâng, có một lý do.",
      "author": "ChatGPT4.1"
    },
    "77000": {
      "id": 2681333,
      "text": "Kiến trúc sư Greg Chason chỉ mới xây căn nhà này cách đây sáu tháng.",
      "author": "ChatGPT4.1"
    },
    "77001": {
      "id": 2681334,
      "text": "Ông ấy đến xem ngôi nhà của mình vượt qua trận hoả hoạn thế nào.",
      "author": "ChatGPT4.1"
    },
    "77002": {
      "id": 2681335,
      "text": "Phía bên nhà được trát vữa, đóng vai trò là lớp chống cháy cho tường bên, vậy nên điều đó giúp ích rất nhiều.",
      "author": "ChatGPT4.1"
    },
    "77003": {
      "id": 2681336,
      "text": "Chúng tôi cũng sử dụng mái kim loại, mái thép, với lớp lót đặc biệt...",
      "author": "ChatGPT4.1"
    },
    "77004": {
      "id": 2681337,
      "text": "Được thiết kế để bảo vệ chống cháy.",
      "author": "ChatGPT4.1"
    },
    "77005": {
      "id": 2681338,
      "text": "Một số ngôi nhà sống sót chỉ nhờ may mắn.",
      "author": "ChatGPT4.1"
    },
    "77006": {
      "id": 2681339,
      "text": "Dirk Michaels không thể tin được nhà mình còn nguyên khi bao nhiêu nhà khác đã cháy rụi.",
      "author": "ChatGPT4.1"
    },
    "77007": {
      "id": 2681340,
      "text": "Tôi thực sự đã quỳ gối và bật khóc.",
      "author": "ChatGPT4.1"
    },
    "77008": {
      "id": 2681341,
      "text": "Nhưng hàng ngàn người khác đang phải đối mặt với những mất mát không gì thay thế được.",
      "author": "ChatGPT4.1"
    },
    "77009": {
      "id": 2681342,
      "text": "Chúng tôi gặp một người đàn ông tên là Greg,",
      "author": "ChatGPT4.1"
    },
    "77010": {
      "id": 2681343,
      "text": "người lần đầu tiên nhìn thấy ngôi nhà thời thơ ấu của mình, hay những gì còn lại của nó.",
      "author": "ChatGPT4.1"
    },
    "77011": {
      "id": 2681344,
      "text": "Khi nhiều người quay trở lại một nơi như thế này, họ hy vọng còn sót lại điều gì đó, một kỷ vật nào đó…",
      "author": "ChatGPT4.1"
    },
    "77012": {
      "id": 2681345,
      "text": "một bức ảnh, một hộp trang sức, một cái đĩa…",
      "author": "ChatGPT4.1"
    },
    "77013": {
      "id": 2681346,
      "text": "Anh có thấy thứ gì có thể thu hồi được không?",
      "author": "ChatGPT4.1"
    },
    "77014": {
      "id": 2681347,
      "text": "Tôi không thấy, nhưng cha tôi đã nói với tôi…",
      "author": "ChatGPT4.1"
    },
    "77015": {
      "id": 2681348,
      "text": "Nhẫn cưới của bà nội tôi ở đâu đó trong này, nên…",
      "author": "ChatGPT4.1"
    },
    "77016": {
      "id": 2681349,
      "text": "Chúng tôi thực sự muốn tìm thấy nó. Ngoài ra còn có huy chương của ông tôi. Ông từng là cựu chiến binh.",
