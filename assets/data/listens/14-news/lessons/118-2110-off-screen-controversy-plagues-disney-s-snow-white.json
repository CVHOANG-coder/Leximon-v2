  "translations": {
    "83476": {
      "id": 2939669,
      "text": "Cuối cùng thì nó cũng đã đến.",
      "author": "ChatGPT4.1"
    },
    "83477": {
      "id": 2939670,
      "text": "Bạch Tuyết chính thức ra rạp hôm nay. Và bạn có thể mong chờ được nhìn thấy những người hâm mộ hóa trang thành công chúa Disney này.",
      "author": "ChatGPT4.1"
    },
    "83478": {
      "id": 2939671,
      "text": "Trong khi những người khác lại hóa thân thành mụ hoàng hậu độc ác.",
      "author": "ChatGPT4.1"
    },
    "83479": {
      "id": 2939672,
      "text": "Disney đang kỳ vọng một tuần công chiếu bùng nổ doanh thu.",
      "author": "ChatGPT4.1"
    },
    "83480": {
      "id": 2939673,
      "text": "Hy vọng tất cả những tranh cãi xung quanh bộ phim sẽ không ngăn cản các gia đình tới rạp chiếu phim.",
      "author": "ChatGPT4.1"
    },
    "83481": {
      "id": 2939674,
      "text": "Dự kiến phim sẽ thu về từ 45 đến 55 triệu đô la tại thị trường trong nước.",
      "author": "ChatGPT4.1"
    },
    "83482": {
      "id": 2939675,
      "text": "Và có thể vượt 100 triệu đô trên toàn thế giới.",
      "author": "ChatGPT4.1"
    },
    "83483": {
      "id": 2939676,
      "text": "Bộ phim đã bị ảnh hưởng bởi nhiều lùm xùm.",
      "author": "ChatGPT4.1"
    },
    "83484": {
      "id": 2939677,
      "text": "\"Bạch Tuyết và bảy triệu lẻ một vụ tranh cãi\" - New York Times đưa tin.",
      "author": "ChatGPT4.1"
    },
    "83486": {
      "id": 2939678,
      "text": "Người ta cho rằng có sự rạn nứt nghiêm trọng giữa các ngôi sao của phim,",
      "author": "ChatGPT4.1"
    },
    "83487": {
      "id": 2939679,
      "text": "Rachel Zegler và Gal Gadot, người thủ vai hoàng hậu độc ác, bắt nguồn từ cuộc chiến ở Gaza.",
      "author": "ChatGPT4.1"
    },
    "83488": {
      "id": 2939680,
      "text": "Và còn có một tranh cãi khác nữa.",
      "author": "ChatGPT4.1"
    },
    "83489": {
      "id": 2939681,
      "text": "Trong phim, bảy chú lùn được tạo nên bằng hiệu ứng CGI.",
      "author": "ChatGPT4.1"
    },
    "83490": {
      "id": 2939682,
      "text": "Những diễn viên này cho rằng họ nên là người thật.",
      "author": "ChatGPT4.1"
    },
    "83491": {
      "id": 2939683,
      "text": "\"Lược bỏ bảy chú lùn, đó là cơ hội tuyệt vời để tuyển chọn bảy người lùn đa dạng, tài năng và ấn tượng.\"",
      "author": "ChatGPT4.1"
    },
    "83492": {
      "id": 2939684,
      "text": "\"Thật thất vọng khi Bạch Tuyết đã quyết định không cho chúng tôi tham gia.\"",
      "author": "ChatGPT4.1"
    },
    "83493": {
      "id": 2939685,
      "text": "\"Đặc biệt là khi họ cố gắng nói rằng bộ phim này mang thông điệp thức tỉnh và khác biệt.\"",
      "author": "ChatGPT4.1"
    },
    "83494": {
      "id": 2939686,
      "text": "\"Như thể họ đang ám chỉ việc là một người lùn là điều xấu xa vậy.\"",
      "author": "ChatGPT4.1"
    },
    "83495": {
      "id": 2939687,
      "text": "\"Đó là lý do vì sao họ phải biến chúng tôi thành nhân vật hoạt hình.\"",
      "author": "ChatGPT4.1"
    },
    "83496": {
      "id": 2939688,
      "text": "\"Điều đó lẽ ra có thể tạo ra nhiều cơ hội hơn cho những người khác.\"",
      "author": "ChatGPT4.1"
    }
  }
}
