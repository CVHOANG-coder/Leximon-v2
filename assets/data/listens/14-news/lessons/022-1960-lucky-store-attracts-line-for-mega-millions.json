  "translations": {
    "75501": {
      "id": 2625902,
      "text": "Nếu bạn muốn trúng độc đắc, một số người nói rằng đây là cửa hàng nên đến.",
      "author": "ChatGPT4.1"
    },
    "75502": {
      "id": 2625903,
      "text": "Cửa hàng rượu Bluebird ở Hawthorne, California, có khách xếp hàng dài quanh khu phố.",
      "author": "ChatGPT4.1"
    },
    "75503": {
      "id": 2625904,
      "text": "Với nhiều người trúng giải Powerball và Mega Millions trước đây,",
      "author": "ChatGPT4.1"
    },
    "75504": {
      "id": 2625905,
      "text": "cửa hàng này nổi tiếng là may mắn.",
      "author": "ChatGPT4.1"
    },
    "75505": {
      "id": 2625906,
      "text": "Hiện nay, khách hàng hy vọng sẽ trúng giải Mega Millions tiếp theo với trị giá giải thưởng đã vượt qua 1,15 tỷ đô la.",
      "author": "a user"
    },
    "75506": {
      "id": 2625907,
      "text": "Khách hàng xoa con chim xanh của cửa hàng, cho rằng nó mang lại may mắn cho họ.",
      "author": "ChatGPT4.1"
    },
    "75507": {
      "id": 2625908,
      "text": "Một giải xổ số với số tiền thưởng lớn như thế này thu hút đủ loại người tham gia.",
      "author": "ChatGPT4.1"
    },
    "75508": {
      "id": 2625909,
      "text": "Những người thường xuyên mua vé và những người bị hấp dẫn bởi dấu hiệu đô la.",
      "author": "ChatGPT4.1"
    },
    "75509": {
      "id": 2625910,
      "text": "Giải xổ số Mega Millions tiếp theo sẽ được quay vào ngày 27 tháng 12 lúc 11 giờ tối theo giờ miền Đông.",
      "author": "ChatGPT4.1"
    },
    "75510": {
      "id": 2625911,
      "text": "Thời gian sẽ trả lời liệu con chim xanh có may mắn một lần nữa hay không.",
      "author": "ChatGPT4.1"
    }
  }
