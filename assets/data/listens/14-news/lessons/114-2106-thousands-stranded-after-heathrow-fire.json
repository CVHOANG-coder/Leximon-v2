  "translations": {
    "83407": {
      "id": 3513103,
      "text": "Đây là một thông báo bất ngờ của phi công ở độ cao 30,000 feet.",
      "author": "ChatGPT4.1"
    },
    "83408": {
      "id": 3513104,
      "text": "Chúng tôi đã quay đầu 180 độ.",
      "author": "ChatGPT4.1"
    },
    "83409": {
      "id": 3513105,
      "text": "Chúng tôi đang quay trở lại Charlotte.",
      "author": "ChatGPT4.1"
    },
    "83410": {
      "id": 3513106,
      "text": "Để tôi kể cho bạn nghe chuyện gì đang xảy ra.",
      "author": "ChatGPT4.1"
    },
    "83411": {
      "id": 3513107,
      "text": "Đã xảy ra một vụ cháy lớn tại sân bay Heathrow ở London.",
      "author": "ChatGPT4.1"
    },
    "83412": {
      "id": 3513108,
      "text": "Hàng trăm chuyến bay buộc phải quay đầu trở lại",
      "author": "ChatGPT4.1"
    },
    "83413": {
      "id": 3513109,
      "text": "sau khi một quả cầu lửa khổng lồ phát nổ tại một cơ sở cung cấp điện gần sân bay Heathrow của London,",
      "author": "ChatGPT4.1"
    },
    "83414": {
      "id": 3513110,
      "text": "dẫn đến việc ngừng hoạt động.",
      "author": "ChatGPT4.1"
    },
    "83415": {
      "id": 3513111,
      "text": "Bản đồ này cho thấy tất cả các chuyến bay đến đã phải chuyển hướng.",
      "author": "ChatGPT4.1"
    },
    "83416": {
      "id": 3513112,
      "text": "Thêm 1300 chuyến bay nữa đã phải hoàn toàn hủy bỏ,",
      "author": "ChatGPT4.1"
    },
    "83417": {
      "id": 3513113,
      "text": "khiến hàng nghìn hành khách bị mắc kẹt, nhiều người trong số họ ở Mỹ.",
      "author": "ChatGPT4.1"
    },
    "83418": {
      "id": 3513114,
      "text": "Cặp vợ chồng này bị mắc kẹt tại sân bay LAX và phải ngủ ở sảnh chờ khách sạn.",
      "author": "ChatGPT4.1"
    },
    "83419": {
      "id": 3513115,
      "text": "\"Chúng tôi đã cố gắng tìm khách sạn. Chúng tôi đến nhiều khách sạn, nhưng ở L.A. đều kín phòng.\"",
      "author": "ChatGPT4.1"
    },
    "83420": {
      "id": 3513116,
      "text": "\"Chúng tôi đã gọi cho khoảng 30 khách sạn và không tìm được phòng.\"",
      "author": "ChatGPT4.1"
    },
    "83421": {
      "id": 3513117,
      "text": "\"Vì vậy, cuối cùng chúng tôi phải ngủ vài tiếng ở sảnh khách sạn.\"",
      "author": "ChatGPT4.1"
    },
    "83422": {
      "id": 3513118,
      "text": "Vậy bạn nên làm gì nếu chuyến bay của mình đột ngột bị hủy?",
      "author": "ChatGPT4.1"
    },
    "83423": {
      "id": 3513119,
      "text": "Các chuyên gia nói rằng việc biết quyền lợi của mình khi là hành khách là rất quan trọng.",
      "author": "ChatGPT4.1"
    },
    "83424": {
      "id": 3513120,
      "text": "Chúng tôi đã nói chuyện với chuyên gia du lịch Pauline Frommer.",
      "author": "ChatGPT4.1"
    },
    "83425": {
      "id": 3513121,
      "text": "\"Nếu chuyến bay quốc tế của bạn bị hủy,\"",
      "author": "ChatGPT4.1"
    },
    "83426": {
      "id": 3513122,
      "text": "\"bạn có quyền được hoàn tiền đầy đủ, ngay lập tức. Không cần tranh cãi với hãng hàng không.\"",
      "author": "ChatGPT4.1"
    },
    "83427": {
      "id": 3513123,
      "text": "Tùy vào hãng hàng không, nếu bạn bị mắc kẹt qua đêm,",
      "author": "ChatGPT4.1"
    },
    "83428": {
      "id": 3513124,
      "text": "bạn có thể được hoàn lại chi phí ăn uống, khách sạn và di chuyển mặt đất.",
      "author": "ChatGPT4.1"
    },
    "83429": {
      "id": 3513125,
      "text": "Điều bạn không nên làm là đến hét vào mặt người nhân viên tội nghiệp đứng sau quầy.",
      "author": "ChatGPT4.1"
    },
    "83430": {
      "id": 3513126,
      "text": "Đó không phải lỗi của họ.",
      "author": "ChatGPT4.1"
    }
  }
}
