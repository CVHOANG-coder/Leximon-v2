  "translations": {
    "94365": {
      "id": 5793239,
      "text": "Mùa hè năm nay còn nóng hơn cả một quả ớt jalapeno trong phòng xông hơi.",
      "author": "ChatGPT4.1"
    },
    "94366": {
      "id": 5793240,
      "text": "Và nói về những tình huống cay nóng, hãy chờ đến khi bạn thấy cảnh tượng kỳ lạ này thực sự làm tăng nhiệt ở Ohio.",
      "author": "ChatGPT4.1"
    },
    "94367": {
      "id": 5793241,
      "text": "Một chiếc xe tải chở hàng ngàn cân sốt cay Frank's Red Hot bị rò rỉ gần Columbus, Ohio,",
      "author": "ChatGPT4.1"
    },
    "94368": {
      "id": 5793242,
      "text": "khiến một đoạn đường cao tốc trông giống như đơn hàng cánh gà sốt cay lớn nhất thế giới.",
      "author": "ChatGPT4.1"
    },
    "94369": {
      "id": 5793243,
      "text": "Tôi đoán là loại sốt đó thực sự có thể dùng với mọi thứ.",
      "author": "ChatGPT4.1"
    },
    "94370": {
      "id": 5793244,
      "text": "Các quan chức đã nhanh chóng đến để kiểm soát thảm họa đỏ rực này.",
      "author": "ChatGPT4.1"
    },
    "94371": {
      "id": 5793245,
      "text": "Các nhà chức trách môi trường xác định rằng vụ tràn này không độc hại.",
      "author": "ChatGPT4.1"
    },
    "94372": {
      "id": 5793246,
      "text": "Nhưng vì nó có tính axit cao, các nhân viên phải ngăn nước sốt chảy vào hệ thống thoát nước mưa gần đó.",
      "author": "ChatGPT4.1"
    },
    "94373": {
      "id": 5793247,
      "text": "Chưa rõ họ dọn dẹp thế nào, nhưng có lẽ đâu đó ai đó đang hỏi, \"Có nước sốt ranch không?\"",
      "author": "ChatGPT4.1"
    },
    "94374": {
      "id": 5793248,
      "text": "Có thể là cả, ừm... Pepto Bismol nữa chăng?",
      "author": "ChatGPT4.1"
    }
