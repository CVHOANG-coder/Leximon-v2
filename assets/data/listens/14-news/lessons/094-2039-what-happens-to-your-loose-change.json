  "translations": {
    "79817": {
      "id": 2651338,
      "text": "Bạn có bao giờ tự hỏi điều gì xảy ra với số tiền lẻ mà bạn đã đánh mất qua các năm không?",
      "author": "ChatGPT4.1"
    },
    "79818": {
      "id": 2651339,
      "text": "Người Mỹ vứt đi gần 70 triệu đô la tiền lẻ mỗi năm.",
      "author": "ChatGPT4.1"
    },
    "79819": {
      "id": 2651340,
      "text": "Và hầu hết số tiền đó đều kết thúc trong thùng rác.",
      "author": "ChatGPT4.1"
    },
    "79820": {
      "id": 2651341,
      "text": "Và rất nhiều trong số đó tập trung tại Reworld Medals ở ngoại ô Philadelphia.",
      "author": "ChatGPT4.1"
    },
    "79821": {
      "id": 2651342,
      "text": "Thật đáng kinh ngạc, có tiền xu trong những đống này.",
      "author": "ChatGPT4.1"
    },
    "79822": {
      "id": 2651343,
      "text": "Ẩn trong các đống phế liệu kim loại ấy là hàng chục ngàn đô la tiền xu lẻ các loại.",
      "author": "ChatGPT4.1"
    },
    "79823": {
      "id": 2651344,
      "text": "Vậy nên chúng ta phải giả định rằng số tiền xu này bị thất lạc trong đệm ghế sofa, nhà ở hoặc doanh nghiệp của bạn,",
      "author": "ChatGPT4.1"
    },
    "79824": {
      "id": 2651345,
      "text": "hoặc kẹt lại trong máy hút bụi tại các trạm rửa xe.",
      "author": "ChatGPT4.1"
    },
    "79825": {
      "id": 2651346,
      "text": "Bằng cách sử dụng các máy móc đặc biệt, họ vận hành một chương trình thu hồi tiền xu quy mô lớn để tìm kiếm, sàng lọc, và làm sạch.",
      "author": "ChatGPT4.1"
    },
    "79826": {
      "id": 2651347,
      "text": "Chúng tôi đã phân loại các đồng xu và rửa sạch chúng,",
      "author": "ChatGPT4.1"
    },
    "79827": {
      "id": 2651348,
      "text": "và bây giờ chúng tôi đang ở giai đoạn làm khô.",
      "author": "ChatGPT4.1"
    },
    "79828": {
      "id": 2651349,
      "text": "Bạn có thể đang nhìn thấy vài trăm đô la tiền xu đang nằm trên bàn này ngay lúc này.",
      "author": "ChatGPT4.1"
    },
    "79829": {
      "id": 2651350,
      "text": "Cuối cùng, tất cả số tiền lẻ đó, sau khi được làm sạch, sẽ quay trở lại lưu thông trong nền kinh tế.",
      "author": "ChatGPT4.1"
    },
    "79830": {
      "id": 2651351,
      "text": "Chúng tôi sẽ phân loại chúng theo mệnh giá.",
      "author": "ChatGPT4.1"
    },
    "79831": {
      "id": 2651352,
      "text": "Khoảng 50.000 pound mỗi năm.",
      "author": "ChatGPT4.1"
    },
    "79832": {
      "id": 2651353,
      "text": "Nhiều đồng xu bị hư hại quá nặng không thể thu hồi được.",
      "author": "ChatGPT4.1"
    },
    "79833": {
      "id": 2651354,
      "text": "Cứ mỗi đồng xu tốt thì có lẽ có hai hoặc ba đồng xu hỏng.",
      "author": "ChatGPT4.1"
    },
    "79834": {
      "id": 2651355,
      "text": "Mỗi đồng xu đều được phân loại bằng tay, và một số hóa ra lại rất hiếm.",
      "author": "ChatGPT4.1"
    },
    "79835": {
      "id": 2651356,
      "text": "Chúng tôi có một đồng penny mà có lẽ, tôi tin rằng, là từ năm 1864.",
      "author": "ChatGPT4.1"
    },
    "79836": {
      "id": 2651357,
      "text": "Quả là \"tiền rơi từ trên trời xuống\".",
      "author": "ChatGPT4.1"
    },
    "79837": {
      "id": 2651358,
      "text": "Gần một triệu đô la tiền xu được đưa trở lại lưu thông.",
      "author": "ChatGPT4.1"
    }
  }
