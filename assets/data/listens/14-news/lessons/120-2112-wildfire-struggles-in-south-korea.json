  "translations": {
    "83522": {
      "id": 2677994,
      "text": "Một phần của lịch sử đã cháy rụi xuống đất.",
      "author": "ChatGPT4.1"
    },
    "83523": {
      "id": 2677995,
      "text": "Đây là cảnh tượng tại chùa Gounsa ở Hàn Quốc.",
      "author": "ChatGPT4.1"
    },
    "83524": {
      "id": 2677996,
      "text": "Một nơi thờ cúng trong suốt 1300 năm đã bị phá hủy bởi các đám cháy rừng.",
      "author": "ChatGPT4.1"
    },
    "83525": {
      "id": 2677997,
      "text": "Ngọn lửa bao quanh quần thể chùa Phật giáo khi cháy rừng lan rộng khắp miền nam đất nước trong tuần qua.",
      "author": "ChatGPT4.1"
    },
    "83526": {
      "id": 2677998,
      "text": "Những gì còn lại bây giờ chỉ là những đống tro tàn và đổ nát.",
      "author": "ChatGPT4.1"
    },
    "83527": {
      "id": 2677999,
      "text": "Các Phật tử của chúng tôi rất tự hào về ngôi chùa của mình.",
      "author": "ChatGPT4.1"
    },
    "83528": {
      "id": 2678000,
      "text": "Vì đây là một ngôi chùa rất cổ nên thật đáng tiếc và đau lòng khi nó đã bị thiêu rụi.",
      "author": "ChatGPT4.1"
    },
    "83529": {
      "id": 2678001,
      "text": "Một số hiện vật như tượng Phật bằng đá này, vốn được nhà nước công nhận là bảo vật,",
      "author": "ChatGPT4.1"
    },
    "83530": {
      "id": 2678002,
      "text": "đã được cứu thoát vì đã được chuyển đến các chùa khác trước khi xảy ra cháy.",
      "author": "ChatGPT4.1"
    },
    "83531": {
      "id": 2678003,
      "text": "Các đám cháy bắt đầu bùng phát vào cuối tuần trước.",
      "author": "ChatGPT4.1"
    },
    "83532": {
      "id": 2678004,
      "text": "Cho đến nay đã có một số người bị thương và thiệt mạng.",
      "author": "ChatGPT4.1"
    },
    "83533": {
      "id": 2678005,
      "text": "Trong số đó có cả các công chức được cử đi chữa cháy, theo Bộ An toàn Nội địa.",
      "author": "ChatGPT4.1"
    },
    "83534": {
      "id": 2678006,
      "text": "Và với những người đã thoát nạn an toàn.",
      "author": "ChatGPT4.1"
    },
    "83535": {
      "id": 2678007,
      "text": "Vẫn còn những mất mát phải gánh chịu.",
      "author": "ChatGPT4.1"
    },
    "83536": {
      "id": 2678008,
      "text": "Những thứ gợi nhớ về tuổi trẻ của tôi đã biến mất không còn dấu vết.",
      "author": "ChatGPT4.1"
    },
    "83537": {
      "id": 2678009,
      "text": "Những bức ảnh chụp các con tôi khi còn nhỏ, mà đôi khi tôi nhìn lại để hồi tưởng về quá khứ, giờ đã không còn.",
      "author": "ChatGPT4.1"
    },
    "83538": {
      "id": 2678010,
      "text": "Và với con tôi thì không còn nơi nào để chia sẻ những kỷ niệm cùng các con.",
      "author": "ChatGPT4.1"
    },
    "83539": {
      "id": 2678011,
      "text": "Tôi đã mất đi ký ức về tuổi trẻ của mình.",
      "author": "ChatGPT4.1"
    },
    "83540": {
      "id": 2678012,
      "text": "Quyền tổng thống Hàn Quốc Han Duck-soo gọi các vụ cháy rừng này là \"nghiêm trọng nhất từ trước đến nay\" ở nước này.",
      "author": "ChatGPT4.1"
    },
    "83541": {
      "id": 2678013,
      "text": "Ông nói rằng các đám cháy bị thổi bùng lên bởi gió lớn. Và ông cũng cho biết rằng...",
      "author": "ChatGPT4.1"
    },
    "83542": {
      "id": 2678014,
      "text": "tất cả nguồn lực có thể trên toàn quốc đang được huy động.",
      "author": "ChatGPT4.1"
    },
    "83543": {
      "id": 2678015,
      "text": "Các nhà chức trách đang tiếp tục làm việc suốt ngày đêm để kiểm soát các đám cháy",
      "author": "ChatGPT4.1"
    },
    "83544": {
      "id": 2678016,
      "text": "trước khi thêm nhiều phần lịch sử nữa của Hàn Quốc biến mất mãi mãi.",
      "author": "ChatGPT4.1"
    }
  }
}
