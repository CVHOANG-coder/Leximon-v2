    "81708": {
      "id": 2532038,
      "text": "Cuối cùng thì điều này cũng đã xảy ra.",
      "author": "ChatGPT4.1"
    },
    "81709": {
      "id": 2532039,
      "text": "Cặp đại bàng đầu trắng nổi tiếng nhất thế giới, Jackie và Shadow, đang chào đón hai chú chim non vừa mới nở,",
      "author": "ChatGPT4.1"
    },
    "81710": {
      "id": 2532040,
      "text": "với hy vọng quả trứng thứ ba sẽ nở sớm.",
      "author": "ChatGPT4.1"
    },
    "81711": {
      "id": 2532041,
      "text": "Hàng chục nghìn người trên khắp thế giới đang dán mắt vào video trực tiếp 24 giờ của tổ chim này",
      "author": "ChatGPT4.1"
    },
    "81712": {
      "id": 2532042,
      "text": "từ Big Bear, California.",
      "author": "ChatGPT4.1"
    },
    "81713": {
      "id": 2532043,
      "text": "Tin tức địa phương đã ngắt chương trình để đưa tin về chú chim non đầu tiên chào đời lúc 11:26 tối qua.",
      "author": "ChatGPT4.1"
    },
    "81714": {
      "id": 2532044,
      "text": "Đó là một trong những chú chim non thực sự đang nở.",
      "author": "ChatGPT4.1"
    },
    "81715": {
      "id": 2532045,
      "text": "Điều này vừa mới xảy ra vài phút trước.",
      "author": "ChatGPT4.1"
    },
    "81716": {
      "id": 2532046,
      "text": "Bạn có thể thấy những sợi lông nhỏ và chiếc mỏ hiện ra.",
      "author": "ChatGPT4.1"
    },
    "81717": {
      "id": 2532047,
      "text": "Vào lúc 4:10 sáng, chú đại bàng non thứ hai đã nở.",
      "author": "ChatGPT4.1"
    },
    "81718": {
      "id": 2532048,
      "text": "Sandy Steers điều hành webcam trực tiếp.",
      "author": "ChatGPT4.1"
    },
    "81719": {
      "id": 2532049,
      "text": "Thật phấn khích biết bao khi được chứng kiến những chú chim non này.",
      "author": "ChatGPT4.1"
    },
    "81720": {
      "id": 2532050,
      "text": "Ồ, thật sự rất phấn khích.",
      "author": "ChatGPT4.1"
    },
    "81721": {
      "id": 2532051,
      "text": "Chúng có vẻ khỏe mạnh. Chúng đã được làm khô.",
      "author": "ChatGPT4.1"
    },
    "81722": {
      "id": 2532052,
