  "translations": {
    "83497": {
      "id": 2728390,
      "text": "Hòn đảo nổi tiếng Santorini của Hy Lạp đã trải qua nhiều đợt động đất vào tháng Một và tháng Hai,",
      "author": "ChatGPT4.1"
    },
    "83498": {
      "id": 2728391,
      "text": "khiến du khách và nhiều cư dân phải sơ tán.",
      "author": "ChatGPT4.1"
    },
    "83499": {
      "id": 2728392,
      "text": "Nhưng chỉ hơn một tháng sau,",
      "author": "ChatGPT4.1"
    },
    "83500": {
      "id": 2728393,
      "text": "chiếc du thuyền đầu tiên của mùa đã cập bến đảo.",
      "author": "ChatGPT4.1"
    },
    "83501": {
      "id": 2728394,
      "text": "Đó là dấu hiệu hy vọng du lịch có thể phục hồi sau khi động đất gây ra tình trạng khẩn cấp kéo dài đến ngày 3 tháng 3.",
      "author": "ChatGPT4.1"
    },
    "83502": {
      "id": 2728395,
      "text": "\"Thật thú vị, vâng, khi biết rằng đảo đã mở cửa trở lại và chúng tôi được đến thăm đầu tiên; nơi đây an toàn.\"",
      "author": "ChatGPT4.1"
    },
    "83503": {
      "id": 2728396,
      "text": "Hòn đảo xinh đẹp này nằm gần ranh giới giữa các mảng kiến tạo châu Phi và Âu-Á.",
      "author": "ChatGPT4.1"
    },
    "83504": {
      "id": 2728397,
      "text": "Do vị trí gần các đứt gãy địa chất,",
      "author": "ChatGPT4.1"
    },
    "83505": {
      "id": 2728398,
      "text": "Santorini thường xuyên trải qua hoạt động địa chấn.",
      "author": "ChatGPT4.1"
    },
    "83506": {
      "id": 2728399,
      "text": "Nhưng đợt động đất gần đây nhất không phải là điển hình.",
      "author": "ChatGPT4.1"
    },
    "83507": {
      "id": 2728400,
      "text": "Dữ liệu từ Đài quan sát Quốc gia Athens cho thấy hơn 1.200 trận động đất,",
      "author": "ChatGPT4.1"
    },
    "83508": {
      "id": 2728401,
      "text": "có cường độ dao động từ 1 đến 5,2 độ,",
      "author": "ChatGPT4.1"
    },
    "83509": {
      "id": 2728402,
      "text": "đã xảy ra trong khoảng thời gian hai tuần.",
      "author": "ChatGPT4.1"
    },
    "83510": {
      "id": 2728403,
      "text": "Trường học đóng cửa và các công trình xây dựng bị đình trệ.",
      "author": "ChatGPT4.1"
    },
    "83511": {
      "id": 2728404,
      "text": "Nhưng hiện tại khi các trận động đất đã lắng xuống,",
      "author": "ChatGPT4.1"
    },
    "83512": {
      "id": 2728405,
      "text": "du khách bày tỏ sự háo hức khi trở lại Santorini sau khi chính phủ đảm bảo an toàn.",
      "author": "ChatGPT4.1"
    },
    "83513": {
      "id": 2728406,
      "text": "\"Chúng tôi thích là chiếc du thuyền đầu tiên có cơ hội đến Santorini; chúng tôi cảm thấy thật may mắn,\"",
      "author": "ChatGPT4.1"
    },
    "83514": {
      "id": 2728407,
      "text": "\"Chúng tôi tin tưởng vào ban quản lý du lịch ở đây, vì vậy nếu họ nói là an toàn để đến...\"",
      "author": "ChatGPT4.1"
    },
    "83515": {
      "id": 2728408,
      "text": "\"chúng tôi đến đây với vòng tay rộng mở.\"",
      "author": "ChatGPT4.1"
    },
    "83516": {
      "id": 2728409,
      "text": "Hòn đảo này, nơi thu hút khoảng 3,4 triệu du khách mỗi năm,",
      "author": "ChatGPT4.1"
    },
    "83517": {
      "id": 2728410,
      "text": "cũng là nơi sinh sống của khoảng 200.000 cư dân.",
      "author": "ChatGPT4.1"
    },
    "83518": {
      "id": 2728411,
      "text": "Và du lịch chiếm phần lớn thu nhập của đảo.",
      "author": "ChatGPT4.1"
    },
    "83519": {
      "id": 2728412,
      "text": "\"Tất cả chúng tôi đều hy vọng mọi thứ sẽ trở lại bình thường, rằng mọi người sẽ quay trở lại,\"",
      "author": "ChatGPT4.1"
    },
    "83520": {
      "id": 2728413,
      "text": "\"Có vẻ như những đám mây đang tan dần, vì vậy tình hình sẽ tốt lên cho mọi người,\"",
      "author": "ChatGPT4.1"
    },
    "83521": {
      "id": 2728414,
      "text": "\"ít nhất đó là điều chúng tôi hy vọng.\"",
      "author": "ChatGPT4.1"
    }
  }
}
