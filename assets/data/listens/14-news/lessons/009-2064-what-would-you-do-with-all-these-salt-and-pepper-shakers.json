  "translations": {
    "81332": {
      "id": 2622971,
      "text": "Hãy nhìn tất cả những bộ lọ muối và tiêu này.",
      "author": "ChatGPT4.1"
    },
    "81333": {
      "id": 2622972,
      "text": "Có hàng trăm cặp, khoảng 1500 cặp nếu đếm chính xác.",
      "author": "ChatGPT4.1"
    },
    "81334": {
      "id": 2622973,
      "text": "Và nói về sự đa dạng, có những bộ rất dễ thương và độc đáo!",
      "author": "ChatGPT4.1"
    },
    "81335": {
      "id": 2622974,
      "text": "Đây là một bộ mà chúng tôi thật sự rất ngạc nhiên.",
      "author": "ChatGPT4.1"
    },
    "81336": {
      "id": 2622975,
      "text": "Có vẻ như đây là một bộ lọ muối tiêu rất được săn lùng. Chúng là những quả dâu tây bằng thủy tinh, và được treo lên.",
      "author": "ChatGPT4.1"
    },
    "81337": {
      "id": 2622976,
      "text": "Rachel Whitten, một giáo viên trung học ở Pottsville, Arkansas,",
      "author": "ChatGPT4.1"
    },
    "81338": {
      "id": 2622977,
      "text": "khoe một phần bộ sưu tập từng thuộc về người bà quá cố của cô, Sharon Tidwell.",
      "author": "ChatGPT4.1"
    },
    "81339": {
      "id": 2622978,
      "text": "“Tôi biết bà có rất nhiều, nhưng khi nhìn thấy tất cả ngay đó... thật khó tin.”",
      "author": "ChatGPT4.1"
    },
    "81340": {
      "id": 2622979,
      "text": "Phải mất bốn tiếng để dỡ hết chúng ra.",
      "author": "ChatGPT4.1"
    },
    "81341": {
      "id": 2622980,
      "text": "“Và khi chúng tôi lấy hết ra và bày chúng ở bếp của mẹ tôi,”",
      "author": "ChatGPT4.1"
    },
    "81342": {
      "id": 2622981,
      "text": "“tôi đã nghĩ, mình phải quay video lại cảnh này vì quá điên rồ.”",
      "author": "ChatGPT4.1"
    },
    "81343": {
      "id": 2622982,
      "text": "Rachel chia sẻ một vài bộ mà cô yêu thích nhất.",
      "author": "ChatGPT4.1"
    },
    "81344": {
      "id": 2622983,
      "text": "“Đây là một trong những bộ tôi thích nhất khi còn nhỏ vì phim The Wizard of Oz là phim tôi yêu thích nhất.”",
      "author": "ChatGPT4.1"
    },
    "81345": {
      "id": 2622984,
      "text": "Và còn có bộ I Love Lucy, gợi nhớ lại bao kỷ niệm thời thơ ấu.",
      "author": "ChatGPT4.1"
    },
    "81346": {
      "id": 2622985,
      "text": "“Nhìn thấy mấy bộ này luôn khiến tôi mỉm cười vì bà lúc nào cũng bật kênh TV Land trong nhà suốt ngày.”",
      "author": "ChatGPT4.1"
    },
    "81347": {
      "id": 2622986,
      "text": "“Vì thế chỉ cần nhìn chúng là tôi nhớ đến bà”",
      "author": "ChatGPT4.1"
    },
    "81348": {
      "id": 2622987,
      "text": "“và những lần ở lại nhà bà vào cuối tuần và mọi thứ khác nữa.”",
      "author": "ChatGPT4.1"
    },
    "81349": {
      "id": 2622988,
      "text": "Khi nhìn vào tất cả chúng, thật quá choáng ngợp.",
      "author": "ChatGPT4.1"
    },
    "81350": {
      "id": 2622989,
      "text": "Rachel nói cô sẽ giữ lại những bộ có ý nghĩa tình cảm và bán đi nhiều bộ khác.",
      "author": "ChatGPT4.1"
    },
    "81351": {
      "id": 2622990,
      "text": "Hiện tại, cô đã đăng video bộ sưu tập lên TikTok và thu hút hàng triệu lượt xem.",
      "author": "ChatGPT4.1"
    },
    "81352": {
      "id": 2622991,
      "text": "“Tôi cảm thấy rất may mắn và biết ơn vì mọi người muốn biết về câu chuyện của bà.”",
      "author": "ChatGPT4.1"
    },
    "81353": {
      "id": 2622992,
      "text": "“Tôi thật sự hạnh phúc vì có thể chia sẻ về bà, tình yêu thương của bà và bà là một người tuyệt vời đến với mọi người.”",
      "author": "ChatGPT4.1"
    }
  }
}
