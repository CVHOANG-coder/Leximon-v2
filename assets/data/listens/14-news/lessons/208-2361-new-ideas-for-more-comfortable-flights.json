  "translations": {
    "92716": {
      "id": 5612021,
      "text": "Cách chúng ta bay đang được tái định hình hoàn toàn với nhiều ý tưởng mới.",
      "author": "ChatGPT4.1"
    },
    "92717": {
      "id": 5612022,
      "text": "Air New Zealand vừa công bố thiết kế giường tầng mới dành cho hành khách hạng phổ thông trên máy bay.",
      "author": "ChatGPT4.1"
    },
    "92718": {
      "id": 5612023,
      "text": "Nó có tên là Skynest.",
      "author": "ChatGPT4.1"
    },
    "92719": {
      "id": 5612024,
      "text": "Khoang ngủ này sẽ được cung cấp bắt đầu từ tháng 11 này cho chuyến bay 17 giờ giữa sân bay JFK ở New York và Auckland.",
      "author": "ChatGPT4.1"
    },
    "92720": {
      "id": 5612025,
      "text": "Bạn có thể đặt chỗ bắt đầu từ tháng tới.",
      "author": "ChatGPT4.1"
    },
    "92721": {
      "id": 5612026,
      "text": "Chỉ với 495 đô la, nhưng có một điều kiện:",
      "author": "ChatGPT4.1"
    },
    "92722": {
      "id": 5612027,
      "text": "Bạn chỉ được sử dụng giường trong 4 giờ, sau đó tiếp viên sẽ thay ga giường và gối cho hành khách tiếp theo.",
      "author": "ChatGPT4.1"
    },
    "92723": {
      "id": 5612028,
      "text": "Tiếp theo, bạn nghĩ sao về ghế máy bay hai tầng?",
      "author": "ChatGPT4.1"
    },
    "92724": {
      "id": 5612029,
      "text": "Một nhà thiết kế đang giới thiệu ý tưởng mới, thiết kế ghế Chase Lounge",
      "author": "ChatGPT4.1"
    },
    "92725": {
      "id": 5612030,
      "text": "bắt đầu như một dự án ở trường đại học vào năm 2020.",
      "author": "ChatGPT4.1"
    },
    "92726": {
      "id": 5612031,
      "text": "Với thiết kế này, máy bay sẽ phải bỏ khoang chứa hành lý trên đầu để có chỗ cho hai dãy ghế.",
      "author": "ChatGPT4.1"
    },
    "92727": {
      "id": 5612032,
      "text": "Tầng dưới sẽ có thêm không gian duỗi chân.",
      "author": "ChatGPT4.1"
    },
    "92728": {
      "id": 5612033,
      "text": "Công ty đứng sau ý tưởng này cho biết họ thường xuyên trao đổi với các CEO hãng hàng không,",
      "author": "ChatGPT4.1"
    },
    "92729": {
      "id": 5612034,
      "text": "nhưng vẫn chưa ai chính thức hợp tác với họ.",
      "author": "ChatGPT4.1"
    }
  }
