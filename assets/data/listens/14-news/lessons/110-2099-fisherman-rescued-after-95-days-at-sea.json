  "translations": {
    "82982": {
      "id": 2594175,
      "text": "Một ngư dân Peru đã trải qua 95 ngày lênh đênh trên Thái Bình Dương trước khi được cứu thoát.",
      "author": "ChatGPT4.1"
    },
    "82983": {
      "id": 2594176,
      "text": "Maximo Napa rời cảng San Juan de Marcona vào ngày 7 tháng 12 năm 2024,",
      "author": "ChatGPT4.1"
    },
    "82984": {
      "id": 2594177,
      "text": "để đi đánh cá trên một chiếc thuyền nhỏ.",
      "author": "ChatGPT4.1"
    },
    "82985": {
      "id": 2594178,
      "text": "Động cơ của chiếc thuyền đó bị hỏng, và ông đã bị cuốn theo dòng hải lưu vào vùng biển của Ecuador,",
      "author": "ChatGPT4.1"
    },
    "82986": {
      "id": 2594179,
      "text": "nơi ông cuối cùng đã được một tàu đánh cá cá ngừ cứu sống.",
      "author": "ChatGPT4.1"
    },
    "82987": {
      "id": 2594180,
      "text": "Đây là những gì ông đã kể với các phóng viên về thời gian lênh đênh trên biển:",
      "author": "ChatGPT4.1"
    },
    "82988": {
      "id": 2594181,
      "text": "\"Tôi không ăn gì cả. Tôi không muốn chết.\"",
      "author": "ChatGPT4.1"
    },
    "82989": {
      "id": 2594182,
      "text": "\"95 ngày, tôi phải ăn gián, chim.\"",
      "author": "ChatGPT4.1"
    },
    "82990": {
      "id": 2594183,
      "text": "\"Thứ cuối cùng là một con rùa.\"",
      "author": "ChatGPT4.1"
    },
    "82991": {
      "id": 2594184,
      "text": "\"Tôi không muốn chết vì mẹ tôi.\"",
      "author": "ChatGPT4.1"
    },
    "82992": {
      "id": 2594185,
      "text": "\"Tôi còn mẹ tôi đang sống.\"",
      "author": "ChatGPT4.1"
    },
    "82993": {
      "id": 2594186,
      "text": "Ông đã sống sót với rất ít vật chất trong hơn ba tháng với hy vọng được gặp lại gia đình.",
      "author": "ChatGPT4.1"
    },
    "82994": {
      "id": 2594187,
      "text": "Napa đã được đón chào bằng một cái ôm thật chặt khi đoàn tụ với anh trai Alberto.",
      "author": "ChatGPT4.1"
    },
    "82995": {
      "id": 2594188,
      "text": "Napa hiện đang trải qua các cuộc kiểm tra y tế sau chuyến hành trình dài trên biển.",
      "author": "ChatGPT4.1"
    }
  }
}
