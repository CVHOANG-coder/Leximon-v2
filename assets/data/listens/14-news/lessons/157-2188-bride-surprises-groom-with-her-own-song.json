  "translations": {
    "86623": {
      "id": 2787919,
      "text": "Chú rể này rất căng thẳng khi chờ đợi được gặp cô dâu của mình.",
      "author": "ChatGPT4.1"
    },
    "86624": {
      "id": 2787920,
      "text": "Rồi nhạc bắt đầu vang lên.",
      "author": "ChatGPT4.1"
    },
