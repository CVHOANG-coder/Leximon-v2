    },
    "86627": {
      "id": 2787923,
      "text": "Và anh không thể kìm nén được cảm xúc - đó là giọng của vợ mình.",
      "author": "ChatGPT4.1"
    },
    "86628": {
      "id": 2787924,
      "text": "Cánh cửa mở ra và cô ấy xuất hiện, được đưa vào lễ đường với bài hát chính mình thể hiện.",
      "author": "ChatGPT4.1"
    },
    "86629": {
      "id": 2787925,
      "text": "Cô dâu Ashton Gill Stout đã tạo nên bất ngờ hoàn hảo cho chú rể Cameron.",
      "author": "ChatGPT4.1"
    },
    "86630": {
      "id": 2787926,
      "text": "Tôi thực sự rất bất ngờ và tôi nghĩ điều khiến tôi xúc động lúc đó chính là được nghe giọng hát của cô ấy.",
      "author": "ChatGPT4.1"
    },
    "86631": {
      "id": 2787927,
      "text": "Ờ... vì tôi đã không ngờ đến điều đó.",
      "author": "ChatGPT4.1"
    },
    "86632": {
      "id": 2787928,
      "text": "Đó là một khoảnh khắc rất khó tin, bạn biết đấy.",
      "author": "ChatGPT4.1"
    },
    "86633": {
      "id": 2787929,
      "text": "Hai tháng trước ngày cưới, Ashton đã đặt phòng thu âm và bí mật thu âm bài hát tình ca yêu thích của mình.",
      "author": "ChatGPT4.1"
    },
    "86634": {
      "id": 2787930,
      "text": "Đó là lời hứa mà em dành cho anh.",
      "author": "ChatGPT4.1"
    },
    "86635": {
