  "translations": {
    "76089": {
      "id": 3023953,
      "text": "Bạn đang tìm kiếm một món hời bất động sản thực sự an toàn tuyệt đối?",
      "author": "ChatGPT4.1"
    },
    "76090": {
      "id": 3023954,
      "text": "Còn gì bằng một boongke thời Chiến tranh Lạnh thực thụ đang sắp được đem ra đấu giá?",
      "author": "ChatGPT4.1"
    },
    "76091": {
      "id": 3023955,
      "text": "Theo SDL Auctions, boongke này được xây dựng vào những năm 1950",
      "author": "ChatGPT4.1"
    },
    "76092": {
      "id": 3023956,
      "text": "và nằm ẩn mình 14 feet dưới một cánh đồng ở Derbyshire, Anh.",
      "author": "ChatGPT4.1"
    },
    "76093": {
      "id": 3023957,
      "text": "Có kích thước tương đương một gara, boongke nhỏ xinh đã ngừng hoạt động này vẫn giữ lại phần nào nét duyên dáng vốn có.",
      "author": "ChatGPT4.1"
    },
    "76094": {
      "id": 3023958,
      "text": "Với các vật dụng đặc trưng như chăn chống cháy bằng amiăng, ống nhòm cổ điển,",
      "author": "ChatGPT4.1"
    },
    "76095": {
      "id": 3023959,
      "text": "và một tủ đựng thức ăn vẫn còn đầy ắp mà hoàn toàn không hề kinh khủng.",
      "author": "ChatGPT4.1"
    },
    "76096": {
      "id": 3023960,
      "text": "Ngoài ra còn có chiếc điện thoại đường dây nóng thời Chiến tranh Lạnh cho các báo động Đỏ thực sự.",
      "author": "ChatGPT4.1"
    },
    "76097": {
      "id": 3023961,
      "text": "Nhưng nó cũng đã được nâng cấp với những tiện nghi như thảm lót sàn, rèm nhung,",
      "author": "ChatGPT4.1"
    },
    "76098": {
      "id": 3023962,
      "text": "và một toilet hóa học chưa từng sử dụng.",
      "author": "ChatGPT4.1"
    },
    "76099": {
      "id": 3023963,
      "text": "Này, thật khó mà định giá cho những thứ đó!",
      "author": "ChatGPT4.1"
    },
    "76100": {
      "id": 3023964,
      "text": "Thực tế, những người đấu giá dự đoán các khách hàng sẽ chi đến 26,000 đô la cho mảnh lịch sử thân quen này.",
      "author": "ChatGPT4.1"
    },
    "76101": {
      "id": 3023965,
      "text": "Rất lý tưởng cho những ai muốn bảo vệ mình khỏi thị trường bất động sản đầy biến động.",
      "author": "ChatGPT4.1"
    },
    "76102": {
      "id": 3023966,
      "text": "Và cả, bạn biết đấy, một vụ nổ hạt nhân nhiệt hạch.",
      "author": "ChatGPT4.1"
    }
  }
}
