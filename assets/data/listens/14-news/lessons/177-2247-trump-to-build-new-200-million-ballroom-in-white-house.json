  "translations": {
    "89269": {
      "id": 3548274,
      "text": "Những thay đổi lớn sắp đến với Nhà Trắng và không phải ai cũng hài lòng về điều đó.",
      "author": "ChatGPT4.1"
    },
    "89270": {
      "id": 3548275,
      "text": "Tổng thống Trump đang xây dựng một phòng khiêu vũ khổng lồ gắn liền với Cánh Đông.",
      "author": "ChatGPT4.1"
    },
    "89271": {
      "id": 3548276,
      "text": "\"Nó sẽ rất đẹp, sẽ có tầm nhìn ra Đài tưởng niệm Washington.\"",
      "author": "ChatGPT4.1"
    },
    "89272": {
      "id": 3548277,
      "text": "\"Nó sẽ không ảnh hưởng đến tòa nhà hiện tại, sẽ không... nó sẽ nằm gần đó, nhưng không chạm vào.\"",
      "author": "ChatGPT4.1"
    },
    "89273": {
      "id": 3548278,
      "text": "Trong các bản thiết kế do Nhà Trắng công bố, phòng khiêu vũ có những cột lớn và rất nhiều cửa sổ.",
      "author": "ChatGPT4.1"
    },
    "89274": {
      "id": 3548279,
      "text": "Bên trong là một không gian rộng lớn, đủ lớn để chứa 650 khách,",
      "author": "ChatGPT4.1"
    },
    "89275": {
      "id": 3548280,
