  "translations": {
    "80501": {
      "id": 3374117,
      "text": "Bạn có thể niêm phong lời thề của mình bằng một nụ hôn.",
      "author": "ChatGPT4.1"
    },
    "80502": {
      "id": 3374118,
      "text": "Đó là một đám cưới tuyệt đẹp bên bờ biển ở Hawaii.",
      "author": "ChatGPT4.1"
    },
    "80503": {
      "id": 3374119,
      "text": "Và đây là một buổi lễ mà chú rể, Joe DiMeo, không chắc mình sẽ có dịp chứng kiến.",
      "author": "ChatGPT4.1"
    },
    "80504": {
      "id": 3374120,
      "text": "Đây là hình ảnh Joe trước kia: một chàng trai 18 tuổi điển trai.",
      "author": "ChatGPT4.1"
    },
    "80505": {
      "id": 3374121,
      "text": "Rồi một vụ tai nạn ô tô đã thay đổi cuộc đời và ngoại hình anh mãi mãi.",
      "author": "ChatGPT4.1"
    },
    "80506": {
      "id": 3374122,
      "text": "Joe đã ngủ gật khi đang lái xe.",
      "author": "ChatGPT4.1"
    },
    "80507": {
      "id": 3374123,
      "text": "Xe của anh bị lật và bốc cháy.",
      "author": "ChatGPT4.1"
    },
    "80508": {
      "id": 3374124,
      "text": "Anh bị bỏng hơn 80% cơ thể.",
      "author": "ChatGPT4.1"
    },
    "80509": {
      "id": 3374125,
      "text": "Trong một ca phẫu thuật kéo dài 23 giờ với sự tham gia của 140 nhân viên y tế tại NYU Langone Health,",
      "author": "ChatGPT4.1"
    },
    "80510": {
      "id": 3374126,
      "text": "Joe đã làm nên lịch sử y học,",
      "author": "ChatGPT4.1"
    },
    "80511": {
      "id": 3374127,
      "text": "khi anh được ghép một khuôn mặt mới cũng như đôi tay mới từ cùng một người hiến.",
      "author": "ChatGPT4.1"
    },
    "80512": {
      "id": 3374128,
      "text": "Một đường rạch nhỏ dọc theo chân tóc đã được sử dụng",
      "author": "ChatGPT4.1"
    },
    "80513": {
      "id": 3374129,
      "text": "với việc loại bỏ mô sẹo bên ngoài dọc theo cổ, tai, mí mắt và khuôn mặt.",
      "author": "ChatGPT4.1"
    },
    "80514": {
      "id": 3374130,
      "text": "Joe bắt đầu đăng tải về những gì mình đã trải qua và thu hút được nhiều người theo dõi trên mạng xã hội.",
      "author": "ChatGPT4.1"
    },
    "80515": {
      "id": 3374131,
      "text": "Trong số đó có Jessica Perez, một y tá đến từ Ohio.",
      "author": "ChatGPT4.1"
    },
    "80516": {
      "id": 3374132,
      "text": "Họ gắn kết với nhau vì cả hai đều nuôi chó Boston Terrier.",
      "author": "ChatGPT4.1"
    },
    "80517": {
      "id": 3374133,
      "text": "Một mối quan hệ đặc biệt đã nảy nở.",
      "author": "ChatGPT4.1"
    },
    "80518": {
      "id": 3374134,
      "text": "Jessica, bạn yêu điều gì ở Joe?",
      "author": "ChatGPT4.1"
    },
    "80519": {
      "id": 3374135,
      "text": "\"Anh ấy là một người hiền lành và tốt bụng. Anh ấy rất dễ gần gũi và để yêu.\"",
      "author": "ChatGPT4.1"
    },
    "80520": {
      "id": 3374136,
      "text": "\"Khi Jessica đến, tôi không tìm kiếm tình yêu. Mọi thứ tự nhiên xảy ra.\"",
      "author": "ChatGPT4.1"
    },
    "80521": {
      "id": 3374137,
      "text": "Sau gần bốn năm hẹn hò, Joe đã cầu hôn Jessica.",
      "author": "ChatGPT4.1"
    },
    "80523": {
      "id": 3374138,
      "text": "Và bây giờ, trên bờ biển Honolulu, một nghệ sĩ chơi ukulele hát tặng họ và một vũ công hula biểu diễn.",
      "author": "ChatGPT4.1"
    },
    "80524": {
      "id": 3374139,
      "text": "Họ trao nhau những vòng hoa truyền thống trước khi đọc lời thề nguyện.",
      "author": "ChatGPT4.1"
    },
    "80525": {
      "id": 3374140,
      "text": "\"Cùng nhau, chúng ta đã chứng minh rằng không có thử thách nào quá lớn,\"",
      "author": "ChatGPT4.1"
    },
    "80526": {
      "id": 3374141,
      "text": "\"và anh biết rằng khi ở bên em, chúng ta có thể vượt qua mọi thứ.\"",
      "author": "ChatGPT4.1"
    },
    "80527": {
      "id": 3374142,
      "text": "Bạn có thể niêm phong lời thề của mình bằng một nụ hôn.",
      "author": "ChatGPT4.1"
    },
    "80528": {
      "id": 3374143,
      "text": "Những người chứng kiến trên những chiếc thuyền độc mộc chèo qua khi người chủ hôn thổi kèn Pū truyền thống của Hawaii.",
      "author": "ChatGPT4.1"
    },
    "80529": {
      "id": 3374144,
      "text": "\"Bạn biết đấy, khi bạn tìm thấy người mình muốn ở bên, bạn sẽ không thể tưởng tượng được một ngày thiếu họ. Và với Joe cũng vậy.\"",
      "author": "ChatGPT4.1"
    },
    "80522": {
      "id": 3374190,
      "text": "...",
      "author": "GoogleTranslate"
    }
  }
