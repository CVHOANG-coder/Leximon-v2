  "translations": {
    "82829": {
      "id": 2618550,
      "text": "Hàng ngàn người đang phải đối mặt với sự tàn phá to lớn từ những cơn gió mạnh, mưa lớn, và các đợt bùng phát lốc xoáy trên nhiều bang khác nhau.",
      "author": "ChatGPT4.1"
    },
    "82830": {
      "id": 2618551,
      "text": "Hàng chục người đã thiệt mạng.",
      "author": "ChatGPT4.1"
    },
    "82831": {
      "id": 2618552,
      "text": "Nó bắt đầu vào thứ Sáu ở vùng Trung Tây với một dải bão lớn di chuyển về phía đông,",
      "author": "ChatGPT4.1"
    },
    "82832": {
      "id": 2618553,
      "text": "ảnh hưởng đến hơn 900 dặm của khu vực này.",
      "author": "ChatGPT4.1"
    },
    "82833": {
      "id": 2618554,
      "text": "Kansas và Texas đã chứng kiến những trận bão bụi do gió mạnh gây ra.",
      "author": "ChatGPT4.1"
    },
    "82834": {
      "id": 2618555,
      "text": "Thống đốc Oklahoma đã ban bố tình trạng khẩn cấp do cháy rừng lan rộng bởi gió mạnh.",
      "author": "ChatGPT4.1"
    },
    "82835": {
      "id": 2618556,
      "text": "Sau đó vào thứ Bảy, chúng ta đã chứng kiến số lượng cảnh báo lốc xoáy nhiều nhất cả nước kể từ tháng Tư năm ngoái,",
      "author": "ChatGPT4.1"
    },
    "82836": {
      "id": 2618557,
      "text": "với ít nhất 163 cảnh báo được phát ra.",
      "author": "ChatGPT4.1"
    },
    "82837": {
      "id": 2618558,
      "text": "Hơn 40 trận lốc xoáy được báo cáo đã quét qua 8 bang ở vùng Trung Tây và miền Nam.",
      "author": "ChatGPT4.1"
    },
    "82838": {
      "id": 2618559,
      "text": "Thời tiết khắc nghiệt tiếp tục kéo dài đến Chủ Nhật, với các cảnh báo lốc xoáy được phát ra dọc bờ Đông.",
      "author": "ChatGPT4.1"
    },
    "82839": {
      "id": 2618560,
      "text": "Hàng trăm nghìn người đã bị mất điện sau cơn bão.",
      "author": "ChatGPT4.1"
    },
    "82840": {
      "id": 2618561,
      "text": "Alabama, Mississippi và Missouri bị lốc xoáy tấn công dữ dội.",
      "author": "ChatGPT4.1"
    },
    "82841": {
      "id": 2618562,
      "text": "Ở một số khu vực, đường dây điện bị đổ, cây cối nằm la liệt,",
      "author": "ChatGPT4.1"
    },
    "82842": {
      "id": 2618563,
      "text": "trong khi các mảnh vỡ từ những tòa nhà và nhà cửa bị phá hủy đang chắn ngang các con đường.",
      "author": "ChatGPT4.1"
    }
  }
}
