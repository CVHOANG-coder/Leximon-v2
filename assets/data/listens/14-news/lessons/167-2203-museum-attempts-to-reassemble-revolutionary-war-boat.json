    },
    "87095": {
      "id": 3271129,
      "text": "Các mảnh của chiếc thuyền đã được chăm sóc cẩn thận trước khi có thể ráp lại.",
      "author": "ChatGPT4.1"
    },
    "87096": {
      "id": 3271130,
      "text": "Bảo tàng cho biết mỗi mảnh trong số 600 mảnh này đã được bảo quản trong một dung dịch đặc biệt trong nhiều năm.",
      "author": "ChatGPT4.1"
    },
    "87097": {
