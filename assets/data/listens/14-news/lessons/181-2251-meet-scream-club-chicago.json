  "translations": {
    "89346": {
      "id": 3553022,
      "text": "Một câu lạc bộ trị liệu đặc biệt quy tụ để xử lý tất cả những cảm xúc lớn của họ theo một cách lớn lao.",
      "author": "ChatGPT4.1"
    },
    "89347": {
      "id": 3553023,
      "text": "Đó là một cách để ngửi hoa và làm nguội súp.",
      "author": "ChatGPT4.1"
    },
    "89348": {
      "id": 3553024,
      "text": "Hãy làm quen với Câu lạc bộ La hét Chicago.",
      "author": "ChatGPT4.1"
    },
    "89349": {
      "id": 3553025,
      "text": "Một nhóm người gặp nhau mỗi tuần trên một bãi biển của hồ Michigan, nơi mọi người có thể giải tỏa mọi thứ mà không bị phán xét.",
      "author": "ChatGPT4.1"
    },
    "89350": {
      "id": 3553026,
      "text": "\"Gần đây gia đình tôi có nhiều thay đổi, và con gái tôi đã trải qua rất nhiều cảm xúc,\"",
      "author": "ChatGPT4.1"
    },
    "89351": {
      "id": 3553027,
      "text": "\"và tôi cảm thấy đó là điều rất tốt khi con bé thấy người lớn xử lý tất cả những cảm xúc buồn bã và khó khăn một cách thật lành mạnh.\"",
      "author": "ChatGPT4.1"
    },
    "89352": {
      "id": 3553028,
      "text": "Đầu tiên, những người tham gia sẽ hít thở sâu.",
      "author": "ChatGPT4.1"
    },
    "89353": {
      "id": 3553029,
      "text": "Sau đó, họ ném xuống nước những mảnh giấy phân hủy sinh học đã ghi lại những điều khiến họ bực bội.",
      "author": "ChatGPT4.1"
    },
    "89354": {
      "id": 3553030,
      "text": "Sau đó, họ la hét.",
      "author": "ChatGPT4.1"
    },
    "89355": {
      "id": 3553031,
      "text": "Bực bội, giận dữ, lo âu, đó đều là cảm xúc hợp lý mà ai cũng từng trải qua, đúng không?",
      "author": "ChatGPT4.1"
    },
    "89356": {
      "id": 3553032,
      "text": "Vậy nên, lần tới nếu bạn cảm thấy quá tải, hãy thử cách này nhé.",
      "author": "ChatGPT4.1"
    },
    "89357": {
      "id": 3553033,
      "text": "Nhưng nếu xung quanh bạn không có hồ nước nào,",
      "author": "ChatGPT4.1"
    },
    "89358": {
      "id": 3553034,
      "text": "bạn có thể muốn báo trước với gia đình hoặc hàng xóm, hoặc lấy một cái gối và kìm nén lại một chút.",
      "author": "ChatGPT4.1"
    }
  }
}
