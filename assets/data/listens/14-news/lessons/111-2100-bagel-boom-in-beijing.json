  "translations": {
    "82996": {
      "id": 2600349,
      "text": "Bây giờ là tin tức về sự bùng nổ của bánh mì vòng bagel ở Bắc Kinh.",
      "author": "ChatGPT4.1"
    },
    "82997": {
      "id": 2600350,
      "text": "Bagel là loại bánh khá phổ biến với nhiều người trong chúng ta, đặc biệt là ở Mỹ.",
      "author": "ChatGPT4.1"
    },
    "82998": {
      "id": 2600351,
      "text": "Nhưng ở bên kia bán cầu tại Trung Quốc, chúng chưa từng thực sự được ưa chuộng.",
      "author": "ChatGPT4.1"
    },
    "82999": {
      "id": 2600352,
      "text": "Nhưng gần đây, chúng đã trở thành trào lưu ẩm thực mới không thể thiếu.",
      "author": "ChatGPT4.1"
    },
    "83000": {
      "id": 2600353,
      "text": "Hãy cùng phóng viên Mark Stewart của chúng tôi tại Bắc Kinh để tìm hiểu lý do tại sao người dân địa phương lại sẵn sàng trả giá cao gấp 10 đến 20 lần",
      "author": "ChatGPT4.1"
    },
    "83001": {
      "id": 2600354,
      "text": "cho những chiếc bánh mì vòng ngon miệng này so với các loại bánh và đồ ăn vặt truyền thống.",
      "author": "ChatGPT4.1"
    },
    "83002": {
      "id": 2600355,
      "text": "Một số người nói rằng chúng không chỉ đơn giản là bánh mì có lỗ ở giữa,",
      "author": "ChatGPT4.1"
    },
    "83003": {
      "id": 2600356,
      "text": "mà còn là một phong cách sống.",
      "author": "ChatGPT4.1"
    },
    "83004": {
      "id": 2600357,
      "text": "Theo tôi đây là một loại bánh mì mới.",
      "author": "ChatGPT4.1"
    },
    "83005": {
      "id": 2600358,
      "text": "Ăn bagel có phải là một việc sành điệu ở Trung Quốc không?",
      "author": "ChatGPT4.1"
    },
    "83006": {
      "id": 2600359,
      "text": "Ban đầu, tôi nghĩ nó khá thời thượng vì trước đây chưa từng có bagel.",
      "author": "ChatGPT4.1"
    },
    "83007": {
      "id": 2600360,
      "text": "Nhưng bây giờ, tôi nghĩ nó đã trở thành lựa chọn quen thuộc của tôi.",
      "author": "ChatGPT4.1"
    },
    "83008": {
      "id": 2600361,
      "text": "Tuy nhiên, một số người vẫn chưa hoàn toàn hiểu được.",
      "author": "ChatGPT4.1"
    },
    "83009": {
      "id": 2600362,
      "text": "Không khí nhộn nhịp làm bánh đã bắt đầu ở tiệm bánh bagel này.",
      "author": "ChatGPT4.1"
    },
    "83010": {
      "id": 2600363,
      "text": "Nhưng đây không phải là thành phố New York. Đây là Bắc Kinh, Trung Quốc.",
      "author": "ChatGPT4.1"
    },
    "83011": {
      "id": 2600364,
      "text": "Có thể nói thành phố đang bùng nổ với bagel.",
      "author": "ChatGPT4.1"
    },
    "83012": {
      "id": 2600365,
      "text": "Có mặt ở các quán cà phê, trên ứng dụng giao đồ ăn, và tràn ngập mạng xã hội.",
      "author": "ChatGPT4.1"
    },
    "83013": {
      "id": 2600366,
      "text": "Vừa tốt cho sức khỏe, đẹp mắt, lại còn là một xu hướng mới.",
      "author": "ChatGPT4.1"
    },
    "83014": {
      "id": 2600367,
      "text": "Đây là bánh bao truyền thống của Trung Quốc, và giống như bagel, được làm từ bột mì và nước.",
      "author": "ChatGPT4.1"
    },
    "83015": {
      "id": 2600368,
      "text": "Nhưng bagel lại có giá trung bình cao hơn gấp 10 đến 20 lần,",
      "author": "ChatGPT4.1"
    },
    "83016": {
      "id": 2600369,
      "text": "và người ta vẫn sẵn sàng chi trả cho nó.",
      "author": "ChatGPT4.1"
    }
