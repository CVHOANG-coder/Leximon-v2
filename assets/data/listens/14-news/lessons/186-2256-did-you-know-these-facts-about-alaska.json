  "translations": {
    "89403": {
      "id": 3580392,
      "text": "Bạn có biết Alaska từng là một phần của Nga không?",
      "author": "ChatGPT4.1"
    },
    "89404": {
      "id": 3580393,
      "text": "Đúng vậy, Hoa Kỳ đã mua vùng đất sẽ trở thành bang thứ 49 từ Đế quốc Nga gần 158 năm trước với giá 7,2 triệu đô la.",
      "author": "ChatGPT4.1"
    },
    "89405": {
      "id": 3580394,
      "text": "Ngày Alaska được tổ chức hàng năm để kỷ niệm việc chuyển giao chính thức vào ngày 18 tháng 10 năm 1867.",
      "author": "ChatGPT4.1"
    },
    "89406": {
      "id": 3580395,
      "text": "Và Alaska không chỉ là bang lớn nhất của Hoa Kỳ, mà còn là bang cực bắc, cực tây và cực đông nhất.",
      "author": "ChatGPT4.1"
    },
    "89407": {
      "id": 3580396,
      "text": "Bạn có biết không?",
      "author": "ChatGPT4.1"
    },
    "89408": {
      "id": 3580397,
      "text": "Đúng vậy, quần đảo Aleutian của bang này kéo dài xa về phía tây đến mức nó lại nằm ở phía đông.",
      "author": "ChatGPT4.1"
    },
    "89409": {
      "id": 3580398,
      "text": "Chúng vượt qua kinh tuyến 180, đặt chúng vào Bán cầu Đông.",
      "author": "ChatGPT4.1"
    }
  }
