  "translations": {
    "83630": {
      "id": 2625978,
      "text": "Đó là một cảnh tượng buồn.",
      "author": "ChatGPT4.1"
    },
    "83631": {
      "id": 2625979,
      "text": "Tác giả đang bán cuốn sách kinh doanh tự lực của mình tại một hiệu sách địa phương.",
      "author": "ChatGPT4.1"
    },
    "83632": {
      "id": 2625980,
      "text": "Và doanh số bán, nói một cách nhẹ nhàng, không hề cao.",
      "author": "ChatGPT4.1"
    },
    "83633": {
      "id": 2625981,
      "text": "Điều đó xảy ra tại cửa hàng Barnes & Noble ở Wilkes-Barre, Pennsylvania.",
      "author": "ChatGPT4.1"
    },
    "83634": {
      "id": 2625982,
      "text": "Như một phép lịch sự dành cho các tác giả địa phương, hiệu sách đã cho phép Jonathan Stanley bày một bàn đầy sách,",
      "author": "ChatGPT4.1"
    },
    "83635": {
      "id": 2625983,
      "text": "và ký tặng cho bất kỳ khách hàng nào mua một cuốn.",
      "author": "ChatGPT4.1"
    },
    "83636": {
      "id": 2625984,
      "text": "Nhưng khi thời gian trôi qua, anh ấy chỉ bán được bốn cuốn.",
      "author": "ChatGPT4.1"
    },
    "83637": {
      "id": 2625985,
      "text": "Sau đó, một khách hàng tên Taylor nhận ra anh ấy đang bị lãng quên.",
      "author": "ChatGPT4.1"
    },
    "83638": {
      "id": 2625986,
      "text": "Cô cảm thấy thương cảm cho anh.",
      "author": "ChatGPT4.1"
    },
    "83639": {
      "id": 2625987,
      "text": "Tôi biết cảm giác như thế nào khi mọi người đi ngang qua bạn và chẳng nhìn bạn lần thứ hai.",
      "author": "ChatGPT4.1"
    },
    "83640": {
      "id": 2625988,
      "text": "Vì vậy cô đã đăng video này.",
      "author": "ChatGPT4.1"
    },
    "83641": {
      "id": 2625989,
      "text": "Người đàn ông dễ thương này đang ngồi ở Barnes & Noble với một chồng sách do ông viết.",
      "author": "ChatGPT4.1"
    },
    "83642": {
      "id": 2625990,
      "text": "Và trái tim tôi tan vỡ mỗi lần ai đó đi ngang qua ông ấy.",
      "author": "ChatGPT4.1"
    },
    "83643": {
      "id": 2625991,
      "text": "Con gái 4 tuổi của cô, Ella, đã tiến đến gần người viết cô đơn.",
      "author": "ChatGPT4.1"
    },
    "83644": {
      "id": 2625992,
      "text": "Chính Ella đã lại gần tôi, và...",
      "author": "ChatGPT4.1"
    },
    "83645": {
      "id": 2625993,
      "text": "Điều đầu tiên bé nói là \"Khi lớn lên cháu muốn trở thành tác giả.\"",
      "author": "ChatGPT4.1"
    },
    "83646": {
      "id": 2625994,
      "text": "Video về cuộc gặp gỡ ở hiệu sách đó đã được xem đến 100 triệu lần và vẫn đang tăng lên.",
      "author": "ChatGPT4.1"
    },
    "83647": {
      "id": 2625995,
      "text": "Bạn biết không, cuốn sách \"Purposeful Performance: The Secret Mix of Connecting Leading and Succeeding\" của anh ấy",
      "author": "ChatGPT4.1"
    },
    "83648": {
      "id": 2625996,
      "text": "giờ đây đã trở thành cuốn sách bán chạy số một trên Amazon.",
      "author": "ChatGPT4.1"
    },
    "83649": {
      "id": 2625997,
      "text": "Vậy tình hình doanh số thế nào?",
      "author": "ChatGPT4.1"
    },
    "83650": {
      "id": 2625998,
      "text": "À... đã bán được hơn 10.000 cuốn.",
      "author": "ChatGPT4.1"
    },
    "83651": {
      "id": 2625999,
      "text": "Hơn 10.000 cuốn sách, thật là nhiều!",
      "author": "ChatGPT4.1"
    },
    "83652": {
      "id": 2626000,
      "text": "Tác giả cho biết anh đã viết và tự xuất bản cuốn sách này sau khi mất việc làm tư vấn kinh doanh.",
      "author": "ChatGPT4.1"
    },
    "83653": {
      "id": 2626001,
      "text": "Giờ đây, anh nói rằng mình mãi mãi biết ơn.",
      "author": "ChatGPT4.1"
    },
    "83654": {
      "id": 2626002,
      "text": "Khi tôi gặp Ella, bé đã chạm đến trái tim tôi ngay lập tức.",
      "author": "ChatGPT4.1"
    }
  }
}
