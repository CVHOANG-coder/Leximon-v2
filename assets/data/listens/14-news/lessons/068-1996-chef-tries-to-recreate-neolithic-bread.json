  "translations": {
    "77578": {
      "id": 2647607,
      "text": "Đây có phải là những ổ bánh mì lâu đời nhất trên thế giới không?",
      "author": "ChatGPT4.1"
    },
    "77579": {
      "id": 2647608,
      "text": "Cũng gần như vậy.",
      "author": "ChatGPT4.1"
    },
    "77580": {
      "id": 2647609,
      "text": "Một đầu bếp ở Thổ Nhĩ Kỳ nảy ra ý tưởng phục hồi loại bánh mì từng được ăn vào thời kỳ đồ đá mới,",
      "author": "ChatGPT4.1"
    },
    "77581": {
      "id": 2647610,
      "text": "bắt đầu cách đây 8.600 năm.",
      "author": "ChatGPT4.1"
    },
    "77582": {
      "id": 2647611,
      "text": "Hai năm trước, các nhà khảo cổ học khai quật ở tỉnh Konya đã tìm thấy một vật thể cháy xốp.",
      "author": "ChatGPT4.1"
    },
    "77583": {
      "id": 2647612,
      "text": "Các xét nghiệm cho thấy đó là một ổ bánh mì men và có chứa hạt lúa mì cùng đậu Hà Lan.",
      "author": "ChatGPT4.1"
    },
    "77584": {
      "id": 2647613,
      "text": "Đầu bếp Ulas Tekerkaya chỉ có thể tự hỏi nó sẽ có vị như thế nào",
      "author": "ChatGPT4.1"
    },
    "77585": {
      "id": 2647614,
      "text": "và bắt tay vào hồi sinh công thức bánh mì của tổ tiên đã thất truyền từ lâu.",
      "author": "ChatGPT4.1"
    },
    "77586": {
      "id": 2647615,
      "text": "Chỉ sử dụng các loại hạt địa phương, vị đầu bếp này được cho là đã thử rất nhiều lần",
      "author": "ChatGPT4.1"
    },
    "77587": {
      "id": 2647616,
      "text": "không chỉ để làm đúng kết cấu mà còn cả hương vị.",
      "author": "ChatGPT4.1"
    },
    "77588": {
      "id": 2647617,
      "text": "Điều đó đòi hỏi phải nướng bánh giống như những người thợ làm bánh ngày xưa:",
      "author": "ChatGPT4.1"
    },
    "77589": {
      "id": 2647618,
      "text": "trên lò củi.",
      "author": "ChatGPT4.1"
    },
    "77590": {
      "id": 2647619,
      "text": "Việc thử vị cho thấy ông có thể đã đúng hướng.",
      "author": "ChatGPT4.1"
    },
    "77591": {
      "id": 2647620,
      "text": "Dù ông sẽ không bao giờ biết được bánh mì của mình so với bánh ngày xưa như thế nào,",
      "author": "ChatGPT4.1"
    },
    "77592": {
      "id": 2647621,
      "text": "nó vẫn có thể tạo ra sự kết nối với những nền văn minh mà chúng ta vẫn đang cố gắng tìm hiểu.",
      "author": "ChatGPT4.1"
    }
  }
}
