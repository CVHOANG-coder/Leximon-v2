  "translations": {
    "82843": {
      "id": 2572130,
      "text": "Một nỗ lực toàn cầu đầy tham vọng nhằm khám phá các sinh vật biển mới đang đem lại thành quả lớn.",
      "author": "ChatGPT4.1"
    },
    "82844": {
      "id": 2572131,
      "text": "làm sáng tỏ hơn 800 loài mới được ghi nhận,",
      "author": "ChatGPT4.1"
    },
    "82845": {
      "id": 2572132,
      "text": "bao gồm một loài cá mập hình cây đàn guitar nổi bật nhất.",
      "author": "ChatGPT4.1"
    },
    "82846": {
      "id": 2572133,
      "text": "Một nhiệm vụ kéo dài 10 năm có tên là Ocean Census đã được tiến hành từ năm 2023.",
      "author": "ChatGPT4.1"
    },
    "82847": {
      "id": 2572134,
      "text": "Và bản cập nhật lớn đầu tiên của dự án này bao gồm 10 chuyến thám hiểm trên khắp thế giới với các thợ lặn, tàu lặn do người điều khiển và các phương tiện điều khiển từ xa...",
      "author": "ChatGPT4.1"
    },
    "82848": {
      "id": 2572135,
      "text": "đã công bố 866 loài được phát hiện và được coi là hoàn toàn mới đối với khoa học,",
      "author": "ChatGPT4.1"
    },
    "82849": {
      "id": 2572136,
      "text": "bao gồm một loài ốc mút biển sâu, một loài thân mềm có nọc độc,",
      "author": "ChatGPT4.1"
    },
    "82850": {
      "id": 2572137,
      "text": "và một loài cá ngựa cực kỳ nhỏ bé.",
      "author": "ChatGPT4.1"
    },
    "82851": {
      "id": 2572138,
      "text": "Nhưng chính loài cá mập hình đàn guitar mới được phát hiện này mới thực sự gây chú ý.",
      "author": "ChatGPT4.1"
    },
    "82852": {
      "id": 2572139,
      "text": "Được đặt tên như vậy vì... hình dáng giống cây đàn guitar.",
      "author": "ChatGPT4.1"
    },
    "82853": {
      "id": 2572140,
      "text": "Được tìm thấy ngoài khơi Mozambique và Tanzania, việc phát hiện ra loài cá có nguy cơ tuyệt chủng này là một \"bản nhạc\" đầy hứng khởi đối với các nhà thám hiểm.",
      "author": "ChatGPT4.1"
    }
  }
