  "translations": {
    "86639": {
      "id": 3031150,
      "text": "Chào nắng! Chúc mừng thứ Sáu vui vẻ.",
      "author": "ChatGPT4.1"
    },
    "86640": {
      "id": 3031151,
      "text": "Tôi là Coy Wire trong một chuyến thực địa CNN 10 đưa bạn đến từ Asheville, North Carolina dọc theo dãy núi Blue Ridge xinh đẹp.",
      "author": "ChatGPT4.1"
    },
    "86641": {
      "id": 3031152,
      "text": "Chúng tôi đang đứng trên khuôn viên của dinh thự tư nhân lớn nhất nước Mỹ, Biltmore Estate.",
      "author": "ChatGPT4.1"
    },
    "86642": {
      "id": 3031153,
      "text": "Và điều này xứng đáng với...",
      "author": "ChatGPT4.1"
    },
    "86643": {
      "id": 3031154,
      "text": "Bạn có biết, Biltmore Estate được xây dựng vào năm 1895 bởi George Vanderbilt, cháu trai của đại gia vận tải lừng danh Cornelius Vanderbilt.",
      "author": "ChatGPT4.1"
    },
    "86644": {
      "id": 3031155,
      "text": "Phải mất 6 năm để xây dựng.",
      "author": "ChatGPT4.1"
    },
    "86645": {
      "id": 3031156,
      "text": "Ông cùng vợ là Edith và con gái Cornelia đã sống trong ngôi nhà có 250 phòng này",
      "author": "ChatGPT4.1"
    },
    "86646": {
      "id": 3031157,
      "text": "với 35 phòng ngủ, 43 phòng tắm, và 65 lò sưởi.",
      "author": "ChatGPT4.1"
    },
    "86647": {
      "id": 3031158,
      "text": "Ở đây còn có rất nhiều cửa bí mật và lối đi ẩn.",
      "author": "ChatGPT4.1"
    },
    "86648": {
      "id": 3031159,
      "text": "Có lẽ điều ấn tượng nhất là khu vườn sau rộng 8.000 mẫu tuyệt đẹp.",
      "author": "ChatGPT4.1"
    },
    "86649": {
      "id": 3031160,
      "text": "Năm 1930, gia đình quyết định mở cửa dinh thự cho công chúng như một cách thúc đẩy kinh tế Asheville trong thời kỳ Đại Suy Thoái.",
      "author": "ChatGPT4.1"
    },
    "86650": {
      "id": 3031161,
      "text": "Dinh thự hiện vẫn được điều hành bởi hậu duệ của George Vanderbilt.",
      "author": "ChatGPT4.1"
    },
    "86651": {
      "id": 3031162,
      "text": "Và ngày nay, khoảng 1,3 triệu du khách mỗi năm tận hưởng không gian hoài niệm và kỳ diệu này.",
      "author": "ChatGPT4.1"
    },
    "86652": {
      "id": 3031163,
      "text": "Bạn có thể cưỡi ngựa, leo núi, đi xe đạp, đi xe ngựa, picnic, dạo chơi trong những khu vườn tuyệt đẹp và xem huấn luyện chim ưng.",
      "author": "ChatGPT4.1"
    },
    "86654": {
      "id": 3031165,
      "text": "Bây giờ, một lý do nữa khiến tôi có mặt tại đây hôm nay là để làm nổi bật nỗ lực phục hồi đáng ngạc nhiên",
      "author": "ChatGPT4.1"
    },
    "86655": {
      "id": 3031166,
      "text": "sau khi thị trấn nghệ thuật lập dị này bị tàn phá bởi siêu bão Helen.",
      "author": "ChatGPT4.1"
    },
    "86656": {
      "id": 3031167,
      "text": "Đã 9 tháng kể từ khi cơn bão cấp 4 càn quét thung lũng sông Swannanoa ở tây Bắc Carolina, gây ngập lụt, sạt lở đất, làm đổ cây, phá hủy nhà cửa và doanh nghiệp.",
      "author": "ChatGPT4.1"
    },
    "86657": {
      "id": 3031168,
      "text": "Và dù nhiều vết thương còn chưa lành,",
      "author": "ChatGPT4.1"
    },
    "86658": {
      "id": 3031169,
      "text": "tiến độ dọn dẹp và xây dựng lại nơi đây thực sự đáng kinh ngạc.",
      "author": "ChatGPT4.1"
    },
    "86659": {
      "id": 3031170,
      "text": "Asheville và các thị trấn lân cận dựa vào du lịch để phát triển kinh tế.",
      "author": "ChatGPT4.1"
    },
    "86660": {
      "id": 3031171,
      "text": "Người dân địa phương hy vọng mùa hè này, du khách, người yêu nghệ thuật và những ai mê phiêu lưu sẽ trở lại vùng tây Bắc Carolina.",
      "author": "ChatGPT4.1"
    },
    "86661": {
      "id": 3031172,
      "text": "Con đường sau siêu bão Helen thật dài, nhưng chúng tôi rất vui mừng đón mọi người trở lại, biết rằng chúng tôi vẫn ở đây và đang xây dựng lại.",
      "author": "ChatGPT4.1"
    },
    "86662": {
      "id": 3031173,
      "text": "Cảm ơn Chúa vì có những tình nguyện viên và sự quyên góp, họ đang giúp xây dựng lại thị trấn này.",
      "author": "ChatGPT4.1"
    },
    "86663": {
      "id": 3031174,
      "text": "Khi đối mặt với bi kịch hay tuyệt vọng, ngài Mr. Rogers nổi tiếng từng nói: \"Hãy tìm những người giúp đỡ.\"",
      "author": "ChatGPT4.1"
    },
    "86664": {
      "id": 3031175,
      "text": "Và ở Bắc Carolina thì không cần tìm đâu xa.",
      "author": "ChatGPT4.1"
    },
    "86665": {
      "id": 3031176,
      "text": "Dưới đây là một vài câu chuyện của họ...",
      "author": "ChatGPT4.1"
    },
    "86653": {
      "id": 3565481,
      "text": "Biltmore Estate là điểm đến không thể bỏ qua cùng với trung tâm thành phố Asheville xinh đẹp và cổ kính.",
      "author": "ChatGPT4.1"
    }
  }
