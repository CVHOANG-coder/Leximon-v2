  "translations": {
    "74655": {
      "id": 3059529,
      "text": "Những đợt sóng lớn ập vào bờ kè biển.",
      "author": "ChatGPT4.1"
    },
    "74656": {
      "id": 3059530,
      "text": "Cây cối bị gãy như những cành cây nhỏ.",
      "author": "ChatGPT4.1"
    },
    "74657": {
      "id": 3059531,
      "text": "Và mưa như trút nước.",
      "author": "ChatGPT4.1"
    },
    "74658": {
      "id": 3059532,
      "text": "Đó là những gì đang diễn ra ngay lúc này tại Đài Loan.",
      "author": "ChatGPT4.1"
    },
    "74659": {
      "id": 3059533,
      "text": "Bão Kong-Rey, một cơn bão mạnh, đã đổ bộ trong tuần này.",
      "author": "ChatGPT4.1"
    },
    "74660": {
      "id": 3059534,
      "text": "Đây là cơn bão lớn nhất tấn công hòn đảo kể từ năm 1996.",
      "author": "ChatGPT4.1"
    },
    "74661": {
      "id": 3059535,
      "text": "Nếu cơn bão này là một chiếc ô tô, nó sẽ chạy với tốc độ 125 dặm một giờ.",
      "author": "ChatGPT4.1"
    },
    "74662": {
      "id": 3059536,
      "text": "Đó là tốc độ gió đang thổi.",
      "author": "ChatGPT4.1"
    },
    "74663": {
      "id": 3059537,
      "text": "Điều làm Kong-Rey trở nên đặc biệt không chỉ là tốc độ của nó, mà còn là kích thước.",
      "author": "ChatGPT4.1"
    },
    "74664": {
      "id": 3059538,
      "text": "Phạm vi gió mạnh nhất của cơn bão kéo dài khoảng 200 dặm.",
      "author": "ChatGPT4.1"
    },
    "74665": {
      "id": 3059539,
      "text": "Đó giống như một cơn bão có thể rộng gần bằng toàn bộ tiểu bang Maine.",
      "author": "ChatGPT4.1"
    },
    "74666": {
      "id": 3059540,
      "text": "Tác động ư? Thực sự là rất lớn.",
      "author": "ChatGPT4.1"
    },
    "74667": {
      "id": 3059541,
      "text": "Đáng buồn là đã có một người thiệt mạng.",
      "author": "ChatGPT4.1"
    },
    "74668": {
      "id": 3059542,
      "text": "Và hàng chục người khác đã bị thương tính đến thời điểm ghi hình chương trình.",
      "author": "ChatGPT4.1"
    },
    "74669": {
      "id": 3059543,
      "text": "Đài Loan đã huy động hơn 34.000 binh sĩ để hỗ trợ công tác cứu hộ,",
      "author": "ChatGPT4.1"
    },
    "74670": {
      "id": 3059544,
      "text": "và sơ tán hơn 8.600 người khỏi các khu vực nguy hiểm.",
      "author": "ChatGPT4.1"
    },
    "74671": {
      "id": 3059545,
      "text": "Hơn 500 chuyến bay đã bị hủy, trong đó có 300 chuyến bay quốc tế.",
      "author": "ChatGPT4.1"
    },
    "74672": {
      "id": 3059546,
      "text": "Ngay cả tuyến đường sắt cao tốc nổi tiếng cũng đang hoạt động với công suất hạn chế.",
      "author": "ChatGPT4.1"
    },
    "74673": {
      "id": 3059547,
      "text": "Các chuyên gia khí tượng Đài Loan cảnh báo về mưa cực lớn.",
      "author": "ChatGPT4.1"
    },
    "74674": {
      "id": 3059548,
      "text": "Và đó là cấp cảnh báo cao nhất của họ.",
      "author": "ChatGPT4.1"
    },
    "74675": {
      "id": 3059549,
      "text": "Một số khu vực ở đông và bắc Đài Loan có thể thấy thêm 20 inch mưa nữa.",
      "author": "ChatGPT4.1"
    },
    "74676": {
      "id": 3059550,
      "text": "Điều này có thể dẫn đến lũ quét và sạt lở đất.",
      "author": "ChatGPT4.1"
    },
    "74677": {
      "id": 3059551,
      "text": "Các nhà khoa học cho biết đại dương ấm lên đang khiến các cơn bão như Kong-Rey mạnh lên nhanh hơn trước đây.",
      "author": "ChatGPT4.1"
    },
    "74678": {
      "id": 3059552,
      "text": "Đây thực sự là cơn bão thứ ba của Đài Loan trong năm nay.",
      "author": "ChatGPT4.1"
    },
    "74679": {
      "id": 3059553,
      "text": "Sau khi qua Đài Loan, Kong-Rey vẫn chưa dừng lại.",
      "author": "ChatGPT4.1"
    },
    "74680": {
      "id": 3059554,
      "text": "Cơn bão đang hướng về biển Hoa Đông và Nhật Bản.",
      "author": "ChatGPT4.1"
    },
    "74681": {
      "id": 3059555,
      "text": "Bạn có thể truy cập cnn.com để cập nhật thông tin mới nhất về đường đi của bão.",
      "author": "ChatGPT4.1"
    }
  }
}
