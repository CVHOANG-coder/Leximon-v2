  "translations": {
    "85692": {
      "id": 2713998,
      "text": "Câu chuyện hôm nay được chấm 10 trên 10 là về một chú chim cánh cụt con mới chắc chắn sẽ làm bạn thêm phần hào hứng.",
      "author": "ChatGPT4.1"
    },
    "85693": {
      "id": 2713999,
      "text": "Tại thủy cung Niagara xinh đẹp và nên thơ ở New York,",
      "author": "ChatGPT4.1"
    },
    "85694": {
      "id": 2714000,
      "text": "một chú chim cánh cụt Humboldt con tinh nghịch đang thu hút sự chú ý như một hình mẫu của sự gắn bó thuần khiết.",
      "author": "ChatGPT4.1"
    },
    "85695": {
      "id": 2714001,
      "text": "Và dù phải đến mùa hè này bằng xét nghiệm máu mới biết được giới tính của nó,",
      "author": "ChatGPT4.1"
    },
    "85696": {
      "id": 2714002,
      "text": "thủy cung đang tha thiết kêu gọi mọi người tham gia đặt tên cho chú chim cánh cụt chưa có tên.",
      "author": "ChatGPT4.1"
    },
    "85697": {
      "id": 2714003,
      "text": "Họ gợi ý ba cái tên cho cộng đồng, lấy cảm hứng từ quê hương Peru của loài chim này.",
      "author": "ChatGPT4.1"
    },
    "85698": {
      "id": 2714004,
      "text": "Cantuta, quốc hoa của Peru.",
      "author": "ChatGPT4.1"
    },
    "85699": {
      "id": 2714005,
      "text": "Machu, theo tên thành phố cổ Machu Picchu,",
      "author": "ChatGPT4.1"
    },
    "85700": {
      "id": 2714006,
      "text": "và Centa, từ tiếng Tây Ban Nha có nghĩa là 60, để kỷ niệm 60 năm thành lập thủy cung.",
      "author": "ChatGPT4.1"
    },
    "85701": {
      "id": 2714007,
      "text": "Đây là một lời kêu gọi có chủ đích, hy vọng tạo ra điều gì đó vô cùng ý nghĩa.",
      "author": "ChatGPT4.1"
    },
    "85702": {
      "id": 2714008,
      "text": "Mỗi lượt bình chọn trị giá 1 đô la trên website thủy cung sẽ góp vào quỹ chăm sóc động vật.",
      "author": "ChatGPT4.1"
    }
  }
