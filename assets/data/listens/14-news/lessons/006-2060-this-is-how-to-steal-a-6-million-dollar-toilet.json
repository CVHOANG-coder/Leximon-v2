    },
    "81212": {
      "id": 2625380,
      "text": "nơi sinh của Winston Churchill.",
      "author": "ChatGPT4.1"
    },
    "81213": {
      "id": 2625381,
      "text": "Một nhóm tội phạm đã đột nhập vào cung điện và lấy cắp một chiếc bồn cầu bằng vàng có giá trị cao đang được trưng bày.",
      "author": "ChatGPT4.1"
    },
    "81214": {
      "id": 2625382,
      "text": "Chiếc bồn cầu mà họ lấy được làm từ vàng 18 karat và được bảo hiểm 6 triệu đô la Mỹ.",
      "author": "ChatGPT4.1"
    },
    "81215": {
      "id": 2625383,
      "text": "Trong đoạn video được trình chiếu cho bồi thẩm đoàn tại phiên tòa, hai chiếc xe đã lái băng qua bãi cỏ của cung điện.",
      "author": "ChatGPT4.1"
    },
