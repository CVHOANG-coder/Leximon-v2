    },
    "81210": {
      "id": 2625378,
      "text": "Giới chức Anh vừa công bố đoạn video giám sát của một vụ án xảy ra cách đây 5 năm.",
      "author": "ChatGPT4.1"
    },
    "81211": {
      "id": 2625379,
      "text": "Năm 2019, một nhóm những tên trộm sáng tạo đã tấn công Cung điện Blenheim,",
