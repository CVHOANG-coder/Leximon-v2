  "translations": {
    "75394": {
      "id": 3032873,
      "text": "Đây là điều bạn không thường thấy mỗi ngày.",
      "author": "ChatGPT4.1"
    },
    "75395": {
      "id": 3032874,
      "text": "Captain America, bị mắc kẹt.",
      "author": "ChatGPT4.1"
    },
    "75396": {
      "id": 3032875,
      "text": "Chiếc mô tô của anh ấy bị hư bên lề đường cao tốc.",
      "author": "ChatGPT4.1"
    },
    "75397": {
      "id": 3032876,
      "text": "Khi lái xe ngang cảnh tượng lạ này, một phó cảnh sát trưởng quay lại để giúp đỡ.",
      "author": "ChatGPT4.1"
    },
    "75398": {
      "id": 3032877,
      "text": "Tôi quay đầu lại và thấy một chiếc mô tô, trông như bị hỏng...",
      "author": "ChatGPT4.1"
    },
    "75399": {
      "id": 3032878,
      "text": "Captain America đang đứng cạnh nó.",
      "author": "ChatGPT4.1"
    },
    "75400": {
      "id": 3032879,
      "text": "Vì vậy tôi xuống lối ra gần nhất, quay đầu xe và quay lại trò chuyện với anh ấy xem có ổn không.",
      "author": "ChatGPT4.1"
    },
    "75401": {
      "id": 3032880,
      "text": "Người mặc bộ đồ Captain America là Matt Gnojek, 35 tuổi.",
      "author": "ChatGPT4.1"
    },
    "75402": {
      "id": 3032881,
      "text": "Chiếc xe của anh ấy bị hỏng hoàn toàn.",
      "author": "ChatGPT4.1"
    },
    "75403": {
      "id": 3032882,
      "text": "Nhưng khi vị phó cảnh sát nghe thấy nơi mà Captain America đang đến,",
      "author": "ChatGPT4.1"
    },
    "75404": {
      "id": 3032883,
      "text": "ông quyết định làm nhiều hơn là chỉ gọi một chiếc xe cứu hộ",
      "author": "a user"
    },
    "75405": {
      "id": 3032884,
      "text": "\"Tôi sẽ trả tiền cho việc đó.\"",
      "author": "ChatGPT4.1"
    },
    "75406": {
      "id": 3032885,
      "text": "\"Không, không, không.\"",
      "author": "ChatGPT4.1"
    },
    "75407": {
      "id": 3032886,
      "text": "\"Đang là mùa Giáng sinh mà, không sao đâu. Đừng lo về điều đó.\"",
      "author": "ChatGPT4.1"
    },
    "75408": {
      "id": 3032887,
      "text": "\"Nhưng tôi không thể yên tâm để chiếc xe của anh ở đây được.\"",
      "author": "ChatGPT4.1"
    },
    "75409": {
      "id": 3032888,
      "text": "Captain America sững sờ.",
      "author": "ChatGPT4.1"
    },
    "75410": {
      "id": 3032889,
      "text": "\"Đừng bắt tôi phải dùng quyền lực. Tôi là một đội trưởng mà.\"",
      "author": "ChatGPT4.1"
    },
    "75411": {
      "id": 3032890,
      "text": "Vậy là phó cảnh sát Zepeski đã tự bỏ ra 140 đô la để kéo xe.",
      "author": "ChatGPT4.1"
    },
    "75412": {
      "id": 3032891,
      "text": "Tại sao?",
      "author": "ChatGPT4.1"
    },
    "75413": {
      "id": 3032892,
      "text": "Bởi vì Captain America thường đến thăm các em nhỏ bị bệnh ở các bệnh viện trên khắp nước Mỹ,",
      "author": "ChatGPT4.1"
    },
    "75414": {
      "id": 3032893,
      "text": "mang đến cho các em chút niềm vui mà chỉ một siêu anh hùng mới có thể mang lại.",
      "author": "ChatGPT4.1"
    },
    "75415": {
      "id": 3032894,
      "text": "\"Tôi có thể hình dung ra khuôn mặt của tất cả các em nhỏ ở bệnh viện đó và cảm giác tuyệt vời mà các em sẽ cảm nhận.\"",
      "author": "ChatGPT4.1"
    },
    "75416": {
      "id": 3032895,
      "text": "Trong phim ảnh, Captain America luôn cứu nguy cho mọi người.",
      "author": "ChatGPT4.1"
    },
    "75417": {
      "id": 3032896,
      "text": "Nhưng lần này, chính anh ấy là người cần được cứu giúp.",
      "author": "ChatGPT4.1"
    },
    "75418": {
      "id": 3032897,
      "text": "\"Mọi người nhìn thấy tôi với chiếc khiên đỏ, trắng, xanh trên lưng,\"",
      "author": "ChatGPT4.1"
    },
    "75419": {
      "id": 3032898,
      "text": "và họ nói, 'Ồ, anh là anh hùng vì những việc anh làm.'",
      "author": "ChatGPT4.1"
    },
    "75420": {
      "id": 3032899,
      "text": "\"Nhưng đó không phải là sự hy sinh thực sự.\"",
      "author": "ChatGPT4.1"
    },
    "75421": {
      "id": 3032900,
      "text": "\"Anh ấy mới là anh hùng thực sự.\"",
      "author": "ChatGPT4.1"
    }
  }
}
