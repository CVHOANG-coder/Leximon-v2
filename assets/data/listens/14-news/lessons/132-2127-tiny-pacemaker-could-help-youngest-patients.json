  "translations": {
    "83999": {
      "id": 2597471,
      "text": "Họ gọi đây là máy tạo nhịp tim nhỏ nhất thế giới.",
      "author": "ChatGPT4.1"
    },
    "84000": {
      "id": 2597472,
      "text": "Các kỹ sư tại Đại học Northwestern đã phát triển thiết bị này nhỏ đến mức",
      "author": "ChatGPT4.1"
    },
    "84001": {
      "id": 2597473,
      "text": "mà nó vừa vặn bên trong đầu kim tiêm.",
      "author": "ChatGPT4.1"
    },
    "84002": {
      "id": 2597474,
      "text": "Nó có thể được tiêm trực tiếp vào ngực bệnh nhân.",
      "author": "ChatGPT4.1"
    },
    "84003": {
      "id": 2597475,
      "text": "Vì vậy, không cần các ca phẫu thuật xâm lấn.",
      "author": "ChatGPT4.1"
    },
    "84004": {
      "id": 2597476,
      "text": "Bản thân máy tạo nhịp tim này rất nhạy với ánh sáng.",
      "author": "ChatGPT4.1"
    },
    "84005": {
      "id": 2597477,
      "text": "Nó hoạt động cùng với miếng dán nhỏ này dán trên da.",
      "author": "ChatGPT4.1"
    },
    "84006": {
      "id": 2597478,
      "text": "Khi phát hiện nhịp tim bất thường, nó sẽ phát sáng.",
      "author": "ChatGPT4.1"
    },
    "84007": {
      "id": 2597479,
      "text": "Ánh sáng đó kích hoạt các điện cực trên máy tạo nhịp tim.",
      "author": "ChatGPT4.1"
    },
    "84008": {
      "id": 2597480,
      "text": "Và sau đó gửi xung điện đến tim,",
      "author": "ChatGPT4.1"
    },
    "84009": {
      "id": 2597481,
      "text": "giúp kiểm soát và điều chỉnh nhịp tim.",
      "author": "ChatGPT4.1"
    },
    "84010": {
      "id": 2597482,
      "text": "Mặc dù máy tạo nhịp nhỏ này có thể hoạt động với trái tim ở bất kỳ kích thước nào,",
      "author": "ChatGPT4.1"
    },
    "84011": {
      "id": 2597483,
      "text": "nhưng nó đặc biệt có thể mang lại lợi ích cho trẻ sơ sinh mắc bệnh tim bẩm sinh",
      "author": "ChatGPT4.1"
    },
    "84012": {
      "id": 2597484,
      "text": "khi các bé hồi phục sau những ca phẫu thuật tim nghiêm trọng.",
