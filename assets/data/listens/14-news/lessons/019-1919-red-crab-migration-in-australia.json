  "translations": {
    "74523": {
      "id": 2594234,
      "text": "Hàng triệu con cua tụ tập và chiếm lĩnh một hòn đảo.",
      "author": "ChatGPT4.1"
    },
    "74524": {
      "id": 2594235,
      "text": "Đúng vậy, tôi nói là hàng triệu!",
      "author": "ChatGPT4.1"
    },
    "74525": {
      "id": 2594236,
      "text": "Cuộc di cư của cua đỏ diễn ra hàng năm tại Đảo Christmas ở Úc,",
      "author": "ChatGPT4.1"
    },
    "74526": {
      "id": 2594237,
      "text": "tạo nên điểm thu hút du lịch lớn nhất của hòn đảo.",
      "author": "ChatGPT4.1"
    },
    "74527": {
      "id": 2594238,
      "text": "Với từng đàn cua đỏ bò rời khỏi rừng hướng về phía bãi biển.",
      "author": "ChatGPT4.1"
    },
    "74528": {
      "id": 2594239,
      "text": "Vậy làm thế nào mà tất cả chúng đều biết lúc nào là lúc chuẩn bị và di chuyển?",
      "author": "ChatGPT4.1"
    },
    "74529": {
      "id": 2594240,
      "text": "Đây là cuộc di cư hàng loạt nổi tiếng của cua đỏ tại Đảo Christmas ở Úc,",
      "author": "ChatGPT4.1"
    },
    "74530": {
      "id": 2594241,
      "text": "một hòn đảo nằm ở Ấn Độ Dương, cách Perth khoảng 2.600 km về phía tây bắc.",
      "author": "ChatGPT4.1"
    },
    "74531": {
      "id": 2594242,
      "text": "Mỗi năm, hàng triệu con cua di chuyển từ rừng ra biển để sinh sản.",
      "author": "ChatGPT4.1"
    },
    "74532": {
      "id": 2594243,
      "text": "Cuộc di cư bắt đầu với những cơn mưa đầu tiên của mùa mưa.",
      "author": "ChatGPT4.1"
    },
    "74533": {
      "id": 2594244,
      "text": "Điều này thường diễn ra vào tháng Mười hoặc tháng Mười Một.",
      "author": "ChatGPT4.1"
    },
    "74534": {
      "id": 2594245,
      "text": "Những con cua chọn thời điểm di cư trùng với tuần trăng cuối cùng của Mặt Trăng.",
      "author": "ChatGPT4.1"
    },
    "74535": {
      "id": 2594246,
      "text": "Những con cua đực dẫn đầu, theo sau là các con cua cái.",
      "author": "ChatGPT4.1"
    },
    "74536": {
      "id": 2594247,
      "text": "Hiện tượng tuyệt vời này là điểm thu hút du lịch lớn nhất của Đảo Christmas.",
      "author": "ChatGPT4.1"
    }
  }
}
