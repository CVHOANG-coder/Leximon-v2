  "translations": {
    "75205": {
      "id": 2624065,
      "text": "Amazon đối mặt với một cuộc đình công lớn ở Mỹ khi mùa mua sắm nghỉ lễ đạt đến đỉnh điểm.",
      "author": "ChatGPT4.1"
    },
    "75206": {
      "id": 2624066,
      "text": "Hàng nghìn công nhân dự kiến sẽ đình công vào thứ Năm sau khi các quan chức công đoàn nói rằng công ty đã không tham gia bàn đàm phán.",
      "author": "ChatGPT4.1"
    },
    "75207": {
      "id": 2624067,
      "text": "Các quan chức Teamsters cho biết nhân viên sẽ đình công tại các kho ở New York, San Francisco và Atlanta.",
      "author": "ChatGPT4.1"
    },
    "75208": {
      "id": 2624068,
      "text": "Công đoàn cho biết họ đại diện cho khoảng 10.000 công nhân tại 10 cơ sở của Amazon.",
      "author": "ChatGPT4.1"
    },
    "75209": {
      "id": 2624069,
      "text": "Hiện tại, cuộc đình công đe dọa làm gián đoạn hoạt động vào thời điểm bận rộn nhất trong năm đối với các nhà bán lẻ.",
      "author": "ChatGPT4.1"
    },
    "75210": {
      "id": 2624070,
      "text": "Tuy nhiên, gã khổng lồ thương mại điện tử này có nhiều kho và các điểm giao hàng nhỏ hơn có thể giúp họ vượt qua sự ngưng trệ này.",
      "author": "ChatGPT4.1"
    },
    "75211": {
      "id": 2624071,
      "text": "Amazon chưa trả lời ngay lập tức yêu cầu bình luận về cuộc đình công.",
      "author": "ChatGPT4.1"
    },
    "75212": {
      "id": 2624072,
      "text": "Công đoàn đã đưa ra hạn chót vào Chủ nhật để bắt đầu đàm phán và công nhân cũng đã bỏ phiếu cho phép đình công.",
      "author": "ChatGPT4.1"
    },
    "75213": {
      "id": 2624073,
      "text": "Các quan chức Teamsters cho biết họ cũng sẽ lập hàng rào đình công tại hàng trăm cơ sở của Amazon trên toàn quốc.",
      "author": "ChatGPT4.1"
    }
  }
