  "translations": {
    "92707": {
      "id": 5611997,
      "text": "Một điều điên rồ ở Texas: mọi người đang phục vụ kem tôm càng... Vâng!",
      "author": "ChatGPT4.1"
    },
    "92708": {
      "id": 5611998,
      "text": "Mùa tôm càng bắt đầu vào tháng Ba.",
      "author": "ChatGPT4.1"
    },
    "92709": {
      "id": 5611999,
      "text": "Đó là lúc Red Circle Ice Cream ở Houston bắt đầu bán món kem tôm càng lạnh đặc biệt của họ.",
      "author": "ChatGPT4.1"
    },
    "92710": {
      "id": 5612000,
      "text": "Chủ tiệm Nikki Neo nấu tôm càng theo cách truyền thống:",
      "author": "ChatGPT4.1"
    },
    "92711": {
      "id": 5612001,
      "text": "tỏi, bơ, gia vị cajun, rồi hòa cùng món tráng miệng.",
      "author": "ChatGPT4.1"
    },
    "92712": {
      "id": 5612002,
      "text": "Thay vì phục vụ với xúc xích hay bắp như truyền thống, món này được múc kèm tôm càng và bánh quế.",
      "author": "ChatGPT4.1"
    },
    "92713": {
      "id": 5612003,
      "text": "\"Nó hơi mặn, nhưng lại béo ngậy, mịn màng, và hơi cay nhẹ.\"",
      "author": "ChatGPT4.1"
    },
    "92714": {
      "id": 5612004,
      "text": "Không phải kiểu hải sản luộc Cajun truyền thống, nhưng Nikki nói rằng khách hàng luôn đòi món này mỗi năm.",
      "author": "ChatGPT4.1"
    },
    "92715": {
      "id": 5612005,
      "text": "Tuy nhiên, Nikki cảnh báo rằng nếu bạn định thử, thì đừng nên... hôn ai trong một thời gian đấy.",
      "author": "ChatGPT4.1"
    }
  }
}
