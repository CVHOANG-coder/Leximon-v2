    "78022": {
      "id": 2649921,
      "text": "Đó là một phép màu y học thực sự.",
      "author": "ChatGPT4.1"
    },
    "78023": {
      "id": 2649922,
      "text": "Bé Evelyn Otto 4 tuổi đã có thể đi lại,",
      "author": "ChatGPT4.1"
    },
    "78024": {
      "id": 2649923,
      "text": "di chuyển quanh bệnh viện như bao đứa trẻ khác.",
      "author": "ChatGPT4.1"
    },
    "78025": {
      "id": 2649924,
      "text": "Thật tuyệt vời khi thấy Evelyn kiên cường đến thế nào.",
      "author": "ChatGPT4.1"
    },
    "78026": {
      "id": 2649925,
      "text": "Không nghi ngờ gì, cô bé là một chiến binh.",
      "author": "ChatGPT4.1"
    },
    "78027": {
      "id": 2649926,
      "text": "Khi Evelyn chào đời, cô bé được chẩn đoán mắc một dị tật tim bẩm sinh.",
      "author": "ChatGPT4.1"
    },
    "78028": {
      "id": 2649927,
      "text": "Và điều đó kéo theo rất nhiều khó khăn.",
      "author": "ChatGPT4.1"
    },
    "78029": {
      "id": 2649928,
      "text": "Sau tám ca phẫu thuật trước khi tròn hai tuổi,",
      "author": "ChatGPT4.1"
    },
    "78030": {
      "id": 2649929,
      "text": "bé Evelyn thực sự là một chiến binh nhỏ bé.",
      "author": "ChatGPT4.1"
    },
    "78031": {
      "id": 2649930,
      "text": "Bác sĩ của cô bé nói rằng theo thời gian, khi bé lớn lên,",
      "author": "ChatGPT4.1"
    },
    "78032": {
      "id": 2649931,
      "text": "bé sẽ phải trải qua thêm nhiều ca phẫu thuật và sống cùng thuốc men.",
      "author": "ChatGPT4.1"
    },
    "78033": {
      "id": 2649932,
      "text": "Nhưng cũng còn nhiều hy vọng.",
      "author": "ChatGPT4.1"
    },
    "78034": {
      "id": 2649933,
      "text": "Cô bé thật sự mạnh mẽ.",
      "author": "ChatGPT4.1"
    },
    "78035": {
      "id": 2649934,
      "text": "Bạn biết đấy, mặc dù có những giới hạn, nhưng cũng có rất nhiều kỳ vọng rằng bé sẽ có một cuộc sống trọn vẹn và tuyệt vời.",
