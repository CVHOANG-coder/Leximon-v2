  "translations": {
    "92195": {
      "id": 3686173,
      "text": "Ở tuổi 90, người ta có thể bắt đầu nghĩ đến việc sống chậm lại một chút.",
      "author": "ChatGPT4.1"
    },
    "92196": {
      "id": 3686174,
      "text": "Nhưng không phải là Sơ Selene Gosell.",
      "author": "ChatGPT4.1"
    },
    "92197": {
      "id": 3686175,
      "text": "\"Tôi không muốn vào tu viện, xin Chúa tha cho tôi.\"",
      "author": "ChatGPT4.1"
    },
    "92198": {
      "id": 3686176,
      "text": "\"Tôi không thuộc về nơi đó.\"",
      "author": "ChatGPT4.1"
    },
    "92199": {
      "id": 3686177,
      "text": "Không, bà nói rằng mình đang chính xác ở nơi mình thuộc về:",
      "author": "ChatGPT4.1"
    },
    "92200": {
      "id": 3686178,
      "text": "tại Nhà kho Thực phẩm Wisconsin do dòng tu của bà, các Nữ tu Bác ái Thánh Giá thành lập từ năm 1983.",
      "author": "ChatGPT4.1"
    },
    "92201": {
      "id": 3686179,
      "text": "Bà đã điều hành nơi này suốt 5 năm qua",
      "author": "ChatGPT4.1"
    },
    "92202": {
      "id": 3686180,
      "text": "và nói với WSAW rằng bà chỉ thấy nhu cầu cho dịch vụ của mình ngày càng tăng lên.",
      "author": "ChatGPT4.1"
    },
    "92203": {
      "id": 3686181,
      "text": "\"Hạt Lincoln có lẽ là một trong những hạt nghèo nhất bang Wisconsin.\"",
      "author": "ChatGPT4.1"
    },
    "92204": {
      "id": 3686182,
      "text": "\"Chúng tôi bắt đầu với... có lẽ chỉ phát cho khoảng 10 người mỗi tuần...\"",
      "author": "ChatGPT4.1"
    },
    "92205": {
      "id": 3686183,
      "text": "\"...và giờ chúng tôi làm nhiều hơn thế chỉ trong một ngày.\"",
      "author": "ChatGPT4.1"
    },
    "92206": {
      "id": 3686184,
      "text": "\"77 gia đình mới kể từ đầu tháng 1 năm 2025.\"",
      "author": "ChatGPT4.1"
    },
    "92207": {
      "id": 3686185,
      "text": "Sự kiên trì của bà trong cuộc chiến chống nghèo đói đã truyền cảm hứng cho những người làm việc cùng bà.",
      "author": "ChatGPT4.1"
    },
    "92208": {
      "id": 3686186,
      "text": "\"Tôi hy vọng khi mình bằng tuổi bà... nếu tôi đến được tuổi đó, tôi sẽ năng động được một nửa như bà ấy.\"",
      "author": "ChatGPT4.1"
    },
    "92209": {
      "id": 3686187,
      "text": "Bà nói rằng kế hoạch duy nhất của mình cho tương lai là giữ các kệ này luôn đầy và cộng đồng của bà luôn được no đủ.",
      "author": "ChatGPT4.1"
    },
    "92210": {
      "id": 3686188,
      "text": "\"Chúng tôi đang làm điều mà Chúa kêu gọi mình làm.\"",
      "author": "ChatGPT4.1"
    }
  }
}
