  "translations": {
    "86303": {
      "id": 2532474,
      "text": "Những chú ngựa mini này đang bước đi vào trái tim của mọi người mà chúng gặp gỡ.",
      "author": "ChatGPT4.1"
    },
    "86304": {
      "id": 2532475,
      "text": "Romeo và Ziggy không phải là ngựa con. Chúng là những con ngựa mini trưởng thành.",
      "author": "ChatGPT4.1"
    },
    "86305": {
      "id": 2532476,
      "text": "\"Bạn thật xinh đẹp. Tôi có thể nhận được những cái hôn của mình không?\"",
      "author": "ChatGPT4.1"
    },
    "86306": {
      "id": 2532477,
      "text": "Và cô gái cao bồi đứng sau niềm vui này có thể khiến bạn ngạc nhiên.",
      "author": "ChatGPT4.1"
    },
    "86307": {
      "id": 2532478,
      "text": "Đó là nữ diễn viên Daryl Hannah.",
      "author": "ChatGPT4.1"
    },
    "86308": {
      "id": 2532479,
      "text": "\"Thật tuyệt vời đối với tôi vì bất kể tôi đi đâu với Romeo, mọi người chỉ nhìn thấy nó.\"",
      "author": "ChatGPT4.1"
    },
    "86309": {
      "id": 2532480,
      "text": "\"Họ thậm chí còn không chú ý đến tôi, vì vậy thật tuyệt vời.\"",
      "author": "ChatGPT4.1"
    },
    "86310": {
      "id": 2532481,
      "text": "Cô ấy nhận nuôi Romeo và giúp huấn luyện nó để làm việc với mọi người ở mọi lứa tuổi.",
      "author": "ChatGPT4.1"
    },
    "86311": {
      "id": 2532482,
      "text": "\"Nó thích gặp gỡ những người mới. Nó thích được chú ý và tôi chỉ...\"",
      "author": "ChatGPT4.1"
    },
    "86312": {
      "id": 2532483,
      "text": "\"điều đó dường như là một sự phù hợp tự nhiên.\"",
      "author": "a user"
    },
    "86313": {
      "id": 2532484,
      "text": "Giờ đây, mỗi tháng một lần, Daryl cùng huấn luyện viên ngựa Senath Ferrera đến trung tâm người cao tuổi ở Thousand Oaks, California.",
      "author": "ChatGPT4.1"
    },
    "86314": {
      "id": 2532485,
      "text": "Tôi nghĩ rằng động vật có một khả năng độc đáo để đánh thức chúng ta về mối liên hệ nội tại của chúng ta với thế giới tự nhiên,",
      "author": "ChatGPT4.1"
    },
    "86315": {
      "id": 2532486,
      "text": "và điều đó nhắc nhở chúng ta rằng vẫn còn niềm vui và sự kỳ diệu để tìm thấy ngay cả khi bạn gặp hạn chế về thể chất.",
      "author": "ChatGPT4.1"
    },
    "86316": {
      "id": 2532487,
      "text": "Martha Shapiro là giám đốc chương trình tại trung tâm người cao tuổi và đã chứng kiến những lợi ích mà những chú ngựa mang lại.",
      "author": "ChatGPT4.1"
    },
    "86317": {
      "id": 2532488,
      "text": "\"Liệu điều này cũng có khía cạnh trị liệu không?\"",
      "author": "ChatGPT4.1"
    },
    "86318": {
      "id": 2532489,
      "text": "\"Có. Thăm viếng động vật luôn rất có ích về mặt trị liệu cho tất cả chúng ta, thật sự.\"",
      "author": "ChatGPT4.1"
    },
    "86319": {
      "id": 2532490,
      "text": "Những chú ngựa mini uy nghi này không chỉ đáng yêu mà còn có tác dụng trị liệu nữa.",
      "author": "ChatGPT4.1"
    },
    "86320": {
      "id": 2532491,
      "text": "\"Điều gì ở Romeo khiến nó trở nên kỳ diệu đối với bạn?\"",
      "author": "ChatGPT4.1"
    },
    "86321": {
      "id": 2532492,
      "text": "\"À, chúng hiền lành, chúng tốt bụng và chúng không phải là con trai.\"",
      "author": "ChatGPT4.1"
    },
    "86322": {
      "id": 2532493,
      "text": "\"Nhiều người không có cơ hội ở gần ngựa, và chúng thật kỳ diệu.\"",
      "author": "ChatGPT4.1"
    }
  }
