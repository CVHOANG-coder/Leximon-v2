    "78576": {
      "id": 2685044,
      "text": "Cẩn thận nhé, Ikea.",
      "author": "ChatGPT4.1"
    },
    "78577": {
      "id": 2685045,
      "text": "Một công ty ở Úc muốn làm ra một chiếc giường có thể lắp ráp dễ dàng.",
      "author": "ChatGPT4.1"
    },
    "78578": {
      "id": 2685046,
      "text": "Chỉ mất khoảng 1 giờ để lắp ráp một chiếc giường king single.",
      "author": "ChatGPT4.1"
    },
    "78579": {
      "id": 2685047,
      "text": "Hơn nữa, những chiếc giường này được làm từ 100% nhựa tái chế.",
      "author": "ChatGPT4.1"
    },
    "78580": {
      "id": 2685048,
      "text": "John Steel đã nảy ra ý tưởng làm giường bằng các khối nhựa ghép nối với nhau.",
      "author": "ChatGPT4.1"
    },
    "78581": {
      "id": 2685049,
      "text": "Bằng cách nấu chảy các tấm pallet từng là xô, thùng và các vật dụng tái chế khác.",
      "author": "ChatGPT4.1"
    },
    "78582": {
      "id": 2685050,
      "text": "Anh ấy nói rằng mỗi khung giường đôi giúp ngăn 16 lb nhựa khỏi bị vứt ra bãi rác.",
      "author": "ChatGPT4.1"
    },
    "78583": {
      "id": 2685051,
      "text": "Chúng dự kiến sẽ dùng được khoảng 10 năm,",
      "author": "ChatGPT4.1"
    },
    "78584": {
      "id": 2685052,
      "text": "và sau đó sẽ là lúc tái chế toàn bộ chiếc giường.",
      "author": "ChatGPT4.1"
    },
    "78585": {
      "id": 2685053,
      "text": "Nhưng ngủ trên những chiếc giường này cảm giác thế nào?",
      "author": "ChatGPT4.1"
    },
    "78586": {
      "id": 2685054,
      "text": "Một số vận động viên đã thử nghiệm và chia sẻ với CBS News rằng:",
      "author": "ChatGPT4.1"
    },
    "78587": {
      "id": 2685055,
      "text": "Tôi nghĩ nó rất tốt. Nó hoàn toàn không có tiếng ồn, vì thế...",
      "author": "ChatGPT4.1"
    },
    "78588": {
      "id": 2685056,
      "text": "không có tiếng kẽo kẹt hay gì tương tự.",
      "author": "ChatGPT4.1"
    },
    "78589": {
      "id": 2685057,
      "text": "Một giấc ngủ yên tĩnh càng giúp bạn an tâm rằng chiếc giường của mình đang góp phần bảo vệ môi trường.",
