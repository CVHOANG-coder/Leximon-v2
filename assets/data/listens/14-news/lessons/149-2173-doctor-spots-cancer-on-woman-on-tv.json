    },
    "85954": {
      "id": 2599866,
      "text": "Tôi đã nghĩ, trời ơi, tôi cảm thấy mình có trách nhiệm phải cho người này biết.",
      "author": "ChatGPT4.1"
    },
    "85955": {
      "id": 2599867,
      "text": "Có thể họ không biết mình có gì đó và...",
