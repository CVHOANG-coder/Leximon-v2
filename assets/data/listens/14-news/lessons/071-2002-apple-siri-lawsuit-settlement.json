  "translations": {
    "77923": {
      "id": 3044391,
      "text": "Đó là điều mà chúng ta thường xuyên đùa rằng \"điện thoại của chúng ta đang nghe lén chúng ta\", đúng không?",
      "author": "ChatGPT4.1"
    },
    "77924": {
      "id": 3044392,
      "text": "Nhưng liệu điều đó có thể là sự thật không?",
      "author": "ChatGPT4.1"
    },
    "77925": {
      "id": 3044393,
      "text": "Apple đã đồng ý trả 95 triệu đô la tiền mặt để giải quyết một vụ kiện tập thể được đề xuất.",
      "author": "ChatGPT4.1"
    },
    "77926": {
      "id": 3044394,
      "text": "Chủ sở hữu thiết bị di động cho rằng Apple thường xuyên ghi âm các cuộc trò chuyện riêng tư của họ",
      "author": "ChatGPT4.1"
    },
    "77927": {
      "id": 3044395,
      "text": "sau khi họ vô tình kích hoạt Siri bằng giọng nói.",
      "author": "ChatGPT4.1"
    },
    "77928": {
      "id": 3044396,
      "text": "Và những cuộc trò chuyện này đã bị tiết lộ cho các bên thứ ba như các nhà quảng cáo.",
      "author": "ChatGPT4.1"
    },
    "77929": {
      "id": 3044397,
      "text": "Khi đồng ý giải quyết, Apple đã phủ nhận hành vi sai trái hoặc vi phạm quyền riêng tư của người dùng.",
      "author": "ChatGPT4.1"
    },
    "77930": {
      "id": 3044398,
      "text": "Đây là một mối quan tâm quan trọng khi công nghệ ngày càng đóng vai trò lớn hơn trong cuộc sống hàng ngày của chúng ta.",
      "author": "ChatGPT4.1"
    },
    "77931": {
      "id": 3044399,
      "text": "Một nguyên đơn trong vụ kiện tập thể cho biết",
      "author": "ChatGPT4.1"
    },
    "77932": {
      "id": 3044400,
      "text": "anh ta đã nhận được quảng cáo về một phương pháp điều trị phẫu thuật mang thương hiệu",
      "author": "ChatGPT4.1"
    },
    "77933": {
      "id": 3044401,
      "text": "sau khi nghĩ rằng mình đang có một cuộc trò chuyện riêng tư với bác sĩ.",
      "author": "ChatGPT4.1"
    },
    "77934": {
      "id": 3044402,
      "text": "Số người liên quan đến vụ kiện tập thể này ước tính lên tới hàng chục triệu người.",
      "author": "ChatGPT4.1"
    },
    "77935": {
      "id": 3044403,
      "text": "Vì vậy, mọi người có thể sẽ nhận được khoảng 20 đô la cho mỗi thiết bị có Siri, như iPhone hoặc Apple Watch.",
      "author": "ChatGPT4.1"
    }
  }
}
