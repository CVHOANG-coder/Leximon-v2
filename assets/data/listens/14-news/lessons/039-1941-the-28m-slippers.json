  "translations": {
    "74876": {
      "id": 2626099,
      "text": "Một đôi giày trị giá 28 triệu đô la sao?",
      "author": "ChatGPT4.1"
    },
    "74877": {
      "id": 2626100,
      "text": "Một người đấu giá ẩn danh đã bỏ ra 28 triệu đô để mua đôi giày ruby",
      "author": "ChatGPT4.1"
    },
    "74878": {
      "id": 2626101,
      "text": "từ bộ phim huyền thoại The Wizard of Oz.",
      "author": "ChatGPT4.1"
    },
    "74879": {
      "id": 2626102,
      "text": "Đôi giày mang tính biểu tượng này từng được Judy Garland mang.",
      "author": "ChatGPT4.1"
    },
    "74880": {
      "id": 2626103,
      "text": "Giá cứ tăng liên tục, nhưng người đấu giá thì kiểu như, \"Tôi sẽ lấy được các em thôi!\"",
      "author": "ChatGPT4.1"
    },
    "74881": {
      "id": 2626104,
      "text": "Phiên đấu giá này xác lập kỷ lục mới về số tiền cao nhất từng chi cho một kỷ vật điện ảnh.",
      "author": "ChatGPT4.1"
    },
    "74882": {
      "id": 2626105,
      "text": "Đôi giày lấp lánh này là một trong bốn đôi còn sót lại.",
      "author": "ChatGPT4.1"
    },
    "74883": {
      "id": 2626106,
      "text": "Và thực tế là đôi này từng bị đánh cắp khỏi Bảo tàng Judy Garland ở Minnesota vào năm 2005,",
      "author": "ChatGPT4.1"
    },
    "74884": {
      "id": 2626107,
      "text": "trước khi cuối cùng được tìm thấy trở lại vào năm 2018.",
      "author": "ChatGPT4.1"
    }
  }
}
