  "translations": {
    "74648": {
      "id": 2645159,
      "text": "Cảnh quay bằng drone mới quay ở Đông Nam Ma-rốc hé lộ lũ lụt hiếm gặp ở sa mạc Sahara.",
      "author": "ChatGPT4.1"
    },
    "74649": {
      "id": 2645160,
      "text": "Mưa không phải là chưa từng xảy ra ở khu vực này của Sahara",
      "author": "ChatGPT4.1"
    },
    "74650": {
      "id": 2645161,
      "text": "nhưng chỉ xảy ra với lượng mưa vài inch mỗi năm.",
      "author": "ChatGPT4.1"
    },
    "74651": {
      "id": 2645162,
      "text": "Cơ quan khí tượng Ma-rốc nói với AP vào đầu tháng Mười",
      "author": "ChatGPT4.1"
    },
    "74652": {
      "id": 2645163,
      "text": "rằng đã \"30 đến 50 năm\" họ mới chứng kiến lượng mưa lớn như vậy.",
      "author": "ChatGPT4.1"
    },
    "74653": {
      "id": 2645164,
      "text": "Sahara là sa mạc không cực lớn nhất thế giới,",
      "author": "ChatGPT4.1"
    },
    "74654": {
      "id": 2645165,
      "text": "trải dài trên diện tích 3,6 triệu dặm vuông.",
      "author": "ChatGPT4.1"
    }
  }
