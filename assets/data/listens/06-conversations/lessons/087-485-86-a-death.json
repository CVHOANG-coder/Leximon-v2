      "id": 64028,
      "text": "Tôi nghĩ là do cơn đau tim.",
      "author": "a user"
    },
    "18740": {
      "id": 64037,
      "text": "Bà ấy có bị bệnh tim trước đó không?",
      "author": "a user"
    },
    "18741": {
      "id": 64040,
      "text": "Ừ, bà Smith đã bị bệnh tim năm năm trước khi qua đời.",
      "author": "a user"
    },
    "18742": {
      "id": 64041,
      "text": "Họ đã thử phẫu thuật chưa?",
      "author": "a user"
    },
    "18743": {
      "id": 64042,
      "text": "Bà ấy đã trải qua hai ca phẫu thuật, nhưng không có hiệu quả.",
      "author": "a user"
    },
    "18733": {
      "id": 2583591,
      "text": "Bạn có nghe về gia đình Smith không?",
