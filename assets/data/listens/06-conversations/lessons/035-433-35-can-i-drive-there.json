  "translations": {
    "18131": {
      "id": 12980,
      "text": "Ôi không, tôi trễ mất rồi.",
      "author": "a user"
    },
    "18132": {
      "id": 12983,
      "text": "Bạn đi đâu vậy?",
      "author": "a user"
    },
    "18134": {
      "id": 12990,
      "text": "Để tôi đưa bạn tới đó nhé?",
      "author": "a user"
    },
    "18135": {
      "id": 13005,
      "text": "Chắc chắn rồi! Điều đó sẽ giúp ích.",
      "author": "a user"
    },
    "18136": {
      "id": 13011,
      "text": "Bạn có bị đau răng không?",
      "author": "a user"
    },
    "18137": {
      "id": 13019,
      "text": "Đúng vậy, và nó rất tệ",
      "author": "a user"
    },
    "18139": {
      "id": 13027,
      "text": "Tôi bị đau mấy tuần nay rồi, và đây là lần đầu tiên tôi đặt lịch hẹn được.",
      "author": "a user"
    },
    "18140": {
      "id": 13082,
      "text": "Nha sĩ của tôi lúc nào cũng bận rộn!",
      "author": "a user"
    },
    "18141": {
      "id": 13103,
      "text": "Tôi đoán đó là một điều tốt! Nó có nghĩa là rất nhiều người thích anh ấy.",
      "author": "a user"
    },
    "18129": {
      "id": 2598058,
      "text": "Mấy giờ rồi?",
      "author": "a user"
    },
    "18130": {
      "id": 2598059,
      "text": "Bây giờ là ba giờ.",
      "author": "ChatGPT4.1"
    },
    "18133": {
      "id": 2598060,
      "text": "Tôi đến nha sĩ.",
      "author": "ChatGPT4.1"
    },
    "18138": {
      "id": 2598061,
      "text": "Tôi rất tiếc khi nghe vậy.",
      "author": "ChatGPT4.1"
    }
  }
