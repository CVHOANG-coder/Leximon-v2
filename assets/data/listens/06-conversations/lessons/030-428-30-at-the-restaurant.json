  "translations": {
    "18066": {
      "id": 4344,
      "text": "Cái menu này nhiều món quá!",
      "author": "a user"
    },
    "18067": {
      "id": 4345,
      "text": "Đúng vậy, bạn muốn chọn món gì?",
      "author": "a user"
    },
    "18068": {
      "id": 4346,
      "text": "Thịt gà, đậu và khoai tây nướng.",
      "author": "a user"
    },
    "18069": {
      "id": 4347,
      "text": "Tôi không biết phải chọn gì.",
      "author": "a user"
    },
    "18072": {
      "id": 4350,
      "text": "Còn bít tết thì sao?",
      "author": "a user"
    },
    "18073": {
      "id": 4351,
      "text": "Tuyệt vời. Tôi sẽ gọi bít tết và khoai tây nghiền.",
      "author": "a user"
    },
    "18074": {
      "id": 4352,
      "text": "Bạn sẽ gọi món rau nào?",
      "author": "a user"
    },
    "18075": {
      "id": 4353,
      "text": "Tôi không gọi gì hết. Tôi không thích rau.",
      "author": "a user"
    },
    "18070": {
      "id": 2620478,
      "text": "Họ có món gà tây rất ngon.",
      "author": "ChatGPT4.1"
    },
    "18071": {
      "id": 2620479,
      "text": "Tôi đã ăn gà tây hôm qua.",
      "author": "ChatGPT4.1"
    }
  }
