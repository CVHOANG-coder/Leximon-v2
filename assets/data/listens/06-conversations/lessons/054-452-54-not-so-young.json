  "translations": {
    "18364": {
      "id": 7877,
      "text": "Con trai tôi sẽ tốt nghiệp trung học ngày hôm nay!",
      "author": "a user"
    },
    "18366": {
      "id": 7882,
      "text": "Con bé bao nhiêu tuổi rồi?",
      "author": "a user"
    },
    "18369": {
      "id": 7886,
      "text": "Tôi biết. Chúng ta đang trở nên già đi.",
      "author": "a user"
    },
    "18371": {
      "id": 7890,
      "text": "Tại sao không? Đó là sự thật.",
      "author": "a user"
    },
    "18372": {
      "id": 7893,
      "text": "Không, không phải thế. Chúng ta kết hôn khi chúng ta còn trẻ.",
      "author": "a user"
    },
    "18373": {
      "id": 7894,
      "text": "Đúng vậy, nhưng chúng ta đã kết hôn cách đây 25 năm rồi!",
      "author": "a user"
    },
    "18365": {
      "id": 2590225,
      "text": "Và con gái tôi sẽ tốt nghiệp vào năm sau.",
      "author": "ChatGPT4.1"
    },
    "18367": {
      "id": 2590226,
      "text": "Nó mười sáu tuổi.",
      "author": "ChatGPT4.1"
    },
    "18368": {
      "id": 2590227,
      "text": "Tôi nhớ khi nó còn là một em bé.",
      "author": "ChatGPT4.1"
    },
    "18370": {
      "id": 2590228,
      "text": "Đừng nói vậy!",
      "author": "ChatGPT4.1"
    }
  }
