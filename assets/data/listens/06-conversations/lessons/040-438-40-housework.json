  "translations": {
    "18178": {
      "id": 23167,
      "text": "Bạn nấu bữa tối mỗi tối à?",
      "author": "a user"
    },
    "18179": {
      "id": 23169,
      "text": "Đúng vậy, tôi thường nấu bữa tối, còn chồng tôi rửa bát.",
      "author": "a user"
    },
    "18180": {
      "id": 23176,
      "text": "Tôi sống một mình, nên tôi làm mọi thứ. Dù là vậy, đôi khi tôi cũng đi ăn ngoài.",
      "author": "a user"
    },
    "18181": {
      "id": 23183,
      "text": "Có một số nhà hàng ngon trong khu phố của tôi.",
      "author": "a user"
    },
    "18182": {
      "id": 23195,
      "text": "Bạn sống ở đâu?",
      "author": "a user"
    },
    "18183": {
      "id": 23205,
      "text": "Gần Trung tâm Pen.",
      "author": "a user"
    },
    "18184": {
      "id": 23207,
      "text": "Ồ, tuyệt thật.",
      "author": "a user"
    },
    "18185": {
      "id": 23211,
      "text": "Gần nhà tôi chẳng có nhà hàng nào ngon cả.",
      "author": "a user"
    },
    "18187": {
      "id": 23230,
      "text": "Umm... có. Anh ấy dọn bàn ăn hầu như mỗi tối, và sáng nào cũng dọn giường.",
      "author": "a user"
    },
    "18188": {
      "id": 23235,
      "text": "Nhưng tôi thường chuẩn bị tất cả các bữa ăn.",
      "author": "a user"
    },
    "18189": {
      "id": 23238,
      "text": "Còn việc dọn dẹp thì sao?",
      "author": "a user"
    },
    "18192": {
      "id": 23286,
      "text": "và anh ấy làm vườn ngoài sân",
      "author": "a user"
    },
    "18193": {
      "id": 23288,
      "text": "Chồng bạn giúp bạn rất nhiều đấy. Anh ấy cũng giúp cả việc giặt giũ chứ?",
      "author": "a user"
    },
    "18194": {
      "id": 23293,
      "text": "À, anh ấy chưa bao giờ giúp tôi giặt đồ.",
      "author": "a user"
    },
    "18177": {
      "id": 2621132,
      "text": "Ôi! Tôi thật sự rất mệt và bây giờ tôi phải về nhà nấu ăn.",
      "author": "ChatGPT4.1"
    },
    "18186": {
      "id": 2621133,
      "text": "Chồng bạn có giúp bạn làm việc nhà nhiều không?",
      "author": "ChatGPT4.1"
    },
    "18190": {
      "id": 2621134,
      "text": "Chúng tôi dọn nhà cùng nhau vào mỗi cuối tuần.",
      "author": "ChatGPT4.1"
    },
    "18191": {
      "id": 2621135,
      "text": "Tôi hút bụi các phòng, và anh ấy thường xuyên quét sàn bếp,",
      "author": "ChatGPT4.1"
    }
  }
}
