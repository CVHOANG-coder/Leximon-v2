  "translations": {
    "18568": {
      "id": 41990,
      "text": "Bà, Martin? Tôi là bác sĩ Thomas.",
      "author": "a user"
    },
    "18569": {
      "id": 41993,
      "text": "Ôi bác sĩ, anh ấy thế nào rồi?",
      "author": "a user"
    },
    "18570": {
      "id": 41997,
      "text": "Ồ, tôi e rằng chúng ta sẽ phải phẫu thuật.",
      "author": "a user"
    },
    "18572": {
      "id": 42001,
      "text": "Đừng lo. Nếu chúng tôi phẫu thuật ngay bây giờ, anh ấy sẽ ổn thôi.",
      "author": "a user"
    },
    "18574": {
      "id": 42004,
      "text": "Tôi e là vậy. Anh ấy mất rất nhiều máu.",
      "author": "a user"
    },
    "18571": {
      "id": 2593267,
      "text": "Ôi không! Ông ấy luôn sợ các ca phẫu thuật.",
      "author": "ChatGPT4.1"
    },
    "18573": {
      "id": 2593268,
      "text": "Ôi, bác sĩ, thật sự phải làm vậy sao?",
      "author": "ChatGPT4.1"
    },
    "18575": {
      "id": 2593269,
      "text": "Nếu chúng ta không phẫu thuật, ông ấy sẽ chết!",
      "author": "ChatGPT4.1"
    },
    "18576": {
      "id": 2593270,
      "text": "Ôi, xin hãy làm bất cứ điều gì cần thiết.",
      "author": "ChatGPT4.1"
    }
  }
