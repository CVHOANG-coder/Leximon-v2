  "translations": {
    "60775": {
      "id": 1374601,
      "text": "Bạn có đến Công viên Quốc gia Redwood vào cuối tuần không?",
      "author": "a user"
    },
    "60776": {
      "id": 1374602,
      "text": "Có chứ. Thật không thể tin được!",
      "author": "a user"
    },
    "60777": {
      "id": 1374604,
      "text": "Cây ở đó cao và hùng vĩ lắm.",
      "author": "a user"
    },
    "60778": {
      "id": 1374605,
      "text": "Oh, tôi tin là vậy.",
      "author": "a user"
    },
    "60782": {
      "id": 1374609,
      "text": "Có nhiều người ở đó không?",
      "author": "a user"
    },
    "60783": {
      "id": 1374610,
      "text": "Không đông lắm.",
      "author": "a user"
    },
    "60779": {
      "id": 2610487,
      "text": "Bạn đã tham gia chuyến tham quan có hướng dẫn viên hay là tự mình khám phá??",
      "author": "a user"
    },
    "60780": {
      "id": 2610488,
      "text": "Chúng tôi quyết định tự khám phá.",
