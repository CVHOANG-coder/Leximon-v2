      "id": 7723,
      "text": "Ý tưởng hay đấy! Bạn đang đi đâu?",
      "author": "a user"
    },
    "18325": {
      "id": 7745,
      "text": "Để gửi gói hàng này.",
      "author": "a user"
    },
    "18326": {
      "id": 7750,
      "text": "Bạn có thể mua giúp tôi một số con tem không?",
      "author": "a user"
    },
    "18320": {
      "id": 2660913,
      "text": "Vâng, trời lạnh và có gió!",
      "author": "ChatGPT4.1"
    },
