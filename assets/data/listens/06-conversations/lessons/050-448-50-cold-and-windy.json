    "18327": {
      "id": 2660916,
      "text": "Được chứ. Bạn muốn bao nhiêu tem?",
      "author": "ChatGPT4.1"
    },
    "18328": {
      "id": 2660917,
      "text": "Mười cái.",
      "author": "ChatGPT4.1"
    },
    "18329": {
      "id": 2660918,
      "text": "Đây là tiền mua tem.",
      "author": "ChatGPT4.1"
    },
    "18330": {
