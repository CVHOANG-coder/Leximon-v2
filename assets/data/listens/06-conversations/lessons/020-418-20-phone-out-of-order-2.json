  "translations": {
    "17949": {
      "id": 4625,
      "text": "Nghe thử tiếng ồn kỳ lạ này xem",
      "author": "a user"
    },
    "17950": {
      "id": 4632,
      "text": "Nó không giống như âm thanh quay số.",
      "author": "a user"
    },
    "17951": {
      "id": 4643,
      "text": "Chắc là điện thoại bị hỏng rồi.",
      "author": "a user"
    },
    "17952": {
      "id": 4649,
      "text": "Tốt hơn chúng ta nên thông báo cho công ty điện thoại.",
      "author": "a user"
    },
    "17953": {
      "id": 4651,
      "text": "Làm sao để làm điều đó? Chúng ta không thể dùng điện thoại này.",
      "author": "a user"
    },
    "17955": {
      "id": 4664,
      "text": "Anh ấy lúc nào cũng phàn nàn về người khác. Tôi không muốn nhờ vả gì anh ấy đâu.",
      "author": "a user"
    },
    "17956": {
      "id": 4687,
      "text": "Vậy còn nhà hàng xóm đối diện thì sao?",
      "author": "a user"
    },
    "17957": {
      "id": 4690,
      "text": "Tôi quên mất bà Riley! Tôi chắc rằng bà ấy sẽ cho chúng ta sử dụng điện thoại của bà ấy.",
      "author": "a user"
    },
    "17948": {
      "id": 2606904,
      "text": "Này! Điện thoại cậu bị sao vậy?",
      "author": "a user"
    },
    "17954": {
      "id": 2606905,
      "text": "Chúng ta sang nhà bên cạnh dùng điện thoại của hàng xóm đi.",
      "author": "ChatGPT4.1"
    }
  }
