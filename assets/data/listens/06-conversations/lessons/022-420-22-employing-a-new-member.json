  "translations": {
    "17964": {
      "id": 7229,
      "text": "Chà, cô gái này có vẻ phù hợp với công việc.",
      "author": "a user"
    },
    "17965": {
      "id": 7234,
      "text": "Nhưng liệu cô ấy có đủ năng động?",
      "author": "a user"
    },
    "17966": {
      "id": 7237,
      "text": "Đúng vậy, cô ấy thực sự có vẻ tràn đầy năng lượng.",
      "author": "a user"
    },
    "17967": {
      "id": 7240,
      "text": "Ừm. Cô ấy cũng phải có tham vọng. Có đúng không?",
      "author": "a user"
    },
    "17968": {
      "id": 7243,
      "text": "Đúng vậy, cô ấy có nhiều tham vọng.",
      "author": "a user"
    },
    "17969": {
      "id": 7244,
      "text": "Và chúng tôi thực sự cần một kiểu người linh hoạt. Bạn có nghĩ rằng cô ấy là kiểu người như thế không?",
      "author": "a user"
    },
    "17970": {
      "id": 7245,
      "text": "Ừm. Cô ấy có vẻ đủ quyết tâm, nhưng hơi cứng nhắc.",
      "author": "a user"
    },
    "17971": {
      "id": 7246,
      "text": "Vậy tôi đoán chúng ta sẽ cho cô ấy làm thử, và xem cô ấy làm việc như thế nào!",
      "author": "a user"
    }
  }
