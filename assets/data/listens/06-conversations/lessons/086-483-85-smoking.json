    },
    "18711": {
      "id": 29108,
      "text": "Tôi đã hút thuốc được 20 năm.",
      "author": "a user"
    },
    "18713": {
      "id": 29113,
      "text": "Tôi hút hai gói mỗi ngày.",
      "author": "a user"
    },
    "18715": {
      "id": 29127,
      "text": "Rồi, tôi đã bỏ thuốc hai lần: một lần khi tôi mang thai bé Paul,",
      "author": "a user"
    },
    "18716": {
      "id": 29129,
      "text": "và lần khác khi tôi bị viêm họng nặng.",
      "author": "a user"
    },
    "18717": {
      "id": 64014,
      "text": "Nhưng tôi gặp rất nhiều khó khăn.",
      "author": "a user"
    },
    "18719": {
      "id": 64016,
      "text": "Bạn sẽ phải suy nghĩ thật kỹ về chuyện đó đấy!",
      "author": "a user"
    },
    "18708": {
      "id": 2582806,
      "text": "Bạn bắt đầu hút thuốc khi nào?",
