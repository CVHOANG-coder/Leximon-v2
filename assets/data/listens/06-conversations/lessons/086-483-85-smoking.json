    },
    "18712": {
      "id": 2582808,
      "text": "Bạn hút bao nhiêu điếu thuốc mỗi ngày?",
      "author": "ChatGPT4.1"
    },
    "18714": {
      "id": 2582809,
      "text": "Bạn đã từng cố bỏ thuốc chưa?",
