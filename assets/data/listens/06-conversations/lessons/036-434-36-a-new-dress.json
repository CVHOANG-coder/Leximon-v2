      "text": "Em không mang chìa khóa à?",
      "author": "a user"
    },
    "18145": {
      "id": 22518,
      "text": "Không, mở cửa cho tôi đi!",
      "author": "a user"
    },
    "18146": {
      "id": 22519,
      "text": "Trong hộp đó là gì? Em mua gì thế?",
      "author": "a user"
    },
    "18147": {
      "id": 22523,
      "text": "Một chiếc váy mới, anh yêu.",
      "author": "a user"
    },
    "18148": {
      "id": 22527,
      "text": "Nhưng em có một tủ đầy váy.",
      "author": "a user"
    },
    "18149": {
      "id": 22533,
      "text": "Em biết, nhưng em cần một cái mới.",
      "author": "a user"
    },
    "18150": {
      "id": 22536,
      "text": "Có gì không ổn với tất cả những chiếc váy kia?",
      "author": "a user"
    },
