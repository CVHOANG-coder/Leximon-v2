  "translations": {
    "60703": {
      "id": 1374398,
      "text": "Tôi không thể tin được đã gần năm năm kể từ lần cuối chúng ta gặp nhau.",
      "author": "a user"
    },
    "60704": {
      "id": 1374401,
      "text": "Ừ, thật điên rồ khi thời gian trôi nhanh như vậy.",
      "author": "a user"
    },
    "60705": {
      "id": 1374402,
      "text": "Dạo này bạn thế nào?",
      "author": "a user"
    },
    "60706": {
      "id": 1374403,
      "text": "Tôi ổn! Tôi vừa chuyển đến một thành phố mới để làm việc.",
      "author": "a user"
    },
    "60708": {
      "id": 1374406,
      "text": "Mình cũng bận rộn với công việc nhưng vẫn ở chỗ cũ.",
      "author": "a user"
    },
    "60710": {
      "id": 1374410,
      "text": "Có, tuyệt lắm!",
      "author": "a user"
    },
    "60713": {
      "id": 1374413,
      "text": "Chúng ta nên gặp nhau thường xuyên hơn và đừng để quá nhiều thời gian trôi qua như thế",
      "author": "a user"
    },
    "60707": {
      "id": 2616670,
      "text": "Còn bạn thì sao?",
      "author": "ChatGPT4.1"
    },
    "60709": {
      "id": 2616671,
      "text": "Bạn có thích thành phố mới không?",
      "author": "ChatGPT4.1"
    },
    "60711": {
      "id": 2616672,
      "text": "Có rất nhiều điều để khám phá.",
      "author": "ChatGPT4.1"
    },
    "60712": {
      "id": 2616673,
      "text": "Chỉ là mình nhớ một vài người bạn cũ thôi.",
      "author": "ChatGPT4.1"
    }
