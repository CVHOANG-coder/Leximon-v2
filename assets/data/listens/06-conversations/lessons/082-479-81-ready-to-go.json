      "id": 32300,
      "text": "Cô ấy cần nhanh lên. Chúng ta không có đủ thời gian.",
      "author": "a user"
    },
    "18665": {
      "id": 32310,
      "text": "Không cần vội. Đi xe hơi chỉ mất mười phút để đến đó thôi.",
      "author": "a user"
    },
    "18666": {
      "id": 32314,
      "text": "Tôi biết, nhưng quanh rạp chiếu phim không có nhiều chỗ đậu xe.",
      "author": "a user"
    },
    "18658": {
      "id": 2584156,
      "text": "Bạn sẵn sàng chưa?",
      "author": "a user"
    },
    "18661": {
      "id": 2584157,
      "text": "Bộ phim bắt đầu lúc mấy giờ?",
