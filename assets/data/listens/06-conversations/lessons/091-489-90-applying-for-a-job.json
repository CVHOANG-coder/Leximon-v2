  "translations": {
    "18791": {
      "id": 17870,
      "text": "Vâng, đúng rồi. Chào ông ạ.",
      "author": "a user"
    },
    "18792": {
      "id": 17871,
      "text": "Chào cô. Mời cô ngồi.",
      "author": "a user"
    },
    "18793": {
      "id": 32258,
      "text": "Cảm ơn rất nhiều.",
      "author": "a user"
    },
    "18794": {
      "id": 32259,
      "text": "Vâng, tôi có đơn xin việc của cô ở đây.",
      "author": "a user"
    },
    "18795": {
      "id": 32260,
      "text": "Tôi chỉ muốn kiểm tra lại thông tin... được chứ?",
      "author": "a user"
    },
    "18796": {
      "id": 32261,
      "text": "Vâng, tất nhiên rồi.",
      "author": "a user"
    },
    "18798": {
      "id": 32263,
      "text": "Vâng, đúng vậy.",
      "author": "a user"
    },
    "18801": {
      "id": 32266,
      "text": "Uh, huh. Bạn không học đại học, đúng không?",
      "author": "a user"
    },
    "18802": {
      "id": 32267,
      "text": "Đúng, tôi không học đại học, nhưng tôi đã học trường cao đẳng kỹ thuật.",
      "author": "a user"
    },
    "18803": {
      "id": 32268,
      "text": "Và tôi bắt đầu đi làm từ năm 20 tuổi.",
      "author": "a user"
    },
    "18804": {
      "id": 32269,
      "text": "Tôi hiểu rồi. Bạn có thể nói tiếng Tây Ban Nha, đúng không??",
      "author": "a user"
    },
    "18805": {
      "id": 32270,
      "text": "Vâng, tôi có thể... nhưng tôi viết tốt hơn là nói.",
      "author": "a user"
    },
    "18806": {
      "id": 32271,
      "text": "Bạn có nói được ngôn ngữ nào khác không?",
      "author": "a user"
    },
    "18809": {
      "id": 32274,
      "text": "Đúng vậy... và cả Pháp nữa.",
      "author": "a user"
    },
    "18811": {
      "id": 32277,
      "text": "Không, tôi e là chưa, nhưng tôi rất muốn đến đó.",
      "author": "a user"
    },
    "18812": {
      "id": 32278,
      "text": "Tốt lắm, vì công việc này cần những người nói được nhiều ngôn ngữ.",
      "author": "a user"
    },
    "18814": {
      "id": 32281,
      "text": "Cảm ơn ông rất nhiều! Tôi sẽ không làm ông thất vọng đâu!",
      "author": "a user"
    },
    "18790": {
      "id": 2583287,
      "text": "Mời vào... mời vào. Cô là cô Wallace, phải không?",
      "author": "ChatGPT4.1"
    },
    "18797": {
      "id": 2583288,
      "text": "Bây giờ cô 28 tuổi, phải không?",
      "author": "ChatGPT4.1"
    },
    "18799": {
      "id": 2583289,
      "text": "Và cô chưa kết hôn, đúng không?",
      "author": "ChatGPT4.1"
    },
    "18800": {
      "id": 2583290,
      "text": "Chưa, tôi chưa... Tôi vừa đính hôn.",
      "author": "ChatGPT4.1"
    },
    "18807": {
      "id": 2583291,
      "text": "Vâng, tôi biết nói một chút tiếng Pháp.",
      "author": "ChatGPT4.1"
    },
    "18808": {
      "id": 2583292,
      "text": "Cô đã từng tới Argentina rồi, đúng không?",
      "author": "ChatGPT4.1"
    },
    "18810": {
      "id": 2583293,
      "text": "Tôi hiểu... nhưng cô chưa từng đến Trung Đông, đúng không?",
      "author": "ChatGPT4.1"
    },
    "18813": {
      "id": 2583294,
      "text": "Tôi nghĩ cô sẽ làm tốt thôi!",
      "author": "ChatGPT4.1"
    }
  }
