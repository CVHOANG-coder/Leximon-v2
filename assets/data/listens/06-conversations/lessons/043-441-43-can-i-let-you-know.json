  "translations": {
    "18236": {
      "id": 20857,
      "text": "Tối nay cậu có đi chơi với Leonard không?",
      "author": "a user"
    },
    "18237": {
      "id": 33808,
      "text": "Ờ ờ. Lẽ ra anh ấy phải đón tôi lúc 6:30. Bây giờ là mấy giờ rồi?",
      "author": "a user"
    },
    "18238": {
      "id": 33834,
      "text": "5:45. Cậu nên chuẩn bị đi thôi.",
      "author": "a user"
    },
    "18239": {
      "id": 33846,
      "text": "Đùa à? Tớ còn chưa tắm nữa.",
      "author": "a user"
    },
    "18240": {
      "id": 33855,
      "text": "Các bạn định đi đâu vậy?",
      "author": "a user"
    },
    "18242": {
      "id": 33878,
      "text": "Đi xem Forrest Gump đi. Người ta nói bộ phim này thú vị đó.",
      "author": "a user"
    },
    "18243": {
      "id": 33888,
      "text": "Ồ, có thể bọn tớ sẽ xem. Tớ cũng nghe nói phim Giác quan thứ sáu hay nữa.",
      "author": "a user"
    },
    "18244": {
      "id": 33897,
      "text": "Chà, cá nhân tôi thích Forrest Gump hơn.",
      "author": "a user"
    },
    "18245": {
      "id": 33904,
      "text": "Tớ thật sự phải đi đây. Ngày mai cậu muốn đi mua sắm không?",
      "author": "a user"
    },
    "18246": {
      "id": 33917,
      "text": "Tớ cũng muốn đi, nhưng còn tùy.",
      "author": "a user"
    },
    "18247": {
      "id": 33923,
      "text": "Có lẽ ngày mai tôi phải đến cửa hàng và làm một số việc.",
      "author": "a user"
    },
    "18248": {
      "id": 33932,
      "text": "Tôi có thể cho bạn biết vào sáng sớm ngày mai được không?",
      "author": "a user"
    },
    "18249": {
      "id": 33944,
      "text": "OK, vậy cũng được.",
      "author": "a user"
    },
    "18250": {
      "id": 33950,
      "text": "Ồ, có điện thoại kìa. Chắc là Leonard.",
      "author": "a user"
    },
    "18251": {
      "id": 33958,
