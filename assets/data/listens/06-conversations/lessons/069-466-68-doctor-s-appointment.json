  "translations": {
    "18513": {
      "id": 36871,
      "text": "Khi nào tôi có thể gặp Bác sĩ Know?",
      "author": "a user"
    },
    "18514": {
      "id": 36872,
      "text": "Anh ấy sẽ không rảnh cho đến ngày mai.",
      "author": "a user"
    },
    "18516": {
      "id": 36904,
      "text": "Chắc chắn. Ngày mai lúc mười giờ được không?",
      "author": "a user"
    },
    "18517": {
      "id": 36905,
      "text": "Bạn có thể xếp hẹn lúc chín giờ được không?",
      "author": "a user"
    },
    "18519": {
      "id": 36916,
      "text": "Tôi xin lỗi nhưng anh ấy bận đến mười giờ.",
      "author": "a user"
    },
    "18520": {
      "id": 36917,
      "text": "Thế, có cách nào nhét tôi vào lịch trình được không?",
      "author": "a user"
    },
    "18522": {
      "id": 36920,
      "text": "Sau khi ăn trưa có được không?",
      "author": "a user"
    },
    "18515": {
      "id": 2587998,
      "text": "Tôi có thể đặt lịch hẹn được không?",
      "author": "ChatGPT4.1"
    },
    "18518": {
      "id": 2587999,
      "text": "Tôi sẽ kiểm tra xem ông ấy có rảnh không.",
      "author": "ChatGPT4.1"
    },
    "18521": {
      "id": 2588000,
      "text": "Tôi e là không được.",
      "author": "ChatGPT4.1"
    },
    "18523": {
      "id": 2588001,
      "text": "Một giờ được không?",
      "author": "ChatGPT4.1"
    },
    "18524": {
      "id": 2588002,
      "text": "Rất tuyệt. Cảm ơn bạn.",
      "author": "ChatGPT4.1"
    }
