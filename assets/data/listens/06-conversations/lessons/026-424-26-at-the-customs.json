  "translations": {
    "18018": {
      "id": 11064,
      "text": "Chào buổi sáng. Tôi có thể xem hộ chiếu của bạn không?",
      "author": "a user"
    },
    "18019": {
      "id": 11066,
      "text": "Tất nhiên rồi. Nó đây.",
      "author": "a user"
    },
    "18020": {
      "id": 11072,
      "text": "Ừ, vậy ổn rồi. Bạn có mang gì cần khai báo không?",
      "author": "a user"
    },
    "18021": {
      "id": 11076,
      "text": "Có, tôi có. Tôi có một ít rượu whisky và một ít thuốc lá.",
      "author": "a user"
    },
    "18024": {
      "id": 11087,
      "text": "Vậy thì ổn thôi. Còn thuốc lá thì bạn có bao nhiêu điếu?",
      "author": "a user"
    },
    "18027": {
      "id": 11093,
      "text": "À... Không, tôi không có.",
      "author": "a user"
    },
    "18028": {
      "id": 11096,
      "text": "Tốt. Vui lòng mở vali của bạn.",
      "author": "a user"
    },
    "18029": {
      "id": 11098,
      "text": "cái gì cơ?",
      "author": "a user"
    },
    "18030": {
      "id": 11099,
      "text": "Vui lòng mở vali của bạn ra. Mở nó ra ngay!",
      "author": "a user"
    },
    "18022": {
      "id": 2595139,
      "text": "Anh/chị mang bao nhiêu rượu whisky?",
      "author": "ChatGPT4.1"
    },
    "18023": {
      "id": 2595140,
      "text": "Một lít.",
      "author": "ChatGPT4.1"
    },
    "18025": {
      "id": 2595141,
      "text": "Hai trăm.",
      "author": "ChatGPT4.1"
    },
    "18026": {
      "id": 2595142,
      "text": "Tốt. Thế còn nước hoa thì sao?",
      "author": "ChatGPT4.1"
    },
    "18031": {
      "id": 2595143,
      "text": "Ôi, trời ơi! Nhìn cái này này!",
      "author": "ChatGPT4.1"
    },
    "18032": {
      "id": 2595144,
      "text": "Anh/chị có 3 chai whisky, 400 điếu thuốc và rất nhiều nước hoa!",
      "author": "ChatGPT4.1"
    },
    "18033": {
      "id": 2595145,
      "text": "Điều đó có nghĩa là tôi không thể đi à?",
      "author": "ChatGPT4.1"
    }
  }
