      "text": "Chúng tôi chỉ cho phép hai kiện hành lý thôi. Bạn sẽ phải trả phần phụ phí.",
      "author": "a user"
    },
    "18008": {
      "id": 11044,
      "text": "Ồ! Tôi có thể mang cái này theo bên mình được không?",
      "author": "a user"
    },
    "18009": {
      "id": 11047,
      "text": "Không, tôi rất tiếc. Nó sẽ không nhét vừa bên dưới chỗ ngồi của bạn.",
      "author": "a user"
    },
    "18010": {
      "id": 11053,
      "text": "Số tiền thêm là 45 đô la.",
      "author": "a user"
    },
    "18011": {
      "id": 11055,
      "text": "Đây, của bạn đây.",
      "author": "a user"
    },
    "18013": {
      "id": 11057,
      "text": "Chỗ ngồi cạnh cửa sổ hay chỗ ngồi cạnh lối đi?",
      "author": "a user"
    },
    "18014": {
      "id": 11058,
      "text": "Tôi muốn ngồi cạnh cửa sổ.",
      "author": "a user"
    },
    "18015": {
      "id": 11060,
      "text": "Dạ được ạ. Ghế 15A.",
      "author": "a user"
    },
    "18017": {
