  "translations": {
    "60794": {
      "id": 1375123,
      "text": "Bạn có để ý rằng phòng của chúng ta hôm nay chưa được dọn không?",
      "author": "a user"
    },
    "60795": {
      "id": 1375125,
      "text": "Có, mình có thấy.",
      "author": "a user"
    },
    "60796": {
      "id": 1375126,
      "text": "Tôi khá bất ngờ khi trở về và thấy phòng vẫn còn bừa bộn.",
      "author": "a user"
    },
    "60799": {
      "id": 1375132,
      "text": "Có thể họ bỏ sót phòng chúng ta do nhầm lẫn.",
      "author": "a user"
    },
    "60800": {
      "id": 1375133,
      "text": "Được rồi. Mình hy vọng họ có thể cử người lên sớm;",
      "author": "a user"
    },
    "60801": {
      "id": 1375134,
      "text": "ở thế này thật sự không thoải mái chút nào.",
      "author": "a user"
    },
    "60797": {
      "id": 2588850,
      "text": "Bạn nghĩ chúng ta nên gọi lễ tân hay tự xuống đó?",
      "author": "ChatGPT4.1"
    },
    "60798": {
      "id": 2588851,
      "text": "Hãy gọi cho họ trước và xem họ nói gì.",
      "author": "ChatGPT4.1"
    },
    "60802": {
      "id": 2588852,
      "text": "Ừ, và hãy nhắc họ về mấy cái gối thêm mà mình đã yêu cầu sáng nay nữa nhé.",
      "author": "ChatGPT4.1"
    }
  }
